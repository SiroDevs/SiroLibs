                  "text": "2:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man etimbre, kinde ma dhanu maku medri wi wang’ ng’om, man nyir unyole igi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.1",
            "verseOrgIds": [
              "GEN.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nia wot Mungu gineno nyir mi dhanu nia wang’gi leng’; man gigamu igi mon mi ceke ma gifoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.2",
            "verseOrgIds": [
              "GEN.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man Yehova wacu kumae, Tipona bipiembre ku dhanu nja ngo, kum en bende en e kum: ento ceng’ pare bibedo rundi dak acel ku pier ario. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.3",
            "verseOrgIds": [
              "GEN.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.13.33"
              },
              "items": [
                {
                  "text": "Wel 13:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Junefili ginuti i ng’om i ceng’ maeca, man bende yo ng’ei maeno, kinde ma wot Mungu gimondo ba nyig dhanu, e ginyolo nyithindho igi: dhanune gi dhanu ma tek ma ginuti con, dhanu ma pigi yik.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.4",
            "verseOrgIds": [
              "GEN.6.4"
            ]
          }
        }
      ]
    },
    {
