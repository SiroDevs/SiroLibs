          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man Rebeka wacu ni Isak kumae, Kwo para ola kum nyig Heth: tek Yakobo gamu dhaku ma kind nyig Heth, wadi maeni, mi nyir m’i ng’ombe, kwo para biloko ang’o ira?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.46",
