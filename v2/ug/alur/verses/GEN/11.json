          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "man Arpakcad ucamu ng’om yo ng’ei nyolo Cela rundi dak ang’wen ku wi adek, man enyolo nyithindho ma co ku nyithindho ma nyir.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.13",
