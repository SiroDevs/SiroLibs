              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man Arpakcad ucamu ng’om rundi pier adek wi abic, man enyolo Cela: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.12",
            "verseOrgIds": [
              "GEN.11.12"
            ]
