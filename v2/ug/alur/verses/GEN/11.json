          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maeni dhanum’utuk pa Cem. Cem rundi pare dak acel, man enyolo Arpakcad rundi ario yo ng’ei pi m’ucoro ng’om: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.10",
            "verseOrgIds": [
              "GEN.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "man Cem ucamu ng’om yo ng’ei nyolo Arpakcad rundi dak abic, man enyolo nyithindho ma co ku nyithindho ma nyir.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.11",
            "verseOrgIds": [
              "GEN.11.11"
            ]
          }
        }
      ]
    },
