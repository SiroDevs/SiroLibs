              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.6",
            "verseOrgIds": [
              "1SA.12.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.6.26"
              },
              "items": [
                {
                  "text": "Ai 6:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man Samwil uwacu ni dhanu kumae, en e Yehova m’ugoyo wi Musa ku Harun, man m’uwodho kwaruwu kud i ng’om Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.6",
            "verseOrgIds": [
              "1SA.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka kumeno wucung’ ling’, kara agony iwu i wang’ Yehova pi tic mi bedopwe ceke pa Yehova, m’etimo iwu man ni kwaruwu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.7",
            "verseOrgIds": [
              "1SA.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.2.23"
              },
              "items": [
                {
                  "text": "Ai 2:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kinde ma Yakobo bino i Misiri, man kwaruwu ywak ba Yehova, Yehova lund uoro Musa giku Harun, m’uwodho kwaruwu woko kud i Misiri, man eketho gibedo i ka maeni. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.8",
            "verseOrgIds": [
              "1SA.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.4.2"
              },
              "items": [
                {
                  "text": "Pok 4:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.13.1"
              },
              "items": [
                {
                  "text": "Pok 13:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.3.12"
              },
              "items": [
                {
                  "text": "Pok 3:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ento wigi wil kum Yehova Mungu migi; man eng’iewogi i cing’ Sisera, jego mir udul pa Hazor, man i cing’ Jufilisti, man i cing’ ubimo mi Moab; man gikiedo kugi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.9",
            "verseOrgIds": [
              "1SA.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.10.10+JDG.10.11+JDG.10.12+JDG.10.13+JDG.10.14+JDG.10.15"
              },
              "items": [
                {
                  "text": "Pok 10:10-15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man gilwong’o Yehova, e giwacu kumae, Wadubo, kum waweko Yehova, man watimo ni Balim man Actaroth: ento kawono bodhwa kud i cing’ judegi mwa, man wabitimo iri. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.10",
            "verseOrgIds": [
              "1SA.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.7.1"
              },
              "items": [
                {
                  "text": "Pok 7:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.4.6"
              },
              "items": [
                {
                  "text": "Pok 4:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.11.29"
              },
              "items": [
                {
                  "text": "Pok 11:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.3.20"
              },
              "items": [
                {
                  "text": "1 Sam 3:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man Yehova oro Yerubal man Bedan, ku Yeftha, man Samwil, man ebodhowu kud i cing’ judegiwu kun ku kun; e wubedo museme. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.11",
            "verseOrgIds": [
              "1SA.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.8.19"
              },
              "items": [
                {
                  "text": "1 Sam 8:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ento ka wuneno nia Nahac m’ubimo mi nyithindho mir Amon ubino i kumwu, wuwacu ira kumae, Ungo, ento ubimo bicamu ker i wiwa; ma nwang’u Yehova Mungu mu en e ubimo mu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.12",
            "verseOrgIds": [
              "1SA.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka kumeno kawono nen ubimo ma wugoyo wie, man ma wupenjo pire: man, nen, Yehova ketho ubimo i wiwu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.13",
            "verseOrgIds": [
              "1SA.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tek wubilworo Yehova, man wutim ire, wuwinj dwande de, man wujai ungo kum lembang’ola pa Yehova, man wun kud ubimo bende m’ucamu ker i wiwu wubed julub Yehova Mungu mu, e dre: ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.14",
            "verseOrgIds": [
              "1SA.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ento tek wubiwinjo dwand Yehova ngo, ento wujai kum lembang’ola pa Yehova, e cing’ Yehova bibedo i wiwu, calu ebedo i wi kwaruwu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.15",
            "verseOrgIds": [
              "1SA.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka kumeno kawono wucung ling’ man wunen gin ma dit maeni, ma Yehova bitimo i weng’wu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.16",
            "verseOrgIds": [
              "1SA.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "En e palacam mi nganu tin ungo? Abilwong’o Yehova, kara eor morpolo ku koth; e wubing’eyo wubineno de nia dubo mu e dit, ma wutimo i wang’ Yehova, i penji ma wupenjo ko ubimo iwu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.17",
            "verseOrgIds": [
              "1SA.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum kumeno Samwil ulwong’o Yehova; man Yehova oro morpolo ku koth i ceng’ maeca: man lworo nego dhanu ceke dit kum Yehova man kum Samwil.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.18",
            "verseOrgIds": [
              "1SA.12.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.18",
            "verseOrgIds": [
              "1SA.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man dhanune ceke giwacu ni Samwil kumae, Rwo ni Yehova Mungu peri pi jutic peri, kara ku watho; kum wamedo kum dubo mwa ceke kier maeni, ma wapenjo ko iwa ubimo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.19",
            "verseOrgIds": [
              "1SA.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "E Samwil uwacu ni dhanune kumae, Lworo kud unegwu: wutimo dubo maeni ceke andha; ento kud wulokru cen kum lubo Yehova, ento wutim ni Yehova kud adundewu ceke: ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.20",
            "verseOrgIds": [
              "1SA.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "man kud wulokru cen; kum tek kumeno nwang’u wucidho tok gin mananu ma kulokane mbe kadi both, kum gi mananu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.21",
            "verseOrgIds": [
              "1SA.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum Yehova biweko dhanu pare ngo kum nyinge ma dwong’, kum enyayu mutoro i Yehova ya edwokwu ni dhanu ire gire. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.22",
            "verseOrgIds": [
              "1SA.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mange ke pi an, dong’ ebed bor i kuma nia adub ni Yehova kuweko rwo piwu: ento abiponjowu i yo ma ber m’atira de. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.23",
            "verseOrgIds": [
              "1SA.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndhu wulwor Yehova, man wutim ire andha kud adundewu ceke; kum wupoi pi gin ma dit m’etimo iwu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.24",
            "verseOrgIds": [
              "1SA.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento tek wubidubo asu, wubinyothru, wun kud ubimo mu de.",
