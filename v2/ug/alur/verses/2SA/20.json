              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.3",
            "verseOrgIds": [
              "2SA.20.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.16.22"
              },
              "items": [
                {
                  "text": "2 Sam 16:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man Daudi bino i ot pare i Yerusalem; e Daudi gamu mon pare apar m’araga, m’eweko kara ugwok ot, man ekethogi i ka ma jukuro, emio igi cemo de, ento emondo i bang’gi ngo. Kum kumeno juciko bang’gi cil i ceng’ mi tho migi, ma gibedo ko ni mon landu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.3",
            "verseOrgIds": [
              "2SA.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.3",
            "verseOrgIds": [
              "2SA.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubimo lund uwacu ni Amasa kumae, Lwong’ dhanu pa Yuda ubin i bang’a ma fodi ceng’ adek kukadhu ngo, man ibed nuti keni. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.4",
            "verseOrgIds": [
              "2SA.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum kumeno Amasa cidho kara elwong’ dhanu mi Yuda karacelo; ento egalu ma sagu nindo m’aketha m’eng’olo ire. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.5",
            "verseOrgIds": [
              "2SA.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man Daudi wacu ni Abicai kumae, Kawono Ceba ma wod Bikri bitimowa rac ma sagu Absalom: gam jutic pa rwoth peri, man ilub toke, emaru maku adhura ma tek ire, man emaru both i wang’wa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.6",
            "verseOrgIds": [
              "2SA.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man dhanu pa Yoab gilubo toke, man Jukerethi ku Jupelethi, ku dhanu ma tek ceke; man giai kud i Yerusalem, kara gilub tolf Ceba ma wod Bikri. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.7",
            "verseOrgIds": [
              "2SA.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinde ma gini kum kidi ma dit ma ni i Gibeon, Amasa bino kara eromb kugi. Man Yoab ukendo jambali pare m’eronyo, etwio wie ku del ma palamularu ni i kume i ukorone; man kan ewok woko epodho. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.8",
            "verseOrgIds": [
              "2SA.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man Yoab uwacu ni Amasa kumae, Lembe bedo ber i beng’i, umira? Man Yoab umaku Amasa ku tike i cinge ma yor acwic kara ecwi limbe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.9",
            "verseOrgIds": [
              "2SA.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento Amasa ie pido ngo pi palamularu ma ni i cing’ Yoab: kum kumeno edhuye kudo, man eolo cindie i ng’om, man egoye kendo ngo; e etho. Man Yoab kud Abicai m’umin mire gilubo tok Ceba ma wod Bikri. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.10",
            "verseOrgIds": [
              "2SA.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man jalawobi pa Yoab acel ucungo i vute, man ewacu kumae, Ng’atu m’ufoyo Yoab, ku ng’atu ma jaba Daudi, dong’ elub tok Yoab. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.11",
            "verseOrgIds": [
              "2SA.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man Amasa vuto m’ebefodre wi rimo pare i die gengi. Man kinde ma ng’atuno neno nia dhanu ceke cungo ling’, eting’o Amasa kud i gengi etere i thim, man ebolo kendi i wie, kinde m’eneno nia dhanu ceke kubang’gi kubang’gi m’ubino i vute gicungo ling’. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.12",
            "verseOrgIds": [
              "2SA.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinde ma jukabe kud i gengi, dhanu ceke gicidho gilubo Yoab, kara gilub tok Ceba ma wod Bikri.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.13",
            "verseOrgIds": [
              "2SA.20.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.13",
            "verseOrgIds": [
              "2SA.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ekadhu kud i suru mir Israel ceke cil kum Abel, man kum Beth-maka, ku Juberi ceke: e jucokogi karacelo, man gin bende gicidho i toke. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.14",
            "verseOrgIds": [
              "2SA.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man gibino gitieke kud ali i Abel mi Beth-maka; man gidhuro ng’om kum adhurane, man ecungo kum dhugang’ mi ot ma tek; man dhanu ceke ma gini ku Yoab gibemugo gang’kidi, kara ging’iele. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.15",
            "verseOrgIds": [
              "2SA.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhaku ma riek ulund ulwong’o ku i adhura kumae, Winj, winj; akwayuwu, wuwac ni Yoab kumae, Bin ceng’ni keni, kara wawec wakudi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.16",
            "verseOrgIds": [
              "2SA.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ebino ceng’ni i bang’e; man dhakune wacu kumae, In i Yoabi? Man eloko lembe kumae, An a en. Elund ewacu ire kumae, Winj lembe pa bong’ peri. Man eloko lembe kumae, Abewinjo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.17",
            "verseOrgIds": [
              "2SA.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elund eyero, ewacu kumae, Yang’ con juwacu, juwacu kumae, Gibipenjo lembapora i Abel andha: man gidaru lembe kumeca. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.18",
            "verseOrgIds": [
              "2SA.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "An a kind ju ma gi weg kwiocwiny man mandha i Israel: iyenyo inyoth adhura ku mego i kind Israel: ibimwonyo aba pa Yehova nedi? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.19",
            "verseOrgIds": [
              "2SA.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man Yoab uloko lembe ewacu kumae, Ebed bor, ebed bor ira, ma nia amwony kadi anyoth. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.20",
            "verseOrgIds": [
              "2SA.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lembene bedo kumeno ngo: ento ng’atu moko m’i ng’om gudi pa Efraim, en e Ceba ma wod Bikri ku nyinge, eting’o cinge kum ubimo, kum Daudi; mie kende, e abiai kum adhura. E dhakune wacu ni Yoab kumae, Nen, jubibolo wie i beng’i ku wi gang’kidi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.21",
            "verseOrgIds": [
              "2SA.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "E dhakune lund ucidho ba dhanu ceke ku rieko pare. E githumo wi Ceba ma wod Bikri, man gibole woko ba Yoab. E ekudho agwara, man julalugi ku kum adhurane, ku ba dhanu ceke ng’atuman ba hema pare. Man Yoab udok i Yerusalem bang’ ubimo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.22",
            "verseOrgIds": [
              "2SA.20.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.22",
            "verseOrgIds": [
              "2SA.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nie Yoab ni wi udul mir Israel ceke; man Benaya ma wod Yehoiada ni wi Jukerethi man wi Jupelethi; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.23",
            "verseOrgIds": [
              "2SA.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "man Adoram ni wi dhanu ceke ma jukethogi kum tic mi olo, man Yehocafat ma wod Ahilud en e jagorlemkei; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.24",
            "verseOrgIds": [
              "2SA.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "man Ceba en e jagorcik; man Zadok kud Abiathar gi julam; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.25",
            "verseOrgIds": [
              "2SA.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "man Ira bende ma Jajari en e jatim ma jadit ni Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.26",
            "verseOrgIds": [
              "2SA.20.26"
            ]
          }
        }
      ]
    }
  ],
  "next": {
