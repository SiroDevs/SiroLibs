            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.3.3"
              },
              "items": [
                {
                  "text": "2 Sam 3:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento Absalom uringo, man ecidho ba Talmai ma wod Amihur, m’ubimo mi Gecur. Man Daudi ywak pi wode ceng’ ku ceng’. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.37",
            "verseOrgIds": [
              "2SA.13.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2SA 13:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum kumeno Absalom uringo, man ecidho Gecur, e ebedo kuca rundi adek. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.38",
            "verseOrgIds": [
              "2SA.13.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2SA 13:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ava cidho tok Absalom unego ubimo ma Daudi: kum ejukre kum Amnon, kum etho.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.39",
            "verseOrgIds": [
              "2SA.13.39"
            ]
          }
        }
      ]
