            "style": "v",
            "sid": "2SA 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.30",
            "verseOrgIds": [
              "2SA.3.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man Daudi wacu ni Yoab, ku dhanu ceke ma gini kude kumae, Wuyec kendi mu, man wutwi gonia, wuywak de i wang’ Abner. E ubimo ma Daudi lubo tok kika mir avu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.31",
            "verseOrgIds": [
              "2SA.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man giyiko Abner i Hebron: e ubimo ting’o dwande malu, man eywak wi liend Abner; e dhanu ceke giywak. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.32",
            "verseOrgIds": [
              "2SA.3.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 3:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "E can unego ubimo kum Abner, man ewacu kumae,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.33",
            "verseOrgIds": [
              "2SA.3.33"
            ]
          }
        }
