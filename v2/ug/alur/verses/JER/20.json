            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.3.1+JOB.3.2+JOB.3.3+JOB.3.4+JOB.3.5+JOB.3.6+JOB.3.7+JOB.3.8+JOB.3.9+JOB.3.10+JOB.3.11+JOB.3.12+JOB.3.13+JOB.3.14+JOB.3.15+JOB.3.16+JOB.3.17+JOB.3.18+JOB.3.19"
              },
              "items": [
                {
                  "text": "Yob 3:1-19",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwong’ ubed wi ceng’ ma junyola i ie: kud wuyi mugisa kwany ceng’ ma ma nyola i ie. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.14",
            "verseOrgIds": [
              "JER.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwong’ ubed wi ng’atu m’ukelo rwonglembe ba vwa, m’uwacu kumae, Junyolo nyathin ma nico iri; ma junyayu ko mutoro i ie. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.15",
            "verseOrgIds": [
              "JER.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "E wek ng’atu maeno bed calu adhura ma Yehova redho, m’elokre de ngo, man wek ewinj ywak kugweno, ku kok i nindo mi dieceng’; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.16",
            "verseOrgIds": [
              "JER.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kum enega ngo kud i ic; e kuno di ma bedo ni liel para, man icne bedo dit thiri thiri. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.17",
            "verseOrgIds": [
              "JER.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pirang’o awok woko kud i ic nineno tic mi muli ku can, ma nia ceng’ para thum ku lewici?",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.18",
            "verseOrgIds": [
              "JER.20.18"
            ]
          }
        }
      ]
    }
  ],
