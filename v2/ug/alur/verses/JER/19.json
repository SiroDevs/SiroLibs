                "loc": "2KI.23.10"
              },
              "items": [
                {
                  "text": "2 Ub 23:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.30+JER.7.31+JER.7.32"
              },
              "items": [
                {
                  "text": "Yer 7:30-32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.32.34"
              },
              "items": [
                {
                  "text": "32:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.32.35"
              },
              "items": [
                {
                  "text": "35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "man iwok woko i poga pa wod Hinom, ma ni i ng’et kamondo mi dhugang’ ma Harsith, man iyer lembe m’abiyero iri kuca; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.2",
            "verseOrgIds": [
              "JER.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "man iwac kumae, Wuwinj lembe pa Yehova, E ju m’ubimo mi Yuda, man ju m’ubedo i Yerusalem: Yehova mir udul, Mungu mir Israel, uwacu kumae, Nen, abikelo lem ma rac wi kakeni, man ng’atu ma tek uwinjo, ithe biwoi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.3",
            "verseOrgIds": [
              "JER.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum giweka, man giketho kakeni ng’eire ngo, man giwang’u udok ma ng’wice ng’ar i ie ni mungu mange, ma ging’eyo ngo, gin ku kwarugi man ju m’ubimo mi Yuda, man gipong’o kakeni ku rimo mi ju m’umbe dubo, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.4",
            "verseOrgIds": [
              "JER.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.21"
              },
              "items": [
                {
                  "text": "Law 18:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "man gigomo ka ma malu mi Bal, kara giwang’ wotgi i mac ni lam m’awang’a ni Bal; m’ang’olo ngo, kadi ayero maeni de ngo, kadok i pidoic para de ebino ngo: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.5",
            "verseOrgIds": [
              "JER.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka kumeno, nen, ceng’ ubino, Yehova wacu, nia jubilwong’o kakeni Tofeth kendo ngo, kadi Poga pa wod Hinom de ngo, ento Poga mi Nek. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.6",
            "verseOrgIds": [
              "JER.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man abithiro lembapora pa Yuda ku Yerusalem i kakeni; man abiketho gipodho ku palamularu i wang’ judegi migi, man ku cing’ ju m’uyenyo kwo migi: abimio avujgi de ni winyo ma kor polo ni cemo, man ni yedi m’i ng’om. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.7",
            "verseOrgIds": [
              "JER.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man abidwoko adhura maeni ni wang’uic, ku cac; ku ba dhanu ceke m’ukadhu kud i ng’ete ie biwang’ lii man ebicayu kum masendine ceke. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.8",
            "verseOrgIds": [
              "JER.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man abiketho gicamu ring’kum wotgi ku ring’kum nyiggi; man kubang’gi kubang’gi ng’atuman bicamu ring’kum jarimbe, i atiek mir ali man i can, ma judegi migi, ku ju m’uyenyo kwo migi, gisendogi kudo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.9",
            "verseOrgIds": [
              "JER.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.9",
            "verseOrgIds": [
              "JER.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibilund turo cupa i wang’ dhanu m’ucidho kudi, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.10",
            "verseOrgIds": [
              "JER.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "man ibiwacu igi kumae, Yehova mir udul uwacu kumae, Abituro dhanu maeni kud adhura maeni kumeni, calu ng’atu moko turo agulu pa jacwiagulu, ma jucopo dwoko dho kendo ngo; e gibiyiko i Tofeth, maram ka moko bibedo umbe ma juyik i ie. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.11",
            "verseOrgIds": [
              "JER.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abitimo kumeni kum kakeni, Yehova wacu, man kum ju m’ubedo i iene de, m’abedwoko adhura maeni calu Tofeth: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.12",
            "verseOrgIds": [
              "JER.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "man udi mi Yerusalem, ku udi mi ju m’ubimo mi Yuda, ma jucido, bibedo calu ka mi Tofeth, en e udi ceke ma giwang’u udok ma ng’wice ng’ar i wie ni udul ceke m’i polo, man ma gikonjo giramadha ni mungu mange i wie. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.13",
            "verseOrgIds": [
              "JER.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeremia lund uai kud i Tofeth, ka ma Yehova ore i ie kara ceu lembaewa; man ecungo i lelagang’ mi ot pa Yehova, man ewacu ni dhanu ceke kumae: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.14",
            "verseOrgIds": [
              "JER.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova mir udul, Mungu mir Israel, uwacu kumae, Nen, abikelo lem ma rac ceke m’angolo wi adhura maeni man wi pacune ceke; kum gidwoko ng’utgi tek, kara ku giwinj lem para.",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.15",
            "verseOrgIds": [
              "JER.19.15"
            ]
          }
        }
      ]
    }
