                "loc": "ISA.17.1+ISA.17.2+ISA.17.3"
              },
              "items": [
                {
                  "text": "Isa 17:1-3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.1.3+AMO.1.4+AMO.1.5"
              },
              "items": [
                {
                  "text": "Amo 1:3-5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.9.1"
              },
              "items": [
                {
                  "text": "Zek 9:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lembe mi Dameski. Junyayu lewic wi Hamath, kud Arpad; kum giwinjo lembe ma rac, giloi: can ni wi nam; ecopo bedo yo ngo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.23",
            "verseOrgIds": [
              "JER.49.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 49:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dameski doko ng’ic, elokre gire kara eringi, man mielkum umake: ndiba ku can umake, calu dhaku m’ubenyol. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.24",
            "verseOrgIds": [
              "JER.49.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 49:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Juweko adhura mi pak ungo nedi, adhura mi mutoro para? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.25",
            "verseOrgIds": [
              "JER.49.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 49:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka kumeno awobi pare bipodho i gengine, man jubiketho dhanu mir ali ceke ling’ i ceng’ maeca, Yehova mir udul uwacu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.26",
            "verseOrgIds": [
              "JER.49.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 49:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man abicwinyo mac i gang’kidi mi Dameski, man ebiwang’u udi mi ker pa Ben-hadad.",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.27",
            "verseOrgIds": [
              "JER.49.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 49:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.27",
            "verseOrgIds": [
              "JER.49.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 49:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lembe mi Kedar, man mi ker mi Hazor, ma Nebukadrezar m’ubimo mi Babeli goyo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.28",
            "verseOrgIds": [
              "JER.49.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 49:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wacu kumae: Wuai, wuidh malu ba Kedar, man wunyoth nyithindho ma yo nyangu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.28",
            "verseOrgIds": [
              "JER.49.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 49:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gibimaku hema migi kud udul rombe migi; gibiyaku bongu m’ang’aba migi, kud agulu migi ceke, man ngamia migi, igi gigi; e gibikok igi kumae, Ndiri ni kun ku kun mire! ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.29",
            "verseOrgIds": [
              "JER.49.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 49:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuringi, wucidh bor, wubed i ka ma thuth, E wu ju m’ubedo i Hazor, Yehova wacu; kum Nebukadrezar m’ubimo mi Babeli poro lembe i kumwu, man ekeco lembe i kumwu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.30",
            "verseOrgIds": [
              "JER.49.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 49:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuai, wuidh ba thek m’ubedo yo, m’ubedo museme, Yehova wacu; m’ubedo ku dhugang’kadi utwindi de ngo, m’ubedo kendgi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.31",
            "verseOrgIds": [
              "JER.49.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 49:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "E ngamia migi bibedo ni ayeki, man udul lim migi ni ayeki: man abilalu ju m’unyaru semba tikgi ni yamu ceke; man abikelo ruvwa migi kud i ng’etgi kun ku kun, Yehova wacu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.32",
            "verseOrgIds": [
              "JER.49.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 49:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man Hazor bidoko ni kabedo mir utho, uvuru mi nja: ng’atu moko mbe ma bibedo kuca, kadok wod dhanu moko de bibedo ngo i ie ni umondo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.33",
            "verseOrgIds": [
              "JER.49.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 49:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.33",
            "verseOrgIds": [
              "JER.49.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 49:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lembe pa Yehova m’ubino ba Yeremia ma jabila pi Elam, i thekri mi camuker pa Zedekia m’ubimo mi Yuda, m’uwacu kumae, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.34",
            "verseOrgIds": [
              "JER.49.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 49:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova mir udul uwacu kumae: Nen, abituro atum mir Elam, dit mi tego migi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.35",
            "verseOrgIds": [
              "JER.49.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JER 49:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man abikelo yamu ang’wen wi Elam kud i gund polo ang’wen, man abilalugi yo ba yamu maeno ceke; man thek moko bibedo umbe ma ju ma juriemo kubitundo i ie ngo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.36",
            "verseOrgIds": [
              "JER.49.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JER 49:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man abiketho cwiny Elam ng’abre i wang’ judegi migi, man i wang’ ju m’uyenyo kwo migi; man abikelo lem ma rac i wigi, en e ng’ecwiny para ma lake tek, Yehova wacu; man abioro palamularu i tokgi, maram adaru kogi: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.37",
            "verseOrgIds": [
              "JER.49.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JER 49:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "man abiketho komker para i Elam, man abinyotho ubimo ku judongomawijo ku kuca, Yehova wacu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.38",
            "verseOrgIds": [
              "JER.49.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JER 49:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento ebitimbre i nindo ma cen, nia abidwoko ng’eca mir Elam, Yehova wacu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.39",
            "verseOrgIds": [
              "JER.49.39"
            ]
          }
        }
      ]
    }
  ],
