{
  "id": "JER.13",
  "number": "13",
  "bookId": "JER",
  "reference": "Yeremia 13",
  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "JER 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova lund uwacu ira kumae, Cidhi, man ing’ieu iri thondhpier mi bongu ma nwang’, man itwie i pieri, man kud ikethe i pi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.1",
            "verseOrgIds": [
              "JER.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum kumeno ang’iewo thondhpier calku lembe pa Yehova, man atwie i piera. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.2",
            "verseOrgIds": [
              "JER.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "E lembe pa Yehova bino i bang’a wang’ arionde, m’uwacu kumae, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.3",
            "verseOrgIds": [
              "JER.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ting’ thondhpier m’ing’iewo, ma ni i pieri, man iai, icidh i Frati, man ipane kuca i odcana. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.4",
            "verseOrgIds": [
              "JER.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum kumeno acidho, man apane dhu Frati, calu Yehova ng’olo ira. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.5",
            "verseOrgIds": [
              "JER.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man etimbre yo ng’ei nindo dupa, nia Yehova wacu ira kumae, Ai, cidh i Frati, man igam thondhpier ku kuca, m’ang’olo iri ya ipan kuca. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.6",
            "verseOrgIds": [
              "JER.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alund acidho i Frati, man akunyo, e ating’o thondhpier ku ka m’akane i ie; man, nen, thondhpier udoko rac, kulokane mbe mi gin moko.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.7",
            "verseOrgIds": [
              "JER.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.7",
            "verseOrgIds": [
              "JER.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lembe pa Yehova lund ubino i bang’a, m’uwacu kumae, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.8",
            "verseOrgIds": [
              "JER.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wacu kumae, Abinyotho kuhaya pa Yuda kumeca, man kuhaya ma dit mi Yerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.9",
            "verseOrgIds": [
              "JER.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhanu ma rac maeni, m’ukwero winjo lembe para, m’uwotho i udhuko mir adundegi, man m’ucidho tok mungu mange kara gitim igi, man kara girwo igi, gibibedo cil calu thondhpier maeni, ma kulokane mbe mi gin moko. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.10",
            "verseOrgIds": [
              "JER.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum calu thondhpier moko kum dhanu, e aketho ot mi Yuda ku ot mir Israel ceke moko i kuma kumeca, Yehova wacu; kara gibed ira ni dhanu, man ni nying’, ni pak de, man ni dwong’: ento giyenyo ngo giwinji.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.11",
            "verseOrgIds": [
              "JER.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.11",
            "verseOrgIds": [
              "JER.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka kumeno yer igi lembe maeni: Yehova, Mungu mir Israel, uwacu kumae, Jubipong’o cupa kubang’e kubang’e ku pigulok: man gibiwacu iri kumae, Wang’eyo ngo andha nia cupa kubang’e kubang’e jubipong’o ku piguloki? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.12",
            "verseOrgIds": [
              "JER.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibilund wacu igi kumae, Yehova wacu kumae, Nen, abipong’o ju m’ubedo i ng’om maeni ceke, cil ju m’ubimo m’ujany wi komker pa Daudi, ku julam, man jubila, ku ju m’ubedo i Yerusalem ceke, ku merkong’o. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.13",
            "verseOrgIds": [
              "JER.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man abirwadugi acel kum wadi, en e wego ku wodo karacelo, Yehova wacu: kisa binega ngo, kadi abiweko de ngo, kadi kisa de binega ngo, kara kud anyothgi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.14",
            "verseOrgIds": [
              "JER.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.14",
            "verseOrgIds": [
              "JER.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuwinji, man wucik ithwu; kuhaya kud utimwu; kum Yehova yero. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.15",
            "verseOrgIds": [
              "JER.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi dwong’ ni Yehova Mungu mu, ma fok’ewodho mudho, man ma fodi tiendwu kukier ungo wi gudi mi mudho, man, kinde ma wukio der, eloke ni tipopiny mi tho, man edwoke ni mudho ma bii. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.16",
            "verseOrgIds": [
              "JER.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento tek wubiwinjo maeni ngo, ng’eyong’ec para biywak mung’ mung’ pi kuhaya mu; man wang’a biywak hai, man ebimolo piwang’, kum juyaku udul pa Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.17",
            "verseOrgIds": [
              "JER.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.17",
            "verseOrgIds": [
              "JER.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wac ni ubirao ku min ubimo kumae, Wujwigri giwu, wubed piny kum giiatwia mu m’i wic ugonjie, en e jamkermiwic mi dwong’ mu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.18",
            "verseOrgIds": [
              "JER.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adhura ma yor ariwa ma piny juciko, man ng’atu moko mbe ma yabugi: juyaku Yuda ni ng’eca, kare ceke; juyake dho ni ng’eca.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.19",
            "verseOrgIds": [
              "JER.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.19",
            "verseOrgIds": [
              "JER.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ting’ weng’i malu, man inen ju m’uai yor ariwa ma malu: udul rombe rria jumio iri ni kani, udul rombe peri ma leng’i? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.20",
            "verseOrgIds": [
              "JER.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihiwacu ang’o, kinde m’ebiliewi, kum in giri iponjogi i kumi, en e jurimbi kara gibed ni wic i wii? can bimeki ngo, calu pa dhaku m’ubenyoli? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.21",
            "verseOrgIds": [
              "JER.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man tek iwacu i adundeni kumae, Pirang’o gin maeni wok i kuma? kum dit mi kier peri dhu kendi peri bedo ayaba, man ufunytiendi nwang’u rop. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.22",
            "verseOrgIds": [
              "JER.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jaethiopia copo loko dendkume, kadi ng’u de copo loko kume ma cukucuku? tek kumeno e wun de wucopo timo ber, ma wung’io kutimo rac. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.23",
            "verseOrgIds": [
              "JER.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka kumeno abilalugi, calu soka ma kadhu cen, ku yamu mi langa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.24",
            "verseOrgIds": [
              "JER.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maeni gagi peri, makapiny ma juporo iri m’uai i bang’a, Yehova wacu; kum wii wil i kuma, man igeno lemndra. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.25",
            "verseOrgIds": [
              "JER.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka kumeno an bende abiyabu dhu kendi peri i weng’i, man lewic peri binyuthre. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.26",
            "verseOrgIds": [
              "JER.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aneno ginmajudagu peri, en e dubri swa peri, man kok peri, en e tarwang’ mir asara peri, wi ungulu gudi i thim. Can i wii, E Yerusalem! iyeny o ngo judwoki leng’; fodi ebibedo rokani?",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.27",
            "verseOrgIds": [
              "JER.13.27"
            ]
          }
        }
      ]
    }
  ],
