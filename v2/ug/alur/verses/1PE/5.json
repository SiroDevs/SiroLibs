                "loc": "ACT.15.40"
              },
              "items": [
                {
                  "text": "40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Agoro iwu ku lembe ma nyanok, aoro ku cing’ Siluano, m’umegwa mandha, calu akwane, abejuko man abetuco nia maeni en e bero mandha pa Mungu: wucung ki i ie. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.12",
            "verseOrgIds": [
              "1PE.5.12"
            ]
          }
        },
        {
