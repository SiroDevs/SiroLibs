          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwiocwiny ubed i beng’wu ceke wu ju ma wuni i Kristu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.14",
            "verseOrgIds": [
              "1PE.5.14"
            ]
          }
        }
