                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwir agba mi kwen ma thobi mbe i ie. Cam kwen ma thobi mbe i ie ceng’ abiro, calu ang’olo iri, i nindo ma juketho i dwi Abib;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.18",
            "verseOrgIds": [
              "EXO.34.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "Abib = dwi mir acende mi Juyahudi dwi mir adege ku mir ang’wonde mi oro mwa.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kum iai kud i Misiri i dwi Abib. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.18",
            "verseOrgIds": [
              "EXO.34.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 34:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.13.2"
              },
              "items": [
                {
                  "text": "Ai 13:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gin ceke m’uyabu ic en e para; lim peri ceke ma coge, kayu mi dhiang’ man mi rombe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.19",
            "verseOrgIds": [
              "EXO.34.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 34:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.13.13"
              },
              "items": [
                {
                  "text": "Ai 13:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "War kayu mi kana ku nyathi rombo: man tek iware ngo, ilund itur ng’ute. War kayu ceke mi woti. Man ng’atu moko mbe ma biwok i wang’a ma cinge nanu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.20",
            "verseOrgIds": [
              "EXO.34.20"
            ]
          }
        }
      ]
    },
