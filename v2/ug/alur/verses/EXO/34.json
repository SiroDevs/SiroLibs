                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man ikwir agba mi yenga, en e mi mwoka mi palacam mi nganu, man agba mi cokopiny i kakan i kajik rundi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.22",
            "verseOrgIds": [
              "EXO.34.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 34:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Co peri ceke binyuthri i wang’ Rwoth Yehova, Mungu mir Israel, wang’ adek i rundi acel. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.23",
            "verseOrgIds": [
              "EXO.34.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum abiriemo thek woko i weng’i, man abimedo kieu peri: kadok ng’om peri de ng’atu moko mbe ma biyenye, kinde m’iidho malu kara ithieri i wang’ Yehova Mungu peri wang’ adek i rundi acel.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.24",
            "verseOrgIds": [
              "EXO.34.24"
            ]
          }
        }
