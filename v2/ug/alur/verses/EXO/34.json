                "loc": "DEU.27.15"
              },
              "items": [
                {
                  "text": "27:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kud itim mungu m’acwia m’atwaga iri ki.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.17",
            "verseOrgIds": [
              "EXO.34.17"
            ]
          }
        }
      ]
