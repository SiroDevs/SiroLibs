              "type": "text"
            }
          ]
        },
        {
          "text": "Kud ithier rimo mi lam para ku kwen ma thobi ni i ie; kadok lam mir agba mi kadhukuwijo de kud wuwek mi kugweno. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.25",
