              "items": [
                {
                  "text": "Ezr 2:63",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.7.65"
              },
              "items": [
                {
                  "text": "Neh 7:65",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man iketh Urim ku Thumim i jambkor mi pokolembe; man gibibedo wi adunde Harun, kinde m’emondo i wang’ Yehova: man Harun biyeyo pokolembe mi nyithindho mir Israel wi adundene i wang’ Yehova thiri thiri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.30",
            "verseOrgIds": [
              "EXO.28.30"
            ]
          }
        }
      ]
    },
