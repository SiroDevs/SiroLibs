              "EXO.38.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.30.18"
              },
              "items": [
                {
                  "text": "Ai 30:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man etimo jamblogo mi mola, man there ku mola, mi kieu mi mon mi timotim ma gitimo giratima i dhugola mi hema mi cokri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.8",
            "verseOrgIds": [
              "EXO.38.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.8",
            "verseOrgIds": [
              "EXO.38.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 38:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man etimo lelagang’: mi ng’ete ma piny yo piny gang’bongu mi lelagang’ en e mi bongu ma nwang’ ma ber m’awia, bot dak acel; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.9",
            "verseOrgIds": [
              "EXO.38.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 38:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbegine pier ario, man werne pier ario, mi mola; gol mi mbegi ku jambribne en e mi mola ma tar. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.10",
            "verseOrgIds": [
              "EXO.38.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 38:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man i ng’ete ma yor ariwa ma malu bot dak acel, mbegine pier ario, man werne pier ario, mi mola; gol mi mbegi, ku jambribne, mi mola ma tar. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.11",
            "verseOrgIds": [
              "EXO.38.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 38:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man mi ng’ete ma yo reto gang’bongu nuti bot pier abic, mbegine apar, man werne apar; gol mi mbegine, ku jambribne, mi mola ma tar. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.12",
            "verseOrgIds": [
              "EXO.38.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 38:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man mi ng’ete ma yo nyangu m’ulokre yo nyangu bot pier abic. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.13",
            "verseOrgIds": [
              "EXO.38.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 38:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gang’bongu mi ng’ete kucel mi dhugang’ en e bot apar wi abic; mbegine adek, man werne adek; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.14",
            "verseOrgIds": [
              "EXO.38.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 38:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "man mi ng’ete mucelo de kumeca; yo ku cing’ kucel man yo ku cing’ mucelo ba dhugang’ mi lelagang’ gang’bongu nuti bot apar wi abic; mbegine adek, man werne adek. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.15",
            "verseOrgIds": [
              "EXO.38.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 38:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gang’bongu ceke mi lelagang’ m’utieke gbur en e mi bongu ma nwang’ ma ber m’awia. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.16",
            "verseOrgIds": [
              "EXO.38.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 38:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man wer mi mbegi en e mi mola; gol mi mbegi, ku jambribne, mi mola ma tar; man jambum mi wie, en e mi mola ma tar; man mbegi ceke mi mola mi lelagang’ juribo ku mola ma tar. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.17",
            "verseOrgIds": [
              "EXO.38.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 38:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man voi mi dhugang’ mi lelagang’ en e tic pa jakwoc mi ruko, mi m’ulweku, ku m’uluga, man ma kwar ngbo, ku bongu ma nwang’ ma ber, m’awia: man kaborne bot pier ario, man kadongone i kalacne bot abic; m’erombo ku gang’bongu mi lelagang’. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.18",
            "verseOrgIds": [
              "EXO.38.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 38:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man mbegine ang’wen, werne de ang’wen, mi mola; golne mi mola ma tar, man jambum mi wie, ku jambribne de, mi mola ma tar. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.19",
            "verseOrgIds": [
              "EXO.38.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 38:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man gute ceke mi hema, man mi lelagang’ utieke gbur, en e mi mola.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.20",
            "verseOrgIds": [
              "EXO.38.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 38:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.20",
            "verseOrgIds": [
              "EXO.38.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 38:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maeni en e wel jamb hema, en e hema mi lembatuca, calu jukwanugi, calku lembang’ola pa Musa, mi timotim mi Julawi, ku cing’ Ithamar, ma wod Harun ma jalam. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.21",
            "verseOrgIds": [
              "EXO.38.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 38:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man Bezalel ma wod Uri, ma wod Hur, mi suru pa Yuda, utimo gin ceke ma Yehova ng’olo ni Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.22",
            "verseOrgIds": [
              "EXO.38.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 38:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man Aholiab ma wod Ahisamak, mi suru pa Dan, ni karacelo kude m’e jang’ikpiny, man jatic ma riek, man jakwoc mi ruko i gin m’ulweku, man m’uluga, ku gin ma kwar ngbo, man mi bongu ma nwang’ ma ber.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.23",
            "verseOrgIds": [
              "EXO.38.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 38:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.23",
            "verseOrgIds": [
              "EXO.38.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 38:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mola ma kwar ceke ma jutimo ko tije i tic ceke mi kamaleng’, cil mola ma kwar ma juthiero, en e talanto pier ario wi abung’wen, man cekel dak abiro ku pier adek, calku cekel mi kamaleng’. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.24",
            "verseOrgIds": [
              "EXO.38.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 38:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.30.11+EXO.30.12+EXO.30.13+EXO.30.14+EXO.30.15+EXO.30.16"
              },
              "items": [
                {
                  "text": "Ai 30:11-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man mola ma tar mi ju ma jukwanu mir udul en e talanto dak acel, man cekel rubanga acel ku dak abiro ku pier abiro wi abic, calku cekel mi kamaleng’: ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.25",
            "verseOrgIds": [
              "EXO.38.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 38:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.17.24"
              },
              "items": [
                {
                  "text": "Mt 17:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ku ba wie ku ba beka, thelembene, ng’et cekel, calku cekel mi kamaleng’, kum ku ba dhanu ceke m’ukadhu ba ju ma jukwanugi, ugambre kum rundi pier ario ku ma sagu, mi dhanu ma co rubanga dak abusiel ku wi adek ku dak abic ku pier abic. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.26",
            "verseOrgIds": [
              "EXO.38.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 38:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man talanto dak acel mi mola ma tar en e mi thiedho wer mi kamaleng’, ku wer mi kusikabongu; wer dak acel mi talanto dak acel, talanto acel mi wer acel. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.27",
            "verseOrgIds": [
              "EXO.38.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 38:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man etimo gol mi mbegi ku cekel rubanga ku dak abiro ku pier abiro wi abic, man emwono wigi, man etimo jambrib igi. ",
          "type": "text",
