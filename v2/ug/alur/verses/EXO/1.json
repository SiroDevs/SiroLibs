              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.7",
            "verseOrgIds": [
              "EXO.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.8",
            "verseOrgIds": [
              "EXO.1.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.18"
              },
              "items": [
                {
                  "text": "Tic 7:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nie ubimo ma nyen uwok wi Misiri, m’ung’eyo Yusuf ungo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.8",
            "verseOrgIds": [
              "EXO.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ewacu ni dhanu pare kumae, Nen, dhanu mi nyithindho mir Israel welgi ku tego migi sagu mwa: ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.9",
            "verseOrgIds": [
              "EXO.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.19"
              },
              "items": [
                {
                  "text": "Tic 7:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "wubin, wek watimu ku rieko i kumgi, gimaru nyai dit, man emaru timbre, nia, kinde ma ali moko wok, gin bende gimaru ci ribri ku judegi mwa, man gikied kudwa, man giai kud i ng’ombuni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.10",
            "verseOrgIds": [
              "EXO.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka kumeno giketho juwitic i wigi kara usendgi ku ter migi. Man gigomo adhura mi kanupiny Pithom ku Ramses, ni Farao. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.11",
            "verseOrgIds": [
              "EXO.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento kadok gisendogi, de gimedri ma sagu man gimoiri foo. Man lembe ton i igi kum nyithindho mir Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.12",
            "verseOrgIds": [
              "EXO.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man Jumisiri giketho nyithindho mir Israel gitim ma tek: ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.13",
            "verseOrgIds": [
              "EXO.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "e giketho bedo migi bedo rac ku tic ma tek, mir ulobo man biriki, man ku tic ceke de ma kwonde tung’ tung’ i thim, en e tic migi ceke, ma giketho gitimo ma tek i ie.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.14",
            "verseOrgIds": [
              "EXO.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.14",
            "verseOrgIds": [
              "EXO.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ubimo mi Misiri yero ni jucolmon mi Juebrania, ma nying’ ng’atu acel m’i kindgi en e Cifra, man nying’ mucelo Pua: ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.15",
            "verseOrgIds": [
              "EXO.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "man ewacu kumae, Kinde ma wubecolo mon mi Juebrania, man wuneno gibenyol; tek en e nico, e wubinege; ento tek en e nyaku, e ebibedo kwo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.16",
            "verseOrgIds": [
              "EXO.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento jucolmon gilworo Mungu, man gitimo calu ubimo mi Misiri ng’olo igi ngo, ento gibodho nyithindho ma co ma kwo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.17",
            "verseOrgIds": [
              "EXO.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ubimo mi Misiri lwong’o jucolmon, man ewacu igi kumae, Nedi wutimo gin maeni, man wubodho nyithindho ma co ma kwo? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.18",
            "verseOrgIds": [
              "EXO.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man jucolmon giwacu ni Farao kumae, Kum mon mi Juebrania gi calu mon mi Jumisiri ngo; kum gi tek, man ginyol ma fodi jucolmon kubino i bang’gi ngo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.19",
            "verseOrgIds": [
              "EXO.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "E Mungu timo ber ba jucolmon: man dhanu medre, e gidoko dit apila. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.20",
            "verseOrgIds": [
              "EXO.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man etimbre, kum jucolmon ulworo Mungu, nia eketho udi migi cungo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.21",
            "verseOrgIds": [
              "EXO.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.19"
              },
              "items": [
                {
                  "text": "Tic 7:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man Farao ng’olo ni dhanu pare ceke, ewacu kumae, Ku ba nyithindho ma co ceke ma junyolo wubibologi i kulo, man ku ba nyithindho ma nyir ceke wubiweko gibedo kwo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.22",
            "verseOrgIds": [
              "EXO.1.22"
            ]
          }
        }
      ]
    }
  ],
