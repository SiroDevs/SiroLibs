          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "m’anyutho kisa ni rubanga mi ju m’umara m’uworo lembang’ola para.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.6",
            "verseOrgIds": [
              "EXO.20.6"
            ]
