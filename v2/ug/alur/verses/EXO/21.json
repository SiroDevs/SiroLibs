          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man tek ekiro lak jamiru pare, kadi lak bong’ pare; ebigonye pi lake.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.27",
