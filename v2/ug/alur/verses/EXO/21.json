              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man tek ng’atu moko goyo jamiru pare, kadi bong’ pare, kud ukede, man etho the cinge; jubisende andha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.20",
            "verseOrgIds": [
