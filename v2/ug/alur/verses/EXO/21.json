          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento, tek ebedo ceng’ acel kadi ario, jubisende ngo: kum en e sente pare.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.21",
