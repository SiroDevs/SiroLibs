            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man tek dhanu gidhau, man ng’atu acel ucanyu wadi ku kidi, kadi ku cinge m’adola, man etho ngo, ento evuto wi kavuto pare; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.18",
            "verseOrgIds": [
              "EXO.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "tek eai malu kendo, man ewotho woko kud uluth pare, e ng’atu m’ugoye bilund bedo ma lembe mbe i wie: ere ebiculo pi nindo pare m’ukadhu mananu, man ebigwoke maram kume kei ko ma gwei.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.19",
            "verseOrgIds": [
              "EXO.21.19"
            ]
