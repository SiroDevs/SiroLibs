            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.20.1+JOS.20.2+JOS.20.3+JOS.20.4+JOS.20.5+JOS.20.6+JOS.20.7+JOS.20.8+JOS.20.9"
              },
              "items": [
                {
                  "text": "Yoc 20:1-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man tek ng’atu moko kanu adhi ngo, ento Mungu kethe i cinge; abilund ng’olo iri ka m’ering i ie. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.13",
            "verseOrgIds": [
              "EXO.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man tek ng’atu moko bino kum wadi aka, kara enege ku riu; ibikabe ku ba pemblam para, kara etho.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.14",
            "verseOrgIds": [
              "EXO.21.14"
            ]
          }
        }
      ]
    },
