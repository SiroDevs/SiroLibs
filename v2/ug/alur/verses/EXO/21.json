        },
        {
          "text": "Man tek ng’atu moko biyabu wi vur, man tek ng’atu moko bikunyo vur man eume ngo, e koni dhiang’ kadi kana podho i ie, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.33",
            "verseOrgIds": [
