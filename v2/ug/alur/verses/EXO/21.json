          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "won vurne biculo; ebimio sente ni won, e lim m’utho bibedo pare.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.34",
