          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man emio ban ario mi lembatuca ni Musa, ban mi kidi, m’ubedo agora ku lwet Mungu, kinde m’edaru weco kude wi got Sinai.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.18",
            "verseOrgIds": [
              "EXO.31.18"
            ]
          }
        }
