              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.11",
            "verseOrgIds": [
              "EXO.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "E Yehova yero ni Musa, ewacu kumae, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.12",
            "verseOrgIds": [
              "EXO.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yer ni nyithindho mir Israel bende, wac kumae, Wugwok sabatu para andha: kum en e giranyutha i kindwa wakudu cil i dhanum’utuk mu ceke; kara wung’ei nia an a Yehova m’udwokowu leng’ ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.13",
            "verseOrgIds": [
              "EXO.31.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka kumeno wukwir ceng’ sabatu; kum en e leng’ iwu: ku ba dhanu ceke m’ucide jubiketho etho andha; kum ng’atu ma tek utimo tic moko i ie, jubikabu ng’eyong’ec maeno woko ku kind juthugi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.14",
            "verseOrgIds": [
              "EXO.31.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
