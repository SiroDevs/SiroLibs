              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.12+DEU.5.13+DEU.5.14"
              },
              "items": [
                {
                  "text": "Poi 5:12-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jutim tic ceng’ abusiel; ento ceng’ mir abirone en e sabatu mi yom mandha, e leng’ ni Yehova; ng’atu ma tek utimo tic moko i ceng’ sabatu, jubiketho etho andha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.15",
            "verseOrgIds": [
              "EXO.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum kumeno nyithindho mir Israel bikwiro ceng’ sabatu, kara giwor ceng’ sabatu i kind dhanum’utuk migi ceke, mi lembariba mi nja. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.16",
            "verseOrgIds": [
              "EXO.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.11"
              },
              "items": [
                {
                  "text": "Ai 20:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "En e giranyutha i kindwa waku nyithindho mir Israel mi nja: kum Yehova timo polo ku ng’om i ceng’ abusiel, man i ceng’ mir abirone eyom, man edwoko cwinye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.17",
            "verseOrgIds": [
              "EXO.31.17"
            ]
          }
        }
      ]
    },
