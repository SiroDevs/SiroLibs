              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man iketh kabedomikisa wi sanduk mi lembatuca i kamaleng’ m’usagu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.34",
            "verseOrgIds": [
              "EXO.26.34"
            ]
          }
        },
