          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.24",
            "verseOrgIds": [
              "EXO.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "E ceng’ abiro kadhu, yo ng’ei kulo ma Yehova goyo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.25",
            "verseOrgIds": [
              "EXO.7.25"
            ]
          }
        }
      ]
    }
  ],
