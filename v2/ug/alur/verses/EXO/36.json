          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "man mbegi abic pire ku golne: man emwono wie ku jambwicne ku mola ma kwar; man weme abic en e mi mola.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.38",
