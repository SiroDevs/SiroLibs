          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man etimo riu ku yendulu; riu abic mi bau mi ng’et hema acel, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.31",
            "verseOrgIds": [
              "EXO.36.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 36:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "man riu abic mi bau mi ng’et hema mucelo, man riu abic mi bau mi hema ma yor i ng’eye yo reto. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.32",
            "verseOrgIds": [
              "EXO.36.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 36:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man etimo riu m’i diere ukadhu ku kind bau ugambre i ng’ete kucel utundo kum ng’ete mucelo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.33",
            "verseOrgIds": [
              "EXO.36.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 36:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man emwono bau ku mola ma kwar, man etimo wende ku mola ma kwar mi kaka riu, man emwono riu ku mola ma kwar.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.34",
            "verseOrgIds": [
              "EXO.36.34"
            ]
          }
        }
      ]
