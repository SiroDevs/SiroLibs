          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man egoro waraga ni Juyahudi ceke, ni ng’etker dak acel ku pier ario wi abiro mi ker pa Ahasuerus, ku lembe mi kwiocwiny man lemandha, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.30",
            "verseOrgIds": [
              "EST.9.30"
            ]
