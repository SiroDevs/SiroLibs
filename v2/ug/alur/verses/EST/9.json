              "type": "text"
            }
          ]
        },
        {
          "text": "Ester ma ci ubimo, ma nyar Abihail, ku Mordekai ma Jayahudi, gilund gigoro ng’ol ceke kara giketh waraga mir arionde mi Purim ucungi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.29",
            "verseOrgIds": [
              "EST.9.29"
            ]
          }
