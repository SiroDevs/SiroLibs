            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man eponjo ceng’ ku ceng’ i hekalu. Ento julam ma dongo ku jugorik de ku judongo mi dhanu giyenyo ginyothe: ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.47",
            "verseOrgIds": [
              "LUK.19.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
