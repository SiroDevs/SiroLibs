          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "E kan edhingo ceng’ni, eneno adhura eywak de i kume, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.41",
            "verseOrgIds": [
              "LUK.19.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 19:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "ewacu kumae, E, tinuni tek nwang’u ing’eyo gin ma mi kwiocwiny peri! ento kawono gimungri i weng’i. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.42",
            "verseOrgIds": [
              "LUK.19.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 19:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum ceng’ biwok i kumi, ka jukwoji bidhuro ng’om i theri, man gibitieki kingli, man gibikuri kun ku kun ceke, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.43",
            "verseOrgIds": [
              "LUK.19.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 19:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "man gibiredhi i ng’om, ku nyithindho peri ma ni ii; man gibiweko kidi acel de ngo wi wagi ii; kum ing’eyo ngo nindo mi lieu peri.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.44",
            "verseOrgIds": [
              "LUK.19.44"
            ]
          }
        }
      ]
    },
