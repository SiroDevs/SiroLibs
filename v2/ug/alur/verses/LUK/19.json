          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "e ginwang’u ngo gin ma gicopo timo: kum dhanu ceke gidikri i kume, niwinje.",
          "type": "text",
          "attrs": {
