              "items": [
                {
                  "text": "Yer 7:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ewacu igi kumae, Egore kumae, Man ot para bibedo odrwo: ento wudwoke ni kagonjo mi weg ayeki.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.46",
            "verseOrgIds": [
              "LUK.19.46"
            ]
          }
        }
