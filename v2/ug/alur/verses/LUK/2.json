                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ka gidaru gin ceke calu cik pa Rwoth uwacu, gidok Galilaya, bang’ adhura migi ma dhe ma Nazareti.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.39",
            "verseOrgIds": [
              "LUK.2.39"
            ]
          }
        }
      ]
