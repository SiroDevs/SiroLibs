          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyathin udongo, tego medre ire, rieko de pong’e: man bero pa Mungu ni i wie.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.40",
