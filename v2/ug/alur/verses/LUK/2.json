              "items": [
                {
                  "text": "Lem 3:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E Yesu dongo man ecikucidho i rieko, man i bero ni Mungu ku dhanu bende.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.52",
            "verseOrgIds": [
