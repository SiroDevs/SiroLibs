                "loc": "LEV.12.3"
              },
              "items": [
                {
                  "text": "Law 12:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.31"
              },
              "items": [
                {
                  "text": "Lk 1:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ceng’ abora romo mi timo yaa i kume, jucaku nyinge Yesu, calu malaika lwong’o ma fodi jukugamu icne ngo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.21",
            "verseOrgIds": [
              "LUK.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.21",
            "verseOrgIds": [
              "LUK.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ceng’ uromo mi dwokri leng’ migi calku cik pa Musa, gikele malu Yerusalem nithiere ba Rwoth ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.22",
            "verseOrgIds": [
              "LUK.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.13.2"
              },
              "items": [
                {
                  "text": "Ai 13:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.13.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "(calu egore i cik pa Rwoth kumae, Ku ba co ceke m’uyabu i min jubilwong’e leng’ ni Rwoth), ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.23",
            "verseOrgIds": [
              "LUK.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.12.6+LEV.12.7+LEV.12.8"
              },
              "items": [
                {
                  "text": "Law 12:6-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "man niwodho lam calu cik pa Rwoth uwacu kumae, Akuru ario, kadi nyithindh akuru ario. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.24",
            "verseOrgIds": [
              "LUK.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man nen, ng’atu moko nuti Yerusalem, ma nyinge Simeon; ng’atu maeni ng’atu ma pwe ma lworo Mungu de, m’ebekio juk mir Israel: Tipo Maleng’ de ni i wie. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.25",
            "verseOrgIds": [
              "LUK.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man Tipo Maleng’ unyutho ire nia ebineno tho ngo, ma fokeneno Kristu pa Rwoth ungo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.26",
            "verseOrgIds": [
              "LUK.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ebino i hekalu m’eni i Tipo: ka junyodo pa Yesu gikelo nyathin Yesu i ie, kara gitim i kume calku kura cik, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.27",
            "verseOrgIds": [
              "LUK.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "elund ejole i bote, emio mugisa ni Mungu, ewacu kumae,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.28",
            "verseOrgIds": [
              "LUK.2.28"
            ]
          }
        }
      ]
    },
