                  "text": "Lk 19:47",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "E ku ba ceng’ ceke eponjo i hekalu; man ku ba diewor ceke ecidho woko, man egonjo wi got ma julwong’o Zeituni. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.37",
            "verseOrgIds": [
              "LUK.21.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 21:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhanu ceke de bino i bang’e pir kugweno i hekalu niwinje.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.38",
            "verseOrgIds": [
              "LUK.21.38"
            ]
