                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.13.20"
              },
              "items": [
                {
                  "text": "Yoh 13:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ng’atu m’uwinjowu nwang’u ewinjo an; ng’atu m’ukwerowu nwang’u ekwero an; man ng’atu m’ukwero an nwang’u ekwero ng’atu m’uora.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.16",
            "verseOrgIds": [
              "LUK.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
