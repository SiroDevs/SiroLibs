                "loc": "ZEC.9.2+ZEC.9.3+ZEC.9.4"
              },
              "items": [
                {
                  "text": "Zek 9:2-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Can i wii, Korazin! can i wii, Bethsaida! kum tek tic ma tek m’utimbre i iwu utimbre i Turo ku Sidon, kuno di gilokri con, ku bedo i usuba man vuru. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.13",
            "verseOrgIds": [
              "LUK.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento lembe mi Turo ku Sidon bibedo ber ma sagu mu, i ceng’ pokolembe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.14",
            "verseOrgIds": [
              "LUK.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.14.13+ISA.14.14+ISA.14.15"
              },
              "items": [
                {
                  "text": "Isa 14:13-15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "In de, Kapernaum, jubidodi malu i polo? jubijwigi piny i Hadeya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.15",
            "verseOrgIds": [
              "LUK.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.40"
              },
              "items": [
                {
                  "text": "Mt 10:40",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.9.37"
              },
              "items": [
                {
                  "text": "Mk 9:37",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.9.48"
              },
              "items": [
                {
                  "text": "Lk 9:48",
