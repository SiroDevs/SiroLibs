                "loc": "LUK.8.16"
              },
              "items": [
                {
                  "text": "Lk 8:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ng’atu moko mbe, ma kan ecwinyo thala, ekethe the ot, kadok the katoko, ento wi thethala, kara ju m’umondo ginen der. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.33",
            "verseOrgIds": [
              "LUK.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thala mi kumi en e weng’i: ka weng’i cungo acel, kumi dho bende pong’ ku der; ento kan ebedo rac, kumi bende pong’ ku mudho. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.34",
            "verseOrgIds": [
              "LUK.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka kumeno nen tek der ma ni ii kud ubed ni mudho. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.35",
            "verseOrgIds": [
              "LUK.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka kumeno tek kumi dho pong’ ku der, ma ng’ete kucel col ungo, nwang’u ebibedo pong’ ku der kwa, calu ka thala mio iri der ku rienyne ma ber.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.36",
            "verseOrgIds": [
              "LUK.11.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
