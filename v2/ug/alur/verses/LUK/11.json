              },
              "items": [
                {
                  "text": "Yon 3:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kum calu Yona doko giranyutha ni Junineve, e Wod dhanu bende bibedo kumeno ni dhanum’utuk maeni, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.30",
            "verseOrgIds": [
              "LUK.11.30"
            ]
          }
        },
        {
