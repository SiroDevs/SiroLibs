              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "kum abedo ku utumira abic; kara eyer igi, kara gin bende ku gibin i ka ndiba maeni. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.28",
            "verseOrgIds": [
              "LUK.16.28"
            ]
          }
