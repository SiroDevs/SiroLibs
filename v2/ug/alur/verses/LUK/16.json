          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento Ibrahim wacu kumae, Gibedo ku Musa ku jubila de, wek giwinjgi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.29",
            "verseOrgIds": [
              "LUK.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ewacu kumae, Ungo, vwa Ibrahim: ento tek ng’atu acel ucidho i bang’gi m’uai i kind ju m’utho, e gibiloko cwinygi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.30",
            "verseOrgIds": [
              "LUK.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
