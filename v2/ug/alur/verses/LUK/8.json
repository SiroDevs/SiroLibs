          "type": "text",
          "attrs": {
            "verseId": "LUK.8.15",
            "verseOrgIds": [
              "LUK.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
