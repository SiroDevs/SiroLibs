              "NUM.6.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.21.23"
              },
              "items": [
                {
                  "text": "Tic 21:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.21.24"
              },
              "items": [
                {
                  "text": "24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man maeni cik ma ni Janaziri, kinde ma nindo mi koiri pare romo kakare: jubikele ba dhugola mi hema mi cokri: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.13",
            "verseOrgIds": [
              "NUM.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "man ebithiero girathiera pare ni Yehova, en e nyathi nyog rombo acel ma rundine acel m’umbe mulima ni lam m’awang’a, man vong’ rombo acel ma rundine acel m’umbe mulima ni lam mi dubo, man nyog rombo m’umbe mulima ni lam mi kwiocwiny, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.14",
            "verseOrgIds": [
              "NUM.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "man katoko mi kwen ma thobi mbe i ie, kwen m’ang’ina mi mogo ma yom m’ujebre ku mo, man kwen m’apada ma thobi mbe i ie ma juwiro ku mo, ku lam mi mogo migi, man lam m’amadha migi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.15",
            "verseOrgIds": [
              "NUM.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "E jalam bithierogi i wang’ Yehova, man ebithiero lam pare mi dubo, ku lam pare m’awang’a: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.16",
            "verseOrgIds": [
              "NUM.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "man ebithiero nyog rombo ni lam mi girathiera mi kwiocwiny ni Yehova, karacelo ku katoko mi kwen ma thobi mbe i ie: jalam bende bithiero lam mi mogone, ku lam m’amadhane. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.17",
            "verseOrgIds": [
              "NUM.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man Janaziri bigwaru wie mi koiri pare ba dhugola mi hema mi cokri, man ebigamu yuk wie mi koiri pare, man ebikethe i mac ma the lam mi girathiera mi kwiocwiny. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.18",
            "verseOrgIds": [
              "NUM.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man jalam bigamu bot nyog rombo m’ateda, ku kwen m’ang’ina ma thobi mbe i ie acel ku i katoko, ku kwen m’apada acel ma thobi mbe i ie, man ebikethogi i cing’ Janaziri, yo ng’ei wie mi koiri pare m’egwaru; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.19",
            "verseOrgIds": [
              "NUM.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "e jalam biwirogi ni lam m’awira i wang’ Yehova; maeni e leng’ ni jalam, karacelo ku kor m’awira ku bam m’ating’a: e yo ng’ei maeno Janaziri copo madhu pigulok.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.20",
            "verseOrgIds": [
              "NUM.6.20"
            ]
          }
        }
      ]
    },
