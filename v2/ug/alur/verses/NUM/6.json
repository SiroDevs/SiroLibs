          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova keth wang’e rieny i wii, man etim i beng’i ku bero:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.25",
            "verseOrgIds": [
              "NUM.6.25"
            ]
          }
        }
      ]
