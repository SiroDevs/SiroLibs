          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maeni en e cik pa Janaziri m’ung’olo lembe, man mi girathiera pare ni Yehova pi koiri pare, umedo gin m’ecopo gamu: calku lembang’ola pare m’eng’olo, dong’ etim kumeca be calku cik mi koiri pare.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.21",
            "verseOrgIds": [
              "NUM.6.21"
            ]
          }
        }
      ]
    },
