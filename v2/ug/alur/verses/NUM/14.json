            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.7.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehova bedo yo ni ng’ecwiny, man e dit ku mer mi bero, m’eweko ko kier ku dubo; m’ebiweko dubo de ki ngo, m’eketho ko kier mi wego wi nyithindho, wi dhanum’utuk mir adege ku wi mir ang’wende. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.18",
            "verseOrgIds": [
              "NUM.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwei, wek kier mi dhanu maeni, calku dwong’ mi mer mi bero peri, man calu iweko dubo mi dhanu maeni, ugambre i Misiri cil kawono nini.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.19",
            "verseOrgIds": [
              "NUM.14.19"
            ]
          }
        }
      ]
    },
