            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "E Yehova wacu kumae, Aweko dubo calku lembe peri: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.20",
            "verseOrgIds": [
              "NUM.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.3.18"
              },
              "items": [
                {
                  "text": "Ebr 3:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ento andha, calu abedo kwo, man calu ng’om yu bipong’ ku dwpng’ pa Yehova; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.21",
            "verseOrgIds": [
              "NUM.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "kum dhanu maeno ceke ma gineno dwong’ para, ku giranyutha para, m’atimo i Misiri kud i langa, ento gibidha wang’ apar maeni, man giwinjo dwanda ngo; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.22",
            "verseOrgIds": [
              "NUM.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "andha gibineno ng’om m’akwong’o ni kwarugi ngo, kadok jumoko m’i kindgi de mbe m’ucaya ma gibinene: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.23",
            "verseOrgIds": [
              "NUM.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 14:24"
          },
          "items": [
