              "NUM.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "E hema mi cokri bilund tugo woth, karacelo ku gonjo mi Julawi i kind gonjo: calu gigonjo, gibitugo woth kumeca, ku ba dhanu ceke ng’atuman i kakare, kum abera migi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.17",
            "verseOrgIds": [
              "NUM.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.17",
            "verseOrgIds": [
              "NUM.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abera mi gonjo pa Efraim bibedo nuti i ng’ete ma yo reto calkud udul migi: man Elicama ma wod Amihud bibedo jadit mi nyithindho pa Efraim. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.18",
            "verseOrgIds": [
              "NUM.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man udul pare, ku ju m’i kindgi ma jukwanu welgi, gi rubanga pier ang’wen ku dak abic. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.19",
            "verseOrgIds": [
              "NUM.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man suru pa Manase bibedo i ng’ete: man Gamaliel ma wod Pedazur bibedo jadit mi nyithindho pa Manase. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.20",
            "verseOrgIds": [
              "NUM.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man udul pare, ku ju m’i kindgi ma jukwanu welgi, gi rubanga pier adek wi ario ku dak ario. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.21",
            "verseOrgIds": [
              "NUM.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man suru pa Benyamin: Abidan ma wod Gideoni bibedo jadit mi nyithindho pa Benyamin. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.22",
            "verseOrgIds": [
              "NUM.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man udul pare, ku ju m’i kindgi ma jukwanu welgi, gi dhanu rubanga pier adek wi abic ku dak ang’wen. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.23",
            "verseOrgIds": [
              "NUM.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhanu ceke ma jukwanu welgi mi gonjo pa Efraim gi rubanga dak acel ku wi abora ku dak acel, calkud udul migi. E gibitugo woth mir adege.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.24",
            "verseOrgIds": [
              "NUM.2.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
