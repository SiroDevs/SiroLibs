              "type": "text"
            }
          ]
        },
        {
          "text": "en e dhanu ceke ma jukwanugi gi rubanga dak abusiel ku wi adek ku dak abic ku pier abic.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.46",
            "verseOrgIds": [
              "NUM.1.46"
            ]
          }
        }
