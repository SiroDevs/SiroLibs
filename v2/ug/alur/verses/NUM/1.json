          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi nyithindho pa Gad, dhanum’utuk migi, ku ba wat migi ku ba wat migi, ku ba udi pa weggi ku ba udi pa weggi, calku wel nying’, m’ugambre kum ju ma rundi migi pier ario ku ma sagu, dhanu ceke ma gicopo cidho woko i lwiny; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.24",
            "verseOrgIds": [
              "NUM.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "gi ju ma jukwanu welgi, mi suru pa Gad, gi rubanga pier ang’wen wi abic ku dak abusiel ku pier abic. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.25",
            "verseOrgIds": [
              "NUM.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi nyithindho pa Yuda, dhanum’utuk migi, ku ba wat migi ku ba wat migi, ku ba udi pa weggi ku ba udi pa weggi, calku wel nying’, m’ugambre kum ju ma rundi migi pier ario ku ma sagu, dhanu ceke ma copo cidho woko i lwiny; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.26",
            "verseOrgIds": [
              "NUM.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "gi ju ma jukwanu welgi, mi suru pa Yuda, gi dhanu rubanga pier abiro wi ang’wen ku dak abusiel.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.27",
            "verseOrgIds": [
              "NUM.1.27"
            ]
          }
        }
      ]
    },
