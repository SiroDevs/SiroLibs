          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum kumeno dhanu ceke mi nyithindho mir Israel ma jukwanugi ku ba udi pa weggi ku ba udi pa weggi, m’ugambre kum ju ma rundi migi pier ario ku ma sagu, dhanu ceke ma copo cidho woko i lwiny i Israel: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.45",
            "verseOrgIds": [
              "NUM.1.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
