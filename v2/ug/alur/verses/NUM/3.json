            "sid": "NUM 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nie maeni gi dhanum’utuk pa Harun giku Musa i ceng’ ma Yehova weco ie ku Musa wi got Sinai. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.1",
            "verseOrgIds": [
              "NUM.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.26.60"
              },
              "items": [
                {
                  "text": "Wel 26:60",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man maeni gi nying’ wot Harun: Nadab ma kayu, man Abihu, kud Eliazar, man Ithamar. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.2",
            "verseOrgIds": [
              "NUM.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maeni gi nying’ wot Harun, gi julam ma juwiro, m’ethiero kara utim i tic pa jalam. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.3",
            "verseOrgIds": [
              "NUM.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.10.1"
              },
              "items": [
                {
                  "text": "Law 10:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.10.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.26.61"
              },
              "items": [
                {
                  "text": "Wel 26:61",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man Nadab gikud Abihu githo i wang’ Yehova, kinde ma githiero mac ma tung’ i wang’ Yehova, i langa mi Sinai, e nyithindho migi mbe; man Eleazar gikud Ithamar gitimo i tic ma pa jalam i vut Harun ma weggi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.4",
            "verseOrgIds": [
              "NUM.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.4",
            "verseOrgIds": [
              "NUM.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "E Yehova yero ni Musa, ewacu kumae, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.5",
            "verseOrgIds": [
              "NUM.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kel suru pa Lawi ceng’ni, man ikethgi i wang’ Harun ma jalam, kara gitim ire. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.6",
            "verseOrgIds": [
              "NUM.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "E gibigwoko kur pare, ku kur mir udul dho i wang’ hema mi cokri, kara gitim tic mi hema. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.7",
            "verseOrgIds": [
              "NUM.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man gibigwoko jamni ceke mi hema mi cokri, ku kur mi nyithindho mir Israel, kara gitim tic mi hema. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.8",
            "verseOrgIds": [
              "NUM.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ibimio Julawi ni Harun man ni wote: jumiogi dho ire pi nyithindho mir Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.9",
            "verseOrgIds": [
              "NUM.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ibiketho Harun ku wote, e gibigwoko lamulam migi: e jawirok m’ucoro ceng’ni jubinege.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.10",
            "verseOrgIds": [
              "NUM.3.10"
            ]
          }
        }
      ]
    },
    {
