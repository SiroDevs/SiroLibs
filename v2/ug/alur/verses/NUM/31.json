          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "ku kana rubanga pier adek ku dak abic, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.45",
            "verseOrgIds": [
              "NUM.31.45"
            ]
          }
        },
        {
          "name": "verse",
