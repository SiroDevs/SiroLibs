          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "(nie ng’ete mir udul en e rombe rubanga dak adek ku pier adek wi abiro ku dak abic, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.43",
            "verseOrgIds": [
              "NUM.31.43"
            ]
          }
        },
        {
          "name": "verse",
