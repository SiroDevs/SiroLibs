          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "cil kind ng’ete mi nyithindho mir Israel, Musa wodho acel kud i pier abic kubang’gi kubang’gi, mi dhanu man mi lim, man emiogi ni Julawi, m’ugwoko kur mi hema pa Yehova; calu Yehova ng’olo ni Musa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.47",
            "verseOrgIds": [
              "NUM.31.47"
            ]
          }
        }
      ]
