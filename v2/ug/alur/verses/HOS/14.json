            "style": "v",
            "sid": "HOS 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.8",
            "verseOrgIds": [
              "HOS.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng’a ma riek, kara eng’ei thelembe mi gin maeni? won pidoic, kara eng’eigi? kum yo pa Yehova en e atira, man won bedopwe biwotho i igi; ento weg kier bipodho i ie.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.9",
            "verseOrgIds": [
              "HOS.14.9"
            ]
          }
        }
      ]
    }
