                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Koti m’aweko Troa ba Karpo, ibin kude kan ibino, ku kitabu de, ma sagu ceke re waraga no. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.13",
            "verseOrgIds": [
              "2TI.4.13"
            ]
