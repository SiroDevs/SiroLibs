        },
        {
          "text": "Luka kende m’udong’ i bang’a. Cok Marko, wubin wukude; kum ebedo ni kuloka ira kum tim m’etimo. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.11",
            "verseOrgIds": [
              "2TI.4.11"
            ]
          }
        },
