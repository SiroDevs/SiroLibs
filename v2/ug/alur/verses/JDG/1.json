                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man Efraim uriemo Jukanani m’ubedo i Gezer woko ngo; ento Jukanani gibedo i Gezer i kindgi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.29",
