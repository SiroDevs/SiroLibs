          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "ento Juaceri gibedo i kind Jukanani, ma gi ju m’ubedo i ng’ombe; kum giriemogi woko ngo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.32",
