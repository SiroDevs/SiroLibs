              "type": "text"
            }
          ]
        },
        {
          "text": "Man Juamori gicwalu nyithindho pa Dan i ng’om gudi; kum giyio ngo igi nia gilor piny i poga; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.34",
            "verseOrgIds": [
