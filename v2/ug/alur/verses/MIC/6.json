              },
              "items": [
                {
                  "text": "21:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.21.26"
              },
              "items": [
                {
                  "text": "26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kum cik pa Omri juworo, ku tic ceke mi ot pa Ahab, man wuwotho i lembapora migi; kara adwoki ni nyoth, man ju ma gibedo i iene ni cac; e wubiyeyo cac mi dhanu para.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.16",
            "verseOrgIds": [
              "MIC.6.16"
            ]
          }
        }
      ]
    }
