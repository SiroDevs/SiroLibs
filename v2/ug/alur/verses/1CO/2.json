              },
              "items": [
                {
                  "text": "Isa 64:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ento calu egore kumae,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.9",
            "verseOrgIds": [
              "1CO.2.9"
            ]
          }
