            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.16.8+PSA.16.9+PSA.16.10"
              },
              "items": [
                {
                  "text": "Zab 16:8-10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.40"
              },
              "items": [
                {
                  "text": "Mt 12:40",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.2.24+ACT.2.25+ACT.2.26+ACT.2.27+ACT.2.28+ACT.2.29+ACT.2.30+ACT.2.31+ACT.2.32"
              },
              "items": [
                {
                  "text": "Tic 2:24-32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ya juyike bende; man nia ecer i ceng’ mir adege calku lembagora pa Mungu; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.4",
            "verseOrgIds": [
              "1CO.15.4"
            ]
          }
        },
        {
