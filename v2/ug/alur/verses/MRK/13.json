              "items": [
                {
                  "text": "Yoe 2:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "cero de bipodho kud i polo, tego mi polo de biyengre. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.25",
            "verseOrgIds": [
              "MRK.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
