                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.7"
              },
              "items": [
                {
                  "text": "Nyu 1:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E i nindo maeno gibineno Wod dhanu bebino i afuru ku tego ma dit ku dwong’ bende. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.26",
            "verseOrgIds": [
              "MRK.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man i nindo maeno ebioro malaika, man ebicoko jupare ma jugoyo nying’gi karacelo ku yo the yamu ang’wen, kud i tung’ ng’om ku tung’ polo de.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.27",
            "verseOrgIds": [
              "MRK.13.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
