              "items": [
                {
                  "text": "Eze 32:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ento i ceng’ maeno, yo ng’ei masendi maeno, ceng’ biyutho, dwi de birij eny ungo, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.24",
            "verseOrgIds": [
              "MRK.13.24"
            ]
          }
        },
        {
