        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.53",
            "verseOrgIds": [
              "LEV.14.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "LEV 14:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maeni en e cik mi tho mi joi ma kwonde tung’ tung’ ceke, man mi vur ma apokane cudo, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.54",
            "verseOrgIds": [
              "LEV.14.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "LEV 14:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "man mi joi m’i kendi, man m’i ot, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.55",
            "verseOrgIds": [
              "LEV.14.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "LEV 14:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "man mi vur ma kwot, man mir apoka rem, man mi wang’ rem ma rieny; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.56",
            "verseOrgIds": [
              "LEV.14.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "LEV 14:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "kara uponj kinde m’ecido, man kinde m’e leng’: maeni cik mi joi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.57",
            "verseOrgIds": [
              "LEV.14.57"
            ]
          }
        }
      ]
    }
