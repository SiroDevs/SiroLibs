              "LEV.9.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.3.1+LEV.3.2+LEV.3.3+LEV.3.4+LEV.3.5+LEV.3.6+LEV.3.7+LEV.3.8+LEV.3.9+LEV.3.10+LEV.3.11"
              },
              "items": [
                {
                  "text": "Law 3:1-11",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man enego koni dhiang’ bende ku nyog rombo, en e lam mi girathiera mi kwiocwiny, ma en e mi dhanu: man wot Harun ukelo rimone i bang’e, m’ekiro wi pemblam gbur, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.18",
            "verseOrgIds": [
              "LEV.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "man mio mi koni dhiang’ man nyog rombone, ku yibe ma mio, ku gin ma umo jambie, ku rong’ni, man bor ma wi cwiny: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.19",
            "verseOrgIds": [
              "LEV.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "man giketho mio wi kor, man ewang’u mione wi pemblam: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.20",
            "verseOrgIds": [
              "LEV.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "man kor ku bamb ma yor acwic Harun uwiro ni lam m’awira i wang’ Yehova; calu Musa ng’olo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.21",
            "verseOrgIds": [
              "LEV.9.21"
            ]
          }
        }
      ]
    },
