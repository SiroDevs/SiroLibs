            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.6.22+NUM.6.23+NUM.6.24+NUM.6.25+NUM.6.26"
              },
              "items": [
                {
                  "text": "Wel 6:22-26",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "E Harun uting’o cinge yo ba dhanu man emio mugisa igi; man eloro piny ku ba thiero lam mi dubo, ku lam m’awang’a, man lam mi kwiocwiny. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.22",
            "verseOrgIds": [
              "LEV.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "E Musa giku Harun gimondo i hema mi cokri, man giwok woko, e gimio mugisa ni dhanu: man dwong’ pa Yehova nyuthre ni dhanu ceke. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.23",
            "verseOrgIds": [
              "LEV.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "E mac uai i wang’ Yehova, man ewang’u lam m’awang’a wi pemblam ku mio: e kinde ma dhanu ceke neno maeni, gikok, man gipodho arieba wang’gi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.24",
            "verseOrgIds": [
              "LEV.9.24"
            ]
          }
        }
      ]
    }
