          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maeni cik mi lam m’awang’a, mi lam mi mogo, man mi lam mi dubo, mi lam mi kadhukuwicik de, man mi thier, man mi lam mi girathiera mi kwiocwiny; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.37",
            "verseOrgIds": [
              "LEV.7.37"
            ]
          }
        },
        {
          "name": "verse",
