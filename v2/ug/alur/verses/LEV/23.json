              "LEV.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maeni agba pa Yehova ma juketho, en e cokri ma leng’, ma wubilwong’o i nindo migi ma juketho. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.4",
            "verseOrgIds": [
              "LEV.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.1+EXO.12.2+EXO.12.3+EXO.12.4+EXO.12.5+EXO.12.6+EXO.12.7+EXO.12.8+EXO.12.9+EXO.12.10+EXO.12.11+EXO.12.12+EXO.12.13"
              },
              "items": [
                {
                  "text": "Ai 12:1-13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.1"
              },
              "items": [
                {
                  "text": "Poi 16:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "I dwi ma kwong’ane, i ceng’ apar wi ang’wende mi dwije uthieno, en e kadhukuwijo pa Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.5",
            "verseOrgIds": [
              "LEV.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.14+EXO.12.15+EXO.12.16+EXO.12.17+EXO.12.18+EXO.12.19+EXO.12.20"
              },
              "items": [
                {
                  "text": "Ai 12:14-20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.15"
              },
              "items": [
                {
                  "text": "23:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.18"
              },
              "items": [
                {
                  "text": "34:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.3+DEU.16.4+DEU.16.5+DEU.16.6+DEU.16.7+DEU.16.8"
              },
              "items": [
                {
                  "text": "Poi 16:3-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man i ceng’ apar wi abije mi dwije en e agba mi kwen ma thobi mbe i ie ni Yehova: wubicamu kwen ma thobi mbe i ie ceng’ abiro. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.6",
            "verseOrgIds": [
              "LEV.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "I ceng’ ma kwong’ane wubibedo ku cokri ma leng’: wubitimo tic moko ngo ma jumuli kudo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.7",
            "verseOrgIds": [
              "LEV.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento wubithiero lam ma jutimo ku mac ni Yehova ceng’ abiro: i ceng’ mir abirone en e cokri ma leng’; wubitimo tic moko ma jumuli kudo ngo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.8",
            "verseOrgIds": [
              "LEV.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.8",
            "verseOrgIds": [
              "LEV.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "E Yehova yero ni Musa, ewacu kumae, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.9",
            "verseOrgIds": [
              "LEV.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yer ni nyithindho mir Israel, man iwac igi kumae, Kinde ma wumondo i ng’om m’amio iwu, man wukai mwokane, wulund wukel landu mwoka mu ba jalam: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.10",
            "verseOrgIds": [
              "LEV.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "man ebiwiro kumna i wang’ Yehova, kara eyire iwu: urwone yo ng’ei sabatu jalam biwire. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.11",
            "verseOrgIds": [
              "LEV.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man i ceng’ ma wuwiro kumnane, wubithiero nyathi nyog rombo ma mulima mbe i kume ma rundine acel ni lam m’awang’a ni Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.12",
            "verseOrgIds": [
              "LEV.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man lam mi mogone bibedo ng’et mogo ma yom ma jujebo ku mo mir apaje ario ma i katoko, lam ma jutimo ku mac ni Yehova ni ng’wic mido ma ng’ar; man lam m’amadhane bibedo mi pigulok, ng’et tabu mir ang’wende. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.13",
            "verseOrgIds": [
              "LEV.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man kud wucam kadok kwen, kadi cam m’acela, kadi withe ma nyen, cil ma ceng’ maeni bitundo ko, cil ma wukel ko girathiera pa Mungu mu: en e cik mi nja cil kum dhanum’utuk mu i kabedo mu ceke. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.14",
            "verseOrgIds": [
              "LEV.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.16"
              },
              "items": [
                {
                  "text": "Ai 23:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.22"
              },
              "items": [
                {
                  "text": "34:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.9+DEU.16.10+DEU.16.11+DEU.16.12"
              },
              "items": [
                {
                  "text": "Poi 16:9-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man wukwan iwu ugambre urwone yo ng’ei sabatu ugambre i ceng’ ma wukelo ie kumna mi girathiera m’awira; sabatu abiro bibedo nuti kubang’e: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.15",
            "verseOrgIds": [
              "LEV.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "en e i ceng’ mir arionde yo ng’ei sabatu mir abirone wukwan ceng’ pier abic; man wuthier lam mi mogo ma nyen ni Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.16",
            "verseOrgIds": [
              "LEV.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wukel kwen m’ang’ina ario m’awira mi ng’ete mir apaje ario ma i katoko ku i kabedo mu: gibibedo mi mogo ma yom, jubitedogi ku thobi, ni nying’ ma kwong’a ni Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.17",
            "verseOrgIds": [
              "LEV.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man wubithiero nyithi rombe abiro ma mulima mbe i kumgi ma rundigi acel acel karacelo ku kwen de, man thwon dhiang’ acel m’aradu, ku nyogi rombe ario: gibibedo ni lam ra’awang’a ni Yehova, ku lam mi mogone, man lam m’amadhane, en e lam ma jutimo ku mac, mi ng’wic mido ma ng’ar ni Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.18",
            "verseOrgIds": [
              "LEV.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man wubithiero nyog diel acel ni lam mi dubo, man nyithi nyogi rombe ario ma rundigi acel acel ni lam mi girathiera mi kwiocwiny. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.19",
            "verseOrgIds": [
              "LEV.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man jalam biwirogi karacelo ku kwen mi nying’ ma kwong’a ni lam m’awira i wang’ Yehova, ku nyithi rombe ario: gibibedo leng’ ni Yehova pi julam. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.20",
            "verseOrgIds": [
              "LEV.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man wubilwong’o i ceng’ maeca nica; cokri ma leng’ bibedo nuti iwu; kud wutim tic moko ma jumuli kudo: en e cik mi nja i kabedo mu ceke cil kum dhanum’utuk mu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.21",
            "verseOrgIds": [
              "LEV.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.9"
              },
              "items": [
                {
                  "text": "Law 19:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.24.19+DEU.24.20+DEU.24.21+DEU.24.22"
              },
              "items": [
                {
                  "text": "Poi 24:19-22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man kinde ma wukayu mwoka mi ng’om mu, kud ikai gund podho peri ceke, kadok kund mwoka de kud icoki: wekgi ni jacan, man ni umondo: an a Yehova Mungu mu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.22",
            "verseOrgIds": [
              "LEV.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
