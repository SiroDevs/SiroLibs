            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.12+DEU.5.13+DEU.5.14"
              },
              "items": [
                {
                  "text": "Poi 5:12-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jubitimo tic ceng’ abusiel: ento ceng’ mir abirone en e sabatu mi yom ma cu, en e cokri ma leng’; kud wutim tic moko ki: en e sabatu ni Yehova i kabedo mu ceke.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.3",
            "verseOrgIds": [
              "LEV.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
