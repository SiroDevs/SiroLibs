              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.16",
            "verseOrgIds": [
              "1TH.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1TH 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento wan, umego, ma jupokowa wakudu mi nindo ma nyanok, mi nendri ku wang’ kud adunde re ngo, waponjo apila ma sagu ya wanen weng’wu kud amora ma dit: ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.17",
            "verseOrgIds": [
              "1TH.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1TH 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kum nwang’u wayenyo dit wabin i beng’wu, an a Paolo wang’ acel man kendo; e Jok ucerowa. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.18",
            "verseOrgIds": [
              "1TH.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1TH 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum genogen mwa en e ang’o, kadi anyong’a mwa, kadi jamkermi wic mwa mi kulula? Ndhu wun ungo, i wang’ Rwoth mwa ma Yesu i bino pare? ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.19",
            "verseOrgIds": [
              "1TH.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1TH 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum wun wu dwong’ mwa man mutoro mwa.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.20",
            "verseOrgIds": [
              "1TH.2.20"
            ]
          }
        }
      ]
    }
