              "items": [
                {
                  "text": "17:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.17.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.12"
              },
              "items": [
                {
                  "text": "18:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ma ginego Rwoth Yesu ku jubila, giriemo wan de woko, ginyayu mutoro ngo i Mungu, man gi tung’ ku dhanu ceke; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.15",
            "verseOrgIds": [
              "1TH.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TH 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "gikwero ya ku wayer ni Thekdhanumange kara gibothi; kara gipong’ dubo migi thiri thiri: ento kwinyo wok i wigi cil i kajikne.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.16",
            "verseOrgIds": [
              "1TH.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
