              "type": "text"
            }
          ]
        },
        {
          "text": "Nie kinde ma Suleman udaru rwo, mac uai i polo loro piny, man ewang’u lam m’awang’a ku lam; e dwong’ pa Yehova pong’o ot. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.1",
            "verseOrgIds": [
              "2CH.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man julam copo mondo ngo i ot pa Yehova, kum dwong’ pa Yehova pong’o ot pa Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.2",
            "verseOrgIds": [
              "2CH.7.2"
            ]
          }
        },
