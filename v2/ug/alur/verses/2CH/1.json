              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.13",
            "verseOrgIds": [
              "2CH.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.14",
            "verseOrgIds": [
              "2CH.1.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.4.26"
              },
              "items": [
                {
                  "text": "1 Ub 4:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man Suleman ucoko magali ku weg riuni: man magali pare rubanga acel ku dak ang’wen, weg riuni ke rubanga apar wi ario, m’eketho i adhura mi magali, man karacelo kud ubimo i Y er usalem. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.14",
            "verseOrgIds": [
              "2CH.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ubimo ketho mola ma tar ku mola ma kwar ubed calu kidi i Yerusalem, man musonge eketho ubed calu yenduduk ma ni i poga, ni ditne. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.15",
            "verseOrgIds": [
              "2CH.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.16"
              },
              "items": [
                {
                  "text": "Poi 17:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man riuni ma Suleman ubedo ko jukelo ku i Misiri; weg katali p’ubimo jologi ni udul, udul kubang’e kubang’e mi welpiny. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.16",
            "verseOrgIds": [
              "2CH.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man gikelo magali malu kud i ng’om Misiri mi cekel mi mola ma tar dak abusiel, man riuni mi cekel dak acel ku pier abic: man kumeni mir ubimo ceke mi Juhiti, man ubimo mi Cami, giwodhogi ku cing’gi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.17",
            "verseOrgIds": [
              "2CH.1.17"
            ]
          }
        }
      ]
    }
