                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.9.15"
              },
              "items": [
                {
                  "text": "2 Kei 9:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.9.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kum kumeno Cicak m’ubimo mi Misiri bino malu kum Yerusalem, man eyaku piny m’akana kud i ot pa Yehova, ku piny m’akana mi ot p’ubimo; ekabu ceke woko: ekabu ban mi mola ma kwar ma Suleman utimo bende. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.9",
            "verseOrgIds": [
              "2CH.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "E ubimo ma Rehoboam utimo ban mi mola kakagi, man ekethogi i cing’ jego mi jukur, ma gwoko dhugola mi ot p’ubimo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.10",
            "verseOrgIds": [
              "2CH.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ebedo kumeno, nia, kan ubimo mondo i ot pa Yehova, jakur ubino man eyeyogi, e edwokogi kendo i kusika mi kur. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.11",
            "verseOrgIds": [
              "2CH.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "E kinde m’ejwigre gire, kwinyo pa Yehova lokre kud i bang’e, kara kud unyothe kot: man kendo i Yuda junwang’u gin moko ma ber.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.12",
            "verseOrgIds": [
              "2CH.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.12",
            "verseOrgIds": [
              "2CH.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum kumeno ubimo ma Rehoboam utegre gire i Yerusalem, man ecamu ker: kum Rehoboam rundi pare pier ang’wen wi acel kinde m’emaku camu ker, man ecamu ker rundi apar wi abiro i Yerusalem, adhura ma Yehova goyo wie kud i suru ceke mir Israel, kara eketh nyinge keca: man nying’ min mire Nama ma Nyaamoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.13",
            "verseOrgIds": [
              "2CH.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man etimo gin ma rac, kum eketho adundene ngo kara eyeny Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.14",
            "verseOrgIds": [
              "2CH.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.14",
            "verseOrgIds": [
              "2CH.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nie tic pa Rehoboam, ma kwong’ane ku ma cenne, gigore i lemkei pa Cemaya ma jabila man pa Ido ma jaeulembe, calku kura mi thekwaru ngo? Man ali ni i kind Rehoboam ku Yeroboam thiri thiri. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.15",
            "verseOrgIds": [
              "2CH.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man Rehoboam unindo ku kwaru pare, man juyike i adhura pa Daudi: man Abija ma wode camu ker kakare.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.16",
            "verseOrgIds": [
              "2CH.12.16"
            ]
          }
        }
      ]
    }
  ],
