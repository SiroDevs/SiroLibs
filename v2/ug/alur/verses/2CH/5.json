                "loc": "EXO.40.34"
              },
              "items": [
                {
                  "text": "Ai 40:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.40.35"
              },
              "items": [
                {
                  "text": "35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man etimbre, kinde ma julam giwok woko kud i kamaleng’ (kum julam ceke ma ginuti gidwokri gigi leng’, man gikuro kur migi ngo; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.11",
            "verseOrgIds": [
              "2CH.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Julawi bende ma gi juwer, kagi ceke, cil Asaf man Heman, man Yeduthun, ku wotgi man utumeggi, ma gironjri ku bongu ma nwang’ ma ber, kud umbukulumbu man nanga kud adungu, gicungo ng’et pemblam ma yo nyangu, man julam dak acel ku pier ario ma gibekudho agwara ni karacelo kugi); ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.12",
            "verseOrgIds": [
              "2CH.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "etimbre, kinde ma jukudhagwara man juwer gibedo calu acel, kara giketh badwal acel uwinjre kum paku ku foyo Yehova; man kinde ma giting’o dwandgi malu karacelo kud agwara man umbukulumbu ku jambwer mi badwal, man gipaku Yehova, giwacu kumae, Kum en e ber; kum mer mi bero pare bedo mi nja; nia ot ulund upong’ kud afuru, en e ot pa Yehova, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.13",
            "verseOrgIds": [
              "2CH.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ketho nia julam gicopo cungo ngo nitimo kum afurune: kum dwong’ pa Yehova pong’o ot pa Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.14",
            "verseOrgIds": [
              "2CH.5.14"
            ]
          }
        }
