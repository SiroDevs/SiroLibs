                "loc": "2SA.6.12+2SA.6.13+2SA.6.14+2SA.6.15"
              },
              "items": [
                {
                  "text": "2 Sam 6:12-15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.15.25+1CH.15.26+1CH.15.27+1CH.15.28"
              },
              "items": [
                {
                  "text": "1 Kei 15:25-28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Suleman ulund ucoko judongo mir Israel, ku wi suru ceke, ma gi judongomawijo mi udi pa wego mi nyithindho mir Israel, i Yerusalem, kara ukel sanduk mi lembariba pa Yehova malu ku i adhura pa Daudi, ma en e Sayuni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.2",
            "verseOrgIds": [
              "2CH.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man dhanu ceke mir Israel gicokri gigi bang’ ubimo i agba, ma ni i dwi mir abirone. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.3",
            "verseOrgIds": [
              "2CH.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "E judongo ceke mir Israel gibino: man Julawi giting’o sanduk malu; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.4",
            "verseOrgIds": [
              "2CH.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "man gikelo sanduk malu, ku hema mi cokri, kud agulu ceke ma leng’ ma ni i Hema; julam ku Julawi gikelo maeni malu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.5",
            "verseOrgIds": [
              "2CH.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ubimo ma Suleman kud udul ceke mir Israel, ma gicokri i bang’e, gini i wang’ sanduk, ma gibelamu rombe ku koni dhiang’, ma jucopo kwanu ngo kadi welne de jucopo ng’eyo ngo ni udulne. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.6",
            "verseOrgIds": [
              "2CH.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "E julam gikelo sanduk mi lembariba pa Yehova i ie i kakare, i kayerlembe mi ot, ba kamaleng’ m’usagu, en e the bomb kerubi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.7",
            "verseOrgIds": [
              "2CH.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum kerubi giyaru bombgi wi ka sanduk, man kerubi giumo sandukne ku yende de ku malu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.8",
            "verseOrgIds": [
              "2CH.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man yen gi bor hai ketho nia dhu yen unen ku ba sanduk i wang’ kayerlembe; ento ginen ungo ku yo woko; e ebedo keca cil i ceng’ ma tin. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.9",
            "verseOrgIds": [
              "2CH.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.10.5"
              },
              "items": [
                {
                  "text": "Poi 10:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gin moko mbe i sanduk ndhu ban ario ma Musa ketho keca i Horeb, kinde ma Yehova timo lembariba ku nyithindho mir Israel, kinde ma giai woko kud i Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.10",
            "verseOrgIds": [
              "2CH.5.10"
            ]
          }
        }
      ]
    },
