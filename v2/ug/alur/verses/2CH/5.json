              "items": [
                {
                  "text": "1 Kei 18:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kum kumeni tic ceke ma Suleman utimo pi ot pa Yehova thum. Man Suleman ukelo gin ma Daudi, ma won uthiero i ie, en e mola ma tar, ku mola ma kwar, kud agulu ceke, man ekethogi i kakanpiny mi ot pa Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.1",
            "verseOrgIds": [
              "2CH.5.1"
            ]
          }
        }
