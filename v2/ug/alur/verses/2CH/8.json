                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "calku ma cande nuti ceng’ ku ceng’, m’ethiero calku lembang’ola pa Musa, i ceng’ sabatu, man i dwi m’upor, man i agba ma juketho, wang’ adek i rundi acel, i agba mi kwen ma thobi mbe i ie, man i agba mi yenga, man i agba mi odbak.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.13",
            "verseOrgIds": [
              "2CH.8.13"
            ]
          }
        }
