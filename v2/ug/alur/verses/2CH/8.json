              "2CH.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suleman ulund uthiero lam m’awang’a ni Yehova wi pemblam pa Yehova, m’eguro i wang’ pondot, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.12",
            "verseOrgIds": [
              "2CH.8.12"
            ]
          }
        },
