          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.10",
            "verseOrgIds": [
              "2CH.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man Suleman ukelo Nyafarao malu kud i adhura pa Daudi ba ot pare m’egomo ire; kum ewacu kumae, Dhaku para bibedo i ot pa Daudi m’ubimo mir Israel ungo, kum en e ka ma leng’, ka ma sanduk pa Yehova bino i ie.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.11",
            "verseOrgIds": [
              "2CH.8.11"
            ]
          }
        }
      ]
    },
    {
