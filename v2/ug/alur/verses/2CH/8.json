            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.13",
            "verseOrgIds": [
              "2CH.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man eketho, calku lembapoka pa Daudi ma won, kur mi julam ba tic migi, man Julawi ba tic migi, kara gipak, man gitim i wang’ julam, calu ma cande nuti mi ceng’ ku ceng’; jukur dhugola bende ku ba kur migi ba dhugang’ kubang’gi kubang’gi: kum Daudi ma dhanu pa Mungu ng’olo kumeno. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.14",
            "verseOrgIds": [
              "2CH.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man giweko lembang’ola p’ubimo ngo ma ba julam ku Julawi pi lembe moko, kadi pi piny m’akana.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.15",
            "verseOrgIds": [
              "2CH.8.15"
            ]
          }
        }
      ]
    },
