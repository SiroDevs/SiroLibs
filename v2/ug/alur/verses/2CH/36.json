                "loc": "JER.28.1+JER.28.2+JER.28.3+JER.28.4+JER.28.5+JER.28.6+JER.28.7+JER.28.8+JER.28.9+JER.28.10+JER.28.11+JER.28.12+JER.28.13+JER.28.14+JER.28.15+JER.28.16+JER.28.17"
