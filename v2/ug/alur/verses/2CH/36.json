                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nebukadnezar m’ubimo mi Babeli bino i kume, man etwie ku gwang’, kara etere i Babeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.6",
            "verseOrgIds": [
              "2CH.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadnezar utero agulu mi ot pa Yehova bende i Babeli, man ekethogi i hekalu i Babeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.7",
            "verseOrgIds": [
              "2CH.36.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nie dong’ tic pa Yehoiakim, man ginmajudagu pare m’etimo ku gin ma junwang’u i ie, nen, gigore i kitabu mir ubimo mir Israel ku Yuda: e Yehoiakin ma wode camu ker kakare.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.8",
            "verseOrgIds": [
              "2CH.36.8"
            ]
          }
        }
      ]
