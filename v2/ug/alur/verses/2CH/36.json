                "loc": "JER.34.1+JER.34.2+JER.34.3+JER.34.4+JER.34.5"
              },
              "items": [
                {
                  "text": "34:1-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ka kumeno ekelo ubimo mi Jukaldayo i wigi, m’unego awobi migi ku palamularu i ot mi kamaleng’ migi, man ngisi pare mbe kum jalawobi kadi nyaku ma sumba, dhanu m’uti kadi ng’atu ma wie ju lwar: emiogi ceke i cinge. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.17",
            "verseOrgIds": [
              "2CH.36.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 36:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man agulu ceke mi ot pa Mungu, ma dongo ku ma thindho, ku piny m’akana mi ot pa Yehova, man piny m’akana p’ubimo, man mi judongomawijo pare, maeni ceke etero i Babeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.18",
            "verseOrgIds": [
              "2CH.36.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.9.8"
              },
              "items": [
                {
                  "text": "1 Ub 9:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E giwang’u ot pa Mungu, man girwombo gang’kidi mi Yerusalem piny, e giwang’u odkeme ceke ku mac, man ginyotho agulu ma berne ceke. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.19",
            "verseOrgIds": [
              "2CH.36.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 36:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ju ma giboth ni palamularu eterogi i Babeli; e gibedo ni jutic ire man ni wote cil i camuker mi ker mir Ajemi: ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.20",
            "verseOrgIds": [
              "2CH.36.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.25.11"
              },
              "items": [
                {
                  "text": "Yer 25:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.29.10"
              },
              "items": [
                {
                  "text": "29:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kara uketh lembe pa Yehova utimbre kakare ma ku dhu Yeremia, maram ng’om ubedo ko kud anyong’a ku sabatu pare: kum cil m’ebedo ni uvuru ekwiro sabatu, kara oro pier abiro timbre.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.21",
            "verseOrgIds": [
              "2CH.36.21"
            ]
          }
        }
