  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "COL 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mirayiro yaMararamiro Matsvene",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "COL 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sezvo, zvino, makamutswa pamwe chete naKristu, isai mwoyo yenyu pazvinhu zviri kumusoro, uko kugere Kristu kuruoko rworudyi rwaMwari.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.1",
            "verseOrgIds": [
              "COL.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "COL 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isai pfungwa dzenyu pazvinhu zviri kumusoro, kwete pazvinhu zvenyika.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.2",
            "verseOrgIds": [
              "COL.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "COL 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti makafa, uye upenyu hwenyu hwakavigwa zvino naKristu muna Mwari.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.3",
            "verseOrgIds": [
              "COL.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "COL 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panoonekwa Kristu, iye upenyu hwenyu, ipapo nemiwo muchaonekwa pamwe chete naye mukubwinya.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.4",
            "verseOrgIds": [
              "COL.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "COL 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo, urayai zvose zvenyu zvenyika zvinoti: upombwe, netsvina, nokusachena, nokuchiva, nokuda zvakaipa uye kukara, ndiko kunamata zvifananidzo.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.5",
            "verseOrgIds": [
              "COL.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "COL 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuda kwaizvozvi, kutsamwa kwaMwari kuri kuuya.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.6",
            "verseOrgIds": [
              "COL.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "COL 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imi maimbofamba mazviri, muupenyu hwamaimborarama.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.7",
            "verseOrgIds": [
              "COL.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "COL 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi zvino munofanira kuzvidzora pane zvose zvakadai sezvizvi zvinoti: kutsamwa, hasha, ruvengo, makuhwa, nokutaura zvakaora zvichibva pamiromo yenyu.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.8",
            "verseOrgIds": [
              "COL.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "COL 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musareverana nhema, sezvo makabvisa munhu wenyu wekare namabasa ake",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.9",
            "verseOrgIds": [
              "COL.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "COL 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "mukafuka munhu mutsva, ari kuvandudzwa mukuziva, mumufananidzo woMusiki wake.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.10",
            "verseOrgIds": [
              "COL.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "COL 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apa hapachina muGiriki kana muJudha, kudzingiswa kana kusadzingiswa, mutorwa kana muSitia, nhapwa kana akasununguka, asi Kristu ndiye zvose, uye ari mune zvose.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.11",
            "verseOrgIds": [
              "COL.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "COL 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo savasanangurwa vaMwari, vatsvene uye vanodikanwa kwazvo, zvifukidzei netsitsi, nounyoro, nokuzvininipisa, nokupfava uye nomwoyo murefu.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.12",
            "verseOrgIds": [
              "COL.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "COL 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munzwirane tsitsi uye mukanganwirane pamhosva ipi zvayo yamunenge matadzirana. Mukanganwire sezvamakakanganwirwa naShe.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.13",
            "verseOrgIds": [
              "COL.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "COL 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye pazvinhu zvose izvi fukai rudo, runokusunganidzai pamwe chete muhumwe hwakakwana.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.14",
            "verseOrgIds": [
              "COL.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "COL 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rugare rwaKristu ngarutonge mumwoyo yenyu, sezvo senhengo dzomuviri mumwe makadanirwa kurugare. Uye munofanira kuvonga.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.15",
            "verseOrgIds": [
              "COL.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "COL 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shoko raKristu ngarigare zvakakwana mamuri pamunenge muchidzidzisana muchirayirana nouchenjeri hwose, uye muchiimba mapisarema, dzimbo nenziyo dzomweya muchivonga Mwari mumwoyo yenyu.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.16",
            "verseOrgIds": [
              "COL.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "COL 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye zvose zvamunoita, mushoko kana mumabasa, itai zvose muzita raIshe Jesu, muchivonga Mwari ivo Baba kubudikidza naye.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.17",
            "verseOrgIds": [
              "COL.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mitemo yavaKristu mudzimba dzavo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "COL 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakadzi, zviisei pasi pavarume venyu, sezvazvakafanira muna She.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.18",
            "verseOrgIds": [
              "COL.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "COL 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume, idai vakadzi venyu musingavabati nehasha.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.19",
            "verseOrgIds": [
              "COL.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "COL 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vana, teererai vabereki venyu pazvinhu zvose, nokuti izvi zvinofadza Ishe.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.20",
            "verseOrgIds": [
              "COL.3.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "COL 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Madzibaba, musanetsa vana venyu, nokuti vanozoora mwoyo.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.21",
            "verseOrgIds": [
              "COL.3.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "COL 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varanda, teererai vatenzi venyu vapanyika muzvinhu zvose; uye muzviite, kwete kuti vakuonei chete uye kuti mudikanwe navo, asi nokutendeka kwomwoyo uye nokutya Ishe.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.22",
            "verseOrgIds": [
              "COL.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "COL 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvose zvamunoita, itai zvose nomwoyo wose, savanhu vanoshandira Ishe, kwete munhu,",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.23",
            "verseOrgIds": [
              "COL.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "COL 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "sezvo muchiziva kuti muchagamuchira nhaka kubva kuna She somubayiro. NdiIshe Kristu wamunoshumira.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.24",
            "verseOrgIds": [
              "COL.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "COL 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani naani anoita zvakaipa achatsiviwa nokuda kwezvakaipa zvake, uye hapana kutsaura vanhu.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.25",
            "verseOrgIds": [
              "COL.3.25"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "COL.4",
    "number": "4",
    "bookId": "COL"
  },
