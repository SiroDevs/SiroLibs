{
  "id": "COL.2",
  "number": "2",
  "bookId": "COL",
  "reference": "VaKorose 2",
  "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "COL 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "COL 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinoda kuti muzive kuti ndiri kurwa sei pamusoro penyu nepaavo vari paRaodhikea, navose vasina kuonana neni pachangu.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.1",
            "verseOrgIds": [
              "COL.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "COL 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vavariro yangu ndeyokuti vakurudzirwe mumwoyo uye vabatane murudo, kuitira kuti vave nepfuma izere yokunzwisisa kwakakwana, kuti vagoziva chakavanzika chaMwari, iye Kristu,",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.2",
            "verseOrgIds": [
              "COL.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "COL 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "maari ndimo makachengetwa pfuma yose youchenjeri nokuziva.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.3",
            "verseOrgIds": [
              "COL.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "COL 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinokuudzai izvi kuitira kuti parege kuva nomunhu anokunyengerai namashoko anobata kumeso.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.4",
            "verseOrgIds": [
              "COL.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "COL 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti kunyange ndisipo pamuri panyama, mumweya ndinemi uye ndinofara ndichiona kuti mugere zvakanaka sei uye kuti makasimba sei mukutenda kwenyu muna Kristu.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.5",
            "verseOrgIds": [
              "COL.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kusunungurwa paTsika dzaVanhu noUpenyu muna Kristu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "COL 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka zvino, sezvamakagamuchira Kristu Jesu saShe, rambai muchifamba maari,",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.6",
            "verseOrgIds": [
              "COL.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "COL 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "mune midzi uye makavakwa maari, makasimbiswa mukutenda sezvamakadzidziswa, uye muzere nokuvonga.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.7",
            "verseOrgIds": [
              "COL.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "COL 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muone kuti parege kuva nomunhu anokutapai nokutaura kusina maturo kunonyengera, kunosendamira patsika dzavanhu nezvokuvamba kwenyika ino, asingateveri Kristu.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.8",
            "verseOrgIds": [
              "COL.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "COL 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti muna Kristu kuzara kwouMwari kunogara maari pamuviri,",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.9",
            "verseOrgIds": [
              "COL.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "COL 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nemiwo makapiwa kuzara uku muna Kristu, iye ari pamusoro poushe hwose nesimba.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.10",
            "verseOrgIds": [
              "COL.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "COL 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nemiwo makadzingiswa maari, mukubviswa kwomunhu wezvivi, kwete nokudzingiswa kunoitwa namaoko avanhu, asi nokudzingiswa kunoitwa naKristu,",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.11",
            "verseOrgIds": [
              "COL.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "COL 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "makavigwa pamwe chete mukubhabhatidzwa uye mukamutswa pamwe chete naye nokutenda kwenyu musimba raMwari, akamumutsa kubva kuvakafa.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.12",
            "verseOrgIds": [
              "COL.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "COL 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamakanga makafa muzvivi zvenyu uye nokusadzingiswa kwomunhu wenyu wekare, Mwari akakuitai vapenyu muna Kristu. Akatikanganwira zvivi zvedu zvose,",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.13",
            "verseOrgIds": [
              "COL.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "COL 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "akadzima mutemo wakanyorwa, nezvirevo zvawo, uyo wakanga uchirwa nesu uye waimira uchipikisana nesu; akaubvisa, achiuroverera pamuchinjikwa.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.14",
            "verseOrgIds": [
              "COL.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "COL 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye akati abvisa ushe namasimba, akazvibudisa pachena, akazvikunda nomuchinjikwa.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.15",
            "verseOrgIds": [
              "COL.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "COL 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo ngakurege kuva nomunhu anokutongai pamusoro pezvamunodya kana kunwa, kana nezvemitambo yechitendero, kupemberera Kugara kwoMwedzi kana zuva reSabata.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.16",
            "verseOrgIds": [
              "COL.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "COL 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izvi mumvuri wezvinhu zvaizouya, kunyange zvakadaro, chokwadi chinowanikwa muna Kristu.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.17",
            "verseOrgIds": [
              "COL.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "COL 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musarega munhu upi zvake anofarira kuzvininipisa kwenhema uye kunamata vatumwa achikutorerai mubayiro wenyu. Munhu akadaro anorondedzera zvikuru pamusoro pezvaakaona, uye nokufunga kwake kwenyama anozvikudza pasina.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.18",
            "verseOrgIds": [
              "COL.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "COL 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akarasika kubva paMusoro, uyo kubva pauri muviri wose, wakasimbiswa uye wakabatanidzwa pamwe chete nemitezo yawo namarunda, unokura sezvinoda Mwari.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.19",
            "verseOrgIds": [
              "COL.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "COL 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sezvo makafa pamwe chete naKristu kune mitemo yenyika ino, seiko muchiita kunge muchiri vayo, muchizviisa pasi pemitemo yayo inoti:",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.20",
            "verseOrgIds": [
              "COL.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "COL 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Usabata! Usaravira! Usagunzva!\"?",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.21",
            "verseOrgIds": [
              "COL.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "COL 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izvi zvose zvichaparadzwa nokubata kwazvo, nokuti zvakavakwa pamirayiro yavanhu nokudzidzisa kwavanhu.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.22",
            "verseOrgIds": [
              "COL.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "COL 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvirokwazvo mitemo yakadai inoita seino uchenjeri, nokunamata kwavo kwokuzvipa, kuzvininipisa kwavo kwenhema uye nokurwadzisa kwavo muviri, asi zvisingagoni kudzivisa kuchiva kwomuviri.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.23",
            "verseOrgIds": [
              "COL.2.23"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "COL.3",
    "number": "3",
