{
  "id": "2CO.8",
  "number": "8",
  "bookId": "2CO",
  "reference": "2 VaKorinde 8",
  "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "2CO 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kupa kunokurudzirwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye zvino, hama, tinoda kuti muzive pamusoro penyasha dzakapiwa naMwari kukereke dzeMasedhonia.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.1",
            "verseOrgIds": [
              "2CO.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakati pokuedzwa kukuru, mufaro wavo mukuru nokushayiwa kwavo kukuru zvakaita kuti vape zvizhinji.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.2",
            "verseOrgIds": [
              "2CO.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti ndinopupura kuti vakapa napavaigona napo, uye kunyange kutopfuura pavaigona napo. Vakaita zvose izvi nokuda kwavo,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.3",
            "verseOrgIds": [
              "2CO.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "vakakumbirisa kwazvo kwatiri kuti vawane mukana wokugoverana nesu muushumiri uhu kuvatsvene.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.4",
            "verseOrgIds": [
              "2CO.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye havana kuita sezvataifunga bedzi, asi kuti vakazvipa ivo pachavo kutanga kuna Ishe mushure mezvo vakazvipa kwatiri maererano nokuda kwaMwari.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.5",
            "verseOrgIds": [
              "2CO.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka takakumbira zvikuru Tito, kuti sezvaakanga atanga, apedzisewo basa iri renyasha kwamuri.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.6",
            "verseOrgIds": [
              "2CO.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi sezvamakagonesesa pazvinhu zvose, pakutenda, pakutaura, pakuziva, napakushingaira kwose uye nomurudo rwenyu, onaiwo kuti mugonesese munyasha idzi dzokupa.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.7",
            "verseOrgIds": [
              "2CO.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Handisi kukurayirai, asi kuti ndinoda kuedza kutendeka kwerudo rwenyu nokukuenzanisa nokushingaira kwavamwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.8",
            "verseOrgIds": [
              "2CO.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti munoziva nyasha dzaIshe wedu Jesu Kristu, kuti kunyange zvake akanga ari mupfumi, asi nokuda kwenyu akava murombo, kuitira kuti kubudikidza nourombo hwake imi mugopfumiswa.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.9",
            "verseOrgIds": [
              "2CO.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye herino zano rangu pane zvichakubatsirai pachinhu ichi: Gore rakapera makava vokutanga kwete pakupa chete asiwo pakuva nechishuvo chokuzviita.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.10",
            "verseOrgIds": [
              "2CO.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino pedzisai basa, kuitira kuti shungu dzenyu dzokuda kuita izvi, dzienzaniswe nokuzvizadzisa kwenyu, maererano nepamunogona napo.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.11",
            "verseOrgIds": [
              "2CO.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti kana chido chiripo, chipo chinogamuchirwa, maererano nezvine munhu, kwete maererano nezvaasina.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.12",
            "verseOrgIds": [
              "2CO.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chishuvo chedu hachisi chokuti vamwe varerukirwe asi imi muchiremerwa, asi kuti pave nokuenzana.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.13",
            "verseOrgIds": [
              "2CO.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva ino kuwana kwenyu kuchavawanisa zvavanoshayiwa, kuitirawo kuti kuwana kwavo kugokuwanisaiwo zvamunoshayiwa. Ipapo pachava nokuenzana,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.14",
            "verseOrgIds": [
              "2CO.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "sezvazvakanyorwa zvichinzi: \"Akaunganidza zvakawanda haana kuva nezvakawandisa, uye akaunganidza zvishoma haana kuva nezvishoma shoma.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.15",
            "verseOrgIds": [
              "2CO.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tito anotumwa kuKorinde",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinovonga Mwari, akaisa mumwoyo maTito hanya seyandinayo kwamuri.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.16",
            "verseOrgIds": [
              "2CO.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti Tito haana kugamuchira chikumbiro chedu bedzi, asi kuti ari kuuyawo kwamuri nokushingaira kukuru uye nokuda kwake hake.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.17",
            "verseOrgIds": [
              "2CO.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye tiri kumutumira kwamuri pamwe chete nehama inorumbidzwa nekereke dzose paushumiri hwevhangeri.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.18",
            "verseOrgIds": [
              "2CO.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CO 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazvisizvo zvoga, akasarudzwawo nekereke kuti atiperekedze pakutakura chipo chatiri kundopa, kuti tikudze Ishe pachake uye kuti tiratidze shungu dzedu dzokuda kubatsira.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.19",
            "verseOrgIds": [
              "2CO.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CO 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinoda kuchenjerera kuti kurege kuva nomunhu angatipa mhosva pamusoro pamabatiro atichaita chipo ichi chikuru.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.20",
            "verseOrgIds": [
              "2CO.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CO 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti tiri kuedza kwazvo kuita zvakanaka, kwete pamberi paShe chete asiwo pamberi penyu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.21",
            "verseOrgIds": [
              "2CO.8.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CO 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamusoro pezvo, tiri kutuma hama yedu pamwe chete navo uyo akaratidza kwatiri nenzira dzakawanda kuti anoshingaira, uye kunyanya iye zvino nokuda kwokuvimba kwake kukuru nemi.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.22",
            "verseOrgIds": [
              "2CO.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CO 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana ari Tito, ndiye shamwari yangu nomubati pamwe chete neni pakati penyu; kana dziri hama dzedu, ndivo vamiririri vekereke uye kukudzwa kwaKristu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.23",
            "verseOrgIds": [
              "2CO.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CO 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo ratidzai varume ava chiratidzo chorudo rwenyu uye chikonzero chokuzvirumbidza kwenyu, kuitira kuti kereke dzigogona kuzviona.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.24",
            "verseOrgIds": [
              "2CO.8.24"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "2CO.9",
    "number": "9",
    "bookId": "2CO"
  },
