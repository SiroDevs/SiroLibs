            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Bhiridhadhi muShuhi akapindura akati:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.25.1",
            "verseOrgIds": [
              "JOB.25.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kubata ushe nokutyiwa ndezvaMwari;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.25.2",
            "verseOrgIds": [
              "JOB.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 25:2"
      },
      "items": [
        {
          "text": "uye anosimbisa rugare kumusoro-soro kudenga.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.25.2",
            "verseOrgIds": [
              "JOB.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mauto ake angaverengwa here?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.25.3",
            "verseOrgIds": [
              "JOB.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 25:3"
      },
      "items": [
        {
          "text": "Ndianiko asingavhenekerwi nechiedza chake?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.25.3",
            "verseOrgIds": [
              "JOB.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino munhu angava akarurama seiko pamberi paMwari?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.25.4",
            "verseOrgIds": [
              "JOB.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 25:4"
      },
      "items": [
        {
          "text": "Ko, munhu akazvarwa nomukadzi angava akachena sei?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.25.4",
            "verseOrgIds": [
              "JOB.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange dai mwedzi ukasachena,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.25.5",
            "verseOrgIds": [
              "JOB.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 25:5"
      },
      "items": [
        {
          "text": "uye nyeredzi dzikasava dzakachena pamberi pake,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.25.5",
            "verseOrgIds": [
              "JOB.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndoda munhu zvake, iro gonye zvaro,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.25.6",
            "verseOrgIds": [
              "JOB.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 25:6"
      },
      "items": [
        {
          "text": "iye mwanakomana womunhu, anongova gonye zvaro!\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.25.6",
            "verseOrgIds": [
              "JOB.25.6"
            ]
          }
        }
      ]
    }
