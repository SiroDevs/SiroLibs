  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "JOB 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mweya wangu waputsika,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.1",
            "verseOrgIds": [
              "JOB.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:1"
      },
      "items": [
        {
          "text": "mazuva angu aitwa mashoma,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.1",
            "verseOrgIds": [
              "JOB.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:1"
      },
      "items": [
        {
          "text": "guva rakandimirira.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.1",
            "verseOrgIds": [
              "JOB.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvirokwazvo vaseki vakandipoteredza;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.2",
            "verseOrgIds": [
              "JOB.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:2"
      },
      "items": [
        {
          "text": "meso angu anofanira kuramba akatarisa ruvengo rwavo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.2",
            "verseOrgIds": [
              "JOB.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndipei, imi Mwari, chitsidzo chamunoda.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.3",
            "verseOrgIds": [
              "JOB.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:3"
      },
      "items": [
        {
          "text": "Ndianiko achandiisira rubatso?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.3",
            "verseOrgIds": [
              "JOB.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makapofumadza ndangariro dzavo pakunzwisisa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.4",
            "verseOrgIds": [
              "JOB.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:4"
      },
      "items": [
        {
          "text": "naizvozvo hamungavatenderi kukunda.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.4",
            "verseOrgIds": [
              "JOB.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana munhu akaramba shamwari dzake nokuda kwomubayiro,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.5",
            "verseOrgIds": [
              "JOB.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:5"
      },
      "items": [
        {
          "text": "meso avana vake achapofumara.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.5",
            "verseOrgIds": [
              "JOB.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mwari akandiita shumo kuvanhu vose,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.6",
            "verseOrgIds": [
              "JOB.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:6"
      },
      "items": [
        {
          "text": "munhu anopfirwa mate kumeso kwake navanhu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.6",
            "verseOrgIds": [
              "JOB.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meso angu aneta nokuchema;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.7",
            "verseOrgIds": [
              "JOB.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:7"
      },
      "items": [
        {
          "text": "muviri wangu wose wangova mumvuri zvawo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.7",
            "verseOrgIds": [
              "JOB.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vakarurama vanokatyamadzwa nazvo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.8",
            "verseOrgIds": [
              "JOB.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:8"
      },
      "items": [
        {
          "text": "vasina mhaka vachamukira vasingadi Mwari.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.8",
            "verseOrgIds": [
              "JOB.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvakadaro, vakarurama vachabatirira panzira dzavo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.9",
            "verseOrgIds": [
              "JOB.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:9"
      },
      "items": [
        {
          "text": "uye vana maoko akachena vachanyanya kusimba.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.9",
            "verseOrgIds": [
              "JOB.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Asi uyai, imi mose, edzaizve!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.10",
            "verseOrgIds": [
              "JOB.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:10"
      },
      "items": [
        {
          "text": "Handingawani murume ane uchenjeri pakati penyu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.10",
            "verseOrgIds": [
              "JOB.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazuva angu apfuura, urongwa hwangu hwaparadzwa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.11",
            "verseOrgIds": [
              "JOB.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:11"
      },
      "items": [
        {
          "text": "saizvozvowo zvishuvo zvomwoyo wangu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.11",
            "verseOrgIds": [
              "JOB.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu ava vanoshandura usiku kuti huve masikati;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.12",
            "verseOrgIds": [
              "JOB.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:12"
      },
      "items": [
        {
          "text": "mukati merima ivo vanoti, 'Chiedza chiri pedyo.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.12",
            "verseOrgIds": [
              "JOB.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana musha wandinotarisira uri guva chete,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.13",
            "verseOrgIds": [
              "JOB.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:13"
      },
      "items": [
        {
          "text": "kana ndikawaridzira mubhedha wangu murima,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.13",
            "verseOrgIds": [
              "JOB.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kana ndikati kuuori, 'Ndiwe baba vangu,'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.14",
            "verseOrgIds": [
              "JOB.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:14"
      },
      "items": [
        {
          "text": "nokuhonye ndikati, 'Ndiwe mai vangu' kana 'Hanzvadzi yangu,'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.14",
            "verseOrgIds": [
              "JOB.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ko, tariro yangu iripi zvino?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.15",
            "verseOrgIds": [
              "JOB.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:15"
      },
      "items": [
        {
          "text": "Ndianiko angaona tariro yangu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.15",
            "verseOrgIds": [
              "JOB.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichaburukira kumasuo orufu here?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.16",
            "verseOrgIds": [
              "JOB.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:16"
      },
      "items": [
        {
          "text": "Tichaburukira muguruva pamwe chete here?\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.16",
            "verseOrgIds": [
              "JOB.17.16"
            ]
          }
        }
      ]
    }
  ],
