{
  "id": "ACT.1",
  "number": "1",
  "bookId": "ACT",
  "reference": "Mabasa 1",
  "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "ACT 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kukwidzwa kwaJesu kuDenga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubhuku rangu rokutanga, Teofirasi, ndakanyora pamusoro pezvose zvakatanga kuitwa uye nokudzidziswa naJesu",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.1",
            "verseOrgIds": [
              "ACT.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kusvikira pazuva raakakwidzwa kudenga, shure kwokunge arayira, kubudikidza noMweya Mutsvene, vapostori vaakanga asarudza.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.2",
            "verseOrgIds": [
              "ACT.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushure mokutambudzika kwake, akazviratidza kuvarume ava uye akaratidza zviratidzo zvakasimba zvizhinji zvokuti akanga ari mupenyu. Akaonekwa navo mazuva anopfuura makumi mana uye akataura nezvoumambo hwaMwari.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.3",
            "verseOrgIds": [
              "ACT.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pane imwe nguva, paakanga achidya navo, akavarayira achiti, \"Musabva muJerusarema, asi mumirire chipo chakavimbiswa naBaba vangu, icho chamakandinzwa ndichitaura pamusoro pacho.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.4",
            "verseOrgIds": [
              "ACT.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti Johani akabhabhatidza nemvura, asi mushure mamazuva mashoma muchabhabhatidzwa noMweya Mutsvene.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.5",
            "verseOrgIds": [
              "ACT.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka, vakati vaungana pamwe chete, vakamubvunza vakati, \"Ishe, mava kuzodzosera ushe kuvaIsraeri panguva ino here?\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.6",
            "verseOrgIds": [
              "ACT.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati kwavari, \"Hazvisi kwamuri kuti muzive nguva kana musi wakatarwa naBaba nesimba ravo pachavo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.7",
            "verseOrgIds": [
              "ACT.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi muchagamuchira simba kana Mweya Mutsvene auya pamusoro penyu; uye muchava zvapupu zvangu muJerusarema, nomuJudhea mose, nomuSamaria, kusvikira kumigumo yenyika.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.8",
            "verseOrgIds": [
              "ACT.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushure mokunge ataura izvi, akakwidzwa kudenga pamberi pameso avo chaipo, uye gore rikamufukidza vakasazomuona.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.9",
            "verseOrgIds": [
              "ACT.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakanga vakatarisisa paakanga achienda, uye pakarepo varume vaviri vakanga vakapfeka nguo chena vakamira pavari.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.10",
            "verseOrgIds": [
              "ACT.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati kwavari, \"Varume veGarirea, makamirireiko pano makatarisa kudenga? Iyeyu Jesu abviswa kwamuri achienda kudenga, achadzokazve sezvamamuona achienda kudenga.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.11",
            "verseOrgIds": [
              "ACT.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Matiasi anosarudzwa kuti atore nzvimbo yaJudhasi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vakadzokera kuJerusarema vachibva kugomo rinonzi reMiorivhi, rwendo rwezuva reSabata uchibva kuguta.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.12",
            "verseOrgIds": [
              "ACT.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati vasvika, vakakwira kuimba yapamusoro kukamuri ravaigara. Vakanga varipo vaiti:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.13",
            "verseOrgIds": [
              "ACT.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "ACT 1:13"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "ACT 1:13"
      },
      "items": [
        {
          "text": "Petro, Johani, Jakobho naAndirea;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.13",
            "verseOrgIds": [
              "ACT.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "ACT 1:13"
      },
      "items": [
        {
          "text": "Firipi naTomasi;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.13",
            "verseOrgIds": [
              "ACT.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "ACT 1:13"
      },
      "items": [
        {
          "text": "Bhatoromeo naMateo;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.13",
            "verseOrgIds": [
              "ACT.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "ACT 1:13"
      },
      "items": [
        {
          "text": "Jakobho mwanakomana waArifeasi naSimoni muZeroti, uye naJudhasi mwanakomana waJakobho.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.13",
            "verseOrgIds": [
              "ACT.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakabatana vose pakuramba vachinyengetera, pamwe chete navakadzi uye naMaria mai vaJesu, navanunʼuna vake.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.14",
            "verseOrgIds": [
              "ACT.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumazuva iwayo, Petro akasimuka pakati pavatendi (ungano yaida kusvika zana namakumi maviri)",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.15",
            "verseOrgIds": [
              "ACT.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "akati, \"Hama, Rugwaro rwaifanira kuzadziswa rwakataurwa noMweya Mutsvene nomuromo waDhavhidhi pamusoro paJudhasi, uyo akabatsira kutungamirira vaya vakasunga Jesu,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.16",
            "verseOrgIds": [
              "ACT.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "akanga ari mumwe wedu uye akanga ano mugove muushumiri uhu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.17",
            "verseOrgIds": [
              "ACT.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Nomubayiro waakawana nokuda kwokuipa kwake, Judhasi akatenga munda; imomo ndimo maakawira pasi nomusoro, muviri wake ukaputika, ura hwake hukabuda.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.18",
            "verseOrgIds": [
              "ACT.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munhu wose akanzwa nezvazvo muJerusarema, saka vakatumidza munda uya nomutauro wavo kuti Akeridhama, ndiko kuti, Munda weRopa.)",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.19",
            "verseOrgIds": [
              "ACT.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petro akati, \"Nokuti kwakanyorwa mubhuku raMapisarema kuti,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.20",
            "verseOrgIds": [
              "ACT.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ACT 1:20"
      },
      "items": [
        {
          "text": "\" 'Musha wake ngauve dongo;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.20",
            "verseOrgIds": [
              "ACT.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ACT 1:20"
      },
      "items": [
        {
          "text": "ngakurege kuva nomunhu anogaramo,'",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.20",
            "verseOrgIds": [
              "ACT.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "ACT 1:20"
      },
      "items": [
        {
          "text": "uye kuti,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.20",
            "verseOrgIds": [
              "ACT.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ACT 1:20"
      },
      "items": [
        {
          "text": "\" 'Mumwe ngaatore nzvimbo yake youtungamiri.'",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.20",
            "verseOrgIds": [
              "ACT.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo zvakafanira kuti kusarudzwe mumwe murume akanga anesu nguva yose Ishe Jesu paaipinda nokubuda pakati pedu,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.21",
            "verseOrgIds": [
              "ACT.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "kutanga parubhabhatidzo rwaJohani kusvikira panguva yakabviswa Jesu kwatiri. Nokuti mumwe waava anofanira kuva chapupu chokumuka kwake, pamwe chete nesu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.22",
            "verseOrgIds": [
              "ACT.1.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vakasarudza varume vaviri vaiti: Josefa ainzi Bhanabhasi (aizivikanwawo sokunzi Jastasi) naMatiasi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.23",
            "verseOrgIds": [
              "ACT.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vakanyengetera vachiti, \"Ishe, munoziva mwoyo yavanhu vose. Tiratidzei pakati pavaviri ava wamasarudza",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.24",
            "verseOrgIds": [
              "ACT.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti atore basa iri roupostori, rakasiyiwa naJudhasi achienda kunzvimbo yake.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.25",
            "verseOrgIds": [
              "ACT.1.25"
            ]
