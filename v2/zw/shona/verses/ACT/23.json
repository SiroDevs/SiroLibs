  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "ACT 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pauro akatarisisa kuDare Guru ravaJudha akati kwavari, \"Hama dzangu, ini ndakaita basa rangu kuna Mwari nehana yakanaka kusvikira zuva ranhasi.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.1",
            "verseOrgIds": [
              "ACT.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo muprista mukuru ainzi Ananiasi akarayira vaya vakanga vamire pedyo naye kuti vamurove pamuromo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.2",
            "verseOrgIds": [
              "ACT.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Pauro akati kwaari, \"Mwari achakurova, iwe chidziro chakacheneswa nependi! Ugere ipapo kuti unditonge maererano nomurayiro, asi iwe pachako unodarika murayiro nokurayira kuti ndirohwe!\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.3",
            "verseOrgIds": [
              "ACT.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaya vakanga vamire pedyo naPauro vakati, \"Iwe uri kutotuka muprista mukuru waMwari nhai?\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.4",
            "verseOrgIds": [
              "ACT.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pauro akapindura akati, \"Hama dzangu, ndanga ndisingazivi kuti ndiye muprista mukuru; nokuti kwakanyorwa kuchinzi: 'Usataura zvakaipa pamusoro pomubati wavanhu vako.' \"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.5",
            "verseOrgIds": [
              "ACT.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Pauro, achiziva kuti vamwe vavo vakanga vari vaSadhusi uye kuti vamwe vakanga vari vaFarisi, akadanidzira kuDare Guru akati, \"Hama dzangu, ini ndiri muFarisi, mwanakomana womuFarisi. Ndimire pano ndichitongwa nokuda kwetariro yangu yokumuka kwavakafa.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.6",
            "verseOrgIds": [
              "ACT.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati ataura izvozvo, nharo dzakamuka pakati pavaFarisi navaSadhusi, nokudaro ungano yakapesana.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.7",
            "verseOrgIds": [
              "ACT.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaSadhusi vanoti hakuna kumuka kwavakafa, uye kuti hakuna mutumwa kana mweya, asi vaFarisi vanotenda izvozvo zvose.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.8",
            "verseOrgIds": [
              "ACT.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakava nebope guru, uye vamwe vadzidzisi vomurayiro vainge vari vaFarisi vakasimuka vakaita nharo zvikuru. Vakati, \"Hatina chakaipa chatinoona pamunhu uyu. Ko, kana ari mweya kana mutumwa akataura kwaari?\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.9",
            "verseOrgIds": [
              "ACT.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kupesana kwakava nemhirizhonga zvokuti mukuru wamauto akatya kuti Pauro angangobvamburwa-bvamburwa navo. Akarayira varwi kuti vaburuke vandomutora vamubvise kwavari nechisimba vagomuendesa kudzimba dzavarwi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.10",
            "verseOrgIds": [
              "ACT.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usiku hwakatevera, Ishe akamira pedyo naPauro akati kwaari, \"Tsunga mwoyo! Sezvawapupura pamusoro pangu muJerusarema, saizvozvo unofanira kundopupurawo muRoma.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.11",
            "verseOrgIds": [
              "ACT.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rangano yoKuuraya Pauro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fume mangwana, vaJudha vakaita rangano vakazvisunga nemhiko kuti varege kudya kana kunwa kusvikira vauraya Pauro.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.12",
            "verseOrgIds": [
              "ACT.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume vaipfuura makumi mana ndivo vakaita rangano iyi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.13",
            "verseOrgIds": [
              "ACT.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakaenda kuvaprista vakuru navakuru vakati, \"Isu tazvisunga nemhiko kuti tirege kudya kana chinhu kusvikira tauraya Pauro.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.14",
            "verseOrgIds": [
              "ACT.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino imi neDare Guru ravaJudha kumbirai mukuru wavarwi kuti amuuyise pamberi penyu muchiita somunoda kubvunzisisa pamusoro penyaya iyi. Isu takagadzirira kumuuraya asati asvika kuno.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.15",
            "verseOrgIds": [
              "ACT.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi, mwanakomana wehanzvadzi yaPauro akati anzwa rangano iyi, akapinda mudzimba dzavarwi akandoudza Pauro.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.16",
            "verseOrgIds": [
              "ACT.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Pauro akadana mumwe wavakuru vezana akati kwaari, \"Tora jaya iri uende naro kumukuru wavarwi; ane zvaari kuda kumutaurira.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.17",
            "verseOrgIds": [
              "ACT.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka akaenda naye kumukuru wavarwi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.18",
            "verseOrgIds": [
              "ACT.23.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ACT 23:18"
      },
      "items": [
        {
          "text": "Mukuru wezana akati, \"Pauro, musungwa uya, andidaidza akandikumbira kuti ndiuye nejaya iri, kwamuri nokuti rine zvarinoda kukuudzai.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.18",
            "verseOrgIds": [
              "ACT.23.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukuru wavarwi akabata ruoko rwejaya, akaenda naye padivi akamubvunza akati, \"Chii chauri kuda kundiudza?\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.19",
            "verseOrgIds": [
              "ACT.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye akati, \"VaJudha vakatenderana kukukumbirai kuti muuyise Pauro pamberi peDare Guru ravaJudha mangwana vachiita sevanoda kunyatsobvunzisisa pamusoro pake.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.20",
            "verseOrgIds": [
              "ACT.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musavanzwa, nokuti pane vamwe vavo vanopfuura makumi mana vakamuvandira. Vakatozvisunga nemhiko kuti varege kudya kana kunwa kusvikira vamuuraya. Vakatogadzirira izvozvi, vakamirira kubvuma kwenyu chikumbiro chavo.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.21",
            "verseOrgIds": [
              "ACT.23.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukuru wavarwi akaita kuti jaya iri riende uye akamuyambira achiti, \"Usaudza munhu kuti wataura izvi kwandiri.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.22",
            "verseOrgIds": [
              "ACT.23.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pauro anoendeswa kuKesaria",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akadana vakuru vezana vaviri akavarayira achiti, \"Gadzirirai mazana maviri avarwi, navanotasva mabhiza makumi manomwe uye mazana maviri avarume vane mapfumo kuti vaende kuKesaria nenguva dzepfumbamwe manheru.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.23",
            "verseOrgIds": [
              "ACT.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutsvakirewo Pauro bhiza rokutasva kuitira kuti andosvika zvakanaka kuMubati Ferikisi.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.24",
            "verseOrgIds": [
              "ACT.23.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanyora tsamba yaiti:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.25",
            "verseOrgIds": [
              "ACT.23.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiraudhiyo Risiasi, kuna Changamire, Mubati Ferikisi:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.26",
            "verseOrgIds": [
              "ACT.23.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo",
        "vid": "ACT 23:26"
      },
      "items": [
        {
          "text": "Kwaziwai.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.26",
            "verseOrgIds": [
              "ACT.23.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murume uyu akabatwa navaJudha uye vakanga voda kumuuraya, asi ini ndakabva ndasvika navarwi vangu ndikamununura, nokuti ndakanga ndanzwa kuti muRoma.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.27",
            "verseOrgIds": [
              "ACT.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakada kuziva kuti sei vakanga vachimupomera mhosva, saka ndikamuendesa kuDare ravo Guru.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.28",
            "verseOrgIds": [
              "ACT.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakaona kuti aipomerwa mhosva pamusoro pamashoko omurayiro wavo, asi pakanga pasina mhosva ingafanira rufu kana kupfigirwa mutorongo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.29",
            "verseOrgIds": [
              "ACT.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pandakanyeverwa pamusoro perangano yaakanga arongerwa, ndakabva ndamutumira kwamuri pakarepo. Ndakazivisawo vapomeri vake kuti vazosvitsa kwamuri mhosva yavanomupomera.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.30",
            "verseOrgIds": [
              "ACT.23.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka varwi vakaita sezvavakanga varayirwa, vakatora Pauro vakaenda naye usiku vakandosvika naye kuAndipatirisi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.31",
            "verseOrgIds": [
              "ACT.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zuva rakatevera, vakarega vamabhiza vachienda naye, ivo vachibva vadzokera kudzimba dzavarwi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.32",
            "verseOrgIds": [
              "ACT.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vatasvi vamabhiza vakati vasvika kuKesaria, vakapa tsamba kumubati ndokubva vaisa Pauro mumaoko ake.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.33",
            "verseOrgIds": [
              "ACT.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubati akaverenga tsamba akamubvunza kuti akanga achibva kudunhu ripi. Akati aziva kuti akanga achibva kuSirisia,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.34",
            "verseOrgIds": [
              "ACT.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "akati kwaari, \"Ndichazonzwa nyaya yako kana vanokupomera vasvika.\" Ipapo akarayira kuti Pauro achengetwe navarindi vomumuzinda waHerodhi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.35",
            "verseOrgIds": [
              "ACT.23.35"
            ]
          }
        }
      ]
    }
  ],
