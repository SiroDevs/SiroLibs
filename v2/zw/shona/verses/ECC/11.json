  "verseCount": 10,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "ECC 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chingwa pamusoro peMvura",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanda chingwa chako pamusoro pemvura zhinji,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.1",
            "verseOrgIds": [
              "ECC.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:1"
      },
      "items": [
        {
          "text": "nokuti mushure mamazuva mazhinji uchachiwanazve.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.1",
            "verseOrgIds": [
              "ECC.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Govera vanomwe, kunyange navaserewo;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.2",
            "verseOrgIds": [
              "ECC.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:2"
      },
      "items": [
        {
          "text": "nokuti hauzivi kuti idambudziko rakadii richauya panyika.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.2",
            "verseOrgIds": [
              "ECC.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana makore azara nemvura",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.3",
            "verseOrgIds": [
              "ECC.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:3"
      },
      "items": [
        {
          "text": "anonayisa mvura panyika.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.3",
            "verseOrgIds": [
              "ECC.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 11:3"
      },
      "items": [
        {
          "text": "Hazvinei kuti muti wawira zasi kana kumusoro,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.3",
            "verseOrgIds": [
              "ECC.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:3"
      },
      "items": [
        {
          "text": "panzvimbo paunowira, ndipo paucharara.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.3",
            "verseOrgIds": [
              "ECC.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani naani anotarira mhepo haangadyari;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.4",
            "verseOrgIds": [
              "ECC.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:4"
      },
      "items": [
        {
          "text": "ani naani anotarira makore haangakohwi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.4",
            "verseOrgIds": [
              "ECC.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sezvo usingazivi nzira yemhepo,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.5",
            "verseOrgIds": [
              "ECC.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:5"
      },
      "items": [
        {
          "text": "kana magadzirirwo omuviri mudumbu ramai,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.5",
            "verseOrgIds": [
              "ECC.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 11:5"
      },
      "items": [
        {
          "text": "saizvozvowo haunganzwisisi basa raMwari,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.5",
            "verseOrgIds": [
              "ECC.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:5"
      },
      "items": [
        {
          "text": "Muiti wezvose.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.5",
            "verseOrgIds": [
              "ECC.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kusha mbeu dzako mangwanani,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.6",
            "verseOrgIds": [
              "ECC.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:6"
      },
      "items": [
        {
          "text": "uye madekwana urege kugarira maoko ako,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.6",
            "verseOrgIds": [
              "ECC.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 11:6"
      },
      "items": [
        {
          "text": "nokuti hauzivi kuti chichabudirira ndechipi,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.6",
            "verseOrgIds": [
              "ECC.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:6"
      },
      "items": [
        {
          "text": "chingava ichi kana icho,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.6",
            "verseOrgIds": [
              "ECC.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:6"
      },
      "items": [
        {
          "text": "kana kuti zvose zviri zviviri zvichafanana pakunaka.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.6",
            "verseOrgIds": [
              "ECC.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rangarira Musiki wako uchiri muduku",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiedza chakanaka,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.7",
            "verseOrgIds": [
              "ECC.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:7"
      },
      "items": [
        {
          "text": "uye zvinofadza meso kuona zuva.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.7",
            "verseOrgIds": [
              "ECC.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvazvo munhu akararama makore mazhinji,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.8",
            "verseOrgIds": [
              "ECC.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:8"
      },
      "items": [
        {
          "text": "ngaafadzwe nawo ose.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.8",
            "verseOrgIds": [
              "ECC.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 11:8"
      },
      "items": [
        {
          "text": "Asi ngaarangarire mazuva erima,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.8",
            "verseOrgIds": [
              "ECC.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:8"
      },
      "items": [
        {
          "text": "nokuti achava mazhinji.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.8",
            "verseOrgIds": [
              "ECC.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:8"
      },
      "items": [
        {
          "text": "Zvose zvichazouya hazvina maturo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.8",
            "verseOrgIds": [
              "ECC.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fara zvako jaya, pauduku hwako,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.9",
            "verseOrgIds": [
              "ECC.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:9"
      },
      "items": [
        {
          "text": "uye mwoyo wako ngaukupe mufaro pamazuva ouduku hwako.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.9",
            "verseOrgIds": [
              "ECC.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 11:9"
      },
      "items": [
        {
          "text": "Tevera nzira dzomwoyo wako,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.9",
            "verseOrgIds": [
              "ECC.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:9"
      },
      "items": [
        {
          "text": "nezvose zvingaonekwe nameso ako,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.9",
            "verseOrgIds": [
              "ECC.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 11:9"
      },
      "items": [
        {
          "text": "asi uzive kuti pazvinhu zvose izvi",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.9",
            "verseOrgIds": [
              "ECC.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:9"
      },
      "items": [
        {
          "text": "Mwari achakusvitsa pakutongwa.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.9",
            "verseOrgIds": [
              "ECC.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka zvino dzinga zvinonetsa pamwoyo",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.10",
            "verseOrgIds": [
              "ECC.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:10"
      },
      "items": [
        {
          "text": "wako ugobvisa zvinotambudza pamuviri wako,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.10",
            "verseOrgIds": [
              "ECC.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:10"
      },
      "items": [
        {
          "text": "nokuti uduku nesimba hazvina maturo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.10",
            "verseOrgIds": [
              "ECC.11.10"
            ]
          }
        }
      ]
    }
  ],
