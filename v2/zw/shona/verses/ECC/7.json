  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "ECC 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Uchenjeri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zita rakanaka rinopfuura mafuta anonhuhwira zvakanaka kwazvo,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.1",
            "verseOrgIds": [
              "ECC.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:1"
      },
      "items": [
        {
          "text": "uye zuva rokufa rinopfuura zuva rokuzvarwa.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.1",
            "verseOrgIds": [
              "ECC.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zviri nani kuenda kuimba yokuchema",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.2",
            "verseOrgIds": [
              "ECC.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:2"
      },
      "items": [
        {
          "text": "pano kuenda kuimba yamabiko,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.2",
            "verseOrgIds": [
              "ECC.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 7:2"
      },
      "items": [
        {
          "text": "nokuti rufu ndiwo mugumo womunhu wose;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.2",
            "verseOrgIds": [
              "ECC.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:2"
      },
      "items": [
        {
          "text": "vapenyu ngavazviise izvi pamwoyo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.2",
            "verseOrgIds": [
              "ECC.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kusuwa kunopfuura kuseka,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.3",
            "verseOrgIds": [
              "ECC.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:3"
      },
      "items": [
        {
          "text": "nokuti chiso chinopunyaira chakanakira mwoyo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.3",
            "verseOrgIds": [
              "ECC.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwoyo womuchenjeri uri mumba yokuchema,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.4",
            "verseOrgIds": [
              "ECC.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:4"
      },
      "items": [
        {
          "text": "asi mwoyo yamapenzi iri kuimba yamafaro.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.4",
            "verseOrgIds": [
              "ECC.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zviri nani kuteerera kutsiura kwomunhu akachenjera,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.5",
            "verseOrgIds": [
              "ECC.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:5"
      },
      "items": [
        {
          "text": "pano kuteerera rwiyo rwamapenzi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.5",
            "verseOrgIds": [
              "ECC.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sokuputika kweminzwa pasi pehari,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.6",
            "verseOrgIds": [
              "ECC.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:6"
      },
      "items": [
        {
          "text": "ndizvo zvakaita kuseka kwamapenzi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.6",
            "verseOrgIds": [
              "ECC.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:6"
      },
      "items": [
        {
          "text": "Naizvozviwo hazvina maturo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.6",
            "verseOrgIds": [
              "ECC.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Udzvinyiriri hunoshandura muchenjeri achiva benzi,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.7",
            "verseOrgIds": [
              "ECC.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:7"
      },
      "items": [
        {
          "text": "uye fufuro inosvibisa mwoyo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.7",
            "verseOrgIds": [
              "ECC.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magumo echinhu anopfuura mavambo acho,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.8",
            "verseOrgIds": [
              "ECC.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:8"
      },
      "items": [
        {
          "text": "uye mwoyo murefu unopfuura kuzvikudza.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.8",
            "verseOrgIds": [
              "ECC.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usakurumidza kutsamwa pamweya wako",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.9",
            "verseOrgIds": [
              "ECC.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:9"
      },
      "items": [
        {
          "text": "nokuti kutsamwa kunogara muchipfuva chamapenzi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.9",
            "verseOrgIds": [
              "ECC.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usati, \"Sei mazuva akare ari nani kupfuura azvino?\"",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.10",
            "verseOrgIds": [
              "ECC.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:10"
      },
      "items": [
        {
          "text": "Nokuti hazvina kuchenjera kubvunza mibvunzo yakadaro.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.10",
            "verseOrgIds": [
              "ECC.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uchenjeri chinhu chakanaka senhaka,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.11",
            "verseOrgIds": [
              "ECC.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:11"
      },
      "items": [
        {
          "text": "uye hunobatsira avo vanoona zuva.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.11",
            "verseOrgIds": [
              "ECC.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uchenjeri hunodzivirira sokudzivirira kunoita mari,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.12",
            "verseOrgIds": [
              "ECC.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:12"
      },
      "items": [
        {
          "text": "asi kunakisa kworuzivo ndokuku:",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.12",
            "verseOrgIds": [
              "ECC.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 7:12"
      },
      "items": [
        {
          "text": "kuti uchenjeri hunochengetedza",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.12",
            "verseOrgIds": [
              "ECC.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:12"
      },
      "items": [
        {
          "text": "upenyu hwomunhu anahwo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.12",
            "verseOrgIds": [
              "ECC.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cherechedza zvakaitwa naMwari:",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.13",
            "verseOrgIds": [
              "ECC.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 7:13"
      },
      "items": [
        {
          "text": "Ndiani angatwasanudza",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.13",
            "verseOrgIds": [
              "ECC.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:13"
      },
      "items": [
        {
          "text": "zvaakagonyanisa?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.13",
            "verseOrgIds": [
              "ECC.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana zvinhu zvakanaka, fara;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.14",
            "verseOrgIds": [
              "ECC.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:14"
      },
      "items": [
        {
          "text": "asi kana nguva dzakaipa, rangarira kuti:",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.14",
            "verseOrgIds": [
              "ECC.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 7:14"
      },
      "items": [
        {
          "text": "Mwari ndiye akaita izvozvo",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.14",
            "verseOrgIds": [
              "ECC.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:14"
      },
      "items": [
        {
          "text": "zvose zviri zviviri.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.14",
            "verseOrgIds": [
              "ECC.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 7:14"
      },
      "items": [
        {
          "text": "Naizvozvo, munhu haagoni kuziva chinhu",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.14",
            "verseOrgIds": [
              "ECC.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:14"
      },
      "items": [
        {
          "text": "pamusoro peramangwana rake.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.14",
            "verseOrgIds": [
              "ECC.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muupenyu hwangu husina maturo ndakaona zvose izvi:",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.15",
            "verseOrgIds": [
              "ECC.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
