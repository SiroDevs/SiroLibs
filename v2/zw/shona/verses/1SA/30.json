  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "1SA 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dhavhidhi anoparadza vaAmareki",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi navanhu vake vakasvika kuZikiragi pazuva retatu. Zvino vaAmareki vakanga vakomba Negevhi neZikiragi. Vakanga varwisa Zikiragi vakaripisa,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.1",
            "verseOrgIds": [
              "1SA.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye vakanga vatapa vakadzi navose vakanga varimo, vose vakuru navaduku. Havana wavakauraya, asi vakavatora vakaenda navo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.2",
            "verseOrgIds": [
              "1SA.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi navanhu vake vakati vasvika kuZikiragi, vakariwana raparadzwa nomoto, uye vakadzi vavo navanakomana navanasikana vavo vakanga vatapwa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.3",
            "verseOrgIds": [
              "1SA.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Dhavhidhi navanhu vake vakachema kwazvo kusvikira vapererwa nesimba rokuchema.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.4",
            "verseOrgIds": [
              "1SA.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakadzi vaDhavhidhi vari vaviri vakanga vatapwa, Ahinoami weJezireeri naAbhigairi, chirikadzi yaNabhari weKarimeri.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.5",
            "verseOrgIds": [
              "1SA.30.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akatambudzika zvikuru nokuti vanhu vakanga vachitaura zvokuda kumutaka namabwe; mumwe nomumwe akanga ane shungu mumweya make nokuda kwavanakomana navanasikana vake. Asi Dhavhidhi akawana simba muna Jehovha Mwari wake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.6",
            "verseOrgIds": [
              "1SA.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Dhavhidhi akati kuna Abhiatari muprista, mwanakomana waAhimereki, \"Ndivigirewo efodhi kuno.\" Abhiatari akaenda nayo kwaari,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.7",
            "verseOrgIds": [
              "1SA.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ipapo Dhavhidhi akabvunza kuna Jehovha akati, \"Ndingatevera here vapambi ava? Ndichavabata here?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.8",
            "verseOrgIds": [
              "1SA.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 30:8"
      },
      "items": [
        {
          "text": "Akapindura akati, \"Vatevere. Zvirokwazvo uchavabata uye uchakunda mukuvanunura.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.8",
            "verseOrgIds": [
              "1SA.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi navarume mazana matanhatu vaiva naye vakasvika parukova rweBhesori, vamwe vakasara ipapo,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.9",
            "verseOrgIds": [
              "1SA.30.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti varume mazana maviri vakanga vaneta kwazvo kuti vayambuke rukova. Asi Dhavhidhi namazana mana avarume vakaramba vachitevera.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.10",
            "verseOrgIds": [
              "1SA.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakawana muIjipita ari mumunda ndokubva vauya naye kuna Dhavhidhi. Vakamupa mvura yokunwa nezvokudya kuti adye,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.11",
            "verseOrgIds": [
              "1SA.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "chimedu chekeke ramaonde akaoma uye makeke maviri amazambiringa akaomeswa. Akadya akasimba, nokuti akanga asina kudya chipi zvacho kana kunwa mvura kwamazuva matatu nousiku hutatu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.12",
            "verseOrgIds": [
              "1SA.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akamubvunza akati, \"Uri waaniko iwe, uye unobvepi?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.13",
            "verseOrgIds": [
              "1SA.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 30:13"
      },
      "items": [
        {
          "text": "Iye akati, \"Ndiri muIjipita, mutapwa womumwe muAmareki. Tenzi wangu akandisiya pandakanga ndorwara mazuva matatu apfuura.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.13",
            "verseOrgIds": [
              "1SA.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Takapamba Zasi kwenyika yavaKereti uye nenyika yeJudha neZasi kwenyika yaKarebhu. Uye takapisa Zikiragi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.14",
            "verseOrgIds": [
              "1SA.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akamubvunza akati, \"Ungagona kunditungamirira here kuti ndiburuke ndiende kuvapambi ava.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.15",
            "verseOrgIds": [
              "1SA.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 30:15"
      },
      "items": [
        {
          "text": "Iye akapindura akati, \"Ndipikirei pamberi paMwari kuti hamuzondiurayi kana kundiisa kuna tenzi wangu, ini ndigokutungamirirai kwavari.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.15",
            "verseOrgIds": [
              "1SA.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatungamirira Dhavhidhi ikoko, vakavawana vakapararira munzvimbo yose, vachidya, vachinwa uye vachifara nokuda kwokuwanda kwezvavakanga vapamba kubva munyika yavaFiristia nokuJudha.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.16",
            "verseOrgIds": [
              "1SA.30.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akarwa navo panguva yorubvunzavaeni kusvikira madekwana ezuva rakatevera, uye hakuna mumwe wavo akapunyuka, kunze kwamajaya mazana mana akatasva ngamera akatiza.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.17",
            "verseOrgIds": [
              "1SA.30.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akadzosa zvose zvakanga zvatorwa navaAmareki, pamwe chete navakadzi vake vaviri.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.18",
            "verseOrgIds": [
              "1SA.30.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuna chakashayikwa: vaduku navakuru, mukomana kana musikana, chakapambwa kana chipi zvacho chavakanga vatora. Dhavhidhi akadzosa zvose.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.19",
            "verseOrgIds": [
              "1SA.30.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatora makwai ose nemombe dzose, uye vanhu vake vakazvitinha mberi kwezvimwe zvipfuwo, achiti, \"Izvi ndizvo zvakapambwa naDhavhidhi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.20",
            "verseOrgIds": [
              "1SA.30.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Dhavhidhi akasvika kuvarume vaya mazana maviri vakanga vaneta kwazvo pakumutevera uye vakanga vasiyiwa mumashure parukova rweBhesori. Vakabuda kuti vazosangana naDhavhidhi uye navanhu vakanga vanaye. Dhavhidhi navanhu vake vakati vaswedera kwavari, vakavakwazisa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.21",
            "verseOrgIds": [
              "1SA.30.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vanhu vose vakaipa nevemhirizhonga pakati pavateveri vaDhavhidhi vakati, \"Nemhaka yokuti havana kuenda nesu, hatidi kugovana navo zvatakapamba zvatakawana. Kunyange zvakadaro, murume mumwe nomumwe ngaatore hake mukadzi wake navana aende.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.22",
            "verseOrgIds": [
              "1SA.30.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 30:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akati, \"Kwete hama dzangu, hamufaniri kuita izvozvo pane zvatakapiwa naJehovha. Ndiye akatidzivirira akaisa mumaoko edu varwi vakauya kuzorwa nesu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.23",
            "verseOrgIds": [
              "1SA.30.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndianiko achateerera kune zvamunoreva? Mugove womunhu akasara achichengeta nhumbi unofanira kuva wakaenzana nowouyo akaenda kuhondo.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.24",
            "verseOrgIds": [
              "1SA.30.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akaita izvi kuti uve mutemo nomurayiro kuvaIsraeri kubva pazuva iroro kusvikira nhasi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.25",
            "verseOrgIds": [
              "1SA.30.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akati asvika muZikiragi, akatumira zvimwe zvezvakapambwa kuvakuru veJudha, avo vakanga vari shamwari dzake, achiti, \"Hecho chipo chenyu chamapiwa chabva pane zvakapambwa zvavavengi vaJehovha.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.26",
            "verseOrgIds": [
              "1SA.30.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 30:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akachitumira kuna vaya vakanga vari muBheteri, Ramoti Negevhi neJariri;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.27",
            "verseOrgIds": [
              "1SA.30.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 30:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuna avo vakanga vari muAroeri, Sifimoti, Eshitemoa",
          "type": "text",
          "attrs": {
