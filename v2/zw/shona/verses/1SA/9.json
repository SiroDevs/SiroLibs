  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "1SA 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Samueri anozodza Sauro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakanga kuno murume worudzi rwaBhenjamini, ainzi Kishi mwanakomana waAbhieri, mwanakomana waZerori, mwanakomana waBhekorati, mwanakomana waAfia muBhenjamini, murume wesimba noumhare.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.1",
            "verseOrgIds": [
              "1SA.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aiva nomwanakomana ainzi Sauro, jaya raiyemurika rakanga risina akaenzana naro pakati pavaIsraeri, rakanga rakareba kupfuura vose.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.2",
            "verseOrgIds": [
              "1SA.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino mbongoro dzaKishi, baba vaSauro, dzakanga dzarasika, Kishi akati kuna Sauro mwanakomana wake, \"Tora mumwe wavaranda uende naye kundotsvaga mbongoro.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.3",
            "verseOrgIds": [
              "1SA.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka akapfuura nomunyika yamakomo yeEfuremu, akapfuurawo nomunzvimbo yakapoteredza Sharisha, asi havana kudziwana. Vakapfuurira mberi nomudunhu reSharimu, asi mbongoro dzakanga dzisiko. Ipapo akapfuura nomunyika yaBhenjamini, asi havana kudziwana.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.4",
            "verseOrgIds": [
              "1SA.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pavakasvika mudunhu reZufi, Sauro akati kumuranda waaiva naye, \"Uya tidzokere, zvimwe baba vangu vangarega kufunga nezvembongoro vakatanga kufunganya pamusoro pedu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.5",
            "verseOrgIds": [
              "1SA.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi muranda akapindura achiti, \"Tarirai, muguta rino mune munhu waMwari; anoremekedzwa zvikuru uye zvinhu zvose zvaanotaura zvinoitika. Handei ikoko iye zvino. Zvichida achatiudza nzira yokuenda nayo.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.6",
            "verseOrgIds": [
              "1SA.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauro akati kumuranda, \"Kana tikaenda, murume uyu tingandomupei? Zvokudya zvanga zviri mumasaga edu zvapera. Hatina chipo chokundopa munhu waMwari. Chii chatinacho?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.7",
            "verseOrgIds": [
              "1SA.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muranda akamupindura zvakare achiti, \"Tarirai, ndine chikamu chimwe chete muzvina cheshekeri",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.8",
            "verseOrgIds": [
              "1SA.9.8"
            ]
          }
        },
        {
          "text": "resirivha. Ndichachipa kumunhu waMwari kuti agotiudza nzira yokuenda nayo.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.8",
            "verseOrgIds": [
              "1SA.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kare munyika yeIsraeri, kana munhu achienda kundobvunza Mwari, aiti, \"Handei kumuoni,\" nokuti muprofita wanhasi ainzi muoni kare.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.9",
            "verseOrgIds": [
              "1SA.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauro akati kumuranda wake, \"Zvakanaka, uya tiende.\" Saka vakasimuka vakananga kuguta kwaiva nomunhu waMwari.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.10",
            "verseOrgIds": [
              "1SA.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pavaikwira gomo kuenda kuguta iri, vakasangana navasikana vaienda kundochera mvura, vakavabvunza vachiti, \"Muoni aripo here?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.11",
            "verseOrgIds": [
              "1SA.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakapindura vachiti, \"Aripo. Ari mberi kwenyu. Kurumidzai achangosvika iye zvino muguta redu, nokuti vanhu vane chibayiro panzvimbo yakakwirira.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.12",
            "verseOrgIds": [
              "1SA.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muchingopinda muguta muchamuwana asati aenda kunzvimbo yakakwirira kundodya. Vanhu havatangi kudya asati auya, nokuti anofanira kuropafadza chibayiro; mushure maizvozvo, avo vanenge vakakokwa vozodya. Endai iye zvino; munofanira kumuwana nguva idzo dzino.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.13",
            "verseOrgIds": [
              "1SA.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakakwidza kuguta, uye pavakanga vava kupindamo vakaona Samueri achiuya nokwavakanga vari, ari munzira yake achikwidza kunzvimbo yakakwirira.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.14",
            "verseOrgIds": [
              "1SA.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nezuro wacho Sauro asati asvika, Jehovha akanga aratidza izvi kuna Samueri:",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.15",
            "verseOrgIds": [
              "1SA.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nenguva inenge ino mangwana ndichakutumira mumwe anobva kunyika yaBhenjamini. Muzodze kuti ave mambo pamusoro pavanhu vangu veIsraeri; achanunura vanhu vangu kubva muruoko rwavaFiristia. Ndatarira vanhu vangu, nokuti kuchema kwavo kwasvika kwandiri.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.16",
            "verseOrgIds": [
              "1SA.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samueri paakangoona Sauro, Jehovha akati kwaari, \"Uyu ndiye murume wandakataura newe pamusoro pake; achatonga vanhu vangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.17",
            "verseOrgIds": [
              "1SA.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauro akaenda kuna Samueri pasuo akamubvunza achiti, \"Mungandiudzewo here kune imba yomuoni?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.18",
            "verseOrgIds": [
              "1SA.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samueri akapindura akati, \"Ndini muoni. Chitungamira mberi kwangu kunzvimbo yakakwirira, nokuti nhasi unofanira kudya neni, mangwanani ndichakurega uchienda uye ndichakuudza zvose zviri mumwoyo mako.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.19",
            "verseOrgIds": [
              "1SA.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana zviri zvembongoro dzawakarasa mazuva matatu apfuura, usafunganya pamusoro padzo, dzakawanikwa. Zvino zvido zvose zveIsraeri zvatarira kuna ani kana kusiri kwauri iwe nemhuri yose yababa vako?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.20",
            "verseOrgIds": [
              "1SA.9.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauro akapindura achiti, \"Ko, handisi muBhenjamini, worudzi rudiki pane mamwe ose aIsraeri here, uye mhuri yangu haisi diki here pamhuri dzose dzaBhenjamini? Sei muchitaura chinhu chakadaro kwandiri?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.21",
            "verseOrgIds": [
              "1SA.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Samueri akatora Sauro nomuranda wake akapinda navo mumba yokudyira akavagadzika kumusoro kwaavo vakanga vakokwa, vaisvika makumi matatu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.22",
            "verseOrgIds": [
              "1SA.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samueri akati kumubiki, \"Uya nechidimbu chenyama chandakakupa, chiya chandakuudza kuti uise parutivi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.23",
            "verseOrgIds": [
              "1SA.9.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo mubiki akatora gumbo nezvaiva pariri akazvigadzika pamberi paSauro. Samueri akati, \"Hezvi zvawakanga wachengeterwa. Idya, nokuti zvanga zvakachengeterwa iwe panguva ino, kubvira panguva yandakati, 'Ndakoka vanhu.' \" Zvino Sauro akadya naSamueri musi iwoyo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.24",
            "verseOrgIds": [
              "1SA.9.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushure mokunge vadzika kubva kunzvimbo yakakwirira vakaenda kuguta, Samueri akataura naSauro ari pamusoro pedenga reimba yake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.25",
            "verseOrgIds": [
              "1SA.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakamuka zuva richangobuda Samueri akadana Sauro ari padenga pemba akati, \"Gadzirira ndigokurega uende hako.\" Sauro akati agadzirira iye naSamueri vakabuda panze pamwe chete.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.26",
            "verseOrgIds": [
              "1SA.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pavakanga vachienda kumucheto weguta, Samueri akati kuna Sauro, \"Taurira muranda kuti atungamire mberi kwedu.\" Muranda akaita saizvozvo. \"Asi iwe chimbogara pano kwechinguva, kuti ndigokupa shoko rabva kuna Mwari.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.27",
            "verseOrgIds": [
              "1SA.9.27"
            ]
          }
        }
      ]
    }
  ],
