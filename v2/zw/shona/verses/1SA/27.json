  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
        "style": "c",
        "sid": "1SA 27"
      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dhavhidhi pakati pavaFiristia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Dhavhidhi akafunga mumwoyo make, akati, \"Rimwe ramazuva ano ndichaparadzwa noruoko rwaSauro. Chinhu chiri nani chandingaita ndechokutizira kunyika yavaFiristia. Ipapo Sauro acharega kunditsvaka muIsraeri yose, uye ndichapukunyuka muruoko rwake.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.1",
            "verseOrgIds": [
              "1SA.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Dhavhidhi akabva navarume mazana matanhatu vakanga vanaye akaenda kuna Akishi mwanakomana waMaoki mambo weGati.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.2",
            "verseOrgIds": [
              "1SA.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi navanhu vake vakandogara muGati naAkishi. Murume mumwe nomumwe akanga ane mhuri yake, uye Dhavhidhi akanga ana vakadzi vake vaviri vanoti: Ahinoami weJezireeri naAbhigairi weKarimeri, chirikadzi yaNabhari.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.3",
            "verseOrgIds": [
              "1SA.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauro akati anzwa kuti Dhavhidhi akanga atizira kuGati, haana kuzomutsvakazve.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.4",
            "verseOrgIds": [
              "1SA.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Dhavhidhi akati kuna Akishi, \"Kana ndawana nyasha pamberi penyu, regai ndipiwe hangu nzvimbo mune rimwe ramaguta omunyika kuti ndigareko. Muranda wenyu angagara seiko muguta ramambo nemi?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.5",
            "verseOrgIds": [
              "1SA.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka musi iwoyo, Akishi akamupa Zikiragi, uye rikava guta ramadzimambo eJudha kusvikira nhasi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.6",
            "verseOrgIds": [
              "1SA.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akagara munyika yavaFiristia kwegore nemwedzi mina.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.7",
            "verseOrgIds": [
              "1SA.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Dhavhidhi navanhu vake vakaenda vakandopamba vaGeshuri, vaGeziri, navaAmareki. (Kubva kare vanhu ava vakanga vachigara munyika yaisvika kuShuri neIjipiti.)",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.8",
            "verseOrgIds": [
              "1SA.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi aiti akarwisa nzvimbo, akanga asingasiyi murume kana mukadzi ari mupenyu, asi aitora makwai nemombe, mbongoro, nengamera, nenguo. Ipapo akadzokera kuna Akishi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.9",
            "verseOrgIds": [
              "1SA.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akishi aiti amubvunza kuti, \"Wanga waenda kundopamba kupiko nhasi?\" Dhavhidhi aiti, \"Kurutivi rweZasi kweJudha kana kuti kurutivi rweZasi kweJerameeri kana kuti kurutivi rweZasi kweKeni.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.10",
            "verseOrgIds": [
              "1SA.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haana kusiya murume kana mukadzi ari mupenyu kuti auye navo kuGati, nokuti akafunga mumwoyo make kuti, \"Vangazotirevera vachiti, 'Izvi ndizvo zvaitwa naDhavhidhi.' \" Uye aya ndiwo akanga ari maitiro ake pakugara kwake kwose munyika yavaFiristia.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.11",
            "verseOrgIds": [
              "1SA.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akishi akavimba naDhavhidhi akati mumwoyo make, \"Ava munhu anovengwa kwazvo navanhu vokwake, ivo vaIsraeri, zvokuti achava muranda wangu nokusingaperi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.12",
            "verseOrgIds": [
              "1SA.27.12"
            ]
          }
        }
      ]
    }
  ],
