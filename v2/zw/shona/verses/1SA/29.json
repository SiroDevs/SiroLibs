  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "29",
        "style": "c",
        "sid": "1SA 29"
      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akishi anodzosera Dhavhidhi kuZikiragi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaFiristia vakaunganidza varwi vavo paAfeki, uye vaIsraeri vakadzika musasa patsime raiva paJezireeri.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.1",
            "verseOrgIds": [
              "1SA.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vatongi vavaFiristia pavaifamba namapoka avo amazana mazana uye ezviuru zviuru, Dhavhidhi navanhu vake vaifamba vari mushure maAkishi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.2",
            "verseOrgIds": [
              "1SA.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakuru vehondo yavaFiristia vakabvunza vakati, \"Ko, vaHebheru ava vanodei?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.3",
            "verseOrgIds": [
              "1SA.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 29:3"
      },
      "items": [
        {
          "text": "Akishi akapindura akati, \"Ko, uyu haazi Dhavhidhi, akanga ari muchinda waSauro mambo weIsraeri here? Anga agere neni kwenguva inopfuura gore, uye kubva pazuva raakabva kuna Sauro kusvikira zvino, handina kuwana chakaipa maari.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.3",
            "verseOrgIds": [
              "1SA.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vakuru vehondo yavaFiristia vakamutsamwira vakati, \"Dzosai munhu uyu kwakare, kuti adzokere kunzvimbo yamakamurayira kuti agare. Haafaniri kuenda nesu kuhondo kuitira kuti arege kutipindukira tiri pakurwa. Zvingava nani kwaari kuti awane nyasha kuna tenzi wake ndezvipiko, hakusi kuti agure misoro yavanhu vedu here?",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.4",
            "verseOrgIds": [
              "1SA.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, uyu handiye Dhavhidhi wavakaimba pamusoro pake vachitamba vachiti:",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.5",
            "verseOrgIds": [
              "1SA.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1SA 29:5"
      },
      "items": [
        {
          "text": "\" 'Sauro akauraya zviuru zvake,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.5",
            "verseOrgIds": [
              "1SA.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 29:5"
      },
      "items": [
        {
          "text": "uye Dhavhidhi makumi ezviuru zvake'?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.5",
            "verseOrgIds": [
              "1SA.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Akishi akadana Dhavhidhi akati kwaari, \"Zvirokwazvo naJehovha mupenyu, iwe wanga wakavimbika, uye ini ndaifara kuti iwe ushande neni muhondo. Kubva pazuva rawakasvika kwandiri kusvikira iye zvino, handina kuwana chakaipa mauri, asi madzishe haabvumirani newe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.6",
            "verseOrgIds": [
              "1SA.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chidzoka hako kwakare norugare; urege kuita chinhu chisingafadzi madzishe avaFiristia.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.7",
            "verseOrgIds": [
              "1SA.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akamubvunza akati, \"Asi ndaiteiko hangu? Makawaneiko chakaipa kumuranda wenyu kubva pazuva randakasvika kwamuri kusvikira zvino? Ndinoregereiko kundorwa navavengi vashe wangu mambo?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.8",
            "verseOrgIds": [
              "1SA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akishi akati, \"Ndinoziva kuti wanga uchifadza pamberi pangu somutumwa waMwari; asi zvazvo, vakuru vehondo yavaFiristia vati, 'Iye haafaniri kuenda nesu kuhondo.'",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.9",
            "verseOrgIds": [
              "1SA.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino muka mangwanani-ngwanani, pamwe chete navaranda vatenzi wako avo vakauya newe, ugobva achiri mangwanani pakunotanga kuchena.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.10",
            "verseOrgIds": [
              "1SA.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Dhavhidhi navanhu vake vakamuka mangwanani-ngwanani kuti vadzokere kunyika yavaFiristia, uye vaFiristia vakakwidza kuJezireeri.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.11",
            "verseOrgIds": [
              "1SA.29.11"
            ]
          }
        }
      ]
    }
  ],
