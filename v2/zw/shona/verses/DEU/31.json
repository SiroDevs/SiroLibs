  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "31",
        "style": "c",
        "sid": "DEU 31"
      },
      "items": [
        {
          "text": "31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Joshua anotevera Mozisi pakutungamirira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Mozisi akaenda akandotaura mashoko aya kuvaIsraeri vose achiti:",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.1",
            "verseOrgIds": [
              "DEU.31.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zvino ndava namakore zana namakumi maviri uye handichagoni kukutungamirirai. Jehovha akati kwandiri, 'Iwe haufaniri kuyambuka Jorodhani urwu.'",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.2",
            "verseOrgIds": [
              "DEU.31.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha Mwari wenyu pachake ndiye achayambuka ari pamberi penyu. Achaparadza ndudzi idzi dzose pamberi penyu, mugotora nyika yavo. Joshua ndiye achayambuka ari pamberi penyu, sezvakataurwa naJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.3",
            "verseOrgIds": [
              "DEU.31.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Jehovha achavaitira ivo zvaakaitira Sihoni naOgi, madzimambo avaAmori, vaakaparadza pamwe chete nenyika yavo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.4",
            "verseOrgIds": [
              "DEU.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha achavaisa kwamuri, uye munofanira kuvaitira zvose zvandakakurayirai.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.5",
            "verseOrgIds": [
              "DEU.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simbai mutsunge mwoyo. Musatya kana kuvhundutswa nokuda kwavo, nokuti Jehovha Mwari wenyu achaenda nemi; haangakusiyei kana kukurasai.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.6",
            "verseOrgIds": [
              "DEU.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Mozisi akadana Joshua akati kwaari, pamberi pavaIsraeri vose, \"Simba utsunge mwoyo, nokuti unofanira kuenda navanhu ava munyika iyo Jehovha akapika kumadzitateguru avo kuti achavapa, uye unofanira kuigovera kwavari senhaka.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.7",
            "verseOrgIds": [
              "DEU.31.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha pachake achakutungamirira uye achava newe; haangakusiyi kana kukurasa. Usatya kana kuora mwoyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.8",
            "verseOrgIds": [
              "DEU.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuverengwa kwoMurayiro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Mozisi akanyora murayiro uyu akaupa kuvaprista, vanakomana vaRevhi, vaitakura areka yesungano yaJehovha, uye nokuvakuru vose veIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.9",
            "verseOrgIds": [
              "DEU.31.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Mozisi akavarayira, akati, \"Panopera makore manomwe nguva dzose, mugore rokukanganwira zvikwereti, panguva yoMutambo waMatumba,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.10",
            "verseOrgIds": [
              "DEU.31.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "vaIsraeri vose pavanouya kuzozviratidza pamberi paJehovha Mwari wenyu panzvimbo yaachasarudza, muchaverenga murayiro uyu pamberi pavo vachinzwa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.11",
            "verseOrgIds": [
              "DEU.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unganidzai vanhu, varume, vakadzi navana uye navatorwa vagere mumaguta enyu, kuti vanzwe uye vazive kutya Jehovha Mwari wenyu nokutevera zvakanaka mashoko ose omurayiro uyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.12",
            "verseOrgIds": [
              "DEU.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vana vavo, vasingazivi murayiro uyu, vanofanira kuunzwa uye vagodzidza kutya Jehovha Mwari wenyu panguva yose yamuchagara munyika yamuri kuyambuka Jorodhani kuti muitore.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.13",
            "verseOrgIds": [
              "DEU.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kumukira kwavaIsraeri kunoziviswa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kuna Mozisi, \"Zvino zuva rokufa kwako rava pedyo. Dana Joshua mugondomira muTende Rokusangana kuti ndimurayire.\" Saka Mozisi naJoshua vakauya vakazviratidza paTende Rokusangana.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.14",
            "verseOrgIds": [
              "DEU.31.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehovha akazviratidza paTende mushongwe yegore, uye gore rikamira pamusuo weTende.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.15",
            "verseOrgIds": [
              "DEU.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Jehovha akati kuna Mozisi, \"Uchavata namadzibaba ako, uye vanhu ava, zvino zvino, vachaita ufeve navamwari vavatorwa venyika yavari kupinda. Vachandirasa uye vachaputsa sungano yandakaita navo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.16",
            "verseOrgIds": [
              "DEU.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva iroro ndichavatsamwira ndigovarasa: ndichavanza chiso changu kubva kwavari, uye vachaparadzwa. Njodzi namatambudziko mazhinji zvichavawira uye pazuva iro vachabvunza vachiti, 'Ko, hatina kuwirwa nenjodzi idzi nokuti Mwari wedu haasi pakati pedu here?'",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.17",
            "verseOrgIds": [
              "DEU.31.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino ndichaviga chiso changu zvirokwazvo nezuva iro nokuda kwezvakaipa zvavo zvose zvokutsaukira kuna vamwe vamwari.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.18",
            "verseOrgIds": [
              "DEU.31.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 31:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zvino zvinyorerei rwiyo urwu mugorudzidzisa kuvaIsraeri uye mugovaita kuti varuimbe, kuitira kuti chigova chapupu kwandiri pamusoro pavo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.19",
            "verseOrgIds": [
              "DEU.31.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 31:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana ndichinge ndavauyisa munyika inoerera mukaka nouchi, nyika iyo yandakavimbisa nemhiko kumadzitateguru avo, uye kana vachinge vadya vaguta uye vakora, vachatsaukira kuna vamwe vamwari vagovanamata, vachindiramba uye vachiputsa sungano yangu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.20",
            "verseOrgIds": [
              "DEU.31.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 31:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino kana njodzi namatambudziko mazhinji zvavawira, rwiyo urwu ruchavapupurira pamusoro pavo, nokuti haruzombokanganwikwi nezvizvarwa zvavo. Ini ndinoziva zvavachazoita, kunyange ndisati ndavauyisa munyika yandakavavimbisa nemhiko.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.21",
            "verseOrgIds": [
              "DEU.31.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 31:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Mozisi akanyora rwiyo urwu nomusi uyu uye akarudzidzisa kuvaIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.22",
            "verseOrgIds": [
              "DEU.31.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 31:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akapa murayiro uyu kuna Joshua mwanakomana waNuni akati, \"Simba utsunge mwoyo, nokuti uchauyisa vaIsraeri munyika yandakavavimbisa nemhiko, uye ini pachangu ndichava newe.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.23",
            "verseOrgIds": [
              "DEU.31.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 31:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushure mokunge Mozisi apedza kunyora mubhuku mashoko omurayiro uyu kubva pokutanga kusvikira pokupedzisira,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.24",
            "verseOrgIds": [
              "DEU.31.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 31:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "akapa murayiro uyu kuvaRevhi vaitakura areka yesungano yaJehovha achiti,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.25",
            "verseOrgIds": [
              "DEU.31.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 31:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Torai Bhuku iri roMurayiro muriise parutivi peareka yesungano yaJehovha Mwari wenyu. Ipapo richagara sechapupu pamusoro penyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.26",
            "verseOrgIds": [
              "DEU.31.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 31:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti ndinoziva kuti vanomukira sei uye kuti mitsipa yavo mikukutu sei. Kana maimukira Jehovha ndichiri mupenyu uye ndiri pakati penyu, ko, kuzoti ndikange ndafa muchamumukira zvakadii!",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.27",
            "verseOrgIds": [
              "DEU.31.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 31:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiunganidzirei vakuru vose vamarudzi enyu namachinda enyu ose, kuti nditaure kwavari mashoko vachinzwa uye ndigodana denga nenyika zvivapupurire.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.28",
            "verseOrgIds": [
              "DEU.31.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 31:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti ndinoziva kuti mushure mokunge ndafa imi muchazvishatisa kwazvo uye muchatsauka kubva panzira yandakakurayirai. Pamazuva anouya, njodzi ichakuwirai nokuti muchaita zvakaipa pamberi paJehovha muchimutsamwisa nokuda kwezvakaitwa namaoko enyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.29",
            "verseOrgIds": [
              "DEU.31.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rwiyo rwaMozisi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
