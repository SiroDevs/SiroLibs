        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pasika",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rangarira mwedzi waAbhibhi upemberere Pasika yaJehovha Mwari wako, nokuti mumwedzi waAbhibhi akakubudisa kubva muIjipiti usiku.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.1",
            "verseOrgIds": [
              "DEU.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayira Jehovha Mwari wako chipfuwo kubva pamakwai ako kana kubva pamombe dzako sePasika panzvimbo iyo Jehovha achasarudza kuti Zita rake rigarepo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.2",
            "verseOrgIds": [
              "DEU.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usaidya nechingwa chine mbiriso, asi kwamazuva manomwe unofanira kudya chingwa chisina mbiriso, chingwa chokutambudzika, nokuti makabuda muIjipiti muchikurumidza, kuitira kuti murangarire nguva yamakabuda kubva muIjipiti.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.3",
            "verseOrgIds": [
              "DEU.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamazuva manomwe aya ngapasawanikwa mbiriso panyika yenyu yose. Musarega nyama yamunobayira usiku hwezuva rokutanga ichisara kusvikira mangwanani.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.4",
            "verseOrgIds": [
              "DEU.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamufaniri kubayira Pasika mune ripi zvaro ramaguta amunopiwa naJehovha Mwari wenyu,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.5",
            "verseOrgIds": [
              "DEU.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunze kwenzvimbo yaachasarudza kuti Zita rake rigarepo. Ipapo ndipo pamunofanira kubayira Pasika madekwana, kana zuva ravira, nezuva rokurangarira kwamakaita kubva muIjipiti.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.6",
            "verseOrgIds": [
              "DEU.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igochei mugoidyira panzvimbo yamuchasarudzirwa naJehovha Mwari wenyu kuti Zita rake rigarepo. Zvino kana ava mangwanani mudzokere kumatende enyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.7",
            "verseOrgIds": [
              "DEU.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwamazuva matanhatu mudye chingwa chisina mbiriso uye pazuva rechinomwe munofanira kuita ungano kuna Jehovha Mwari wenyu uye murege kushanda.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.8",
            "verseOrgIds": [
              "DEU.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mutambo waMavhiki",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Verengai mavhiki manomwe kubva panguva yamunotanga kucheka gorosi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.9",
            "verseOrgIds": [
              "DEU.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo upemberere Jehovha Mwari wako Mutambo waMavhiki nokupa chipo chokuda kwako maererano nokuropafadzwa kwawakaitwa naJehovha Mwari wako.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.10",
            "verseOrgIds": [
              "DEU.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye ufare pamberi paJehovha Mwari wako panzvimbo yaachasarudza kuti Zita rake rigarepo, iwe, navanakomana vako navanasikana vako, varandarume vako navarandakadzi vako, navaRevhi vari mumaguta ako, uye navatorwa, nenherera nechirikadzi dzigere pakati penyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.11",
            "verseOrgIds": [
              "DEU.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rangarirai kuti maiva varanda muIjipiti, uye muchenjerere kuchengeta mirayiro iyi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.12",
            "verseOrgIds": [
              "DEU.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mutambo waMatumba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Upemberere Mutambo waMatumba mazuva manomwe mushure mokunge wapedza kuunganidza zvawawana paburiro rako napachisviniro chako.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.13",
            "verseOrgIds": [
              "DEU.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ufare kwazvo paMutambo wako, iwe, navanakomana vako navanasikana vako, varandarume vako navarandakadzi vako, navaRevhi vari mumaguta ako, uye navatorwa, nenherera nechirikadzi dzigere mumaguta enyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.14",
            "verseOrgIds": [
              "DEU.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwamazuva manomwe upemberere Mutambo kuna Jehovha Mwari wako panzvimbo ichasarudzwa naJehovha, nokuti Jehovha Mwari wako achakuropafadza mukukohwa kwako kwose nomubasa rako rose ramaoko ako, uye mufaro wako uchazadziswa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.15",
            "verseOrgIds": [
              "DEU.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katatu pagore varume vose pakati penyu vanofanira kuuya pamberi paJehovha Mwari wenyu panzvimbo iyo achasarudza: panguva yoMutambo weChingwa Chisina Mbiriso, noMutambo waMavhiki uye noMutambo waMatumba. Hapana munhu anofanira kuuya asina chaakabata pamberi paJehovha:",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.16",
            "verseOrgIds": [
              "DEU.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwe nomumwe wenyu anofanira kuuya nechipo chakaenzanirana nokuropafadzwa kwaakaitwa naJehovha Mwari wenyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.17",
            "verseOrgIds": [
              "DEU.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vatongi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gadzai vatongi navakuru kurudzi rumwe norumwe rwenyu muguta rimwe nerimwe ramuri kupiwa naJehovha Mwari wenyu, uye vagotonga vanhu nokutonga kwakanaka.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.18",
            "verseOrgIds": [
              "DEU.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musatsauka pakururamisira uye musaita rusarura. Musagamuchira fufuro, nokuti fufuro rinopofumadza meso owakachenjera uye rinominamisa mashoko avakarurama.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.19",
            "verseOrgIds": [
              "DEU.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Teverai kururamisira uye kururamisira chete, kuitira kuti mugorarama uye mugotora nyika yamuri kupiwa naJehovha Mwari wenyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.20",
            "verseOrgIds": [
              "DEU.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kunamata vamwe vamwari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musazvimisira matanda api zvawo aAshera parutivi pearitari yamunovakira Jehovha Mwari wenyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.21",
            "verseOrgIds": [
              "DEU.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye musamisa dombo rinoera, nokuti izvi Jehovha Mwari wenyu anozvivenga.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.22",
            "verseOrgIds": [
              "DEU.16.22"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "DEU.17",
    "number": "17",
