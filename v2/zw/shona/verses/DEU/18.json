  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "DEU 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zvipiriso zvaVaprista navaRevhi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaprista vanova vaRevhi, zvirokwazvo rudzi rwose rwaRevhi, havafaniri kuva nomugove kana nhaka pamwe chete neIsraeri. Vachararama nezvipiriso zvinopiswa zvaJehovha, nokuti ndiyo nhaka yavo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.1",
            "verseOrgIds": [
              "DEU.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Havazovi nenhaka pakati pehama dzavo: Jehovha ndiye nhaka yavo sezvaakavavimbisa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.2",
            "verseOrgIds": [
              "DEU.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyu ndiwo mugove wakafanira vaprista kubva kuvanhu vanobayira nzombe kana gwai: bandauko neshaya dzacho uye nezvemukati.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.3",
            "verseOrgIds": [
              "DEU.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munofanira kuvapa zvibereko zvokutanga zvezviyo, waini itsva namafuta, uye namakushe okutanga amakwai ako,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.4",
            "verseOrgIds": [
              "DEU.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti Jehovha Mwari wenyu akavasarudza ivo nezvizvarwa zvavo, kubva pakati pamarudzi ose kuti vamire vachishumira muzita raJehovha nguva dzose.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.5",
            "verseOrgIds": [
              "DEU.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana muRevhi akabva mune rimwe ramaguta enyu, kupi zvako muIsraeri kwaanenge achigara, uye akauya nomwoyo wake wose kunzvimbo ichasarudzwa naJehovha,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.6",
            "verseOrgIds": [
              "DEU.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "anogona hake kushumira muzita raJehovha Mwari wake savamwe vake vose vaRevhi vanoshumira ipapo pamberi paJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.7",
            "verseOrgIds": [
              "DEU.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anofanira kuwana mugove wakaenzana newavo, kunyange zvake akawana mari paakatengesa nhaka yemhuri yake.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.8",
            "verseOrgIds": [
              "DEU.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tsika dzinonyangadza",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana muchinge mapinda munyika yamuri kupiwa naJehovha Mwari wenyu, musadzidzira kutevedzera nzira dzinonyangadza dzendudzi dzirimo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.9",
            "verseOrgIds": [
              "DEU.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngapasava nomumwe pakati penyu anoita mwanakomana wake kana mwanasikana wake chibayiro chinopiswa, kana anovuka kana anoita zvamazango kana anotenda zvamashura, kana kuita zvouroyi,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.10",
            "verseOrgIds": [
              "DEU.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kana anoita zvounʼanga, kana anotenda zvamasvikiro kana anobvunza vakafa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.11",
            "verseOrgIds": [
              "DEU.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani naani anoita zvinhu izvi anonyangadza pamberi paJehovha, uye nokuda kwetsika idzi dzinonyangadza Jehovha Mwari wenyu achadzinga ndudzi idzi pamberi penyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.12",
            "verseOrgIds": [
              "DEU.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unofanira kuva wakarurama pamberi paJehovha Mwari wako.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.13",
            "verseOrgIds": [
              "DEU.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Muprofita",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndudzi dzamunotorera nyika dzinoteerera kuna avo vanoita zvamazango kana kuvuka. Asi kana muri imi Jehovha Mwari wenyu haana kukutenderai kuti muite izvozvo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.14",
            "verseOrgIds": [
              "DEU.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha Mwari wenyu achakumutsirai muprofita akaita seni kubva pakati pehama dzenyu. Munofanira kumuteerera.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.15",
            "verseOrgIds": [
              "DEU.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti izvi ndizvo zvamakakumbira Jehovha Mwari wenyu paHorebhi pazuva reungano apo makati, \"Hatidi kunzwa inzwi raJehovha Mwari wedu kana kuona moto mukuru uyu zvakare, nokuti tingafa.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.16",
            "verseOrgIds": [
              "DEU.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kwandiri, \"Zvavataura zvakanaka.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.17",
            "verseOrgIds": [
              "DEU.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichavamutsira muprofita anobva pakati pehama dzavo akaita sewe; ndichaisa mashoko angu mumuromo wake, uye achavaudza zvose zvandichamurayira.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.18",
            "verseOrgIds": [
              "DEU.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana pane munhu acharega kuteerera mashoko angu anotaurwa nomuprofita muzita rangu, ini pachangu ndichamubvunza pamusoro pazvo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.19",
            "verseOrgIds": [
              "DEU.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi muprofita achataura muzita rangu mashoko api zvawo andisina kumurayira kuti ataure, kana muprofita anotaura muzita ravamwe vamwari, anofanira kuurayiwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.20",
            "verseOrgIds": [
              "DEU.18.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungati zvako mumwoyo mako, \"Tingaziva seiko kuti shoko iri rataurwa naJehovha?\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.21",
            "verseOrgIds": [
              "DEU.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana zvakataurwa nomuprofita muzita raJehovha zvikasaitika kana zvikasava chokwadi, shoko iroro harina kutaurwa naJehovha. Muprofita iyeye ataura zvomusoro wake. Musamutya.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.22",
            "verseOrgIds": [
              "DEU.18.22"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "DEU.19",
