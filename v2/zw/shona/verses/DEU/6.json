  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "DEU 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ida Jehovha Mwari wako",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyi ndiyo mitemo, nemirayiro zvandakarayirwa naJehovha Mwari wenyu kuti ndikudzidzisei kuti muzviite munyika yamunoyambukira Jorodhani kuti ive yenyu,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.1",
            "verseOrgIds": [
              "DEU.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuitira kuti iwe, navana vako navana vavo vachavatevera mutye Jehovha Mwari wenyu pakurarama kwenyu nokuchengeta mitemo nemirayiro yake yose yandinokupai, uye kuitira kuti muve namazuva mazhinji okurarama.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.2",
            "verseOrgIds": [
              "DEU.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinzwa, iwe Israeri, uchenjere kuti uzviite kuitira kuti zvikunakire uye kuti muwande kwazvo munyika inoyerera mukaka nouchi, sezvamakavimbiswa naJehovha, iye Mwari wamadzibaba enyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.3",
            "verseOrgIds": [
              "DEU.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinzwa iwe Israeri: Jehovha Mwari wedu, ndiJehovha mumwe chete.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.4",
            "verseOrgIds": [
              "DEU.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ida Jehovha Mwari wako nomwoyo wako wose nomweya wako wose uye nesimba rako rose.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.5",
            "verseOrgIds": [
              "DEU.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mirayiro iyi yandinokupai nhasi inofanira kuva mumwoyo yenyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.6",
            "verseOrgIds": [
              "DEU.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvisimbisei kuvana venyu. Taurai pamusoro payo kana mugere mudzimba dzenyu uye kana muchifamba munzira, kana muchivata pasi uye kana muchimuka.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.7",
            "verseOrgIds": [
              "DEU.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isungirirei pamaoko enyu sechiratidzo mugoisungira pahuma dzenyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.8",
            "verseOrgIds": [
              "DEU.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muinyore pamagwatidziro emikova yedzimba dzenyu uye napamasuo enyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.9",
            "verseOrgIds": [
              "DEU.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino kana Jehovha Mwari wenyu achinge akupinzai munyika yaakapikira kumadzibaba enyu, Abhurahama, naIsaka, naJakobho, kuti achakupai, nyika ina maguta makuru akanaka, amusina kuvaka imi,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.10",
            "verseOrgIds": [
              "DEU.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "dzimba dzizere nezvinhu zvakanaka zvamarudzi ose zvamusina kutsvaka imi, matsime amusina kuchera, minda yemizambiringa namasango nemiti yemiorivhi yamusina kusima, zvino kana muchinge madya uye mukaguta,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.11",
            "verseOrgIds": [
              "DEU.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "muchenjerere kuti murege kukanganwa Jehovha, akakubudisai kubva muIjipiti, kubva munyika youranda.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.12",
            "verseOrgIds": [
              "DEU.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itya Jehovha Mwari wako, ushumire iye oga ugoita mhiko dzako muzita rake.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.13",
            "verseOrgIds": [
              "DEU.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musatevera vamwe vamwari, vamwari vendudzi dzakakupoteredzai;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.14",
            "verseOrgIds": [
              "DEU.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti Jehovha Mwari wenyu ari pakati penyu ndiMwari ane godo uye hasha dzake dzichapisa pamusoro penyu, uye achakuparadzai kubva pamusoro penyika.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.15",
            "verseOrgIds": [
              "DEU.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musaedza Jehovha Mwari wenyu sezvamakaita paMasa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.16",
            "verseOrgIds": [
              "DEU.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chenjererai kuchengeta mirayiro yaJehovha Mwari wenyu nezvaakatema nemitemo yaakakupai.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.17",
            "verseOrgIds": [
              "DEU.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itai zvakarurama nezvakanaka pamberi paJehovha, kuitira kuti zvigokunakirai, mugopinda mugotora nyika yakanaka iyo Jehovha akavimbisa nemhiko kumadzitateguru enyu,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.18",
            "verseOrgIds": [
              "DEU.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "agoparadza vavengi venyu vose pamberi penyu, sezvakataurwa naJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.19",
            "verseOrgIds": [
              "DEU.6.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva inotevera, kana mwanakomana wako akakubvunza achiti, \"Ko, zvakatemwa izvi, mitemo nemirayiro yamakarayirwa naJehovha Mwari wedu zvinorevei?\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.20",
            "verseOrgIds": [
              "DEU.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuudze kuti, \"Takanga tiri varanda vaFaro muIjipiti, asi Jehovha akatibudisa muIjipiti noruoko rune simba.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.21",
            "verseOrgIds": [
              "DEU.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akatumira pamberi pedu zviratidzo nezvishamiso zvinotyisa pamusoro peIjipiti naFaro neimba yake yose.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.22",
            "verseOrgIds": [
              "DEU.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi akatibudisamo kuti atipinze nokutipa nyika yaakavimbisa nemhiko kumadzibaba edu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.23",
            "verseOrgIds": [
              "DEU.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akatirayira kuti titeerere mitemo iyi yose nokutya Jehovha Mwari wedu, kuitira kuti tibudirire nguva dzose nokurarama sezvatakaita nhasi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.24",
            "verseOrgIds": [
              "DEU.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye kana tichichenjerera kuteerera murayiro uyu wose pamberi paJehovha Mwari wedu, sezvaakatirayira, ndiko kuchava kururama kwedu.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.25",
            "verseOrgIds": [
              "DEU.6.25"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "DEU.7",
    "number": "7",
