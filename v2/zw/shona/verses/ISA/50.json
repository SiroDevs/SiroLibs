  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "50",
        "style": "c",
        "sid": "ISA 50"
      },
      "items": [
        {
          "text": "50",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chivi chaIsraeri noKuteerera kwoMuranda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 50:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvanzi naJehovha:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.1",
            "verseOrgIds": [
              "ISA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:1"
      },
      "items": [
        {
          "text": "\"Ko, rugwaro rwokurambwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.1",
            "verseOrgIds": [
              "ISA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:1"
      },
      "items": [
        {
          "text": "kwamai venyu rwuripiko rwandakavadzinga narwo?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.1",
            "verseOrgIds": [
              "ISA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:1"
      },
      "items": [
        {
          "text": "Uye ndevapiko vandakakwereta",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.1",
            "verseOrgIds": [
              "ISA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:1"
      },
      "items": [
        {
          "text": "ndikazokutengesai kwavari?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.1",
            "verseOrgIds": [
              "ISA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:1"
      },
      "items": [
        {
          "text": "Makatengeswa nokuda kwezvivi zvenyu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.1",
            "verseOrgIds": [
              "ISA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:1"
      },
      "items": [
        {
          "text": "mai venyu vakadzingwa nokuda kwokudarika kwenyu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.1",
            "verseOrgIds": [
              "ISA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 50:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sei ndakashaya munhu, pandakauya?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.2",
            "verseOrgIds": [
              "ISA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:2"
      },
      "items": [
        {
          "text": "Sei pasina akapindura pandakadana?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.2",
            "verseOrgIds": [
              "ISA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:2"
      },
      "items": [
        {
          "text": "Ko, ruoko rwangu rwakanga rwakapfupika here kuti ndikudzikinurei?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.2",
            "verseOrgIds": [
              "ISA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:2"
      },
      "items": [
        {
          "text": "Handina simba rokukununurai here?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.2",
            "verseOrgIds": [
              "ISA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:2"
      },
      "items": [
        {
          "text": "Nokungorayira chete ndinopwisa gungwa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.2",
            "verseOrgIds": [
              "ISA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:2"
      },
      "items": [
        {
          "text": "ndinoshandura nzizi dzikava gwenga;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.2",
            "verseOrgIds": [
              "ISA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:2"
      },
      "items": [
        {
          "text": "hove dzadzo dzinoora nokushayiwa mvura,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.2",
            "verseOrgIds": [
              "ISA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:2"
      },
      "items": [
        {
          "text": "uye dzinofa nenyota.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.2",
            "verseOrgIds": [
              "ISA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 50:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinoshongedza denga nerima",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.3",
            "verseOrgIds": [
              "ISA.50.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:3"
      },
      "items": [
        {
          "text": "uye ndinoita masaga chifukidzo charo.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.3",
            "verseOrgIds": [
              "ISA.50.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 50:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishe Jehovha akandipa rurimi rwakadzidziswa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.4",
            "verseOrgIds": [
              "ISA.50.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:4"
      },
      "items": [
        {
          "text": "kuziva shoko rinosimbisa vakarukutika.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.4",
            "verseOrgIds": [
              "ISA.50.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:4"
      },
      "items": [
        {
          "text": "Anondimutsa mangwanani namangwanani,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.4",
            "verseOrgIds": [
              "ISA.50.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:4"
      },
      "items": [
        {
          "text": "anomutsa nzeve yangu kuti iteerere somunhu anodzidziswa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.4",
            "verseOrgIds": [
              "ISA.50.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 50:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishe Jehovha akazarura nzeve dzangu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.5",
            "verseOrgIds": [
              "ISA.50.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:5"
      },
      "items": [
        {
          "text": "uye handina kumumukira;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.5",
            "verseOrgIds": [
              "ISA.50.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:5"
      },
      "items": [
        {
          "text": "handina kudzokera shure.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.5",
            "verseOrgIds": [
              "ISA.50.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 50:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakapa musana wangu kuna avo vaindirova,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.6",
            "verseOrgIds": [
              "ISA.50.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:6"
      },
      "items": [
        {
          "text": "namatama angu kuna avo vakadzura ndebvu dzangu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.6",
            "verseOrgIds": [
              "ISA.50.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:6"
      },
      "items": [
        {
          "text": "Handina kuvanza chiso changu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.6",
            "verseOrgIds": [
              "ISA.50.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:6"
      },
      "items": [
        {
          "text": "pakusekwa nokupfirwa mate.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.6",
            "verseOrgIds": [
              "ISA.50.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 50:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti Ishe Jehovha anondibatsira,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.7",
            "verseOrgIds": [
              "ISA.50.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:7"
      },
      "items": [
        {
          "text": "handizonyadziswi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.7",
            "verseOrgIds": [
              "ISA.50.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:7"
      },
      "items": [
        {
          "text": "Naizvozvo ndakaita kuti chiso changu chive sebwe romusarasara,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.7",
            "verseOrgIds": [
              "ISA.50.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:7"
      },
      "items": [
        {
          "text": "uye ndinoziva kuti handizonyadziswi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.7",
            "verseOrgIds": [
              "ISA.50.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 50:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anondiruramisira ari pedyo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.8",
            "verseOrgIds": [
              "ISA.50.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:8"
      },
      "items": [
        {
          "text": "Ndianiko zvino achandipa mhosva?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.8",
            "verseOrgIds": [
              "ISA.50.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:8"
      },
      "items": [
        {
          "text": "Ngatitarisanei!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.8",
            "verseOrgIds": [
              "ISA.50.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:8"
      },
      "items": [
        {
          "text": "Ndianiko mupomeri wangu?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.8",
            "verseOrgIds": [
              "ISA.50.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:8"
      },
      "items": [
        {
          "text": "Ngaanangane neni!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.8",
            "verseOrgIds": [
              "ISA.50.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 50:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiye Ishe Jehovha anondibatsira.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.9",
            "verseOrgIds": [
              "ISA.50.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:9"
      },
      "items": [
        {
          "text": "Ndianiko achandipa mhosva?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.9",
            "verseOrgIds": [
              "ISA.50.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:9"
      },
      "items": [
        {
          "text": "Vose vachasakara senguo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.9",
            "verseOrgIds": [
              "ISA.50.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:9"
      },
      "items": [
        {
          "text": "vachadyiwa nezvipfuno.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.9",
            "verseOrgIds": [
              "ISA.50.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 50:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiani pakati penyu anotya Jehovha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.10",
            "verseOrgIds": [
              "ISA.50.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:10"
      },
      "items": [
        {
          "text": "uye anoteerera shoko romuranda wake?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.10",
            "verseOrgIds": [
              "ISA.50.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:10"
      },
      "items": [
        {
          "text": "Ngaafambe murima,",
