      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:15"
      },
      "items": [
        {
          "text": "pasina munhu anopfuura nemauri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.15",
            "verseOrgIds": [
              "ISA.60.15"
            ]
          }
        }
      ]
