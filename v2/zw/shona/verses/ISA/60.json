      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:16"
      },
      "items": [
        {
          "text": "Ipapo uchaziva kuti ini, iyeni Jehovha, ndini Muponesi wako,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.16",
            "verseOrgIds": [
              "ISA.60.16"
            ]
          }
        }
      ]
