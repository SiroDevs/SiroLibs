      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:13"
      },
      "items": [
        {
          "text": "uye ndichabwinyisa nzvimbo yetsoka dzangu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.13",
            "verseOrgIds": [
              "ISA.60.13"
            ]
          }
        }
      ]
    },
