      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:13"
      },
      "items": [
        {
          "text": "mipaini nemifiri nemisipuresi pamwe chete,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.13",
            "verseOrgIds": [
              "ISA.60.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:13"
      },
      "items": [
        {
          "text": "kuzoshongedza nzvimbo yetemberi yangu tsvene;",
