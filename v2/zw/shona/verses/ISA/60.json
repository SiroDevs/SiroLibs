      },
      "items": [
        {
          "text": "60",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kubwinya kweZioni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 60:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Simuka, upenye nokuti chiedza chako chasvika,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.1",
            "verseOrgIds": [
              "ISA.60.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:1"
      },
      "items": [
        {
          "text": "uye kubwinya kwaJehovha kwabuda pamusoro pako.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.1",
            "verseOrgIds": [
              "ISA.60.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 60:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tarira, rima rakafukidza nyika",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.2",
            "verseOrgIds": [
              "ISA.60.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:2"
      },
      "items": [
        {
          "text": "uye rima guru riri pamusoro pavanhu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.2",
            "verseOrgIds": [
              "ISA.60.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:2"
      },
      "items": [
        {
          "text": "asi Jehovha anobuda pamusoro pako",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.2",
            "verseOrgIds": [
              "ISA.60.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:2"
      },
      "items": [
        {
          "text": "uye kubwinya kwake kunoratidzwa pamusoro pako.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.2",
            "verseOrgIds": [
              "ISA.60.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 60:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndudzi dzichauya kuchiedza chako,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.3",
            "verseOrgIds": [
              "ISA.60.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:3"
      },
      "items": [
        {
          "text": "uye madzimambo kukubwinya kwamambakwedza ako.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.3",
            "verseOrgIds": [
              "ISA.60.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 60:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Simudza meso ako utarise zvakakukomberedza:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.4",
            "verseOrgIds": [
              "ISA.60.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:4"
      },
      "items": [
        {
          "text": "vose vanoungana uye vanouya kwauri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.4",
            "verseOrgIds": [
              "ISA.60.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:4"
      },
      "items": [
        {
          "text": "vanakomana vako vanobva kure,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.4",
            "verseOrgIds": [
              "ISA.60.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:4"
      },
      "items": [
        {
          "text": "uye vanasikana vako vanotakurwa pamaoko.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.4",
            "verseOrgIds": [
              "ISA.60.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 60:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo uchatarisa ugopenya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.5",
            "verseOrgIds": [
              "ISA.60.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:5"
      },
      "items": [
        {
          "text": "mwoyo wako uchakwata uye uchazara nomufaro;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.5",
            "verseOrgIds": [
              "ISA.60.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:5"
      },
      "items": [
        {
          "text": "upfumi huri pamusoro pamakungwa huchauyiswa kwauri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.5",
            "verseOrgIds": [
              "ISA.60.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:5"
      },
      "items": [
        {
          "text": "pfuma yendudzi ichauya kwauri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.5",
            "verseOrgIds": [
              "ISA.60.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 60:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mapoka engamera achazadza nyika yako,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.6",
            "verseOrgIds": [
              "ISA.60.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:6"
      },
      "items": [
        {
          "text": "mhuru dzengamera dzeMidhiani neEfa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.6",
            "verseOrgIds": [
              "ISA.60.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:6"
      },
      "items": [
        {
          "text": "Uye vose vanobva kuShebha vachauya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.6",
            "verseOrgIds": [
              "ISA.60.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:6"
      },
      "items": [
        {
          "text": "vakatakura goridhe nezvinonhuhwira",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.6",
            "verseOrgIds": [
              "ISA.60.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:6"
      },
      "items": [
        {
          "text": "vachiparidza kurumbidzwa kwaJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.6",
            "verseOrgIds": [
              "ISA.60.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 60:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mapoka eKedhari achaunganidzirwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.7",
            "verseOrgIds": [
              "ISA.60.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:7"
      },
      "items": [
        {
          "text": "kwauri makondobwe eNebhayoti achakushumira:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.7",
            "verseOrgIds": [
              "ISA.60.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:7"
      },
      "items": [
        {
          "text": "achagamuchirwa sezvipo paaritari yangu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.7",
            "verseOrgIds": [
              "ISA.60.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:7"
      },
      "items": [
        {
          "text": "uye ndichashongedza temberi yangu yokukudzwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.7",
            "verseOrgIds": [
              "ISA.60.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 60:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndivanaani ava vanobhururuka samakore,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.8",
            "verseOrgIds": [
              "ISA.60.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:8"
      },
      "items": [
        {
          "text": "senjiva dzinoenda kumatendere adzo?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.8",
            "verseOrgIds": [
              "ISA.60.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 60:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvirokwazvo zviwi zvinotarira kwandiri;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.9",
            "verseOrgIds": [
              "ISA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:9"
      },
      "items": [
        {
          "text": "zvikepe zveTashishi zvinotungamira",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.9",
            "verseOrgIds": [
              "ISA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:9"
      },
      "items": [
        {
          "text": "zvichiuya navanakomana venyu vari kubva kure,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.9",
            "verseOrgIds": [
              "ISA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:9"
      },
      "items": [
        {
          "text": "nesirivha yavo negoridhe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.9",
            "verseOrgIds": [
              "ISA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:9"
      },
      "items": [
        {
          "text": "kuzokudza Jehovha Mwari wako,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.9",
            "verseOrgIds": [
              "ISA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:9"
      },
      "items": [
        {
          "text": "iye Mutsvene waIsraeri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.9",
            "verseOrgIds": [
              "ISA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:9"
      },
      "items": [
        {
          "text": "nokuti akakushongedza nokubwinya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.9",
            "verseOrgIds": [
              "ISA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 60:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Vatorwa vachavakazve masvingo ako,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.10",
            "verseOrgIds": [
              "ISA.60.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:10"
      },
      "items": [
        {
          "text": "uye madzimambo avo achakushandira.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.10",
            "verseOrgIds": [
              "ISA.60.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:10"
      },
      "items": [
        {
          "text": "Kunyange ndakakurova mukutsamwa kwangu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.10",
            "verseOrgIds": [
              "ISA.60.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:10"
      },
      "items": [
        {
          "text": "munyasha dzangu ndichakunzwira tsitsi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.10",
            "verseOrgIds": [
              "ISA.60.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 60:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masuo ako achagara akashama",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.11",
            "verseOrgIds": [
              "ISA.60.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:11"
      },
      "items": [
        {
          "text": "haachazombozarirwi, masikati kana usiku",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.11",
            "verseOrgIds": [
              "ISA.60.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:11"
      },
      "items": [
        {
          "text": "kuitira kuti vanhu vakuvigire upfumi hwendudzi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.11",
            "verseOrgIds": [
              "ISA.60.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:11"
      },
      "items": [
        {
          "text": "madzimambo adzo achafambiswa ari mumudungwe akundwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.11",
            "verseOrgIds": [
              "ISA.60.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
