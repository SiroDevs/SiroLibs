      "attrs": {
        "style": "q2",
        "vid": "ISA 8:17"
      },
      "items": [
        {
          "text": "iye ari kuvanzira imba yaJakobho chiso chake.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.17",
            "verseOrgIds": [
              "ISA.8.17"
            ]
