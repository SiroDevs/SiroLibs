  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "ISA 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Asiria, Shamhu yaJehovha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kwandiri, \"Tora bhuku guru unyore pamusoro paro nechinyoreso: pamusoro paMaheri-Sharari-Hashi-Bhazi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.1",
            "verseOrgIds": [
              "ISA.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichadana Uriya muprista naZekaria mwanakomana waJebherekia sezvapupu zvakatendeka kwandiri.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.2",
            "verseOrgIds": [
              "ISA.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ndakaenda kumuprofitakadzi, akatora pamuviri akabereka mwanakomana. Zvino Jehovha akati kwandiri, \"Mutumidze kuti Maheri-Sharari-Hashi-Bhazi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.3",
            "verseOrgIds": [
              "ISA.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti mwana asati aziva kuti, 'Baba vangu' kana kuti, 'Mai vangu,' pfuma yeDhamasiko nezvakapambwa zveSamaria zvichatakurwa namambo weAsiria.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.4",
            "verseOrgIds": [
              "ISA.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akataurazve kwandiri akati,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.5",
            "verseOrgIds": [
              "ISA.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nokuti vanhu ava vakaramba",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.6",
            "verseOrgIds": [
              "ISA.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:6"
      },
      "items": [
        {
          "text": "mvura inoyerera zvinyoronyoro yeShiroa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.6",
            "verseOrgIds": [
              "ISA.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 8:6"
      },
      "items": [
        {
          "text": "uye vanofarira Rezini",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.6",
            "verseOrgIds": [
              "ISA.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:6"
      },
      "items": [
        {
          "text": "nomwanakomana waRemaria,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.6",
            "verseOrgIds": [
              "ISA.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "naizvozvo Jehovha ava kuda kuuyisa pamusoro pavo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.7",
            "verseOrgIds": [
              "ISA.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:7"
      },
      "items": [
        {
          "text": "mafashamu makuru oRwizi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.7",
            "verseOrgIds": [
              "ISA.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:7"
      },
      "items": [
        {
          "text": "mambo weAsiria nokukudzwa kwake kwose.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.7",
            "verseOrgIds": [
              "ISA.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 8:7"
      },
      "items": [
        {
          "text": "Ruchapfachukira hova dzarwo dzose,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.7",
            "verseOrgIds": [
              "ISA.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:7"
      },
      "items": [
        {
          "text": "uye rugopfachukira kumahombekombe arwo ose,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.7",
            "verseOrgIds": [
              "ISA.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ruchakukura kusvikira kuJudha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.8",
            "verseOrgIds": [
              "ISA.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:8"
      },
      "items": [
        {
          "text": "ruchipafuma nomukati mayo, rugopfuura nomairi ruchisvika muhuro.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.8",
            "verseOrgIds": [
              "ISA.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 8:8"
      },
      "items": [
        {
          "text": "Kutandavara kwamapapiro arwo kuchafukidza upamhi hwenyika yako,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.8",
            "verseOrgIds": [
              "ISA.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:8"
      },
      "items": [
        {
          "text": "iwe Imanueri!\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.8",
            "verseOrgIds": [
              "ISA.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ridzai mhere yehondo, imi ndudzi, mugoputswa-putswa!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.9",
            "verseOrgIds": [
              "ISA.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:9"
      },
      "items": [
        {
          "text": "Teererai, imi nyika dzose dziri kure.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.9",
            "verseOrgIds": [
              "ISA.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 8:9"
      },
      "items": [
        {
          "text": "Gadzirirai kurwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.9",
            "verseOrgIds": [
              "ISA.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:9"
      },
      "items": [
        {
          "text": "mugoputswa-putswa!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.9",
            "verseOrgIds": [
              "ISA.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gadzirirai urongwa hwenyu, asi huchakona;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.10",
            "verseOrgIds": [
              "ISA.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:10"
      },
      "items": [
        {
          "text": "Taurai zvourongwa hwenyu, asi hauzomiri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.10",
            "verseOrgIds": [
              "ISA.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 8:10"
      },
      "items": [
        {
          "text": "nokuti Mwari anesu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.10",
            "verseOrgIds": [
              "ISA.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ityai Mwari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akataura kwandiri ruoko rwake rune simba rwuri pamusoro pangu, achindiyambira kuti ndirege kutevera nzira yavanhu ava, akati:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.11",
            "verseOrgIds": [
              "ISA.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Musati irangano zvinhu zvose",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.12",
            "verseOrgIds": [
              "ISA.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:12"
      },
      "items": [
        {
          "text": "zvinonzi navanhu ava irangano;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.12",
            "verseOrgIds": [
              "ISA.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 8:12"
      },
      "items": [
        {
          "text": "musatya zvavanotya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.12",
            "verseOrgIds": [
              "ISA.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:12"
      },
      "items": [
        {
          "text": "musazvivhunduka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.12",
            "verseOrgIds": [
              "ISA.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha Wamasimba Ose ndiye wamunofanira kuita mutsvene,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.13",
            "verseOrgIds": [
              "ISA.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:13"
      },
      "items": [
        {
          "text": "ndiye wamunofanira kuvhunduka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.13",
            "verseOrgIds": [
              "ISA.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndiye achava nzvimbo tsvene;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.14",
            "verseOrgIds": [
              "ISA.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:14"
      },
      "items": [
        {
          "text": "asi padzimba dzose dzaIsraeri",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.14",
            "verseOrgIds": [
              "ISA.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 8:14"
      },
      "items": [
        {
          "text": "achava dombo rinoita kuti vanhu vagumburwe;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.14",
            "verseOrgIds": [
              "ISA.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:14"
      },
      "items": [
        {
          "text": "nedombo rinoita kuti vapunzike.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.14",
            "verseOrgIds": [
              "ISA.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 8:14"
      },
      "items": [
        {
          "text": "Uye kuvanhu veJerusarema",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.14",
            "verseOrgIds": [
              "ISA.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:14"
      },
      "items": [
        {
          "text": "iye achava musungo norugombe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.14",
            "verseOrgIds": [
              "ISA.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vazhinji vavo vachagumburwa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.15",
            "verseOrgIds": [
              "ISA.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:15"
      },
      "items": [
        {
          "text": "vachawa vagovhunika,",
          "type": "text",
          "attrs": {
