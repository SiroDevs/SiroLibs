  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "64",
        "style": "c",
        "sid": "ISA 64"
      },
      "items": [
        {
          "text": "64",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 64:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa, dai maibvarura matenga mukaburuka pasi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.1",
            "verseOrgIds": [
              "ISA.64.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:1"
      },
      "items": [
        {
          "text": "kuti makomo adedere pamberi penyu!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.1",
            "verseOrgIds": [
              "ISA.64.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 64:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sezvinoita moto paunopisa tsotso",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.2",
            "verseOrgIds": [
              "ISA.64.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:2"
      },
      "items": [
        {
          "text": "uchiita kuti mvura ivire,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.2",
            "verseOrgIds": [
              "ISA.64.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 64:2"
      },
      "items": [
        {
          "text": "burukai muzoita kuti zita renyu rizivikanwe kuvavengi venyu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.2",
            "verseOrgIds": [
              "ISA.64.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:2"
      },
      "items": [
        {
          "text": "uye muite kuti ndudzi dzidedere pamberi penyu!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.2",
            "verseOrgIds": [
              "ISA.64.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 64:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti pamakaita zvinhu zvinotyisa zvatakanga tisina kutarisira,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.3",
            "verseOrgIds": [
              "ISA.64.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:3"
      },
      "items": [
        {
          "text": "makaburuka pasi, makomo akabvunda pamberi penyu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.3",
            "verseOrgIds": [
              "ISA.64.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 64:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubva panguva dzekare hakuna munhu akanzwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.4",
            "verseOrgIds": [
              "ISA.64.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:4"
      },
      "items": [
        {
          "text": "hakuna nzeve yakanzwisisa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.4",
            "verseOrgIds": [
              "ISA.64.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 64:4"
      },
      "items": [
        {
          "text": "hakuna ziso rakaona mumwe Mwari kunze kwenyu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.4",
            "verseOrgIds": [
              "ISA.64.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:4"
      },
      "items": [
        {
          "text": "anobatsira avo vanomumirira.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.4",
            "verseOrgIds": [
              "ISA.64.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 64:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munouya kuzobatsira avo vanofarira kuita zvakarurama,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.5",
            "verseOrgIds": [
              "ISA.64.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:5"
      },
      "items": [
        {
          "text": "vanorangarira nzira dzenyu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.5",
            "verseOrgIds": [
              "ISA.64.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 64:5"
      },
      "items": [
        {
          "text": "Asi patakaramba tichivatadzira,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.5",
            "verseOrgIds": [
              "ISA.64.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:5"
      },
      "items": [
        {
          "text": "imi makatsamwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.5",
            "verseOrgIds": [
              "ISA.64.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:5"
      },
      "items": [
        {
          "text": "Zvino tingaponeswa seiko?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.5",
            "verseOrgIds": [
              "ISA.64.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 64:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isu tose tafanana nousina kuchena,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.6",
            "verseOrgIds": [
              "ISA.64.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:6"
      },
      "items": [
        {
          "text": "uye mabasa edu ose okururama afanana namamvemve enguo dzine tsvina;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.6",
            "verseOrgIds": [
              "ISA.64.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 64:6"
      },
      "items": [
        {
          "text": "isu tose tinooma seshizha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.6",
            "verseOrgIds": [
              "ISA.64.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:6"
      },
      "items": [
        {
          "text": "semhepo zvivi zvedu zvinotitsvairira kure.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.6",
            "verseOrgIds": [
              "ISA.64.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 64:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuna anodana kuzita renyu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.7",
            "verseOrgIds": [
              "ISA.64.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:7"
      },
      "items": [
        {
          "text": "kana anoshingairira kuti akubatei;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.7",
            "verseOrgIds": [
              "ISA.64.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 64:7"
      },
      "items": [
        {
          "text": "nokuti makativanzira chiso chenyu mukaita",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.7",
            "verseOrgIds": [
              "ISA.64.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:7"
      },
      "items": [
        {
          "text": "kuti tiperezeke nokuda kwezvivi zvedu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.7",
            "verseOrgIds": [
              "ISA.64.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 64:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa, Jehovha, kunyange zvakadaro muri Baba vedu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.8",
            "verseOrgIds": [
              "ISA.64.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:8"
      },
      "items": [
        {
          "text": "Isu tiri ivhu, imi muri muumbi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.8",
            "verseOrgIds": [
              "ISA.64.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:8"
      },
      "items": [
        {
          "text": "isu tose tiri basa ramaoko enyu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.8",
            "verseOrgIds": [
              "ISA.64.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 64:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Regai kutsamwa zvikuru imi Jehovha;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.9",
            "verseOrgIds": [
              "ISA.64.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:9"
      },
      "items": [
        {
          "text": "regai kurangarira zvivi zvedu nokusingaperi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.9",
            "verseOrgIds": [
              "ISA.64.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 64:9"
      },
      "items": [
        {
          "text": "Haiwa Jehovha, ringirai kwatiri, tinokumbira,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.9",
            "verseOrgIds": [
              "ISA.64.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:9"
      },
      "items": [
        {
          "text": "nokuti tose tiri vanhu venyu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.9",
            "verseOrgIds": [
              "ISA.64.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 64:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maguta enyu matsvene ava renje;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.10",
            "verseOrgIds": [
              "ISA.64.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:10"
      },
      "items": [
        {
          "text": "kunyange Zioni irenje, Jerusarema rava dongo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.10",
            "verseOrgIds": [
              "ISA.64.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 64:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Temberi yedu tsvene inobwinya, umo madzibaba edu akakurumbidzai,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.11",
            "verseOrgIds": [
              "ISA.64.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:11"
      },
      "items": [
        {
          "text": "yakapiswa nomoto,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.11",
            "verseOrgIds": [
              "ISA.64.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:11"
      },
      "items": [
        {
          "text": "uye nzvimbo dzose dzataikoshesa dzaparara.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.11",
            "verseOrgIds": [
              "ISA.64.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 64:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa Jehovha, mushure maizvozvi mungazvidzorawo here?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.12",
            "verseOrgIds": [
              "ISA.64.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:12"
      },
      "items": [
        {
          "text": "Mucharamba munyerere, uye mugotiranga zvinopfuura mwero here?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.12",
            "verseOrgIds": [
              "ISA.64.11"
            ]
          }
        }
      ]
    }
  ],
