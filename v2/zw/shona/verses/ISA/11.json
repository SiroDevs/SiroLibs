      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Davi raJese",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukira richabva kudzinde raJese;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.1",
            "verseOrgIds": [
              "ISA.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:1"
      },
      "items": [
        {
          "text": "Davi rinobva pamidzi yake richabereka muchero.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.1",
            "verseOrgIds": [
              "ISA.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mweya waJehovha uchagara pamusoro pake,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.2",
            "verseOrgIds": [
              "ISA.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:2"
      },
      "items": [
        {
          "text": "mweya wouchenjeri newokunzwisisa, mweya wokurayira nowesimba,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.2",
            "verseOrgIds": [
              "ISA.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:2"
      },
      "items": [
        {
          "text": "mweya wokuziva newokutya Jehovha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.2",
            "verseOrgIds": [
              "ISA.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye achafarira kutya Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.3",
            "verseOrgIds": [
              "ISA.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 11:3"
      },
      "items": [
        {
          "text": "Haazotongi nezvaanoona nameso ake,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.3",
            "verseOrgIds": [
              "ISA.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:3"
      },
      "items": [
        {
          "text": "kana kutonga nezvaanonzwa nenzeve dzake,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.3",
            "verseOrgIds": [
              "ISA.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi nokururama achatongera varombo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.4",
            "verseOrgIds": [
              "ISA.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:4"
      },
      "items": [
        {
          "text": "nokururamisira achatongera vanyoro vapanyika.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.4",
            "verseOrgIds": [
              "ISA.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 11:4"
      },
      "items": [
        {
          "text": "Acharova nyika neshamhu yomuromo wake;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.4",
            "verseOrgIds": [
              "ISA.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:4"
      },
      "items": [
        {
          "text": "nokufema kwemiromo yake achauraya vakaipa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.4",
            "verseOrgIds": [
              "ISA.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kururuma ndiro richava bhanhire rake",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.5",
            "verseOrgIds": [
              "ISA.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:5"
      },
      "items": [
        {
          "text": "uye kutendeka bhanhire romuchiuno chake.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.5",
            "verseOrgIds": [
              "ISA.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bere richagara negwayana,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.6",
            "verseOrgIds": [
              "ISA.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:6"
      },
      "items": [
        {
          "text": "ingwe ichavata pasi nembudzi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.6",
            "verseOrgIds": [
              "ISA.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 11:6"
      },
      "items": [
        {
          "text": "mhuru neshumba nezvakakodzwa zvichafura pamwe chete;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.6",
            "verseOrgIds": [
              "ISA.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:6"
      },
      "items": [
        {
          "text": "uye mwana mudiki achazvitungamirira.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.6",
            "verseOrgIds": [
              "ISA.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mhou ichafura nebere,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.7",
            "verseOrgIds": [
              "ISA.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:7"
      },
      "items": [
        {
          "text": "vana vazvo vachavata pasi pamwe chete,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.7",
            "verseOrgIds": [
              "ISA.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:7"
      },
      "items": [
        {
          "text": "uye shumba ichadya uswa senzombe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.7",
            "verseOrgIds": [
              "ISA.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana mucheche achatambira pedyo nomwena wemhakure,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.8",
            "verseOrgIds": [
              "ISA.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:8"
      },
      "items": [
        {
          "text": "uye mwana mudiki achaisa ruoko rwake mumwena wenyoka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.8",
            "verseOrgIds": [
              "ISA.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazvingazokuvadzi kana kuparadza",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.9",
            "verseOrgIds": [
              "ISA.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:9"
      },
      "items": [
        {
          "text": "pagomo rangu rose dzvene,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.9",
            "verseOrgIds": [
              "ISA.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 11:9"
      },
      "items": [
        {
          "text": "nokuti nyika ichazara nokuziva Jehovha",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.9",
            "verseOrgIds": [
              "ISA.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:9"
      },
      "items": [
        {
          "text": "semvura zhinji inofukidza gungwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.9",
            "verseOrgIds": [
              "ISA.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva iro Mudzi waJese uchamira somureza wamarudzi; ndudzi dzichamhanyira kwaari, uye nzvimbo yake yokuzorora ichabwinya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.10",
            "verseOrgIds": [
              "ISA.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva iro Jehovha achatambanudza ruoko rwake kechipiri kuti adzorezve vakasara ivo vanhu vake vakasiyiwa kubva kuAsiria, kubva zasi kweIjipiti, nokubva kumusoro kweIjipiti nokubva kuEtiopia, nokubva kuEramu, nokubva kuBhabhironi, nokuHamati uye nokubva kuzviwi zvegungwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.11",
            "verseOrgIds": [
              "ISA.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achasimudzira marudzi mureza",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.12",
            "verseOrgIds": [
              "ISA.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:12"
      },
      "items": [
        {
          "text": "uye achaunganidza vakadzingwa vaIsraeri;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.12",
            "verseOrgIds": [
              "ISA.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 11:12"
      },
      "items": [
        {
          "text": "achaunganidza vakaparadzirwa vavanhu veJudha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.12",
            "verseOrgIds": [
              "ISA.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:12"
      },
      "items": [
        {
          "text": "kubva kumativi mana enyika.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.12",
            "verseOrgIds": [
              "ISA.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Godo raEfuremu richapera",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.13",
            "verseOrgIds": [
              "ISA.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:13"
      },
      "items": [
        {
          "text": "uye vavengi vavaJudha vachagurwa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.13",
            "verseOrgIds": [
              "ISA.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 11:13"
      },
      "items": [
        {
          "text": "Efuremu haachazovi negodo naJudha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.13",
            "verseOrgIds": [
              "ISA.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:13"
      },
      "items": [
        {
          "text": "naJudha haangaitire Efuremu hasha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.13",
            "verseOrgIds": [
              "ISA.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vachawira pamusoro pamateru eFiristia kumavirazuva;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.14",
            "verseOrgIds": [
              "ISA.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:14"
      },
      "items": [
        {
          "text": "pamwe chete vachapamba vanhu vokumabvazuva.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.14",
            "verseOrgIds": [
              "ISA.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 11:14"
      },
      "items": [
        {
          "text": "Vachatora Edomu neMoabhu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.14",
            "verseOrgIds": [
              "ISA.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:14"
      },
      "items": [
        {
          "text": "uye vaAmoni vachava varanda vavo.",
