          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Esteri anoitwa vaHosi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushure mezvinhu izvi kutsamwa kwamambo Zekisesi kwapera, akarangarira Vhashiti nezvaakanga aita uye nezvaakanga atema pamusoro pake.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.1",
            "verseOrgIds": [
              "EST.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo varanda vamambo vaimushandira vakati,",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.2",
            "verseOrgIds": [
              "EST.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mambo ngaatsvakirwe mhandara dzakanaka. Mambo ngaagadze nhume munyika dzose dzoumambo hwake kuti vauye navasikana vakanaka munzvimbo inogara vakadzi panhare yeShushani. Ngavachengetwe naHegai, muranda wamambo anoona nezvamadzimai, uye zvinopa runako ngazvipiwe kwavari.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.3",
            "verseOrgIds": [
              "EST.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino musikana uyo anofadza mambo ngaave vahosi pachinzvimbo chaVhashiti.\" Zano iri rakafadza mambo, uye akaita saizvozvo.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.4",
            "verseOrgIds": [
              "EST.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino munhare yeShushani maiva nomuJudha worudzi rwaBhenjamini, ainzi Modhekai mwanakomana waJairi, mwanakomana waShimei, mwanakomana waKishi,",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.5",
            "verseOrgIds": [
              "EST.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "akanga atapwa kubva kuJerusarema naNebhukadhinezari mambo weBhabhironi, ari pakati paavo vakatapwa pamwe chete naJehoyakini mambo weJudha.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.6",
            "verseOrgIds": [
              "EST.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Modhekai aiva nomwanasikana wasekuru vake ainzi Hadhasa, waakanga arera nokuti akanga asina mai kana baba. Musikana uyu ainziwo Esteri, akanga akanaka kwazvo pachimiro napaunhu, uye Modhekai akanga amutora somwanasikana wake pakufa kwakaita mai vake nababa vake.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.7",
            "verseOrgIds": [
              "EST.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino murayiro nomutemo wamambo zvakati zvaziviswa, vasikana vazhinji vakauyiswa kunhare yeShushani ndokuiswa pasi paHegai kuti avachengete. NaEsteriwo akatorwa akaiswa mumuzinda wamambo akachengetwa naHegai, aiva muchengeti wenzvimbo yaigara madzimai.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.8",
            "verseOrgIds": [
              "EST.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musikana akamufadza akawana nyasha kwaari. Pakarepo akamupa zvinonhuhwira zvinowedzera runako uye nezvokudya zvakatsaurwa. Akamupa vasikana vanomwe vakanga vasarudzwa kubva munhare yamambo ndokumuendesa iye navasikana vake kunzvimbo yakanga yakanakisisa muimba yavakadzi.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.9",
            "verseOrgIds": [
              "EST.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esteri akanga asina kutaura rudzi rwake nemhuri yake, kana kwaaibva, nokuti Modhekai akanga amurambidza kuita izvozvo.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.10",
            "verseOrgIds": [
              "EST.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zuva rimwe nerimwe aitenderera ari pedyo noruvazhe rwenzvimbo yaigariswa vanhukadzi achida kuona kuti Esteri akadini uye kuti chii chaiitika kwaari.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.11",
            "verseOrgIds": [
              "EST.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musikana aifanira kupedza mwedzi gumi nemiviri achizvinatsa nezvinonhuhwira dzoro rake risati rasvika rokupinda kuna mambo Zekisesi sokurongerwa kwaiitirwa vanhukadzi, mwedzi mitanhatu yamafuta emura uye mwedzi mitanhatu yezvinonhuhwira nezvizoro.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.12",
            "verseOrgIds": [
              "EST.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino aya ndiwo aiva maendero ake kuna mambo: Aipiwa chinhu chipi nechipi chaaida kutora kuti aende nacho kumuzinda wamambo paainge achibva kwaigara vanhukadzi.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.13",
            "verseOrgIds": [
              "EST.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ava manheru aipota achiendako uye mangwanani achidzokera kune rimwe kamuri raigara vanhukadzi kwaichengetwa naShaashigazi, muranda wamambo aiva muchengeti wavarongo. Aisadzokerazve kuna mambo kunze kwokunge mambo afadzwa naye akamudaidza nezita.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.14",
            "verseOrgIds": [
              "EST.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dzoro raEsteri rakati rasvika (musikana akanga atorwa kuti ave mwana naModhekai, mwanasikana wasekuru vake Abhihairi) rokuenda kuna Mambo, haana chaakakumbira kunze kwezvaakaudzwa naHegai, muranda wamambo aiva mutariri wenzvimbo yaigarwa navanhukadzi. Zvino Esteri akawana nyasha kuna vose vakamuona.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.15",
            "verseOrgIds": [
              "EST.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EST 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaendeswa kuna Mambo Zekisesi muimba youmambo mumwedzi wegumi, mwedzi waTibheti, mugore rechinomwe rokutonga kwake.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.16",
            "verseOrgIds": [
              "EST.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EST 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino mambo akayevedzwa naEsteri kupfuura ani naani zvake wavamwe vakadzi, uye akawana nyasha kwaari akagamuchirwa kupfuura ani zvake pakati pedzimwe mhandara. Saka akagadza korona youmambo pamusoro wake akamuita vahosi panzvimbo yaVhashiti.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.17",
            "verseOrgIds": [
              "EST.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EST 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino mambo akaita mabiko makuru, mabiko aEsteri, achiitira makurukota ake ose navabati. Akadaidzira zuva rezororo munyika dzose akagovera zvipo, zvakawanda sezvakakodzera mambo.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.18",
            "verseOrgIds": [
              "EST.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Modhekai anoburitsa pachena rangano yakaipa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EST 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mhandara dzakati dzaungana kechipiri, Modhekai akanga akagara pasuo ramambo.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.19",
            "verseOrgIds": [
              "EST.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EST 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Esteri akanga avanza nhoroondo yemhuri yake norudzi rwake sezvaakanga audzwa naModhekai, nokuti akaramba achitevera kurayira kwaModhekai nezvaaisiita acharerwa naye.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.20",
            "verseOrgIds": [
              "EST.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EST 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva iyo Modhekai akanga akagara pasuo ramambo, Bhigitana naTereshi, vabati vaviri vamambo vairinda mukova vakatsamwa ndokubva varangana kuuraya Mambo Zekisesi.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.21",
            "verseOrgIds": [
              "EST.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EST 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Modhekai akazviziva ndokubva audza Esteri nezverangano iyi, iye ndokuzvizivisa kuna mambo, achiti akanga anzwa naModhekai.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.22",
            "verseOrgIds": [
              "EST.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EST 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino shoko iri rakati raferefetwa uye rikawanikwa riri rechokwadi, vabati vaviri ava vakasungirwa pamatanda vakafa. Zvose izvi zvakanyorwa mubhuku renhoroondo pamberi pamambo.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.23",
            "verseOrgIds": [
              "EST.2.23"
            ]
          }
        }
      ]
    }
  ],
