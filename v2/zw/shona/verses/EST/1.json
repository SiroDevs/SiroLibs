  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "EST 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izvi ndizvo zvakaitika panguva yaZekisesi, uya Zekisesi akatonga nyika zana namakumi maviri nenomwe kubva kuIndia kusvika kuEtiopia:",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.1",
            "verseOrgIds": [
              "EST.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva iyo mambo Zekisesi akatonga ari pachigaro chake choumambo munhare yeShushani",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.2",
            "verseOrgIds": [
              "EST.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye mugore rake rechitatu akaitira makurukota ake ose navabati vake mabiko. Vakuru vehondo yePezhia neMedhia, machinda namakurukota enyika aivapo.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.3",
            "verseOrgIds": [
              "EST.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaratidza kuwanda kwepfuma youmambo hwake uye nokuyevedza nokubwinya kwoumambo hwake kwamazuva zana namakumi masere akazara.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.4",
            "verseOrgIds": [
              "EST.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazuva aya akati apera, mambo akaita mabiko akapedza mazuva manomwe, mumunhanga webindu romuzinda wamambo achiitira vanhu vose kubva kuvadiki kusvikira kuvakuru, vaigara munhare yeShushani.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.5",
            "verseOrgIds": [
              "EST.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bindu raiva nezvakarembedzwa zvichena nezvebhuruu zvomucheka, zvakanga zvakasungirirwa nezvisungo zvomucheka muchena nowepepuru, kuzvikochekedzo zvesirivha pamusoro pembiru dzamatombo akanga akavezwa. Paiva nezvigaro zvegoridhe nezvesirivha pamusoro penzira yamatombo mashava, machena namamwewo anokosha.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.6",
            "verseOrgIds": [
              "EST.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waini yaipiwa vanhu mumidziyo yegoridhe, yakasiyana-siyana, uye waini yamambo yakanga yakawanda, samambo, asingavanyimi napaduku.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.7",
            "verseOrgIds": [
              "EST.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakakokwa vakabvumirwa kunwa pamadiro, nokuti mambo akarayira vatariri vewaini vose kuti vagovere mumwe nomumwe sezvaaida.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.8",
            "verseOrgIds": [
              "EST.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaHosi Vhashiti vakaitawo mabiko amadzimai mumuzinda waMambo Zekisesi.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.9",
            "verseOrgIds": [
              "EST.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva rechinomwe, Mambo Zekisesi afara kwazvo mumwoyo make nokuda kwewaini, akarayira varanda vanomwe vaimushumira, Mehumani, Bhizita, Habhona, Bhigita, Abhagita, Zeta naKakasi,",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.10",
            "verseOrgIds": [
              "EST.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti vauye navaHosi Vhashiti, vakapfeka korona youmambo, kuti aratidze runako rwavo kuvanhu nokumakurukota, nokuti vakanga vakanaka pakuonekwa.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.11",
            "verseOrgIds": [
              "EST.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi pakasvika shoko rakanga rarayirwa namambo, vaHosi Vhashiti vakaramba kuuya. Ipapo mambo akashatirwa zvikuru uye akatsva nehasha.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.12",
            "verseOrgIds": [
              "EST.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mambo akabvunza vachenjeri vaiziva murayiro uye vainzwisisa zvenguva sezvo yaiva tsika yamadzimambo kubvunza nyanzvi dzezvomurayiro nokururamisira,",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.13",
            "verseOrgIds": [
              "EST.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye vaiva pedyo kwazvo namambo vaiti: Kashena, Sheta, Adhumata, Tashishi, Meresi, Masena naMemukani, makurukota manomwe ePezhia neMedhia avo vaiva nekodzero yokupinda kuna mambo uye vaikudzwa muumambo.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.14",
            "verseOrgIds": [
              "EST.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabvunza achiti, \"Pamurayiro chii chinofanira kuitwa kuna vaHosi Vhashiti? Havana kuteerera kurayira kwaMambo Zekisesi sokuudzwa kwavaitwa navaranda.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.15",
            "verseOrgIds": [
              "EST.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EST 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Memukani akapindura pamberi pamambo namakurukota akati, \"VaHosi Vhashiti vaita zvakaipa, kwete kuna mambo chete asi nokumakurukota ose nokuvanhu vose venyika dzose dzamambo Zekisesi.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.16",
            "verseOrgIds": [
              "EST.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EST 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti zvaitwa navahosi zvichazivikanwa navakadzi vose, nokudaro vachazvidza varume vavo vachiti, 'Inga wani Mambo Zekisesi vakarayira vaHosi Vhashiti kuti vauye vamire pamberi pavo, asi vakaramba kuuya.'",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.17",
            "verseOrgIds": [
              "EST.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EST 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye nhasi uno vakadzi vamakurukota ePezhia neveMedhia vanzwa zvaitwa navahosi vachaitawo saizvozvo kumakurukota amambo. Kusakudzana nenyonganyonga hazvimbozoperi.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.18",
            "verseOrgIds": [
              "EST.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EST 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Naizvozvo, kana mambo achifara nazvo, ngaateme chirevo chamambo uye ngachinyorwe mumirayiro yavaPezhia navaMedhia, isingagoni kushandurwa kuti Vhashiti haachazosvikizve pamberi paMambo Zekisesi. Uyezve mambo ngaape chinzvimbo chake muumambo kuno mumwe ari nani kupinda iye.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.19",
            "verseOrgIds": [
              "EST.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EST 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo kana chirevo chamambo chaziviswa muumambo hwake hwose, vakadzi vose vachakudza varume vavo, kubva kumudiki kusvikira kumukuru.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.20",
            "verseOrgIds": [
              "EST.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EST 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo namakurukota ake vakafadzwa nezano iri, saka mambo akaita sezvakanga zvarehwa naMemukani.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.21",
            "verseOrgIds": [
              "EST.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EST 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatumira matsamba kumativi ose oumambo hwake, kunyika imwe neimwe norunyoro rwayo nokumunhu mumwe nomumwe nomutauro wake achizivisa norurimi rwavanhu kuti murume mumwe nomumwe ave nesimba pamusoro peimba yake.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.22",
            "verseOrgIds": [
              "EST.1.22"
            ]
          }
        }
      ]
    }
  ],
