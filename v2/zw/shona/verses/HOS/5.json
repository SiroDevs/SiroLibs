          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kutongwa kweIsraeri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Inzwai izvi, imi vaprista!",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.1",
            "verseOrgIds": [
              "HOS.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:1"
      },
      "items": [
        {
          "text": "Teererai, imi vaIsraeri!",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.1",
            "verseOrgIds": [
              "HOS.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 5:1"
      },
      "items": [
        {
          "text": "Teerera, iwe imba youmambo!",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.1",
            "verseOrgIds": [
              "HOS.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:1"
      },
      "items": [
        {
          "text": "Ndiwe uri kutongwa:",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.1",
            "verseOrgIds": [
              "HOS.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 5:1"
      },
      "items": [
        {
          "text": "Wakanga uri musungo paMizipa,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.1",
            "verseOrgIds": [
              "HOS.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:1"
      },
      "items": [
        {
          "text": "mumbure wakatambanudzwa paTabhori.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.1",
            "verseOrgIds": [
              "HOS.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vapanduki vari mushishi rokuuraya.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.2",
            "verseOrgIds": [
              "HOS.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:2"
      },
      "items": [
        {
          "text": "Ndichavaranga vose.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.2",
            "verseOrgIds": [
              "HOS.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinoziva zvose zviri pamusoro paEfuremu;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.3",
            "verseOrgIds": [
              "HOS.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:3"
      },
      "items": [
        {
          "text": "Israeri haina kuvanzika kwandiri.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.3",
            "verseOrgIds": [
              "HOS.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 5:3"
      },
      "items": [
        {
          "text": "Efuremu, watendeukira zvino kuufeve;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.3",
            "verseOrgIds": [
              "HOS.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:3"
      },
      "items": [
        {
          "text": "Israeri aora.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.3",
            "verseOrgIds": [
              "HOS.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zviito zvavo hazvivatenderi",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.4",
            "verseOrgIds": [
              "HOS.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:4"
      },
      "items": [
        {
          "text": "kudzokera kuna Mwari wavo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.4",
            "verseOrgIds": [
              "HOS.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 5:4"
      },
      "items": [
        {
          "text": "Mweya woufeve uri mumwoyo yavo;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.4",
            "verseOrgIds": [
              "HOS.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:4"
      },
      "items": [
        {
          "text": "havazivi Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.4",
            "verseOrgIds": [
              "HOS.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuzvikudza kwaIsraeri kunovapa mhosva;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.5",
            "verseOrgIds": [
              "HOS.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:5"
      },
      "items": [
        {
          "text": "vaIsraeri, kunyange Efuremu, vanogumburwa muchivi chavo;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.5",
            "verseOrgIds": [
              "HOS.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:5"
      },
      "items": [
        {
          "text": "Judha anogumburwawo pamwe chete navo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.5",
            "verseOrgIds": [
              "HOS.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pavachaenda namakwai nemombe dzavo",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.6",
            "verseOrgIds": [
              "HOS.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:6"
      },
      "items": [
        {
          "text": "kundotsvaka Jehovha,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.6",
            "verseOrgIds": [
              "HOS.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 5:6"
      },
      "items": [
        {
          "text": "havazomuwani;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.6",
            "verseOrgIds": [
              "HOS.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:6"
      },
      "items": [
        {
          "text": "azvibvisa kwavari.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.6",
            "verseOrgIds": [
              "HOS.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Havana kutendeka kuna Jehovha;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.7",
            "verseOrgIds": [
              "HOS.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:7"
      },
      "items": [
        {
          "text": "vanobereka vana voupombwe.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.7",
            "verseOrgIds": [
              "HOS.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 5:7"
      },
      "items": [
        {
          "text": "Zvino mitambo yavo yoKugara kwoMwedzi",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.7",
            "verseOrgIds": [
              "HOS.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:7"
      },
      "items": [
        {
          "text": "ichavadya pamwe chete neminda yavo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.7",
            "verseOrgIds": [
              "HOS.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ridzai hwamanda paGibhea,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.8",
            "verseOrgIds": [
              "HOS.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:8"
      },
      "items": [
        {
          "text": "norunyanga paRama.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.8",
            "verseOrgIds": [
              "HOS.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 5:8"
      },
      "items": [
        {
          "text": "Ridzai mhere yehondo paBheti Avheni;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.8",
            "verseOrgIds": [
              "HOS.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:8"
      },
      "items": [
        {
          "text": "tungamira pamberi, iwe Bhenjamini.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.8",
            "verseOrgIds": [
              "HOS.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efuremu achaparadzwa",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.9",
            "verseOrgIds": [
              "HOS.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:9"
      },
      "items": [
        {
          "text": "pazuva rokutongwa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.9",
            "verseOrgIds": [
              "HOS.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 5:9"
      },
      "items": [
        {
          "text": "Pakati pamarudzi aIsraeri",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.9",
            "verseOrgIds": [
              "HOS.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:9"
      },
      "items": [
        {
          "text": "ndinozivisa zvinhu zvechokwadi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.9",
            "verseOrgIds": [
              "HOS.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vatungamiri vaJudha vakafanana neavo",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.10",
            "verseOrgIds": [
              "HOS.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:10"
      },
      "items": [
        {
          "text": "vanobvisa mabwe omuganhu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.10",
            "verseOrgIds": [
              "HOS.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 5:10"
      },
      "items": [
        {
          "text": "Ndichadurura hasha dzangu pavari",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.10",
            "verseOrgIds": [
              "HOS.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:10"
      },
      "items": [
        {
          "text": "samafashamu emvura.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.10",
            "verseOrgIds": [
              "HOS.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efuremu adzvinyirirwa",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.11",
            "verseOrgIds": [
              "HOS.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:11"
      },
      "items": [
        {
          "text": "atsikwa-tsikwa mukutongwa,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.11",
            "verseOrgIds": [
              "HOS.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:11"
      },
      "items": [
        {
          "text": "nokuti akada kutevera zvifananidzo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.11",
            "verseOrgIds": [
              "HOS.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
