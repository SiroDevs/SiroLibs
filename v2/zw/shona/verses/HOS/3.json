        "style": "s1"
      },
      "items": [
        {
          "text": "Hosea anodzokerana nomukadzi wake",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kwandiri, \"Enda, unodazve mukadzi wako, kunyange achidiwa nomumwe uye ari chifeve. Umude sokuda kunoita Jehovha vaIsraeri, kunyange vachitendeukira kuna vamwe vamwari vachida makeke akaereswa ane marezini.\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.1",
            "verseOrgIds": [
              "HOS.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka ndakamutenga namashekeri gumi namashanu",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.2",
            "verseOrgIds": [
              "HOS.3.2"
            ]
          }
        },
        {
          "text": "esirivha neinenge homeri nereteki",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.2",
            "verseOrgIds": [
              "HOS.3.2"
            ]
          }
        },
        {
          "text": "rebhari.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.2",
            "verseOrgIds": [
              "HOS.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ndakati kwaari, \"Unofanira kugara neni kwamazuva akawanda; haufaniri kuva chifeve kana kudanana nomumwe murume, uye ndichagara newe.\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.3",
            "verseOrgIds": [
              "HOS.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti vaIsraeri vachagara mazuva mazhinji vasina mambo kana muchinda, vasina chibayiro, vasina shongwe, efodhi kana chifananidzo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.4",
            "verseOrgIds": [
              "HOS.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushure maizvozvo vaIsraeri vachadzoka vagotsvaka Jehovha Mwari wavo naDhavhidhi mambo wavo. Vachauya vachidedera kuna Jehovha nokumaropafadzo ake mumazuva okupedzisira.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.5",
            "verseOrgIds": [
              "HOS.3.5"
            ]
          }
        }
      ]
    }
  ],
