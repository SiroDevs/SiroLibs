{
  "id": "JOS.4",
  "number": "4",
  "bookId": "JOS",
  "reference": "Joshua 4",
  "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "JOS 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Matombo Gumi Namaviri anomiswa paGirigari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rudzi rwose parwakapedza kuyambuka Jorodhani, Jehovha akati kuna Joshua,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.1",
            "verseOrgIds": [
              "JOS.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sarudza varume gumi navaviri kubva pakati pavanhu, mumwe chete parudzi rumwe norumwe,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.2",
            "verseOrgIds": [
              "JOS.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugovaudza kuti vatore mabwe gumi namaviri kubva pakati peJorodhani panga pakamira vaprista chaipo, mugoatakura mugoaisa pamunorara nhasi manheru.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.3",
            "verseOrgIds": [
              "JOS.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Joshua akadaidza varume gumi navaviri vaakanga asarudza kubva kuvaIsraeri, mumwe chete kubva kurudzi rumwe norumwe,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.4",
            "verseOrgIds": [
              "JOS.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati kwavari, \"Endai pamberi peareka yaJehovha mupinde pakati peJorodhani. Mumwe nomumwe wenyu anofanira kutakura dombo pafudzi pake zvichienderana nokuwanda kwamarudzi avaIsraeri,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.5",
            "verseOrgIds": [
              "JOS.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti ave chiratidzo pakati penyu. Mumazuva anotevera kana vana venyu vobvunza vachiti, 'Ko, matombo aya anorevei?'",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.6",
            "verseOrgIds": [
              "JOS.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "muvataurire kuti mvura yeJorodhani yaiyerera yakaganhurwa pamberi peareka yesungano yaJehovha. Pavakayambuka Jorodhani, mvura yeJorodhani yakaganhurwa. Matombo aya anofanira kuva chirangaridzo kuvanhu veIsraeri nokusingaperi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.7",
            "verseOrgIds": [
              "JOS.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vaIsraeri vakaita sezvavakarayirwa naJoshua. Vakatora matombo gumi namaviri kubva pakati peJorodhani, aienderana nokuwanda kwamarudzi avaIsraeri, sezvakanga zvataurirwa Joshua naJehovha; vakaatakura vakaenda nawo kumisasa yavo kwavakanoaisa pasi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.8",
            "verseOrgIds": [
              "JOS.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joshua akamisa matombo gumi namaviri akanga ari pakati peJorodhani pakanga pakamira vaprista vakanga vakatakura areka yesungano. Uye achiripo nanhasi uno.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.9",
            "verseOrgIds": [
              "JOS.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaprista vakanga vakatakura areka vakaramba vakamira pakati peJorodhani kusvikira zvose zvakanga zvarayirwa Joshua naJehovha zvaitwa navanhu, sokurayirwa kwakanga kwaitwa Joshua naMozisi. Vanhu vakakurumidza kuyambuka",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.10",
            "verseOrgIds": [
              "JOS.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye vose vachangoyambuka, areka yaJehovha navaprista vakayambukawo vanhu vakavatarisa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.11",
            "verseOrgIds": [
              "JOS.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume vokwaRubheni nevokwaGadhi nehafu yorudzi rwaManase vakayambuka, vakatakura zvombo zvokurwa nazvo, pamberi pavaIsraeri, sokurayirwa kwavakanga vaitwa naMozisi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.12",
            "verseOrgIds": [
              "JOS.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanenge zviuru makumi mana vakanga vakatakura zvombo zvokurwa nazvo, vakayambukira mhiri pamberi paJehovha vakaenda kumapani eJeriko kundorwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.13",
            "verseOrgIds": [
              "JOS.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva iroro Jehovha akasimudzira Joshua pamberi pavaIsraeri vose; vakamuremekedza mazuva ose oupenyu hwake sokuremekedza kwavakanga vaita Mozisi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.14",
            "verseOrgIds": [
              "JOS.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Jehovha akati kuna Joshua,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.15",
            "verseOrgIds": [
              "JOS.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Rayira vaprista vakatakura areka yeChipupuriro kuti vabude kubva muJorodhani.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.16",
            "verseOrgIds": [
              "JOS.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Joshua akarayira vaprista achiti, \"Budai muJorodhani.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.17",
            "verseOrgIds": [
              "JOS.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino vaprista vakanga vakatakura areka yesungano yaJehovha vachangobuda kubva pakati peJorodhani, tsoka dzavo dzichangotsika ivhu rakaoma, mvura yeJorodhani yakadzokera panzvimbo yayo ikazara kusvika nokumahombekombe ose.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.18",
            "verseOrgIds": [
              "JOS.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva regumi romwedzi wokutanga, vanhu vakabuda kubva muJorodhani vakavaka misasa paGirigari pamuganhu wokumabvazuva eJeriko.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.19",
            "verseOrgIds": [
              "JOS.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Joshua akamisa matombo gumi namaviri paGirigari avakanga vatora kubva muJorodhani.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.20",
            "verseOrgIds": [
              "JOS.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati kuvaIsraeri, \"Mumazuva anotevera kana vana venyu vobvunza madzibaba avo vachiti, 'Ko, matombo aya anorevei?'",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.21",
            "verseOrgIds": [
              "JOS.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "muvataurire kuti, 'Israeri yakayambuka Jorodhani pavhu rakaoma.'",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.22",
            "verseOrgIds": [
              "JOS.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti Jehovha Mwari wenyu akaomesa Jorodhani pamberi penyu kusvikira mayambuka. Jehovha Mwari wenyu akaita kuJorodhani sezvaakaita kuGungwa Dzvuku paakariomesa pamberi pedu kusvikira tayambuka.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.23",
            "verseOrgIds": [
              "JOS.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaita izvi kuitira kuti ndudzi dzose dzapanyika dzizive kuti ruoko rwaJehovha rune simba uye kuti vatye Jehovha Mwari wenyu nokusingaperi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.24",
            "verseOrgIds": [
              "JOS.4.24"
            ]
          }
        }
      ]
    }
  ],
