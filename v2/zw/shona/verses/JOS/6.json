  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "JOS 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino guta reJeriko rakanga rapfigwa zvakasimba kwazvo nokuda kwavaIsraeri. Hapana akabuda kunze uye hapana akapinda mukati.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.1",
            "verseOrgIds": [
              "JOS.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Jehovha akati kuna Joshua, \"Tarira, ndaisa Jeriko mumaoko ako, pamwe chete namambo waro navarume varo vehondo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.2",
            "verseOrgIds": [
              "JOS.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fambai mutenderere guta kamwe chete pamwe navarume vose vehondo. Muite izvi kwamazuva matanhatu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.3",
            "verseOrgIds": [
              "JOS.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngapave navaprista vanomwe vanotakura hwamanda dzenyanga dzamakondobwe pamberi peareka. Pazuva rechinomwe fambai muchitenderera guta kanomwe, vaprista vachiridza hwamanda.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.4",
            "verseOrgIds": [
              "JOS.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana mukazovanzwa varidza hwamanda kwenguva refu, vanhu vose vanofanira kudanidzira zvikuru; ipapo rusvingo rweguta ruchakoromoka, vanhu vagopinda, mumwe nomumwe pakanangana naye.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.5",
            "verseOrgIds": [
              "JOS.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Joshua mwanakomana waNuni akadana vaprista akati kwavari, \"Takurai areka yesungano yaJehovha uye vaprista vanomwe ngavatakure hwamanda pamberi pavo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.6",
            "verseOrgIds": [
              "JOS.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akarayira vanhu akati, \"Endai mberi! Fambai muchipoterera guta, varume vakatakura zvombo zvokurwa nazvo vaende mberi kweareka yaJehovha.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.7",
            "verseOrgIds": [
              "JOS.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joshua paakapedza kutaura navanhu, vaprista vanomwe vakatakura hwamanda nomwe pamberi paJehovha vakaenda pamberi, vachiridza hwamanda dzavo, areka yesungano yaJehovha ikavatevera.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.8",
            "verseOrgIds": [
              "JOS.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakanga vakatakura zvombo zvokurwa nazvo vakafamba mberi kwavaprista vairidza hwamanda, navarindi veshure vakatevera areka. Nguva yose iyi hwamanda dzairira.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.9",
            "verseOrgIds": [
              "JOS.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Joshua akanga arayira vanhu achiti, \"Musadanidzira, musasimudzira manzwi enyu, musamboti bufu kusvikira zuva randinokuudzai kuti mudanidzire, ipapo ndipo pamunozodanidzira!\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.10",
            "verseOrgIds": [
              "JOS.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo akarayira kuti areka yaJehovha itakurwe ipoterere guta, iripoterere kamwe chete. Ipapo vanhu vakadzokera kumisasa vakararako.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.11",
            "verseOrgIds": [
              "JOS.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joshua akamuka rungwanangwana zuva raitevera vaprista ndokutakura areka yaJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.12",
            "verseOrgIds": [
              "JOS.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaprista vanomwe vakatakura hwamanda nomwe vakaenda pamberi, vakafamba pamberi peareka yaJehovha vachiridza hwamanda. Varume vakanga vakatakura zvombo zvokurwa nazvo vakavatungamirira uye varindi veshure vakatevera areka yaJehovha, hwamanda dzichingoridzwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.13",
            "verseOrgIds": [
              "JOS.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo pazuva rechipiri vakafamba vachipoteredza guta kamwe chete vakadzokera kumisasa. Vakaita izvi kwamazuva matanhatu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.14",
            "verseOrgIds": [
              "JOS.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva rechinomwe, vakamuka mambakwedza vakafamba vachipoteredza guta kanomwe nenzira imwe chete, asi musi uyu vakapoterera guta kanomwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.15",
            "verseOrgIds": [
              "JOS.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva yechinomwe, vaprista pavakaridza hwamanda, Joshua akarayira vanhu achiti, \"Danidzirai! Nokuti Jehovha akupai guta!",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.16",
            "verseOrgIds": [
              "JOS.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guta nezvose zviri mariri rinofanira kupiwa kuna Jehovha. Asi Rahabhi chifeve bedzi navose vaainavo mumba make ndivo vachasiyiwa, nokuti akavanza vasori vatakatuma.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.17",
            "verseOrgIds": [
              "JOS.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi imi musaswedera pazvinhu zvakatukwa, kuti murege kuzviunzira kuparara, nokutora kana chimwe chazvo. Dzimwe nguva mungaunza kuparara pamusasa weIsraeri mukaipinza padambudziko.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.18",
            "verseOrgIds": [
              "JOS.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sirivha yose negoridhe nemidziyo yendarira neyesimbi zvakatsaurirwa Jehovha uye zvinofanira kuiswa munochengeterwa pfuma yake.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.19",
            "verseOrgIds": [
              "JOS.6.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hwamanda padzakarira, vanhu vakadanidzira, uye pakurira kwehwamanda, vanhu pavakadanidzira zvikuru, rusvingo rwakakoromoka; naizvozvo murume mumwe nomumwe akamhanya achipinda napakanga pakanangana naye, vachibva vatora guta.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.20",
            "verseOrgIds": [
              "JOS.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakapa guta kuna Jehovha kuti riparadzwe nomunondo, chipi nechipi chairarama mariri, varume navakadzi, vaduku navakuru, mombe, makwai nembongoro.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.21",
            "verseOrgIds": [
              "JOS.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joshua akati kuvarume vaviri vakanga vasora nyika, \"Pindai mumba mechifeve mumubudise iye navose vokwake, sezvamakapika kwaari.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.22",
            "verseOrgIds": [
              "JOS.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo majaya akanga asora akapindamo akabudisa Rahabhi, baba vake namai vake nehanzvadzi dzake navose vokwake. Vakabudisa mhuri yose vakavaisa kunze kwomusasa weIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.23",
            "verseOrgIds": [
              "JOS.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vakabva vapisa guta rose nazvose zvaiva mariri, asi vakaisa sirivha negoridhe nemidziyo yendarira neyesimbi munochengeterwa pfuma yemba yaJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.24",
            "verseOrgIds": [
              "JOS.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Joshua akasiya Rahabhi chifeve, nemhuri yake navose vokwake, nokuti akanga avanza varume vakatumwa naJoshua savasori kuJeriko, uye agere pakati pavaIsraeri nanhasi uno.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.25",
            "verseOrgIds": [
              "JOS.6.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva iyoyo Joshua akareva mhiko iyi achiti, \"Ngaatukwe pamberi paJehovha munhu achazoedza kuvakazve guta iri Jeriko:",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.26",
            "verseOrgIds": [
              "JOS.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOS 6:26"
      },
      "items": [
        {
          "text": "\"Acharasikirwa nomwanakomana wake",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.26",
            "verseOrgIds": [
              "JOS.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOS 6:26"
      },
      "items": [
        {
          "text": "wedangwe paachaisa nheyo dzaro;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.26",
            "verseOrgIds": [
              "JOS.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOS 6:26"
      },
      "items": [
        {
          "text": "acharasikirwa negotwe rake",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.26",
            "verseOrgIds": [
              "JOS.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOS 6:26"
      },
      "items": [
        {
          "text": "paachamisa masuo aro.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.26",
            "verseOrgIds": [
              "JOS.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo Jehovha akava naJoshua, mbiri yake ikapararira nenyika yose.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.27",
            "verseOrgIds": [
              "JOS.6.27"
            ]
          }
        }
      ]
    }
  ],
