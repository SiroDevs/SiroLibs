  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "2CH 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Joashi anogadziridza Temberi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joashi akanga ane makore manomwe paakava mambo, uye akatonga muJerusarema kwamakore makumi mana. Mai vake vainzi Zibhia uye vaibva kuBheerishebha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.1",
            "verseOrgIds": [
              "2CH.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joashi akaita zvakanga zvakanaka pamberi paJehovha pamazuva ose aJehoyadha muprista.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.2",
            "verseOrgIds": [
              "2CH.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoyadha akamusarudzira vakadzi vaviri uye akava navanakomana navanasikana.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.3",
            "verseOrgIds": [
              "2CH.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwapera kanguva Joashi akafunga kuti avandudze temberi yaJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.4",
            "verseOrgIds": [
              "2CH.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaunganidza vaprista navaRevhi akati kwavari, \"Endai kumaguta eJudha mundotora mari inofanira kupiwa gore negore kubva kuIsraeri, yokugadziridza nayo temberi yaMwari wenyu. Zviitei iye zvino.\" Asi vaRevhi havana kubva vazviita ipapo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.5",
            "verseOrgIds": [
              "2CH.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo mambo akadaidza Jehoyadha muprista mukuru akati kwaari, \"Sei usina kutuma vaRevhi kuti vauyise kubva kuJudha neJerusarema mutero wakarayirwa naMozisi muranda waJehovha neungano yeIsraeri weTende reChipupuriro?\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.6",
            "verseOrgIds": [
              "2CH.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino vanakomana vaAtaria mukadzi uya akaipa vakanga vamanikidzira kupinda mutemberi yaMwari uye vakanga vashandisa kunyange midziyo yayo inoera mukunamata Bhaari.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.7",
            "verseOrgIds": [
              "2CH.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akati arayira, bhokisi rakagadzirwa rikaiswa pasuo retemberi yaJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.8",
            "verseOrgIds": [
              "2CH.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shoko rakatumwa muJudha neJerusarema kuti vaifanira kuuyisa kuna Jehovha mutero wakanga warayirwa naMozisi muranda waMwari kuti vaIsraeri vape murenje.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.9",
            "verseOrgIds": [
              "2CH.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Machinda ose navanhu vose vakauyisa zvipo zvavo nomufaro, vakazvikanda mubhokisi kusvikira razara.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.10",
            "verseOrgIds": [
              "2CH.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pose paitakurwa bhokisi richipinzwa mukati navaRevhi kumachinda amambo, uye pavaiona kuti maiva nemari yakawanda, munyori wamambo nomubati womuprista mukuru vaiuya vodurura mari kubva mubhokisi riya voridzorera panzvimbo yaro. Vakaita izvi nguva nenguva uye vakaunganidza mari yakawanda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.11",
            "verseOrgIds": [
              "2CH.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo naJehoyadha akaipa kuvanhu vaizoita basa raidiwa patemberi yaJehovha. Vakaripira vavezi vamatombo navavezi vamatanda kuti vamise pakare temberi yaJehovha, uyewo vapfuri vesimbi nendarira kuti vagadziridze temberi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.12",
            "verseOrgIds": [
              "2CH.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume vaibata basa iri vaiva nounyanzvi uye kugadziridza kwose kwakaenderera mberi mumaoko avo. Vakavakazve temberi yaMwari sezvayakanga yakaita pakutanga, vakaisimbisa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.13",
            "verseOrgIds": [
              "2CH.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pavakapedza vakauyisa imwe mari yose yakanga yasara kuna mambo naJehoyadha, uye yakagadziriswa midziyo yomutemberi yaJehovha: midziyo yokushandisa neyezvipiriso zvinopiswa namadhishi nezvimwe zvegoridhe nesirivha. Jehoyadha paakanga achiri mupenyu, zvipiriso zvinopiswa zvaitopiwa nguva nenguva mutemberi yaJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.14",
            "verseOrgIds": [
              "2CH.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Jehoyadha akanga akura ava namakore mazhinji, uye akafa ava namakore zana namakumi matatu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.15",
            "verseOrgIds": [
              "2CH.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akavigwa namadzimambo muGuta raDhavhidhi, nokuda kwezvakanaka zvaakanga aitira Mwari muIsraeri nomutemberi yake.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.16",
            "verseOrgIds": [
              "2CH.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuipa kwaJoashi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushure mokufa kwaJehoyadha, vakuru veJudha vakauya kuzopa rukudzo kuna mambo, uye akateerera kwavari.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.17",
            "verseOrgIds": [
              "2CH.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakasiya temberi yaJehovha, Mwari wamadzibaba avo, vakanamata matanda aAshera nezvifananidzo. Nokuda kwokutadza kwavo, kutsamwa kwaMwari kwakauya pamusoro peJudha neJerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.18",
            "verseOrgIds": [
              "2CH.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvazvo Jehovha akatumira vaprofita kuvanhu kuti vavadzosere kwaari, uye kunyange vaipupura zvakaipa nezvavo, havana kuteerera.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.19",
            "verseOrgIds": [
              "2CH.24.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mweya waJehovha wakauya pana Zekaria, mwanakomana waJehoyadha muprista. Akamira pamberi pavanhu akati, \"Zvanzi naMwari, 'Sei musingateereri mirayiro yaJehovha? Hamusi kuzobudirira. Nokuti makasiya Jehovha, iye akusiyaiwo.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.20",
            "verseOrgIds": [
              "2CH.24.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi ivo vakamupandukira uye nokurayira kwaMambo vakamutaka namabwe kusvikira afa, muchivanze chetemberi yaJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.21",
            "verseOrgIds": [
              "2CH.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo Joashi haana kurangarira tsitsi dzaJehoyadha baba vaZekaria dzavakanga vamuratidza, asi akauraya mwanakomana wake, uye iye paakanga ava kufa akati, \"Jehovha ngaazvione izvi uye aite kuti muzvidavirire.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.22",
            "verseOrgIds": [
              "2CH.24.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakupera kwegore hondo yeAramu yakauya kuzorwisa Joashi; yakapamba Judha neJerusarema uye ikauraya vatungamiri vose vavanhu. Vakatumira zvavakanga vapamba zvose kuna mambo wavo kuDhamasiko.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.23",
            "verseOrgIds": [
              "2CH.24.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvazvo hondo yavaAramu yakanga ine varume vashoma shoma, Jehovha akaisa hondo huru kwazvo mumaoko avo. Nokuti Judha yakanga yarasa Jehovha, Mwari wamadzibaba avo, kutongwa kwakaiswa pamusoro paJoashi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.24",
            "verseOrgIds": [
              "2CH.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaAramu pavakazodzokera shure vakasiya Joashi akuvara zvakanyanya. Machinda ake akarangana akamupa mhosva yokuuraya mwanakomana waJehoyadha muprista, vakamuuraya akarara panhoo yake. Saka akafa akavigwa muGuta raDhavhidhi, asi kwete mumakuva amadzimambo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.25",
            "verseOrgIds": [
              "2CH.24.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 24:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avo vakarangana pamusoro pake vaiti Zabhadhi mwanakomana waShimeati, mudzimai wechiAmoni, naJehozabhadhi, mwanakomana waShimiriti muMoabhu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.26",
            "verseOrgIds": [
              "2CH.24.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nhoroondo dzavanakomana vake, nezvakaprofitwa pamusoro pake nezvakanyorwa pamusoro pokuvandudzwa kwetemberi yaMwari zvakanyorwa mubhuku renhoroondo dzamadzimambo. Uye Amazia mwanakomana wake akamutevera paumambo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.27",
            "verseOrgIds": [
              "2CH.24.27"
            ]
          }
        }
      ]
    }
  ],
