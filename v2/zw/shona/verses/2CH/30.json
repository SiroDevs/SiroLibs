  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "2CH 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hezekia anopemberera Pasika",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia akatuma shoko kuIsraeri yose neJudha yose akanyorera tsamba Efuremu neManase achivakoka kuti vauye kutemberi yaJehovha muJerusarema uye vazopemberera Pasika kuna Jehovha, Mwari weIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.1",
            "verseOrgIds": [
              "2CH.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo namakurukota ake neungano yose muJerusarema vakasarudza kupemberera Pasika mumwedzi wechipiri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.2",
            "verseOrgIds": [
              "2CH.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakanga vasina kukwanisa kutamba mutambo uyu panguva yaunositambwa nokuti vaprista vakanga vazvinatsa vakanga vari vashoma uye vanhu vakanga vasina kuungana muJerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.3",
            "verseOrgIds": [
              "2CH.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zano iri rakaita serakanaka kuna Mambo nokuungano yose.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.4",
            "verseOrgIds": [
              "2CH.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakasarudza kutuma shoko kuIsraeri yose kubva Bheerishebha kusvika kuDhani, vachidaidza vanhu kuti vauye kuJerusarema vazopemberera Jehovha Mwari weIsraeri mutambo wePasika. Haina kunge yambopembererwa navanhu vazhinji sezvakanga zvakanyorwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.5",
            "verseOrgIds": [
              "2CH.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sokurayira kwamambo, vanhu vakaenda muJudha neIsraeri netsamba dzaibva kuna Mambo nokumakurukota ake dzaiti:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.6",
            "verseOrgIds": [
              "2CH.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "2CH 30:6"
      },
      "items": [
        {
          "text": "\"Vanhu veIsraeri, dzokerai kuna Jehovha Mwari waAbhurahama, Isaka naIsraeri kuti adzokere kwamuri imi masara, imi makapunyuka kubva muruoko rwamadzimambo eAsiria.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.6",
            "verseOrgIds": [
              "2CH.30.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musaita samadzibaba enyu nehama dzenyu vakanga vasina kutendeka kuna Jehovha, Mwari wamadzibaba avo, zvokuti akavaita chakatukwa sezvamunoona.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.7",
            "verseOrgIds": [
              "2CH.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musaomesa mitsipa sezvakaita madzibaba enyu. Zviisei pasi paJehovha. Uyai kunzvimbo tsvene yaakatsaura nokusingaperi. Shandirai Jehovha Mwari wenyu, kuti hasha dzake dzinotyisa dzibve kwamuri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.8",
            "verseOrgIds": [
              "2CH.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana mukadzokera kuna Jehovha, ipapo hama dzenyu navana venyu vachanzwirwa tsitsi nevakavatapa uye vachadzoka kunyika ino, nokuti Jehovha Mwari wenyu ane nyasha netsitsi. Haangavanzi chiso chake kwamuri kana mukadzokazve kwaari.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.9",
            "verseOrgIds": [
              "2CH.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakatumwa vakaenda kuguta neguta muEfuremu neManase, kusvikira kuZebhuruni, asi vanhu vakavashora uye vakavaseka.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.10",
            "verseOrgIds": [
              "2CH.30.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvakadaro, vamwe varume veAsheri, Manase neZebhuruni vakazvininipisa vakaenda kuJerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.11",
            "verseOrgIds": [
              "2CH.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye muJudha ruoko rwaMwari rwakanga rwuri pavanhu kuti ruvape kubatana kwepfungwa kuti vaite zvakanga zvarayirwa namambo namachinda ake vachitevera shoko raJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.12",
            "verseOrgIds": [
              "2CH.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vazhinji zhinji vakaungana muJerusarema kuti vazopemberera Mutambo weChingwa Chisina Mbiriso mumwedzi wechipiri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.13",
            "verseOrgIds": [
              "2CH.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakabvisa aritari muJerusarema vakaparadza aritari dzezvinonhuhwira vakadzikanda muMupata weKidhironi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.14",
            "verseOrgIds": [
              "2CH.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakauraya gwayana rechibayiro chePasika pazuva regumi neina romwedzi wechipiri. Vaprista navaRevhi vakanyara kwazvo vakazvinatsa vakauyisa zvipiriso zvinopiswa kutemberi yaJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.15",
            "verseOrgIds": [
              "2CH.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vakatora nzvimbo dzavo sezvazvakanyorwa muMurayiro waMozisi munhu waMwari. Vaprista vakasasa ropa ravakapiwa navaRevhi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.16",
            "verseOrgIds": [
              "2CH.30.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sezvo vazhinji muungano vakanga vasina kuzvinatsa, vaRevhi vakauraya makwayana ePasika vachiitira vose vakanga vasina kucheneswa uye vasingakwanisi kunatsa makwayana avo kuna Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.17",
            "verseOrgIds": [
              "2CH.30.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange vazhinji, pakati pavanhu ava vakabva kuEfuremu, Manase, Isakari neZebhuruni vakanga vasina kuzvichenesa, vakadya Pasika, zvichipikisana nezvakanga zvakanyorwa. Asi Hezekia akavanyengeterera achiti, \"Jehovha, iye akanaka, ngaaregerere hake munhu wose",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.18",
            "verseOrgIds": [
              "2CH.30.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "anoisa mwoyo wake mukutsvaka Mwari, Jehovha Mwari wamadzibaba ake kunyange zvake asina kucheneswa kana tichitevedza mitemo yapanzvimbo tsvene.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.19",
            "verseOrgIds": [
              "2CH.30.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Jehovha akanzwa Hezekia akaporesa vanhu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.20",
            "verseOrgIds": [
              "2CH.30.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaIsraeri vaiva muJerusarema vakatamba Mutambo weChingwa Chisina Mbiriso kwamazuva manomwe nokufara kukuru, vaRevhi navaprista vachiimbira Jehovha zuva nezuva, pamwe chete nezviridzwa zvaJehovha zvokurumbidza.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.21",
            "verseOrgIds": [
              "2CH.30.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia akataura achikurudzira kwazvo vaRevhi vose, avo vakaratidza kunzwisisa kwakanaka kwebasa raJehovha. Kwamazuva manomwe aya vakadya zvokudya zvavakanga vapiwa, vakapa zvipiriso uye vakarumbidza Jehovha Mwari wamadzibaba avo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.22",
            "verseOrgIds": [
              "2CH.30.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 30:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ungano yose yakabvumirana kutamba mutambo uyu kwamamwe mazuva manomwe; saka kwamamwe mazuva manomwe vakapemberera vachifara.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.23",
            "verseOrgIds": [
              "2CH.30.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia mambo weJudha akapa hando chiuru namakwai nembudzi zviuru zvinomwe kuungano uye machinda ake akapa hando chiuru namakwai nembudzi zviuru gumi. Vaprista vazhinji vakazvinatsa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.24",
            "verseOrgIds": [
              "2CH.30.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungano yose yeJudha yakafara kwazvo, pamwe chete navaprista navaRevhi uye vose vakanga vaungana kubva kuIsraeri pamwe chete navatorwa vakanga vabva kuIsraeri naavo vaigara muJudha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.25",
            "verseOrgIds": [
              "2CH.30.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakava nomufaro mukuru kwazvo muJerusarema, nokuti kubva pamazuva aSoromoni mwanakomana waDhavhidhi mambo weIsraeri kwakanga kusina kumboitika zvakaita sezvizvi muJerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.26",
            "verseOrgIds": [
              "2CH.30.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 30:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaprista navaRevhi vakamira kuti varopafadze vanhu, Mwari akavanzwa, nokuti munyengetero wavo wakasvika kudenga, nzvimbo yake tsvene yokugara.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.27",
            "verseOrgIds": [
              "2CH.30.27"
            ]
          }
        }
      ]
    }
  ],
