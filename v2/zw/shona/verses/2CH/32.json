              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia ndiye akavhara mvura yaibuda muchitubu chepaGihoni ichiyerera nokumusoro akaivhurira kuti iende nezasi kumavirazuva kweGuta raDhavhidhi. Akabudirira mune zvose zvaiita.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.30",
            "verseOrgIds": [
              "2CH.32.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi pakatumwa nhume navatongi veBhabhironi kuti vamubvunze pamusoro pechiratidzo chechishamiso chakanga chaitika munyika, Mwari akamusiya kuti amuedze uye kuti azive zvose zvaiva mumwoyo make.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.31",
            "verseOrgIds": [
              "2CH.32.31"
            ]
          }
        }
      ]
    },
    {
