              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvimwe zvakaitwa naHezekia panguva yokutonga kwake zvakanyorwa muchiratidzo chomuprofita Isaya mwanakomana waAmozi mubhuku ramadzimambo eJudha neIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.32",
            "verseOrgIds": [
              "2CH.32.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 32:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia akazorora namadzibaba ake akavigwa pachikomo pane makuva ezvizvarwa zvaDhavhidhi. Judha yose navanhu veJerusarema vakamuremekedza paakafa. Uye mwanakomana wake Manase akamutevera paumambo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.33",
            "verseOrgIds": [
              "2CH.32.33"
            ]
          }
        }
