        },
        {
          "text": "Mamwe mabasa okutonga kwaSoromoni kubva kwokutanga kusvika kwokupedzisira, haana kunyorwa here mubhuku renhoroondo yomuprofita Natani, mashoko akaprofitwa naAhija muShironi nomuzviratidzo zvaIdho muoni pamusoro paJerobhoamu mwanakomana waNebhati?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.29",
            "verseOrgIds": [
              "2CH.9.29"
            ]
          }
        },
