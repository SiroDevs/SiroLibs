              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soromoni akatonga muJerusarema pamusoro peIsraeri yose kwamakore makumi mana.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.30",
            "verseOrgIds": [
