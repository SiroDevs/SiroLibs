  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "JDG 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jefuta muGireadhi, akanga ari murwi ane simba. Baba vake vainzi Gireadhi; mai vake vakanga vari chifeve.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.1",
            "verseOrgIds": [
              "JDG.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukadzi waGireadhi akamuberekerawo vanakomana, uye vakati vakura, vakadzinga Jefuta. Vakati, \"Iwe hauna nhaka ipi zvayo yauchawana mumhuri yedu, nokuti uri mwanakomana womumwe mukadzi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.2",
            "verseOrgIds": [
              "JDG.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Jefuta akatiza kubva pavanunʼuna vake akandogara munyika yeTobhi, uko kwaakandounganirwa navarume vakaipa uye vakamutevera.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.3",
            "verseOrgIds": [
              "JDG.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushure menguva yakati kuti, vaAmoni vakarwa navaIsraeri,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.4",
            "verseOrgIds": [
              "JDG.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakuru veGireadhi vakaenda kundotora Jefuta kubva kunyika yeTobhi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.5",
            "verseOrgIds": [
              "JDG.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati, \"Uya uzova mutungamiri wehondo, kuti tigorwa navaAmoni.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.6",
            "verseOrgIds": [
              "JDG.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jefuta akati kwavari, \"Hamuna kundivenga here mukandidzinga mumba mababa vangu? Sei mava kuuya kwandiri zvino, imi mava munhamo?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.7",
            "verseOrgIds": [
              "JDG.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakuru veGireadhi vakati kwaari, \"Zvisinei hazvo, isu hedu tiri kudzokera kwamuri iye zvino; handei tose kundorwa navaAmoni, uye muchava mukuru wedu pamusoro pavose vagere muGireadhi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.8",
            "verseOrgIds": [
              "JDG.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jefuta akapindura akati, \"Ngatimboti madzokera neni kundorwa navaAmoni uye Jehovha akavapa kwandiri, ndichava mukuru wenyu zvechokwadi here?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.9",
            "verseOrgIds": [
              "JDG.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakuru veGireadhi vakapindura vakati, \"Jehovha ndiye chapupu chedu; zvirokwazvo tichaita sezvaunoreva.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.10",
            "verseOrgIds": [
              "JDG.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Jefuta akaenda navakuru veGireadhi, vanhu vakamuita mukuru wavo uye nomutungamiri wehondo. Uye akadzokorora mashoko ake ose pamberi paJehovha muMizipa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.11",
            "verseOrgIds": [
              "JDG.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jefuta akatuma nhume kuna mambo wavaAmoni nomubvunzo wokuti, \"Mhosva yamunayo nesu ndeyeiko zvamunorwisa nyika yedu?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.12",
            "verseOrgIds": [
              "JDG.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo wavaAmoni akapindura nhume dzaJefuta achiti, \"VaIsraeri pavakabuda muIjipiti, vakatora nyika yangu kubva kuArinoni kusvikira kuJabhoki, kwose nokuJorodhani. Zvino idzosei norugare.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.13",
            "verseOrgIds": [
              "JDG.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jefuta akatumazve nhume kuna mambo wavaAmoni",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.14",
            "verseOrgIds": [
              "JDG.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "achiti,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.15",
            "verseOrgIds": [
              "JDG.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "JDG 11:15"
      },
      "items": [
        {
          "text": "\"Zvanzi naJefuta: Israeri haina kutora nyika yeMoabhu kana nyika yavaAmoni.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.15",
            "verseOrgIds": [
              "JDG.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi pavakabuda muIjipiti, Israeri yakaenda nomurenje kusvikira kuGungwa Dzvuku uye nokumusoro kuKadheshi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.16",
            "verseOrgIds": [
              "JDG.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Israeri yakatuma nhume kuna mambo weEdhomu, ichiti, 'Titendereiwo kupfuura nomunyika yenyu,' asi mambo weEdhomu akaramba kunzwa. Vakatumawo nhume kuna mambo weMoabhu, naiyewo akaramba. Saka vakagara paKadheshi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.17",
            "verseOrgIds": [
              "JDG.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Shure kwaizvozvo vakafamba nomurenje, vachitenderera nyika dzeEdhomu neMoabhu, vakandodzika musasa kuno rumwe rutivi rweArinoni. Havana kupinda munyika yeMoabhu, nokuti Arinoni waiva muganhu wayo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.18",
            "verseOrgIds": [
              "JDG.11.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ipapo vaIsraeri vakatuma nhume kuna Sihoni mambo wavaAmori, akanga achitonga muHeshibhoni, akati kwaari, 'Titendereiwo kupfuura nomunyika yenyu tichienda kunzvimbo yedu.'",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.19",
            "verseOrgIds": [
              "JDG.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvakadaro, Sihoni haana kuvimba navaIsraeri kuti vapfuure nomunyika yake. Akaunganidza vanhu vake vose vakandodzika musasa paJahazi uye vakarwa navaIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.20",
            "verseOrgIds": [
              "JDG.11.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ipapo Jehovha, Mwari waIsraeri, akaisa Sihoni navanhu vake vose mumaoko avaIsraeri, uye vakavakunda. Israeri yakatora nyika yose yavaAmori vaigara munyika iyo,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.21",
            "verseOrgIds": [
              "JDG.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "vakaitapa yose kubva paArinoni kusvikira kuJabhoki uye kubva kurenje kusvikira kuJorodhani.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.22",
            "verseOrgIds": [
              "JDG.11.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zvino sezvo Jehovha, Mwari waIsraeri akadzinga vaAmori pamberi pavanhu vake Israeri, iwe une kodzero ipi yokuti uitore?",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.23",
            "verseOrgIds": [
              "JDG.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, hautori here zvaunopiwa namwari wako Kemoshi? Naizvozvo zvose zvatinopiwa naJehovha Mwari wedu, ndizvo zvatichatora.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.24",
            "verseOrgIds": [
              "JDG.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, iwe uri nani kupfuura Bharaki mwanakomana waZipori mambo weMoabhu here? Akambopopotedzana navaIsraeri kana kurwa navo here?",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.25",
            "verseOrgIds": [
              "JDG.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israeri yakagara muHeshibhoni, Aroeri, nemisha yakapoteredza uye namaguta ose akatarisana neArinoni. Wakaregereiko kuatora panguva iyoyo?",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.26",
            "verseOrgIds": [
              "JDG.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ini handina kukutadzira asi iwe ndiwe wava kundikanganisira nokuda kurwa neni. Jehovha, iye mutongi ngaatonge, ngaatonge gakava iri nhasi riri pakati pavaIsraeri navaAmoni.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.27",
            "verseOrgIds": [
              "JDG.11.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvakadaro, mambo weAmoni, haana kuteerera nhume dzaJefuta dzaakatuma.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.28",
            "verseOrgIds": [
              "JDG.11.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Mweya waJehovha wakauya pamusoro paJefuta. Akayambuka Gireadhi neManase, akapfuura napaMizipa yeGireadhi, uye kubva ipapo akafamba akandorwa navaAmoni.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.29",
            "verseOrgIds": [
              "JDG.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Jefuta akaita mhiko kuna Jehovha akati, \"Kana mukaisa vaAmoni mumaoko angu,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.30",
            "verseOrgIds": [
              "JDG.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "chose chichabuda napamukova weimba yangu kuzosangana neni pakudzoka kwangu ndakunda vaAmoni, chichava chaJehovha, uye ndichachibayira sechipiriso chinopiswa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.31",
            "verseOrgIds": [
              "JDG.11.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jefuta akabuda kundorwa navaAmoni, uye Jehovha akavapa mumaoko ake.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.32",
            "verseOrgIds": [
              "JDG.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JDG 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaparadza maguta makumi maviri kubva kuAroeri kusvikira pedyo neMiniti, akandoguma kuAbheri Keramimi. Nokudaro Israeri yakakunda Amoni.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.33",
            "verseOrgIds": [
              "JDG.11.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JDG 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jefuta akati odzokera kumusha kwake kuMizipa, ndiani akazouya kuzomuchingamidza kunze kwomwanasikana wake, achitamba, matambureni achiridzwa! Ndiye akanga achingova mwana wake oga. Akanga asina mwanakomana kana mwanasikana kunze kwake iye oga.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.34",
            "verseOrgIds": [
              "JDG.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati achimuona akabvarura nguo dzake uye akachema achiti, \"Haiwa mwanasikana wangu! Wandishungurudza nokuti ndaita mhiko kuna Jehovha yandisingagoni kuputsa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.35",
            "verseOrgIds": [
              "JDG.11.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JDG 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapindura akati, \"Baba vangu, mapa shoko renyu kuna Jehovha. Ndiitirei henyu sezvamakavimbisa, sezvo zvino Jehovha akatsivira vavengi venyu, ivo vaAmoni.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.36",
            "verseOrgIds": [
              "JDG.11.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JDG 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi nditenderei henyu chikumbiro chimwe chete ichi. Ndipei henyu mwedzi miviri kuti ndiende kuzvikomo ndinochema pamwe chete neshamwari dzangu, nokuti handichazowanikwi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.37",
            "verseOrgIds": [
              "JDG.11.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JDG 11:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye akati, \"Ungaenda hako.\" Uye akamutendera kuti aende kwemwedzi miviri. Iye navamwe vasikana vakaenda kuzvikomo vakandochema nokuti akanga asingazombowanikwi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.38",
            "verseOrgIds": [
              "JDG.11.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JDG 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwemwedzi miviri akadzoka kuna baba vake uye vakaita kwaari sezvavakanga vapika. Uye akanga ari mhandara.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.39",
            "verseOrgIds": [
              "JDG.11.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 11:39"
      },
      "items": [
        {
          "text": "Ndipo pakabva tsika yavaIsraeri",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.39",
            "verseOrgIds": [
              "JDG.11.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JDG 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "yokuti gore rimwe nerimwe, vanasikana veIsraeri vanobuda kwamazuva mana kundoita chirangaridzo chomwanasikana waJefuta muGireadhi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.40",
            "verseOrgIds": [
              "JDG.11.40"
            ]
          }
        }
      ]
    }
  ],
