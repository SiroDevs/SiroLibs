  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "JDG 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Idzi ndidzo ndudzi dzakasiyiwa naJehovha kuti aedze vaIsraeri vaya vose vakanga vasina kumboziva kana hondo ipi zvayo muKenani,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.1",
            "verseOrgIds": [
              "JDG.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "(akaita izvi bedzi kuti adzidzise zvehondo kuzvizvarwa zvavaIsraeri izvo zvakanga zvisina kumborwa hondo):",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.2",
            "verseOrgIds": [
              "JDG.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "vatongi vashanu vavaFiristia, vaKenani vose, vaSidhoni, uye vaHivhi vaigara mumakomo eRebhanoni kubva paGomo reBhaari Herimoni kusvikira kuRebho Hamati.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.3",
            "verseOrgIds": [
              "JDG.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakasiyiwa kuti vaedze vaIsraeri kuti aone kana vaizoteerera mirayiro yaJehovha, yaakanga apa madzitateguru avo kubudikidza naMozisi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.4",
            "verseOrgIds": [
              "JDG.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaIsraeri vakagara pakati pavaKenani, vaHiti, vaAmori, vaPerezi, vaHivhi navaJebhusi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.5",
            "verseOrgIds": [
              "JDG.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakatora vanasikana vavo kuti vave vakadzi vavo uye vakapa vanasikana vavowo kuvanakomana vavo, uye vakashumira vamwari vavo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.6",
            "verseOrgIds": [
              "JDG.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Otinieri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaIsraeri vakaita zvakaipa pamberi paJehovha; vakakanganwa Jehovha Mwari wavo vakashumira vaBhaari navaAshera.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.7",
            "verseOrgIds": [
              "JDG.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutsamwa kwaJehovha kwakapisa pamusoro paIsraeri zvokuti akavatengesa mumaoko aKushani-Rishataimi mambo weAramu Naharaimu, avo vakashandirwa navaIsraeri kwamakore masere.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.8",
            "verseOrgIds": [
              "JDG.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vakati vachema kuna Jehovha, akavamutsira musununguri, Otinieri mwanakomana waKenazi, mununʼuna waKarebhu, uyo akavaponesa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.9",
            "verseOrgIds": [
              "JDG.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mweya waJehovha wakauya pamusoro pake kuti ave mutongi weIsraeri uye akaenda kuhondo. Jehovha akaisa Kushani-Rishataimi mambo wavaAramu mumaoko aOtinieri, akamukunda.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.10",
            "verseOrgIds": [
              "JDG.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka nyika yakava norugare kwamakore makumi mana, kusvikira Otinieri mwanakomana waKenazi afa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.11",
            "verseOrgIds": [
              "JDG.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ehudhi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaIsraeri vakaitazve zvakaipa pamberi paJehovha, uye nokuda kwokuti vakaita zvakaipa izvi, Jehovha akapa simba kuna Egironi mambo weMoabhu kuti akunde Israeri.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.12",
            "verseOrgIds": [
              "JDG.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egironi akatora vaAmoni navaAmareki kuti vaende naye kundorwisa Israeri, uye vakatora Guta reMichindwe kuti rive ravo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.13",
            "verseOrgIds": [
              "JDG.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaIsraeri vakava varanda vaEgironi mambo weMoabhu kwamakore gumi namasere.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.14",
            "verseOrgIds": [
              "JDG.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaIsraeri vakachemazve kuna Jehovha, iye akavapa musununguri, Ehudhi murume aiva neziboshwe, mwanakomana waGera muBhenjamini. VaIsraeri vakamutuma nomutero kuna Egironi mambo weMoabhu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.15",
            "verseOrgIds": [
              "JDG.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Ehudhi akanga aita munondo wakarodzwa kumativi ose uchikarosvika kubhiti rimwe chete",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.16",
            "verseOrgIds": [
              "JDG.3.16"
            ]
          }
        },
        {
          "text": "pakureba kwawo waakanga akasungira pasi penguo dzake pachidya chake chokurudyi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.16",
            "verseOrgIds": [
              "JDG.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapa mutero kuna Egironi mambo weMoabhu, murume akanga akafuta kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.17",
            "verseOrgIds": [
              "JDG.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushure mokunge Ehudhi apa mutero, akati vanhu vakanga vauya vakatakura mutero wacho vaende.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.18",
            "verseOrgIds": [
              "JDG.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazvifananidzo zvaiva pedyo neGirigari iye pachake akadzoka akati, \"Ndine shoko renyu rakavanzika, imi mambo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.19",
            "verseOrgIds": [
              "JDG.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 3:19"
      },
      "items": [
        {
          "text": "Mambo akati, \"Nyararai!\" uye varanda vake vose vakamusiya.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.19",
            "verseOrgIds": [
              "JDG.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Ehudhi akaswedera kwaari iye agere ari oga muimba yake yapamusoro yomuzinda wake wenguva yezhizha akati, \"Ndine shoko renyu rabva kuna Mwari,\" Mambo akati achisimuka achibva pachigaro chake,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.20",
            "verseOrgIds": [
              "JDG.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ehudhi akatambanudza ruoko rwake rworuboshwe, akavhomora munondo kubva pachidya chake chokurudyi akaunyudza mudumbu ramambo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.21",
            "verseOrgIds": [
              "JDG.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange chibato chomunondo chakanyura chichitevera chese, ukandobuda nokumusana kwake. Ehudhi haana kuvhomora munondo, uye mafuta akaputira pamusoro pawo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.22",
            "verseOrgIds": [
              "JDG.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Ehudhi akabuda akaenda kubiravira; akapfiga mikova yeimba yapamusoro shure kwake akaikiya.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.23",
            "verseOrgIds": [
              "JDG.3.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushure mokuenda kwake, varanda vakasvika vakawana mikova yeimba yapamusoro yakiyiwa. Ivo vakati, \"Anofanira kunge achimbozvizorodza zvake ari mukamuri romukati reimba.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.24",
            "verseOrgIds": [
              "JDG.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakarindira kusvikira vanyadziswa nazvo asi paakarega kuzarura mikova yekamuri, vakatora kiyi vakaikiyinura. Onei ipapo ishe wavo akawira pasi, afa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.25",
            "verseOrgIds": [
              "JDG.3.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vachakamirira, Ehudhi akaenda. Akapfuura napazvifananidzo akapunyuka akaenda kuSeira.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.26",
            "verseOrgIds": [
              "JDG.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati asvika ikoko, akaridza hwamanda ari munyika yezvikomo yaEfuremu, uye vaIsraeri vakaburuka naye vachibva kuzvikomo, iye achivatungamirira.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.27",
            "verseOrgIds": [
              "JDG.3.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati kwavari, \"Nditeverei, nokuti Jehovha aisa Moabhu muvengi wenyu, mumaoko enyu.\" Saka vakaburuka vakamutevera, uye vakatora mazambuko eJorodhani okuenda kuMoabhu, vakasatendera munhu kuyambuka.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.28",
            "verseOrgIds": [
              "JDG.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva iyoyo vakauraya zviuru zvinenge gumi zvavaMoabhu, vose vakanga vakagwinya uye vane simba; hapana akapunyuka.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.29",
            "verseOrgIds": [
              "JDG.3.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zuva iroro Moabhu yakava pasi peIsraeri, uye nyika yakava norugare kwamakore makumi masere.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.30",
            "verseOrgIds": [
              "JDG.3.30"
            ]
          }
