  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "JDG 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kutsiva kwaSamusoni pavaFiristia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushure mechinguva, panguva yokukohwa gorosi, Samusoni akatora mbudzana akaenda kundoshanyira mukadzi wake. Akati, \"Ndinoda kupinda mumba nomukadzi wangu.\" Asi baba vomukadzi wake havana kumutendera kupinda.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.1",
            "verseOrgIds": [
              "JDG.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baba vomukadzi wake vakati, \"Ndakanga ndine chokwadi chaizvo kuti unomuvenga kwazvo zvokuti ndakamupa kushamwari yako. Ko, mununʼuna wake haana kunaka kukunda iye here? Chimutora iye panzvimbo yake.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.2",
            "verseOrgIds": [
              "JDG.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samusoni akati kwaari, \"Panguva ino ndine mvumo yokuti nditsive kuvaFiristia; ndichavaitira zvakaipa chaizvo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.3",
            "verseOrgIds": [
              "JDG.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka akabuda akandobata makava mazana matatu akaasunganidza miswe yawo achiita maviri maviri. Ipapo akaisa zhenje pakati pemiswe miviri miviri yacho.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.4",
            "verseOrgIds": [
              "JDG.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatungidza mazhenje akaregedza makava akapinda muzviyo zvavaFiristia zvakanga zvimire. Akapisa zviyo zvakanga zvakohwewa nezvakanga zvimire mumunda, pamwe chete neminda yemizambiringa neyemiorivhi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.5",
            "verseOrgIds": [
              "JDG.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaFiristia pavakabvunza kuti, \"Ndianiko aita izvi?\" vakaudzwa kuti, \"NdiSamusoni, mukuwasha womuTimina, nemhaka yokuti mukadzi wake akapiwa kushamwari yake.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.6",
            "verseOrgIds": [
              "JDG.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 15:6"
      },
      "items": [
        {
          "text": "Saka vaFiristia vakaenda vakandomupisa iye nababa vake vakafa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.6",
            "verseOrgIds": [
              "JDG.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samusoni akati kwavari, \"Sezvo maita kudai, ini handitombomiri kusvikira ndakutsivai.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.7",
            "verseOrgIds": [
              "JDG.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akavarwisa zvakasimba uye akauraya vazhinji vavo. Ipapo akaburuka akandogara mubako redombo reEtami.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.8",
            "verseOrgIds": [
              "JDG.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaFiristia vakakwidza vakandodzika musasa wavo muJudha, vakapararira kusvika pedyo neRehi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.9",
            "verseOrgIds": [
              "JDG.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume veJudha vakavabvunza vakati, \"Mauyireiko kuzorwa nesu?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.10",
            "verseOrgIds": [
              "JDG.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 15:10"
      },
      "items": [
        {
          "text": "Ivo vakapindura vakati, \"Tauya kuzotora Samusoni kuti ave musungwa, uye kuti tiite kwaari zvaakatiitira isu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.10",
            "verseOrgIds": [
              "JDG.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo varume zviuru zvitatu vaibva kuJudha vakaburuka kubako reEtami vakandoti kuna Samusoni, \"Ko, haunzwi here kuti vaFiristia vanotitonga? Chiiko chawatiitira?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.11",
            "verseOrgIds": [
              "JDG.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 15:11"
      },
      "items": [
        {
          "text": "Akapindura akati, \"Ndakangovaitira zvavakandiitira.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.11",
            "verseOrgIds": [
              "JDG.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivo vakati kwaari, \"Tauya kuzokusunga kuti tikuise kuvaFiristia.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.12",
            "verseOrgIds": [
              "JDG.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 15:12"
      },
      "items": [
        {
          "text": "Samusoni akati, \"Pikai kwandiri kuti imi hamundiurayi pachenyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.12",
            "verseOrgIds": [
              "JDG.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivo vakati, \"Hongu, isu tichangokusunga bedzi tigokuisa mumaoko avo. Hatikuurayi isu.\" Saka vakamusunga namabote matsva maviri vakamutungamirira kuruware.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.13",
            "verseOrgIds": [
              "JDG.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati aswedera kuRehi, vaFiristia vakauya kwaari vachidanidzira. Mweya waJehovha wakauya paari nesimba. Mabote akanga ari mumaoko ake akaita sorushinda, uye zvisungo zvikadonha mumaoko ake.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.14",
            "verseOrgIds": [
              "JDG.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akawana rushaya rutsva rwembongoro, akarubata akauraya varume chiuru.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.15",
            "verseOrgIds": [
              "JDG.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Samusoni akati,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.16",
            "verseOrgIds": [
              "JDG.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JDG 15:16"
      },
      "items": [
        {
          "text": "\"Norushaya rwembongoro",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.16",
            "verseOrgIds": [
              "JDG.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JDG 15:16"
      },
      "items": [
        {
          "text": "ndavaita mbongoro.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.16",
            "verseOrgIds": [
              "JDG.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JDG 15:16"
      },
      "items": [
        {
          "text": "Norushaya rwembongoro",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.16",
            "verseOrgIds": [
              "JDG.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JDG 15:16"
      },
      "items": [
        {
          "text": "ndauraya varume chiuru.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.16",
            "verseOrgIds": [
              "JDG.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati apedza kutaura, akakanda rushaya kure; uye nzvimbo iyoyo ikanzi Ramati Rehi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.17",
            "verseOrgIds": [
              "JDG.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti akanga ava nenyota chaizvo, akadanidzira kuna Jehovha akati, \"Mapa muranda wenyu kukunda kukuru. Zvino ndofira pano nenyota here ndigowira mumaoko avasina kudzingiswa?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.18",
            "verseOrgIds": [
              "JDG.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Mwari akazarura mukaha muRehi, mvura ikabuda mauri. Samusoni akati anwa, simba rake rakadzoka maari uye akamutsiridzwazve. Saka tsime iro rakanzi Eni Hakore, uye richirimo muRehi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.19",
            "verseOrgIds": [
              "JDG.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samusoni akatungamirira vaIsraeri kwamakore makumi maviri mumazuva avaFiristia.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.20",
            "verseOrgIds": [
              "JDG.15.20"
            ]
          }
        }
      ]
    }
  ],
