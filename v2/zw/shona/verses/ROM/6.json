{
  "id": "ROM.6",
  "number": "6",
  "bookId": "ROM",
  "reference": "VaRoma 6",
  "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "ROM 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kufa kuchivi, kuva mupenyu muna Kristu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino tichatiiko? Toramba tichiita zvivi here kuti nyasha dziwande?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.1",
            "verseOrgIds": [
              "ROM.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwete napaduku pose! Takafa kuzvivi; tingararama sei mazviri zvakare?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.2",
            "verseOrgIds": [
              "ROM.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, hamuzivi here kuti isu tose vaya vakabhabhatidzwa muna Kristu Jesu takabhabhatidzwa murufu rwake?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.3",
            "verseOrgIds": [
              "ROM.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo takavigwa naye kubudikidza nokubhabhatidzwa murufu kuitira kuti, sokumutswa kwakaitwa Kristu kubva kuvakafa nokubwinya kwaBaba, nesuwo tirarame upenyu hutsva.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.4",
            "verseOrgIds": [
              "ROM.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti kana takabatanidzwa naye zvakadai murufu rwake, zvirokwazvo tichabatanawo naye mukumuka kwake.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.5",
            "verseOrgIds": [
              "ROM.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti tinoziva kuti munhu wedu wakare akarovererwa pamuchinjikwa pamwe chete naye kuti muviri wechivi ushayiswe simba, kuti tirege kuvazve varanda vechivi,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.6",
            "verseOrgIds": [
              "ROM.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti uyo anenge afa asunungurwa kubva kuchivi.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.7",
            "verseOrgIds": [
              "ROM.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino kana takafa naKristu, tinotenda kuti tichararamawo pamwe chete naye.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.8",
            "verseOrgIds": [
              "ROM.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti sezvo tichiziva kuti Kristu akamutswa kubva kuvakafa, haachazofizve; rufu harusisina simba pamusoro pake.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.9",
            "verseOrgIds": [
              "ROM.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rufu rwaakafa, akafa kuchivi kamwe chete zvikabva zvapera; asi upenyu hwaanorarama, anoraramira Mwari.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.10",
            "verseOrgIds": [
              "ROM.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenzira imwe cheteyo, nemiwo munofanira kuziva kuti makafa kuchivi, asi muri vapenyu kuna Mwari muna Kristu Jesu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.11",
            "verseOrgIds": [
              "ROM.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo musatendera chivi kuti chibate ushe mumuviri wenyu unofa, kuti muteerere kuchiva kwacho.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.12",
            "verseOrgIds": [
              "ROM.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musapa mitezo yomuviri wenyu kuchivi, kuti ive nhumbi dzokuita zvisakarurama, asi zvipei kuna Mwari, savaya vakabviswa kurufu vachiiswa kuupenyu; uye ipai mitezo yomuviri wenyu kwaari ive nhumbi dzokururama.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.13",
            "verseOrgIds": [
              "ROM.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti chivi hachichazovi nesimba pamusoro penyu, nokuti hamusi pasi pomurayiro, asi pasi penyasha.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.14",
            "verseOrgIds": [
              "ROM.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Varanda voKururama",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino tichatiiko? Titadze here nokuti hatisi pasi pomurayiro asi pasi penyasha. Kwete napaduku pose!",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.15",
            "verseOrgIds": [
              "ROM.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamuzivi here kuti kana mukazvipa kuno mumwe munhu kuti mumuteerere savaranda, muri varanda kuno uyo wamunoteerera, mungava varanda vechivi, chinoendesa kurufu kana vokuteerera, kunoendesa kukururama?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.16",
            "verseOrgIds": [
              "ROM.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Mwari ngaavongwe nokuti, kunyange zvenyu maimbova varanda vechivi, makateerera nomwoyo wenyu wose kurudzi rwedzidziso yamakanga mapiwa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.17",
            "verseOrgIds": [
              "ROM.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makasunungurwa kubva kuchivi uye mava varanda vokururama.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.18",
            "verseOrgIds": [
              "ROM.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinotaura izvi nokutaura kwavanhu nokuda kwokushayiwa simba kwenyama yenyu. Sezvamaingopa mitezo yemiviri yenyu kuuranda hwokusachena uye nokuipa kunoramba kuchingowanda, saka zvino ipei kuuranda hwokururama hunoendesa kuutsvene.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.19",
            "verseOrgIds": [
              "ROM.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamakanga muri varanda vechivi, makanga makasununguka kubva pakutonga kwakarurama.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.20",
            "verseOrgIds": [
              "ROM.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino makawaneiko panguva iyoyo kubva pazvinhu zvamunonyadziswa nazvo, iye zvino? Nokuti kuguma kwazvo ndirwo rufu!",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.21",
            "verseOrgIds": [
              "ROM.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi zvino makasunungurwa kubva kuchivi uye mava varanda vaMwari, zvibereko zvamunokohwa zvinoisa kuutsvene, uye kuguma kwazvo ndihwo upenyu husingaperi muna Kristu Jesu Ishe wedu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.22",
            "verseOrgIds": [
              "ROM.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti mubayiro wechivi ndirwo rufu, asi chipo chaMwari chokungopiwa ndihwo upenyu husingaperi muna Kristu Jesu Ishe wedu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.23",
            "verseOrgIds": [
              "ROM.6.23"
            ]
          }
        }
      ]
    }
  ],
