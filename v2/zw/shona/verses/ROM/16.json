        },
        {
          "text": "Zvino kuna iye anogona kukusimbisai nevhangeri rangu, uye nokuparidzwa kwaJesu Kristu, maererano nokuzarurwa kwechakanga chakavanzika kwamakore namakore akapfuura,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.25",
            "verseOrgIds": [
