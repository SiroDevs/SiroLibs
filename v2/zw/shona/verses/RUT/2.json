  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "RUT 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Naomi anosangana naBhoazi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "RUT 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Naomi aiva nehama yokumurume wake, aibva kuimba yaErimereki, murume akasimukira, zita rake richinzi Bhoazi.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.1",
            "verseOrgIds": [
              "RUT.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "RUT 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Rute muMoabhu akati kuna Naomi, \"Regai ndiende kuminda ndinonongera zviyo zvinosara ndiri shure kwaani zvake achandiitira nyasha.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.2",
            "verseOrgIds": [
              "RUT.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "RUT 2:2"
      },
      "items": [
        {
          "text": "Naomi akati kwaari, \"Enda hako mwanasikana wangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.2",
            "verseOrgIds": [
              "RUT.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "RUT 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo akaenda kuminda akatanga kunongera ari muminda achitevera shure kwavacheki. Zvakaitika ndezvokuti akabva angoenda kundoshanda mumunda waBhoazi, uyo aibva kuimba yaErimereki.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.3",
            "verseOrgIds": [
              "RUT.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "RUT 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva iyoyo Bhoazi akasvika achibva kuBheterehema ndokukwazisa vacheki achiti, \"Jehovha ave nemi!\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.4",
            "verseOrgIds": [
              "RUT.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "RUT 2:4"
      },
      "items": [
        {
          "text": "Ivo vakapindura vachiti, \"Jehovha akuropafadzei!\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.4",
            "verseOrgIds": [
              "RUT.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "RUT 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoazi akabvunza mutariri wavacheki akati, \"Ko, mukadzi wechidiki uyo ndewani?\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.5",
            "verseOrgIds": [
              "RUT.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "RUT 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutariri akapindura akati, \"Mukadzi wechiMoabhu akadzoka pamwe chete naNaomi vachibva kuMoabhu.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.6",
            "verseOrgIds": [
              "RUT.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "RUT 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati, 'Ndapota nditenderei kunongera ndichiunganidza pakati pezvisote ndiri mushure mavacheki.' Abva aenda mumunda akashanda nesimba kubva mangwanani kusvikira zvino, kunze kwenguva pfupi yaazorora ari mudumba iro.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.7",
            "verseOrgIds": [
              "RUT.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "RUT 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Bhoazi akati kuna Rute, \"Chinzwa, mwanasikana wangu. Usaenda kunonongera uri kuno mumwe munda uye usaenda kure uchibva pano. Gara pano navashandi vangu vechisikana ava.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.8",
            "verseOrgIds": [
              "RUT.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "RUT 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utarire munda uyo waunoona varume vachicheka, ugotevera mushure mavasikana. Ndarayira majaya kuti arege kukubata. Uye paunonzwira nyota, uende kunonwa mvura mumidziyo iyo yazadzwa namajaya.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.9",
            "verseOrgIds": [
              "RUT.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "RUT 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo, akawira pasi nechiso chake akatsikitsira pasi. Akashamisika, akati, \"Zvaita sei kuti ndiwane nyasha dzakadai pamberi penyu kuti mundione ini mutorwa?\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.10",
            "verseOrgIds": [
              "RUT.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "RUT 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoazi akapindura achiti, \"Ndakaudzwa pamusoro pezvose zvawakaitira vamwene vako kubva pakufa kwomurume wako, uye kuti wakasiya sei baba vako namai vako uye nenyika yokwako ukauya kuzogara navanhu vawakanga usingazivi.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.11",
            "verseOrgIds": [
              "RUT.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "RUT 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha ngaakuripire pane zvawakaita. Jehovha, Mwari waIsraeri, ngaakupe mubayiro uzere, iye wawakauya ukavanda pasi pamapapiro ake.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.12",
            "verseOrgIds": [
              "RUT.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "RUT 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rute akati, \"Regai ndirambe ndichiwana nyasha pamberi penyu, ishe wangu. Mandinyaradza uye mataura netsitsi kumurandakadzi wenyu kunyange ndisina kufanana navamwe varandakadzi venyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.13",
            "verseOrgIds": [
              "RUT.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "RUT 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva yokudya, Bhoazi akati kwaari, \"Uya kuno. Tora chingwa udye uchiseva muvhiniga iyi.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.14",
            "verseOrgIds": [
              "RUT.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "RUT 2:14"
      },
      "items": [
        {
          "text": "Akati agara pasi navacheki, Bhoazi akamupa zviyo zvakakangwa. Akadya zvose zvaaida zvimwe zvikasara.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.14",
            "verseOrgIds": [
              "RUT.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "RUT 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paakasimuka kuti anongere, Bhoazi akarayira majaya ake achiti, \"Kunyange akaunganidza pakati pezvisote, musamudzivisa.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.15",
            "verseOrgIds": [
              "RUT.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "RUT 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi, mumuvhomorere dzimwe tsama, kubva pamasumbu enyu mumusiyire agononga, uye musamutsiura.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.16",
            "verseOrgIds": [
              "RUT.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "RUT 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo Rute akanongera ari mumunda kusvikira manheru. Ipapo akapura bhari raakanga aunganidza, rikasvika pachiero cheefa",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.17",
            "verseOrgIds": [
              "RUT.2.17"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.17",
            "verseOrgIds": [
              "RUT.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "RUT 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaritakura akaenda naro kuguta, vamwene vake vakaona kuti akanga aunganidza zvakadini. Rute akavigirawo vamwene vake zvaakanga asiya paakanga adya akaguta.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.18",
            "verseOrgIds": [
              "RUT.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "RUT 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vamwene vake vakamubvunza vakati, \"Nhasi wanga uchinongera uri kupiko? Washandirepi? Ngaaropafadzwe murume uyo akuona.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.19",
            "verseOrgIds": [
              "RUT.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "RUT 2:19"
      },
      "items": [
        {
          "text": "Ipapo Rute akaudza vamwene vake pamusoro pomunhu akanga ari mwene wenzvimbo yaakanga achishandira. Akati kwaari, \"Zita romurume wandashanda naye nhasi ndiBhoazi.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.19",
            "verseOrgIds": [
              "RUT.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "RUT 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naomi akati kumuroora wake, \"Jehovha ngaamuropafadze! Iye asina kurega kuratidza tsitsi kuvapenyu navakafa.\" Akatizve, \"Murume iyeye ihama yedu yapedyo; mumwe wavadzikinuri vedu.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.20",
            "verseOrgIds": [
              "RUT.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "RUT 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Rute muMoabhu akati, \"Abva ati kwandiri, 'Gara navashandi vangu kusvikira vapedza kucheka zviyo zvangu zvose.' \"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.21",
            "verseOrgIds": [
              "RUT.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "RUT 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naomi akati kuna Rute muroora wake, \"Zvichava zvakanaka kwauri mwanangu, kuti uende navasikana vake, nokuti ukaenda mumunda womumwe ungazokanganiswa.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.22",
            "verseOrgIds": [
              "RUT.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "RUT 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Rute akagara pedyo navasikana vaishandira Bhoazi achinongera kusvikira kuchekwa kwegorosi nebhari kwapera. Uye iye akagara navamwene vake.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.23",
            "verseOrgIds": [
              "RUT.2.23"
            ]
          }
        }
      ]
    }
  ],
