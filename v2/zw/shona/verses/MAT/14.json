          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye pavakapinda mugwa, mhepo yakanyarara.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.32",
            "verseOrgIds": [
              "MAT.14.32"
            ]
          }
        },
        {
          "name": "verse",
