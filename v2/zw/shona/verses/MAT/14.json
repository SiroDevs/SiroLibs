              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye varume venzvimbo iyoyo vakati vamuziva, vakatumira shoko mudunhu rose rakapoteredza. Vanhu vakauya navarwere vavo vose kwaari",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.35",
