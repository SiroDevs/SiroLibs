          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vaya vaiva mugwa vakamunamata vachiti, \"Chokwadi muri Mwanakomana waMwari.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.33",
            "verseOrgIds": [
              "MAT.14.33"
            ]
          }
        }
      ]
