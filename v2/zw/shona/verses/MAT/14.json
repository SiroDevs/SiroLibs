              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuzoti vayambukira mhiri, vakaburukira paGenesareti.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.34",
            "verseOrgIds": [
