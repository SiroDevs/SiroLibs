{
  "id": "MAT.21",
  "number": "21",
  "bookId": "MAT",
  "reference": "Mateo 21",
  "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
  "verseCount": 46,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "MAT 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu Anogamuchirwa muJerusarema",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati voswedera kuJerusarema uye vasvika muBhetifage pagomo reMiorivhi, Jesu akatuma vadzidzi vaviri,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.1",
            "verseOrgIds": [
              "MAT.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "achiti kwavari, \"Endai kumusha wamakatarisana nawo uye imomo muchaona mbongoro yakasungirirwa pamwe chete nomwana wayo. Mudzisunungure muuye nadzo kwandiri.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.2",
            "verseOrgIds": [
              "MAT.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana pano munhu anotaura chinhu kwamuri, mumuudze kuti, Ishe anodzida uye achadzidzosa nokukurumidza.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.3",
            "verseOrgIds": [
              "MAT.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izvi zvakaitika kuti zvizadzise zvakataurwa kubudikidza nomuprofita achiti:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.4",
            "verseOrgIds": [
              "MAT.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Muti kuMwanasikana weZioni,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.5",
            "verseOrgIds": [
              "MAT.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 21:5"
      },
      "items": [
        {
          "text": "'Tarira, Mambo wako anouya kwauri,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.5",
            "verseOrgIds": [
              "MAT.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 21:5"
      },
      "items": [
        {
          "text": "ari munyoro, akatasva mbongoro,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.5",
            "verseOrgIds": [
              "MAT.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 21:5"
      },
      "items": [
        {
          "text": "ari pamusoro pomwana wembongoro.' \"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.5",
            "verseOrgIds": [
              "MAT.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vadzidzi vakaenda vakandoita sezvavakanga varayirwa naJesu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.6",
            "verseOrgIds": [
              "MAT.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakauya nembongoro nomwana wayo, vakaisa nguo dzavo pamusoro padzo, uye Jesu akagara pamusoro padzo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.7",
            "verseOrgIds": [
              "MAT.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vazhinji vakawarira nguo dzavo mumugwagwa, vamwewo vakatema mapazi emiti vakaawarira mumugwagwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.8",
            "verseOrgIds": [
              "MAT.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vazhinji vakanga vakatungamira mberi navaya vakanga vachitevera vakadanidzira vachiti:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.9",
            "verseOrgIds": [
              "MAT.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 21:9"
      },
      "items": [
        {
          "text": "\"Hosana kuMwanakomana waDhavhidhi!\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.9",
            "verseOrgIds": [
              "MAT.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "MAT 21:9"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 21:9"
      },
      "items": [
        {
          "text": "\"Akaropafadzwa uyo anouya muzita raIshe!\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.9",
            "verseOrgIds": [
              "MAT.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "MAT 21:9"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 21:9"
      },
      "items": [
        {
          "text": "\"Hosana kumusoro-soro!\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.9",
            "verseOrgIds": [
              "MAT.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati apinda muJerusarema, guta rose rakazungunuswa, vakabvunza vachiti, \"Ndianiko uyu?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.10",
            "verseOrgIds": [
              "MAT.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vazhinji vakati, \"Uyu ndiye Jesu, muprofita anobva kuNazareta kuGarirea.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.11",
            "verseOrgIds": [
              "MAT.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu paTemberi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akapinda munzvimbo yetemberi akadzinga vose vaitenga nokutengesa. Akapidigura tafura dzavaitsinhanha mari nezvigaro zvavaitengesa njiva.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.12",
            "verseOrgIds": [
              "MAT.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati kwavari, \"Kwakanyorwa kuchinzi, 'Imba yangu ichanzi imba yokunyengetera,' asi imi mava kuiita 'bako ramakororo.' \"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.13",
            "verseOrgIds": [
              "MAT.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mapofu navakaremara vakauya kwaari kutemberi, uye akavaporesa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.14",
            "verseOrgIds": [
              "MAT.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vaprista vakuru navadzidzisi vomurayiro pavakaona zvinhu zvinoshamisa zvaakaita, uye vana vachidanidzira mutemberi vachiti, \"Hosana kuMwanakomana waDhavhidhi,\" vakatsamwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.15",
            "verseOrgIds": [
              "MAT.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakamubvunza vachiti, \"Uri kunzwa zviri kurehwa navana ava here?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.16",
            "verseOrgIds": [
              "MAT.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 21:16"
      },
      "items": [
        {
          "text": "Jesu akavapindura achiti, \"Hongu, hamuna kurava here panoti:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.16",
            "verseOrgIds": [
              "MAT.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 21:16"
      },
      "items": [
        {
          "text": "\" 'Pamiromo yavana navacheche",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.16",
            "verseOrgIds": [
              "MAT.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 21:16"
      },
      "items": [
        {
          "text": "makaisa rumbidzo'?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.16",
            "verseOrgIds": [
              "MAT.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye akavasiya akabuda muguta umu akaenda kuBhetani kwaakandovata.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.17",
            "verseOrgIds": [
              "MAT.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Muonde Unosvava",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mangwanani-ngwanani, paakanga ari munzira achidzokera kuguta, akanzwa nzara.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.18",
            "verseOrgIds": [
              "MAT.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati aona muonde pedyo nomugwagwa, akatsaukira pauri asi haana kuwana chinhu pauri kunze kwamashizha. Ipapo akati kwauri, \"Ngakurege kuva nemicherozve pauri!\" Pakarepo muti uya wakabva wasvava.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.19",
            "verseOrgIds": [
              "MAT.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vadzidzi vakati vazviona, vakakatyamara, vakati, \"Ko, muonde uyu wabva wasvava pakarepo sei?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.20",
            "verseOrgIds": [
              "MAT.21.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akapindura akati, \"Ndinokuudzai chokwadi kuti kana mune kutenda uye musingakahadziki, hamungaiti zvaitwa kumuonde uyu chete, asi munogonawo kuti kugomo iri, 'Enda undozvikanda mugungwa' uye zvichaitika.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.21",
            "verseOrgIds": [
              "MAT.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana muchitenda, muchagamuchira zvose zvamunokumbira mukunyengetera.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.22",
            "verseOrgIds": [
              "MAT.21.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vanobvunza Kunobva Simba raJesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akapinda muruvazhe rwetemberi, uye paakanga achidzidzisa, vaprista vakuru navakuru vavanhu vakauya kwaari. Vakamubvunza vakati, \"Muri kuita zvinhu izvi nesimba ripi? Uye ndiani akakupai simba irori?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.23",
            "verseOrgIds": [
              "MAT.21.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akapindura akati, \"Nemiwo ndichakubvunzai mubvunzo mumwe chete. Kana mukandipindura ndichakuudzaiwo simba randiri kuita naro zvinhu izvi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.24",
            "verseOrgIds": [
              "MAT.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rubhabhatidzo rwaJohani rwakabvepi? Rwakabva kudenga here kana kuvanhu?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.25",
            "verseOrgIds": [
              "MAT.21.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 21:25"
      },
      "items": [
        {
          "text": "Vakataurirana pakati pavo vachiti, \"Kana tikati, 'Rwakabva kudenga' achazobvunza kuti, 'Zvino makaregerei kumutenda?'",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.25",
            "verseOrgIds": [
              "MAT.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana tikati, 'Rwakabva kuvanhu,' tinotya vanhu, nokuti vose vanotenda kuti Johani aiva muprofita.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.26",
            "verseOrgIds": [
              "MAT.21.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vakapindura Jesu vachiti, \"Hatizivi.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.27",
            "verseOrgIds": [
              "MAT.21.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 21:27"
      },
      "items": [
        {
          "text": "Ipapo iye akati, \"Neni handingakuudzeiwo simba randinoita naro zvinhu izvi.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.27",
            "verseOrgIds": [
              "MAT.21.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mufananidzo waVanakomana Vaviri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Munofungei nazvo? Paiva nomurume aiva navanakomana vaviri. Akaenda kuno wokutanga akati, 'Mwanangu, enda nhasi unoshanda mumunda wemizambiringa.'",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.28",
            "verseOrgIds": [
              "MAT.21.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Akapindura achiti, 'Handidi,' asi pashure akazvidemba uye akazoenda hake.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.29",
            "verseOrgIds": [
              "MAT.21.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ipapo baba vaya vakaenda kuno mumwe mwanakomana vakasvikomuudza zvimwe chetezvo. Iye akapindura achiti, 'Ndichaenda, baba' asi haana kuenda.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.30",
            "verseOrgIds": [
              "MAT.21.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndoupiko pavaviri ava akaita zvaidiwa nababa vake?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.31",
            "verseOrgIds": [
              "MAT.21.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 21:31"
      },
      "items": [
        {
          "text": "Vakapindura vachiti, \"Wokutanga.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.31",
            "verseOrgIds": [
              "MAT.21.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 21:31"
      },
      "items": [
        {
          "text": "Jesu akati kwavari, \"Ndinokuudzai chokwadi, vateresi nezvifeve vari kukutangirai kupinda muumambo hwaMwari.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.31",
            "verseOrgIds": [
              "MAT.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti Johani akauya kwamuri kuti azokuratidzai nzira yokururama, mukasamutenda, asi vateresi nezvifeve vakatenda. Uye kunyange mushure mokunge maona izvi hamuna kutendeuka mukamutenda.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.32",
            "verseOrgIds": [
              "MAT.21.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mufananidzo waVarimi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Inzwai mumwe mufananidzo. Kwakanga kuno mumwe murume akanga arima munda wake wemizambiringa. Akaukomberedza noruzhowa, akacherera chisviniro chewaini uye akavaka shongwe. Ipapo akasiya munda womuzambiringa kuvarimi vaimupa mari ndokuenda parwendo rurefu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.33",
            "verseOrgIds": [
              "MAT.21.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nguva yokukohwa yakati yasvika, akatuma varanda vake kuvarimi vaya kuti vandotora zvibereko zvake.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.34",
            "verseOrgIds": [
              "MAT.21.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 21:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Varimi vakabata varanda vaya, vakarova mumwe, vakauraya mumwe, uye vakataka wechitatu namabwe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.35",
            "verseOrgIds": [
              "MAT.21.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 21:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akatumazve vamwe varanda kwavari, vakawanda kupfuura vokutanga, varimi vakavaitira zvimwe chetezvo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.36",
            "verseOrgIds": [
              "MAT.21.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 21:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakupedzisira akatuma mwanakomana wake kwavari. Akati, 'Vacharemekedza mwanakomana wangu.'",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.37",
            "verseOrgIds": [
              "MAT.21.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 21:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Asi varimi pavakaona mwanakomana vakataurirana vakati, 'Uyu ndiye mudyi wenhaka. Uyai timuuraye, tigotora nhaka yake.'",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.38",
            "verseOrgIds": [
              "MAT.21.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 21:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vakamutora vakamubudisa kunze kwemunda wemizambiringa vakamuuraya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.39",
            "verseOrgIds": [
              "MAT.21.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 21:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Naizvozvo, panouya muridzi womunda womuzambiringa achaiteiko kuvarimi avo?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.40",
            "verseOrgIds": [
              "MAT.21.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 21:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakapindura vakati, \"Achaparadza varimi vakaipa ava, uye achapa munda womuzambiringa kuna vamwe varimi avo vachazomupa mugove wake wezvirimwa pakukohwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.41",
            "verseOrgIds": [
              "MAT.21.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 21:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati kwavari, \"Hamuna kutomborava here muMagwaro panoti:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.42",
            "verseOrgIds": [
              "MAT.21.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 21:42"
      },
      "items": [
        {
          "text": "\" 'Ibwe rakarambwa navavaki",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.42",
            "verseOrgIds": [
              "MAT.21.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 21:42"
      },
      "items": [
        {
          "text": "ndiro rakazova musoro wekona.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.42",
            "verseOrgIds": [
              "MAT.21.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 21:42"
      },
      "items": [
        {
          "text": "Ishe aita izvi,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.42",
            "verseOrgIds": [
              "MAT.21.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 21:42"
      },
      "items": [
        {
          "text": "uye zvinoshamisa pamberi pedu'?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.42",
            "verseOrgIds": [
              "MAT.21.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 21:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Naizvozvo ndinokuudzai kuti umambo hwaMwari huchatorwa kubva kwamuri huchipiwa kuvanhu vachabereka zvibereko zvahwo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.43",
            "verseOrgIds": [
              "MAT.21.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 21:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyo anowira pamusoro pebwe iri achavhunika kuita zvidimbu zvidimbu asi uyo warichawira achapwanyiwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.44",
            "verseOrgIds": [
              "MAT.21.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 21:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaprista vakuru navaFarisi pavakanzwa mifananidzo yaJesu, vakaziva kuti aitaura nezvavo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.45",
            "verseOrgIds": [
              "MAT.21.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 21:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakatsvaka nzira yokuti vamusunge nayo, asi vakatya vanhu vazhinji nokuti vakanga vachiti muprofita.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.46",
            "verseOrgIds": [
              "MAT.21.46"
            ]
          }
        }
      ]
    }
  ],
