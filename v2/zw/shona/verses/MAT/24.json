  "verseCount": 51,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "MAT 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zviratidzo zvaMazuva Okupedzisira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akabuda mutemberi, uye paakanga achifamba kudaro, vadzidzi vake vakaswedera kwaari vakamuratidza dzimba dzetemberi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.1",
            "verseOrgIds": [
              "MAT.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye akati kwavari, \"Muri kuona zvinhu izvi zvose here? Ndinokuudzai chokwadi kuti hakuna ibwe richasara pano riri pamusoro perimwe; ose achawisirwa pasi.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.2",
            "verseOrgIds": [
              "MAT.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati agara paGomo reMiorivhi, vadzidzi vakauya kwaari vari voga vakati, \"Tiudzei kuti zvinhu izvi zvichaitika rini, uye kuti chiratidzo chokuuya kwenyu nokuguma kwenyika chichava chei?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.3",
            "verseOrgIds": [
              "MAT.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akapindura akati, \"Chenjerai kuti murege kunyengerwa nomunhu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.4",
            "verseOrgIds": [
              "MAT.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti vazhinji vachauya muzita rangu vachiti, 'Ndini Kristu,' uye vachinyengera vazhinji.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.5",
            "verseOrgIds": [
              "MAT.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muchanzwa nezvehondo uye neguhu rehondo, asi chenjerai kuti murege kuvhundutswa nazvo. Zvinhu zvakadaro zvinofanira kuitika asi kuguma kunenge kusati kwasvika.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.6",
            "verseOrgIds": [
              "MAT.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti rudzi ruchamukira rumwe rudzi noumambo huchamukira humwe umambo. Kuchava nenzara nokudengenyeka kwenyika munzvimbo dzakasiyana-siyana.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.7",
            "verseOrgIds": [
              "MAT.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi zvose izvi mavambo okurwadziwa pakubereka.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.8",
            "verseOrgIds": [
              "MAT.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ipapo muchaiswa kuna vanokutambudzai mugourayiwa, uye muchavengwa nendudzi dzose nokuda kwangu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.9",
            "verseOrgIds": [
              "MAT.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva iyoyo vazhinji vachadzokera shure kubva pakutenda uye vachamukirana vagovengana,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.10",
            "verseOrgIds": [
              "MAT.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye vaprofita vazhinji venhema vachamuka uye vachanyengera vanhu vazhinji.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.11",
            "verseOrgIds": [
              "MAT.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuda kwokuwanda kwokusarurama, rudo rwavazhinji ruchatonhora.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.12",
            "verseOrgIds": [
              "MAT.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi uyo achatsungirira kusvikira kumagumo, achaponeswa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.13",
            "verseOrgIds": [
              "MAT.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye vhangeri iri roumambo richaparidzwa munyika yose souchapupu kumarudzi ose, ipapo kuguma kuchasvika.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.14",
            "verseOrgIds": [
              "MAT.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Saka pamunoona 'nyangadzi yokuparadza' yakataurwa nomuprofita Dhanieri, imire panzvimbo tsvene, anoverenga ngaanzwisise,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.15",
            "verseOrgIds": [
              "MAT.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ipapo vari muJudhea ngavatizire kumakomo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.16",
            "verseOrgIds": [
              "MAT.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyo ari padenga reimba yake ngaarege kuburuka kuti andotora chinhu chipi zvacho chiri mumba make.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.17",
            "verseOrgIds": [
              "MAT.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ari mumunda ngaarege kudzokera kundotora nguo yake.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.18",
            "verseOrgIds": [
              "MAT.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvichaoma sei mumazuva iwayo kuvakadzi vane mimba navaya vanoyamwisa!",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.19",
            "verseOrgIds": [
              "MAT.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyengeterai kuti kutiza kwenyu kurege kuitika panguva yechando kana nomusi weSabata.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.20",
            "verseOrgIds": [
              "MAT.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti ipapo pachava nenhamo huru isina kumbovapo kubva pakuvamba kwenyika kusvika zvino uye haizombovapozve.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.21",
            "verseOrgIds": [
              "MAT.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dai mazuva iwayo asina kutapudzwa, hapana munhu airarama, asi nokuda kwavasanangurwa, mazuva iwayo achatapudzwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.22",
            "verseOrgIds": [
              "MAT.24.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva iyoyo, mukanzwa munhu anoti kwamuri, 'Tarirai, hoyu Kristu!' kana kuti, 'Hoyo Kristu,' musazvitenda.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.23",
            "verseOrgIds": [
              "MAT.24.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti kuchamuka vanaKristu venhema navaprofita venhema avo vachaita zviratidzo nezvishamiso kuti vanyengere kunyange navasanangurwa kana zvichigoneka.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.24",
            "verseOrgIds": [
              "MAT.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tarirai, ndafanokuudzai zvisati zvaitika.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.25",
            "verseOrgIds": [
              "MAT.24.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 24:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Saka kana munhu upi zvake akakuudzai kuti, 'Tarirai uyo ari kurenje,' musabuda kuti muendeko kana kuti akati, 'Tarirai, ari mudzimba dzomukati,' musazvitenda.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.26",
            "verseOrgIds": [
              "MAT.24.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sezvinoita mheni inopenya kumabvazuva ichionekwawo kumavirira, ndizvo zvichaita kuuya kwoMwanakomana woMunhu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.27",
            "verseOrgIds": [
              "MAT.24.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 24:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pose pano mutumbi ndipo pachaungana magora.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.28",
            "verseOrgIds": [
              "MAT.24.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 24:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pakarepo shure kwokutambudzika kwamazuva iwayo,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.29",
            "verseOrgIds": [
              "MAT.24.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 24:29"
      },
      "items": [
        {
          "text": "\" 'zuva richasviba,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.29",
            "verseOrgIds": [
              "MAT.24.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 24:29"
      },
      "items": [
        {
          "text": "uye mwedzi hauzovheneki;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.29",
            "verseOrgIds": [
              "MAT.24.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 24:29"
      },
      "items": [
        {
          "text": "nyeredzi dzichawa kubva kudenga,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.29",
            "verseOrgIds": [
              "MAT.24.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 24:29"
      },
      "items": [
        {
          "text": "namasimba omuchadenga achazungunuswa.'",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.29",
            "verseOrgIds": [
              "MAT.24.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 24:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ipapo chiratidzo choMwanakomana woMunhu chichaonekwa kudenga, uye ndudzi dzose dzenyika dzichachema. Vachaona Mwanakomana woMunhu achiuya ari mumakore okudenga nesimba nokubwinya kukuru.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.30",
            "verseOrgIds": [
              "MAT.24.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 24:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye achatuma vatumwa vake nokurira kwehwamanda kukuru uye vachaunganidza vasanangurwa vake kubva kumhepo ina dzenyika, kubva kuno rumwe rutivi rwedenga kusvikira kuno rumwe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.31",
            "verseOrgIds": [
              "MAT.24.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 24:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zvino dzidzai chidzidzo ichi kubva pamuonde: Panopfava matavi awo uye mashizha awo otungira, munoziva kuti zhizha rava pedyo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.32",
            "verseOrgIds": [
              "MAT.24.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 24:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saizvozvowo, nemiwo pamunoona zvinhu zvose izvi muzive kuti nguva yangu yava pedyo, yava pamusiwo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.33",
            "verseOrgIds": [
              "MAT.24.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 24:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinokuudzai chokwadi kuti rudzi urwu harungatongopfuuri kusvikira zvinhu zvose izvi zvaitika.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.34",
            "verseOrgIds": [
              "MAT.24.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 24:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Denga nenyika zvichapfuura asi mashoko angu haangatongopfuuri.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.35",
            "verseOrgIds": [
              "MAT.24.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Musi neNguva hazvizivikanwi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 24:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Hapana anoziva musi kana nguva kunyange vatumwa vokudenga kana Mwanakomana, asi Baba chete.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.36",
            "verseOrgIds": [
              "MAT.24.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 24:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sezvazvakanga zvakaita pamazuva aNoa, ndizvo zvazvichaita pakuuya kwoMwanakomana woMunhu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.37",
            "verseOrgIds": [
              "MAT.24.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 24:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti sapamazuva iwayo mafashamu asati auya, vanhu vaidya uye vachinwa, vaiwana nokuwanikwa kusvikira pazuva iro Noa akapinda muareka,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.38",
            "verseOrgIds": [
              "MAT.24.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 24:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye vakanga vasingazivi chinhu pamusoro pezvaizoitika kusvikira mafashamu avakukura vose. Ndizvo zvazvichaita pakuuya kwoMwanakomana woMunhu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.39",
            "verseOrgIds": [
              "MAT.24.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 24:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume vaviri vachange vari mumunda, mumwe achatorwa uye mumwe achasiyiwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.40",
            "verseOrgIds": [
              "MAT.24.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 24:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakadzi vaviri vachange vachikuya paguyo, mumwe achatorwa uye mumwe achasiyiwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.41",
            "verseOrgIds": [
              "MAT.24.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 24:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Naizvozvo, garai makagadzirira nokuti hamuzivi zuva iro Ishe wenyu achauya naro.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.42",
            "verseOrgIds": [
              "MAT.24.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 24:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi nzwisisai izvi: Dai muridzi weimba aiziva kuti inguva ipi yousiku ichauya mbavha, angadai airinda uye haaizotendera kuti imba yake ipazwe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.43",
            "verseOrgIds": [
              "MAT.24.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 24:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo nemiwo garai makagadzirira nokuti Mwanakomana woMunhu achauya nenguva yamusingamutarisiri.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.44",
            "verseOrgIds": [
              "MAT.24.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 24:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndiani zvino muranda akatendeka uye akachenjera uyo akaiswa natenzi wake kuti atarire varanda veimba yake kuti agovapa zvokudya panguva yakafanira?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.45",
            "verseOrgIds": [
              "MAT.24.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 24:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaropafadzwa muranda uyo anowanikwa achiita izvozvo pakudzoka kwatenzi wake.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.46",
            "verseOrgIds": [
              "MAT.24.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "MAT 24:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinokuudzai chokwadi kuti achamugadza kuti ave mutariri wepfuma yake yose.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.47",
            "verseOrgIds": [
              "MAT.24.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "MAT 24:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi ngatimboti muranda uyo akaipa uye oti mumwoyo make, 'Tenzi wangu achange asipo kwenguva refu,'",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.48",
            "verseOrgIds": [
              "MAT.24.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "MAT 24:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye ipapo otanga kurova vamwe varanda uye nokudya nokunwa nezvidhakwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.49",
            "verseOrgIds": [
              "MAT.24.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "MAT 24:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tenzi womuranda uyo achauya pazuva raasingatarisire napanguva yaasingazivi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.50",
            "verseOrgIds": [
              "MAT.24.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "MAT 24:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achasvikomugura-gura agomuisa panzvimbo imwe chete navanyengeri apo pachava nokuchema nokurumanya kwameno.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.51",
            "verseOrgIds": [
              "MAT.24.51"
            ]
          }
        }
      ]
    }
  ],
