  "verseCount": 66,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
        "style": "c",
        "sid": "MAT 27"
      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Judhasi Anozvisungirira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mangwanani-ngwanani vaprista vose vakuru navakuru vavanhu vakabvumirana kuti Jesu aurayiwe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.1",
            "verseOrgIds": [
              "MAT.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakamusunga, vakaenda naye vakandomuisa kuna Pirato uyo aiva mubati.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.2",
            "verseOrgIds": [
              "MAT.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Judhasi uya akanga amupandukira akati aona kuti Jesu atongerwa rufu, akazvidemba kwazvo ndokubva adzosera makumi matatu esirivha aya kuvaprista vakuru navakuru.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.3",
            "verseOrgIds": [
              "MAT.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akasvikoti, \"Ndatadza, nokuti ndapandukira ropa risina mhosva.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.4",
            "verseOrgIds": [
              "MAT.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 27:4"
      },
      "items": [
        {
          "text": "Vakamupindura vachiti, \"Zvinei nesu? Ndezvako izvo.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.4",
            "verseOrgIds": [
              "MAT.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Judhasi akakanda mari iya mutemberi akabva akaenda akandozvisungirira.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.5",
            "verseOrgIds": [
              "MAT.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaprista vakuru vakanhonga mari iya vakati, \"Hazvitenderwi nomurayiro kuti tiise mari iyi mudura remari, sezvo iri mari yeropa.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.6",
            "verseOrgIds": [
              "MAT.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vakazotenderana kuti vaishandise kutenga munda womuumbi wehari kuti ugova nzvimbo yokuviga vatorwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.7",
            "verseOrgIds": [
              "MAT.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo wakanzi Munda Weropa kusvikira zuva ranhasi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.8",
            "verseOrgIds": [
              "MAT.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo zvakabva zvazadziswa zvakataurwa nomuprofita Jeremia zvinoti, \"Vakatora makumi matatu esirivha, mutengo waakatengeswa nawo navanhu veIsraeri,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.9",
            "verseOrgIds": [
              "MAT.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye vakaashandisa kutenga nawo munda womuumbi wehari, sokurayirwa kwandakaitwa naIshe.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.10",
            "verseOrgIds": [
              "MAT.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu Pamberi paPirato",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva iyoyo Jesu akamira pamberi pomubati, uye mubati akamubvunza achiti, \"Ndiwe mambo wavaJudha here?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.11",
            "verseOrgIds": [
              "MAT.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 27:11"
      },
      "items": [
        {
          "text": "Jesu akapindura achiti, \"Hongu, ndizvo zvamataura.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.11",
            "verseOrgIds": [
              "MAT.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paakapomerwa navaprista vakuru navakuru vavanhu, haana chaakapindura.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.12",
            "verseOrgIds": [
              "MAT.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Pirato akamubvunza achiti, \"Iwe haunzwi here uchapupu hwezvavari kukupomera izvi?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.13",
            "verseOrgIds": [
              "MAT.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi, Jesu akaramba anyerere, akasapindura kunyange chimwe zvacho, mubati akashamiswa kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.14",
            "verseOrgIds": [
              "MAT.27.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino yaiva tsika yomubati pamutambo kusunungura musungwa mumwe chete anenge asarudzwa navanhu vazhinji.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.15",
            "verseOrgIds": [
              "MAT.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva iyoyo vaiva nomusungwa ainge anetsa kwazvo ainzi Bharabhasi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.16",
            "verseOrgIds": [
              "MAT.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vanhu vazhinji vakati vaungana, Pirato akavabvunza akati, \"Ndoupi wamunoda kuti ndikusunungurirei: Bharabhasi kana kuti Jesu anonzi Kristu?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.17",
            "verseOrgIds": [
              "MAT.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti aiziva kuti vakanga vamuisa kwaari nokuda kwegodo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.18",
            "verseOrgIds": [
              "MAT.27.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pirato akati agere pachigaro chokutonga mukadzi wake akamutumira shoko iri rokuti: \"Usawana chaunoita nomurume uyo asina mhosva, nokuti hope dzandarota nezvake usiku hwanhasi dzanditambudza kwazvo.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.19",
            "verseOrgIds": [
              "MAT.27.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vaprista vakuru navakuru vavanhu vakakurudzira vanhu vazhinji kuti vakumbire Bharabhasi uye kuti Jesu aurayiwe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.20",
            "verseOrgIds": [
              "MAT.27.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubati akabvunza akati, \"Ndoupi pavaviri ava wamunoda kuti ndikusunungurirei?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.21",
            "verseOrgIds": [
              "MAT.27.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 27:21"
      },
      "items": [
        {
          "text": "Vakapindura vakati, \"Bharabhasi!\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.21",
            "verseOrgIds": [
              "MAT.27.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pirato akabvunza akati, \"Zvino ndichaiteiko naJesu anonzi Kristu?\" Vakapindura vakati, \"Ngaarovererwe pamuchinjikwa!\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.22",
            "verseOrgIds": [
              "MAT.27.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pirato akabvunzazve achiti, \"Nemhaka yei? Mhosva yake ndeyei?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.23",
            "verseOrgIds": [
              "MAT.27.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 27:23"
      },
      "items": [
        {
          "text": "Vanhu vazhinji vaya vakaramba vachidanidzira vachiti, \"Ngaarovererwe pamuchinjikwa!\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.23",
            "verseOrgIds": [
              "MAT.27.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pirato akati aona kuti hapana kwaaisvika, asi kuti bope rakanga rotanga, akatora mvura akashamba maoko ake pamberi pavanhu akati, \"Handina mhosva yeropa romunhu uyu. Zvionerei.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.24",
            "verseOrgIds": [
              "MAT.27.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 27:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vose vakapindura vachiti, \"Ropa rake ngarive pamusoro pedu napamusoro pevana vedu.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.25",
            "verseOrgIds": [
              "MAT.27.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akavasunungurira Bharabhasi, asi akaita kuti Jesu arohwe, uye akamupa kwavari kuti arovererwe pamuchinjikwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.26",
            "verseOrgIds": [
              "MAT.27.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Varwi Vanoseka Jesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo varwi vomubati vakatora Jesu vakaenda naye mumuzinda womubati uye vakaunganidza hondo yose paari.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.27",
            "verseOrgIds": [
              "MAT.27.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 27:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakamubvisa nguo dzake vakamupfekedza nguo tsvuku.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.28",
            "verseOrgIds": [
              "MAT.27.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakaruka korona yeminzwa vakaiisa pamusoro wake. Vakamubatisa mudonzvo muruoko rwake rworudyi vakapfugama pamberi pake uye vakamuseka vachiti, \"Kwaziwai, Mambo wavaJudha!\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.29",
            "verseOrgIds": [
              "MAT.27.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 27:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakamusvipira mate vakamutorera tsvimbo iya uye vakamurova nayo mumusoro kakawanda.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.30",
            "verseOrgIds": [
              "MAT.27.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 27:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwokumuseka, vakamupfekedza nguo dzake chaidzo ndokuenda naye kundomuroverera pamuchinjikwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.31",
            "verseOrgIds": [
              "MAT.27.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kurovererwa paMuchinjikwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 27:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati vobuda, vakasangana nomurume aibva kuSairini ainzi Simoni, uye vakamumanikidza kuti atakure muchinjikwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.32",
            "verseOrgIds": [
              "MAT.27.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 27:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakasvika panzvimbo inonzi Gorogota, (zvinoreva kuti Nzvimbo yeDehenya).",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.33",
            "verseOrgIds": [
              "MAT.27.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 27:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vakapa Jesu waini yakasanganiswa nenduru, kuti anwe, asi akati airavira akaramba kuinwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.34",
            "verseOrgIds": [
              "MAT.27.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 27:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati vamuroverera pamuchinjikwa, vakagovana nguo dzake vachiita zvokukanda mijenya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.35",
            "verseOrgIds": [
              "MAT.27.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 27:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye vakagara pasi, vakamurinda.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.36",
            "verseOrgIds": [
              "MAT.27.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 27:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamusoro pake vakaisa rugwaro rwemhosva yake rwaiti: \"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.37",
            "verseOrgIds": [
              "MAT.27.37"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "sc"
          },
          "items": [
            {
              "text": "uyu ndijesu, mambo wavajudha",
              "type": "text",
              "attrs": {
                "verseId": "MAT.27.37",
                "verseOrgIds": [
                  "MAT.27.37"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.37",
            "verseOrgIds": [
              "MAT.27.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 27:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makororo maviri akarovererwawo pamwe chete naye, mumwe kurudyi mumwe kuruboshwe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.38",
            "verseOrgIds": [
              "MAT.27.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 27:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaya vaipfuura napo, vakamutuka vachidzungudza misoro yavo",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.39",
            "verseOrgIds": [
              "MAT.27.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 27:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye vachiti, \"Iwe uri kuzoputsa temberi uchizoivakazve mumazuva matatu, chizviponesa! Buruka pamuchinjikwa kana uri Mwanakomana waMwari!\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.40",
            "verseOrgIds": [
              "MAT.27.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 27:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenzira imwe cheteyo, vaprista vakuru, navadzidzisi vomurayiro navakuru vakamuseka vachiti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.41",
            "verseOrgIds": [
              "MAT.27.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 27:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Akaponesa vamwe, asi haagoni kuzviponesa! Ndiye Mambo weIsraeri! Ngaaburuke zvino pamuchinjikwa tigotenda kwaari.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.42",
            "verseOrgIds": [
              "MAT.27.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 27:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anovimba naMwari saka ngaachimununura iye zvino kana achimuda, nokuti akati, 'Ndiri Mwanakomana waMwari.' \"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.43",
            "verseOrgIds": [
              "MAT.27.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 27:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenzira imwe cheteyo makororo akanga arovererwa pamwe chete naye akamutukawo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.44",
            "verseOrgIds": [
              "MAT.27.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kufa kwaJesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 27:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubva panguva yechitanhatu kusvika panguva yepfumbamwe rima rakavapo panyika yose.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.45",
            "verseOrgIds": [
              "MAT.27.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 27:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenguva inenge yepfumbamwe, Jesu akadanidzira nenzwi guru achiti, \"Eroi, Eroi, rama sabhakitani?\" zvichireva kuti, \"Mwari wangu! Mwari wangu, mandisiyireiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.46",
            "verseOrgIds": [
              "MAT.27.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "MAT 27:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vamwe vakanga vamirepo vakati vanzwa izvozvo, vakati, \"Ari kudana Eria.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.47",
            "verseOrgIds": [
              "MAT.27.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "MAT 27:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakarepo mumwe wavo akamhanya akatora chipanje. Akachizadza newaini yevhiniga ndokuchiisa pachimuti, achibva apa Jesu kuti anwe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.48",
            "verseOrgIds": [
              "MAT.27.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "MAT 27:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vamwe vakati, \"Zvino musiyei ari oga. Regai tione kana Eria achiuya kuzomuponesa.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.49",
            "verseOrgIds": [
              "MAT.27.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "MAT 27:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Jesu akati adanidzira nenzwi guru, akabudisa mweya wake.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.50",
            "verseOrgIds": [
              "MAT.27.50"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "MAT 27:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva iyoyo chidzitiro chomutemberi chakabvaruka napakati kubva kumusoro kusvika pasi. Nyika yakadengenyeka, uye mabwe akatsemuka.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.51",
            "verseOrgIds": [
              "MAT.27.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "MAT 27:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makuva akazaruka, mitumbi yavatsvene vazhinji vakanga vakafa ikamutswa kuupenyu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.52",
            "verseOrgIds": [
              "MAT.27.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "MAT 27:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakabuda mumakuva, uye shure kwokumuka kwaJesu vakapinda muguta dzvene uye vakaonekwa navanhu vazhinji.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.53",
            "verseOrgIds": [
              "MAT.27.53"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "MAT 27:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukuru wezana navaya vaakanga anavo vakarinda Jesu, pavakaona kudengenyeka kwenyika nezvose zvakanga zvaitika, vakatya kwazvo, uye vakati, \"Zvechokwadi, anga ari Mwanakomana waMwari!\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.54",
            "verseOrgIds": [
              "MAT.27.54"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "MAT 27:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakadzi vazhinji vakanga varipo, vachitarira vari kure. Vakanga vatevera Jesu kubva kuGarirea kuti vamuriritire pane zvaaida.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.55",
            "verseOrgIds": [
              "MAT.27.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "MAT 27:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakati pavo paiva naMaria Magadharena, Maria mai vaJakobho naJosefa, namai vavanakomana vaZebhedhi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.56",
            "verseOrgIds": [
              "MAT.27.56"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuvigwa kwaJesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "MAT 27:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakati kwovira, kwakauya mumwe murume mupfumi aibva kuArimatea, ainzi Josefa, akanga avawo mudzidzi waJesu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.57",
            "verseOrgIds": [
              "MAT.27.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "MAT 27:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaenda kuna Pirato akandokumbira mutumbi waJesu, uye Pirato akarayira kuti aupiwe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.58",
            "verseOrgIds": [
              "MAT.27.58"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "MAT 27:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josefa akatora mutumbi akauputira nomucheka wakachena,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.59",
            "verseOrgIds": [
              "MAT.27.59"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "60",
            "style": "v",
            "sid": "MAT 27:60"
          },
          "items": [
            {
              "text": "60",
              "type": "text"
            }
          ]
        },
        {
          "text": "akauisa muguva rake idzva raakanga achera padombo. Akakungurutsira ibwe guru pamuromo weguva ndokubva aenda.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.60",
            "verseOrgIds": [
              "MAT.27.60"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "61",
            "style": "v",
            "sid": "MAT 27:61"
          },
          "items": [
            {
              "text": "61",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maria Magadharena nomumwe Maria vakanga varipo vagere pakatarisana neguva.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.61",
            "verseOrgIds": [
              "MAT.27.61"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Murindi paGuva",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "62",
            "style": "v",
            "sid": "MAT 27:62"
          },
          "items": [
            {
              "text": "62",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mangwana acho, iro rakatevera Zuva roKugadzirira, vaprista vakuru navaFarisi vakaenda kuna Pirato.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.62",
            "verseOrgIds": [
              "MAT.27.62"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "63",
            "style": "v",
            "sid": "MAT 27:63"
          },
          "items": [
            {
              "text": "63",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakasvikoti, \"Ishe, tinorangarira kuti achiri mupenyu, munyengeri uya akati, 'Mushure mamazuva matatu, ndichamukazve.'",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.63",
            "verseOrgIds": [
              "MAT.27.63"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "64",
            "style": "v",
            "sid": "MAT 27:64"
          },
          "items": [
            {
              "text": "64",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka rayirai kuti guva rake richengetedzwe kwazvo kusvika pazuva retatu. Zvimwe vadzidzi vake vangauye vakaba mutumbi wake vakaudza vanhu kuti akamutswa kubva kuvakafa. Kunyengera kwokupedzisira uku kuchaipa kukunda kwokutanga.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.64",
            "verseOrgIds": [
              "MAT.27.64"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "65",
            "style": "v",
            "sid": "MAT 27:65"
          },
          "items": [
            {
              "text": "65",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pirato akapindura akati, \"Torai, varindi. Endai, mundochengetedza guva iroro semaziviro enyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.65",
            "verseOrgIds": [
              "MAT.27.65"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "66",
            "style": "v",
            "sid": "MAT 27:66"
          },
          "items": [
            {
              "text": "66",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vakaenda vakandoita kuti richengetedzwe nokuisa chisimbiso pabwe, uye nokuisa varindi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.66",
            "verseOrgIds": [
              "MAT.27.66"
            ]
          }
        }
      ]
    }
