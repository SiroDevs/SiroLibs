  "verseCount": 46,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "MAT 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mufananidzo woMutambo weSvitsa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akataurazve kwavari nemifananidzo achiti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.1",
            "verseOrgIds": [
              "MAT.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Umambo hwokudenga hwakafanana namambo akagadzirira mwanakomana wake mutambo wesvitsa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.2",
            "verseOrgIds": [
              "MAT.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatuma varanda vake kuna avo vainge vakakokwa kumutambo kuti vachiuya, asi vakaramba kuuya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.3",
            "verseOrgIds": [
              "MAT.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ipapo akatumazve vamwe varanda achiti, 'Taurirai vose vakakokwa kuti ndagadzirira mabiko: Ndabaya nzombe nemombe dzakakodzwa uye zvose zvagadzirirwa. Uyai kumutambo wesvitsa.'",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.4",
            "verseOrgIds": [
              "MAT.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Asi hapana akateerera uye vakaenda mumwe kumunda wake, mumwewo kune rimwe basa rake.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.5",
            "verseOrgIds": [
              "MAT.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vamwe vavo vakabata varanda vake vakavaitira zvakaipa uye vakavauraya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.6",
            "verseOrgIds": [
              "MAT.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akatsamwa kwazvo. Akatuma hondo yake kundoparadza vaurayi vaya uye akapisa guta ravo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.7",
            "verseOrgIds": [
              "MAT.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ipapo akati kuvaranda vake, 'Mutambo wesvitsa wagadzirirwa asi vaya vandakakoka vakanga vasingakodzeri kuti vauye.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.8",
            "verseOrgIds": [
              "MAT.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endai kumharadzano dzenzira mundokoka kumutambo ani zvake wamuchawana.'",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.9",
            "verseOrgIds": [
              "MAT.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka varanda vakaenda mumigwagwa vakandokokorodza vose vavakagona kuwana, vose vakanaka nevakaipa, uye imba yesvitsa ikazara navakanga vakokwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.10",
            "verseOrgIds": [
              "MAT.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Asi mambo akati apinda kuzoona vakanga vakokwa, akaona munhu imomo akanga asina nguo yesvitsa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.11",
            "verseOrgIds": [
              "MAT.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamubvunza akati, 'Shamwari, wapinda seiko muno usina nguo yesvitsa?' Munhu uya akashaya chokureva.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.12",
            "verseOrgIds": [
              "MAT.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ipapo mambo akaudza varanda vake akati, 'Musungei maoko namakumbo mumukande panze, murima, umo muchava nokuchema nokurumanya kwameno.'",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.13",
            "verseOrgIds": [
              "MAT.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nokuti vazhinji vakakokwa asi vakasarudzwa vashoma.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.14",
            "verseOrgIds": [
              "MAT.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuripa Mutero kuna Kesari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vaFarisi vakabuda vakandoronga kuti vamubate namashoko ake.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.15",
            "verseOrgIds": [
              "MAT.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakatuma vadzidzi vavo kwaari pamwe chete navaHerodhi. Vakati, \"Mudzidzisi, tinoziva kuti muri munhu akarurama uye kuti munodzidzisa nzira yaMwari zviri maererano nechokwadi. Hamutsauswi navanhu nokuti hamutarisi kuti ndivanaani.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.16",
            "verseOrgIds": [
              "MAT.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiudzei zvino kuti imi, munoti kudini? Zvakanaka here kutera mutero kuna Kesari kana kuti hazvina?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.17",
            "verseOrgIds": [
              "MAT.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Jesu, achiziva kuipa kwavo, akati, \"Imi vanyengeri munondiedzereiko?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.18",
            "verseOrgIds": [
              "MAT.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiratidzei mari inoshandiswa pakutera mutero.\" Vakamuvigira dhenari",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.19",
            "verseOrgIds": [
              "MAT.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye akavabvunza akati, \"Ko, mufananidzo uyu ndowaani uye runyoro urwu ndorwaani?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.20",
            "verseOrgIds": [
              "MAT.22.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakapindura vakati, \"NdezvaKesari.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.21",
            "verseOrgIds": [
              "MAT.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 22:21"
      },
      "items": [
        {
          "text": "Ipapo akati kwavari, \"Ipai kuna Kesari zvaKesari, uye kuna Mwari zvaMwari.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.21",
            "verseOrgIds": [
              "MAT.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati vanzwa izvi, vakashamiswa. Saka vakamusiya vakaenda.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.22",
            "verseOrgIds": [
              "MAT.22.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waniso paKumuka kwaVakafa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva rimwe chetero vaSadhusi, avo vanoti hakuna kumuka kwavakafa, vakauya kwaari nomubvunzo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.23",
            "verseOrgIds": [
              "MAT.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati, \"Mudzidzisi, Mozisi akatiudza kuti murume akafa asina vana mununʼuna wake anofanira kuwana chirikadzi agomuberekera vana.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.24",
            "verseOrgIds": [
              "MAT.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino pakati pedu paiva navanakomana vomunhu mumwe vanomwe. Wokutanga akawana mukadzi ndokubva iye afa, uye sezvo akanga asina vana, akasiyira mununʼuna wake mukadzi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.25",
            "verseOrgIds": [
              "MAT.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvimwe chetezvo zvakaitika kuno wechipiri nowechitatu kusvikira kuno wechinomwe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.26",
            "verseOrgIds": [
              "MAT.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakupedzisira mukadzi akazofawo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.27",
            "verseOrgIds": [
              "MAT.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino pakumuka kwavakafa, achava mukadzi waaniko pavanomwe vaya sezvo vose vaiva varume vake?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.28",
            "verseOrgIds": [
              "MAT.22.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akavapindura akati, \"Ndipo pamunorasika ipapo nokuti hamuzivi Magwaro kana simba raMwari.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.29",
            "verseOrgIds": [
              "MAT.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakumuka kwavakafa vanhu havawani kana kuwanikwa, vachange vakaita savatumwa kudenga.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.30",
            "verseOrgIds": [
              "MAT.22.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi pane zvokumuka kwavakafa, hamuna kuverenga here zvakarehwa naMwari kwamuri, achiti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.31",
            "verseOrgIds": [
              "MAT.22.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 22:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Ndini Mwari waAbhurahama naMwari waIsaka naMwari waJakobho'? Haasi Mwari wavakafa asi wavapenyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.32",
            "verseOrgIds": [
              "MAT.22.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 22:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vazhinji vakati vanzwa izvi, vakashamiswa nokudzidzisa kwake.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.33",
            "verseOrgIds": [
              "MAT.22.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Murayiro Mukuru",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 22:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanzwa kuti Jesu akanga akunda vaSadhusi, vaFarisi vakaungana pamwe chete.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.34",
            "verseOrgIds": [
              "MAT.22.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 22:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwe wavo aiva nyanzvi pane zvemirayiro akamuedza nomubvunzo achiti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.35",
            "verseOrgIds": [
              "MAT.22.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 22:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mudzidzisi, ndoupi murayiro mukuru muMurayiro?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.36",
            "verseOrgIds": [
              "MAT.22.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 22:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akapindura akati, \" 'Ida Ishe Mwari wako nomwoyo wako wose, nomweya wako wose nokufunga kwako kwose.'",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.37",
            "verseOrgIds": [
              "MAT.22.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 22:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyu ndiwo murayiro mukuru uye wokutanga.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.38",
            "verseOrgIds": [
              "MAT.22.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 22:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wechipiri wakafanana nawo unoti, 'Ida muvakidzani wako sokuda kwaunozviita iwe.'",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.39",
            "verseOrgIds": [
              "MAT.22.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 22:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murayiro wose naVaprofita zvakabatanidzwa pamirayiro iyi miviri.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.40",
            "verseOrgIds": [
              "MAT.22.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ko, Kristu Mwanakomana waani?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 22:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaFarisi pavakanga vachakaungana pamwe chete, Jesu akavabvunza akati,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.41",
            "verseOrgIds": [
              "MAT.22.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 22:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Munofungei nezvaKristu? Mwana waani?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.42",
            "verseOrgIds": [
              "MAT.22.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 22:42"
      },
      "items": [
        {
          "text": "Vakapindura vachiti, \"Mwanakomana waDhavhidhi.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.42",
            "verseOrgIds": [
              "MAT.22.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 22:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati kwavari, \"Ko, zvino sei Dhavhidhi achitaura noMweya akamuti, 'Ishe'? Nokuti anoti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.43",
            "verseOrgIds": [
              "MAT.22.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 22:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ishe akati kuna Ishe wangu:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.44",
            "verseOrgIds": [
              "MAT.22.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 22:44"
      },
      "items": [
        {
          "text": "Gara kuruoko rwangu rworudyi,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.44",
            "verseOrgIds": [
              "MAT.22.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 22:44"
      },
      "items": [
        {
          "text": "kusvikira ndaisa vavengi vako",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.44",
            "verseOrgIds": [
              "MAT.22.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 22:44"
      },
      "items": [
        {
          "text": "pasi petsoka dzako.'",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.44",
            "verseOrgIds": [
              "MAT.22.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 22:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino kana Dhavhidhi achimuti, 'Ishe' angagova mwanakomana wake sei?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.45",
            "verseOrgIds": [
              "MAT.22.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 22:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hapana akagona kutaura shoko rimwe, uye kubva pazuva iroro zvichienda mberi hapana akazoshinga kumubvunza mimwezve mibvunzo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.46",
            "verseOrgIds": [
              "MAT.22.46"
            ]
          }
        }
      ]
    }
  ],
