  "verseCount": 44,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "EZR 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vanhu Vanoreurura Chivi Chavo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZR 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezira paakanga achinyengetera achireurura, achichema uye achizviwisira pasi pamberi peimba yaMwari, ungano huru huru yavarume, vakadzi navana vavaIsraeri yakaungana paari. Naivowo vakachema zvikuru kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.1",
            "verseOrgIds": [
              "EZR.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Shekania mwanakomana waJehieri, mumwe wezvizvarwa zvaEramu, akati kuna Ezira, \"Takatadzira Mwari wedu nokuwana vakadzi vatorwa kubva kundudzi dzakatipoteredza. Asi kunyange zvakadaro, Israeri ichine tariro.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.2",
            "verseOrgIds": [
              "EZR.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino ngatiitei sungano pamberi paMwari wedu kuti tidzinge vakadzi ava vose navana vavo, maererano nezvakarayirwa naishe wangu naavo vanotya mirayiro yaMwari wedu. Ngazviitwe maererano nomurayiro.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.3",
            "verseOrgIds": [
              "EZR.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simuka; nyaya iyi yava mumaoko ako. Tichamira newe, saka, tsunga mwoyo uzviite.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.4",
            "verseOrgIds": [
              "EZR.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Ezira akasimuka akaisa pamhiko vaprista vaitungamira navaRevhi uye navaIsraeri vose kuti vaite zvakanga zvarehwa. Uye vakaita mhiko.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.5",
            "verseOrgIds": [
              "EZR.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Ezira akabva pamberi peimba yaMwari akaenda kukamuri raJehohanani mwanakomana waEriashibhi. Paakanga ari ikoko haana kudya zvokudya kana kunwa mvura nokuti akaramba achichema nokuda kwokusatendeka kwavatapwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.6",
            "verseOrgIds": [
              "EZR.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiziviso chakadanidzirwa muJudha mose nomuJerusarema kuti vatapwa vose vaungane muJerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.7",
            "verseOrgIds": [
              "EZR.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani naani aizokundikana kusvika mumazuva matatu aizotorerwa pfuma yake yose, maererano nokurayira kwamachinda navakuru, uye naiyewo aibva adzingwa kubva paungano yavatapwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.8",
            "verseOrgIds": [
              "EZR.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukati mamazuva matatu, varume vose veJudha neBhenjamini vakanga vaungana muJerusarema. Uye pazuva ramakumi maviri romwedzi wechinomwe, vanhu vose vakagara pachivara pamberi peimba yaMwari, vakasuwa zvikuru nokuda kwechiitiko ichi uye nokuda kwemvura yakanga ichinaya.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.9",
            "verseOrgIds": [
              "EZR.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Ezira muprista akasimuka akati kwavari, \"Makatadza; makawana vakadzi vatorwa, mukawedzera mhosva yaIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.10",
            "verseOrgIds": [
              "EZR.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino reururai kuna Jehovha, iye Mwari wamadzibaba enyu, uye mugoita kuda kwake. Zvitsaurei kubva kumarudzi avanhu akakupoteredzai uye kubva kuvakadzi venyu vatorwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.11",
            "verseOrgIds": [
              "EZR.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungano yose yakapindura nenzwi guru ikati, \"Zvamataura ndizvo! Tinofanira kuita sezvamataura.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.12",
            "verseOrgIds": [
              "EZR.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi pane vanhu vakawanda pano uye inguva yokunaya kwemvura; saka hatingamire panze. Pamusoro pezvo basa iri harigoni kuitwa nezuva rimwe chete kana mazuva maviri, nokuti takatadza zvikuru nokuda kwechinhu ichi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.13",
            "verseOrgIds": [
              "EZR.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Machinda edu ngavamiririre ungano yose. Ipapo mumwe nomumwe mumaguta edu akawana mukadzi mutorwa auye panguva dzakatarwa, pamwe chete navakuru navatongi veguta rimwe nerimwe, kusvikira kutsamwa kwaMwari kukuru kwabviswa kwatiri.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.14",
            "verseOrgIds": [
              "EZR.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonatani mwanakomana waAsaeri naJazeya mwanakomana waTikivha, vachitsigirwa naMeshurami naShabhetai muRevhi, ndivo chete vakapikisa izvi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.15",
            "verseOrgIds": [
              "EZR.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokudaro vakanga vambotapwa vakaita zvakanga zvataurwa. Ezira muprista akasarudza varume vakanga vari vakuru vemhuri, mumwe chete kubva kumhuri yamadzibaba avo, uye vose vachizivikanwa namazita avo. Pazuva rokutanga romwedzi wegumi vakagara pasi vakatanga kuferefeta nyaya idzi,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.16",
            "verseOrgIds": [
              "EZR.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye pazuva rokutanga romwedzi wokutanga vakanga vapedza kutonga varume vose vakanga vawana vakadzi vatorwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.17",
            "verseOrgIds": [
              "EZR.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mhosva yoKuwana Vakadzi Vatorwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZR 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakati pezvizvarwa zvavaprista, ava ndivo vakanga vawana vakadzi vatorwa:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EZR 10:18"
      },
      "items": [
        {
          "text": "Kubva kuzvizvarwa zvaJeshua mwanakomana waJozadhaki nehama dzake:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.18",
            "verseOrgIds": [
              "EZR.10.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EZR 10:18"
      },
      "items": [
        {
          "text": "Maaseya, Eriezeri, Jaribhu naGedharia.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.18",
            "verseOrgIds": [
              "EZR.10.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZR 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Vose vakapika namaoko avo kuti vachadzinga vakadzi vavo, uye pamhosva dzavo mumwe nomumwe wavo akapa gondobwe kubva pamakwai ake sechipiriso chechivi.)",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.19",
            "verseOrgIds": [
              "EZR.10.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZR 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubva kuzvizvarwa zvaImeri:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.20",
            "verseOrgIds": [
              "EZR.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EZR 10:20"
      },
      "items": [
        {
          "text": "Hanani naZebhadhia.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.20",
            "verseOrgIds": [
              "EZR.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZR 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubva kuzvizvarwa zvaHarimu:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.21",
            "verseOrgIds": [
              "EZR.10.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EZR 10:21"
      },
      "items": [
        {
          "text": "Maaseya, Eria, Shemaya, Jehieri naUzia.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.21",
            "verseOrgIds": [
              "EZR.10.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZR 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubva kuzvizvarwa zvaPashuri:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.22",
            "verseOrgIds": [
              "EZR.10.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EZR 10:22"
      },
      "items": [
        {
          "text": "Erioenai, Maaseya, Ishumaeri, Netaneri, Jozabhadhi naErasa.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.22",
            "verseOrgIds": [
              "EZR.10.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZR 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakati pavaRevhi:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EZR 10:23"
      },
      "items": [
        {
          "text": "Jozabhadhi, Shimei, Keraya (ndiye ainzi Kerita), Petahia, Judha naEriezeri.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.23",
            "verseOrgIds": [
              "EZR.10.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZR 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubva kuvaimbi:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.24",
            "verseOrgIds": [
              "EZR.10.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EZR 10:24"
      },
      "items": [
        {
          "text": "Eriashibhi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.24",
            "verseOrgIds": [
              "EZR.10.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EZR 10:24"
      },
      "items": [
        {
