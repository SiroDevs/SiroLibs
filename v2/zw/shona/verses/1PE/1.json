  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "1PE 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1PE 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petro, mupostori waJesu Kristu, kuvasanangurwa vaMwari, vatorwa munyika, vakapararira muPondasi yose, neGaratia, neKapadhokia, Ezhia neBhitinia,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.1",
            "verseOrgIds": [
              "1PE.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1PE 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "vakasarudzwa maererano nokuziva zviri mberi kunoita Mwari Baba, kubudikidza nebasa roMweya rokuvaita vatsvene, kuti vateerere kuna Jesu Kristu nokusaswa neropa rake:",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.2",
            "verseOrgIds": [
              "1PE.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1PE 1:2"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1PE 1:2"
      },
      "items": [
        {
          "text": "Nyasha norugare ngazviwande kwamuri.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.2",
            "verseOrgIds": [
              "1PE.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwari ngaarumbidzwe nokuda kweTariro ine Upenyu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1PE 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari, Baba vaIshe wedu Jesu Kristu, ngaarumbidzwe! Nengoni dzake huru, akatibereka patsva akatipinza mutariro mhenyu nokumuka kwaJesu Kristu kubva kuvakafa,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.3",
            "verseOrgIds": [
              "1PE.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1PE 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "akatiisa munhaka isingagoni kuparara, isingaori kana kusvava, yamakachengeterwa kudenga,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.4",
            "verseOrgIds": [
              "1PE.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1PE 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "imi munodzivirirwa nesimba raMwari nokutenda kusvikira ruponeso rwauya rwakagadzirirwa kuti ruratidzwe munguva dzokupedzisira.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.5",
            "verseOrgIds": [
              "1PE.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1PE 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mune izvi munofara zvikuru kunyange zvino, kana zvichifanira, muchitambudzika kwechinguva chiduku nenzira dzose dzemiedzo.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.6",
            "verseOrgIds": [
              "1PE.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1PE 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izvi zvakauya kuitira kuti kutenda kwenyu, kunokosha kupfuura goridhe, rinoparara kunyange zvaro rakanatswa nomoto, kuwanikwe kwakakwana uye kuve kunorumbidzwa, kunobwinya uye kunokudzwa pakuratidzwa kwaJesu Kristu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.7",
            "verseOrgIds": [
              "1PE.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1PE 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange musina kumuona, munomuda; kunyange zvazvo musingamuoni zvino, munotenda kwaari uye muzere nomufaro usingagoni kurondedzerwa,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.8",
            "verseOrgIds": [
              "1PE.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1PE 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti muri kugamuchira chinovavarirwa nokutenda kwenyu, irwo ruponeso rwemweya yenyu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.9",
            "verseOrgIds": [
              "1PE.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1PE 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nezvoruponeso urwu, vaprofita vakataura nezvenyasha dzaizouya kwamuri, vakanzvera zvikuru uye vakabvunza zvikuru,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.10",
            "verseOrgIds": [
              "1PE.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1PE 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "vachiedza kunzvera kuti vaone nguva nezvinhu zvairatidzwa noMweya wakanga uri mukati mavo pawakaprofita nezvokutambudzika kwaKristu, uye nezvokubwinya kwaizotevera.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.11",
            "verseOrgIds": [
              "1PE.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvakaratidzwa kwavari kuti vakanga vasingazvishumiri ivo, asi imi, pavakataura nezvezvinhu zvakataurwa kwamuri zvino naavo vakaparidza vhangeri kwamuri noMweya Mutsvene wakatumwa uchibva kudenga. Kunyange vatumwa vanoshuva kuona zvinhu izvozvi.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.12",
            "verseOrgIds": [
              "1PE.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ivai Vatsvene",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1PE 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo, pfungwa dzenyu ngadzigadzirire kushanda, muzvidzore; muise, zvizere, tariro yenyu panyasha dzamuchapiwa pakuonekwa kwaJesu Kristu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.13",
            "verseOrgIds": [
              "1PE.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1PE 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Savana vanoteerera, musaenzaniswa nezvido zvakaipa zvamaiva nazvo pamairarama mukusaziva.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.14",
            "verseOrgIds": [
              "1PE.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1PE 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi saiye akakudanai mutsvene, ivai vatsvene pane zvose zvamunoita;",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.15",
            "verseOrgIds": [
              "1PE.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1PE 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti kwakanyorwa kuchinzi: \"Ivai vatsvene, nokuti ini ndiri mutsvene.\"",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.16",
            "verseOrgIds": [
              "1PE.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1PE 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sezvo muchidana kuna Baba vanotonga basa romunhu mumwe nomumwe vasingatsauri, mugare upenyu hwenyu pano savatorwa muchitya.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.17",
            "verseOrgIds": [
              "1PE.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1PE 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti munoziva kuti hamuna kudzikinurwa nezvinhu zvinoora, zvakadai sesirivha kana goridhe, kubva paupenyu hwenyu husina maturo, hwamakagamuchira kubva kumadzitateguru enyu,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.18",
            "verseOrgIds": [
              "1PE.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1PE 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi neropa rinokosha raKristu, iro gwayana risina charingapomerwa uye risina kuremara.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.19",
            "verseOrgIds": [
              "1PE.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1PE 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akasanangurwa kare nyika isati yavapo, asi akaratidzwa kwamuri mumazuva ano okupedzisira nokuda kwenyu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.20",
            "verseOrgIds": [
              "1PE.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1PE 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubudikidza naye munotenda kuna Mwari, akamumutsa kubva kuvakafa uye akamukudza, kuti kutenda kwenyu netariro yenyu zvive muna Mwari.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.21",
            "verseOrgIds": [
              "1PE.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1PE 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino zvamakanatsa mwoyo yenyu nokuteerera chokwadi kuitira kuti mude hama muzvokwadi, munofanira kudanana zvikuru, zvichibva pamwoyo.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.22",
            "verseOrgIds": [
              "1PE.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1PE 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti makaberekwa patsva, kwete nembeu inoora, asi isingaori, neshoko raMwari benyu uye rinogara nokusingaperi.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.23",
            "verseOrgIds": [
              "1PE.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1PE 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.24",
            "verseOrgIds": [
              "1PE.1.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1PE 1:24"
      },
      "items": [
        {
          "text": "\"Vanhu vose vakaita souswa,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.24",
            "verseOrgIds": [
              "1PE.1.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1PE 1:24"
      },
      "items": [
        {
          "text": "uye kuyevedza kwavo kwakaita samaruva ouswa;",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.24",
            "verseOrgIds": [
              "1PE.1.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1PE 1:24"
      },
      "items": [
        {
          "text": "uswa hunosvava uye maruva anowira pasi,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.24",
            "verseOrgIds": [
              "1PE.1.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1PE 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi shoko raShe rinogara nokusingaperi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.25",
            "verseOrgIds": [
              "1PE.1.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "1PE 1:25"
      },
      "items": [
        {
          "text": "Uye iri ndiro shoko ramakaparidzirwa.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.25",
            "verseOrgIds": [
              "1PE.1.25"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "1PE.2",
