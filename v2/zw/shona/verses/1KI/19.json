  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "1KI 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eria anotizira kuHorebhi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Ahabhu akaudza Jezebheri zvose zvakanga zvaitwa naEria nokuuraya kwaakanga aita vaprofita vose nomunondo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.1",
            "verseOrgIds": [
              "1KI.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jezebheri akatuma nhume kuna Eria kundoti, \"Vamwari ngavandirange, vanyanyise kudaro, kana nenguva ino mangwana, ndikasaita kuti upenyu hwako hufanane nehwomumwe wavo.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.2",
            "verseOrgIds": [
              "1KI.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eria akatya akatiza kuti aponese upenyu hwake. Paakasvika kuBheerishebha muJudha, akasiya muranda wake ikoko,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.3",
            "verseOrgIds": [
              "1KI.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "iye pachake akafamba rwendo rwezuva rimwe chete achipinda mugwenga. Akasvika pamuti womurara, akagara pasi pawo akanamata kuti achifa. Akati, \"Zvaringana hazvo, Jehovha. Chitorai upenyu hwangu; handipfuuri madzitateguru angu pakururama.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.4",
            "verseOrgIds": [
              "1KI.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akarara pasi pomuti akabatwa nehope.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.5",
            "verseOrgIds": [
              "1KI.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 19:5"
      },
      "items": [
        {
          "text": "Pakarepo mutumwa akamubata akati, \"Simuka udye.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.5",
            "verseOrgIds": [
              "1KI.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatarisa-tarisa, akaona chingwa chakanga chabikwa pamazimbe omoto pedyo nomusoro wake, nechirongo chemvura. Akadya, akanwa, akabva arara zvakare.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.6",
            "verseOrgIds": [
              "1KI.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutumwa waJehovha akadzoka kechipiri akamubata akati, \"Simuka udye, nokuti rwendo rungakuremera.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.7",
            "verseOrgIds": [
              "1KI.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo akamuka akadya, akanwa. Zvokudya izvozvo zvakamupa simba zvokuti akafamba kwamazuva makumi mana nousiku makumi mana kusvikira asvika paHorebhi, gomo raMwari.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.8",
            "verseOrgIds": [
              "1KI.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akapinda mubako akarara usiku hwose.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.9",
            "verseOrgIds": [
              "1KI.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1",
        "vid": "1KI 19:9"
      },
      "items": [
        {
          "text": "Jehovha anozviratidza kuna Eria",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 19:9"
      },
      "items": [
        {
          "text": "Zvino shoko raJehovha rakasvika kwaari richiti, \"Uri kuiteiko pano, Eria?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.9",
            "verseOrgIds": [
              "1KI.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapindura akati, \"Ndakanga ndichishingairira Jehovha Mwari Wamasimba Ose kwazvo. VaIsraeri vakaramba sungano yenyu, vakaputsa aritari dzenyu, uye vakauraya vaprofita venyu nomunondo. Ndini ndoga ndasara, zvino vava kuedza kundiurayawo.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.10",
            "verseOrgIds": [
              "1KI.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati, \"Buda panze umire pagomo pamberi paJehovha, nokuti Jehovha ari kuda kuzopfuura nepo.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.11",
            "verseOrgIds": [
              "1KI.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 19:11"
      },
      "items": [
        {
          "text": "Ipapo mhepo huru ine simba yakapamura makomo ikapwanya mabwe pamberi paJehovha, asi Jehovha akanga asiri mumhepo. Mushure memhepo, pakava nokudengenyeka kwenyika, asi Jehovha akanga asiri mukudengenyeka ikoko.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.11",
            "verseOrgIds": [
              "1KI.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushure mokudengenyeka kwenyika kwakauya moto, asi Jehovha akanga asiri mumoto. Uye shure kwomoto akanzwa inzwi richitaura nakazevezeve kakapfava.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.12",
            "verseOrgIds": [
              "1KI.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eria paakarinzwa, akafukidza chiso chake nejasi rake akabuda panze akamira pamuromo webako.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.13",
            "verseOrgIds": [
              "1KI.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 19:13"
      },
      "items": [
        {
          "text": "Ipapo inzwi rakati kwaari, \"Uri kuiteiko pano, Eria?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.13",
            "verseOrgIds": [
              "1KI.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapindura akati, \"Ndakanga ndichishingairira Jehovha Mwari Wamasimba Ose kwazvo. VaIsraeri vakaramba sungano yenyu, vakaputsa aritari dzenyu, uye vakauraya vaprofita venyu nomunondo. Ndini ndoga ndasara, zvino vava kuedza kundiurayawo.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.14",
            "verseOrgIds": [
              "1KI.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kwaari, \"Dzokera nenzira yawauya nayo, ugoenda kuGwenga reDhamasiko. Kana wasvikako, uzodze Hazaeri kuti ave mambo weAramu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.15",
            "verseOrgIds": [
              "1KI.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzodzezve Jehu, mwanakomana waNimishi kuti ave mambo weIsraeri, ugozodza Erisha, mwanakomana waShafati wokuAbheri Mehora kuti atore nzvimbo yako somuprofita.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.16",
            "verseOrgIds": [
              "1KI.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehu achauraya vose vachapunyuka munondo waHazaeri, uye Erisha achaurayawo vose vachapunyuka munondo waJehu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.17",
            "verseOrgIds": [
              "1KI.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvakadaro, ndakachengeta zviuru zvinomwe zvavanhu muIsraeri, vose vane mabvi asina kupfugamira Bhaari uye vane miromo isina kumutsvoda.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.18",
            "verseOrgIds": [
              "1KI.19.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kudanwa kwaErisha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo Eria akabvapo akandowana Erisha mwanakomana waShafati. Akanga achirima nehando dzakasungwa pamajoko gumi namaviri, iye achichaira joko regumi namaviri. Eria akaenda kwaari akakanda jasi rake paari.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.19",
            "verseOrgIds": [
              "1KI.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Erisha akasiya hando dzake akamhanya achitevera Eria. Akati, \"Regai ndimbonotsvoda baba namai vangu ndichionekana navo, ndigozoenda nemi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.20",
            "verseOrgIds": [
              "1KI.19.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 19:20"
      },
      "items": [
        {
          "text": "Eria akati, \"Dzokera zvako. Ndakuiteiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.20",
            "verseOrgIds": [
              "1KI.19.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo Erisha akamusiya akadzokera. Akatora hando dzejoko rake akadzibaya. Akashandisa zvaairimisa sehuni dzokubikisa nyama yacho, akaipa kuvanhu, ndokubva vadya. Ipapo akasimuka akatevera Eria akabva ava muranda wake.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.21",
            "verseOrgIds": [
              "1KI.19.21"
            ]
          }
        }
      ]
    }
  ],
