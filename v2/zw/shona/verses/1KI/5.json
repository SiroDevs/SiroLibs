          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Soromoni anogadzirira kuvaka Temberi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiramu mambo weTire akati anzwa kuti Soromoni akanga azodzwa kuti ave mambo panzvimbo yababa vake Dhavhidhi, akatuma nhume dzake kuna Soromoni, nokuti Hiramu akanga agara ano ushamwari naDhavhidhi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.1",
            "verseOrgIds": [
              "1KI.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soromoni akatuma shoko kuna Hiramu akati:",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.2",
            "verseOrgIds": [
              "1KI.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Munoziva kuti nokuda kwehondo dzairwisana nababa vangu Dhavhidhi kubva kumativi ose, haana kuzokwanisa kuvakira Zita raJehovha Mwari wake temberi, kusvikira Jehovha aisa vavengi vake pasi petsoka dzake.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.3",
            "verseOrgIds": [
              "1KI.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi zvino Jehovha Mwari wangu andipa zororo kumativi ose, hapachisina muvengi kana dambudziko.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.4",
            "verseOrgIds": [
              "1KI.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo ndinoda kuvakira zita raJehovha Mwari wangu temberi, sezvo Jehovha akati kuna baba vangu Dhavhidhi, 'Mwanakomana wako, uyo wandichagadza pachigaro choushe panzvimbo yako, achavakira zita rangu temberi iyi.'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.5",
            "verseOrgIds": [
              "1KI.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Naizvozvo chirayirai kuti nditemerwe matanda emisidhari yeRebhanoni. Vanhu vangu vachashanda pamwe chete navanhu venyu uye ndichakuripirai mari yamunenge mati iripirwe vanhu venyu. Munoziva kuti hatina kana munhu mumwe anogona kutema matanda sezvinoitwa navaSidhoni.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.6",
            "verseOrgIds": [
              "1KI.5.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiramu akati anzwa shoko raSoromoni, akafara zvikuru, uye akati, \"Jehovha ngaarumbidzwe nhasi, nokuti apa Dhavhidhi mwanakomana ane uchenjeri kuti atonge rudzi rukuru urwu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.7",
            "verseOrgIds": [
              "1KI.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Hiramu akatuma shoko kuna Soromoni achiti:",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.8",
            "verseOrgIds": [
              "1KI.5.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "1KI 5:8"
      },
      "items": [
        {
          "text": "\"Ndagamuchira shoko ramanditumira navamakatuma uye ndichaita zvose zvamunoda ndigokupai matanda emisidhari nemisipuresi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.8",
            "verseOrgIds": [
              "1KI.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vangu vachatakura kubva kuRebhanoni kusvika kugungwa, uye, ndichaayeredza negungwa kunzvimbo yamunenge masarudza. Ikoko ndichapatsanura kuti mugogona kuatora moenda nawo. Imi mugondiitirawo chishuvo changu mugopa muzinda wangu zvokudya.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.9",
            "verseOrgIds": [
              "1KI.5.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenzira iyi Hiramu akapa Soromoni matanda ose emisidhari nemisipuresi aaida,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.10",
            "verseOrgIds": [
              "1KI.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye Soromoni akapa Hiramu zviyero zviuru makumi maviri",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.11",
            "verseOrgIds": [
              "1KI.5.25"
            ]
          }
        },
        {
          "text": "zvegorosi kuti zvidyiwe mumuzinda wake, pamwe chete nezviyero makumi maviri",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.11",
            "verseOrgIds": [
              "1KI.5.25"
            ]
          }
        },
        {
          "text": "zvamafuta omuorivhi akasvinwa zvakakwana. Soromoni akaramba achiitira Hiramu zvinhu izvi gore negore.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.11",
            "verseOrgIds": [
              "1KI.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akapa Soromoni uchenjeri, sezvaakanga amuvimbisa. Pakati paHiramu naSoromoni pakava norugare, uye vaviri ava vakanyorerana chibvumirano.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.12",
            "verseOrgIds": [
              "1KI.5.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo Soromoni akaunganidza vanhu vechibharo muIsraeri yose, vanhu zviuru makumi matatu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.13",
            "verseOrgIds": [
              "1KI.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akavatumira kuRebhanoni, zviuru gumi pamwedzi, zvokuti vaipedza mwedzi mumwe chete vari kuRebhanoni nemwedzi miviri vari kumusha. Adhoniramu ndiye aiva mukuru wechibharo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.14",
            "verseOrgIds": [
              "1KI.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soromoni aiva navatakuri vezvinhu zviuru makumi manomwe uye vavezi vamatombo zviuru makumi masere mumakomo,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.15",
            "verseOrgIds": [
              "1KI.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamwe chete navatariri vebasa zviuru zvitatu namazana matatu vaitungamirira basa nokuudza vashandi zvokuita.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.16",
            "verseOrgIds": [
              "1KI.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akarayira vakaputsa matombo makuru kwazvo, anokosha, kuti vavake hwaro hwetemberi namatombo akavezwa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.17",
            "verseOrgIds": [
              "1KI.5.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vavaki vaSoromoni, navavaki vaHiramu navaGebhari vakaveza matanda namatombo okuvakisa temberi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.18",
            "verseOrgIds": [
              "1KI.5.32"
            ]
          }
        }
      ]
    }
  ],
