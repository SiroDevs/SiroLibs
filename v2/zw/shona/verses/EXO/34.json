  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "34",
        "style": "c",
        "sid": "EXO 34"
      },
      "items": [
        {
          "text": "34",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mahwendefa matsva amabwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kuna Mozisi, \"Veza matombo maviri amahwendefa akaita seokutanga, uye ndichanyora paari mashoko akanga ari pamahwendefa okutanga, awakaputsa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.1",
            "verseOrgIds": [
              "EXO.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugadzirire mangwanani, uye ipapo ugouya pamusoro peGomo reSinai. Uzviise kwandiri iwe ipapo pamusoro pegomo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.2",
            "verseOrgIds": [
              "EXO.34.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hapana munhu anofanira kuuya newe kana kuonekwa papi zvapo pamusoro peGomo; kunyange makwai kana mombe zvinopfuura pamberi pegomo.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.3",
            "verseOrgIds": [
              "EXO.34.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Mozisi akaveza mahwendefa maviri amabwe akaita seokutanga uye akakwira pamusoro pegomo reSinai mangwanani-ngwanani, sezvaakanga arayirwa naJehovha; uye akatakura mahwendefa maviri amabwe mumaoko ake.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.4",
            "verseOrgIds": [
              "EXO.34.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehovha akaburuka kwaari ari mugore akamira naye ipapo uye akazivisa zita rake, Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.5",
            "verseOrgIds": [
              "EXO.34.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye akapfuura napamberi paMozisi, achizivisa achiti, \"Jehovha, Jehovha, Mwari ane tsitsi nenyasha, anononoka kutsamwa, azere norudo uye akatendeka,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.6",
            "verseOrgIds": [
              "EXO.34.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "anoitira rudo kuzviuru zvamazana, uye achikanganwira zvakaipa, kumukira nechivi. Asi haaregi ane mhosva asingarangwi; anoranga vana navana vavo nokuda kwechivi chamadzibaba avo kusvikira kuchizvarwa chechitatu nechechina.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.7",
            "verseOrgIds": [
              "EXO.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mozisi akakotamira pasi akanamata.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.8",
            "verseOrgIds": [
              "EXO.34.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati, \"Haiwa Jehovha, kana ndawana nyasha pamberi penyu, ipapo Jehovha ngaaende nesu. Kunyange vanhu ava vane mitsipa mikukutu, regererai henyu kuipa kwedu nechivi chedu, uye mutitore senhaka yenyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.9",
            "verseOrgIds": [
              "EXO.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akati, \"Ndava kuita sungano newe. Ndichaita zvishamiso pamberi pavanhu vako zvisina kumboitwa kare mundudzi dzipi zvadzo munyika yose. Vanhu vaunogara pakati pavo vachaona kuti basa randichakuitira ini, Jehovha rinotyisa sei.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.10",
            "verseOrgIds": [
              "EXO.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uteerere zvandinokurayira nhasi. Ndichadzinga pamberi pako vaAmori, vaKenani, vaHiti, vaPerezi, vaHivhi navaJebhusi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.11",
            "verseOrgIds": [
              "EXO.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uchenjerere kuti urege kuita sungano naavo vagere munyika yamunoenda kuti varege kuva musungo pakati penyu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.12",
            "verseOrgIds": [
              "EXO.34.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Putsirai aritari dzavo pasi, pwanyai matombo avo anoyera uye muteme matanda avo aAshera.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.13",
            "verseOrgIds": [
              "EXO.34.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musanamata vamwe vamwari vapi zvavo, nokuti Jehovha, iye ane zita rinonzi Godo, ndiye Mwari ane godo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.14",
            "verseOrgIds": [
              "EXO.34.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uchenjerere kuti urege kuita sungano naavo vanogara munyika; nokuti pavanenge voita ufeve hwavo kuna vamwari vavo uye vakabayira kwavari, vachakukokai uye muchadya zvibayiro zvavo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.15",
            "verseOrgIds": [
              "EXO.34.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye pamunosarudza vamwe vanasikana vavo kuti vave vakadzi vavanakomana venyu uye vanasikana avo vakaita ufeve navamwari vavo, vachatungamirira vanakomana venyu kuita zvimwe chetezvo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.16",
            "verseOrgIds": [
              "EXO.34.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Musaita zvifananidzo zvakaumbwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.17",
            "verseOrgIds": [
              "EXO.34.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mupemberere Mutambo weZvingwa Zvisina Mbiriso. Mudye chingwa chisina mbiriso kwamazuva manomwe, sezvandakurayirai. Muite izvi panguva yakatarwa mumwedzi waAbhibhi, nokuti mumwedzi iwoyo makabuda muIjipiti.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.18",
            "verseOrgIds": [
              "EXO.34.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 34:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Chibereko chose chinotanga kuzarura chizvaro ndechangu, kusanganisira matangwe ose makono ezvipfuwo zvako, dzingava mombe kana makwai.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.19",
            "verseOrgIds": [
              "EXO.34.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 34:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Udzikinure dangwe rembongoro negwayana, asi kana usingaridzikinuri, urivhune mutsipa waro. Udzikinure matangwe ose kuvanakomana venyu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.20",
            "verseOrgIds": [
              "EXO.34.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 34:20"
      },
      "items": [
        {
          "text": "\"Hapana munhu anofanira kumira pamberi pangu asina chinhu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.20",
            "verseOrgIds": [
              "EXO.34.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mubate basa mazuva matanhatu, asi nezuva rechinomwe munofanira kuzorora; kunyange munguva dzokurima nedzokukohwa munofanira kuzorora.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.21",
            "verseOrgIds": [
              "EXO.34.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 34:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mupemberere Mutambo weMavhiki nezvibereko zvokutanga zvegorosi yakohwewa, uye Mutambo woKuunganidza pakupera kwegore.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.22",
            "verseOrgIds": [
              "EXO.34.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 34:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katatu pagore, varume vose vanofanira kumira pamberi paIshe Jehovha, Mwari waIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.23",
            "verseOrgIds": [
              "EXO.34.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichadzinga ndudzi pamberi penyu uye ndichakurisa nyika yenyu, uye hakuna munhu achachiva nyika yenyu pamunokwidzako katatu gore rimwe nerimwe, kuti mumire pamberi paJehovha Mwari wenyu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.24",
            "verseOrgIds": [
              "EXO.34.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 34:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Musapa kwandiri ropa rezvibayiro pamwe chete nechinhu chipi zvacho chine mbiriso, uye musarega chimwe chezvibayiro zvoMutambo wePasika chichisara kusvikira mangwanani.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.25",
            "verseOrgIds": [
              "EXO.34.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Muuyise zvakaisvonaka zvezvibereko zvevhu renyu zvokutanga kuimba yaJehovha Mwari wenyu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.26",
            "verseOrgIds": [
              "EXO.34.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 34:26"
      },
      "items": [
        {
          "text": "\"Musabika mbudzana mumukaka wamai vayo.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.26",
            "verseOrgIds": [
              "EXO.34.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 34:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehovha akati kuna Mozisi, \"Nyora mashoko aya, nokuti maererano namashoko aya ndaita sungano newe uye neIsraeri.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.27",
            "verseOrgIds": [
              "EXO.34.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mozisi akanga ariko kuna Jehovha kwamazuva makumi mana nousiku makumi mana, asingadyi chingwa kana kunwa mvura. Uye akanyora pamahwendefa mashoko esungano, iyo Mirayiro Gumi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.28",
            "verseOrgIds": [
              "EXO.34.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chiso chaMozisi chinobwinya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 34:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mozisi akati aburuka muGomo reSinai aine mahwendefa maviri eChipupuriro mumaoko ake, akanga asingazivi kuti chiso chake chaibwinya nokuti akanga ataura naJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.29",
            "verseOrgIds": [
              "EXO.34.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 34:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni navaIsraeri vose pavakaona Mozisi, chiso chake chakanga chichibwinya, uye vakatya kuswedera pedyo naye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.30",
            "verseOrgIds": [
              "EXO.34.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 34:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Mozisi akavadana; uye Aroni navatungamiri vose vavanhu vakadzokera kwaari, uye akataura navo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.31",
            "verseOrgIds": [
              "EXO.34.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 34:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwaizvozvo vaIsraeri vose vakaswedera pedyo naye akavapa mirayiro yose yaakanga apiwa naJehovha muGomo reSinai.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.32",
            "verseOrgIds": [
              "EXO.34.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 34:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mozisi akati apedza kutaura navo, akaisa chifukidzo pachiso chake.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.33",
            "verseOrgIds": [
              "EXO.34.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 34:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi pose paaipinda paKuvapo kwaJehovha kuti ataure naye, aibvisa chifukidzo kusvikira abuda kunze. Uye aiti paaibuda achiudza vaIsraeri zvaainge arayirwa,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.34",
            "verseOrgIds": [
              "EXO.34.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 34:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "vaiona kuti chiso chake chakanga chichibwinya. Ipapo Mozisi aizoisazve chifukidzo pachiso chake kusvikira apinda kundotaura naJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.35",
            "verseOrgIds": [
              "EXO.34.35"
            ]
          }
        }
      ]
    }
