  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "EXO 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kutsaurwa kwaMatangwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kuna Mozisi,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.1",
            "verseOrgIds": [
              "EXO.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nditsaurire matangwe echirume ose. Chibereko chokutanga chechizvaro pakati pavaIsraeri ndechangu, chingava chomunhu kana chechipfuwo.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.2",
            "verseOrgIds": [
              "EXO.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Mozisi akati kuvanhu, \"Rangarirai zuva iri, iro zuva ramakabuda muIjipiti, munyika youtapwa, nokuti Jehovha akakubudisai mairi noruoko rune simba. Musadya chinhu chine mbiriso.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.3",
            "verseOrgIds": [
              "EXO.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nhasi, mumwedzi waAbhibhi muri kubuda.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.4",
            "verseOrgIds": [
              "EXO.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamunosvitswa naJehovha munyika yavaKenani, vaHiti, vaAmori, vaHivhi, navaJebhusi, iyo nyika yaakapikira madzibaba enyu kuti vazokupai iyo, nyika inoyerera mukaka nouchi, munofanira kucherechedza chirevo ichi mumwedzi uno.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.5",
            "verseOrgIds": [
              "EXO.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwamazuva manomwe munofanira kuitira Jehovha mutambo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.6",
            "verseOrgIds": [
              "EXO.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mudye chingwa chisina mbiriso pamazuva manomwe iwayo; chinhu chine mbiriso hachifaniri kuonekwa pakati penyu, uye mbiriso zvayo haifaniri kuonekwa panzvimbo ipi zvayo pakati pemiganhu yenyu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.7",
            "verseOrgIds": [
              "EXO.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva iroro uudze mwanakomana wako kuti, 'Ndinoita izvi nokuda kwezvandakaitirwa naJehovha pandakabuda muIjipiti.'",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.8",
            "verseOrgIds": [
              "EXO.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mucherechedzo uyu uchava kwauri sechiratidzo paruoko rwako uye sechirangaridzo pahuma yako chokuti murayiro waJehovha unofanira kuva pamiromo yako. Nokuti Jehovha akakubudisa muIjipiti noruoko rwake rune simba.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.9",
            "verseOrgIds": [
              "EXO.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unofanira kuchengeta mutemo uyu panguva dzakatarwa gore negore.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.10",
            "verseOrgIds": [
              "EXO.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Shure kwokunge Jehovha akusvitsa munyika yavaKenani uye aipa kwauri, sezvaakavimbisa nemhiko kwauri nokumadzitateguru ako,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.11",
            "verseOrgIds": [
              "EXO.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "unofanira kupa kuna Jehovha chibereko chokutanga chezvizvaro zvose. Zvikono zvezvipfuwo zvako zvose zvinotanga kuzarura chibereko ndezvaJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.12",
            "verseOrgIds": [
              "EXO.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Udzikinure negwayana mwana wose wokutanga wembongoro, asi kana usingaudzikinuri, uvhune mutsipa wawo. Udzikinure matangwe ose pakati pavanakomana vako.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.13",
            "verseOrgIds": [
              "EXO.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mumazuva anouya, paunenge uchibvunzwa nomwanakomana wako kuti, 'Zvinoreveiko izvi?' uti kwaari, 'Noruoko rune simba Jehovha akatibudisa muIjipiti, munyika youtapwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.14",
            "verseOrgIds": [
              "EXO.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Faro paakasindimara achiramba kuti tiende, Jehovha akauraya matangwe ose omuIjipiti, zvose vanhu nezvipfuwo. Ndokusaka ndichibayira kuna Jehovha mukono wokutanga wechibereko chechizvaro chose uye ndichidzikinura dangwe rimwe nerimwe ravanakomana vangu.'",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.15",
            "verseOrgIds": [
              "EXO.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye chichava chiratidzo paruoko rwako nerundanyara pahuma yako kuti Jehovha akatibudisa kubva muIjipiti noruoko rune simba.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.16",
            "verseOrgIds": [
              "EXO.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuyambuka Gungwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Faro akati atendera vanhu kuti vaende, Mwari haana kuvatungamirira nenzira yaipinda nomunyika yavaFiristia, kunyange zvazvo yakanga iri pfupi. Nokuti Mwari akati, \"Kana vakasangana nehondo, vangashandura pfungwa dzavo vakadzokera kuIjipiti.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.17",
            "verseOrgIds": [
              "EXO.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Mwari akatungamirira vanhu vachipoterera nomumugwagwa womurenje vakananga kuGungwa Dzvuku. VaIsraeri vakabuda kubva muIjipiti vakapakata nhumbi dzehondo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.18",
            "verseOrgIds": [
              "EXO.13.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mozisi akatora mapfupa aJosefa nokuti Josefa akanga aita kuti vanakomana vaIsraeri vapike mhiko. Akanga ati, \"Zvirokwazvo Mwari achakubatsirai, uye ipapo munofanira kutakura mapfupa angu kubva panzvimbo ino.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.19",
            "verseOrgIds": [
              "EXO.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati vabva paSukoti vakadzika musasa paEtamu pamucheto werenje.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.20",
            "verseOrgIds": [
              "EXO.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masikati Jehovha aivatungamirira neshongwe yegore kuti avatungamirire munzira yavo uye usiku aivatungamirira neshongwe yomoto kuti vavhenekerwe, kuti vafambe masikati kana usiku.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.21",
            "verseOrgIds": [
              "EXO.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shongwe yegore masikati kana shongwe yemoto usiku hazvina kubva panzvimbo yazvo pamberi pavanhu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.22",
            "verseOrgIds": [
              "EXO.13.22"
            ]
          }
        }
      ]
    }
  ],
