  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "EXO 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehovha akati kuna Mozisi, \"Zvino uchaona zvandichaita kuna Faro. Nokuda kworuoko rwangu rune simba achavaregera kuti vaende; nokuda kworuoko rwangu rune simba achavadzinga munyika make.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.1",
            "verseOrgIds": [
              "EXO.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari akatiwo kuna Mozisi, \"Ndini Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.2",
            "verseOrgIds": [
              "EXO.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakazviratidza kuna Abhurahama, kuna Isaka, nokuna Jakobho saMwari Wamasimba Ose, asi nezita rangu, Jehovha, handina kuzvizivisa kwavari.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.3",
            "verseOrgIds": [
              "EXO.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakasimbisawo sungano yangu navo kuti ndivape nyika yeKenani, nyika yavakagara savatorwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.4",
            "verseOrgIds": [
              "EXO.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamusoro paizvozvo, ndanzwa kugomera kwavaIsraeri, vakabatwa muutapwa navaIjipita, uye ndarangarira sungano yangu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.5",
            "verseOrgIds": [
              "EXO.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Naizvozvo, uti kuvaIsraeri, 'Ndini Jehovha, uye ndichakubudisai kubva pasi pejoko ravaIjipita. Ndichakusunungurai kuti musava nhapwa kwavari, uye ndichakudzikinurai noruoko rwakatambanudzwa uye nokutonga kwamabasa makuru.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.6",
            "verseOrgIds": [
              "EXO.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichakutorai savanhu vangu, uye ndichava Mwari wenyu. Ipapo muchaziva kuti ndini Jehovha Mwari wenyu, akakubvisai pasi pejoko ravaIjipita.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.7",
            "verseOrgIds": [
              "EXO.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye ndichakuuyisai kunyika yandakapika ndakasimudza ruoko kuna Abhurahama, kuna Isaka nokuna Jakobho. Ndichaipa kwamuri senhaka yenyu. Ndini Jehovha.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.8",
            "verseOrgIds": [
              "EXO.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mozisi akazivisa izvi kuvaIsraeri, asi havana kumuteerera nokuda kwokuora mwoyo kwavo uye nousungwa hune utsinye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.9",
            "verseOrgIds": [
              "EXO.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehovha akati kuna Mozisi,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.10",
            "verseOrgIds": [
              "EXO.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Enda undotaurira Faro mambo weIjipiti kuti arege vaIsraeri vabude munyika yake.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.11",
            "verseOrgIds": [
              "EXO.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Mozisi akati kuna Jehovha, \"Kana vaIsraeri vasinganditeereri, Faro anganditeerera seiko, sezvo ndichitaura nemiromo inokakama?\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.12",
            "verseOrgIds": [
              "EXO.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nhoroondo yemhuri yaMozisi naAroni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Jehovha akataura kuna Mozisi naAroni pamusoro pavaIsraeri napamusoro paFaro mambo weIjipiti, uye akavarayira kuti vabudise vaIsraeri kubva muIjipiti.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.13",
            "verseOrgIds": [
              "EXO.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ava ndivo vaiva vakuru vemhuri dzavo:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "EXO 6:14"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EXO 6:14"
      },
      "items": [
        {
          "text": "Vanakomana vaRubheni mwanakomana wedangwe waIsraeri vaiva Hanoki naParu, Hezironi naKami.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.14",
            "verseOrgIds": [
              "EXO.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "EXO 6:14"
      },
      "items": [
        {
          "text": "Idzi ndidzo dzakanga dziri dzimba dzaRubheni.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaSimeoni vaiva Jemueri, Jamini, Ohadhi, Jakini, Zohari naShauri mwanakomana womukadzi muKenani.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.15",
            "verseOrgIds": [
              "EXO.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "EXO 6:15"
      },
      "items": [
        {
          "text": "Idzi ndidzo dzaiva dzimba dzaSimeoni.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya ndiwo mazita avanakomana vaRevhi maererano nokunyorwa kwawo:",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.16",
            "verseOrgIds": [
              "EXO.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EXO 6:16"
      },
      "items": [
        {
          "text": "Gerishoni, Kohati naMerari.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.16",
            "verseOrgIds": [
              "EXO.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "EXO 6:16"
      },
      "items": [
        {
          "text": "(Revhi akararama makore zana namakumi matatu namanomwe.)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaGerishoni, nedzimba dzavo, vaiva Ribhini naShimei.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.17",
            "verseOrgIds": [
              "EXO.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaKohati vaiva Amurami, Izhari, Hebhuroni naUzieri. Kohati akararama kwamakore zana namakumi matatu namatatu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.18",
            "verseOrgIds": [
              "EXO.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaMerari vaiva Mari naMushi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.19",
            "verseOrgIds": [
              "EXO.6.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "EXO 6:19"
      },
      "items": [
        {
          "text": "Idzi ndidzo dzaiva dzimba dzaRevhi sokunyorwa kwadzo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amurami akawana hanzvadzi yababa vake Jokebhedhi, uyo akamuberekera Aroni naMozisi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.20",
            "verseOrgIds": [
              "EXO.6.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "EXO 6:20"
      },
      "items": [
        {
          "text": "(Amurami akararama kwamakore zana namakumi matatu namanomwe.)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaIzhari vaiva Kora, Nefegi naZikiri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.21",
            "verseOrgIds": [
              "EXO.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaUzieri vaiva Mishaeri, Erizafani naSitiri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.22",
            "verseOrgIds": [
              "EXO.6.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni akawana Erishebha mwanasikana waAminadhabhi nehanzvadzi yaNashoni, uye akamuberekera Nadhabhi naAbhihu, Ereazari naItamari.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.23",
            "verseOrgIds": [
              "EXO.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaKora vaiva Asiri, Erikana naAbhiasafu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.24",
            "verseOrgIds": [
              "EXO.6.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "EXO 6:24"
      },
      "items": [
        {
          "text": "Idzi ndidzo dzaiva dzimba dzavaKora.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ereazari mwanakomana waAroni akawana mumwe wavanasikana vaPutieri, uye akamuberekera Finehazi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.25",
            "verseOrgIds": [
              "EXO.6.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "EXO 6:25"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "EXO 6:25"
      },
      "items": [
        {
          "text": "Ava ndivo vakanga vari vakuru vemhuri dzavaRevhi, mhuri nemhuri.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndivo vaya vanaAroni naMozisi vakanzi naJehovha, \"Budisai vaIsraeri muIjipiti namapoka avo.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.26",
            "verseOrgIds": [
              "EXO.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndivo vakataura kuna Faro mambo weIjipiti pamusoro pokubudisa vaIsraeri kubva muIjipiti. Ndivo vamwe chetevo Mozisi naAroni.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.27",
            "verseOrgIds": [
              "EXO.6.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aroni anotaura akamiririra Mozisi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Jehovha paakataura naMozisi muIjipiti,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.28",
            "verseOrgIds": [
              "EXO.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "akati kwaari, \"Ndini Jehovha. Taurira Faro mambo weIjipiti zvose zvandinokuudza.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.29",
            "verseOrgIds": [
              "EXO.6.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Mozisi akati kuna Jehovha, \"Sezvo ndichitaura nemiromo inokakama, Faro angateerera kwandiri seiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.30",
            "verseOrgIds": [
              "EXO.6.30"
            ]
          }
        }
      ]
    }
