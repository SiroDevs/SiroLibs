  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "DAN 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dhanieri muGomba reShumba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvakafadza Dhariasi kugadza machinda zana namakumi maviri kuti vatonge muushe hwose,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.1",
            "verseOrgIds": [
              "DAN.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "navakuru vatatu vaiva pamusoro pavo, mumwe wavo akanga ari Dhanieri. Machinda aitsanangura zvose pamusoro pemabasa avo kwavari kuti mambo arege kurasikirwa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.2",
            "verseOrgIds": [
              "DAN.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Dhanieri akagona akakunda vakuru namachinda mumaitiro ake aishamisa zvokuti mambo akaronga kumugadza kuti ave pamusoro poumambo hwose.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.3",
            "verseOrgIds": [
              "DAN.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo, vakuru namachinda vakaedza kutsvaka mhosva yavangapomera Dhanieri pamusoro pokufambisa kwake mabasa ehurumende, asi havana chavakagona kuwana. Havana kuwana uori maari, nokuti akanga akatendeka uye pasina uori kana kushaya hanya maari.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.4",
            "verseOrgIds": [
              "DAN.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakupedzisira varume ava vakati, \"Hatingambowani hwaro hwokupomera Dhanieri mhosva kunze kwechinhu chine chokuita nezvomurayiro waMwari wake.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.5",
            "verseOrgIds": [
              "DAN.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vakuru namachinda vakaenda vose pamwe chete kuna mambo vakandoti, \"Haiwa Mambo Dhariasi, raramai nokusingaperi!",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.6",
            "verseOrgIds": [
              "DAN.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakuru voushe vatariri, machinda, navapangi vamazano uye vabati vakatenderana vose kuti mambo ngaateme chirevo nokusimbisa chirevo kuti ani naani anonyengetera kuna mwari upi zvake kana munhu pakati pamazuva makumi matatu, kunze kwokwamuri imi mambo, achakandwa mugomba reshumba.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.7",
            "verseOrgIds": [
              "DAN.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino, imi mambo isai chirevo uye muchinyore kuitira chirege kushandurwa zvinoenderana nemirayiro yavaMedhia navaPezhia, usingagoni kushandurwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.8",
            "verseOrgIds": [
              "DAN.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Mambo Dhariasi akanyora chirevo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.9",
            "verseOrgIds": [
              "DAN.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Dhanieri akati anzwa kuti chirevo chakanga chaziviswa, akaenda muimba yake yapamusoro yaiva namawindo akanga akatarira kuJerusarema. Akapfugama namabvi ake akanyengetera katatu pazuva, achivonga kuna Mwari wake, sezvaaisiita.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.10",
            "verseOrgIds": [
              "DAN.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo varume ava vakaenda vose pamwe chete vakawana Dhanieri achinyengetera, achikumbira kubatsirwa naMwari.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.11",
            "verseOrgIds": [
              "DAN.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vakaenda kuna mambo vakataura naye pamusoro pechirevo chake choushe vachiti, \"Ko, hamuna kuzivisa here chirevo chokuti pakati pamazuva makumi matatu anotevera, ani naani anonyengetera kuna mwari kana munhu upi kunze kwokwamuri, imi mambo, achakandwa mugomba reshumba?\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.12",
            "verseOrgIds": [
              "DAN.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "DAN 6:12"
      },
      "items": [
        {
          "text": "Mambo akapindura akati, \"Chirevo chakadaro chiripo, chinoenderana nomurayiro wavaMedhia navaPezhia, usingagoni kushandurwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.12",
            "verseOrgIds": [
              "DAN.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vakati kuna mambo, \"Dhanieri, mumwe wavakatapwa vakabva Judha, haakuteererei, imi mambo, kana kuchirevo chamakatema norunyoro rwenyu. Achiri kunyengetera katatu pazuva.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.13",
            "verseOrgIds": [
              "DAN.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akati anzwa izvi, akatambudzika zvikuru; akanga achida kurwira Dhanieri uye akaedza nzira dzose dzokumuponesa kusvikira kwadoka.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.14",
            "verseOrgIds": [
              "DAN.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo varume vakaenda vose pamwe chete kuna mambo vakati kwaari, \"Rangarirai imi mambo, kuti maererano nomurayiro wavaMedhia navaPezhia, hakuna chirevo kana mutemo unopiwa namambo unogona kushandurwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.15",
            "verseOrgIds": [
              "DAN.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka mambo akarayira, akauyisa Dhanieri ndokumukanda mugomba reshumba. Mambo akati kuna Dhanieri, \"Mwari wako, waunoramba uchishumira, ngaakurwire!\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.16",
            "verseOrgIds": [
              "DAN.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakauyisa ibwe vakariisa pamusoro pomuromo wegomba, mambo ndokurisimbisa nechisimbiso chake uye nezvisimbiso zvamakurukota ake, kuitira kuti mamiriro aDhanieri arege kushandurwa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.17",
            "verseOrgIds": [
              "DAN.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mambo akadzokera kumuzinda wake akavata usiku hwose asina kudya uye hakuna chinhu chipi chaivaraidza chakauyiswa kwaari. Uye akashayiwa hope.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.18",
            "verseOrgIds": [
              "DAN.6.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva dzamambakwedza, mambo akamuka akamhanyira kugomba reshumba.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.19",
            "verseOrgIds": [
              "DAN.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati aswedera pagomba, akadanidzira kuna Dhanieri nenzwi rokuchema achiti, \"Dhanieri, iwe muranda waMwari mupenyu, Mwari wako, iye waunoshumira nguva dzose, agona kukurwira pamuromo weshumba here?\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.20",
            "verseOrgIds": [
              "DAN.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhanieri akapindura akati, \"Imi mambo, raramai nokusingaperi!",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.21",
            "verseOrgIds": [
              "DAN.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DAN 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari wangu akatuma mutumwa wake, akadzivira miromo yeshumba. Hadzina kundikuvadza, nokuti ndakawanikwa ndisina mhosva pamberi pake. Uye handina kumboita chinhu chakaipa pamberi penyu, imi mambo.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.22",
            "verseOrgIds": [
              "DAN.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akafara zvikuru akarayira kuti Dhanieri abudiswe mugomba. Uye Dhanieri akati abudiswa mugomba, hakuna vanga rakawanikwa paari, nokuti akanga avimba naMwari wake.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.23",
            "verseOrgIds": [
              "DAN.6.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akarayira kuti varume vakanga vapomera Dhanieri varwiswe, uye kuti vakandwe mugomba reshumba, pamwe chete navakadzi vavo navana vavo. Uye vasati vasvika pasi pegomba, shumba dzakavakurira dzikapwanya mapfupa avo ose.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.24",
            "verseOrgIds": [
              "DAN.6.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Mambo Dhariasi akanyorera vanhu vose, nendudzi dzose navanhu vemitauro yose panyika yose achiti:",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.25",
            "verseOrgIds": [
              "DAN.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "DAN 6:25"
      },
      "items": [
        {
          "text": "\"Mubudirire zvikuru kwazvo!",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.25",
            "verseOrgIds": [
              "DAN.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndinotema chirevo chokuti munzvimbo dzose dzoumambo hwangu vanhu vanofanira kutya Mwari waDhanieri uye vamuremekedze.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.26",
            "verseOrgIds": [
              "DAN.6.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "DAN 6:26"
      },
      "items": [
        {
          "text": "\"Nokuti ndiye Mwari mupenyu,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.26",
            "verseOrgIds": [
              "DAN.6.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "DAN 6:26"
      },
      "items": [
        {
          "text": "anogara nokusingaperi;",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.26",
            "verseOrgIds": [
              "DAN.6.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "DAN 6:26"
      },
      "items": [
        {
          "text": "umambo hwake hahungaparadzwi,",
