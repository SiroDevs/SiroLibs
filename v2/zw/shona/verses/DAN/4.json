  "verseCount": 37,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "DAN 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nebhukadhinezari anorota Muti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo Nebhukadhinezari:",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.1",
            "verseOrgIds": [
              "DAN.3.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "DAN 4:1"
      },
      "items": [
        {
          "text": "Kuvanhu, nokundudzi navanhu vemitauro yose, vagere munyika yose:",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.1",
            "verseOrgIds": [
              "DAN.3.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "DAN 4:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "DAN 4:1"
      },
      "items": [
        {
          "text": "Budirirai zvikuru!",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.1",
            "verseOrgIds": [
              "DAN.3.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndafara kwazvo kuti ndikuzivisei zviratidzo nezvinoshamisa zvandakaitirwa naMwari Wokumusoro-soro.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.2",
            "verseOrgIds": [
              "DAN.3.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zviratidzo zvake zvikuru sei,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 4:3"
      },
      "items": [
        {
          "text": "zvishamiso zvake zvine simba sei!",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1",
        "vid": "DAN 4:3"
      },
      "items": [
        {
          "text": "Umambo hwake umambo husingaperi;",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 4:3"
      },
      "items": [
        {
          "text": "kubata kwake ushe kunosvika kuzvizvarwa nezvizvarwa.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ini Nebhukadhinezari ndakanga ndiri mumba mumuzinda wangu, ndakanyatsogutsikana uye ndichinyatsobudirira.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.4",
            "verseOrgIds": [
              "DAN.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakarota hope dzakandityisa. Pandakanga ndivete pamubhedha wangu, zvifananidzo nezviratidzo zvakapinda mupfungwa dzangu zvakandivhundutsa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.5",
            "verseOrgIds": [
              "DAN.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka ndakarayira kuti varume vakachenjera veBhabhironi vauyiswe pamberi pangu kuti vazondidudzira kurota uku.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.6",
            "verseOrgIds": [
              "DAN.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼanga, navaya vanofarira mazango, navazivi vezvenyeredzi navafemberi vakati vauya, ndakavaudza kurota kwangu, asi havana kugona kundidudzira.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.7",
            "verseOrgIds": [
              "DAN.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakupedzisira, Dhanieri akauya pamberi pangu ndikamuudza kurota kwangu. (Ndiye anonzi Bheriteshazari, akapiwa zita ramwari wangu, uye mweya wavamwari vatsvene uri maari.)",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.8",
            "verseOrgIds": [
              "DAN.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakati, \"Bheriteshazari, iwe mukuru wenʼanga, ndinoziva kuti mweya wavamwari vatsvene uri mauri, uye hakuna chakavanzika chinokuomera. Hezvino zvandakarota; chindidudzira.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.9",
            "verseOrgIds": [
              "DAN.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezvino zvandakaratidzwa, zvandakaona ndivete pamubhedha wangu: Ndakatarisa, ndikaona pamberi pangu pamire muti, uri pakati penyika. Kureba kwawo kwakanga kuri kukuru kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.10",
            "verseOrgIds": [
              "DAN.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muti wakakura ukasimba uye manhengenya awo aisvika kudenga; wakanga uchioneka kusvika kumigumo yenyika.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.11",
            "verseOrgIds": [
              "DAN.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mashizha awo akanga akanaka, uye michero yawo yakawanda chose, uye pamusoro pawo pakanga pane zvokudya zvazvose. Mhuka dzesango dzakawana mumvuri pasi pawo, uye shiri dzedenga dzaimhara pamatavi awo; zvipenyu zvose zvaidya pauri.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.12",
            "verseOrgIds": [
              "DAN.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndakaona muzviratidzo, ndakavata pamubhedha wangu, ndikatarisa, ipapo pamberi pangu pakanga pano mutumwa, iye mutsvene, achiburuka kubva kudenga.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.13",
            "verseOrgIds": [
              "DAN.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akadanidzira nenzwi guru achiti, 'Temai muti uyu mugokwanhura matavi awo; pururai mashizha awo mugoparadzira michero yawo. Mhuka ngadzitize pasi pawo, neshiri ngadzibve pamatavi awo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.14",
            "verseOrgIds": [
              "DAN.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi hunde nemidzi yawo, yacho zvakasungwa nesimbi nendarira, ngazvisare muvhu, muuswa hwesango.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.15",
            "verseOrgIds": [
              "DAN.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "DAN 4:15"
      },
      "items": [
        {
          "text": "\" 'Ngaanyoroveswe nedova rokudenga, uye ngaagare nemhuka pakati pemiti yenyika.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.15",
            "verseOrgIds": [
              "DAN.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pfungwa dzake ngadzishandurwe kubva pane dzomunhu uye ngaapiwe pfungwa dzemhuka, kusvikira nguva nomwe dzamuperera.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.16",
            "verseOrgIds": [
              "DAN.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kutonga uku kwaziviswa navatumwa, vatsvene ndivo vareva zvakatongwa, kuitira kuti vapenyu vagoziva kuti Wokumusoro-soro ndiye ishe pamusoro poushe hwavanhu uye anohupa kuna ani naani waanoda anogadza pamusoro pavo munhu wapasipasi.'",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.17",
            "verseOrgIds": [
              "DAN.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndiko kurota kwandakaita, ini Mambo Nebhukadhinezari. Zvino chindiudza zvazvinoreva, iwe, Bheriteshazari, nokuti hakuna varume vakachenjera muushe hwangu vangagona kundidudzira. Asi iwe unogona, nokuti mweya wavamwari vatsvene uri mauri.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.18",
            "verseOrgIds": [
              "DAN.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dhanieri anodudzira Kurota",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Dhanieri (ndiyewo Bheriteshazari) akakatyamara zvikuru kwechinguva uye pfungwa dzake dzakamuvhundutsa. Saka mambo akati kwaari, \"Bheriteshazari, kurota uku kana zvakunoreva ngakurege kukuvhundutsa.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.19",
            "verseOrgIds": [
              "DAN.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "DAN 4:19"
      },
      "items": [
        {
          "text": "Bheriteshazari akapindura achiti, \"Ishe wangu, dai chete kurota uku kwareva vavengi venyu nedudziro yacho vadzivisi venyu!",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.19",
            "verseOrgIds": [
              "DAN.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muti wamakaona, wakakura uye ukasimba, una manhengenya awo anosvika kudenga, unoonekwa pasi pose,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.20",
            "verseOrgIds": [
              "DAN.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "una mashizha akanaka nemichero mizhinji, uchipa zvokudya kuna vose, uchipa mumvuri kumhuka dzesango, uye nenzvimbo dzamatendere eshiri dzedenga pamatavi awo,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.21",
            "verseOrgIds": [
              "DAN.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DAN 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "imi, iyemi mambo, ndimi muti wacho! Mava mukuru uye mune simba; ukuru hwenyu hwakakura kusvika kudenga, uye ushe hwenyu hunosvika kumagumo enyika.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.22",
            "verseOrgIds": [
              "DAN.4.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Imi, iyemi mambo, makaona mutumwa, iye mutsvene, achiburuka kubva kudenga achiti, 'Temai muti uyo muuparadze, asi musiye hunde, yakasungwa nesimbi nendarira, mukati mebundo resango, asi midzi yawo iri muvhu. Ngaanyoroveswe nedova redenga; ngaararame semhuka dzesango, kusvikira nguva nomwe dzamuperera.'",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.23",
            "verseOrgIds": [
              "DAN.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uku ndiko kududzirwa kwazvo, imi mambo, ichi ndicho chirevo cheWokumusoro-soro chapiwa pamusoro penyu, ishe wangu mambo:",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.24",
            "verseOrgIds": [
              "DAN.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muchadzingwa pakati pavanhu uye muchagara nemhuka dzesango; muchadya bundo semombe uye muchanyoroveswa nedova redenga. Nguva nomwe dzichakupfuurai kusvikira maziva kuti Wokumusoro-soro ndiye ishe pamusoro poushe hwavanhu uye anohupa kuna ani zvake waanenge ada.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.25",
            "verseOrgIds": [
              "DAN.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvakarayirwa kuti hunde yomuti nemidzi yawo zvirambe zviripo zvinoreva kuti umambo hwenyu huchavandudzwa pamuchayeuka kuti denga rinotonga.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.26",
            "verseOrgIds": [
              "DAN.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo, imi mambo, farirai kugamuchira zvandinokurayirai: Siyai zvivi zvenyu nokuita zvakarurama, uye kuipa kwenyu nokuitira zvakanaka vanomanikidzwa. Zvimwe zvingaitika kuti ipapo kubudirira kwenyu kuchaenderera mberi.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.27",
            "verseOrgIds": [
              "DAN.4.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chiroto Chinozadziswa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DAN 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvose izvi zvakaitika kuna Mambo Nebhukadhinezari.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.28",
            "verseOrgIds": [
              "DAN.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DAN 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwemwedzi gumi nemiviri, mambo paakanga achifamba pamusoro pedenga romuzinda wamambo weBhabhironi,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.29",
            "verseOrgIds": [
              "DAN.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DAN 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "akati, \"Ko, iri harizi Bhabhironi guru randakavaka sougaro hwoushe, nesimba rangu guru uye nokuda kwokubwinya kwoushe hwangu here?\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.30",
            "verseOrgIds": [
              "DAN.4.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DAN 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mashoko akanga achiri mumuromo make pakauya inzwi richibva kudenga richiti, \"Hezvino zvawatemerwa, iwe Mambo Nebhukadhinezari: Simba roumambo hwako rabviswa kwauri.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.31",
            "verseOrgIds": [
              "DAN.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DAN 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uchadzingwa pakati pavanhu uye uchagara nemhuka dzesango; uchadya uswa semombe. Nguva nomwe dzichakuperera kusvikira waziva kuti Wokumusoro-soro ndiye Ishe pamusoro poushe hwavanhu uye kuti anohupa kuna ani zvake waanenge ada.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.32",
            "verseOrgIds": [
              "DAN.4.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DAN 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakarepo, zvakanga zvarehwa pamusoro paNebhukadhinezari zvakazadzisika. Akadzingwa pakati pavanhu akafura uswa semombe. Muviri wake wakanyoroveswa nedova redenga kusvikira bvudzi rake rareba seminhenga yegondo uye nzara dzake dzafanana nedzeshiri.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.33",
            "verseOrgIds": [
              "DAN.4.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "DAN 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nguva iyoyo yakati yapera, ini, Nebhukadhinezari, ndakasimudzira meso angu kudenga, uye pfungwa dzangu dzakadzoredzerwa. Ipapo ndakarumbidza Wokumusoro-soro; ndakamuremekedza uye ndikamukudza iye anogara nokusingaperi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.34",
            "verseOrgIds": [
              "DAN.4.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1",
        "vid": "DAN 4:34"
      },
      "items": [
        {
          "text": "Ushe hwake hahuperi;",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 4:34"
      },
      "items": [
        {
          "text": "umambo hwake hunogara kubva kuchizvarwa kusvikira kune chimwe chizvarwa.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "DAN 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vose venyika",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 4:35"
      },
      "items": [
        {
          "text": "vanoonekwa sevasina maturo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1",
        "vid": "DAN 4:35"
      },
      "items": [
        {
          "text": "Iye anoita sezvaanoda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 4:35"
      },
      "items": [
        {
          "text": "namasimba okudenga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 4:35"
      },
      "items": [
        {
          "text": "uye navanhu venyika.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1",
        "vid": "DAN 4:35"
      },
      "items": [
        {
          "text": "Hakuna munhu angakonesa ruoko rwake",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 4:35"
      },
      "items": [
        {
          "text": "kana kuti kwaari, \"Waiteiko?\"",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "DAN 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva yacho iyoyo yakavandudzwa pfungwa dzangu, kukudzwa kwangu nokubwinya kwangu kwakadzorerwa kwandiri nokuda kwokubwinya kwoushe hwangu. Vanamupamazano vangu namakurukota vakanditsvaka, uye ndakadzorerwazve pachigaro changu choushe ndikava mukuru kunyange kupfuura kare.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.36",
            "verseOrgIds": [
              "DAN.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "DAN 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino ini Nebhukadhinezari, ndinorumbidza, ndinosimudzira uye ndinokudza Mambo wokudenga, nokuti zvose zvaanoita zvakarurama uye nzira dzake dzose dzakarurama. Uye iye anogona kuninipisa vaya vanofamba mukuzvikudza.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.37",
            "verseOrgIds": [
              "DAN.4.34"
            ]
          }
        }
      ]
    }
  ],
