        "sid": "2KI 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Josia anovandudza Sungano",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mambo akaunganidza vakuru vose veJudha neJerusarema pamwe chete.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.1",
            "verseOrgIds": [
              "2KI.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akakwidza achienda kutemberi yaJehovha navarume veJudha, navanhu veJerusarema, vaprista navaprofita, navanhu vose kubva kuvaduku kusvikira kuvakuru. Akaverenga vachinzwa mashoko ose eBhuku reSungano, rakanga rawanikwa mutemberi yaJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.2",
            "verseOrgIds": [
              "2KI.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akamira pambiru akavandudza sungano pamberi paJehovha, kuti atevere Jehovha uye achengete zvaakarayira, nezvaakatema nemitemo yake nomwoyo wake wose, nomweya wake wose nokudaro achisimbisa mashoko esungano akanyorwa mubhuku iri. Ipapo vanhu vose vakazvipira kusungano.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.3",
            "verseOrgIds": [
              "2KI.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino mambo akarayira Hirikia muprista mukuru, navaprista vaimutevera paukuru navarindi vemikova kuti vabvise mutemberi yaJehovha zvose zvakanga zvaitirwa Bhaari naAshera nenyeredzi dzose dzokudenga. Akazvipisira kunze kweJerusarema muminda yoMupata weKidhironi, akaendesa madota azvo kuBheteri.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.4",
            "verseOrgIds": [
              "2KI.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabvisa vaprista vezvifananidzo vakanga vagadzwa namadzimambo eJudha kuti vapisire zvinonhuhwira pamatunhu akakwirira amaguta eJudha napamusoro penzvimbo dzakapoteredza Jerusarema, vaya vaipisira zvinonhuhwira kuna Bhaari, nokuzuva nomwedzi nokunyeredzi dzose dzokudenga.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.5",
            "verseOrgIds": [
              "2KI.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabvisa danda raAshera mutemberi yaJehovha akariisa kuMupata weKidhironi kunze kweJerusarema akaripisirako. Akarikuya rikava madota, akaparadzira madota acho pamusoro pamarinda avanhuwo zvavo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.6",
            "verseOrgIds": [
              "2KI.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaputsawo dzimba dzezvifeve zvavarume zvapatemberi dzaiva mutemberi yaJehovha mairukira vakadzi machira aAshera.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.7",
            "verseOrgIds": [
              "2KI.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josia akabudisa vaprista vose vaibva mumaguta eJudha akashatisa matunhu akakwirira, kubva kuGebha kusvikira kuBheerishebha, kwaipisirwa zvinonhuhwira navaprista. Akaputsa dzimba dzapamatunhu akakwirira apamasuo apamukova weSuo raJoshua, mutongi weguta, raiva kuruboshwe rwesuo reguta.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.8",
            "verseOrgIds": [
              "2KI.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvazvo vaprista vamatunhu akakwirira vakanga vasingashumiri paaritari yaJehovha muJerusarema, vakadya zvingwa zvisina mbiriso pamwe chete nehama dzavo vaprista.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.9",
            "verseOrgIds": [
              "2KI.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akashatisa Tofeti iri muMupata weBheni Hinomi, kuitira kuti pasava nomunhu angapashandisa kubayira mwanakomana wake kana mwanasikana wake mumoto kuna Moreki.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.10",
            "verseOrgIds": [
              "2KI.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabvisa pasuo retemberi yaJehovha mabhiza akanga akumikidzwa kuzuva namadzimambo eJudha, akanga ari muchivanze pedyo nekamuri romubati ainzi Natani-Mereki. Ipapo Josia akapisa ngoro dzakanga dzakakumikidzwa kuzuva.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.11",
            "verseOrgIds": [
              "2KI.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaputsira pasi aritari dzakanga dzavakwa namadzimambo eJudha pamusoro pedenga, pedyo nekamuri rapamusoro raAhazia, nearitari dzakanga dzavakwa naManase muzvivanze zviviri zvetemberi yaJehovha. Akadzibvisapo, akadziputsa-putsa uye akakanda marara acho muMupata weKidhironi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.12",
            "verseOrgIds": [
              "2KI.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akashatisawo matunhu akakwirira akanga ari kumabvazuva kweJerusarema nechezasi kweChikomo choUori, izvo zvakanga zvavakwa naSoromoni mambo weIsraeri achivakira Ashitoreti mwari anonyangadza wavaSidhoni naKemoshi mwari anonyangadza wavaMoabhu, naMoreki mwari anonyangadza wavaAmoni.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.13",
            "verseOrgIds": [
              "2KI.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josia akaputsa-putsa shongwe dzamatombo aiera akatema matanda aAshera akafukidza nzvimbo dzacho namapfupa avanhu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.14",
            "verseOrgIds": [
              "2KI.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamusoro paizvozvo, akaparadza aritari paBheteri nenzvimbo yakakwirira yakaitwa naJerobhoamu mwanakomana waNebhati, uyo akaita kuti Israeri itadze, kunyange aritari iyoyo nenzvimbo yakakwirira akazviputsa. Akapisa nzvimbo yakakwirira akaikuya kuita upfu, uye akapisawo danda raAshera.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.15",
            "verseOrgIds": [
              "2KI.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Josia akatarira-tarira uye paakaona makuva akanga aripo pamusoro pechikomo, akarayira kuti mapfupa abviswe maari uye apiswe paaritari kuti aishatise, maererano neshoko raJehovha rakaparidzwa nomunhu waMwari akaprofita zvinhu izvi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.16",
            "verseOrgIds": [
              "2KI.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akabvunza akati, \"Ko, shongwe yeguva yandinoona iyo ndeyani?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.17",
            "verseOrgIds": [
              "2KI.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 23:17"
      },
      "items": [
        {
          "text": "Varume vomuguta vakati, \"Ndiyo inoratidza guva romunhu waMwari akabva kuJudha akaprofita pamusoro pearitari yeBheteri nezvinhu izvi zvamaita kwairi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.17",
            "verseOrgIds": [
              "2KI.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye akati, \"Regai azorore. Ngakurege kuva nomunhu anokanganisa mapfupa ake.\" Naizvozvo vakarega mapfupa ake pamwe chete neomuprofita akanga abva kuSamaria.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.18",
            "verseOrgIds": [
              "2KI.23.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josia akaita zvimwe chetezvo sezvaakanga aita paBheteri akabvisa uye akashatisa temberi dzose dzapamatunhu akakwirira dzakanga dzavakwa namadzimambo eIsraeri mumaguta eSamaria, akanga atsamwisa Jehovha,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.19",
            "verseOrgIds": [
              "2KI.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josia akauraya vaprista vose vokumatunhu akakwirira pamusoro pearitari uye akapisirapo mapfupa avanhu. Ipapo akabva adzokera kuJerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.20",
            "verseOrgIds": [
              "2KI.23.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akarayira vanhu vose akati, \"Itirai Jehovha Mwari wenyu Pasika sezvazvakanyorwa muBhuku iri reSungano.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.21",
            "verseOrgIds": [
              "2KI.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuna kumbova nepasika yakadai kubvira pamazuva avatongi vakatungamirira Israeri kana pamazuva amadzimambo avaIsraeri, namadzimambo eJudha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.22",
            "verseOrgIds": [
              "2KI.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi mugore regumi namasere raMambo Josia, pasika iyi yakaitirwa Jehovha muJerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.23",
            "verseOrgIds": [
              "2KI.23.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamusoro paizvozvo, Josia akabvisa masvikiro ose navavuki, navaiita zvemidzimu, nezvifananidzo nezvimwe zvose zvinonyangadza zvaionekwa muJudha nomuJerusarema. Akaita izvi kuti azadzise zvaidikanwa nomurayiro wakanga wakanyorwa mubhuku rakanga rakawanikwa nomuprista Hirikia mutemberi yaJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.24",
            "verseOrgIds": [
              "2KI.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hapana kumbova namambo akaita saJosia kuna vakamutangira kana vakamutevera, akatendeukira kuna Jehovha nomwoyo wake wose, nomweya wake wose, uye nesimba rake rose, sezvaakaita achitevera Murayiro wose waMozisi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.25",
            "verseOrgIds": [
              "2KI.23.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvakadaro, Jehovha haana kushanduka pakupisa kwehasha dzake dzinotyisa, dzaipisira Judha nokuda kwezvose zvakaitwa naManase achimutsamwisa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.26",
            "verseOrgIds": [
              "2KI.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo Jehovha akati, \"Ndichabvisawo Judha pamberi pangu sokubvisa kwandakaita Israeri, uye ndicharamba Jerusarema, guta randakasarudza, netemberi iyi, yandakataura pamusoro payo ndichiti, 'Zita rangu richagarapo.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.27",
            "verseOrgIds": [
              "2KI.23.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana zviri zvimwe zvakaitika pakutonga kwaJosia, nezvose zvaakaita, hazvina kunyorwa here mubhuku renhoroondo dzamadzimambo eJudha?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.28",
            "verseOrgIds": [
              "2KI.23.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josia paakanga ari mambo, Faro Neko mambo weIjipiti akaenda kuRwizi Yufuratesi kuti andobatsira mambo weAsiria. Mambo Josia akaenda kundorwisana naye, asi Neko akamuona akamuuraya paMegidho.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.29",
            "verseOrgIds": [
              "2KI.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varanda vaJosia vakatakura mutumbi wake mungoro kubva kuMegidho kusvika kuJerusarema vakamuviga muguva rake. Vanhu vomunyika imomo vakatora Jehoahazi mwanakomana waJosia vakamuzodza uye vakamuita mambo panzvimbo yababa vake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.30",
            "verseOrgIds": [
              "2KI.23.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jehoahazi Mambo weJudha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoahazi akanga ava namakore makumi maviri namatatu paakava mambo, akatonga kwemwedzi mitatu muJerusarema. Zita ramai vake rainzi Hamutari mwanasikana waJeremia, vaibva kuRibhina.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.31",
            "verseOrgIds": [
              "2KI.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaita zvakaipa pamberi paJehovha, sezvakanga zvaitwa namadzibaba ake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.32",
            "verseOrgIds": [
              "2KI.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Faro Neko akamusunga nengetani paRibhira munyika yeHamati kuti asatonga muJerusarema, uye akaisa mutero pamusoro peJudha wamatarenda zana",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.33",
            "verseOrgIds": [
              "2KI.23.33"
            ]
          }
        },
        {
          "text": "esirivha netarenda",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.33",
            "verseOrgIds": [
              "2KI.23.33"
            ]
          }
        },
        {
          "text": "regoridhe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.33",
            "verseOrgIds": [
              "2KI.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Faro Neko akagadza Eriakimi mwanakomana waJosia kuti ave mambo panzvimbo yababa vake uye Josia akashandura zita raEriakimi kuti rive Jehoyakimi. Asi akatora Jehoahazi akaenda naye kuIjipiti, uye ndiko kwaakafira.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.34",
            "verseOrgIds": [
              "2KI.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoyakimi akapa Faro Neko sirivha negoridhe sezvaakanga areva. Kuti aite izvozvo, akaripisa vanhu vomunyika imomo mutero achitora sirivha negoridhe kubva kuvanhu venyika maererano nezvavakanga vatarirwa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.35",
            "verseOrgIds": [
              "2KI.23.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jehoyakimi anova Mambo weJudha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoyakimi akanga ava namakore makumi maviri namashanu paakava mambo, uye akatonga kwamakore gumi nerimwe muJerusarema. Zita ramai vake rainzi Zebhidha mwanasikana waPedhaya; vaibva kuRuma.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.36",
            "verseOrgIds": [
              "2KI.23.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 23:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaita zvakaipa pamberi paJehovha, sezvakanga zvaitwa namadzibaba ake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.37",
            "verseOrgIds": [
              "2KI.23.37"
            ]
          }
        }
      ]
    }
