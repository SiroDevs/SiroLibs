  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "2KI 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jehovha anotonga Ahazia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushure mokufa kwaAhabhu, vaMoabhu vakamukira Israeri.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.1",
            "verseOrgIds": [
              "2KI.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Ahazia akanga awira pasi napawindo rekamuri reimba yake yapamusoro kuSamaria akakuvara. Saka akatuma nhume akati kwavari, \"Endai mundobvunza Bhaari-Zebhubhi, mwari weEkironi, kuti aone kana ndichizopora pakukuvara uku.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.2",
            "verseOrgIds": [
              "2KI.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi mutumwa waJehovha akati kuna Eria muTishibhi, \"Kwira kumusoro undosangana nenhume dzamambo weSamaria uti kwavari, 'Imhaka yokuti muIsraeri hamuna Mwari here zvamunondobvunza Bhaari-Zebhubhi, mwari weEkironi?'",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.3",
            "verseOrgIds": [
              "2KI.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo zvanzi naJehovha: 'Hauchabva pamubhedha pawakarara ipapo. Zvirokwazvo uchafa!' \" Naizvozvo Eria akaenda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.4",
            "verseOrgIds": [
              "2KI.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nhume dzakati dzadzokera kuna mambo, akavabvunza akati, \"Madzokereiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.5",
            "verseOrgIds": [
              "2KI.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivo vakamupindura vakati, \"Mumwe murume akauya akasangana nesu. Zvino akati kwatiri, 'Dzokerai kuna mambo akutumai mundoti kwaari, \"Zvanzi naJehovha: Imhaka yokuti muIsraeri hamuna Mwari here zvaunotuma nhume kundobvunza Bhaari-Zebhubhi, mwari weEkironi? Naizvozvo hauchaburuki pamubhedha pawakarara ipapo. Zvirokwazvo uchafa!\" ' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.6",
            "verseOrgIds": [
              "2KI.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akavabvunza akati, \"Ko, murume akauya akasangana nemi akakutaurirai izvi akanga akadini?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.7",
            "verseOrgIds": [
              "2KI.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivo vakapindura vakati, \"Akanga ari murume akapfeka nguo dzine mvere nebhanhire reganda muchiuno chake.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.8",
            "verseOrgIds": [
              "2KI.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 1:8"
      },
      "items": [
        {
          "text": "Mambo akati, \"NdiEria muTishibhi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.8",
            "verseOrgIds": [
              "2KI.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akatuma mukuru weboka ravarume makumi mashanu navanhu vake kuna Eria. Mukuru uyu akaenda kuna Eria akanga akagara pamusoro pechikomo, ndokuti kwaari, \"Munhu waMwari, zvanzi namambo, 'Burukai!' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.9",
            "verseOrgIds": [
              "2KI.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eria akamupindura akati, \"Kana ndiri munhu waMwari, moto ngauburuke uchibva kudenga ukuparadze iwe navanhu vako makumi mashanu!\" Ipapo moto wakaburuka uchibva kudenga ukamuparadza iye navanhu vake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.10",
            "verseOrgIds": [
              "2KI.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvadaro mambo akazotumazve mumwe mukuru weboka ravarume makumi mashanu navanhu vake makumi mashanu! Mukuru uyu akati kuna Eria, \"Munhu waMwari, zvanzi namambo, 'Burukai izvozvi!' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.11",
            "verseOrgIds": [
              "2KI.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eria akati kwaari, \"Kana ndiri munhu waMwari, moto ngauburuke uchibva kudenga ukuparadze iwe navanhu vako vana makumi mashanu.\" Ipapo moto waMwari wakaburuka uchibva kudenga ukamuparadza iye navanhu vake makumi mashanu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.12",
            "verseOrgIds": [
              "2KI.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka mambo akatumazve mumwe mukuru wechitatu ana varume makumi mashanu. Uyu mukuru wechitatu akakwira akazviwisira pasi namabvi ake pamberi paEria. Akamukumbira akati, \"Haiwa, munhu waMwari, ndapota, upenyu hwangu nohwavarume ava makumi mashanu, isu varanda venyu, ngahuve hunokosha pamberi penyu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.13",
            "verseOrgIds": [
              "2KI.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tarirai moto wakabva kudenga ukaparadza vakuru vaviri vokutanga navanhu vavo vose. Asi zvino upenyu hwangu ngahuve chinhu chinokosha pamberi penyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.14",
            "verseOrgIds": [
              "2KI.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino mutumwa waJehovha akati kuna Eria, \"Buruka pamwe chete naye; usamutya.\" Naizvozvo Eria akasimuka akaenda naye kuna mambo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.15",
            "verseOrgIds": [
              "2KI.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaudza mambo kuti, \"Zvanzi naJehovha: Imhaka yokuti muIsraeri hamuna Mwari here zvawatuma nhume kundobvunza Bhaari-Zebhubhi, mwari weEkironi? Nokuti waita izvi, hauchambobva pamubhedha pawakarara. Zvirokwazvo uchafa!\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.16",
            "verseOrgIds": [
              "2KI.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo akafa, sezvakanga zvarehwa neshoko raJehovha rakataurwa naEria.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.17",
            "verseOrgIds": [
              "2KI.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 1:17"
      },
      "items": [
        {
          "text": "Nokuti Ahazia akanga asina mwanakomana, Joramu akazomutevera paushe pagore rechipiri raJehoramu, mwanakomana waJehoshafati, mambo weJudha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.17",
            "verseOrgIds": [
              "2KI.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino, mabasa akaitwa pamazuva okutonga kwaAhazia, nezvaakaita iye hazvina kunyorwa here mubhuku renhoroondo dzamadzimambo eIsraeri?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.18",
            "verseOrgIds": [
              "2KI.1.18"
            ]
          }
        }
      ]
    }
  ],
