  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "1CH 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dhavhidhi anoverenga varwi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Satani akamukira Israeri akakurudzira Dhavhidhi kuti averenge vaIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.1",
            "verseOrgIds": [
              "1CH.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Dhavhidhi akati kuna Joabhu navatungamiri vamapoka avarwi, \"Endai mundoverenga vaIsraeri vose kubva kuBheerishebha kusvikira kuDhani. Uye mugozondiudza kuitira kuti ndizive kuti vangani variko.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.2",
            "verseOrgIds": [
              "1CH.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Joabhu akapindura akati, \"Jehovha ngavawedzere uwandu hwavarwi vake kakapetwa kazana. Ishe wangu mambo, ava vose havasi pasi petsoka dzenyu here? Seiko ishe wangu muchida kuita izvi? Sei muchida kuuyisa mhosva kuna Israeri?\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.3",
            "verseOrgIds": [
              "1CH.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvisinei, shoko ramambo rakakunda raJoabhu, saka Joabhu akabvapo akaenda muIsraeri yose uye akadzokera kuJerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.4",
            "verseOrgIds": [
              "1CH.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joabhu akataurira Dhavhidhi uwandu hwavarwi achiti muIsraeri yose maiva navanhu vaigona kubata munondo vaisvika miriyoni nezana rezviuru zvavarume, vachisanganisira zviuru mazana mana nemakumi manomwe muJudha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.5",
            "verseOrgIds": [
              "1CH.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Joabhu haana kusanganisira Revhi naBhenjamini mukuverenga uku, nokuti kurayira kwamambo kwakanga kwakaipa kwazvo kwaari.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.6",
            "verseOrgIds": [
              "1CH.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurayira uku kwakanga kwakaipawo pamberi paMwari, saka akaranga Israeri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.7",
            "verseOrgIds": [
              "1CH.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Dhavhidhi akati kuna Mwari, \"Ndakatadza zvikuru pandakaita chinhu ichi. Zvino ndinokumbirawo kuti mubvise kuipa kwomuranda wenyu. Ndakaita sebenzi kwazvo.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.8",
            "verseOrgIds": [
              "1CH.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kuna Gadhi muoni waDhavhidhi,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.9",
            "verseOrgIds": [
              "1CH.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Enda undotaurira Dhavhidhi kuti, 'Zvanzi naJehovha: Ndinokupa zvinhu zvitatu zvokusarudza. Zvisarudzire chaunoda kuti ndikuitire ndichikuranga.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.10",
            "verseOrgIds": [
              "1CH.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Gadhi akaenda kuna Dhavhidhi akati kwaari, \"Zvanzi naJehovha: 'Sarudza pakati peizvi:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.11",
            "verseOrgIds": [
              "1CH.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makore matatu enzara, mwedzi mitatu yokutsvairwa pamberi pavavengi vako, minondo yavo ichikuparadzai, kana kuti mazuva matatu omunondo waJehovha, mazuva edenda munyika mutumwa waJehovha achiparadza panyika yose yaIsraeri.' Zvino saka zvisarudzirei kuti ndinganopindura sei uyo akandituma.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.12",
            "verseOrgIds": [
              "1CH.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akati kuna Gadhi, \"Ndiri mukutambudzika kukuru kwazvo. Rega hako ndiwire mumaoko aJehovha nokuti tsitsi dzake dzakakura kwazvo, asi musandirega ndichiwira mumaoko avanhu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.13",
            "verseOrgIds": [
              "1CH.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Jehovha akatumira denda muIsraeri uye zviuru makumi manomwe zvavarume veIsraeri vakawira pasi vakafa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.14",
            "verseOrgIds": [
              "1CH.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Jehovha akatuma mutumwa kuti aparadze Jerusarema, asi mutumwa uya paakanga achiita izvi Jehovha akazviona uye akazvidemba nokuda kwedambudziko iri akati kumutumwa aiparadza vanhu, \"Zvakwana! Dzosa ruoko rwako.\" Mutumwa waJehovha ipapo akanga akamira paburiro raArauna muJebhusi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.15",
            "verseOrgIds": [
              "1CH.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akatarisa kumusoro akaona mutumwa waJehovha akamira pakati pedenga nenyika, aine munondo muruoko rwake akarutambanudzira pamusoro peJerusarema. Ipapo Dhavhidhi navakuru vose vakapfeka masaga, vakawira pasi vakatsikitsira zviso zvavo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.16",
            "verseOrgIds": [
              "1CH.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akati kuna Mwari, \"Handisini here ndakarayira kuti varwi vose vaverengwe? Ndini ndakatadza ndikaita zvakaipa, ava vanongova makwai chete. Vakaiteiko? Haiwa Jehovha, Mwari wangu, regai ruoko rwenyu ruwire pandiri ini nemhuri yangu, asi musarega denda iri riri pamusoro pavanhu venyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.17",
            "verseOrgIds": [
              "1CH.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mutumwa waJehovha akarayira Gadhi kuti ataurire Dhavhidhi kuti akwire andovakira Jehovha aritari muburiro raArauna muJebhusi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.18",
            "verseOrgIds": [
              "1CH.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Dhavhidhi akakwidza mukuteerera shoko rakanga rataurwa naGadhi muzita raJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.19",
            "verseOrgIds": [
              "1CH.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arauna paakanga achipura zviyo, akacheuka akaona mutumwa; vanakomana vake vana vaaiva navo vakanohwanda.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.20",
            "verseOrgIds": [
              "1CH.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Dhavhidhi akaswedera, uye Arauna paakatarisa akamuona, akasiya buriro akakotamira pasi pamberi paDhavhidhi akaisa chiso chake pasi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.21",
            "verseOrgIds": [
              "1CH.21.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akati kwaari, \"Ndipewo nzvimbo yeburiro rako kuti ndigovakira Jehovha aritari, kuti denda riri pavanhu rimiswe. Nditengeserewo nomutengo waro wakazara.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.22",
            "verseOrgIds": [
              "1CH.21.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arauna akati kuna Dhavhidhi, \"Ritorei henyu! Ishe wangu mambo ngavaite zvinovafadza. Tarirai ndichakupai nzombe yezvibayiro zvinopiswa, matanda okupurisa dzive huni, uye zviyo zvive zvipiriso zvoupfu. Ndichakupai zvose izvi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.23",
            "verseOrgIds": [
              "1CH.21.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi mambo Dhavhidhi akapindura Arauna akati, \"Kwete, ndinoda kutenga nomutengo wakazara. Handingatori ndichipa Jehovha zvinhu zvako iwe kana kubayira chipiriso chinopiswa chandisina kuripira.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.24",
            "verseOrgIds": [
              "1CH.21.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Dhavhidhi akaripira Arauna mashekeri mazana matanhatu",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.25",
            "verseOrgIds": [
              "1CH.21.25"
            ]
          }
        },
        {
          "text": "egoridhe kuti apiwe nzvimbo iyi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.25",
            "verseOrgIds": [
              "1CH.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akavaka aritari kuna Jehovha ipapo uye akapa zvipiriso zvinopiswa nezvipiriso zvokuwadzana. Akadana kuna Jehovha uye Jehovha akamupindura nomoto wakabva kudenga ukaenda paaritari yezvipiriso zvinopiswa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.26",
            "verseOrgIds": [
              "1CH.21.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehovha akataurira mutumwa iye akadzorera munondo wake mumuhara wawo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.27",
            "verseOrgIds": [
              "1CH.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva iyoyo Dhavhidhi paakaona kuti Jehovha akanga amupindura paburiro raArauna muJebhusi, akapa zvipiriso ipapo.",
