  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "1CH 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Imba yaDhavhidhi neMhuri Yake",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Hiramu mambo weTire akatuma nhume kuna Dhavhidhi namatanda emisidhari navavaki, navavezi, kuti vamuvakire imba youmambo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.1",
            "verseOrgIds": [
              "1CH.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Dhavhidhi akaziva kuti Jehovha akanga amusimbisa samambo pamusoro peIsraeri uye kuti umambo hwake hwakanga hwakudzwa kwazvo nokuda kwavanhu vake Israeri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.2",
            "verseOrgIds": [
              "1CH.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "MuJerusarema, Dhavhidhi akazvitorerazve vamwe vakadzi akava baba vavanakomana navanasikana vazhinji.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.3",
            "verseOrgIds": [
              "1CH.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya ndiwo mazita avana vaakaberekerwa ikoko: Shamua, Shobhabhi, Natani, Soromoni,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.4",
            "verseOrgIds": [
              "1CH.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibhari, Erishua, Eripereti,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.5",
            "verseOrgIds": [
              "1CH.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noga, Nefegi, Jafia,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.6",
            "verseOrgIds": [
              "1CH.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erishama, Bheeriyadha naErifereti.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.7",
            "verseOrgIds": [
              "1CH.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dhavhidhi Anokunda vaFiristia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaFiristia pavakanzwa kuti Dhavhidhi akanga agadzwa kuti ave mambo weIsraeri, vakaenda nehondo yose kundomutsvaka, asi Dhavhidhi akazvinzwa akabuda kundosangana navo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.8",
            "verseOrgIds": [
              "1CH.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino vaFiristia vakanga vauya kuzopamba mupata weRefaimi;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.9",
            "verseOrgIds": [
              "1CH.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "saka Dhavhidhi akabvunza kuna Mwari akati, \"Ndingaenda here kundorwisa vaFiristia? Mungavaisa mumaoko angu here?\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.10",
            "verseOrgIds": [
              "1CH.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CH 14:10"
      },
      "items": [
        {
          "text": "Jehovha akapindura akati, \"Enda ndichavaisa mumaoko ako.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.10",
            "verseOrgIds": [
              "1CH.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Dhavhidhi navanhu vake vakakwidza kuBhaari Perazimu uye ikoko akavakunda akati, \"Sokupwanya kunoita mvura, Mwari akapwanya vavengi vangu noruoko rwangu.\" Saka nzvimbo iyoyo yakatumidzwa kunzi Bhaari Perazimu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.11",
            "verseOrgIds": [
              "1CH.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaFiristia vakasiya vamwari vavo ipapo, Dhavhidhi akarayira kuti vapiswe mumoto.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.12",
            "verseOrgIds": [
              "1CH.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaFiristia vakarwisa zvakare mupata uya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.13",
            "verseOrgIds": [
              "1CH.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Dhavhidhi akabvunza Mwari zvakare, Mwari akamupindura akati, \"Usangonanga ikoko asi vakomberedze wozovarwisa wava pamberi pemiti yemibharisamu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.14",
            "verseOrgIds": [
              "1CH.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamunotanga kunzwa kutinhira kwokufamba pamisoro yemiti yemibharisamu, unofanira kubuda kundorwa, nokuti zvichange zvichireva kuti Mwari akutungamirira kundoparadza hondo yavaFiristia.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.15",
            "verseOrgIds": [
              "1CH.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Dhavhidhi akaita sokurayirwa kwaakanga aitwa naMwari, uye vakaparadza hondo yavaFiristia, kubva kuGibheoni, kusvika kuGezeri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.16",
            "verseOrgIds": [
              "1CH.14.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka mukurumbira waDhavhidhi wakapararira nenyika yose uye Jehovha akaita kuti marudzi ose amutye.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.17",
            "verseOrgIds": [
              "1CH.14.17"
            ]
          }
        }
      ]
    }
  ],
