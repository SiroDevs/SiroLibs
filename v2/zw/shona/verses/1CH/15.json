  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "1CH 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Areka inouyiswa kuJerusarema",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi paakapedza kuzvivakira dzimba muguta raDhavhidhi, akagadzira nzvimbo yainogara areka yaMwari uye akaidzikira tende.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.1",
            "verseOrgIds": [
              "1CH.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Dhavhidhi akati, \"Hakuna munhu kunze kwavaRevhi anofanira kutakura areka yaMwari, nokuti Jehovha akavasarudza kuti vatakure areka yaJehovha uye kuti vashumire pamberi pake nokusingaperi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.2",
            "verseOrgIds": [
              "1CH.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akaunganidza Israeri yose muJerusarema kuti vatore areka yaJehovha vagoiisa kunzvimbo yaakanga aigadzirira.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.3",
            "verseOrgIds": [
              "1CH.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaunganidza zvizvarwa zvaAroni navaRevhi:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubva kuzvizvarwa zvaKohati,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.5",
            "verseOrgIds": [
              "1CH.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 15:5"
      },
      "items": [
        {
          "text": "Urieri mutungamiri nehama dzake zana namakumi maviri;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.5",
            "verseOrgIds": [
              "1CH.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubva kuzvizvarwa zvaMerari,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.6",
            "verseOrgIds": [
              "1CH.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 15:6"
      },
      "items": [
        {
          "text": "Asaya mutungamiri nehama dzake mazana maviri namakumi maviri;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.6",
            "verseOrgIds": [
              "1CH.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubva kuzvizvarwa zvaGerishoni,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.7",
            "verseOrgIds": [
              "1CH.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 15:7"
      },
      "items": [
        {
          "text": "Joere mutungamiri nehama dzake zana namakumi matatu;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.7",
            "verseOrgIds": [
              "1CH.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubva kuzvizvarwa zvaErizafani,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.8",
            "verseOrgIds": [
              "1CH.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 15:8"
      },
      "items": [
        {
          "text": "Shemaya mutungamiri nehama dzake mazana maviri;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.8",
            "verseOrgIds": [
              "1CH.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubva kuzvizvarwa zvaHebhuroni,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.9",
            "verseOrgIds": [
              "1CH.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 15:9"
      },
      "items": [
        {
          "text": "Erieri mutungamiri nehama dzake makumi masere;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.9",
            "verseOrgIds": [
              "1CH.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubva kuzvizvarwa zvaUzieri,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.10",
            "verseOrgIds": [
              "1CH.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 15:10"
      },
      "items": [
        {
          "text": "Aminadhabhi mutungamiri nehama dzake zana negumi navaviri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.10",
            "verseOrgIds": [
              "1CH.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Dhavhidhi akadana Zadhoki naAbhiatari vaprista, naUrieri, Asaya, Joere, Shemaya, Erieri naAminadhabhi vaRevhi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.11",
            "verseOrgIds": [
              "1CH.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati kwavari, \"Imi muri vakuru vemhuri dzavaRevhi, imi navamwe vaRevhi vose munofanira kuzvinatsa kuti mukwire neareka yaJehovha Mwari weIsraeri kunzvimbo yandakaigadzirira.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.12",
            "verseOrgIds": [
              "1CH.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izvi zvakaitika nokuti imi vaRevhi hamuna kukwira neareka pakutanga paya Jehovha Mwari wedu paakatiratidza kutsamwa kukuru. Hatina kunge tabvunza kwaari kuti tingazviite sei nenzira yakarayirwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.13",
            "verseOrgIds": [
              "1CH.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vaprista navaRevhi vakazvinatsa kuti vakwire neareka yaJehovha Mwari waIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.14",
            "verseOrgIds": [
              "1CH.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye vaRevhi vakatakura areka yaMwari namatanda pamapfudzi avo, sezvakanga zvarayirwa naMozisi maererano neshoko raJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.15",
            "verseOrgIds": [
              "1CH.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akataurira vatungamiri vavaRevhi kuti vagadze hama dzavo kuti vave vaimbi kuti vazonoimba dzimbo dzomufaro nezviridzwa zvaiti: mitengeranwa, mbira, namakandira.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.16",
            "verseOrgIds": [
              "1CH.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vaRevhi vakagadza Hemani mwanakomana waJoere; kubva kuhama dzake Asafi mwanakomana waBherekia; uye kubva kuhama dzavo vaMerari, Etani mwanakomana waKushaya;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.17",
            "verseOrgIds": [
              "1CH.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye pamwe chete navo hama dzavo dzaitevera paukuru dzaiti: Zekaria, Jaazieri, Shemiramoti, Jehieri, Uni, Eriabhi, Bhenaya, Maaseya, Matitia, Eriferehu, Mikineya, Obhedhi-Edhomu, Jeyeri varindi vemikova.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.18",
            "verseOrgIds": [
              "1CH.15.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaimbi vaiti Hemani, Asafi naEtani vakagadzwa kuti varidze makandira endarira.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.19",
            "verseOrgIds": [
              "1CH.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zekaria, Azieri, Shemiramoti, Jehieri, Uni, Eriabhi, Maaseya, naBhenaya vaizoridza mitengeranwa, maererano nearamoti,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.20",
            "verseOrgIds": [
              "1CH.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye Matitia, Eriferehu, Mikineya, Obhedhi-Edhomu, Jeyeri, naAzazia vaizoridza mbira maererano neshiminiti.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.21",
            "verseOrgIds": [
              "1CH.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenania mukuru wavaRevhi ndiye aitungamirira kuimba; ndiro rakanga riri basa rake nokuti aiva nyanzvi pariri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.22",
            "verseOrgIds": [
              "1CH.15.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bherekia naErikana ndivo vaizova varindi vemikova weareka.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.23",
            "verseOrgIds": [
              "1CH.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shebhania, Joshafati, Netaneri, Amasai, Zekaria, Bhenaya naErieza vaprista vaizoridza hwamanda pamberi peareka yaMwari. Obhedhi-Edhomu naJehia vaizovawo vatariri vomusuo weareka.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.24",
            "verseOrgIds": [
              "1CH.15.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi navakuru veIsraeri navakuru vamapoka ane chiuru vakaenda kundotora areka yesungano yaMwari kubva kumba kwaObhedhi-Edhomu, vachifara.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.25",
            "verseOrgIds": [
              "1CH.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti Mwari akanga abatsira vaRevhi avo vainge vatakura areka yesungano yaMwari, vakabayira Mwari hando nomwe namakondobwe manomwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.26",
            "verseOrgIds": [
              "1CH.15.26"
            ]
          }
        },
        {
          "name": "verse",
