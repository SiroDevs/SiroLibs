      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:25"
      },
      "items": [
        {
          "text": "Tera mwanakomana wake, Tahani mwanakomana wake,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.25",
            "verseOrgIds": [
              "1CH.7.25"
            ]
          }
        }
