  "verseCount": 47,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "1CH 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dhavhidhi anova Mambo weIsraeri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaIsraeri vose vakaungana kuna Dhavhidhi paHebhuroni vakati, \"Isu tiri nyama yenyu neropa renyu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.1",
            "verseOrgIds": [
              "1CH.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kare kunyange Sauro paaiva mambo ndimi maitungamirira Israeri kundorwa. Uye Jehovha Mwari wenyu akati kwamuri, 'Uchafudza vanhu vangu vaIsraeri uye uchava mutongi wavo.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.2",
            "verseOrgIds": [
              "1CH.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakuru vose veIsraeri pavakauya kuna mambo Dhavhidhi paHebhuroni, akaita sungano navo paHebhuroni pamberi paJehovha, uye vakazodza Dhavhidhi kuti ave mambo weIsraeri sezvakanga zvavimbiswa naJehovha kubudikidza naSamueri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.3",
            "verseOrgIds": [
              "1CH.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dhavhidhi anokunda Jerusarema",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi navaIsraeri vose vakaenda kuJerusarema (ndiro Jebhusi). VaJebhusi vaigaramo",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.4",
            "verseOrgIds": [
              "1CH.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "vakati kuna Dhavhidhi, \"Hamusi kuzopinda muno.\" Kunyange zvakadaro Dhavhidhi akatapa nhare yeZioni, Guta raDhavhidhi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.5",
            "verseOrgIds": [
              "1CH.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akanga ati, \"Achatungamirira kundorwisa vaJebhusi ndiye achava mukuru wavarwi.\" Joabhu mwanakomana waZeruya ndiye akatanga kuenda, saka akapiwa utungamiri hwacho.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.6",
            "verseOrgIds": [
              "1CH.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akagara munhare yeZioni, saka rakazodaidzwa kuti Guta raDhavhidhi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.7",
            "verseOrgIds": [
              "1CH.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akavaka guta richipoteredza, kubva pamihomba yokutsigira kusvikira kurusvingo rwakanga rwakapoteredza, Joabhu achivaka patsva chimwe chikamu chose cheguta.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.8",
            "verseOrgIds": [
              "1CH.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Dhavhidhi akaramba achiva nesimba guru nokuti Jehovha Wamasimba Ose aiva naye.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.9",
            "verseOrgIds": [
              "1CH.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Machinda aDhavhidhi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ava ndivo vaiva vakuru pakati pavarume voumhare vaiva naDhavhidhi, avo pamwe chete neIsraeri yose, vakatsigira umambo hwake zvakasimba kuti husvike munyika yose sokuvimbisa kwakanga kwaita Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.10",
            "verseOrgIds": [
              "1CH.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya ndiwo mazita avarume voumhare vaiva naDhavhidhi:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.11",
            "verseOrgIds": [
              "1CH.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CH 11:11"
      },
      "items": [
        {
          "text": "Jashobheami, muHakimoni, aiva mukuru wamachinda ehondo; akasimudza pfumo rake akarwa navarume mazana matatu, avo vaakauraya pakurwisana panguva imwe chete.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.11",
            "verseOrgIds": [
              "1CH.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aimutevera ainzi Ereazari mwanakomana waDhodhai muAhohi mumwe wavarume voumhare vatatu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.12",
            "verseOrgIds": [
              "1CH.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aiva naDhavhidhi paPasi Dhamimi vaFiristia pavakaungana ipapo kuzorwa. Pane imwe nzvimbo paiva nomunda wakanga uzere nebhari, varwi vakatiza vaFiristia.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.13",
            "verseOrgIds": [
              "1CH.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi ivo vakaramba vamire pakati pomunda vakaurwira vakauraya vaFiristia uye Jehovha akaita kuti vakunde nokukunda kukuru.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.14",
            "verseOrgIds": [
              "1CH.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vatatu pakati pamakumi matatu avakuru vakaburukira kuna Dhavhidhi kuDombo pabako reAdhurami, uye hondo yavaFiristia yakanga yadzika matende muMupata weRefaimi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.15",
            "verseOrgIds": [
              "1CH.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva iyoyo Dhavhidhi akanga ari munhare, uye boka rehondo yavaFiristia rakanga riri paBheterehema.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.16",
            "verseOrgIds": [
              "1CH.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akanzwa nyota akati, \"Haiwa, dai mumwe munhu ainondicherera mvura yokunwa kubva mutsime riri pedyo nesuo reBheterehema!\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.17",
            "verseOrgIds": [
              "1CH.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Vatatu ava vakapinda napakati pehondo dzavaFiristia, vakachera mvura kubva mutsime raiva pedyo nesuo reBheterehema vakaenda nayo kuna Dhavhidhi. Asi akaramba kuinwa akaidururira pasi pamberi paJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.18",
            "verseOrgIds": [
              "1CH.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akati, \"Mwari ngaandidzivise ndiregere kunwa izvi! Ndinganwa here ropa ravarume ava vaenda vachiisa upenyu hwavo panjodzi?\" Nokuti vakaisa upenyu hwavo panjodzi kuti vadzoke vanayo, Dhavhidhi akaramba kuinwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.19",
            "verseOrgIds": [
              "1CH.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CH 11:19"
      },
      "items": [
        {
          "text": "Aya ndiwo mamwe amabasa okukunda akaitwa navarume voumhare vatatu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.19",
            "verseOrgIds": [
              "1CH.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhishai mununʼuna waJoabhu akanga ari mukuru waVatatu Ava. Akasimudza pfumo rake kuti arwise varume mazana matatu, akavauraya, uye akava nomukurumbira saVatatu Vaya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.20",
            "verseOrgIds": [
              "1CH.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaremekedzwa zvakapetwa kaviri pamusoro paVatatu Vaya uye akaitwa mutungamiri wavo, kunyange zvazvo akanga asina kuverengerwa pakati pavo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.21",
            "verseOrgIds": [
              "1CH.11.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhenaya mwanakomana waJehoyadha aiva murwi woumhare aibva kuKabhizeeri, akaita mabasa makuru. Akauraya mhare mbiri dzapamusoro dzavaMoabhu. Akapindawo mugomba mumwe musi kuine chando akauraya shumba.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.22",
            "verseOrgIds": [
              "1CH.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye akauraya muIjipita akanga akareba makubhiti mashanu",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.23",
            "verseOrgIds": [
              "1CH.11.23"
            ]
          }
        },
        {
          "text": ". Kunyange zvazvo muIjipita akanga akapakata pfumo rainge tsvimbo yomuruki muruoko rwake, Bhenaya akamurwisa netsvimbo. Akabvuta pfumo kubva muruoko rwomuIjipita akamuuraya nepfumo rake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.23",
            "verseOrgIds": [
              "1CH.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya ndiwo aiva mabasa aBhenaya mwanakomana waJehoyadha; naiyewo akaita mukurumbira savarume vatatu voumhare.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.24",
            "verseOrgIds": [
              "1CH.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akakudzwa nokuremekedzwa kukuru kupfuura Vaya Makumi Matatu, asi akanga asiri pakati paVatatu Vaya. Uye Dhavhidhi akamuita mutariri wavarindi vake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.25",
            "verseOrgIds": [
              "1CH.11.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume voumhare vaiva:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1CH 11:26"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 11:26"
      },
      "items": [
        {
          "text": "Asaheri mununʼuna waJoabhu,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.26",
            "verseOrgIds": [
              "1CH.11.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 11:26"
      },
      "items": [
        {
          "text": "Erihanani mwanakomana waDhodho aibva kuBheterehema.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.26",
            "verseOrgIds": [
