          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwaivawo navamwe vashanu vaiti: Hashubha, Oheri, Bherekia, Hasadhia naJushabhi-Hesedhi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.20",
            "verseOrgIds": [
              "1CH.3.20"
            ]
