      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 3:17"
      },
      "items": [
        {
          "text": "Shearitieri mwanakomana wake,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.17",
            "verseOrgIds": [
              "1CH.3.17"
            ]
