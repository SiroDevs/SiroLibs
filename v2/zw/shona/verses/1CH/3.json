            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvizvarwa zvaJehoyakini mutapwa zvaiva:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.17",
            "verseOrgIds": [
              "1CH.3.17"
            ]
