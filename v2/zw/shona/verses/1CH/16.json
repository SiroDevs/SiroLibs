  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "1CH 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakauya neareka yaMwari vakaiisa mukati metende rayakanga yagadzirirwa naDhavhidhi, vakapa zvipiriso zvinopiswa nezvipiriso zvokuwadzana pamberi paMwari.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.1",
            "verseOrgIds": [
              "1CH.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akati apedza kubayira zvipiriso zvinopiswa, akaropafadza vanhu muzita raJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.2",
            "verseOrgIds": [
              "1CH.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akapa mumwe nomumwe womudzimai nomurume wechiIsraeri rofu rechingwa, keke romuchero womuchindwe nekeke ramazambiringa akaoma.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.3",
            "verseOrgIds": [
              "1CH.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akagadza vamwe vavaRevhi kuti vashumire pamberi peareka yaJehovha, vakumbirire, vavonge uye kuti varumbidze Jehovha, Mwari waIsraeri:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.4",
            "verseOrgIds": [
              "1CH.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asafi ndiye aiva mukuru wavo, Zekaria wechipiri, kuchitevera Jeyeri Shemiramoti, Jehieri, Matitia, Eriabhi, Bhenaya, Obhedhi-Edhomu naJeyeri. Vaizoridza mitengeranwa nembira; Asafi aizoridza makandira",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.5",
            "verseOrgIds": [
              "1CH.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye Bhenaya naJahazieri vaprista vaizoridza hwamanda nguva dzose pamberi peareka yesungano yaMwari.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.6",
            "verseOrgIds": [
              "1CH.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pisarema raDhavhidhi roKuvonga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zuva iroro Dhavhidhi akapa kwokutanga Asafi navamwe vake pisarema iri rokuvonga Jehovha:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.7",
            "verseOrgIds": [
              "1CH.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vongai Jehovha, danai kuzita rake;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.8",
            "verseOrgIds": [
              "1CH.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:8"
      },
      "items": [
        {
          "text": "zivisai pakati pendudzi dzose zvaakaita.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.8",
            "verseOrgIds": [
              "1CH.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muimbirei, muimbirei nziyo dzokurumbidza;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.9",
            "verseOrgIds": [
              "1CH.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:9"
      },
      "items": [
        {
          "text": "taurai zvose zvamabasa ake anoshamisa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.9",
            "verseOrgIds": [
              "1CH.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvirumbidzei muzita rake dzvene;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.10",
            "verseOrgIds": [
              "1CH.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:10"
      },
      "items": [
        {
          "text": "mwoyo yaavo vanotsvaka Jehovha ngaifare.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.10",
            "verseOrgIds": [
              "1CH.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tarisai kuna Jehovha nokusimba rake;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.11",
            "verseOrgIds": [
              "1CH.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:11"
      },
      "items": [
        {
          "text": "tsvakai chiso chake nguva dzose.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.11",
            "verseOrgIds": [
              "1CH.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rangarirai zvishamiso zvaakaita,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.12",
            "verseOrgIds": [
              "1CH.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:12"
      },
      "items": [
        {
          "text": "zviratidzo zvake uye nemitongo yaakareva.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.12",
            "verseOrgIds": [
              "1CH.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa, imi zvizvarwa zvaIsraeri muranda wake,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.13",
            "verseOrgIds": [
              "1CH.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:13"
      },
      "items": [
        {
          "text": "haiwa imi vanakomana vaJakobho vasanangurwa vake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.13",
            "verseOrgIds": [
              "1CH.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiye Jehovha Mwari wedu;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.14",
            "verseOrgIds": [
              "1CH.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:14"
      },
      "items": [
        {
          "text": "mitongo yake iri munyika yose.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.14",
            "verseOrgIds": [
              "1CH.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anorangarira sungano yake nokusingaperi,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.15",
            "verseOrgIds": [
              "1CH.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:15"
      },
      "items": [
        {
          "text": "shoko raakarayira, kwechiuru chezvizvarwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.15",
            "verseOrgIds": [
              "1CH.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sungano yaakaita naAbhurahama,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.16",
            "verseOrgIds": [
              "1CH.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:16"
      },
      "items": [
        {
          "text": "mhiko yaakapika kuna Isaka.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.16",
            "verseOrgIds": [
              "1CH.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akasimbisa kuna Jakobho somutemo,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.17",
            "verseOrgIds": [
              "1CH.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:17"
      },
      "items": [
        {
          "text": "kuna Israeri sesungano isingaperi, achiti:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.17",
            "verseOrgIds": [
              "1CH.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kwauri ndichapa nyika yeKenani,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.18",
            "verseOrgIds": [
              "1CH.16.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:18"
      },
      "items": [
        {
          "text": "sechikamu chenhaka yako.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.18",
            "verseOrgIds": [
              "1CH.16.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pavakanga vari vashoma,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.19",
            "verseOrgIds": [
              "1CH.16.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:19"
      },
      "items": [
        {
          "text": "vari vashoma kwazvo, vari vatorwa mairi,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.19",
            "verseOrgIds": [
              "1CH.16.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "vakadzungaira kubva kuno rumwe rudzi kusvika kuno rumwe,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.20",
            "verseOrgIds": [
              "1CH.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:20"
      },
      "items": [
        {
          "text": "kubva kuno humwe umambo kusvika kuno humwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.20",
            "verseOrgIds": [
              "1CH.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haana kutendera munhu kuti avadzvinyirire;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.21",
            "verseOrgIds": [
              "1CH.16.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:21"
      },
      "items": [
        {
          "text": "nokuda kwavo akatuka madzimambo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.21",
            "verseOrgIds": [
              "1CH.16.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Musabata vazodziwa vangu;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.22",
            "verseOrgIds": [
              "1CH.16.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:22"
      },
      "items": [
        {
          "text": "musaitira vaprofita vangu zvakaipa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.22",
            "verseOrgIds": [
              "1CH.16.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbirai Jehovha, pasi pose;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.23",
            "verseOrgIds": [
              "1CH.16.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:23"
      },
      "items": [
        {
          "text": "paridzai ruponeso rwake zuva nezuva.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.23",
            "verseOrgIds": [
              "1CH.16.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zivisai kubwinya kwake pakati pendudzi,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.24",
            "verseOrgIds": [
              "1CH.16.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:24"
      },
      "items": [
        {
          "text": "mabasa ake anoshamisa pakati pavanhu vose.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.24",
            "verseOrgIds": [
              "1CH.16.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti Jehovha mukuru uye anofanira kwazvo kurumbidzwa;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.25",
            "verseOrgIds": [
              "1CH.16.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:25"
      },
      "items": [
        {
          "text": "anofanira kutyiwa pamusoro pavamwari vose.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.25",
            "verseOrgIds": [
              "1CH.16.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti vamwari vose vendudzi zvifananidzo,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.26",
            "verseOrgIds": [
              "1CH.16.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:26"
      },
      "items": [
        {
          "text": "asi Jehovha akasika matenga.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.26",
            "verseOrgIds": [
              "1CH.16.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubwinya nokukudzwa zviri pamberi pake;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.27",
            "verseOrgIds": [
              "1CH.16.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:27"
      },
      "items": [
        {
          "text": "simba nomufaro zviri munzvimbo yougaro hwake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.27",
            "verseOrgIds": [
              "1CH.16.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipai kuna Jehovha, imi mhuri dzendudzi,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.28",
            "verseOrgIds": [
              "1CH.16.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:28"
      },
      "items": [
        {
          "text": "ipai Jehovha kukudzwa nesimba,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.28",
            "verseOrgIds": [
              "1CH.16.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "ipai Jehovha kukudzwa kunofanira zita rake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.29",
            "verseOrgIds": [
              "1CH.16.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:29"
      },
      "items": [
        {
          "text": "Uyai nezvipiriso uye muuye pamberi pake;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.29",
            "verseOrgIds": [
              "1CH.16.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:29"
      },
      "items": [
        {
          "text": "namatai Jehovha mukubwinya kwoutsvene hwake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.29",
            "verseOrgIds": [
              "1CH.16.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dederai pamberi pake, imi nyika yose!",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.30",
            "verseOrgIds": [
              "1CH.16.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:30"
      },
      "items": [
        {
          "text": "Nyika yakasimbiswa kwazvo; haingazungunuswi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.30",
            "verseOrgIds": [
              "1CH.16.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matenga ngaafare, nyika ngaifare;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.31",
            "verseOrgIds": [
              "1CH.16.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:31"
      },
      "items": [
        {
          "text": "ngavati pakati pendudzi, \"Jehovha anotonga!\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.31",
            "verseOrgIds": [
              "1CH.16.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gungwa ngaritinhire nezvose zviri mariri;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.32",
            "verseOrgIds": [
              "1CH.16.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:32"
      },
      "items": [
        {
          "text": "minda ngaifarisise nezvose zviri mairi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.32",
            "verseOrgIds": [
              "1CH.16.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo miti yesango ichaimba,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.33",
            "verseOrgIds": [
              "1CH.16.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:33"
      },
      "items": [
        {
          "text": "ichaimba nomufaro pamberi paJehovha,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.33",
            "verseOrgIds": [
              "1CH.16.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:33"
      },
      "items": [
        {
          "text": "nokuti anouya kuzotonga nyika.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.33",
            "verseOrgIds": [
              "1CH.16.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vongai Jehovha nokuti akanaka;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.34",
            "verseOrgIds": [
              "1CH.16.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:34"
      },
      "items": [
        {
          "text": "rudo rwake runogara nokusingaperi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.34",
            "verseOrgIds": [
              "1CH.16.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 16:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Danidzirai muchiti, \"Tiponesei, imi Mwari Muponesi wedu;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.35",
            "verseOrgIds": [
              "1CH.16.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:35"
      },
      "items": [
        {
          "text": "tiunganidzei uye mutirwire pandudzi,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.35",
            "verseOrgIds": [
              "1CH.16.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1CH 16:35"
      },
      "items": [
        {
          "text": "kuti tigovonga zita renyu dzvene",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.35",
            "verseOrgIds": [
              "1CH.16.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:35"
      },
      "items": [
        {
          "text": "kuti tifarisise mukukurumbidzai.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.35",
            "verseOrgIds": [
              "1CH.16.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 16:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rumbidzai Jehovha, Mwari waIsraeri,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.36",
            "verseOrgIds": [
              "1CH.16.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:36"
      },
      "items": [
        {
          "text": "kubva pakusingaperi kusvikira pakusingaperi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.36",
            "verseOrgIds": [
              "1CH.16.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "1CH 16:36"
      },
      "items": [
        {
          "text": "Ipapo vanhu vose vakati, \"Ameni\" uye vakarumbidza Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.36",
            "verseOrgIds": [
              "1CH.16.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 16:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akasiya Asafi navamwe vake pamberi peareka yesungano yaJehovha kuti ashumirepo nguva dzose maererano nezvaidiwa zuva rimwe nerimwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.37",
            "verseOrgIds": [
              "1CH.16.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 16:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akasiya Obhedhi-Edhomu navamwe vake makumi matanhatu navasere kuti vashumire navo. Obhedhi-Edhomu mwanakomana waJedhutuni naHosa vaiva vatariri vamasuo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.38",
            "verseOrgIds": [
              "1CH.16.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 16:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akasiya Zadhoki muprista navamwe vaprista pamberi petabhenakeri yaJehovha panzvimbo yakakwirira muGibheoni",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.39",
            "verseOrgIds": [
              "1CH.16.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 16:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
