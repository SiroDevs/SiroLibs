  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "1CH 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hondo navaAmoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukufamba kwenguva, Nahashi mambo wavaAmoni akafa, mwanakomana wake akamutevera paumambo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.1",
            "verseOrgIds": [
              "1CH.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akafunga akati, \"Ndicharatidza mwoyo wakanaka kuna Hanuni mwanakomana waNahashi nokuti baba vake vakaratidza mwoyo wakanaka kwandiri.\" Saka Dhavhidhi akatuma nhume kundonyaradza Hanuni pamusoro pababa vake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.2",
            "verseOrgIds": [
              "1CH.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CH 19:2"
      },
      "items": [
        {
          "text": "Vanhu vaDhavhidhi pavakasvika kuna Hanuni munyika yavaAmoni kuzomunyaradza,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.2",
            "verseOrgIds": [
              "1CH.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "machinda avaAmoni akati kuna Hanuni, \"Unofunga here kuti Dhavhidhi ari kukudza baba vako nokutuma vanhu vake kuti vauye kuzokunyaradza? Vanhu vake havana kuuya kuzosora nyika yedu here kuti vaitore?\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.3",
            "verseOrgIds": [
              "1CH.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Hanuni akabata vanhu vaDhavhidhi, akavagera ndebvu dzavo, akacheka nguo dzavo napakati kumagaro, akavadzinga.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.4",
            "verseOrgIds": [
              "1CH.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwe munhu akauya akaudza Dhavhidhi pamusoro pavarume ava, Dhavhidhi akatuma nhume kuti dzinosangana navo nokuti vakanga vanyadziswa kwazvo. Mambo akati, \"Garai paJeriko kusvikira ndebvu dzenyu dzakura, mugozodzoka.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.5",
            "verseOrgIds": [
              "1CH.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaAmoni vakati vaziva kuti vakanga vava chinhu chinonhuhwa mumhino dzaDhavhidhi, Hanuni navaAmoni vakatumira chiuru chamatarenda",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.6",
            "verseOrgIds": [
              "1CH.19.6"
            ]
          }
        },
        {
          "text": "esirivha kuti vanokumbira ngoro navachairi vadzo kubva kuAramu Naharaimu, Aramu Maaka nokuZobha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.6",
            "verseOrgIds": [
              "1CH.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakakumbira ngoro zviuru makumi matatu nezviviri navachairi vadzo, pamwe chete namambo weMaaka navarwi vake, uye akauya akadzika musasa pedyo neMedebha, ukuwo vaAmoni vachiungana kubva mumaguta avo, uye vakabuda kundorwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.7",
            "verseOrgIds": [
              "1CH.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paakanzwa izvi, Dhavhidhi akatuma Joabhu kuti abude nehondo yose yavarume vokurwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.8",
            "verseOrgIds": [
              "1CH.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaAmoni vakabudawo vakagadzirira kurwa uye vakamira vari mumitsetse yokurwa pasuo reguta ravo, uye madzimambo akanga auya akanga ari pachawo musango.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.9",
            "verseOrgIds": [
              "1CH.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joabhu akaona kuti kwaiva nemitsetse yavanhu vakagadzirira kurwa mberi kwake neshure kwake; saka akasarudza mamwe amapoka avarwi vapamusoro muIsraeri akavaendesa kuti vandorwa navaAramu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.10",
            "verseOrgIds": [
              "1CH.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaisa vamwe varume vose pasi paAbhishai mununʼuna wake uye vakaendeswa kuti vandorwa navaAmoni.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.11",
            "verseOrgIds": [
              "1CH.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joabhu akati, \"Kana vaAramu vandikundaka, ipapo iwe unofanira kuzondinunura; asi kana vaAmoni vakakukunda, ipapo ini ndichakununura.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.12",
            "verseOrgIds": [
              "1CH.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simba uye ngatirwirei vanhu vedu namaguta aMwari wedu takashinga. Jehovha achaita zvakanaka pamberi pake.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.13",
            "verseOrgIds": [
              "1CH.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Joabhu navarwi vaiva naye vakaenda kundorwa navaAramu, ivo vakatiza pamberi pavo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.14",
            "verseOrgIds": [
              "1CH.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaAmoni pavakaona kuti vaAramu vakanga vava kutiza, ivo vakatizawo pamberi pomununʼuna wake Abhishai vakamhanyira mukati meguta. Ipapo Joabhu akadzokera kuJerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.15",
            "verseOrgIds": [
              "1CH.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushure mokunge vaAramu vaona kuti vakanga vakundwa neIsraeri vakatumira nhume kunokokorodza vamwe vaAramu mberi kweRwizi, Shofaki mutungamiri wehondo yaHadhadhezeri achivatungamirira.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.16",
            "verseOrgIds": [
              "1CH.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi paakaudzwa izvi, akaunganidza Israeri yose ndokuyambuka Jorodhani; akaswedera kwavari kunovarwisa uye akaronga mitsetse yehondo akatarisana navo. Dhavhidhi akaita kuti mitsetse yake isangane navaAramu muhondo uye ivo vakarwa naye.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.17",
            "verseOrgIds": [
              "1CH.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vakatiza pamberi paIsraeri, uye Dhavhidhi akauraya zviuru zvinomwe zvavachairi vengoro, nezviuru makumi mana zvavarwi vetsoka. Akaurayawo Shofaki mutungamiri wehondo yavo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.18",
            "verseOrgIds": [
              "1CH.19.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varanda vaHadhadhezeri pavakaona kuti vakanga vakundwa neIsraeri, vakayanana naDhavhidhi uye vakava pasi pake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.19",
            "verseOrgIds": [
              "1CH.19.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CH 19:19"
      },
      "items": [
        {
          "text": "Saka vaAramu havana kuzoda kubatsira vaAmoni zvakare.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.19",
            "verseOrgIds": [
              "1CH.19.19"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "1CH.20",
    "number": "20",
    "bookId": "1CH"
  },
