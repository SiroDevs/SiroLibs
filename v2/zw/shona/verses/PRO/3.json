  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "PRO 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Munhu ngaatye Jehovha, avimbe naye uye amuteerere",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanakomana wangu, usakanganwa kudzidzisa kwangu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.1",
            "verseOrgIds": [
              "PRO.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:1"
      },
      "items": [
        {
          "text": "asi uchengete mirayiro yangu mumwoyo mako,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.1",
            "verseOrgIds": [
              "PRO.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti zvichawedzera makore mazhinji kuupenyu hwako,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.2",
            "verseOrgIds": [
              "PRO.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:2"
      },
      "items": [
        {
          "text": "uye nokubudirira.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.2",
            "verseOrgIds": [
              "PRO.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rudo nokutendeka ngazvirege kukusiya;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.3",
            "verseOrgIds": [
              "PRO.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:3"
      },
      "items": [
        {
          "text": "uzvisungirire pamutsipa wako,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.3",
            "verseOrgIds": [
              "PRO.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:3"
      },
      "items": [
        {
          "text": "zvinyore pahwendefa romwoyo wako.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.3",
            "verseOrgIds": [
              "PRO.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo uchawana nyasha nezita rakanaka",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.4",
            "verseOrgIds": [
              "PRO.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:4"
      },
      "items": [
        {
          "text": "pamberi paMwari navanhu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.4",
            "verseOrgIds": [
              "PRO.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vimba naJehovha nomwoyo wako wose",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.5",
            "verseOrgIds": [
              "PRO.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:5"
      },
      "items": [
        {
          "text": "urege kuzendamira panjere dzako;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.5",
            "verseOrgIds": [
              "PRO.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "munzira dzako dzose umutungamidze,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.6",
            "verseOrgIds": [
              "PRO.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:6"
      },
      "items": [
        {
          "text": "uye acharuramisa nzira dzako.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.6",
            "verseOrgIds": [
              "PRO.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usazviita munhu akachenjera pamaonero ako;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.7",
            "verseOrgIds": [
              "PRO.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:7"
      },
      "items": [
        {
          "text": "itya Jehovha uvenge zvakaipa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.7",
            "verseOrgIds": [
              "PRO.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izvi zvichava utano pamuviri wako",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.8",
            "verseOrgIds": [
              "PRO.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:8"
      },
      "items": [
        {
          "text": "uye nokusimbiswa kwamapfupa ako.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.8",
            "verseOrgIds": [
              "PRO.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kudza Jehovha nepfuma yako,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.9",
            "verseOrgIds": [
              "PRO.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:9"
      },
      "items": [
        {
          "text": "zvokutanga zvezvirimwa zvako;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.9",
            "verseOrgIds": [
              "PRO.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ipapo matura ako achazadzwa kusvikira pakufashukira,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.10",
            "verseOrgIds": [
              "PRO.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:10"
      },
      "items": [
        {
          "text": "uye makate ako achazara kusvika pamusoro newaini itsva.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.10",
            "verseOrgIds": [
              "PRO.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanakomana wangu, usazvidza kuranga kwaJehovha,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.11",
            "verseOrgIds": [
              "PRO.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:11"
      },
      "items": [
        {
          "text": "uye usatsamwira kutsiura kwake,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.11",
            "verseOrgIds": [
              "PRO.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti Jehovha anoranga avo vaanoda,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.12",
            "verseOrgIds": [
              "PRO.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:12"
      },
      "items": [
        {
          "text": "sababa nomwanakomana wavanofarira.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.12",
            "verseOrgIds": [
              "PRO.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaropafadzwa munhu anowana uchenjeri,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.13",
            "verseOrgIds": [
              "PRO.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:13"
      },
      "items": [
        {
          "text": "munhu anowana kunzwisisa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.13",
            "verseOrgIds": [
              "PRO.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti hwakanyanya kunaka kupfuura sirivha,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.14",
            "verseOrgIds": [
              "PRO.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:14"
      },
      "items": [
        {
          "text": "uye hunopfumisa kupfuura goridhe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.14",
            "verseOrgIds": [
              "PRO.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hunokosha kupfuura marubhi;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.15",
            "verseOrgIds": [
              "PRO.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:15"
      },
      "items": [
        {
          "text": "zvose zvaunoshuva hazvingafananidzwi nahwo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.15",
            "verseOrgIds": [
              "PRO.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazuva mazhinji oupenyu ari muruoko rwahwo rworudyi;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.16",
            "verseOrgIds": [
              "PRO.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:16"
      },
      "items": [
        {
          "text": "muruboshwe rwahwo mune upfumi nokukudzwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.16",
            "verseOrgIds": [
              "PRO.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzira dzahwo dzinofadza,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.17",
            "verseOrgIds": [
              "PRO.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:17"
      },
      "items": [
        {
          "text": "uye makwara ahwo ose rugare.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.17",
            "verseOrgIds": [
              "PRO.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndihwo muti woupenyu kuna vose vanohumbundikira;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.18",
            "verseOrgIds": [
              "PRO.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:18"
      },
      "items": [
        {
          "text": "vose vanohubata vacharopafadzwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.18",
            "verseOrgIds": [
              "PRO.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
