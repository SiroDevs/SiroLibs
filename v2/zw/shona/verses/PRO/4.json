  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "PRO 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Uchenjeri chinhu chikuru",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Teererai, vanakomana vangu, kurayira kwababa venyu;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.1",
            "verseOrgIds": [
              "PRO.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:1"
      },
      "items": [
        {
          "text": "nyatsoteererai mugowana kunzwisisa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.1",
            "verseOrgIds": [
              "PRO.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinokupai dzidziso yakanaka,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.2",
            "verseOrgIds": [
              "PRO.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:2"
      },
      "items": [
        {
          "text": "saka regai kurasa dzidziso yangu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.2",
            "verseOrgIds": [
              "PRO.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pandakanga ndiri mukomana mumba mababa vangu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.3",
            "verseOrgIds": [
              "PRO.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:3"
      },
      "items": [
        {
          "text": "ndichiri muduku uye mwana mumwe chete wamai vangu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.3",
            "verseOrgIds": [
              "PRO.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "baba vangu vakandidzidzisa vachiti,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.4",
            "verseOrgIds": [
              "PRO.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:4"
      },
      "items": [
        {
          "text": "\"Mwoyo wako ngaubatisise mashoko angu;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.4",
            "verseOrgIds": [
              "PRO.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:4"
      },
      "items": [
        {
          "text": "chengeta mirayiro yangu ugorarama.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.4",
            "verseOrgIds": [
              "PRO.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana uchenjeri, wana kunzwisisa;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.5",
            "verseOrgIds": [
              "PRO.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:5"
      },
      "items": [
        {
          "text": "usakanganwa mashoko angu kana kubva paari.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.5",
            "verseOrgIds": [
              "PRO.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usarasa uchenjeri, ipapo huchakuchengeta;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.6",
            "verseOrgIds": [
              "PRO.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:6"
      },
      "items": [
        {
          "text": "hude, ihwo hugokurinda.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.6",
            "verseOrgIds": [
              "PRO.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uchenjeri chinhu chikuru; naizvozvo wana uchenjeri.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.7",
            "verseOrgIds": [
              "PRO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:7"
      },
      "items": [
        {
          "text": "Kunyange huchikutorera zvose zvaunazvo, wana kunzwisisa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.7",
            "verseOrgIds": [
              "PRO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhukudze; ipapo huchakusimudzira;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.8",
            "verseOrgIds": [
              "PRO.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:8"
      },
      "items": [
        {
          "text": "uhumbundikire, ipapo huchakukudza.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.8",
            "verseOrgIds": [
              "PRO.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huchakupfekedza chishongo chenyasha mumusoro mako,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.9",
            "verseOrgIds": [
              "PRO.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:9"
      },
      "items": [
        {
          "text": "uye huchakupa korona yokubwinya.\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.9",
            "verseOrgIds": [
              "PRO.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Teerera, mwanakomana wangu, gamuchira zvandinotaura,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.10",
            "verseOrgIds": [
              "PRO.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:10"
      },
      "items": [
        {
          "text": "ipapo makore oupenyu hwako achava mazhinji.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.10",
            "verseOrgIds": [
              "PRO.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinokudzidzisa nzira youchenjeri",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.11",
            "verseOrgIds": [
              "PRO.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:11"
      },
      "items": [
        {
          "text": "uye ndiri kukutungamirira panzira dzakarurama.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.11",
            "verseOrgIds": [
              "PRO.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paunofamba, tsoka dzako hadzingapinganidzwi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.12",
            "verseOrgIds": [
              "PRO.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:12"
      },
      "items": [
        {
          "text": "paunomhanya, haungagumburwi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.12",
            "verseOrgIds": [
              "PRO.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batisisa kurayirwa, usarega kuchienda;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.13",
            "verseOrgIds": [
              "PRO.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:13"
      },
      "items": [
        {
          "text": "nyatsokurinda zvakanaka, nokuti ndihwo upenyu hwako.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.13",
            "verseOrgIds": [
              "PRO.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usaisa rutsoka panzira dzavakaipa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.14",
            "verseOrgIds": [
              "PRO.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:14"
      },
      "items": [
        {
          "text": "kana kufamba panzira dzavanhu vakaipa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.14",
            "verseOrgIds": [
              "PRO.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Udzinzvenge, usafamba padziri;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.15",
            "verseOrgIds": [
              "PRO.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:15"
      },
      "items": [
        {
          "text": "tsauka padziri ugopfuurira mberi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.15",
            "verseOrgIds": [
              "PRO.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti havangavati vasati vaita zvakaipa;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.16",
            "verseOrgIds": [
              "PRO.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:16"
      },
      "items": [
        {
          "text": "havangabatwi nehope kusvikira vaita kuti mumwe munhu aputsike.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.16",
            "verseOrgIds": [
              "PRO.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanodya zvokudya zvezvakaipa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.17",
            "verseOrgIds": [
              "PRO.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:17"
      },
      "items": [
        {
          "text": "uye vanonwa waini yezvechisimba.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.17",
            "verseOrgIds": [
              "PRO.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzira yavakarurama yakafanana nechiedza chamambakwedza,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.18",
            "verseOrgIds": [
              "PRO.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:18"
      },
      "items": [
        {
          "text": "chinoramba chichiwedzera kubwinya kusvikira pachiedza chamasikati makuru.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.18",
            "verseOrgIds": [
              "PRO.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi nzira yavakaipa yakaita serima guru;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.19",
            "verseOrgIds": [
