          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anotarira zvakanaka mararamiro emhuri yake,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.27",
            "verseOrgIds": [
              "PRO.31.27"
            ]
          }
        }
