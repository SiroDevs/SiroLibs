          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PRO 31:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Vakadzi vazhinji vanoita zvinhu zvakanaka,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.29",
            "verseOrgIds": [
              "PRO.31.29"
            ]
          }
