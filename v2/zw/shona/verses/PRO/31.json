      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:31"
      },
      "items": [
        {
          "text": "uye mabasa ake ngaamupe kurumbidzwa pasuo reguta.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.31",
            "verseOrgIds": [
              "PRO.31.31"
            ]
          }
