  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "31",
        "style": "c",
        "sid": "PRO 31"
      },
      "items": [
        {
          "text": "31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zvirevo zvaMambo Remueri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvirevo zvaMambo Remueri, zvirevo zvaakadzidziswa namai vake:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.1",
            "verseOrgIds": [
              "PRO.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nhaiwe mwanakomana wangu, iwe mwanakomana wokubereka,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.2",
            "verseOrgIds": [
              "PRO.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:2"
      },
      "items": [
        {
          "text": "iwe mwanakomana wemhiko dzangu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.2",
            "verseOrgIds": [
              "PRO.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "usapedzera simba rako pavakadzi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.3",
            "verseOrgIds": [
              "PRO.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:3"
      },
      "items": [
        {
          "text": "nenzira dzako pane avo vanoparadza madzimambo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.3",
            "verseOrgIds": [
              "PRO.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Hazvisi zvamadzimambo, nhaiwe Remueri,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.4",
            "verseOrgIds": [
              "PRO.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:4"
      },
      "items": [
        {
          "text": "hazvina kufanira madzimambo kunwa waini,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.4",
            "verseOrgIds": [
              "PRO.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:4"
      },
      "items": [
        {
          "text": "hazvina kufanira vatongi kukara doro,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.4",
            "verseOrgIds": [
              "PRO.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti vangazonwa vakakanganwa zvakatemwa nomurayiro,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.5",
            "verseOrgIds": [
              "PRO.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:5"
      },
      "items": [
        {
          "text": "uye vakazotadza kururamisira kodzero dzavanomanikidzwa vose.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.5",
            "verseOrgIds": [
              "PRO.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipai doro kuna avo vari kuparara,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.6",
            "verseOrgIds": [
              "PRO.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:6"
      },
      "items": [
        {
          "text": "newaini kuna avo vari mukurwadziwa:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.6",
            "verseOrgIds": [
              "PRO.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "regai vanwe vakanganwe urombo hwavo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.7",
            "verseOrgIds": [
              "PRO.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:7"
      },
      "items": [
        {
          "text": "uye varege kuzorangarirazve kutambudzika kwavo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.7",
            "verseOrgIds": [
              "PRO.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Taurai pachinzvimbo chaavo vasingagoni kuzvitaurira,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.8",
            "verseOrgIds": [
              "PRO.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:8"
      },
      "items": [
        {
          "text": "pamusoro pekodzero dzavose vanoshayiwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.8",
            "verseOrgIds": [
              "PRO.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taura utonge zvakanaka;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.9",
            "verseOrgIds": [
              "PRO.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:9"
      },
      "items": [
        {
          "text": "udzivirire kodzero dzavarombo navanoshayiwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.9",
            "verseOrgIds": [
              "PRO.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mudzimai ane Unhu Hwakanaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mudzimai ane unhu hwakanaka ndiani angamuwana?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.10",
            "verseOrgIds": [
              "PRO.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:10"
      },
      "items": [
        {
          "text": "Mutengo wake unopfuura nokure matombo anokosha emarubhi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.10",
            "verseOrgIds": [
              "PRO.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murume wake anovimba naye zvizere,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.11",
            "verseOrgIds": [
              "PRO.31.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:11"
      },
      "items": [
        {
          "text": "uye haana chaanoshayiwa chinokosha.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.11",
            "verseOrgIds": [
              "PRO.31.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anoitira murume wake zvakanaka, kwete zvakaipa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.12",
            "verseOrgIds": [
              "PRO.31.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:12"
      },
      "items": [
        {
          "text": "mazuva ose oupenyu hwake.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.12",
            "verseOrgIds": [
              "PRO.31.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anosarudza wuru neshinda",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.13",
            "verseOrgIds": [
              "PRO.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:13"
      },
      "items": [
        {
          "text": "uye anoshanda namaoko anoshingaira.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.13",
            "verseOrgIds": [
              "PRO.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akafanana nezvikepe zvavatengesi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.14",
            "verseOrgIds": [
              "PRO.31.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:14"
      },
      "items": [
        {
          "text": "anondotora zvokudya zvake kure.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.14",
            "verseOrgIds": [
              "PRO.31.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anomuka kuchakasviba;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.15",
            "verseOrgIds": [
              "PRO.31.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:15"
      },
      "items": [
        {
          "text": "agotsvagira mhuri yake zvokudya",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.15",
            "verseOrgIds": [
              "PRO.31.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:15"
      },
      "items": [
        {
          "text": "uye agopa varandakadzi vake basa ravo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.15",
            "verseOrgIds": [
              "PRO.31.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anonanʼanidza munda agoutenga;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.16",
            "verseOrgIds": [
              "PRO.31.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:16"
      },
      "items": [
        {
          "text": "anosima munda wemizambiringa nezvaakawana namaoko ake.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.16",
            "verseOrgIds": [
              "PRO.31.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anoita basa rake nesimba;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.17",
            "verseOrgIds": [
              "PRO.31.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:17"
      },
      "items": [
        {
          "text": "maoko ake akasimba kuti aite mabasa ake.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.17",
            "verseOrgIds": [
              "PRO.31.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anoona kuti kushambadzira kwake kunobatsira,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.18",
            "verseOrgIds": [
              "PRO.31.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:18"
      },
      "items": [
        {
          "text": "uye mwenje wake haudzimi pausiku.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.18",
            "verseOrgIds": [
              "PRO.31.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 31:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muruoko rwake anobata chirukiso,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.19",
            "verseOrgIds": [
              "PRO.31.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:19"
      },
      "items": [
        {
          "text": "uye anobata chirukwa neminwe yake.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.19",
            "verseOrgIds": [
              "PRO.31.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 31:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anotambanudzira maoko ake kuvarombo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.20",
            "verseOrgIds": [
              "PRO.31.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:20"
      },
      "items": [
        {
          "text": "uye anotandavadzira maoko ake kune vanoshayiwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.20",
            "verseOrgIds": [
              "PRO.31.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 31:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana kwotonhora, haatyire mhuri yake;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.21",
            "verseOrgIds": [
              "PRO.31.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:21"
      },
      "items": [
        {
          "text": "nokuti vose vakapfeka nguo dzinodziya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.21",
            "verseOrgIds": [
              "PRO.31.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 31:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anozvigadzirira zvokuwaridza panhoo yake;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.22",
            "verseOrgIds": [
              "PRO.31.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:22"
      },
      "items": [
        {
          "text": "anozvipfekedza nguo yomucheka wakaisvonaka, uye nomucheka wepepuru.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.22",
            "verseOrgIds": [
              "PRO.31.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
