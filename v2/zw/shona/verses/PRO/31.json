      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:25"
      },
      "items": [
        {
          "text": "anofara akatarisana namazuva anouya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.25",
            "verseOrgIds": [
              "PRO.31.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
