          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vana vake vanosimuka vagomuti akaropafadzwa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.28",
            "verseOrgIds": [
              "PRO.31.28"
            ]
          }
        }
      ]
