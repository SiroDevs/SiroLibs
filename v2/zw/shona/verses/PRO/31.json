      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:30"
      },
      "items": [
        {
          "text": "asi mukadzi anotya Jehovha anofanira kurumbidzwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.30",
            "verseOrgIds": [
              "PRO.31.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
