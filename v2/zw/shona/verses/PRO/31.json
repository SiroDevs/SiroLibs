          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anotaura nouchenjeri,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.26",
            "verseOrgIds": [
              "PRO.31.26"
            ]
          }
        }
      ]
    },
