          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simba nokukudzwa ndizvo nguo dzake;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.25",
            "verseOrgIds": [
              "PRO.31.25"
            ]
          }
        }
      ]
    },
