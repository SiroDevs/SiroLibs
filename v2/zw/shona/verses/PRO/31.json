      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:26"
      },
      "items": [
        {
          "text": "uye kurayira kwakatendeka kuri parurimi rwake.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.26",
            "verseOrgIds": [
              "PRO.31.26"
            ]
          }
        }
      ]
    },
    {
