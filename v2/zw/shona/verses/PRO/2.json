          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukarerekera nzeve yako kuuchenjeri",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.2",
            "verseOrgIds": [
