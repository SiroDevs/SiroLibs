      "attrs": {
        "style": "q2",
        "vid": "PRO 2:3"
      },
      "items": [
        {
          "text": "uye ukadanidzira nenzwi guru kuti uwane kunzwisisa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.3",
            "verseOrgIds": [
              "PRO.2.3"
            ]
          }
        }
      ]
    },
