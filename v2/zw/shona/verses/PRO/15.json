    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mhinduro nyoro inodzora kutsamwa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.1",
            "verseOrgIds": [
              "PRO.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:1"
      },
      "items": [
        {
          "text": "asi shoko rinorwadza rinomutsa hasha.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.1",
            "verseOrgIds": [
              "PRO.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rurimi rwowakachenjera runobudisa zivo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.2",
            "verseOrgIds": [
              "PRO.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:2"
      },
      "items": [
        {
          "text": "asi muromo webenzi unodurura upenzi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.2",
            "verseOrgIds": [
              "PRO.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meso aJehovha ari pose pose,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.3",
            "verseOrgIds": [
              "PRO.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:3"
      },
      "items": [
        {
          "text": "achicherechedza vakaipa navakanaka.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.3",
            "verseOrgIds": [
              "PRO.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rurimi runouyisa kuporesa ndirwo muti woupenyu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.4",
            "verseOrgIds": [
              "PRO.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:4"
      },
      "items": [
        {
          "text": "asi rurimi runonyengera runopwanya mweya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.4",
            "verseOrgIds": [
              "PRO.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benzi rinoramba kurayira kwababa varo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.5",
            "verseOrgIds": [
              "PRO.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:5"
      },
      "items": [
        {
          "text": "asi ani naani anogamuchira kurayirwa anoratidza kungwara.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.5",
            "verseOrgIds": [
              "PRO.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imba yowakarurama ine pfuma zhinji,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.6",
            "verseOrgIds": [
              "PRO.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:6"
      },
      "items": [
        {
          "text": "asi zvinowanikwa nowakaipa zvinomuunzira kutambudzika.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.6",
            "verseOrgIds": [
              "PRO.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miromo yavakachenjera inokusha zivo;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.7",
            "verseOrgIds": [
              "PRO.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:7"
      },
      "items": [
        {
          "text": "asi mwoyo yamapenzi haidaro.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.7",
            "verseOrgIds": [
              "PRO.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha anovenga chibayiro chowakaipa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.8",
            "verseOrgIds": [
              "PRO.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:8"
      },
      "items": [
        {
          "text": "asi munyengetero womunhu akarurama unomufadza.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.8",
            "verseOrgIds": [
              "PRO.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha anovenga nzira yeakaipa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.9",
            "verseOrgIds": [
              "PRO.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:9"
      },
      "items": [
        {
          "text": "asi anoda vaya vanotevera kururama.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.9",
            "verseOrgIds": [
              "PRO.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurangwa kwakaomarara kwakamirira uyo anotsauka kubva panzira;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.10",
            "verseOrgIds": [
              "PRO.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:10"
      },
      "items": [
        {
          "text": "uyo anovenga kudzorwa achafa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.10",
            "verseOrgIds": [
              "PRO.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rufu nokuparadzwa zviri pachena pamberi paJehovha,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.11",
            "verseOrgIds": [
              "PRO.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:11"
      },
      "items": [
        {
          "text": "ko, kuzoti mwoyo yavanhu!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.11",
            "verseOrgIds": [
              "PRO.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mudadi anovenga kudzorwa;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.12",
            "verseOrgIds": [
              "PRO.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:12"
      },
      "items": [
        {
          "text": "haangabvunzi vakachenjera.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.12",
            "verseOrgIds": [
              "PRO.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwoyo wakafara, unofadza chiso,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.13",
            "verseOrgIds": [
              "PRO.15.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:13"
      },
      "items": [
        {
          "text": "asi mwoyo une shungu unopwanya mweya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.13",
            "verseOrgIds": [
              "PRO.15.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwoyo unonzvera unotsvaka ruzivo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.14",
            "verseOrgIds": [
              "PRO.15.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:14"
      },
      "items": [
        {
          "text": "asi muromo webenzi unodya upenzi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.14",
            "verseOrgIds": [
              "PRO.15.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazuva ose omunhu anotambudzika akaipa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.15",
            "verseOrgIds": [
              "PRO.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:15"
      },
      "items": [
        {
          "text": "asi mwoyo unofara une mutambo nguva dzose.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.15",
            "verseOrgIds": [
              "PRO.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zviri nani kuva nezvishoma uchitya Jehovha,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.16",
            "verseOrgIds": [
              "PRO.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:16"
      },
      "items": [
        {
          "text": "pane kuva nepfuma zhinji namatambudziko.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.16",
            "verseOrgIds": [
              "PRO.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zviri nani kuva nezvokudya zvomuriwo pane rudo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.17",
            "verseOrgIds": [
              "PRO.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:17"
      },
      "items": [
        {
          "text": "pane kuva nemhuru yakakodzwa pane ruvengo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.17",
            "verseOrgIds": [
              "PRO.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
