  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
        "style": "c",
        "sid": "PRO 27"
      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usazvirumbidza pamusoro pezuva ramangwana,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.1",
            "verseOrgIds": [
              "PRO.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:1"
      },
      "items": [
        {
          "text": "nokuti hauzivi zvingauyiswa nezuva.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.1",
            "verseOrgIds": [
              "PRO.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rega mumwe akurumbidze, kwete muromo wako;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.2",
            "verseOrgIds": [
              "PRO.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:2"
      },
      "items": [
        {
          "text": "mumwe munhuwo zvake, kwete miromo yako iwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.2",
            "verseOrgIds": [
              "PRO.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibwe rinorema uye jecha mutoro,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.3",
            "verseOrgIds": [
              "PRO.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:3"
      },
      "items": [
        {
          "text": "asi kudenhwa nebenzi kunorema kupfuura zvose.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.3",
            "verseOrgIds": [
              "PRO.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hasha dzine utsinye uye kutsamwa kunokurira,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.4",
            "verseOrgIds": [
              "PRO.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:4"
      },
      "items": [
        {
          "text": "asi ndiani angamira pamberi pomunhu ane godo?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.4",
            "verseOrgIds": [
              "PRO.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutsiurwa pachena kuri nani",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.5",
            "verseOrgIds": [
              "PRO.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:5"
      },
      "items": [
        {
          "text": "pane rudo rwakavanzika.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.5",
            "verseOrgIds": [
              "PRO.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maronda okukuvadzwa neshamwari anogamuchirika,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.6",
            "verseOrgIds": [
              "PRO.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:6"
      },
      "items": [
        {
          "text": "asi kutsvoda kwomuvengi kunonyengera.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.6",
            "verseOrgIds": [
              "PRO.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyo akaguta anovenga uchi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.7",
            "verseOrgIds": [
              "PRO.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:7"
      },
      "items": [
        {
          "text": "asi kune ane nzara kunyange zvinovava zvinozipa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.7",
            "verseOrgIds": [
              "PRO.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seshiri inorasika kubva padendere rayo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.8",
            "verseOrgIds": [
              "PRO.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:8"
      },
      "items": [
        {
          "text": "ndizvo zvakaita munhu anorasika kubva pamusha wake.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.8",
            "verseOrgIds": [
              "PRO.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafuta nezvinonhuhwira zvinouyisa mufaro kumwoyo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.9",
            "verseOrgIds": [
              "PRO.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:9"
      },
      "items": [
        {
          "text": "uye kunaka kwoushamwari kunobva padzidziso dzake dzakanaka.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.9",
            "verseOrgIds": [
              "PRO.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usarasa shamwari yako kana shamwari yababa vako,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.10",
            "verseOrgIds": [
              "PRO.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:10"
      },
      "items": [
        {
          "text": "uye usangoenda kumba yehama yako kana wawirwa nedambudziko chete,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.10",
            "verseOrgIds": [
              "PRO.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:10"
      },
      "items": [
        {
          "text": "muvakidzani ari pedyo ari nani kupfuura hama iri kure.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.10",
            "verseOrgIds": [
              "PRO.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iva wakachenjera, mwanakomana wangu, ugofadza mwoyo wangu;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.11",
            "verseOrgIds": [
              "PRO.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:11"
      },
      "items": [
        {
          "text": "ipapo ndichagona kupindura ani naani anondishora.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.11",
            "verseOrgIds": [
              "PRO.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munhu akangwara anoona njodzi agovanda,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.12",
            "verseOrgIds": [
              "PRO.27.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:12"
      },
      "items": [
        {
          "text": "asi asina mano anoramba achienda uye agokuvadzwa nayo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.12",
            "verseOrgIds": [
              "PRO.27.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Torera nguo uyo anozviita rubatso kumutorwa;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.13",
            "verseOrgIds": [
              "PRO.27.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:13"
      },
      "items": [
        {
          "text": "uitore semhiko kana achinge aiita rubatso kumukadzi asingazvibati.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.13",
            "verseOrgIds": [
              "PRO.27.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana munhu akafumira rungwanangwana",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.14",
            "verseOrgIds": [
              "PRO.27.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:14"
      },
      "items": [
        {
          "text": "kukwazisa muvakidzani wake achidaidzirisa zvichaonekwa sechituko.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.14",
            "verseOrgIds": [
              "PRO.27.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mudzimai anokakavara akafanana",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.15",
            "verseOrgIds": [
              "PRO.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:15"
      },
      "items": [
        {
          "text": "nemvura inoramba ichidonha-donha mushure mokunge kwanaya;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.15",
            "verseOrgIds": [
              "PRO.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kumudzivisa zvakafanana nokudzivisa mhepo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.16",
            "verseOrgIds": [
              "PRO.27.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:16"
      },
      "items": [
        {
          "text": "kana kuchingidzira mafuta noruoko.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.16",
            "verseOrgIds": [
              "PRO.27.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simbi inorodza simbi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.17",
            "verseOrgIds": [
              "PRO.27.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:17"
      },
      "items": [
        {
          "text": "saizvozvowo mumwe munhu anorodza mumwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.17",
            "verseOrgIds": [
              "PRO.27.17"
            ]
          }
