  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "47",
        "style": "c",
        "sid": "EZK 47"
      },
      "items": [
        {
          "text": "47",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rwizi runobva paTemberi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 47:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murume uyu akandidzosa pamukova wetemberi, ndikaona mvura yaibuda napasi pechikumbaridzo chetemberi kwakatarisa kumabvazuva, nokuti temberi yakanga yakatarira kumabvazuva. Mvura yakanga ichiyerera napasi nechezasi kwetemberi, nyasi kwearitari.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.1",
            "verseOrgIds": [
              "EZK.47.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 47:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akandibudisa nokusuo rokumusoro akanditungamirira pakupoterera nechokunze kwesuo rokunze rakatarisana nokumabvazuva, uye mvura yaiyerera ichibva kurutivi rwezasi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.2",
            "verseOrgIds": [
              "EZK.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 47:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murume uyu akati achifamba akananga kurutivi rwokumabvazuva ane rwodzi rwokuyeresa muruoko rwake, akayera makubhiti chiuru chimwe chete",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.3",
            "verseOrgIds": [
              "EZK.47.3"
            ]
          }
        },
        {
          "text": "ndokubva ipapo andiyambutsa nomumvura yakanga yakadzika kusvika muzviziso zvamakumbo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.3",
            "verseOrgIds": [
              "EZK.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 47:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akayerazve chimwe chiuru chamakubhiti akandifambisa nomumvura yaisvika mumabvi. Akayerazve chimwe chiuru chimwe chete akandiyambutsa nomumvura yaisvika muchiuno.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.4",
            "verseOrgIds": [
              "EZK.47.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 47:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akayerazve chimwe chiuru chimwe chete, asi iye zvino rwakanga rwava rwizi rwandakanga ndisingagoni kuyambuka, nokuti mvura yakanga yawanda uye yakanga yadzika zvokuti munhu angashambira mairi, rwizi rwakanga rusina munhu angaruyambuka.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.5",
            "verseOrgIds": [
              "EZK.47.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 47:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akandibvunza akati, \"Mwanakomana womunhu, unoona izvi here?\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.6",
            "verseOrgIds": [
              "EZK.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EZK 47:6"
      },
      "items": [
        {
          "text": "Ipapo akadzokera neni kumahombekombe orwizi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.6",
            "verseOrgIds": [
              "EZK.47.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 47:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakati ndasvikako ndakaona miti mizhinji kurutivi rumwe norumwe rworwizi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.7",
            "verseOrgIds": [
              "EZK.47.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 47:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye akati kwandiri, \"Mvura iyi inoyerera yakananga kunyika yokumabvazuva ichiburukira kuArabha kwainodira mugungwa. Painongodira mugungwa, mvura yomo inobva yanaka.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.8",
            "verseOrgIds": [
              "EZK.47.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 47:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvose zvipenyu zvinokambaira zvichagara kwose nokunoyerera rwizi. Pachava nehove zhinji zhinji, nokuti mvura iyi inoyereramo ichiita kuti mvura yomunyu inatswe; saka kwose kunoyerera rwizi zvinhu zvose zvinorarama.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.9",
            "verseOrgIds": [
              "EZK.47.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 47:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varedzi vehove vachamira vakatevedza mahombekombe; kubvira kuEni Gedhi kusvikira kuEni Egiraimu kuchava nenzvimbo dzokuteya mumbure. Pachava nemhando zhinji dzehove, kufanana nehove dzeGungwa Guru.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.10",
            "verseOrgIds": [
              "EZK.47.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 47:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi matoro namachakwi haangavi nemvura yakanaka; zvichasarira munyu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.11",
            "verseOrgIds": [
              "EZK.47.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 47:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miti yemichero yemarudzi ose ichamera kumativi ose emahombekombe orwizi. Mashizha ayo haangasvavi, uye haingashayi michero. Ichabereka zvibereko mwedzi woga woga, nokuti mvura inobva panzvimbo tsvene inoyerera madziri. Michero yayo ichava zvokudya zvavanhu uye mashizha ayo achaporesa vanhu.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.12",
            "verseOrgIds": [
              "EZK.47.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Miganhu yeNyika",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 47:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvanzi naIshe Jehovha: \"Iyi ndiyo miganhu yaunofanira kuganhura nyika kuti ive nhaka pakati pamarudzi gumi namaviri aIsraeri, nemigove miviri yaJosefa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.13",
            "verseOrgIds": [
              "EZK.47.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 47:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unofanira kuiganhura zvakaenzana pakati pavo. Nokuti ndakapika noruoko rwakasimudzwa kuti ndichaipa kumadzitateguru enyu, nyika iyi ichava nhaka yenyu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.14",
            "verseOrgIds": [
              "EZK.47.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 47:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Iyi ndiyo inofanira kuva miganhu yenyika:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "EZK 47:15"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EZK 47:15"
      },
      "items": [
        {
          "text": "\"Kurutivi rwokumusoro uchabvira kuGungwa Guru nenzira yeHetironi uchipfuura nepaRebho Hamati kusvikira kuZedhadhi,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.15",
            "verseOrgIds": [
              "EZK.47.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 47:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bherota neSibhiraimu (iri pamuganhu weDhamasiko neHamati), kusvika kuHazeri Hatikoni riri pamuganhu weHaurani.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.16",
            "verseOrgIds": [
              "EZK.47.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 47:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muganhu uchaenda uchibva kugungwa uchindosvika kuHazari Enani, uchitevedza muganhu nokumusoro kweDhamasiko, nomuganhu weHamati kumusoro. Ndiwo uchava muganhu wokumusoro.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.17",
            "verseOrgIds": [
              "EZK.47.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 47:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurutivi rwokumabvazuva muganhu uchava pakati peHaurani neDhamasiko, uchitevedza Jorodhani pakati peGireadhi nenyika yeIsraeri, kusvikira kugungwa rokumabvazuva uye uchindosvika kuTamari. Ndiwo uchava muganhu wokumabvazuva.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.18",
            "verseOrgIds": [
              "EZK.47.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 47:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurutivi rwezasi, uchabvira paTamari uchindosvika kumvura yeMeribha Kadheshi, ipapo wogotevedza Rukova rweIjipiti kusvikira kuGungwa Guru. Uyu ndiwo uchava muganhu wezasi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.19",
            "verseOrgIds": [
              "EZK.47.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 47:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurutivi rwokumavirira, Gungwa Guru richava muganhu kusvikira pakatarisana neRebho Hamati. Uyu ndiwo uchava muganhu wokumavirira.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.20",
            "verseOrgIds": [
              "EZK.47.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 47:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Munofanira kugovana nyika iyi pakati penyu zvakaenzanirana namarudzi aIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.21",
            "verseOrgIds": [
              "EZK.47.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 47:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munofanira kugovana senhaka yenyu uye mugogoverawo vatorwa vagere pakati penyu vane vana. Munofanira kuvarangarira savaIsraeri vakaberekwa munyika ino; vanofanira kugoverwa nhaka pamwe chete nemi pakati pamarudzi aIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.22",
            "verseOrgIds": [
              "EZK.47.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 47:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murudzi rupi norupi mugere mutorwa, munofanira kumupa nhaka yake imomo,\" ndizvo zvinotaura Ishe Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.23",
            "verseOrgIds": [
              "EZK.47.23"
            ]
          }
        }
      ]
    }
  ],
