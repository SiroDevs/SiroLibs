    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EZK 40:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akaenda neni kusuo rokumusoro ndokuriyera. Rakanga rakangoenzana namamwe pakuyera,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.35",
            "verseOrgIds": [
              "EZK.40.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EZK 40:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "sezvakanga zvakaitawo makamuri aro, namadziro aro aionekera uye biravira racho, uye rakanga rina mawindo kumativi ose. Rakanga rakareba makubhiti makumi mashanu uye makubhiti makumi maviri namashanu paupamhi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.36",
            "verseOrgIds": [
              "EZK.40.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EZK 40:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biravira raro rakanga rakatarisana noruvazhe rwokunze; miti yemichindwe yakanga yakashongedza mbiru kumativi ose, uye zvikwiriso zvisere ndizvo zvaisvitsa ikoko.",
          "type": "text",
          "attrs": {
