    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka ndicharanga Ijipiti,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.19",
            "verseOrgIds": [
              "EZK.30.19"
            ]
          }
        }
