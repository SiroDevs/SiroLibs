    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:19"
      },
      "items": [
        {
          "text": "uye vachaziva kuti ndini Jehovha.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.19",
            "verseOrgIds": [
              "EZK.30.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugore regumi nerimwe, mumwedzi wokutanga pazuva rechinomwe shoko raJehovha rakasvika kwandiri richiti,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.20",
            "verseOrgIds": [
              "EZK.30.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mwanakomana womunhu, ndavhuna ruoko rwaFaro mambo weIjipiti. Haruna kusungwa kuti rupore kana kuiswa chiseketo kuti ruve nesimba rokubata munondo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.21",
            "verseOrgIds": [
              "EZK.30.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo zvanzi naIshe Jehovha: Ndine mhaka naFaro mambo weIjipiti. Ndichavhuna maoko ake ose ari maviri, ruoko rwakanaka norwakavhunika, ndigoita kuti munondo uwe kubva muruoko rwake.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.22",
            "verseOrgIds": [
              "EZK.30.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 30:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichaparadzira vaIjipita pakati pendudzi ndigovadzingira munyika dzose.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.23",
            "verseOrgIds": [
              "EZK.30.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichasimbisa ruoko rwamambo weBhabhironi uye ndichaisa munondo wangu muruoko rwake, asi ndichavhuna maoko aFaro, uye achagomera pamberi pake somunhu akuvadzwa zvokuti achafa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.24",
            "verseOrgIds": [
              "EZK.30.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichasimbisa maoko amambo weBhabhironi, asi maoko aFaro acharembera pasi. Ipapo vachaziva kuti ndini Jehovha, pandichaisa munondo muruoko rwamambo weBhabhironi agouvheyesa kuti arwise Ijipiti.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.25",
            "verseOrgIds": [
              "EZK.30.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichaparadzira vaIjipiti pakati pendudzi ndigovadzingira munyika dzose. Ipapo vachaziva kuti ndini Jehovha.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.26",
            "verseOrgIds": [
              "EZK.30.26"
            ]
          }
        }
      ]
    }
