  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "JER 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Makore Makumi Manomwe oUtapwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shoko rakauya kuna Jeremia pamusoro pavanhu vose veJudha mugore rechina raJehoyakimi mwanakomana waJosia mambo weJudha, iro rakanga riri gore rokutanga raNebhukadhinezari mambo weBhabhironi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.1",
            "verseOrgIds": [
              "JER.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Jeremia muprofita akati kuvanhu vose veJudha nokuna vose vaigara muJerusarema:",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.2",
            "verseOrgIds": [
              "JER.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwamakore makumi maviri namatatu, kubva pagore regumi namatatu raJosia mwanakomana waAmoni mambo weJudha kusvikira zuva ranhasi, shoko raJehovha ranga richiuya kwandiri uye ini ndikataura ndataurazve kwamuri, asi hamuna kuteerera.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.3",
            "verseOrgIds": [
              "JER.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye kunyange Jehovha akatuma varanda vake kwamuri ivo vaprofita nguva nenguva, imi hamuna kuteerera kana kurereka nzeve dzenyu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.4",
            "verseOrgIds": [
              "JER.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivo vakati, \"Dzokai zvino mumwe nomumwe wenyu, kubva panzira dzenyu dzakaipa nepamabasa enyu akaipa, mugogara munyika yamakapiwa naJehovha imi namadzibaba enyu nokusingaperi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.5",
            "verseOrgIds": [
              "JER.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Regai kutevera vamwe vamwari kuti muvashumire uye muvanamate; murege kunditsamwisa nezvakaitwa namaoko enyu. Ipapo handingakuitirei zvakaipa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.6",
            "verseOrgIds": [
              "JER.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Asi imi hamuna kunditeerera,\" ndizvo zvinotaura Jehovha, \"uye makanditsamwisa nezvakaitwa namaoko enyu, mukaita kuti zvakaipa zvikuwirei.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.7",
            "verseOrgIds": [
              "JER.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo zvanzi naJehovha Wamasimba Ose: \"Nemhaka yokuti hamuna kuteerera mashoko angu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.8",
            "verseOrgIds": [
              "JER.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndichadana marudzi ose okumusoro uye nomuranda wangu Nebhukadhinezari mambo weBhabhironi,\" ndizvo zvinotaura Jehovha, \"uye ndichavauyisa kuzorwa nenyika ino navanogaramo uye nendudzi dzose dzakavapoteredza. Ndichavaparadza zvachose uye ndichavaita chinhu chinovengwa nechinosekwa, nedongo nokusingaperi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.9",
            "verseOrgIds": [
              "JER.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichabvisa pakati pavo manzwi okupembera nomufaro, namanzwi emwenga neechikomba, nenzwi reguyo nechiedza chemwenje.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.10",
            "verseOrgIds": [
              "JER.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyika ino yose ichava dongo, uye marudzi aya achashandira mambo weBhabhironi kwemakore makumi manomwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.11",
            "verseOrgIds": [
              "JER.25.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Asi kana makore makumi manomwe apera, ndicharova mambo weBhabhironi norudzi rwake, nenyika yavaBhabhironi, pamusoro pemhosva yavo,\" ndizvo zvinotaura Jehovha, \"uye ndichaiita dongo nokusingaperi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.12",
            "verseOrgIds": [
              "JER.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichauyisa pamusoro penyika iyo zvinhu zvose zvandakataura pamusoro payo, zvose zvakanyorwa mubhuku iri nezvakaprofitwa naJeremia pamusoro pendudzi dzose.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.13",
            "verseOrgIds": [
              "JER.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivo pachavo vachatapwa nendudzi zhinji namadzimambo makuru; ini ndichavaripira zvakaenzana nokubata kwavo uye namabasa emaoko avo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.14",
            "verseOrgIds": [
              "JER.25.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mukombe woKutsamwa kwaMwari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izvi ndizvo zvakataurwa naJehovha, Mwari waIsraeri, kwandiri: \"Tora kubva muruoko rwangu mukombe uyu wakazara newaini yokutsamwa kwangu unwise ndudzi dzose dzandinokutuma kwadziri.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.15",
            "verseOrgIds": [
              "JER.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana vachinge vainwa vachadzedzereka nokupenga nokuda kwomunondo wandichatuma pakati pavo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.16",
            "verseOrgIds": [
              "JER.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka ndakatora mukombe muruoko rwaJehovha ndikaita kuti ndudzi dzose dzaakandituma kwadziri dzinwe:",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.17",
            "verseOrgIds": [
              "JER.25.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jerusarema namaguta eJudha, namadzimambo, namachinda aro, kuti aitwe matongo, chinhu chinovengwa nechinosekesa, nechinotukwa, sezvaakaita iye nhasi;",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.18",
            "verseOrgIds": [
              "JER.25.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Faro mambo weIjipiti, navaranda vake, namachinda ake uye navanhu vake vose,",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.19",
            "verseOrgIds": [
              "JER.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "navatorwa vose variko;",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.20",
            "verseOrgIds": [
              "JER.25.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JER 25:20"
      },
      "items": [
        {
          "text": "namadzimambo ose eUzi;",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.20",
            "verseOrgIds": [
              "JER.25.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JER 25:20"
      },
      "items": [
        {
          "text": "namadzimambo ose eFiristia (neavo veAshikeroni, neGaza, neEkironi, navanhu vakasiyiwa kuAshidhodhi);",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.20",
            "verseOrgIds": [
              "JER.25.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Edhomu neMoabhu neAmoni;",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.21",
            "verseOrgIds": [
              "JER.25.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "namadzimambo ose eTire neSidhoni;",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.22",
            "verseOrgIds": [
              "JER.25.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JER 25:22"
      },
      "items": [
        {
          "text": "namadzimambo emuzviwi mhiri kwegungwa;",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.22",
            "verseOrgIds": [
              "JER.25.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "neDhedhani, neTema, neBhuzi navose vari kunzvimbo dziri kure;",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.23",
            "verseOrgIds": [
              "JER.25.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "madzimambo ose eArabhia namadzimambo ose enyika dzavatorwa vanogara mugwenga;",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.24",
            "verseOrgIds": [
              "JER.25.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "namadzimambo ose eZimuri, neEramu neFiristia,",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.25",
            "verseOrgIds": [
              "JER.25.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "namadzimambo ose okumusoro vepedyo nevokure, mumwe achitevera mumwe, ushe hwose huri pamusoro penyika.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.26",
            "verseOrgIds": [
              "JER.25.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JER 25:26"
      },
      "items": [
        {
          "text": "Shure kwaivava vose, mambo weSheshaki achazoinwawo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.26",
            "verseOrgIds": [
              "JER.25.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ipapo uvaudze kuti, 'Zvanzi naJehovha Wamasimba Ose, Mwari weIsraeri: Inwai mudhakwe, murutse, muwe, uye murege kuzomukazve nokuda kwomunondo wandichatuma pakati penyu.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.27",
            "verseOrgIds": [
              "JER.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana vakaramba kutora mukombe muruoko rwako kuti vamwe, uti kwavari, 'Zvanzi naJehovha Wamasimba Ose: Munofanira kuinwa!",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.28",
            "verseOrgIds": [
              "JER.25.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tarirai, ndava kutanga kuuyisa njodzi pamusoro peguta rinodanwa neZita rangu, ko, imi mungarega kurangwa here? Hamungaregi kurangwa nokuti ndava kudana munondo pamusoro pavose vagere panyika, ndizvo zvinotaura Jehovha Wamasimba Ose.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.29",
            "verseOrgIds": [
              "JER.25.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zvino chiprofita mashoko aya ose pamusoro pavo uchiti:",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.30",
            "verseOrgIds": [
              "JER.25.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 25:30"
      },
      "items": [
        {
          "text": "\" 'Jehovha achaomba ari kumusoro;",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.30",
            "verseOrgIds": [
              "JER.25.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 25:30"
      },
      "items": [
        {
          "text": "achatinhira ari pachigaro chake chitsvene",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.30",
            "verseOrgIds": [
              "JER.25.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 25:30"
      },
      "items": [
        {
          "text": "uye achaomba zvikuru pamusoro penyika yake.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.30",
            "verseOrgIds": [
              "JER.25.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 25:30"
      },
      "items": [
        {
          "text": "Achadanidzira sezvinoita vanotsika mazambiringa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.30",
            "verseOrgIds": [
              "JER.25.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 25:30"
      },
      "items": [
        {
          "text": "achidanidzira kuna vose vagere panyika.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.30",
            "verseOrgIds": [
              "JER.25.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 25:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bope richaunga kusvikira kumagumo enyika,",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.31",
            "verseOrgIds": [
              "JER.25.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 25:31"
      },
      "items": [
        {
          "text": "nokuti Jehovha achapa ndudzi mhosva;",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.31",
            "verseOrgIds": [
              "JER.25.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 25:31"
      },
      "items": [
        {
          "text": "achauyisa kutonga pamusoro pamarudzi ose avanhu",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.31",
            "verseOrgIds": [
              "JER.25.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 25:31"
      },
      "items": [
        {
          "text": "uye achaisa vakaipa kumunondo,' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.31",
            "verseOrgIds": [
              "JER.25.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "JER 25:31"
      },
      "items": [
        {
          "text": "ndizvo zvinotaura Jehovha.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 25:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvanzi naJehovha Wamasimba Ose:",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.32",
            "verseOrgIds": [
              "JER.25.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 25:32"
      },
      "items": [
        {
          "text": "\"Tarirai, njodzi iri kupararira",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.32",
            "verseOrgIds": [
              "JER.25.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 25:32"
      },
      "items": [
        {
          "text": "ichibva kuno rumwe rudzi ichienda kuno rumwe;",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.32",
            "verseOrgIds": [
              "JER.25.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 25:32"
      },
      "items": [
        {
          "text": "dutu guru rasimuka",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.32",
            "verseOrgIds": [
              "JER.25.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 25:32"
      },
      "items": [
        {
          "text": "richibva kumagumo enyika.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.32",
            "verseOrgIds": [
              "JER.25.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva iyo vakaurayiwa naJehovha vachava pose pose vachibva kuno mumwe mugumo wenyika kusvikira kuno mumwe. Havangachemwi kana kuunganidzwa, kana kuvigwa, asi vachava somupfudze uri pamusoro penyika.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.33",
            "verseOrgIds": [
              "JER.25.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chemai uye muungudze, imi vafudzi;",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.34",
            "verseOrgIds": [
              "JER.25.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 25:34"
      },
      "items": [
        {
          "text": "umburukai muguruva, imi vatungamiri veboka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.34",
            "verseOrgIds": [
              "JER.25.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 25:34"
      },
      "items": [
        {
          "text": "Nokuti nguva yokuurayiwa kwenyu yasvika;",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.34",
            "verseOrgIds": [
              "JER.25.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 25:34"
      },
      "items": [
        {
          "text": "muchawa mugopwanyika somudziyo wakanaka wevhu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.34",
            "verseOrgIds": [
              "JER.25.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 25:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vafudzi vachashayiwa kwokutizira,",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.35",
            "verseOrgIds": [
              "JER.25.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 25:35"
      },
      "items": [
        {
          "text": "uye vakuru veboka vachashayiwa kwokutizira.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.35",
            "verseOrgIds": [
              "JER.25.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JER 25:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzwai kuchema kwavafudzi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.36",
            "verseOrgIds": [
              "JER.25.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 25:36"
      },
      "items": [
        {
          "text": "kuungudza kwavatungamiri veboka,",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.36",
            "verseOrgIds": [
              "JER.25.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 25:36"
      },
      "items": [
        {
          "text": "nokuti Jehovha ari kuparadza mafuro avo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.36",
            "verseOrgIds": [
              "JER.25.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JER 25:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafuro ano runyararo achaparadzwa",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.37",
            "verseOrgIds": [
              "JER.25.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 25:37"
      },
      "items": [
        {
          "text": "nokuda kwokutsamwa kunotyisa kwaJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.37",
            "verseOrgIds": [
              "JER.25.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JER 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seshumba, achabva panzvimbo yake yokuvanda,",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.38",
            "verseOrgIds": [
              "JER.25.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 25:38"
      },
      "items": [
        {
          "text": "uye nyika yavo ichaparadzwa",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.38",
            "verseOrgIds": [
              "JER.25.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 25:38"
      },
      "items": [
        {
          "text": "nokuda kwomunondo womumanikidzi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.38",
            "verseOrgIds": [
              "JER.25.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 25:38"
      },
      "items": [
        {
          "text": "uye nokuda kwokutsamwa kunotyisa kwaJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.38",
            "verseOrgIds": [
              "JER.25.38"
            ]
          }
        }
