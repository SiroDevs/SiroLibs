  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "JER 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa, dai musoro wangu waiva chitubu chemvura",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.1",
            "verseOrgIds": [
              "JER.8.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:1"
      },
      "items": [
        {
          "text": "uye meso angu riri tsime remisodzi!",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.1",
            "verseOrgIds": [
              "JER.8.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:1"
      },
      "items": [
        {
          "text": "Ndingadai ndaichema masikati nousiku",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.1",
            "verseOrgIds": [
              "JER.8.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:1"
      },
      "items": [
        {
          "text": "nokuda kwavakaurayiwa vavanhu vangu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.1",
            "verseOrgIds": [
              "JER.8.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa, dai ndaiva nenzvimbo",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.2",
            "verseOrgIds": [
              "JER.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:2"
      },
      "items": [
        {
          "text": "mugwenga yokugara yavafambi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.2",
            "verseOrgIds": [
              "JER.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:2"
      },
      "items": [
        {
          "text": "kuitira kuti ndisiye vanhu vangu",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.2",
            "verseOrgIds": [
              "JER.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:2"
      },
      "items": [
        {
          "text": "ndiende kure navo;",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.2",
            "verseOrgIds": [
              "JER.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:2"
      },
      "items": [
        {
          "text": "nokuti vose imhombwe,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.2",
            "verseOrgIds": [
              "JER.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:2"
      },
      "items": [
        {
          "text": "ungano yavanhu vasina kutendeka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.2",
            "verseOrgIds": [
              "JER.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Vanokunga rurimi rwavo souta,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.3",
            "verseOrgIds": [
              "JER.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:3"
      },
      "items": [
        {
          "text": "kuti vapfure nhema;",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.3",
            "verseOrgIds": [
              "JER.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:3"
      },
      "items": [
        {
          "text": "havaiti nechokwadi",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.3",
            "verseOrgIds": [
              "JER.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:3"
      },
      "items": [
        {
          "text": "pakukunda kwavanoita munyika.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.3",
            "verseOrgIds": [
              "JER.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:3"
      },
      "items": [
        {
          "text": "Vanobva pane chimwe chivi vachienda pane chimwe;",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.3",
            "verseOrgIds": [
              "JER.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:3"
      },
      "items": [
        {
          "text": "havandizivi ini,\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.3",
            "verseOrgIds": [
              "JER.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "JER 9:3"
      },
      "items": [
        {
          "text": "ndizvo zvinotaura Jehovha.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Chenjererai shamwari dzenyu;",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.4",
            "verseOrgIds": [
              "JER.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:4"
      },
      "items": [
        {
          "text": "musavimba nehama dzenyu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.4",
            "verseOrgIds": [
              "JER.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:4"
      },
      "items": [
        {
          "text": "Nokuti hama ipi neipi inonyengera,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.4",
            "verseOrgIds": [
              "JER.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:4"
      },
      "items": [
        {
          "text": "uye shamwari ipi neipi inoita makuhwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.4",
            "verseOrgIds": [
              "JER.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shamwari inonyengera shamwari,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.5",
            "verseOrgIds": [
              "JER.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:5"
      },
      "items": [
        {
          "text": "uye hakuna anotaura chokwadi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.5",
            "verseOrgIds": [
              "JER.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:5"
      },
      "items": [
        {
          "text": "Vakadzidzisa ndimi dzavo kureva nhema;",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.5",
            "verseOrgIds": [
              "JER.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:5"
      },
      "items": [
        {
          "text": "vanozvinetsa nokuita zvakaipa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.5",
            "verseOrgIds": [
              "JER.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munogara pakati pounyengeri;",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.6",
            "verseOrgIds": [
              "JER.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:6"
      },
      "items": [
        {
          "text": "mukunyengera kwavo vanoramba kundiziva ini,\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.6",
            "verseOrgIds": [
              "JER.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "JER 9:6"
      },
      "items": [
        {
          "text": "ndizvo zvinotaura Jehovha.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo zvanzi naJehovha Wamasimba Ose:",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.7",
            "verseOrgIds": [
              "JER.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:7"
      },
      "items": [
        {
          "text": "\"Tarirai, ndichavanatsa",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.7",
            "verseOrgIds": [
              "JER.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:7"
      },
      "items": [
        {
          "text": "uye ndichavaedza, ndechipi chimwe chandingaita",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.7",
            "verseOrgIds": [
              "JER.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:7"
      },
      "items": [
        {
          "text": "nokuda kwechivi chavanhu vangu?",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.7",
            "verseOrgIds": [
              "JER.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rurimi rwavo museve unouraya;",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.8",
            "verseOrgIds": [
              "JER.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:8"
      },
      "items": [
        {
          "text": "runotaura nokunyengera.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.8",
            "verseOrgIds": [
              "JER.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:8"
      },
      "items": [
        {
          "text": "Nomuromo wake mumwe nomumwe anotaura zvakanaka kune wokwake,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.8",
            "verseOrgIds": [
              "JER.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:8"
      },
      "items": [
        {
          "text": "asi mumwoyo make anomuteyera musungo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.8",
            "verseOrgIds": [
              "JER.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, handigavarangi nokuda kwechinhu ichi here?\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.9",
            "verseOrgIds": [
              "JER.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:9"
      },
      "items": [
        {
          "text": "ndizvo zvinotaura Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.9",
            "verseOrgIds": [
              "JER.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:9"
      },
      "items": [
        {
          "text": "\"Ko, handingazvitsiviri",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.9",
            "verseOrgIds": [
              "JER.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:9"
      },
      "items": [
        {
          "text": "pamusoro porudzi rwakadai here?\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.9",
            "verseOrgIds": [
              "JER.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichachema uye ndichaungudza nokuda kwamakomo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.10",
            "verseOrgIds": [
              "JER.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:10"
      },
      "items": [
        {
          "text": "uye ndichachema pamusoro pamafuro egwenga.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.10",
            "verseOrgIds": [
              "JER.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:10"
      },
      "items": [
        {
          "text": "Aparara uye hakuna anofambako,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.10",
            "verseOrgIds": [
              "JER.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:10"
      },
      "items": [
        {
          "text": "uye kukuma kwemombe hakunzwiki.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.10",
            "verseOrgIds": [
              "JER.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:10"
      },
      "items": [
        {
          "text": "Shiri dzedenga dzatiza,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.10",
            "verseOrgIds": [
              "JER.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:10"
      },
      "items": [
        {
          "text": "uye mhuka dzaenda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.10",
            "verseOrgIds": [
              "JER.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndichaita Jerusarema murwi wedongo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.11",
            "verseOrgIds": [
              "JER.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:11"
      },
      "items": [
        {
          "text": "panogara makava;",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.11",
            "verseOrgIds": [
              "JER.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:11"
      },
      "items": [
        {
          "text": "uye ndichaparadza maguta eJudha,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.11",
            "verseOrgIds": [
              "JER.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:11"
      },
      "items": [
        {
          "text": "kuti kurege kuva nomunhu anogarako.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.11",
            "verseOrgIds": [
              "JER.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndoupiko munhu akachenjera zvokuti anganzwisisa izvi? Ndianiko akarayirwa naJehovha uye angatsanangura izvi? Nemhaka yeiko nyika yanyangadzwa yava dongo ikafanana negwenga risina angapfuura nomo?",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.12",
            "verseOrgIds": [
              "JER.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati, \"Nemhaka yokuti vakasiya murayiro wangu, wandakaisa pamberi pavo, havana kunditeerera kana kutevera murayiro wangu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.13",
            "verseOrgIds": [
              "JER.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi, vakatevera kusindimara kwemwoyo yavo; vakatevera vanaBhaari, sezvavakadzidziswa namadzibaba avo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.14",
            "verseOrgIds": [
              "JER.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo zvanzi naJehovha Wamasimba Ose, Mwari weIsraeri, \"Tarirai ndichaita kuti vanhu ava vadye zvinovava uye kuti vanwe mvura ino muchetura.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.15",
            "verseOrgIds": [
              "JER.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichavaparadzira pakati pendudzi dzavasina kumboziva uye dzisina kumbozivikanwa namadzibaba avo, uye ndichavatevera nomunondo kusvikira ndavaparadza.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.16",
            "verseOrgIds": [
              "JER.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvanzi naJehovha Wamasimba Ose:",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.17",
            "verseOrgIds": [
              "JER.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:17"
      },
      "items": [
        {
          "text": "\"Rangarirai zvino! Danai vakadzi vanochema vauye;",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.17",
            "verseOrgIds": [
              "JER.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:17"
      },
      "items": [
        {
          "text": "danai vanogonesesa pakati pavo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.17",
            "verseOrgIds": [
              "JER.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngavakurumidze kuuya",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.18",
            "verseOrgIds": [
              "JER.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:18"
      },
      "items": [
        {
          "text": "vagochema pamusoro pedu",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.18",
            "verseOrgIds": [
              "JER.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:18"
      },
      "items": [
        {
          "text": "kusvikira maziso edu ayerera misodzi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.18",
            "verseOrgIds": [
              "JER.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:18"
      },
      "items": [
        {
          "text": "nzizi dzoyerera mumaziso edu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.18",
            "verseOrgIds": [
              "JER.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maungira okuchema anonzwika kubva kuZioni achiti:",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.19",
            "verseOrgIds": [
              "JER.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:19"
      },
      "items": [
        {
          "text": "'Haiwa taparadzwa sei!",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.19",
            "verseOrgIds": [
              "JER.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:19"
      },
      "items": [
        {
          "text": "Haiwa kunyadziswa kwedu kukuru sei!",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.19",
            "verseOrgIds": [
              "JER.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:19"
      },
      "items": [
        {
          "text": "Tinofanira kusiya nyika yedu",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.19",
            "verseOrgIds": [
              "JER.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:19"
      },
      "items": [
        {
          "text": "nokuti dzimba dzedu dzava matongo.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.19",
            "verseOrgIds": [
              "JER.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino, imi vakadzi, inzwai shoko raJehovha;",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.20",
            "verseOrgIds": [
              "JER.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:20"
      },
      "items": [
        {
          "text": "dziurai nzeve dzenyu dzinzwe mashoko omuromo wake.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.20",
            "verseOrgIds": [
              "JER.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:20"
      },
      "items": [
        {
          "text": "Dzidzisai vanasikana venyu kuungudza;",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.20",
            "verseOrgIds": [
              "JER.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:20"
      },
      "items": [
        {
          "text": "dzidzisanai kuchema.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.20",
            "verseOrgIds": [
              "JER.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rufu rwakapinda napamawindo edu",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.21",
            "verseOrgIds": [
              "JER.9.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:21"
      },
      "items": [
        {
          "text": "uye rwapinda munhare dzedu;",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.21",
            "verseOrgIds": [
              "JER.9.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:21"
      },
      "items": [
        {
          "text": "rwauraya vana mumigwagwa",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.21",
            "verseOrgIds": [
              "JER.9.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:21"
      },
      "items": [
        {
          "text": "namajaya ari munzira dzeguta.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.21",
            "verseOrgIds": [
              "JER.9.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uti, \"Zvanzi naJehovha:",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.22",
            "verseOrgIds": [
              "JER.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:22"
      },
      "items": [
        {
          "text": "\" 'Zvitunha zvavanhu zvichavata",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.22",
            "verseOrgIds": [
              "JER.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:22"
      },
      "items": [
        {
          "text": "somupfudze uri pamusoro pomunda,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.22",
            "verseOrgIds": [
              "JER.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:22"
      },
      "items": [
        {
          "text": "sezviyo zvakachekwa shure kwavacheki,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.22",
            "verseOrgIds": [
              "JER.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:22"
      },
      "items": [
        {
          "text": "zvisina achazviunganidza.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.22",
            "verseOrgIds": [
              "JER.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvanzi naJehovha:",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.23",
            "verseOrgIds": [
              "JER.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:23"
      },
      "items": [
        {
          "text": "\"Akachenjera ngaarege kuzvirumbidza pamusoro penjere dzake,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.23",
            "verseOrgIds": [
              "JER.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:23"
      },
      "items": [
        {
          "text": "kana munhu ane simba pamusoro pesimba rake,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.23",
            "verseOrgIds": [
              "JER.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:23"
      },
      "items": [
        {
          "text": "kana akapfuma pamusoro pepfuma yake,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.23",
            "verseOrgIds": [
              "JER.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi anozvirumbidza ngaazvirumbidze pamusoro pezvizvi:",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.24",
            "verseOrgIds": [
              "JER.9.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:24"
      },
      "items": [
        {
          "text": "kuti anondinzwisisa uye kuti anondiziva ini,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.24",
            "verseOrgIds": [
              "JER.9.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:24"
