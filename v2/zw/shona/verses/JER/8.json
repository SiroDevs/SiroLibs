{
  "id": "JER.8",
  "number": "8",
  "bookId": "JER",
  "reference": "Jeremia 8",
  "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "JER 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Panguva iyoyo, ndizvo zvinotaura Jehovha, mapfupa amadzimambo namachinda eJudha, namapfupa avaprista navaprofita, uye mapfupa avanhu veJerusarema, achabviswa kubva mumakuva avo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.1",
            "verseOrgIds": [
              "JER.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achava pamhene agorohwa nezuva uye achavhenekwa nomwedzi nenyeredzi dzose dzedenga, zvavakada vakazvishumira vakazvitevera uye vakabvunza kwazviri, vakazvinamata. Haangaunganidzwi kana kuvigwa, asi achafanana nomupfudze uri panyika.",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.2",
            "verseOrgIds": [
              "JER.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwose zvako kwandichavadzingira, vakasara vose vorudzi urwu rwakaipa, vachademba rufu pachinzvimbo choupenyu, ndizvo zvinotaura Jehovha Wamasimba Ose.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.3",
            "verseOrgIds": [
              "JER.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chivi noKurangwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uti kwavari, 'Zvanzi naJehovha:",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.4",
            "verseOrgIds": [
              "JER.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 8:4"
      },
      "items": [
        {
          "text": "\" 'Vanhu pavanowira pasi, havamukizve here?",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.4",
            "verseOrgIds": [
              "JER.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:4"
      },
      "items": [
        {
          "text": "Munhu akange ambotsauka, haadzokizve here?",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.4",
            "verseOrgIds": [
              "JER.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino nemhaka yei ava vadzokera shure?",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.5",
            "verseOrgIds": [
              "JER.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:5"
      },
      "items": [
        {
          "text": "Nemhaka yei Jerusarema richingogara richitsauka?",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.5",
            "verseOrgIds": [
              "JER.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 8:5"
      },
      "items": [
        {
          "text": "Vanobatirira pakunyengera,",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.5",
            "verseOrgIds": [
              "JER.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:5"
      },
      "items": [
        {
          "text": "vanoramba kudzoka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.5",
            "verseOrgIds": [
              "JER.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakanyatsoteereresa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.6",
            "verseOrgIds": [
              "JER.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:6"
      },
      "items": [
        {
          "text": "asi ivo havambotauri zvakarurama.",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.6",
            "verseOrgIds": [
              "JER.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 8:6"
      },
      "items": [
        {
          "text": "Hakuna anotendeuka pane zvakaipa zvake achiti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.6",
            "verseOrgIds": [
              "JER.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:6"
      },
      "items": [
        {
          "text": "\"Ndaiteiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.6",
            "verseOrgIds": [
              "JER.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 8:6"
      },
      "items": [
        {
          "text": "Mumwe nomumwe anongotevedza nzira yake",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.6",
            "verseOrgIds": [
              "JER.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:6"
      },
      "items": [
        {
          "text": "sebhiza rinomhanyira kurwa hondo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.6",
            "verseOrgIds": [
              "JER.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange shohori riri mudenga",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.7",
            "verseOrgIds": [
              "JER.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:7"
      },
      "items": [
        {
          "text": "rinoziva nguva dzaro dzakatarwa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.7",
            "verseOrgIds": [
              "JER.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 8:7"
      },
      "items": [
        {
          "text": "uye njiva, nenyenganyenga nekondo",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.7",
            "verseOrgIds": [
              "JER.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:7"
      },
      "items": [
        {
          "text": "zvinocherechedza nguva yazvo yokutama.",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.7",
            "verseOrgIds": [
              "JER.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 8:7"
      },
      "items": [
        {
          "text": "Asi vanhu vangu havazivi",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.7",
            "verseOrgIds": [
              "JER.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:7"
      },
      "items": [
        {
          "text": "zvinodikanwa naJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.7",
            "verseOrgIds": [
              "JER.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Munoreva seiko muchiti, \"Takachenjera,",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.8",
            "verseOrgIds": [
              "JER.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:8"
      },
      "items": [
        {
          "text": "nokuti tino murayiro waJehovha,\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.8",
            "verseOrgIds": [
              "JER.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 8:8"
      },
      "items": [
        {
          "text": "asi zvirokwazvo chinyoreso chenhema chavanyori",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.8",
            "verseOrgIds": [
              "JER.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:8"
      },
      "items": [
        {
          "text": "chakanyora nhema?",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.8",
            "verseOrgIds": [
              "JER.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakachenjera vachanyadziswa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.9",
            "verseOrgIds": [
              "JER.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:9"
      },
      "items": [
        {
          "text": "vachavhunduka uye vachabatwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.9",
            "verseOrgIds": [
              "JER.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 8:9"
      },
      "items": [
        {
          "text": "Sezvo vakaramba shoko raJehovha,",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.9",
            "verseOrgIds": [
              "JER.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:9"
      },
      "items": [
        {
          "text": "kuchenjera kwavanako kwakadiniko?",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.9",
            "verseOrgIds": [
              "JER.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo ndichapa vakadzi vavo kuna vamwe varume,",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.10",
            "verseOrgIds": [
              "JER.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:10"
      },
      "items": [
        {
          "text": "neminda yavo kuvaridzi vatsva.",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.10",
            "verseOrgIds": [
              "JER.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 8:10"
      },
      "items": [
        {
          "text": "Kubva kumuduku kusvikira kumukuru vose",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.10",
            "verseOrgIds": [
              "JER.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:10"
      },
      "items": [
        {
          "text": "vanokarira pfuma;",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.10",
            "verseOrgIds": [
              "JER.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 8:10"
      },
      "items": [
        {
          "text": "vaprofita navaprista saizvozvo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.10",
            "verseOrgIds": [
              "JER.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:10"
      },
      "items": [
        {
          "text": "vose vanoita nokunyengera.",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.10",
            "verseOrgIds": [
              "JER.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanosunga vanga ravanhu vangu",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.11",
            "verseOrgIds": [
              "JER.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:11"
      },
      "items": [
        {
          "text": "sokunge duku duku.",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.11",
            "verseOrgIds": [
              "JER.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 8:11"
      },
      "items": [
        {
          "text": "Vanoti, \"Rugare, rugare,\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.11",
            "verseOrgIds": [
              "JER.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:11"
      },
      "items": [
        {
          "text": "ipo pasina rugare.",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.11",
            "verseOrgIds": [
              "JER.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, vanonyadziswa netsika dzavo dzinonyangadza here?",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.12",
            "verseOrgIds": [
              "JER.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:12"
      },
      "items": [
        {
