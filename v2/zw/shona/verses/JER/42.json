  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "42",
        "style": "c",
        "sid": "JER 42"
      },
      "items": [
        {
          "text": "42",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 42:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vakuru vose vehondo, pamwe chete naJohanani mwanakomana waKarea naJezania mwanakomana waHoshaya, navanhu vose kubva kuvaduku kusvikira kuvakuru vakasvika",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.1",
            "verseOrgIds": [
              "JER.42.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 42:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuna Jeremia muprofita vakati kwaari, \"Tapota inzwai chikumbiro chedu mutinyengeterere kuna Jehovha Mwari wenyu nokuda kwavose ava vakasara. Nokuti sezvamunoona zvino, kuti kunyange taiva vazhinji, iye zvino kwangosara vashoma chete.",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.2",
            "verseOrgIds": [
              "JER.42.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 42:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyengeterai kuti Jehovha Mwari wenyu atiudze kwatinofanira kuenda uye zvatinofanira kuita.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.3",
            "verseOrgIds": [
              "JER.42.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 42:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeremia muprofita akapindura achiti, \"Ndakunzwai. Zvirokwazvo ndichakunyengetererai kuna Jehovha Mwari wenyu sezvamakumbira, ndichakuzivisai zvinhu zvose zvicharehwa naJehovha uye handingambokuvanzirai chinhu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.4",
            "verseOrgIds": [
              "JER.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 42:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vakati kuna Jeremia, \"Jehovha ngaave chapupu chezvokwadi uye chakatendeka pamusoro pedu kana tisingaiti zvose zvamunenge matumwa naJehovha kuzotiudza.",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.5",
            "verseOrgIds": [
              "JER.42.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 42:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana zvakanaka, kana zvisina kunaka tichateerera Jehovha Mwari wedu, watinokutumai kwaari kuti zvigotiitira zvakanaka, nokuti tichateerera Jehovha Mwari wedu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.6",
            "verseOrgIds": [
              "JER.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 42:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazuva gumi akati apera, shoko raJehovha rakasvika kuna Jeremia.",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.7",
            "verseOrgIds": [
              "JER.42.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo akaunganidza Johanani mwanakomana waKarea navakuru vose vehondo vaaiva navo navanhu vose kubva kuvaduku kusvikira kuvakuru.",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.8",
            "verseOrgIds": [
              "JER.42.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati kwavari, \"Zvanzi naJehovha, Mwari waIsraeri, iye wamakanditumira kwaari kuti ndisvitse chikumbiro chenyu:",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.9",
            "verseOrgIds": [
              "JER.42.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 42:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Kana mukagara munyika ino, ndichakuvakai handizokukoromorei; ndichakusimai uye handingakudzurei, nokuti ndinorwadziwa nokuda kwenjodzi yandakaisa pamusoro penyu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.10",
            "verseOrgIds": [
              "JER.42.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 42:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musatya mambo weBhabhironi, iye wamunotya zvino. Musamutya, ndizvo zvinotaura Jehovha, nokuti ndinemi uye ndichakuponesai nokukuponesai kubva mumaoko ake.",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.11",
            "verseOrgIds": [
              "JER.42.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 42:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichakunzwirai tsitsi kuitira kuti agokunzwirai tsitsi, agokudzoserai kunyika yenyu.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.12",
            "verseOrgIds": [
              "JER.42.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 42:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kunyange zvakadaro, kana mukati, 'Hatidi kugara munyika ino,' nokudaro musingateerere Jehovha Mwari wenyu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.13",
            "verseOrgIds": [
              "JER.42.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 42:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye kana mukati, 'Kwete tichaenda kundogara kuIjipiti, kwatisingazooni hondo kana kunzwa hwamanda kana kunzwa nzara yechingwa,'",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.14",
            "verseOrgIds": [
              "JER.42.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 42:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "zvino chinzwai shoko raJehovha imi vakasara vaJudha. Zvanzi naJehovha Wamasimba Ose, Mwari waIsraeri, 'Kana mashinga kuenda kuIjipiti kana mukaenda kundogarako,",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.15",
            "verseOrgIds": [
              "JER.42.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 42:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ipapo munondo wamunotya uchakukundai ikoko uye nenzara yamunotya ichakuteverai kuIjipiti, uye muchafira ikoko.",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.16",
            "verseOrgIds": [
              "JER.42.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 42:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvirokwazvo, vose vashinga kuenda kuIjipiti kundogarako vachafa nomunondo, nenzara uye nedenda; hakuna achasara pakati pavo kana kupukunyuka njodzi yandichauyisa pamusoro pavo.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.17",
            "verseOrgIds": [
              "JER.42.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 42:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvanzi naJehovha Wamasimba Ose, Mwari waIsraeri, 'Sokudururwa kwakaitwa hasha dzangu nokutsamwa kwangu pamusoro peavo vaigara muJerusarema, saizvozvo kutsamwa kwangu kuchadururirwa pamusoro penyu kana maenda kuIjipiti. Muchava chinhu chinotukwa nechinosemwa, nechinomhurwa, nokuzvidzwa; hamuchazombooni nzvimbo ino zvakare.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.18",
            "verseOrgIds": [
              "JER.42.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 42:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Haiwa imi vakasara veJudha, Jehovha akuudzai kuti, 'Musaenda kuIjipiti.' Ivai nechokwadi: ndinokuyambirai nhasi",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.19",
            "verseOrgIds": [
              "JER.42.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 42:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti makakanganisa kwazvo pamakandituma kuna Jehovha Mwari wenyu muchiti, 'Tinyengeterere kuna Jehovha Mwari wedu, utiudze zvose zvaanoreva uye isu tichazviita.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.20",
            "verseOrgIds": [
              "JER.42.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 42:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakuudzai nhasi, asi kunyange zvakadaro hamuna kuteerera Jehovha Mwari wenyu pane zvose zvaakandituma kuzokuzivisai imi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.21",
            "verseOrgIds": [
              "JER.42.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 42:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka zvino, ivai nechokwadi nezvizvi: Muchafa nomunondo, nenzara, uye nedenda kunzvimbo yamunoda kuenda kundogara.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.22",
            "verseOrgIds": [
              "JER.42.22"
            ]
          }
        }
      ]
    }
  ],
