    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuchema nokudanidzira kuti vanhu vatendeuke",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "AMO 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzwai shoko iri, imi imba yaIsraeri, kuchema uku kwandinoita pamusoro penyu:",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.1",
            "verseOrgIds": [
              "AMO.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yawira pasi Mhandara Israeri,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.2",
            "verseOrgIds": [
              "AMO.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 5:2"
      },
      "items": [
        {
          "text": "haingazosimukizve,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.2",
            "verseOrgIds": [
              "AMO.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 5:2"
      },
      "items": [
        {
          "text": "akasiyiwa ari oga munyika yake,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.2",
            "verseOrgIds": [
              "AMO.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 5:2"
      },
      "items": [
        {
          "text": "pasina angamusimudza.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.2",
            "verseOrgIds": [
              "AMO.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvanzi naIshe Jehovha:",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.3",
            "verseOrgIds": [
              "AMO.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 5:3"
      },
      "items": [
        {
          "text": "\"Guta richaendesa varwi chiuru vakasimba pakati peIsraeri",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.3",
            "verseOrgIds": [
              "AMO.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 5:3"
      },
      "items": [
        {
          "text": "richasarirwa nezana chete;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.3",
            "verseOrgIds": [
              "AMO.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 5:3"
      },
      "items": [
        {
          "text": "guta richaendesa varwi zana",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.3",
            "verseOrgIds": [
              "AMO.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 5:3"
      },
      "items": [
        {
          "text": "vakasimba richasarirwa negumi chete.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.3",
            "verseOrgIds": [
              "AMO.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvanzi naJehovha kuimba yaIsraeri:",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.4",
            "verseOrgIds": [
              "AMO.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 5:4"
      },
      "items": [
        {
          "text": "\"Nditsvakei murarame;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.4",
            "verseOrgIds": [
              "AMO.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "musatsvaka Bheteri,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.5",
            "verseOrgIds": [
              "AMO.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 5:5"
      },
      "items": [
        {
          "text": "musaenda kuGirigari,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.5",
            "verseOrgIds": [
              "AMO.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 5:5"
      },
      "items": [
        {
          "text": "musaita rwendo rwokuenda kuBheerishebha.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.5",
            "verseOrgIds": [
              "AMO.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 5:5"
      },
      "items": [
        {
          "text": "Nokuti zvirokwazvo Girigari ichaendeswa kuutapwa,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.5",
            "verseOrgIds": [
              "AMO.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 5:5"
      },
      "items": [
        {
          "text": "uye Bheteri richava sapasina chinhu.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.5",
            "verseOrgIds": [
              "AMO.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsvakai Jehovha mugorarama,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.6",
            "verseOrgIds": [
              "AMO.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 5:6"
      },
      "items": [
        {
          "text": "mukasadaro achatsvaira imba yaJosefa sezvinoita moto;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.6",
            "verseOrgIds": [
              "AMO.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 5:6"
      },
      "items": [
        {
          "text": "uchaparadza,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.6",
            "verseOrgIds": [
              "AMO.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 5:6"
      },
      "items": [
        {
          "text": "uye Bheteri richashaya anoudzima.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.6",
            "verseOrgIds": [
              "AMO.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imi vanoshandura kururamisira muchikuita gavakava",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.7",
            "verseOrgIds": [
              "AMO.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 5:7"
      },
      "items": [
        {
          "text": "uye muchikandira kururama pasi",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.7",
            "verseOrgIds": [
              "AMO.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Iye akaita nyeredzi dzeChimutanhatu neOrioni,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.8",
            "verseOrgIds": [
              "AMO.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 5:8"
      },
      "items": [
        {
          "text": "anoshandura rima richiva mambakwedza,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.8",
            "verseOrgIds": [
              "AMO.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 5:8"
      },
      "items": [
        {
          "text": "uye anoita kuti zuva risvibe huve usiku,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.8",
            "verseOrgIds": [
              "AMO.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 5:8"
      },
      "items": [
        {
          "text": "anodana mvura zhinji yegungwa achiidururira panyika,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.8",
            "verseOrgIds": [
              "AMO.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 5:8"
      },
      "items": [
        {
          "text": "Jehovha ndiro zita rake,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.8",
            "verseOrgIds": [
              "AMO.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "anoparadza nhare pakarepo uye anoita",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.9",
            "verseOrgIds": [
              "AMO.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 5:9"
      },
      "items": [
        {
          "text": "kuti guta rina masvingo rive dongo),",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.9",
            "verseOrgIds": [
              "AMO.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "munovenga anorayira padare",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.10",
            "verseOrgIds": [
              "AMO.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 5:10"
      },
      "items": [
        {
          "text": "uye munozvidza anotaura chokwadi.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.10",
            "verseOrgIds": [
              "AMO.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "AMO 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munotsika pamusoro pomurombo",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.11",
            "verseOrgIds": [
              "AMO.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 5:11"
      },
      "items": [
        {
          "text": "muchimumanikidza kuti akupei zviyo.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.11",
            "verseOrgIds": [
              "AMO.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 5:11"
      },
      "items": [
        {
          "text": "Naizvozvo, kunyange makavaka dzimba huru dzamabwe,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.11",
            "verseOrgIds": [
              "AMO.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 5:11"
      },
      "items": [
        {
          "text": "hamungagari madziri;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.11",
            "verseOrgIds": [
              "AMO.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 5:11"
      },
      "items": [
        {
          "text": "kunyange makasima minda yakasvibira yemizambiringa,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.11",
            "verseOrgIds": [
              "AMO.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 5:11"
      },
      "items": [
        {
          "text": "hamunganwi waini yayo.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.11",
            "verseOrgIds": [
              "AMO.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "AMO 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti ndinoziva kuwanda kwemhosva",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.12",
            "verseOrgIds": [
              "AMO.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 5:12"
      },
      "items": [
        {
          "text": "dzenyu nokukura kwakaita zvivi zvenyu.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.12",
            "verseOrgIds": [
              "AMO.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "AMO 5:12"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 5:12"
      },
      "items": [
        {
          "text": "Munodzvinyirira vakarurama uye munotora fufuro,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.12",
            "verseOrgIds": [
              "AMO.5.12"
            ]
