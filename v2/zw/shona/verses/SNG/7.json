  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "SNG 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "SNG 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dzakanaka sei tsoka dzako dzakapfekedzwa shangu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.1",
            "verseOrgIds": [
              "SNG.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:1"
      },
      "items": [
        {
          "text": "iwe mwanasikana womuchinda!",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.1",
            "verseOrgIds": [
              "SNG.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 7:1"
      },
      "items": [
        {
          "text": "Makumbo ako akanakisisa akaita sezvishongo,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.1",
            "verseOrgIds": [
              "SNG.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:1"
      },
      "items": [
        {
          "text": "basa ramaoko emhizha.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.1",
            "verseOrgIds": [
              "SNG.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "SNG 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guvhu rako rakatenderera somukombe",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.2",
            "verseOrgIds": [
              "SNG.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:2"
      },
      "items": [
        {
          "text": "unogara uine waini yakasanganiswa zvakanaka.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.2",
            "verseOrgIds": [
              "SNG.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 7:2"
      },
      "items": [
        {
          "text": "Chiuno chako murwi wegorosi",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.2",
            "verseOrgIds": [
              "SNG.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:2"
      },
      "items": [
        {
          "text": "wakakomberedzwa namaruva.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.2",
            "verseOrgIds": [
              "SNG.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "SNG 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazamu ako akaita setsvana mbiri,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.3",
            "verseOrgIds": [
              "SNG.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:3"
      },
      "items": [
        {
          "text": "mapatya emhara.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.3",
            "verseOrgIds": [
              "SNG.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "SNG 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutsipa wakaita seshongwe yakagadzirwa nenyanga dzenzou.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.4",
            "verseOrgIds": [
              "SNG.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 7:4"
      },
      "items": [
        {
          "text": "Meso ako ndiwo madziva eHeshibhoni",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.4",
            "verseOrgIds": [
              "SNG.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:4"
      },
      "items": [
        {
          "text": "pasuo reBhati Rabhimi.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.4",
            "verseOrgIds": [
              "SNG.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 7:4"
      },
      "items": [
        {
          "text": "Mhuno yako yakaita seshongwe yeRebhanoni",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.4",
            "verseOrgIds": [
              "SNG.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:4"
      },
      "items": [
        {
          "text": "yakatarisa kudivi reDhamasiko.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.4",
            "verseOrgIds": [
              "SNG.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "SNG 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musoro wako unokushongedza nekorona seGomo reKarimeri.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.5",
            "verseOrgIds": [
              "SNG.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:5"
      },
      "items": [
        {
          "text": "Bvudzi rako rakaita sezvirukwa zvomumba mamambo;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.5",
            "verseOrgIds": [
              "SNG.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:5"
      },
      "items": [
        {
          "text": "mwoyo wamambo wakabatwa nokugadzirwa kwebvudzi rako.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.5",
            "verseOrgIds": [
              "SNG.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "SNG 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakanaka uye unofadza sei,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.6",
            "verseOrgIds": [
              "SNG.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:6"
      },
      "items": [
        {
          "text": "iwe mudiwa nezvinofadza zvako!",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.6",
            "verseOrgIds": [
              "SNG.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "SNG 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimiro chako chakaita somuti womuchindwe;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.7",
            "verseOrgIds": [
              "SNG.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:7"
      },
      "items": [
        {
          "text": "uye mazamu ako samasumbu omuchero.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.7",
            "verseOrgIds": [
              "SNG.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "SNG 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakati, \"Ndichakwira muchindwi uyu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.8",
            "verseOrgIds": [
              "SNG.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:8"
      },
      "items": [
        {
          "text": "ndigobata muchero wawo.\"",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.8",
            "verseOrgIds": [
              "SNG.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 7:8"
      },
      "items": [
        {
          "text": "Mazamu ako ngaaite samasumbu omuzambiringa,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.8",
            "verseOrgIds": [
              "SNG.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:8"
      },
      "items": [
        {
          "text": "munhuwi wokufema kwako uite samaapuro,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.8",
            "verseOrgIds": [
              "SNG.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "SNG 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "muromo wako ugoita sewaini yakanakisisa.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.9",
            "verseOrgIds": [
              "SNG.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp",
        "vid": "SNG 7:9"
      },
      "items": [
        {
          "text": "Mukadzi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 7:9"
      },
      "items": [
        {
          "text": "Waini ngaiendeswe kumudiwa wangu chaiko,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.9",
            "verseOrgIds": [
              "SNG.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:9"
      },
      "items": [
        {
          "text": "igoyerera zvinyoronyoro, napamiromo yake nameno ake.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.9",
            "verseOrgIds": [
              "SNG.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "SNG 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ini ndiri womudiwa wangu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.10",
            "verseOrgIds": [
              "SNG.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:10"
      },
      "items": [
        {
          "text": "uye iye anondishuva.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.10",
            "verseOrgIds": [
              "SNG.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "SNG 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uya, mudiwa wangu, ngatiendei kumunda,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.11",
            "verseOrgIds": [
              "SNG.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:11"
      },
      "items": [
        {
          "text": "tigozopedza usiku hwose kumaruwa.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.11",
            "verseOrgIds": [
              "SNG.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "SNG 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngatimukirei kuminda yemizambiringa",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.12",
            "verseOrgIds": [
              "SNG.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:12"
      },
      "items": [
        {
          "text": "tindoona kana mizambiringa yakabukira,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.12",
            "verseOrgIds": [
              "SNG.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 7:12"
      },
      "items": [
        {
          "text": "uye kana maruva awo azaruka,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.12",
            "verseOrgIds": [
              "SNG.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:12"
      },
      "items": [
        {
          "text": "uye kana mitamba yatumbuka yava namaruva,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.12",
            "verseOrgIds": [
              "SNG.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:12"
      },
      "items": [
        {
          "text": "ikoko ndiko kwandichakupa rudo rwangu.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.12",
            "verseOrgIds": [
              "SNG.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "SNG 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miti yemidiwadiwa inopa kunhuhwira kwayo,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.13",
            "verseOrgIds": [
              "SNG.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:13"
      },
      "items": [
        {
          "text": "uye pamusuo pedu pane zvinonaka zvose,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.13",
            "verseOrgIds": [
              "SNG.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 7:13"
      },
      "items": [
        {
          "text": "zvose zvitsva nezvitsaru,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.13",
            "verseOrgIds": [
              "SNG.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
