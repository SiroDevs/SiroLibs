          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbiru dzacho akadzigadzira nesirivha,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.10",
            "verseOrgIds": [
              "SNG.3.10"
            ]
          }
        }
      ]
    },
