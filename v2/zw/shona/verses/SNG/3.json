          "type": "text",
          "attrs": {
            "verseId": "SNG.3.8",
            "verseOrgIds": [
              "SNG.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:8"
      },
      "items": [
        {
          "text": "vose vakarwa hondo,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.8",
            "verseOrgIds": [
              "SNG.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 3:8"
      },
      "items": [
        {
          "text": "mumwe nomumwe ane munondo parutivi rwake,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.8",
            "verseOrgIds": [
              "SNG.3.8"
            ]
          }
        }
      ]
    },
