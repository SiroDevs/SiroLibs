        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "SNG 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dai chete wakanga uri sehanzvadzi kwandiri,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.1",
            "verseOrgIds": [
              "SNG.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:1"
      },
      "items": [
        {
          "text": "akanwa pamazamu amai vangu!",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.1",
            "verseOrgIds": [
              "SNG.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 8:1"
      },
      "items": [
        {
          "text": "Ipapo kana ndaikuwana panze,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.1",
            "verseOrgIds": [
              "SNG.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:1"
      },
      "items": [
        {
          "text": "ndaikutsvoda",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.1",
            "verseOrgIds": [
              "SNG.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:1"
      },
      "items": [
        {
          "text": "uye hapana aizondishora.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.1",
            "verseOrgIds": [
              "SNG.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "SNG 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaizokutora ndouya newe",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.2",
            "verseOrgIds": [
              "SNG.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:2"
      },
      "items": [
        {
          "text": "kumba kwamai vangu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.2",
            "verseOrgIds": [
              "SNG.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:2"
      },
      "items": [
        {
          "text": "ivo vakandidzidzisa.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.2",
            "verseOrgIds": [
              "SNG.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 8:2"
      },
      "items": [
        {
          "text": "Ndaikupa waini yakaiswa zvinonhuhwira kuti unwe,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.2",
            "verseOrgIds": [
              "SNG.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:2"
      },
      "items": [
        {
          "text": "nomukume wemitamba yangu.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.2",
            "verseOrgIds": [
              "SNG.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "SNG 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruoko rwake rworuboshwe rwuri pasi pomusoro wangu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.3",
            "verseOrgIds": [
              "SNG.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:3"
      },
      "items": [
        {
          "text": "uye ruoko rwake rworudyi rwakandimbundikira.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.3",
            "verseOrgIds": [
              "SNG.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "SNG 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imi vanasikana veJerusarema ndinokurayirai:",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.4",
            "verseOrgIds": [
              "SNG.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:4"
      },
      "items": [
        {
          "text": "Musazunguza kana kumutsa rudo",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.4",
            "verseOrgIds": [
              "SNG.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:4"
      },
      "items": [
        {
          "text": "kusvikira irwo rwada rwoga.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.4",
            "verseOrgIds": [
              "SNG.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Shamwari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "SNG 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndianiko uyo ari kuuya achibva kurenje",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.5",
            "verseOrgIds": [
              "SNG.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:5"
      },
      "items": [
        {
          "text": "akazendamira pamudiwa wake?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.5",
            "verseOrgIds": [
              "SNG.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp",
        "vid": "SNG 8:5"
      },
      "items": [
        {
          "text": "Mukadzi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 8:5"
      },
      "items": [
        {
          "text": "Pasi pomuti womuapuro ndakakumutsa;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.5",
            "verseOrgIds": [
              "SNG.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:5"
      },
      "items": [
        {
          "text": "ipapo mai vako vakakubereka,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.5",
            "verseOrgIds": [
              "SNG.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:5"
      },
      "items": [
        {
          "text": "ipapo ivo vairwadziwa vakakubereka.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.5",
            "verseOrgIds": [
              "SNG.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "SNG 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiise pamwoyo pako sechisimbiso,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.6",
            "verseOrgIds": [
              "SNG.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:6"
      },
      "items": [
        {
          "text": "sechisimbiso paruoko rwako;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.6",
            "verseOrgIds": [
              "SNG.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 8:6"
      },
      "items": [
        {
          "text": "nokuti rudo rwakasimba sorufu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.6",
            "verseOrgIds": [
              "SNG.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:6"
      },
      "items": [
        {
          "text": "godo rarwo seguva harishanduki.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.6",
            "verseOrgIds": [
              "SNG.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 8:6"
      },
      "items": [
        {
          "text": "Runopisa serimi romoto,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.6",
            "verseOrgIds": [
              "SNG.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:6"
      },
      "items": [
        {
          "text": "somurazvo mukuru kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.6",
            "verseOrgIds": [
              "SNG.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
