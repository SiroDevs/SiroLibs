          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mvura zhinji haigoni kudzima rudo;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.7",
            "verseOrgIds": [
              "SNG.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:7"
      },
      "items": [
        {
          "text": "nzizi hadzigoni kurukukura.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.7",
            "verseOrgIds": [
              "SNG.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 8:7"
      },
      "items": [
        {
          "text": "Kunyange munhu akapa",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.7",
            "verseOrgIds": [
              "SNG.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:7"
      },
      "items": [
        {
          "text": "pfuma yose yemba yake kuti awane rudo,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.7",
            "verseOrgIds": [
              "SNG.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:7"
      },
      "items": [
        {
          "text": "zvingazvidzwa chose.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.7",
            "verseOrgIds": [
              "SNG.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
