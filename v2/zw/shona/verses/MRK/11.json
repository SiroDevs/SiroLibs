{
  "id": "MRK.11",
  "number": "11",
  "bookId": "MRK",
  "reference": "Mako 11",
  "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "MRK 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu Anopinda muJerusarema saMambo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pavakanga vava kusvika kuJerusarema uye vasvika kuBhetifage neBhetani paGomo reMiorivhi, Jesu akatuma vaviri vavadzidzi vake,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.1",
            "verseOrgIds": [
              "MRK.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "achiti kwavari, \"Endai mumusha wakatarisana nemi. Pamunongopinda mauri, muchawana mwana wembongoro asina kumbotasvwa nomunhu, akasungirirwa ipapo. Mumusunungure mugouya naye pano.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.2",
            "verseOrgIds": [
              "MRK.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana mukabvunzwa nomunhu kuti, 'Seiko muchiita izvi?' muti kwaari, 'Ishe anomuda uye achamudzosa pano nokukurumidza.' \"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.3",
            "verseOrgIds": [
              "MRK.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakaenda vakandowana mwana wembongoro ari kunze munzira yomumusha, akasungirirwa pamukova. Pavakamusunungura,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.4",
            "verseOrgIds": [
              "MRK.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "vamwe vanhu vakanga vamirepo vakabvunza vakati, \"Muri kuitei, muchisunungura mwana wembongoro uyo?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.5",
            "verseOrgIds": [
              "MRK.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakapindura sezvavakanga vaudzwa naJesu, uye vanhu vakavarega vachienda.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.6",
            "verseOrgIds": [
              "MRK.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakauya nembongoro iyi kuna Jesu vakakanda majasi avo pamusoro payo, iye akagara pairi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.7",
            "verseOrgIds": [
              "MRK.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vazhinji vakawaridza majasi avo mumigwagwa, vamwe vakawaridza matavi avakanga vatema musango.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.8",
            "verseOrgIds": [
              "MRK.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakanga vari mberi navaya vaitevera vakadanidzira vachiti:",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.9",
            "verseOrgIds": [
              "MRK.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MRK 11:9"
      },
      "items": [
        {
          "text": "\"Hosana!\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.9",
            "verseOrgIds": [
              "MRK.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "MRK 11:9"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MRK 11:9"
      },
      "items": [
        {
          "text": "\"Akaropafadzwa uyo anouya muzita raShe!\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.9",
            "verseOrgIds": [
              "MRK.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Hwakaropafadzwa umambo hunouya, hwababa vedu Dhavhidhi!\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.10",
            "verseOrgIds": [
              "MRK.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "MRK 11:10"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MRK 11:10"
      },
      "items": [
        {
          "text": "\"Hosana kumusoro-soro!\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.10",
            "verseOrgIds": [
              "MRK.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akapinda muJerusarema uye akaenda kutemberi. Akatarisa-tarisa zvinhu zvose, asi sezvo kwakanga kwadoka, akabuda akaenda kuBhetani navane gumi navaviri.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.11",
            "verseOrgIds": [
              "MRK.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu Anonatsa Temberi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fume mangwana pavakanga vobva kuBhetani, Jesu akanzwa nzara.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.12",
            "verseOrgIds": [
              "MRK.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaona muonde uri kure una mashizha, akaenda kundoona kana wakanga une muchero. Akati asvika pauri, haana chaakawana asi mashizha bedzi, nokuti yakanga isiri nguva yamaonde.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.13",
            "verseOrgIds": [
              "MRK.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akati kumuti, \"Ngakurege kuva nomunhu anodya muchero paurizve.\" Vadzidzi vake vakamunzwa achidaro.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.14",
            "verseOrgIds": [
              "MRK.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paakasvika muJerusarema, Jesu akapinda mutemberi akatanga kudzingira kunze vaya vakanga vachitenga nokutengeserana imomo. Akapidigura tafura dzevaitsinhana mari nezvigaro zvevaitengesa njiva,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.15",
            "verseOrgIds": [
              "MRK.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye haana kutendera munhu kutakura zvaitengeswa achipinda nomuchivanze chete mberi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.16",
            "verseOrgIds": [
              "MRK.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye akavadzidzisa achiti, \"Ko, hazvina kunyorwa here kuti:",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.17",
            "verseOrgIds": [
              "MRK.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MRK 11:17"
      },
      "items": [
        {
          "text": "\" 'Imba yangu ichanzi",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.17",
            "verseOrgIds": [
              "MRK.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MRK 11:17"
      },
      "items": [
        {
          "text": "imba yokunyengetera yendudzi dzose'?",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.17",
            "verseOrgIds": [
              "MRK.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "MRK 11:17"
      },
      "items": [
        {
          "text": "Asi imi maiita 'bako ramakororo.' \"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.17",
            "verseOrgIds": [
              "MRK.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaprista vakuru navadzidzisi vomurayiro vakazvinzwa ndokubva vatanga kutsvaka nzira yokumuuraya nayo, nokuti vaimutya, nokuti vanhu vazhinji vose vaishamiswa nedzidziso yake.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.18",
            "verseOrgIds": [
              "MRK.11.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Madekwana akati asvika, vakaenda kunze kweguta.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.19",
            "verseOrgIds": [
              "MRK.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Muonde Wakaoma",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mangwanani, pavakanga vachifamba, vakaona muonde wakaoma kubva kumidzi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.20",
            "verseOrgIds": [
              "MRK.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petro akarangarira akati kuna Jesu, \"Rabhi, tarirai! Muonde wamakatuka waoma!\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.21",
            "verseOrgIds": [
              "MRK.11.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akapindura akati, \"Ivai nokutenda muna Mwari.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.22",
            "verseOrgIds": [
              "MRK.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinokuudzai chokwadi, kana munhu akati kugomo iri, 'Enda, uzvikande mugungwa,' uye asingakahadziki nazvo mumwoyo make, asi achitenda kuti zvaareva zvichaitika, achazviitirwa.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.23",
            "verseOrgIds": [
              "MRK.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo ndinoti kwamuri, zvose zvamunokumbira mukunyengetera, tendai kuti mazvigamuchira, uye zvichava zvenyu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.24",
            "verseOrgIds": [
              "MRK.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye paunomira uchinyengetera, kana mumwe munhu akakutadzira, muregerere, kuitira kuti Baba vako vari kudenga vagokuregerera zvivi zvako.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.25",
            "verseOrgIds": [
              "MRK.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana usingaregereri, Baba vako vari kudenga havazoregereri zvivi zvako.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.26",
            "verseOrgIds": [
              "MRK.11.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Simba raJesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakasvikazve muJerusarema, uye Jesu paaifamba mutemberi, vaprista vakuru, vadzidzisi vomurayiro navakuru vakauya kwaari.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.27",
            "verseOrgIds": [
              "MRK.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati, \"Unoita zvinhu izvi nesimba ripiko? Uye ndiani akakupa simba rokuita izvi?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.28",
            "verseOrgIds": [
              "MRK.11.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akapindura akati, \"Ndichakubvunzai mubvunzo mumwe chete. Ndipindurei, ndigokuudzai simba randinoita naro zvinhu izvi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.29",
            "verseOrgIds": [
              "MRK.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rubhabhatidzo rwaJohani, rwakabva kudenga kana kuti kuvanhu? Ndiudzei!\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.30",
            "verseOrgIds": [
              "MRK.11.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakataurirana pakati pavo vakati, \"Kana tikati, 'Kudenga,' achati, 'Zvino makaregereiko kumutenda?'",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.31",
            "verseOrgIds": [
              "MRK.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana tikati kuvanhu…\" (Vakanga vachitya vanhu, nokuti vanhu vose vaitenda kuti Johani akanga ari muprofita zvechokwadi.)",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.32",
            "verseOrgIds": [
              "MRK.11.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vakapindura Jesu vachiti, \"Hatizivi.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.33",
            "verseOrgIds": [
              "MRK.11.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MRK 11:33"
      },
      "items": [
        {
          "text": "Jesu akati, \"Neniwo handikuudzei simba randinoita naro zvinhu izvi.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.33",
            "verseOrgIds": [
              "MRK.11.33"
            ]
          }
        }
      ]
    }
  ],
