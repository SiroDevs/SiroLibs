  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "MRK 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu Anoporesa Munhu Akanga Akafa Mutezo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwamazuva mashoma shoma, Jesu akati apindazve muKapenaume, vanhu vakanzwa kuti akanga auya kumusha.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.1",
            "verseOrgIds": [
              "MRK.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vazhinji vakaungana zvokuti mumba makasara musisina nzvimbo kunyange kunze kwomukova, uye akaparidza shoko kwavari.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.2",
            "verseOrgIds": [
              "MRK.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vamwe varume vakasvika, vakauya kwaari nomunhu akanga akafa mutezo, akatakurwa navarume vana.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.3",
            "verseOrgIds": [
              "MRK.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sezvo vakanga vasingagoni kusvika naye kuna Jesu nokuda kwokuwanda kwavanhu, vakazarura denga reimba pamusoro paJesu uye, vakati variputsa, vakaburutsa nhoo pakanga pavete uya munhu akanga akafa mutezo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.4",
            "verseOrgIds": [
              "MRK.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati aona kutenda kwavo, akati kuno uya akanga akafa mutezo, \"Mwanakomana, zvivi zvako zvaregererwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.5",
            "verseOrgIds": [
              "MRK.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino vamwe vadzidzisi vomurayiro, vakanga vagere ipapo, vakafunga mumwoyo yavo vachiti,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.6",
            "verseOrgIds": [
              "MRK.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Munhu uyu anotaura sei achidaro? Ari kumhura Mwari! Ndianiko anoregerera zvivi asi Mwari oga?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.7",
            "verseOrgIds": [
              "MRK.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakarepo Jesu akazviziva mumweya wake kuti ndizvo zvavakanga vachifunga mumwoyo yavo, uye akati kwavari, \"Seiko muchifunga zvinhu izvi?",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.8",
            "verseOrgIds": [
              "MRK.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndezvipiko zvakareruka: Kuti kuno wakafa mutezo, 'Zvivi zvako zvaregererwa,' kana kuti, 'Simuka, tora nhoo yako ufambe'?",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.9",
            "verseOrgIds": [
              "MRK.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kuti muzive kuti Mwanakomana woMunhu ane simba panyika rokuregerera zvivi.\" Akati kuna akanga akafa mutezo,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.10",
            "verseOrgIds": [
              "MRK.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndinoti kwauri, simuka, tora nhoo yako uende kumba.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.11",
            "verseOrgIds": [
              "MRK.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akasimuka kubva panhoo yake, akatora nhoo yake akafamba akabuda vose vachizviona. Izvi zvakashamisa munhu wose uye vakarumbidza Mwari vachiti, \"Hatina kumboona chinhu chakadai!\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.12",
            "verseOrgIds": [
              "MRK.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kudanwa kwaRevhi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jesu akabudazve akaenda kugungwa. Vanhu vazhinji zhinji vakauya kwaari uye akatanga kuvadzidzisa.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.13",
            "verseOrgIds": [
              "MRK.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paaifamba achitevedza gungwa, akaona Revhi mwanakomana waArifeasi agere paitererwa mutero. Jesu akati kwaari, \"Nditevere,\" ipapo Revhi akasimuka akamutevera.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.14",
            "verseOrgIds": [
              "MRK.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu paakanga achidya kudya kwamanheru pamba paRevhi, vateresi vazhinji na\"vatadzi\" vakanga vachidya naye, navadzidzi vake, nokuti kwaiva navazhinji vaimutevera.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.15",
            "verseOrgIds": [
              "MRK.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vadzidzisi vomurayiro, ivo vaFarisi, vakati vachimuona achidya na\"vatadzi\" navateresi, vakabvunza vadzidzi vake vakati, \"Seiko achidya navateresi na'vatadzi'?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.16",
            "verseOrgIds": [
              "MRK.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anzwa izvozvo, Jesu akati kwavari, \"Vasingarwari havatsvaki chiremba, asi vanorwara. Handina kuuya kuzodana vakarurama, asi vatadzi.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.17",
            "verseOrgIds": [
              "MRK.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vanobvunza Jesu pamusoro poKutsanya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino vadzidzi vaJohani navaFarisi vakanga vachitsanya. Vamwe vanhu vakauya vakabvunza Jesu vakati, \"Sei vadzidzi vaJohani navadzidzi vavaFarisi vachitsanya, asi venyu vasingatsanyi?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.18",
            "verseOrgIds": [
              "MRK.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akapindura akati, \"Shamwari dzechikomba dzingatsanya seiko kana iye achinavo? Havangadaro, kana iye achinavo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.19",
            "verseOrgIds": [
              "MRK.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi nguva ichasvika ichabviswa chikomba kwavari, uye pazuva iroro vachatsanya.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.20",
            "verseOrgIds": [
              "MRK.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Hakuna munhu anoisa chigamba chitsva panguo tsaru. Kana akadaro, chigamba chitsva chichabvarura chitsaru, zvoita kuti buri racho rinyanye kukura.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.21",
            "verseOrgIds": [
              "MRK.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye hakuna munhu anodira waini itsva muhombodo dzamatehwe tsaru. Kana akaita izvozvo, waini ichaputitsa matehwe, uye zvose waini nedehwe rewaini zvichaparara. Kwete, anodira waini itsva muhombodo itsva.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.22",
            "verseOrgIds": [
              "MRK.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ishe weSabata",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwe musi weSabata, Jesu akanga achipfuura nomuminda yezviyo, uye vadzidzi vake vakanga vachifamba naye, vakatanga kutanha hura dzezviyo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.23",
            "verseOrgIds": [
              "MRK.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaFarisi vakati kwaari, \"Tarirai, seiko vachiita zvisingatenderwi nomusi weSabata.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.24",
            "verseOrgIds": [
              "MRK.2.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapindura akati, \"Hamuna kumboverenga here zvakaitwa naDhavhidhi navamwe vake pavakanga vashayiwa zvokudya uye vonzwa nzara?",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.25",
            "verseOrgIds": [
              "MRK.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumazuva aAbhiatari muprista mukuru, akapinda mumba maMwari akadya chingwa chakatsaurwa, chinongotenderwa kudyiwa navaprista chete. Uye akapawo vamwe vaaiva navo.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.26",
            "verseOrgIds": [
              "MRK.2.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akati kwavari, \"Sabata rakaitirwa munhu, munhu haana kuitirwa Sabata.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.27",
            "verseOrgIds": [
              "MRK.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Mwanakomana woMunhu ndiye Ishe kunyange weSabata.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.28",
            "verseOrgIds": [
              "MRK.2.28"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "MRK.3",
