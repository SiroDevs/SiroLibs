  "verseCount": 52,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "MRK 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kurambana",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Jesu akabva panzvimbo iyoyo akaenda munyika yeJudhea uye akayambuka mhiri kweJorodhani. Vanhu vazhinji vakauyazve kwaari, uye sezvayakanga iri tsika yake, akavadzidzisa.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.1",
            "verseOrgIds": [
              "MRK.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vamwe vaFarisi vakauya vakamuedza nokumubvunza vachiti, \"Zvinotenderwa here kuti munhu arambe mukadzi wake?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.2",
            "verseOrgIds": [
              "MRK.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye akati, \"Mozisi akakurayirai kuti kudiniko?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.3",
            "verseOrgIds": [
              "MRK.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivo vakati, \"Mozisi akatendera murume kuti anyore tsamba yokurambana uye agomuendesa.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.4",
            "verseOrgIds": [
              "MRK.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akapindura akati, \"Nokuti mwoyo yenyu yakanga iri mikukutu, Mozisi akakunyorerai murayiro uyu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.5",
            "verseOrgIds": [
              "MRK.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kubvira kumavambo okusikwa kwezvinhu, Mwari 'akavaita murume nomukadzi.'",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.6",
            "verseOrgIds": [
              "MRK.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuda kwaizvozvi, murume achasiya baba vake namai vake uye agonamatira kumukadzi wake,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.7",
            "verseOrgIds": [
              "MRK.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye vaviri ava vachava nyama imwe. Saka havachisiri vaviri, asi nyama imwe.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.8",
            "verseOrgIds": [
              "MRK.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo izvo zvabatanidzwa naMwari, munhu ngaarege kuzviparadzanisa.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.9",
            "verseOrgIds": [
              "MRK.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati vapindazve mumba, vadzidzi vakabvunza Jesu pamusoro paizvozvi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.10",
            "verseOrgIds": [
              "MRK.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapindura akati, \"Ani naani anoramba mukadzi wake uye akawana mumwe mukadzi, ava kuita upombwe naye.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.11",
            "verseOrgIds": [
              "MRK.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye kana iye akarambawo murume wake uye akawanikwa nomumwe murume, anoita upombwe naye.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.12",
            "verseOrgIds": [
              "MRK.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu naVana Vaduku",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vakanga vachiuya navana vaduku kuna Jesu kuti avabate, asi vadzidzi vakavatsiura.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.13",
            "verseOrgIds": [
              "MRK.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu paakazviona, akatsamwa. Akati kwavari, \"Regai vana vaduku vauye kwandiri, uye musavadzivisa, nokuti umambo hwaMwari ndohwavakadai.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.14",
            "verseOrgIds": [
              "MRK.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinokuudzai chokwadi, ani naani asingagamuchiri umambo hwaMwari somwana muduku haangatongopindi mahuri.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.15",
            "verseOrgIds": [
              "MRK.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akatora vana akavafungatira mumaoko ake, akaisa maoko ake pamusoro pavo akavaropafadza.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.16",
            "verseOrgIds": [
              "MRK.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jaya Mupfumi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati achifamba munzira, mumwe murume akamhanyira kwaari akawira pasi namabvi ake pamberi pake. Akabvunza akati, \"Mudzidzisi akanaka, ndinofanira kuiteiko kuti ndigare nhaka youpenyu husingaperi?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.17",
            "verseOrgIds": [
              "MRK.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akapindura akati, \"Unondiidzireiko akanaka? Hakuna munhu akanaka kunze kwaMwari oga.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.18",
            "verseOrgIds": [
              "MRK.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mirayiro unoiziva here inoti: 'Usauraya, usaita upombwe, usaba, usapupura nhema, usanyengera, kudza baba vako namai vako.' \"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.19",
            "verseOrgIds": [
              "MRK.10.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye akati, \"Mudzidzisi, izvi zvose ndakazvichengeta kubvira ndichiri mukomana.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.20",
            "verseOrgIds": [
              "MRK.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akamutarira uye akamuda, akati kwaari, \"Unoshayiwa chinhu chimwe chete. Enda undotengesa zvinhu zvose zvaunazvo upe kuvarombo, ugova nepfuma kudenga. Ipapo ugouya, unditevere.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.21",
            "verseOrgIds": [
              "MRK.10.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anzwa izvi akasuwa kwazvo. Akaenda akasuwa, nokuti akanga ane pfuma zhinji.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.22",
            "verseOrgIds": [
              "MRK.10.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akatarira-tarira ndokuti kuvadzidzi vake, \"Zvakaoma sei kuti mupfumi apinde muumambo hwaMwari!\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.23",
            "verseOrgIds": [
              "MRK.10.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vadzidzi vakashamiswa namashoko ake. Asi Jesu akatizve, \"Vana, zvakaoma sei kupinda muumambo hwaMwari!",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.24",
            "verseOrgIds": [
              "MRK.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zviri nyore kuti ngamera ipinde napaburi retsono pano kuti mupfumi apinde muumambo hwaMwari.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.25",
            "verseOrgIds": [
              "MRK.10.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vadzidzi vakanyanya kushamiswa, uye vakati pakati pavo, \"Zvino ndianiko angaponeswa?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.26",
            "verseOrgIds": [
              "MRK.10.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akatarisa kwavari akati, \"Kumunhu hazvigoneki, asi kwete naMwari; zvinhu zvose zvinogoneka kuna Mwari.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.27",
            "verseOrgIds": [
              "MRK.10.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petro akati kwaari, \"Isu takasiya zvinhu zvose kuti tikuteverei!\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.28",
            "verseOrgIds": [
              "MRK.10.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akapindura akati, \"Ndinokuudzai chokwadi, hakuna munhu akasiya musha, kana vanunʼuna kana hanzvadzi kana mai kana baba kana vana kana minda nokuda kwangu uye nokuda kwevhangeri",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.29",
            "verseOrgIds": [
              "MRK.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "achakundikana kugamuchira zvakawanda kakapetwa kazana munguva ino (misha, vanunʼuna, hanzvadzi, vanamai, vana neminda, uye pamwe chete naizvozvo, kutambudzika) uye panguva inouya, upenyu husingaperi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.30",
            "verseOrgIds": [
              "MRK.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vazhinji vanova vokutanga ndivo vachava vokupedzisira, uye vokupedzisira vachava vokutanga.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.31",
            "verseOrgIds": [
              "MRK.10.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu Anotaurazve nezvoKufa Kwake",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakanga vari munzira vachikwidza kuenda kuJerusarema, Jesu achivatungamirira, uye vadzidzi vakakatyamara, asi vaya vakanga vachitevera vakanga vachitya. Akatorazve vane gumi navaviri vari voga uye akavaudza zvaizoitika kwaari.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.32",
            "verseOrgIds": [
              "MRK.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati, \"Tiri kuenda kuJerusarema, uye Mwanakomana woMunhu achapandukirwa agoiswa kuvaprista vakuru navadzidzisi vomurayiro. Vachamutongera rufu uye vachamuisa mumaoko eveDzimwe Ndudzi,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.33",
            "verseOrgIds": [
              "MRK.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "avo vachamuseka uye vagomupfira mate, vachamurova uye vagomuuraya. Shure kwamazuva matatu, achamuka.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.34",
            "verseOrgIds": [
              "MRK.10.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chikumbiro chaJakobho naJohani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jakobho naJohani vanakomana vaZebhedhi, vakauya kwaari, vakati, \"Mudzidzisi, tinoda kuti mutiitire zvose zvose zvatinokumbira.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.35",
            "verseOrgIds": [
              "MRK.10.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akavabvunza akati, \"Munoda kuti ndikuitireiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.36",
            "verseOrgIds": [
              "MRK.10.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakapindura vakati, \"Titenderei kuti mumwe wedu agare kuruoko rwenyu rworudyi uye mumwe kuruboshwe rwenyu mukubwinya kwenyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.37",
            "verseOrgIds": [
              "MRK.10.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MRK 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati, \"Hamuzivi zvamunokumbira. Mungagona here kunwa mukombe wandinonwa kana kubhabhatidzwa norubhabhatidzo rwandinobhabhatidzwa narwo?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.38",
            "verseOrgIds": [
              "MRK.10.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MRK 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakapindura vakati, \"Tinogona.\" Jesu akati, \"Muchanwa mukombe wandinonwa uye muchabhabhatidzwa norubhabhatidzo rwandinobhabhatidzwa narwo,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.39",
            "verseOrgIds": [
              "MRK.10.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MRK 10:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi zvokugara kuruoko rwangu rworudyi kana kuruboshwe handisini ndinozvipa. Nzvimbo idzi ndedzavaya vakadzigadzirirwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.40",
            "verseOrgIds": [
              "MRK.10.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MRK 10:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vane gumi vakati vanzwa izvi, vakatsamwira Jakobho naJohani.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.41",
            "verseOrgIds": [
              "MRK.10.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MRK 10:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akavadana pamwe chete akati, \"Munoziva kuti vaya vanonzi vatongi neveDzimwe Ndudzi vanotonga pamusoro pavo, uye vabati vavo vakuru vanoshandisa simba pamusoro pavo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.42",
            "verseOrgIds": [
              "MRK.10.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MRK 10:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazvina kudaro pakati penyu. Pachinzvimbo chaizvozvo, ani naani anoda kuva mukuru pakati penyu anofanira kuva muranda wenyu,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.43",
            "verseOrgIds": [
              "MRK.10.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MRK 10:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye ani naani anoda kuva wokutanga anofanira kuva nhapwa yavose.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.44",
            "verseOrgIds": [
              "MRK.10.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MRK 10:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti kunyange Mwanakomana woMunhu haana kuuya kuzoshumirwa, asi kuzoshumira uye nokupa upenyu hwake kuti huve rudzikinuro rwavazhinji.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.45",
            "verseOrgIds": [
              "MRK.10.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bhatimeo Bofu Anosvinudzwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MRK 10:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vakasvika kuJeriko. Jesu navadzidzi vake, pamwe chete navanhu vazhinji, vakati vobuda muguta, Bhatimeo, murume akanga ari bofu, (ndiye mwanakomana waTimeo), akanga agere parutivi penzira achipemha.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.46",
            "verseOrgIds": [
              "MRK.10.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "MRK 10:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paakanzwa kuti akanga ari Jesu weNazareta, akatanga kudanidzira achiti, \"Mwanakomana waDhavhidhi, ndinzwirei ngoni!\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.47",
            "verseOrgIds": [
              "MRK.10.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "MRK 10:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vazhinji vakamutsiura uye vakamutaurira kuti anyarare, asi akanyanyisa kudanidzira achiti, \"Mwanakomana waDhavhidhi, ndinzwirei ngoni!\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.48",
            "verseOrgIds": [
              "MRK.10.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "MRK 10:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akamira akati, \"Mudanei.\" Saka vakadana murume uya bofu vakati, \"Tsunga mwoyo! Simuka! Anokudana.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.49",
            "verseOrgIds": [
              "MRK.10.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "MRK 10:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akakanda jasi rake parutivi, akakwakuka akauya kuna Jesu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.50",
            "verseOrgIds": [
              "MRK.10.50"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "MRK 10:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akamubvunza akati, \"Unoda kuti ndikuitirei?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.51",
            "verseOrgIds": [
              "MRK.10.51"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MRK 10:51"
      },
      "items": [
        {
          "text": "Murume uya bofu akati, \"Rabhi, ndinoda kuona.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.51",
            "verseOrgIds": [
              "MRK.10.51"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "MRK 10:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati, \"Enda hako, kutenda kwako kwakuporesa.\" Pakarepo meso ake akasvinudzwa uye akatevera Jesu munzira.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.52",
            "verseOrgIds": [
              "MRK.10.52"
            ]
          }
        }
      ]
    }
  ],
