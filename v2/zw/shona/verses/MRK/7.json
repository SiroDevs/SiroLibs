  "verseCount": 37,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "MRK 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zvakachena neZvisina Kuchena",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaFarisi navamwe vavadzidzisi vomurayiro vakanga vauya kuJerusarema vakaungana pana Jesu",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.1",
            "verseOrgIds": [
              "MRK.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "vakaona vamwe vavadzidzi vake vachidya zvokudya namaoko akanga ane \"tsvina,\" ndiko kuti, asina kushambwa.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.2",
            "verseOrgIds": [
              "MRK.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaFarisi navaJudha vose havadyi kunze kwokunge vamboshamba maoko avo, vachichengeta tsika dzavakuru.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.3",
            "verseOrgIds": [
              "MRK.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pavanenge vadzoka kumusika, havadyi kunze kwokunge vashamba. Uye vanocherechedza dzimwe tsika zhinji, dzakadai sokushambidza mikombe, matende, nemidziyo yokuvirisa mvura.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.4",
            "verseOrgIds": [
              "MRK.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vaFarisi navadzidzisi vomurayiro vakabvunza Jesu vakati, \"Seiko vadzidzi venyu vachirega kurarama zviri maererano netsika dzavakuru, zvavanodya zvokudya zvavo 'namaoko ane tsvina'?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.5",
            "verseOrgIds": [
              "MRK.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapindura akati, \"Isaya akataura zvakanaka paakaprofita pamusoro penyu imi vanyengeri; sezvazvakanyorwa zvichinzi:",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.6",
            "verseOrgIds": [
              "MRK.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MRK 7:6"
      },
      "items": [
        {
          "text": "\" 'Vanhu ava vanondikudza nemiromo yavo,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.6",
            "verseOrgIds": [
              "MRK.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MRK 7:6"
      },
      "items": [
        {
          "text": "asi mwoyo yavo iri kure neni.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.6",
            "verseOrgIds": [
              "MRK.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanondinamata pasina;",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.7",
            "verseOrgIds": [
              "MRK.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MRK 7:7"
      },
      "items": [
        {
          "text": "dzidziso dzavo dzinongova mirayiro inodzidziswa navanhu.'",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.7",
            "verseOrgIds": [
              "MRK.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makasiya mirayiro yaMwari mukachengetedza tsika dzavanhu.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.8",
            "verseOrgIds": [
              "MRK.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye akati kwavari, \"Mune nzira chaiyo yokuisa parutivi nayo mirayiro yaMwari kuitira kuti mucherechedze tsika dzenyuwo!",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.9",
            "verseOrgIds": [
              "MRK.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti Mozisi akati, 'Kudza baba vako namai vako,' uye 'Munhu upi zvake achatuka baba vake kana mai vake anofanira kuurayiwa.'",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.10",
            "verseOrgIds": [
              "MRK.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi imi munoti, kana munhu akati kuna baba kana mai vake, 'Rubatsiro rupi zvarwo rwamungadaro makagamuchira kubva kwandiri iKobhani' (ndiko kuti, chipo chakapirwa kuna Mwari),",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.11",
            "verseOrgIds": [
              "MRK.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ipapo hamuchamuregi achiitira baba kana mai vake chinhu chipi zvacho.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.12",
            "verseOrgIds": [
              "MRK.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokudaro munoparadza shoko raMwari nokuda kwetsika dzenyu dzamakachengeta kusvika zvino. Uye munoita zvinhu zvizhinji zvakadaro.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.13",
            "verseOrgIds": [
              "MRK.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akadanazve kwaari vanhu vazhinji akati kwavari, \"Nditeererei, imi mose, uye munzwisise izvi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.14",
            "verseOrgIds": [
              "MRK.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuna chinhu chinobva kunze 'chinosvibisa' munhu nokupinda maari. Asi icho chinobuda mumunhu ndicho chinoita kuti 'asvibe.'",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.15",
            "verseOrgIds": [
              "MRK.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana munhu ane nzeve dzokunzwa, ngaanzwe.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.16",
            "verseOrgIds": [
              "MRK.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino akati abva pavanhu vazhinji uye apinda mumba, vadzidzi vake vakamubvunza pamusoro pomufananidzo uyu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.17",
            "verseOrgIds": [
              "MRK.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati, \"Hamunzwisisi seiko? Hamuoni kuti hakuna chinhu chinopinda mumunhu chichibva kunze chinogona 'kumusvibisa'?",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.18",
            "verseOrgIds": [
              "MRK.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti hazvipindi mumwoyo make asi mudumbu make, uyezve zvichizobuda mumuviri wake.\" Nokutaura uku, Jesu akati zvokudya zvose zvakanaka.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.19",
            "verseOrgIds": [
              "MRK.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaenderera mberi achiti, \"Zvinobuda mumunhu ndizvo zvinomusvibisa.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.20",
            "verseOrgIds": [
              "MRK.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti kubva mukati, kubva mumwoyo yavanhu ndimo munobuda mirangariro yakaipa, upombwe, kuba, kuuraya, ufeve,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.21",
            "verseOrgIds": [
              "MRK.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ruchiva, nouipi, kunyengera, utere, godo, kureva, manyawi noupenzi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.22",
            "verseOrgIds": [
              "MRK.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvakaipa izvozvi zvose zvinobuda kubva mukati uye 'zvinosvibisa munhu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.23",
            "verseOrgIds": [
              "MRK.7.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rutendo rwoMukadzi wokuFonishia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akabva panzvimbo iyo akaenda pedyo neTire. Akapinda mumba akasada kuzivikanwa nomunhu; asi akanga asingagoni kuzvivanza.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.24",
            "verseOrgIds": [
              "MRK.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvakaitika ndezvokuti, paakangonzwa nezvake, mukadzi aiva nomwanasikana akanga akabatwa nomweya wetsvina akauya akawira patsoka dzake.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.25",
            "verseOrgIds": [
              "MRK.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukadzi uyu aiva muGiriki, akaberekerwa muFonishia yomuSiria. Akakumbirisa Jesu kuti adzinge dhimoni mumwanasikana wake.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.26",
            "verseOrgIds": [
              "MRK.7.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati kwaari, \"Vana vanofanira kutanga kudya zvavanoda, nokuti hazvina kunaka kutora chingwa chavana uchichikandira kumbwa dzavo.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.27",
            "verseOrgIds": [
              "MRK.7.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye akapindura akati, \"Hongu Ishe, asi kunyange imbwa dziri pasi petafura dzinodya zvimedu zvezvokudya zvavana wani.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.28",
            "verseOrgIds": [
              "MRK.7.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akati kwaari, \"Nokuda kwemhinduro yakadai, enda hako; dhimoni rabva pamwanasikana wako.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.29",
            "verseOrgIds": [
              "MRK.7.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akadzokera kumba kwake akawana mwana wake avete pamubhedha, uye dhimoni raenda.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.30",
            "verseOrgIds": [
              "MRK.7.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuporeswa kwoMurume Aiva Matsi neMbeveve",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jesu akabva kunzvimbo yeTire akaenda nokuSidhoni, akaburukira kuGungwa reGarirea uye nokudunhu reDhekapori.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.31",
            "verseOrgIds": [
              "MRK.7.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikoko vamwe vanhu vakauya kwaari nomurume akanga ari matsi uye asingagoni kunyatsotaura, uye vakamukumbira kwazvo kuti aise ruoko rwake pamusoro pomurume uyu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.32",
            "verseOrgIds": [
              "MRK.7.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati aenda naye parutivi, kure noruzhinji, Jesu akaisa minwe yake munzeve dzake. Ipapo akapfira mate akabata rurimi rwomurume uya.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.33",
            "verseOrgIds": [
              "MRK.7.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatarisa kudenga uye nokugomera kukuru akati kwaari, \"Efata!\" (kureva kuti, \"Dziuka!\")",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.34",
            "verseOrgIds": [
              "MRK.7.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakarepo, nzeve dzomurume uya dzakadziuka, rurimi rwake rukasunungurwa uye akatanga kutaura zvakanaka.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.35",
            "verseOrgIds": [
              "MRK.7.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akavarayira kuti varege kutaurira kana munhu. Asi paakanyanya kuita izvozvo, ndipo pavakanyanya kutaura nezvazvo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.36",
            "verseOrgIds": [
              "MRK.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vakashamiswa zvikuru kwazvo. Vakati, \"Akaita zvinhu zvose nenzira yakanaka. Anoita kuti kunyange matsi dzinzwe uye nembeveve dzitaure.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.37",
            "verseOrgIds": [
              "MRK.7.37"
            ]
          }
        }
      ]
    }
