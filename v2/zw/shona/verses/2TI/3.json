  "reference": "2 Timoti 3",
  "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "2TI 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kushaya Umwari paMazuva Okupedzisira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2TI 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi uzive chinhu ichi: Kuchava nenguva dzokutambudzika pamazuva okupedzisira.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.1",
            "verseOrgIds": [
              "2TI.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TI 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vachava vanozvida, vanoda mari, vanozvirumbidza, vanozvikudza, vanotuka, vasingateereri vabereki, vasingatendi, vasina utsvene,",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.2",
            "verseOrgIds": [
              "2TI.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2TI 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "vasina rudo, vasingaregereri, vanochera vamwe, vasingazvidzori, vane utsinye, vasingadi zvinhu zvakanaka,",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.3",
            "verseOrgIds": [
              "2TI.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TI 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "vanomukira, vanoita manyawi, vanonyengera, vanoda kuzvifadza nezvenyika kupfuura Mwari;",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.4",
            "verseOrgIds": [
              "2TI.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TI 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "vane mufananidzo bedzi wokunamata Mwari asi vachiramba simba racho. Siyana navanhu ivavo.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.5",
            "verseOrgIds": [
              "2TI.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2TI 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti ndivo vaya vanoverevedza vachipinda mudzimba vachitapa vakadzi vasingazvibati vakaremedzwa nezvivi zvizhinji,",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.6",
            "verseOrgIds": [
              "2TI.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TI 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "vanogara vachidzidza asi vasingatongosviki pakuziva chokwadi.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.7",
            "verseOrgIds": [
              "2TI.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2TI 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sezvakaita Janesi naJambiresi vakadzivisa Mozisi, varume avawo vanodzivisa zvokwadi, vanhu vane ndangariro dzakaora, kana pari pazvinhu zvokutenda, vakarasika.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.8",
            "verseOrgIds": [
              "2TI.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2TI 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi havangasviki kure, nokuti upenzi hwavo huchaonekwa navanhu vose.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.9",
            "verseOrgIds": [
              "2TI.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pauro anorayira Timoti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2TI 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kunyange zvakadaro, iwe unoziva kudzidzisa kwangu kwose, mararamiro angu, chinangwa changu, kutenda kwangu, mwoyo murefu wangu, norudo, nokutsungirira,",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.10",
            "verseOrgIds": [
              "2TI.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2TI 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "matambudziko, nhamo, nezvinhu zvose zvakaitika kwandiri muAndioki, Ikoniamu nomuRistra, nokutambudzwa kwose kwandakasangana nako. Asi Ishe akandinunura kubva pazviri zvose.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.11",
            "verseOrgIds": [
              "2TI.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2TI 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvirokwazvo munhu wose anoda kurarama upenyu hwoumwari muna Kristu Jesu achatambudzwa,",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.12",
            "verseOrgIds": [
              "2TI.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2TI 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi vanhu vakaipa navanonyengera vachanyanyisa kuipa, vachinyengera nokunyengerwa.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.13",
            "verseOrgIds": [
              "2TI.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2TI 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi iwe, rambira pazvinhu zvawakadzidza uye ukatenda mazviri, nokuti unoziva kuti wakazvidzidza kubva kuna ani,",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.14",
            "verseOrgIds": [
              "2TI.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TI 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye kuti kubva pauduku wakaziva Magwaro matsvene, anogona kukupa uchenjeri hunosvitsa kukuponeswa kubudikidza nokutenda muna Kristu Jesu.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.15",
            "verseOrgIds": [
              "2TI.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2TI 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rugwaro rwose rwakafemerwa naMwari uye runobatsira pakudzidzisa, kurayira, kutsiura nokurayiridza mukururama,",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.16",
            "verseOrgIds": [
              "2TI.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2TI 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti munhu waMwari akwaniswe kwazvo, agadzirirwa mabasa ose akanaka.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.17",
            "verseOrgIds": [
              "2TI.3.17"
            ]
          }
        }
      ]
    }
  ],
