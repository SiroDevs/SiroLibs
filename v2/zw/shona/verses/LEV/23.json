  "verseCount": 44,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "LEV 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kuna Mozisi,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.1",
            "verseOrgIds": [
              "LEV.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Taura kuvaIsraeri uti kwavari, 'Iyi ndiyo mitambo yangu yandakatara, mitambo yakatarwa yaJehovha yamunofanira kudaidzira seungano tsvene.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.2",
            "verseOrgIds": [
              "LEV.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Sabata",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Pane mazuva matanhatu amunoshanda asi zuva rechinomwe iSabata rokuzorora, zuva reungano tsvene. Hamufaniri kuita basa ripi zvaro kwose kwamunogara, iSabata kuna Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.3",
            "verseOrgIds": [
              "LEV.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Pasika nechingwa chisina mbiriso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Iyi ndiyo mitambo yakatarwa yaJehovha, ungano tsvene dzamunodaidzira panguva dzakatarwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.4",
            "verseOrgIds": [
              "LEV.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pasika yaJehovha inotanga madekwana pazuva regumi namana romwedzi wokutanga.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.5",
            "verseOrgIds": [
              "LEV.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva regumi namashanu romwedzi iwoyo Mutambo waJehovha weChingwa Chisina Mbiriso unotanga; kwamazuva manomwe munofanira kudya chingwa chinobikwa chisina mbiriso.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.6",
            "verseOrgIds": [
              "LEV.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva rokutanga itai ungano tsvene uye musaita mabasa amazuva ose.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.7",
            "verseOrgIds": [
              "LEV.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwamazuva manomwe mupe chipiriso chinoitirwa Jehovha nomoto. Uye pazuva rechinomwe munofanira kuita ungano tsvene uye musaita basa ramazuva ose.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.8",
            "verseOrgIds": [
              "LEV.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Zvibereko zvokutanga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kuna Mozisi,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.9",
            "verseOrgIds": [
              "LEV.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Taura kuvaIsraeri uti kwavari, 'Kana mapinda munyika yandichakupai, mukakohwa gohwo rayo, uyai kumuprista nechisote chezviyo zvamunotanga kukohwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.10",
            "verseOrgIds": [
              "LEV.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anofanira kuninira chisote pamberi paJehovha kuti chigamuchirwe panzvimbo penyu. Muprista anofanira kuchininira pazuva rinotevera Sabata.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.11",
            "verseOrgIds": [
              "LEV.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva ramunoninira chisote, munofanira kubayira sechipiriso chinopiswa kuna Jehovha, gwayana rine gore rimwe chete risina kuremara,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.12",
            "verseOrgIds": [
              "LEV.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamwe chete nechipiriso chacho chezviyo chinokwana zvikamu zviviri kubva mugumi zveefa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.13",
            "verseOrgIds": [
              "LEV.23.13"
            ]
          }
        },
        {
          "text": ", zvoupfu hwakatsetseka hwakasanganiswa namafuta, chipiriso chinoitirwa Jehovha nomoto, chinonhuhwira zvinofadza, nechipiriso chacho chokunwa chikamu chimwe chete kubva muzvina zvehini",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.13",
            "verseOrgIds": [
              "LEV.23.13"
            ]
          }
        },
        {
          "text": "rewaini.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.13",
            "verseOrgIds": [
              "LEV.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamufaniri kudya chingwa chipi zvacho, kana zviyo zvakakangwa, kana zviyo zvitsva, kusvikira zuva chairo ramunouya nechipiriso ichi kuna Mwari wenyu. Uyu unofanira kuva murayiro unogara nokusingaperi kuzvizvarwa zvichatevera, kwose kwamuchagara.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.14",
            "verseOrgIds": [
              "LEV.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Mutambo waMavhiki",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kubva pazuva rinotevera Sabata, zuva ramakauya nechisote chechipiriso chokuninira, verengai mavhiki manomwe azere.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.15",
            "verseOrgIds": [
              "LEV.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Verengai mazuva makumi mashanu kusvika pazuva rinotevera Sabata rechinomwe, ipapo mugopa chipiriso chezviyo zvitsva kuna Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.16",
            "verseOrgIds": [
              "LEV.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubva kupi kwose kwamunogara, uyai nezvingwa zviviri zvakaitwa nezvikamu zviviri kubva mugumi zveefa zvoupfu hwakatsetseka zvakabikwa nembiriso sechipiriso chokuninira chezvibereko zvokutanga kuna Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.17",
            "verseOrgIds": [
              "LEV.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamwe chete nechingwa ichi mupe makwayana manomwe asina kuremara egore rimwe nehando imwe chete diki namakondobwe maviri. Zvichava zvipiriso zvinopisirwa Jehovha, pamwe chete nezvipiriso zvezviyo nezvipiriso zvinonwiwa, chive chipiriso chinoitwa nomoto chinonhuhwira zvinofadza kuna Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.18",
            "verseOrgIds": [
              "LEV.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo bayirai nhongo imwe chete sechipiriso chechivi namakwayana maviri, ose egore rimwe chete, sechipiriso chokuwadzana.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.19",
            "verseOrgIds": [
              "LEV.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muprista anofanira kuninira makwayana maviri pamberi paJehovha sechipiriso chokuninira pamwe chete nechingwa chegohwo rokutanga. Izvi zvipiriso zvitsvene kuna Jehovha zvomuprista.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.20",
            "verseOrgIds": [
              "LEV.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva rimwe chetero munofanira kudaidzira ungano tsvene murege basa ramazuva ose. Uyu unofanira kuva murayiro unogara nokusingaperi kuzvizvarwa zvichauya, kwose kwamuchagara.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.21",
            "verseOrgIds": [
              "LEV.23.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kana muchikohwa gohwo renyika yenyu musakohwa kusvikira kumucheto kwomunda wenyu, kana kunhongera zvinosara pakukohwa kwenyu. Zvisiyirei varanda navatorwa. Ndini Jehovha Mwari wenyu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.22",
            "verseOrgIds": [
              "LEV.23.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Mutambo weHwamanda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kuna Mozisi,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.23",
            "verseOrgIds": [
              "LEV.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uti kuvaIsraeri, 'Pazuva rokutanga romwedzi wechinomwe munofanira kuva nezuva rokuzorora, ungano tsvene inocherechedzwa nokuridza hwamanda.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.24",
            "verseOrgIds": [
              "LEV.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musaita basa ramazuva ose, asi mupe chipiriso chinoitirwa Jehovha nomoto.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.25",
            "verseOrgIds": [
              "LEV.23.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Zuva Rokuyananisira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kuna Mozisi,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.26",
            "verseOrgIds": [
              "LEV.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zuva regumi romwedzi iwoyo wechinomwe iZuva Rokuyananisa. Muite ungano tsvene uye muzvinyime zvokudya, mugopa chipiriso chinoitirwa Jehovha nomoto.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.27",
            "verseOrgIds": [
              "LEV.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musashanda pazuva iroro, nokuti iZuva Rokuyananisira, pamunoyananisirwa pamberi paJehovha Mwari wenyu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.28",
            "verseOrgIds": [
              "LEV.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munhu wose asingazvinyimi musi iwoyo anofanira kubviswa pakati pavanhu vokwake.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.29",
            "verseOrgIds": [
              "LEV.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munhu upi noupi achaita basa ripi zvaro, nomusi iwoyo, ndichamuparadza pakati pavanhu vokwake.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.30",
            "verseOrgIds": [
              "LEV.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamufaniri kutomboita basa. Uyu unofanira kuva murayiro unogara nokusingaperi kumarudzi ose achauya, kwose kwamuchagara.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.31",
            "verseOrgIds": [
              "LEV.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iri iSabata renyu rokuzorora, uye munofanira kuzvinyima. Kubva manheru ezuva repfumbamwe romwedzi kusvikira manheru anotevera munofanira kucherechedza Sabata.\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.32",
            "verseOrgIds": [
              "LEV.23.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Mutambo waMatumba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kuna Mozisi,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.33",
            "verseOrgIds": [
              "LEV.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uti kuvaIsraeri, 'Pazuva regumi neshanu romwedzi wechinomwe Mutambo waJehovha waMatumba unotanga, uye uchapedza mazuva manomwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.34",
            "verseOrgIds": [
              "LEV.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zuva rokutanga iungano tsvene; musaita basa ramazuva ose.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.35",
            "verseOrgIds": [
              "LEV.23.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwamazuva manomwe mupe kuna Jehovha zvipiriso zvinoitwa nomoto uye pazuva iroro muite ungano tsvene mugopa chipiriso chinoitirwa Jehovha nomoto. Iyi ndiyo ungano yokupedzisira; musaita basa ramazuva ose.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.36",
            "verseOrgIds": [
              "LEV.23.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 23:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Iyi ndiyo mitambo yaJehovha yakatarwa yamunofanira kuparidzira ungano tsvene kuti dziuye nezvipiriso zvinoitirwa Jehovha nomoto, nezvipiriso zvinopiswa uye nezvinopiswa zvezviyo, zvibayiro nezvipiriso zvokunwa zvinodiwa mazuva ose.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.37",
            "verseOrgIds": [
              "LEV.23.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 23:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvipiriso izvi zvinowedzerwa pamusoro pezviya zvamaSabata aJehovha uye pamusoro pezvipo zvenyu nezvose zvamakapikira nezvipiriso zvose zvokupa nokuzvisarudzira zvamunopa kuna Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.38",
            "verseOrgIds": [
              "LEV.23.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 23:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Zvino kutanga pazuva regumi namashanu romwedzi wechinomwe, mushure mokunge mapedza kukohwa zvirimwa zvenyika, muite mutambo wokupemberera kuna Jehovha kwamazuva manomwe; zuva rokutanga izuva rokuzorora, uye zuva rorusere izuva rokuzororawo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.39",
            "verseOrgIds": [
              "LEV.23.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 23:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva rokutanga munofanira kutsara michero yakanakisisa yemiti, nemichero yemichindwe, namatavi ana mashizha akawanda, nemikonachando, uye mugofara pamberi paJehovha Mwari wenyu kwamazuva manomwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.40",
            "verseOrgIds": [
              "LEV.23.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 23:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munofanira kuitira Jehovha mutambo uyu kwamazuva manomwe gore negore. Uyu unofanira kuva murayiro unogara nokusingaperi kuzvizvarwa zvichauya; muupemberere mumwedzi wechinomwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.41",
            "verseOrgIds": [
              "LEV.23.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 23:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garai mumatumba kwamazuva manomwe: Zvizvarwa zvose zvavaIsraeri zvinofanira kugara mumatumba",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.42",
            "verseOrgIds": [
              "LEV.23.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 23:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuitira kuti zvizvarwa zvenyu zvigoziva kuti ndakaita kuti vaIsraeri vagare mumatumba pandakavabudisa kubva muIjipiti. Ndini Jehovha Mwari wenyu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.43",
            "verseOrgIds": [
              "LEV.23.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 23:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Mozisi akazivisa kuvaIsraeri mitambo yakatarwa yaJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.44",
            "verseOrgIds": [
              "LEV.23.44"
            ]
          }
        }
      ]
    }
  ],
