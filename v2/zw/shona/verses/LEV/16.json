              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muprista akazodzwa nokugadzwa kuti atevere baba vake somuprista mukuru anofanira kuyananisira. Anofanira kupfeka nguo dzomucheka, nguo tsvene",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.32",
            "verseOrgIds": [
              "LEV.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
