        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kudzikinura zvaJehovha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kuna Mozisi,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.1",
            "verseOrgIds": [
              "LEV.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Taura navaIsraeri uti kwavari, 'Kana munhu akaita mhiko yakasarudzika yokuti akumikidze vanhu kuna Jehovha nokupa mutengo wakaenzanirana,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.2",
            "verseOrgIds": [
              "LEV.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "utare mutengo womunhurume ane makore ari pakati pamakumi maviri namakumi matanhatu pamashekeri makumi mashanu",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.3",
            "verseOrgIds": [
              "LEV.27.3"
            ]
          }
        },
        {
          "text": "esirivha, zvichienzaniswa neshekeri rapanzvimbo tsvene",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.3",
            "verseOrgIds": [
              "LEV.27.3"
            ]
          }
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.3",
            "verseOrgIds": [
              "LEV.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye kana ari munhukadzi, utare mutengo wake pamashekeri makumi matatu",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.4",
            "verseOrgIds": [
              "LEV.27.4"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.4",
            "verseOrgIds": [
              "LEV.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana ari munhu ana makore ari pakati pamashanu namakore makumi maviri, utare mutengo womunhurume pamashekeri makumi maviri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.5",
            "verseOrgIds": [
              "LEV.27.5"
            ]
          }
        },
        {
          "text": ", uye munhukadzi pamashekeri gumi",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.5",
            "verseOrgIds": [
              "LEV.27.5"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.5",
            "verseOrgIds": [
              "LEV.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana ari munhu ari pakati pomwedzi mumwe namakore mashanu, utare mutengo womunhurume pamashekeri mashanu",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.6",
            "verseOrgIds": [
              "LEV.27.6"
            ]
          }
        },
        {
          "text": "esirivha uye utare pamunhukadzi mashekeri matatu",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.6",
            "verseOrgIds": [
              "LEV.27.6"
            ]
          }
        },
        {
          "text": "esirivha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.6",
            "verseOrgIds": [
              "LEV.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana munhu ane makore makumi matanhatu kana anopfuura, utare mutengo womunhurume pamashekeri gumi namashanu",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.7",
            "verseOrgIds": [
              "LEV.27.7"
            ]
          }
        },
        {
          "text": ", uye pamunhukadzi mashekeri gumi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.7",
            "verseOrgIds": [
              "LEV.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana munhu wose anenge achiita mhiko ari murombo zvikuru zvokutotadza kuripa muripo wakatarwa, anofanira kuuya nomunhu uyu kumuprista, achatara mutengo wake zvichienderana nezvinokwaniswa nomunhu ari kuita mhiko.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.8",
            "verseOrgIds": [
              "LEV.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kana chaakapika chiri mhuka inogamuchirika sechipiriso kuna Jehovha, mhuka yakadai inopiwa kuna Jehovha ichava tsvene.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.9",
            "verseOrgIds": [
              "LEV.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haafaniri kuchitsinhanisa kana kuisa chakanaka panzvimbo yechakaipa, kana chakaipa panzvimbo yechakanaka; kana akaisa mhuka pachinzvimbo cheimwe, dzose dziri mbiri neyatsinhanisa dzichava tsvene.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.10",
            "verseOrgIds": [
              "LEV.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana chaakapika chiri mhuka isina kuchena, iyo isingagamuchiriki sechipiriso kuna Jehovha, mhuka iyi inofanira kupiwa kumuprista,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.11",
            "verseOrgIds": [
              "LEV.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "uyo achatara kukosha kwayo, kuti yakanaka kana kuti yakaipa. Mutengo upi noupi uchatemwa nomuprista, ndiwo uchave mutengo wayo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.12",
            "verseOrgIds": [
              "LEV.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana muridzi achida kudzikinura mhuka iyi, anofanira kupamhidzira chikamu chimwe chete muzvishanu pamutengo wayo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.13",
            "verseOrgIds": [
              "LEV.27.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kana munhu akakumikidza imba yake sechinhu chitsvene kuna Jehovha, muprista achatara kukosha kwayo kuti yakanaka here kana kuti yakaipa. Mutengo upi noupi uchatemwa nomuprista, ndiwo ucharamba uripo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.14",
            "verseOrgIds": [
              "LEV.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana murume anokumikidza imba yake akaidzikinura, anofanira kupamhidzira chikamu chimwe chete muzvishanu zvomutengo wayo. Uye imba ichava yake zvakare.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.15",
            "verseOrgIds": [
              "LEV.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kana munhu akakumikidza kuna Jehovha chikamu chomunda wemhuri yake, mutengo wawo unofanira kutarwa zvichienderana nouwandu hwezviyo zvinodiwa ipapo, mashekeri makumi mashanu esirivha pahomeri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.16",
            "verseOrgIds": [
              "LEV.27.16"
            ]
          }
        },
        {
          "text": "yezviyo yebhari.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.16",
            "verseOrgIds": [
              "LEV.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana akakumikidza munda wake mugore reJubhiri, mutengo wakatarwa unoramba uripo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.17",
            "verseOrgIds": [
              "LEV.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana akakumikidza munda wake mushure meJubhiri, muprista achatara mutengo zvichienderana namakore asara Jubhiri rinotevera risati rasvika, uye mutengo wawo wakatarwa uchaderedzwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.18",
            "verseOrgIds": [
              "LEV.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana murume anokumikidza munda achida kuudzikinura, anofanira kupamhidzira chikamu chimwe chete muzvishanu pamutengo wacho, uye munda uchava wake zvakare.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.19",
            "verseOrgIds": [
              "LEV.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvakadaro, kana asingadzikinuri munda wake, kana akautengesera mumwe munhu, hauzogoni kudzikinurwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.20",
            "verseOrgIds": [
              "LEV.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana munda ukasunungurwa muJubhiri, uchava mutsvene, somunda wakapiwa kuna Jehovha; uchava munda wavaprista.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.21",
            "verseOrgIds": [
              "LEV.27.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kana munhu akakumikidza kuna Jehovha munda waakatenga, usiri chikamu chomunda wemhuri yake,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.22",
            "verseOrgIds": [
              "LEV.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "muprista achatara mutengo wawo kusvikira mugore reJubhiri, uye munhu uyu anofanira kuripa mutengo wawo musi iwoyo sechinhu chitsvene kuna Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.23",
            "verseOrgIds": [
              "LEV.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugore reJubhiri munda uchadzokera kumunhu waakatengeserana naye uyo aiva muridzi womunda.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.24",
            "verseOrgIds": [
              "LEV.27.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 27:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutengo wose unofanira kutarwa zvichienderana neshekeri repanzvimbo tsvene, makumi maviri amagera pashekeri rimwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.25",
            "verseOrgIds": [
              "LEV.27.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Zvisinei hazvo, hapana munhu angakumikidza dangwe remhuka, sezvo dangwe ragara riri raJehovha kare; ingava mombe kana gwai; ndezvaJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.26",
            "verseOrgIds": [
              "LEV.27.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana iri imwe yemhuka dzisina kuchena, anogona kuidzikinura nomutengo wayo wakatarwa, achipamhidzira chikamu chimwe chete muzvishanu pamutengo wayo. Kana isina kudzikinurwa, inofanira kutengeswa nomutengo wayo wakatarwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.27",
            "verseOrgIds": [
              "LEV.27.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 27:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Asi hakuna chinhu chomunhu chinopiwa kuna Jehovha, angava munhu kana mhuka kana munda wemhuri, chinogona kutengeswa kana kudzikinurwa; chinhu chose chinopiwa saizvozvo chinova chitsvene kwazvo kuna Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.28",
            "verseOrgIds": [
              "LEV.27.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Hakuna munhu anopiwa kuti aparadzwe angadzikinurwa; anofanira kuurayiwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.29",
