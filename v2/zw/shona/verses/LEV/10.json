{
  "id": "LEV.10",
  "number": "10",
  "bookId": "LEV",
  "reference": "Revhitiko 10",
  "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "LEV 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kufa kwaNadhabhi naAbhihu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Nadhabhi naAbhihu, vanakomana vaAroni vakatora, mumwe nomumwe, hadyana yake yezvinonhuhwira, vakaisamo moto, vakaisawo zvinonhuhwira, vakaisa moto usingabvumirwi pamberi paJehovha zvaakanga asina kuvarayira.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.1",
            "verseOrgIds": [
              "LEV.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka naizvozvo moto wakabuda kubva pamberi paJehovha ukavapisa vose ndokubva vafa pamberi paJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.2",
            "verseOrgIds": [
              "LEV.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Mozisi akati kuna Aroni, \"Izvi ndizvo zvakataurwa naJehovha paakati:",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.3",
            "verseOrgIds": [
              "LEV.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LEV 10:3"
      },
      "items": [
        {
          "text": "\" 'Pakati peavo vachaswedera",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.3",
            "verseOrgIds": [
              "LEV.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LEV 10:3"
      },
      "items": [
        {
          "text": "kwandiri ndicharatidza utsvene hwangu,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.3",
            "verseOrgIds": [
              "LEV.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LEV 10:3"
      },
      "items": [
        {
          "text": "pamberi pavanhu vose",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.3",
            "verseOrgIds": [
              "LEV.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LEV 10:3"
      },
      "items": [
        {
          "text": "ndichakudzwa.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.3",
            "verseOrgIds": [
              "LEV.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "LEV 10:3"
      },
      "items": [
        {
          "text": "Aroni akaramba anyerere.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.3",
            "verseOrgIds": [
              "LEV.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mozisi akadana Mishaeri naErizafani, vanakomana vaUzieri, babamunini vaAroni, akati kwavari, \"Uyai pano mutakure madzikoma enyu muende navo kunze kwomusasa vabve pamberi penzvimbo tsvene.\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.4",
            "verseOrgIds": [
              "LEV.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vakauya vakavatakura vachakapfeka hanzu dzavo vakaenda navo kunze kwomusasa sezvazvakanga zvarayirwa naMozisi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.5",
            "verseOrgIds": [
              "LEV.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Mozisi akati kuna Aroni navanakomana vake, Ereazari naItamari, \"Musarega bvudzi renyu risina kukamwa uye musabvarura nguo dzenyu nokuti mungafa, Mwari akatsamwira ungano yose. Asi hama dzenyu, imba yose yaIsraeri, vanogona kuchema avo vakaparadzwa nomoto naJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.6",
            "verseOrgIds": [
              "LEV.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musabva pamusuo weTende Rokusangana nokuti mungafa nokuti mafuta aJehovha okuzodza ari pamuri.\" Saka vakaita sezvakataurwa naMozisi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.7",
            "verseOrgIds": [
              "LEV.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehovha akati kuna Aroni,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.8",
            "verseOrgIds": [
              "LEV.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Iwe navanakomana vako hamufaniri kunwa waini kana zvimwe zvinwiwa zvakaviriswa pose pose pamunopinda muTende Rokusangana nokuti mungafa. Uyu mutemo usingaperi kusvikira kuzvizvarwa zvinotevera.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.9",
            "verseOrgIds": [
              "LEV.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munofanira kuisa mutsauko pakati pezvitsvene nezvisingakoshi, pakati pezvakachena nezvisina kuchena.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.10",
            "verseOrgIds": [
              "LEV.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye munofanira kudzidzisa vaIsraeri mirayiro yose yavakapiwa naJehovha kubudikidza naMozisi.\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.11",
            "verseOrgIds": [
              "LEV.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mozisi akati kuna Aroni navanakomana vake vakanga vasara, Ereazari naItamari, \"Torai chipiriso chezviyo kubva pazvipiriso zvakaitirwa Jehovha nomoto, zvakagadzirwa pasina mbiriso mugochiisa parutivi pearitari nokuti chitsvene-tsvene.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.12",
            "verseOrgIds": [
              "LEV.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvidyei munzvimbo tsvene, nokuti mugove wenyu nomugove wavanakomana venyu, wezvipiriso zvinoitirwa Jehovha nomoto, nokuti ndakarayirwa saizvozvo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.13",
            "verseOrgIds": [
              "LEV.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi iwe navanakomana vako navanasikana vako, munogona kudya chityu chakaninirwa nebandauko rakakumikidzwa. Zvidyei munzvimbo yakacheneswa; izvi zvakapiwa kwauri navana vako somugove wenyu wezvipiriso zvokuwadzana zvavana vaIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.14",
            "verseOrgIds": [
              "LEV.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bandauko rakakumikidzwa nechityu chakaninirwa zvinofanirwa kuuyiswa namafuta nezvipiriso zvinoitwa nomoto, kuti zvininirwe pamberi paJehovha sechipiriso chokuninira. Uyu uchava mugove wamuchagara muchiwana navana venyu sezvakarayirwa naJehovha.\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.15",
            "verseOrgIds": [
              "LEV.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mozisi akati abvunza nezvembudzi yechipiriso chechivi akawana yatopiswa, akatsamwira Ereazari naItamari vanakomana vaAroni vakanga vasara akabvunza akati,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.16",
            "verseOrgIds": [
              "LEV.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sei musina kudyira chipiriso chechivi munzvimbo tsvene? Chitsvene-tsvene, chakapiwa kwamuri kuti chibvise mhosva yeungano nokuvayananisira pamberi paJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.17",
            "verseOrgIds": [
              "LEV.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sezvo ropa racho risina kuuyiswa kuNzvimbo Tsvene, maifanira kudyira mbudzi munharaunda yenzvimbo tsvene, sezvandakarayira.\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.18",
            "verseOrgIds": [
              "LEV.10.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni akapindura Mozisi achiti, \"Nhasi vabayira chipiriso chavo chechivi nechipiriso chavo chinopiswa pamberi paJehovha asi zvinhu zvakaita seizvi zvaitika kwandiri. Jehovha aidai afara here dai ndadya chipiriso chechivi nhasi?\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.19",
            "verseOrgIds": [
              "LEV.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mozisi paakanzwa izvi akagutsikana.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.20",
            "verseOrgIds": [
              "LEV.10.20"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "LEV.11",
    "number": "11",
    "bookId": "LEV"
  },
  "previous": {
    "id": "LEV.9",
    "number": "9",
