  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "1CO 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Teverai muenzaniso wangu, sezvandinotevera muenzaniso waKristu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.1",
            "verseOrgIds": [
              "1CO.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zvinofanira kuitwa paKunamata",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinokurumbidzai nokuti munondirangarira pazvinhu zvose, uye muchichengeta dzidziso, sezvandakakudzidzisai.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.2",
            "verseOrgIds": [
              "1CO.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino ndinoda kuti muzive kuti musoro womurume wose ndiKristu, uye musoro womukadzi murume, uye musoro waKristu ndiye Mwari.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.3",
            "verseOrgIds": [
              "1CO.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murume mumwe nomumwe anonyengetera kana kuprofita musoro wake wakafukidzwa, anoninipisa musoro wake.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.4",
            "verseOrgIds": [
              "1CO.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye mukadzi mumwe nomumwe anonyengetera kana kuprofita musoro wake usina kufukidzwa, anoninipisa musoro wake, zvakangofanana nokuva nomusoro wakaveurwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.5",
            "verseOrgIds": [
              "1CO.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana mukadzi asingafukidzi musoro wake, anofanira kugera bvudzi rake; asi kana zvichinyadzisa mukadzi kuti agerwe bvudzi rake, anofanira kufukidza musoro wake.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.6",
            "verseOrgIds": [
              "1CO.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murume haafaniri kufukidza musoro wake, sezvo ari mufananidzo nokubwinya kwaMwari; asi mukadzi kubwinya kwomurume.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.7",
            "verseOrgIds": [
              "1CO.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti murume haana kubva pamukadzi, asi mukadzi ndiye akabva pamurume;",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.8",
            "verseOrgIds": [
              "1CO.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye murume haana kusikirwa mukadzi, asi mukadzi ndiye akasikirwa murume.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.9",
            "verseOrgIds": [
              "1CO.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuda kwechikonzero ichi, uye nokuda kwavatumwa, mukadzi anofanira kuva nechiratidzo chesimba pamusoro wake.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.10",
            "verseOrgIds": [
              "1CO.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvakadaro, muna She mukadzi haazi kunze kwomurume, nomurume haazi kunze kwomukadzi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.11",
            "verseOrgIds": [
              "1CO.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti mukadzi sezvaakabva pamurume, saizvozvowo murume anozvarwa nomukadzi asi zvose zvinobva kuna Mwari.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.12",
            "verseOrgIds": [
              "1CO.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tongai imi pachenyu kuti: Zvakafanira here kuti mukadzi anyengetere kuna Mwari asina kufukidza musoro wake?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.13",
            "verseOrgIds": [
              "1CO.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, hamudzidziswi namasikirwo ezvinhu kuti kana murume ane bvudzi refu, anonyadziswa nazvo here,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.14",
            "verseOrgIds": [
              "1CO.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi kuti kana mukadzi ane bvudzi refu, ndiko kubwinya kwake? Nokuti bvudzi refu rakapiwa kwaari kuti rive chifukidzo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.15",
            "verseOrgIds": [
              "1CO.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino kana pane anoda kuita gakava pazviri, hatina tsika dzakadaro kunyange kereke dzaMwari.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.16",
            "verseOrgIds": [
              "1CO.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chirariro chaShe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pane zvakarayirwa zvinotevera handikurumbidzei, nokuti hamuunganiri zvakanaka asi zvakaipa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.17",
            "verseOrgIds": [
              "1CO.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chokutanga, ndakanzwa kuti pamunoungana pamwe chete sekereke, pane kupesana pakati penyu, uye ndingangozvitenda.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.18",
            "verseOrgIds": [
              "1CO.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti dzidziso dzakatsaukana dzinofanira kuva pakati penyu, kuti zvionekwe kuti vakatendeka kuna Mwari ndavapi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.19",
            "verseOrgIds": [
              "1CO.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamunoungana, hachisi chirariro chaShe chamunodya,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.20",
            "verseOrgIds": [
              "1CO.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti kana modya, mumwe nomumwe wenyu anongotanga kudya asingamiriri vamwe. Mumwe anosara ane nzara, mumwewo anodhakwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.21",
            "verseOrgIds": [
              "1CO.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, hamuna dzimba kwamungadyira nokunwira here? Kana kuti munozvidza kereke yaMwari nokunyadzisa vasina chinhu here? Zvino ndichatiiko kwamuri? Ndingakurumbidzai nokuda kwaizvozvi here? Zvirokwazvo kwete!",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.22",
            "verseOrgIds": [
              "1CO.11.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti ndakagamuchira kubva kuna She icho chandakakupai kuti Ishe Jesu, usiku hwaakapandukirwa, akatora chingwa,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.23",
            "verseOrgIds": [
              "1CO.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye mushure mokunge avonga, akachimedura akati, \"Uyu ndiwo muviri wangu, unomedurirwa imi; itai izvi muchindirangarira.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.24",
            "verseOrgIds": [
              "1CO.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saizvozvowo, mushure mechirariro akatora mukombe, achiti, \"Mukombe uyu ndiwo sungano itsva muropa rangu; itai izvi nguva dzose kana muchiunwa, muchindirangarira.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.25",
            "verseOrgIds": [
              "1CO.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti nguva dzose kana muchidya chingwa ichi nokunwa mukombe uyu, munoparidza rufu rwaShe kusvikira achidzoka.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.26",
            "verseOrgIds": [
              "1CO.11.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CO 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo ani naani anodya chingwa nokunwa mukombe waShe nomutoo usina kufanira achabatwa nemhosva yokutadzira muviri neropa raShe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.27",
            "verseOrgIds": [
              "1CO.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CO 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munhu anofanira kuti azviedze asati adya chingwa nokunwa mukombe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.28",
            "verseOrgIds": [
              "1CO.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CO 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti ani naani anodya nokunwa asingacherechedzi muviri waShe anozvidyira nokuzvinwira kutongwa kwake.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.29",
            "verseOrgIds": [
              "1CO.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CO 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndokusaka vazhinji pakati penyu vasina simba uye vachirwara, uye vamwe venyu vavete.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.30",
            "verseOrgIds": [
              "1CO.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CO 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana tikazviedza pachedu, hatingazotongwi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.31",
            "verseOrgIds": [
              "1CO.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CO 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana tikatongwa naShe, tiri kurangwa kuitira kuti tirege kuzoraswa pamwe chete nenyika.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.32",
            "verseOrgIds": [
              "1CO.11.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CO 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka naizvozvo, hama dzangu, kana muchiungana pakudya, miriranai.",
