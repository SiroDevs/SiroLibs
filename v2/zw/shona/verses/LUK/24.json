  "verseCount": 53,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "LUK 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kumuka kwaJesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomusi wokutanga wevhiki, mambakwedza, vakadzi vaya vakatora zvinonhuhwira zvavakanga vagadzira vakaenda kuguva.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.1",
            "verseOrgIds": [
              "LUK.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakawana ibwe rakungurutswa kubva paguva,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.2",
            "verseOrgIds": [
              "LUK.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi vakati vapinda, vakashayiwa mutumbi waIshe Jesu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.3",
            "verseOrgIds": [
              "LUK.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pavakanga vachiri kushamisika nazvo, pakarepo varume vaviri vakanga vakapfeka nguo chena dzaipenya semheni vakamira parutivi pavo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.4",
            "verseOrgIds": [
              "LUK.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukutya kwavo, vakadzi vaya vakakotamisa pasi zviso zvavo, asi varume ava vakati kwavari, \"Seiko muchitsvaka mupenyu pakati pavakafa?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.5",
            "verseOrgIds": [
              "LUK.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haapo pano; amuka! Rangarirai zvaakakuudzai, paakanga achinemi muGarirea kuti:",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.6",
            "verseOrgIds": [
              "LUK.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Mwanakomana woMunhu anofanira kuiswa mumaoko avatadzi, arovererwe pamuchinjikwa agomukazve pazuva rechitatu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.7",
            "verseOrgIds": [
              "LUK.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vakarangarira mashoko ake.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.8",
            "verseOrgIds": [
              "LUK.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati vadzoka kubva kuguva, vakataurira vane gumi nomumwe zvinhu zvose izvi, uye nokuna vamwe vose.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.9",
            "verseOrgIds": [
              "LUK.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "VanaMaria Magadharena, naJohana, Maria mai vaJakobho, uye navamwe vavaiva navo ndivo vakandoudza vapostori izvozvo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.10",
            "verseOrgIds": [
              "LUK.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi havana kutenda vakadzi ava, nokuti mashoko avo ainge upenzi kwavari.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.11",
            "verseOrgIds": [
              "LUK.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvisinei hazvo, Petro, akasimuka, akamhanyira kuguva. Akakotama, akaona micheka iri yoga, ndokubva adzokera kumba, achishamisika mumwoyo make nezvakanga zvaitika.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.12",
            "verseOrgIds": [
              "LUK.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu Anosangana naVadzidzi muNzira inoenda kuEmausi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino musi mumwe chete iwoyo, varume vaviri vakanga vachienda kumusha wainzi Emausi, makiromita anenge gumi nerimwe chete kubva kuJerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.13",
            "verseOrgIds": [
              "LUK.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakanga vachitaurirana pamusoro pezvinhu zvose zvakanga zvaitika.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.14",
            "verseOrgIds": [
              "LUK.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vachiri kutaura nokukurukurirana pamusoro pezvinhu izvi, Jesu pachake akabva asvika uye akafamba navo;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.15",
            "verseOrgIds": [
              "LUK.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi meso avo akabatwa zvokuti havana kumuziva.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.16",
            "verseOrgIds": [
              "LUK.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akavabvunza akati, \"Muri kukurukurirana pamusoro peiko, zvamuri kufamba kudai?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.17",
            "verseOrgIds": [
              "LUK.24.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 24:17"
      },
      "items": [
        {
          "text": "Vakamira vakanyarara, zviso zvavo zvakasuwa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.17",
            "verseOrgIds": [
              "LUK.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwe wavo ainzi Kiropasi, akati kwaari, \"Ndiwe woga mushanyi muJerusarema asingazivi zvinhu zvakaitikamo mumazuva ano aya here?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.18",
            "verseOrgIds": [
              "LUK.24.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati, \"Zveiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.19",
            "verseOrgIds": [
              "LUK.24.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 24:19"
      },
      "items": [
        {
          "text": "Vakapindura vachiti, \"ZvaJesu weNazareta. Aiva muprofita, aiva nesimba mushoko napamabasa pamberi paMwari uye nokuvanhu vose.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.19",
            "verseOrgIds": [
              "LUK.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaprista vakuru navatongi vedu vakamuendesa kuti andotongerwa rufu, saka vakamuroverera pamuchinjikwa;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.20",
            "verseOrgIds": [
              "LUK.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi isu takanga tichitarisira kuti ndiye akanga achizodzikinura vaIsraeri. Pamusoro paizvozvo, ratova zuva rechitatu kubvira pazvakaitika.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.21",
            "verseOrgIds": [
              "LUK.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyezve vamwe vakadzi vokwedu vatishamisa. Vaenda kuguva nhasi mambakwedza",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.22",
            "verseOrgIds": [
              "LUK.24.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi havana kuwana mutumbi wake urimo. Vauya vakatiudza kuti vaona chiratidzo chavatumwa, avo vati iye mupenyu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.23",
            "verseOrgIds": [
              "LUK.24.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo dzimwe shamwari dzedu dzaenda kuguva dzikawana zviri izvo chaizvo zvanga zvataurwa navakadzi vaya, asi iye havana kumuona.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.24",
            "verseOrgIds": [
              "LUK.24.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye akati kwavari, \"Haiwa imi vokusanzwisisa, uye vane mwoyo inononoka kutenda zvose zvakarehwa navaprofita!",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.25",
            "verseOrgIds": [
              "LUK.24.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 24:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, Kristu akanga asingafaniri kutambudzika pazvinhu izvi agozopinda mukubwinya kwake here?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.26",
            "verseOrgIds": [
              "LUK.24.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akatanga naMozisi navaprofita vose, akavatsanangurira zvakanyorwa pamusoro pake mumagwaro.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.27",
            "verseOrgIds": [
              "LUK.24.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 24:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuzoti vava kusvika mumusha mavakanga vachienda, Jesu akaita sokunge oda kupfuurira.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.28",
            "verseOrgIds": [
              "LUK.24.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 24:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vakamugombedzera zvikuru vachiti, \"Garai nesu, nokuti kwava kudoka; zuva rava kuvira.\" Saka akapinda kuti andogara navo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.29",
            "verseOrgIds": [
              "LUK.24.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 24:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati agara navo patafura, akatora chingwa, akavonga, akachimedura akatanga kuvapa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.30",
            "verseOrgIds": [
              "LUK.24.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 24:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo meso avo akasvinudzwa vakamuziva, akabva anyangarika pamberi pavo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.31",
            "verseOrgIds": [
              "LUK.24.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 24:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakabvunzana vachiti, \"Ko, mwoyo yedu yanga isingapisi neiko mukati medu zvaanga achitaura nesu mumugwagwa uye achitizarurira magwaro?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.32",
            "verseOrgIds": [
              "LUK.24.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 24:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakasimuka panguva iyoyo vakadzokera kuJerusarema. Ikoko, vakandowana vane Gumi noMumwe navamwe vavaiva navo, vakaungana pamwe chete",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.33",
            "verseOrgIds": [
              "LUK.24.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 24:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "vachiti, \"Ichokwadi! Ishe amuka uye azviratidza kuna Simoni.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.34",
            "verseOrgIds": [
              "LUK.24.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 24:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vaviri ava vakataura zvakanga zvaitika munzira, uye kuti vakaziva sei Jesu paakamedura chingwa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.35",
            "verseOrgIds": [
              "LUK.24.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu Anozviratidza kuVadzidzi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 24:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pavakanga vachiri kutaura pamusoro pazvo, Jesu pachake akasvikomira pakati pavo akati, \"Rugare ngaruve nemi.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.36",
            "verseOrgIds": [
              "LUK.24.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 24:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakavhunduka uye vakatya, vachifunga kuti vaona mweya.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.37",
            "verseOrgIds": [
              "LUK.24.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 24:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye akati kwavari, \"Munotambudzika neiko, uye seiko kukahadzika kuchimuka mupfungwa dzenyu?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.38",
            "verseOrgIds": [
              "LUK.24.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 24:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tarisai maoko angu netsoka dzangu. Ndini iye! Ndibatei muone; mweya hauna nyama namapfupa, sezvamunoona ndinazvo ini.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.39",
            "verseOrgIds": [
              "LUK.24.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 24:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati areva izvi, akavaratidza maoko ake netsoka dzake.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.40",
            "verseOrgIds": [
              "LUK.24.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 24:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye pavakanga vachigere kutenda nokuda kwomufaro uye vachishamiswa, akavabvunza akati, \"Mune chokudya here pano?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.41",
            "verseOrgIds": [
              "LUK.24.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 24:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakamupa chimedu chehove yakagochwa,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.42",
            "verseOrgIds": [
              "LUK.24.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 24:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye akachitora akachidya pamberi pavo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.43",
            "verseOrgIds": [
              "LUK.24.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 24:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati kwavari, \"Izvi ndizvo zvandaikuudzai ndichinemi kuti: Zvinhu zvose zvakanyorwa pamusoro pangu muMurayiro waMozisi, naVaprofita nomuMapisarema zvinofanira kuzadziswa.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.44",
            "verseOrgIds": [
              "LUK.24.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 24:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akazarura ndangariro dzavo kuti vanzwisise Magwaro.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.45",
            "verseOrgIds": [
              "LUK.24.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 24:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati kwavari, \"Izvi ndizvo zvakanyorwa kuti: Kristu achatambudzika agomuka kubva kuvakafa pazuva rechitatu,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.46",
            "verseOrgIds": [
              "LUK.24.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LUK 24:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye kuti kutendeuka nokuregererwa kwezvivi kuchaparidzirwa kumarudzi ose muzita rake, kutanga paJerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.47",
            "verseOrgIds": [
              "LUK.24.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LUK 24:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imi muri zvapupu zvezvinhu izvi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.48",
            "verseOrgIds": [
              "LUK.24.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LUK 24:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichakutumirai chipikirwa chakavimbiswa naBaba; asi imi garai muguta kusvikira mafukidzwa nesimba rinobva kumusoro.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.49",
            "verseOrgIds": [
              "LUK.24.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kukwidzwa kwaJesu kudenga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LUK 24:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati avatungamirira kunze kweguta pedyo neBhetania, akatambanudza maoko ake akavaropafadza.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.50",
            "verseOrgIds": [
              "LUK.24.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LUK 24:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achiri kuvaropafadza, akabva pavari akatorwa akakwidzwa kudenga.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.51",
            "verseOrgIds": [
              "LUK.24.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LUK 24:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vakamunamata ndokubva vadzokera kuJerusarema nomufaro mukuru.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.52",
            "verseOrgIds": [
              "LUK.24.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LUK 24:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye vakaramba vari mutemberi, vachirumbidza Mwari nguva dzose.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.53",
            "verseOrgIds": [
              "LUK.24.53"
            ]
          }
        }
      ]
    }
  ],
