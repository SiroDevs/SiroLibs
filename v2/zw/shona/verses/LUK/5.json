  "verseCount": 39,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "LUK 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kudanwa kwaVadzidzi Vokutanga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rimwe zuva Jesu zvaakanga amire paGungwa reGenesareti, vanhu vakaungana vakamukomberedza vachiteerera kushoko raMwari,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.1",
            "verseOrgIds": [
              "LUK.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye akaona magwa maviri kumhenderekedzo dzegungwa, akanga asiyiwapo navabati vehove, vakanga vachisuka mambure avo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.2",
            "verseOrgIds": [
              "LUK.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akakwira mune rimwe ramagwa acho, rakanga riri raSimoni, akamukumbira kuti ariswededze zvishoma kumahombekombe. Ipapo akagara pasi akadzidzisa vanhu ari mugwa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.3",
            "verseOrgIds": [
              "LUK.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati apedza kutaura, akati kuna Simoni, \"Chiriswededza kwakadzika ugokanda usvasvi ubate hove.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.4",
            "verseOrgIds": [
              "LUK.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoni akapindura akati, \"Tenzi, takashanda zvakaoma usiku hwose uye hatina kubata chinhu. Asi sezvamadaro imi, ndichakanda hangu mambure.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.5",
            "verseOrgIds": [
              "LUK.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati vaita saizvozvo, vakabata hove zhinji kwazvo uye mambure avo akatanga kubvaruka.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.6",
            "verseOrgIds": [
              "LUK.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vakaninira vamwe vavo vakanga vari mune rimwe igwa kuti vauye vazovabatsira, ivo vakauya vakazadza magwa ose ari maviri; akazara zvokuti akatanga kunyura.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.7",
            "verseOrgIds": [
              "LUK.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoni Petro akati achiona izvi, akawira pamabvi aJesu akati, \"Ibvai kwandiri, Ishe; ndiri mutadzi!\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.8",
            "verseOrgIds": [
              "LUK.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti iye neshamwari dzake vakashama kwazvo nokuda kwehove dzavakanga vabata,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.9",
            "verseOrgIds": [
              "LUK.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye vanaJakobho naJohani, vanakomana vaZebhedhi, vamwe vaSimoni, vakashamawo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.10",
            "verseOrgIds": [
              "LUK.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 5:10"
      },
      "items": [
        {
          "text": "Ipapo Jesu akati kuna Simoni, \"Usatya; kubva zvino uchava mubati wavanhu.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.10",
            "verseOrgIds": [
              "LUK.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vakakwevera magwa avo kumahombekombe, vakasiya zvose uye vakamutevera.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.11",
            "verseOrgIds": [
              "LUK.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu Anonatsa Munhu Akanga Ana Maperembudzi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu paakanga achiri mune rimwe ramaguta, mumwe murume akanga azere namaperembudzi akauya. Akati achiona Jesu, akawira pasi nechiso chake akamukumbira zvikuru achiti, \"Ishe, kana muchida, munogona kundinatsa.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.12",
            "verseOrgIds": [
              "LUK.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akatambanudza ruoko rwake akabata murume uyu akati, \"Ndinoda, chinatswa!\" Pakarepo maperembudzi akabva paari.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.13",
            "verseOrgIds": [
              "LUK.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jesu akamurayira akati, \"Usaudza munhu, asi enda undozviratidza kumuprista ugopa zvibayiro zvakarayirwa naMozisi zvokunatswa kwako, chive chapupu kwavari.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.14",
            "verseOrgIds": [
              "LUK.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi mukurumbira wake wakapararira kwazvo, zvokuti vanhu vazhinji zhinji vakauya kuzomunzwa uye kuti vaporeswe zvirwere zvavo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.15",
            "verseOrgIds": [
              "LUK.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi, kazhinji Jesu aizvitsaura achienda kusina vanhu kuti andonyengetera.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.16",
            "verseOrgIds": [
              "LUK.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu Anoporesa Munhu Akanga Akaoma Mutezo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rimwe zuva paaidzidzisa, vaFarisi navadzidzisi vomurayiro, vakanga vabva mumisha yose yeGarirea neJudhea uye neJerusarema, vakanga vagerepo. Uye simba raShe rakanga riripo kuti aporese vanorwara.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.17",
            "verseOrgIds": [
              "LUK.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vamwe varume vakasvika vakatakura murume akanga akaoma mutezo parukukwe vakaedza kuti vamupinze mumba kuti vandomuradzika pamberi paJesu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.18",
            "verseOrgIds": [
              "LUK.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati vashayiwa nzira yokupinda nayo nokuda kwokuwanda kwavanhu, vakakwira pamusoro pedenga vakamuburutsa ari parukukwe rwake nepamapfiriro, pakati pavanhu, pamberi paJesu chaipo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.19",
            "verseOrgIds": [
              "LUK.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati aona kutenda kwavo, akati, \"Shamwari, zvivi zvako zvaregererwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.20",
            "verseOrgIds": [
              "LUK.5.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaFarisi navadzidzisi vomurayiro vakatanga kufunga vachiti, \"Ndianiko munhu uyu anotaura achimhura Mwari. Ndianiko anoregerera zvivi kunze kwaMwari chete?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.21",
            "verseOrgIds": [
              "LUK.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu aiziva zvavaifunga uye akabvunza achiti, \"Seiko muchifunga zvinhu izvi mumwoyo yenyu?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.22",
            "verseOrgIds": [
              "LUK.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndezvipiko zvakareruka: kuti, 'Zvivi zvako zvaregererwa,' kana kuti, 'Simuka ufambe'?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.23",
            "verseOrgIds": [
              "LUK.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kuti muzive kuti Mwanakomana woMunhu ane simba panyika rokuregerera zvivi.\" Akati kumurume akanga akaoma mutezo, \"Ndinoti kwauri, simuka, tora rukukwe rwako uende kumba.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.24",
            "verseOrgIds": [
              "LUK.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakarepo akasimuka pamberi pavo, akatora rukukwe rwaakanga avete parwuri akaenda kumba achirumbidza Mwari.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.25",
            "verseOrgIds": [
              "LUK.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munhu wose akashamiswa nazvo akarumbidza Mwari. Vakazadzwa nokutya vakati, \"Taona zvinhu zvinoshamisa nhasi.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.26",
            "verseOrgIds": [
              "LUK.5.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kudanwa kwaRevhi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwaizvozvo, Jesu akabuda akaona muteresi ainzi Revhi akagara paimba yake yokuteresa. Jesu akati kwaari, \"Nditevere.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.27",
            "verseOrgIds": [
              "LUK.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Revhi akasimuka, akasiya zvinhu zvose akamutevera.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.28",
            "verseOrgIds": [
              "LUK.5.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Revhi akaitira Jesu mabiko makuru pamba pake, uye vateresi vazhinji kwazvo navamwewo vakadya navo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.29",
            "verseOrgIds": [
              "LUK.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vaFarisi navadzidzisi vomurayiro vakanga vari veboka ravo vakagununʼuna vakati kuvadzidzi vake, \"Seiko muchidya navateresi navatadzi?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.30",
            "verseOrgIds": [
              "LUK.5.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akavapindura akati, \"Vasingarwari havatsvaki chiremba, asi vanorwara.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.31",
            "verseOrgIds": [
              "LUK.5.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Handina kuuya kuzodana vakarurama, asi vatadzi kuti vatendeuke.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.32",
            "verseOrgIds": [
              "LUK.5.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vanobvunza Jesu pamusoro poKutsanya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 5:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivo vakati kwaari, \"Vadzidzi vaJohani vanotsanya kazhinji uye vachinyengetera, uye vadzidzi vavaFarisi vanodarowo, asi venyu vanoramba vachidya nokunwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.33",
            "verseOrgIds": [
              "LUK.5.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 5:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akavapindura akati, \"Mungaite here kuti shamwari dzechikomba dzitsanye iye achinavo?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.34",
            "verseOrgIds": [
              "LUK.5.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 5:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi nguva ichauya apo chikomba chichabviswa kwavari; mumazuva iwayo vachatsanya.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.35",
            "verseOrgIds": [
              "LUK.5.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 5:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akavaudza mufananidzo uyu akati, \"Hakuna munhu anobvarura chigamba kubva panguo itsva achichisonera panguo tsaru. Kana akadaro, anenge abvarura nguo itsva, uye chigamba chinobva panguo itsva hachibatsiri panguo tsaru.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.36",
            "verseOrgIds": [
              "LUK.5.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 5:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye hakuna anodira waini itsva mumaguchu amatehwe matsaru. Kana akadaro, waini itsva ichatsemura matehwe, waini itsva ichateuka uye maguchu ewaini achaparadzwa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.37",
            "verseOrgIds": [
              "LUK.5.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 5:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwete, waini itsva inofanira kudirwa mumaguchu amatehwe matsva.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.38",
            "verseOrgIds": [
              "LUK.5.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 5:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye hakuna munhu anoti ambonwa waini tsaru ozoda waini itsva, nokuti anoti, 'Tsaru iri nani.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.39",
            "verseOrgIds": [
              "LUK.5.39"
            ]
          }
        }
      ]
    }
  ],
