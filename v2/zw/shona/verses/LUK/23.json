  "verseCount": 56,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "LUK 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ungano yose yakasimuka ikaenda naye kuna Pirato.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.1",
            "verseOrgIds": [
              "LUK.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye vakatanga kumupomera mhosva, vachiti, \"Takawana murume uyu achitsausa rudzi rwedu. Haabvumirani nokuripa mutero kuna Kesari uye anozviti ndiye Kristu, mambo.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.2",
            "verseOrgIds": [
              "LUK.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Pirato akabvunza Jesu achiti, \"Ndiwe mambo wavaJudha here?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.3",
            "verseOrgIds": [
              "LUK.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 23:3"
      },
      "items": [
        {
          "text": "Jesu akapindura akati, \"Hongu, ndizvo zvamareva.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.3",
            "verseOrgIds": [
              "LUK.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Pirato akati kuvaprista vakuru navanhu vazhinji, \"Handiwani hwaro hwemhosva inopomerwa murume uyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.4",
            "verseOrgIds": [
              "LUK.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi ivo vakaramba vachiti, \"Anomutsa vanhu nedzidziso yake muJudhea rose. Akatanga kuGarirea uye atosvika kwose kuno uku.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.5",
            "verseOrgIds": [
              "LUK.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anzwa izvi, Pirato akabvunza kuti murume uyu akanga ari muGarirea here.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.6",
            "verseOrgIds": [
              "LUK.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati anzwa kuti Jesu akanga ari pasi poutongi hwaHerodhi, akabva amutumira kuna Herodhi, uyo aivawo muJerusarema panguva iyoyo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.7",
            "verseOrgIds": [
              "LUK.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Herodhi akati achiona Jesu, akafara zvikuru, nokuti akanga achishuva kumuona kwenguva refu. Kubva pane zvaakanga ambonzwa nezvake, ainge achitarisira kuti amuone achiita zvishamiso.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.8",
            "verseOrgIds": [
              "LUK.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamubvunza mibvunzo mizhinji, asi Jesu haana kumupindura.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.9",
            "verseOrgIds": [
              "LUK.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaprista vakuru navadzidzisi vomurayiro vakanga vamire ipapo, vachinyanya kumupomera mhosva.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.10",
            "verseOrgIds": [
              "LUK.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Herodhi navarwi vake vakamuzvidza uye vakamuseka. Vakamupfekedza nguo youmambo, vakamudzosera kuna Pirato.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.11",
            "verseOrgIds": [
              "LUK.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musi uyo, Herodhi naPirato vakava shamwari, kare kwavo, vakanga vachimbovengana.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.12",
            "verseOrgIds": [
              "LUK.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pirato akaunganidza vaprista vakuru, vatongi, navanhu,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.13",
            "verseOrgIds": [
              "LUK.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "akati kwavari, \"Mauyisa munhu uyu kwandiri somunhu anomutsa vanhu kuti vamukire hurumende. Ndanyatsomuongorora pamberi penyu uye ndashaya hwaro hwemhosva yamunomupomera.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.14",
            "verseOrgIds": [
              "LUK.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange naHerodhi, nokuti amudzosa kwatiri; sezvamunoona, haana kuita chinhu chingafanira kutongerwa rufu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.15",
            "verseOrgIds": [
              "LUK.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo, ndichamurova ndigomuregedza.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.16",
            "verseOrgIds": [
              "LUK.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Nokuti aifanira kuvasunungurira mumwe munhu pamutambo.)",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.17",
            "verseOrgIds": [
              "LUK.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vose pamwe chete vakadanidzira vachiti, \"Murume uyu ngaafe! Tisunungurirei Bharabhasi!\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.18",
            "verseOrgIds": [
              "LUK.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Bharabhasi akanga aiswa mujeri nokuda kwebope raakanga amutsa muguta, uye nemhaka yokuuraya.)",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.19",
            "verseOrgIds": [
              "LUK.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sezvaakanga achida kusunungura Jesu, Pirato akataurazve navo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.20",
            "verseOrgIds": [
              "LUK.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi ivo vakaramba vachidanidzira vachiti, \"Murovererei! Murovererei!\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.21",
            "verseOrgIds": [
              "LUK.23.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati kwavari kechitatu, \"Sei? Murume uyu atadzeiko? Handina kuwana mhosva paari yokuti atongerwe rufu. Naizvozvo, ndichaita kuti arohwe ndigomusunungura.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.22",
            "verseOrgIds": [
              "LUK.23.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vakaramba vachidanidzira nenzwi guru vachiti aifanira kurovererwa pamuchinjikwa, uye kudanidzira kwavo kukakunda.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.23",
            "verseOrgIds": [
              "LUK.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Pirato akatonga kuti zvavakakumbira zviitwe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.24",
            "verseOrgIds": [
              "LUK.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akasunungura murume akanga aiswa mujeri nokuda kwebope uye nokuuraya, uyo wavakanga vakumbira, ndokubva avapa Jesu kuti vaite zvavanoda naye.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.25",
            "verseOrgIds": [
              "LUK.23.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kurovererwa kwaJesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati voenda naye, vakabata murume ainzi Simoni weKurini, uyo akanga achibva muruwa, vakamutakudza muchinjikwa ari mushure maJesu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.26",
            "verseOrgIds": [
              "LUK.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vazhinji zhinji vakamutevera, pamwe chete navakadzi vakanga vachichema uye vachiungudza.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.27",
            "verseOrgIds": [
              "LUK.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akatendeuka akati kwavari, \"Vanasikana veJerusarema, musandichema ini; zvichemei imi navana venyu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.28",
            "verseOrgIds": [
              "LUK.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti nguva ichasvika iyo yamuchati, 'Vakaropafadzwa vakadzi vasingabereki, izvo zvizvaro zvisina kumbobereka, namazamu asina kumboyamwisa!'",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.29",
            "verseOrgIds": [
              "LUK.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.30",
            "verseOrgIds": [
              "LUK.23.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LUK 23:30"
      },
      "items": [
        {
          "text": "\"vachati kumakomo, 'Wirai pamusoro pedu!'",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.30",
            "verseOrgIds": [
              "LUK.23.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LUK 23:30"
      },
      "items": [
        {
          "text": "nokuzvikomo, 'Tifukidzei!'",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.30",
            "verseOrgIds": [
              "LUK.23.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti kana vanhu vachiita zvinhu izvi pamuti munyoro, chiiko chichaitika kune wakaoma?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.31",
            "verseOrgIds": [
              "LUK.23.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vamwezve varume vaviri, vose vakanga vari mbavha, vakatorwawo pamwe chete naye kuti vandourayiwa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.32",
            "verseOrgIds": [
              "LUK.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati vasvika panzvimbo yainzi Dehenya, vakamuroverera ipapo, pamwe chete nembavha, mumwe kurudyi rwake, mumwe kuruboshwe rwake.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.33",
            "verseOrgIds": [
              "LUK.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati, \"Baba, varegererei, nokuti havazivi zvavari kuita.\" Vakagovana nguo dzake vachikanda mijenya.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.34",
            "verseOrgIds": [
              "LUK.23.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vakamira vakatarira, uye kunyange vatongi vakamuseka. Vakati, \"Akaponesa vamwe; ngaazviponese iye pachake kana ari Kristu waMwari, iye Musanangurwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.35",
            "verseOrgIds": [
              "LUK.23.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varwi vakasvikawo vakamuseka. Vakamupa waini yevhiniga",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.36",
            "verseOrgIds": [
              "LUK.23.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 23:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "vakati, \"Kana uri mambo wavaJudha, chizviponesa.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.37",
            "verseOrgIds": [
              "LUK.23.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 23:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamusoro pake pakanga pane chiziviso chakanga chakanyorwa kuti:",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.38",
            "verseOrgIds": [
              "LUK.23.38"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "sc"
          },
          "items": [
            {
              "text": "uyu ndiye mambo wavajudha",
              "type": "text",
              "attrs": {
                "verseId": "LUK.23.38",
                "verseOrgIds": [
                  "LUK.23.38"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.38",
            "verseOrgIds": [
              "LUK.23.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 23:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwe wembavha dzakanga dzakarembera pamwe chete naye akamutuka achiti, \"Ko, ndiwe Kristu here? Zviponese ugoponesa nesuwo!\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.39",
            "verseOrgIds": [
              "LUK.23.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 23:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi imwe mbavha yakamutsiura ikati, \"Hautyi Mwari here iwe, sezvo uri pakutongwa kumwe cheteko?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.40",
            "verseOrgIds": [
              "LUK.23.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 23:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isu tiri kutongwa zvakarurama, nokuti tiri kupiwa zvakafanira mabasa edu. Asi munhu uyu haana chakaipa chaakaita.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.41",
            "verseOrgIds": [
              "LUK.23.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 23:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akati, \"Jesu, mundirangarirewo pamunenge masvika muumambo hwenyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.42",
            "verseOrgIds": [
              "LUK.23.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 23:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akamupindura akati, \"Zvirokwazvo ndinoti kwauri, nhasi uchava neni muparadhiso.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.43",
            "verseOrgIds": [
              "LUK.23.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kufa kwaJesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 23:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino yakanga yava nguva inenge yechitanhatu, rima rikava pamusoro penyika yose kusvikira panguva yepfumbamwe,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.44",
            "verseOrgIds": [
              "LUK.23.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 23:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti zuva rakamira kuvhenekera. Uye chidzitiro chetemberi chakabvarurwa napakati.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.45",
            "verseOrgIds": [
              "LUK.23.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 23:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akadanidzira nenzwi guru achiti, \"Baba, ndinoisa mweya wangu mumaoko enyu.\" Akati ataura izvi, akabudisa mweya wake.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.46",
            "verseOrgIds": [
              "LUK.23.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LUK 23:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukuru wezana, akati achiona zvakanga zvaitika, akarumbidza Mwari achiti, \"Zvirokwazvo uyu anga ari munhu akarurama.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.47",
            "verseOrgIds": [
              "LUK.23.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LUK 23:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vose vakanga vakaungana kuzopupura chiitiko ichi, vakaona zvakanga zvaitika, vakazvirova zvipfuva zvavo uye vakaenda.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.48",
            "verseOrgIds": [
              "LUK.23.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LUK 23:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vakanga vachimuziva, pamwe chete navakadzi vakanga vamutevera vachibva kuGarirea, vakamira nechokure, vakatarisa zvinhu zvose izvi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.49",
            "verseOrgIds": [
              "LUK.23.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuvigwa kwaJesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LUK 23:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino kwakanga kuno mumwe murume ainzi Josefa, nhengo yedare ramakurukota, munhu akanga akanaka uye akarurama,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.50",
            "verseOrgIds": [
              "LUK.23.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LUK 23:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "uyo akanga asina kubvumirana navo pakuronga kwavo uye nokuita kwavo. Aibva kuguta ravaJudha reArimatea uye akanga akamirira umambo hwaMwari.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.51",
            "verseOrgIds": [
              "LUK.23.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LUK 23:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asvika kuna Pirato, akakumbira mutumbi waJesu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.52",
            "verseOrgIds": [
              "LUK.23.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LUK 23:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akauburutsa, akauputira nomucheka akauisa muguva rakanga racherwa paruware, rakanga risina kumbovigwa munhu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.53",
            "verseOrgIds": [
              "LUK.23.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "LUK 23:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rakanga riri zuva rokugadzirira, uye Sabata rakanga rava kuda kutanga.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.54",
            "verseOrgIds": [
              "LUK.23.54"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "LUK 23:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakadzi vaya vakanga vauya naJesu vachibva kuGarirea vakatevera Josefa vakaona guva uye kuti mutumbi wake wakanga waradzikwa sei mariri.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.55",
            "verseOrgIds": [
              "LUK.23.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "LUK 23:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vakaenda kumba vakandogadzira zvinonhuhwira namafuta anonhuhwira. Asi vakazorora nomusi weSabata vachiteerera murayiro.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.56",
            "verseOrgIds": [
              "LUK.23.56"
            ]
          }
        }
      ]
    }
  ],
