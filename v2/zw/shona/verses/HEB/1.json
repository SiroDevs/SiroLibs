  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "HEB 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kristu mukuru kuVatumwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kare, Mwari akataura kumadzitateguru edu kubudikidza navaprofita panguva zhinji, uye nenzira dzakasiyana-siyana,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.1",
            "verseOrgIds": [
              "HEB.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi mumazuva ano okupedzisira akataura kwatiri nomuMwanakomana wake, waakaita mudyi wenhaka yezvinhu zvose, uye naiyewo waakaita naye nyika.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.2",
            "verseOrgIds": [
              "HEB.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanakomana ndiye chadzera chokubwinya kwaMwari uye ndiye mufananidzo wake chaiwo, anochengeta zvinhu zvose neshoko rake rine simba. Mushure mokunge apedza kunatswa kwezvivi, akagara kurudyi rwamambo kudenga.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.3",
            "verseOrgIds": [
              "HEB.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka akava mukuru kupfuura vatumwa sezvo zita raakapiwa nhaka yaro rakanyanya kunaka kupfuura ravo.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.4",
            "verseOrgIds": [
              "HEB.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti ndoupi pakati pavatumwa, Mwari waakamboti kwaari:",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.5",
            "verseOrgIds": [
              "HEB.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 1:5"
      },
      "items": [
        {
          "text": "\"Ndiwe Mwanakomana wangu;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.5",
            "verseOrgIds": [
              "HEB.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 1:5"
      },
      "items": [
        {
          "text": "nhasi ndava baba vako?\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.5",
            "verseOrgIds": [
              "HEB.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "HEB 1:5"
      },
      "items": [
        {
          "text": "kana kutizve,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.5",
            "verseOrgIds": [
              "HEB.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 1:5"
      },
      "items": [
        {
          "text": "\"Ndichava Baba vake,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.5",
            "verseOrgIds": [
              "HEB.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 1:5"
      },
      "items": [
        {
          "text": "naiye achava Mwanakomana wangu?\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.5",
            "verseOrgIds": [
              "HEB.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyezve, Mwari paanouyisa dangwe rake munyika, anoti:",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.6",
            "verseOrgIds": [
              "HEB.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 1:6"
      },
      "items": [
        {
          "text": "\"Vatumwa vose vaMwari ngavamunamate.\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.6",
            "verseOrgIds": [
              "HEB.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achitaura pamusoro pavatumwa anoti,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.7",
            "verseOrgIds": [
              "HEB.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 1:7"
      },
      "items": [
        {
          "text": "\"Anoita vatumwa vake mhepo,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.7",
            "verseOrgIds": [
              "HEB.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 1:7"
      },
      "items": [
        {
          "text": "varanda vake mirazvo yomoto.\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.7",
            "verseOrgIds": [
              "HEB.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi pamusoro poMwanakomana anoti,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.8",
            "verseOrgIds": [
              "HEB.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 1:8"
      },
      "items": [
        {
          "text": "\"Chigaro chenyu choushe, imi Mwari, chichagara nokusingaperi-peri,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.8",
            "verseOrgIds": [
              "HEB.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 1:8"
      },
      "items": [
        {
          "text": "uye kururama kuchava tsvimbo youshe hwenyu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.8",
            "verseOrgIds": [
              "HEB.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makada kururama uye mukavenga kusarurama;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.9",
            "verseOrgIds": [
              "HEB.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 1:9"
      },
      "items": [
        {
          "text": "naizvozvo Mwari, Mwari wenyu, akakuisai pamusoro peshamwari dzenyu",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.9",
            "verseOrgIds": [
              "HEB.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 1:9"
      },
      "items": [
        {
          "text": "nokukuzodzai namafuta okufara.\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.9",
            "verseOrgIds": [
              "HEB.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anotizve,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.10",
            "verseOrgIds": [
              "HEB.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 1:10"
      },
      "items": [
        {
          "text": "\"Pakutanga, imi Ishe, makateya nheyo dzenyika,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.10",
            "verseOrgIds": [
              "HEB.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 1:10"
      },
      "items": [
        {
          "text": "uye matenga ndiwo basa ramaoko enyu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.10",
            "verseOrgIds": [
              "HEB.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvichaparara, asi imi mucharamba muripo;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.11",
            "verseOrgIds": [
              "HEB.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 1:11"
      },
      "items": [
        {
          "text": "zvichasakara zvose senguo.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.11",
            "verseOrgIds": [
              "HEB.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muchazvipeta sejasi;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.12",
            "verseOrgIds": [
              "HEB.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 1:12"
      },
      "items": [
        {
          "text": "senguo zvichashandurwa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.12",
            "verseOrgIds": [
              "HEB.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 1:12"
      },
      "items": [
        {
          "text": "Asi imi munoramba makadaro,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.12",
            "verseOrgIds": [
              "HEB.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 1:12"
      },
      "items": [
        {
          "text": "uye makore enyu haatozogumi.\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.12",
            "verseOrgIds": [
              "HEB.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndoupi pakati pavatumwa akambonzi naMwari:",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.13",
            "verseOrgIds": [
              "HEB.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 1:13"
      },
      "items": [
        {
          "text": "\"Gara kurudyi rwangu",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.13",
            "verseOrgIds": [
              "HEB.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 1:13"
      },
      "items": [
        {
          "text": "kusvikira ndaita vavengi vako",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.13",
            "verseOrgIds": [
              "HEB.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 1:13"
      },
      "items": [
        {
          "text": "chitsiko chetsoka dzako?\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.13",
            "verseOrgIds": [
              "HEB.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, vatumwa vose havasi mweya inoshumira yakatumwa kuzobatsira vaya vachadya nhaka yoruponeso here?",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.14",
            "verseOrgIds": [
              "HEB.1.14"
            ]
          }
        }
      ]
    }
  ],
