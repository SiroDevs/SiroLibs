            "number": "3",
            "style": "v",
            "sid": "PSA 137:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti ipapo avo vakatitapa vakatikumbira nziyo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.3",
            "verseOrgIds": [
              "PSA.137.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:3"
      },
      "items": [
        {
          "text": "vatambudzi vedu vakatigombedzera kuti tiimbe nziyo dzomufaro, vakati,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.3",
            "verseOrgIds": [
              "PSA.137.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:3"
      },
      "items": [
        {
          "text": "\"Tiimbirei rumwe rwiyo rweZioni!\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.3",
            "verseOrgIds": [
              "PSA.137.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 137:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tingaimba seiko nziyo dzaJehovha",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.4",
            "verseOrgIds": [
              "PSA.137.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:4"
      },
      "items": [
        {
          "text": "tiri munyika yokumwe?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.4",
            "verseOrgIds": [
              "PSA.137.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 137:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana ndikakukanganwa, iwe Jerusarema,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.5",
            "verseOrgIds": [
              "PSA.137.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:5"
      },
      "items": [
        {
          "text": "ruoko rwangu rworudyi ngarukanganwe umhizha hwarwo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.5",
            "verseOrgIds": [
              "PSA.137.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 137:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rurimi rwangu ngarunamatire kumusoro kwomuromo wangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.6",
            "verseOrgIds": [
              "PSA.137.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:6"
      },
      "items": [
        {
          "text": "kana ndikasakurangarira iwe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.6",
            "verseOrgIds": [
              "PSA.137.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 137:6"
      },
      "items": [
        {
          "text": "kana ndisingafungi Jerusarema,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.6",
            "verseOrgIds": [
              "PSA.137.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:6"
      },
      "items": [
        {
          "text": "iwo mufaro wangu wapamusoro-soro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.6",
            "verseOrgIds": [
              "PSA.137.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
