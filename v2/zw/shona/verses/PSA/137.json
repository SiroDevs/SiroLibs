            "sid": "PSA 137:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamikonachando apo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.2",
            "verseOrgIds": [
              "PSA.137.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:2"
      },
      "items": [
        {
          "text": "ndipo patakaturika mbira dzedu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.2",
            "verseOrgIds": [
              "PSA.137.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
