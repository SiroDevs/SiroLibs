          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 137:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa Jehovha, rangarirai henyu zvakaitwa navaEdhomu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.7",
            "verseOrgIds": [
              "PSA.137.7"
            ]
          }
        }
      ]
    },
