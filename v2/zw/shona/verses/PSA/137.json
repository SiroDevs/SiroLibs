      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:7"
      },
      "items": [
        {
          "text": "pazuva rakawa Jerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.7",
            "verseOrgIds": [
              "PSA.137.7"
            ]
          }
        }
      ]
