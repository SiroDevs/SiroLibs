      },
      "items": [
        {
          "text": "97",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Pisarema 97",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 97:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha anobata ushe, nyika ngaifare;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.1",
            "verseOrgIds": [
              "PSA.97.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:1"
      },
      "items": [
        {
          "text": "zviwi zviri kure ngazvifare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.1",
            "verseOrgIds": [
              "PSA.97.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 97:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makore nerima guru zvakamukomberedza;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.2",
            "verseOrgIds": [
              "PSA.97.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:2"
      },
      "items": [
        {
          "text": "kururama nokururamisira ndidzo nheyo dzechigaro chake choushe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.2",
            "verseOrgIds": [
              "PSA.97.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 97:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto unoenda mberi kwake",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.3",
            "verseOrgIds": [
              "PSA.97.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:3"
      },
      "items": [
        {
          "text": "uchipisa vavengi vake kumativi ose.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.3",
            "verseOrgIds": [
              "PSA.97.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 97:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mheni yake inovhenekera pasi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.4",
            "verseOrgIds": [
              "PSA.97.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:4"
      },
      "items": [
        {
          "text": "nyika inozviona igodedera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.4",
            "verseOrgIds": [
              "PSA.97.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 97:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makomo anonyungudika senamo pamberi paJehovha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.5",
            "verseOrgIds": [
              "PSA.97.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:5"
      },
      "items": [
        {
          "text": "pamberi paIshe wenyika yose.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.5",
            "verseOrgIds": [
              "PSA.97.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 97:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kudenga denga kunoparidza kururama kwake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.6",
            "verseOrgIds": [
              "PSA.97.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:6"
      },
      "items": [
        {
          "text": "uye vanhu vose vanoona kubwinya kwake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.6",
            "verseOrgIds": [
              "PSA.97.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 97:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vose vanonamata zvifananidzo vanonyadziswa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.7",
            "verseOrgIds": [
              "PSA.97.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:7"
      },
      "items": [
        {
          "text": "avo vanozvirumbidza nezvifananidzo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.7",
            "verseOrgIds": [
              "PSA.97.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:7"
      },
      "items": [
        {
          "text": "munamatei, imi vamwari vose!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.7",
            "verseOrgIds": [
              "PSA.97.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 97:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zioni rinonzwa rigofara uye misha yeJudha inofara nokuda kwezvamakatonga, imi Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.8",
            "verseOrgIds": [
              "PSA.97.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 97:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti imi, iyemi Jehovha, ndimi Wokumusoro-soro pasi pose;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.9",
            "verseOrgIds": [
              "PSA.97.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:9"
      },
      "items": [
        {
          "text": "makasimudzirwa kupfuura vamwari vose.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.9",
            "verseOrgIds": [
              "PSA.97.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 97:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanoda Jehovha ngavavenge zvakaipa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.10",
            "verseOrgIds": [
              "PSA.97.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:10"
      },
      "items": [
        {
          "text": "nokuti anorinda upenyu kwavanhu vake vakatendeka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.10",
            "verseOrgIds": [
              "PSA.97.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:10"
      },
      "items": [
        {
          "text": "uye anovarwira muruoko rwowakaipa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.10",
            "verseOrgIds": [
              "PSA.97.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 97:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiedza chinovhenekera pamusoro pavakarurama,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.11",
            "verseOrgIds": [
              "PSA.97.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:11"
      },
      "items": [
        {
          "text": "nomufaro pamusoro pavane mwoyo yakarurama.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.11",
            "verseOrgIds": [
              "PSA.97.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 97:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farai muna Jehovha, imi vakarurama,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.12",
            "verseOrgIds": [
              "PSA.97.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:12"
      },
      "items": [
        {
          "text": "uye mukudze zita rake dzvene.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.12",
            "verseOrgIds": [
              "PSA.97.12"
            ]
          }
        }
      ]
    }
  ],
