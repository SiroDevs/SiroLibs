  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "50",
        "style": "c",
        "sid": "PSA 50"
      },
      "items": [
        {
          "text": "50",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Pisarema 50",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Pisarema raAsafi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 50:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye Wamasimba, Mwari, Jehovha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.1",
            "verseOrgIds": [
              "PSA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:1"
      },
      "items": [
        {
          "text": "anotaura uye anodana nyika",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.1",
            "verseOrgIds": [
              "PSA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:1"
      },
      "items": [
        {
          "text": "kubva pakubuda kwezuva kusvikira kwarinovirira.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.1",
            "verseOrgIds": [
              "PSA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 50:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubva kuZioni, rakakwana parunako,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.2",
            "verseOrgIds": [
              "PSA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:2"
      },
      "items": [
        {
          "text": "Mwari anopenya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.2",
            "verseOrgIds": [
              "PSA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 50:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari wedu anouya uye haanganyarari;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.3",
            "verseOrgIds": [
              "PSA.50.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:3"
      },
      "items": [
        {
          "text": "moto unoparadza pamberi pake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.3",
            "verseOrgIds": [
              "PSA.50.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:3"
      },
      "items": [
        {
          "text": "uye dutu rine hasha rakamupoteredza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.3",
            "verseOrgIds": [
              "PSA.50.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 50:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anodana matenga kumusoro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.4",
            "verseOrgIds": [
              "PSA.50.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:4"
      },
      "items": [
        {
          "text": "uye nenyika, kuti atonge vanhu vake achiti:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.4",
            "verseOrgIds": [
              "PSA.50.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 50:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndiunganidzirei vatsvene vangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.5",
            "verseOrgIds": [
              "PSA.50.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:5"
      },
      "items": [
        {
          "text": "vakaita sungano neni nechibayiro.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.5",
            "verseOrgIds": [
              "PSA.50.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 50:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye matenga anoparidza kururama kwake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.6",
            "verseOrgIds": [
              "PSA.50.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:6"
      },
      "items": [
        {
          "text": "nokuti Mwari amene ndiye mutongi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.6",
            "verseOrgIds": [
              "PSA.50.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sera",
              "type": "text",
              "attrs": {
                "verseId": "PSA.50.6",
                "verseOrgIds": [
                  "PSA.50.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 50:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Inzwai, imi vanhu vangu, uye ndichataura,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.7",
            "verseOrgIds": [
              "PSA.50.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:7"
      },
      "items": [
        {
          "text": "imi Israeri, uye ndichapupura pamusoro penyu:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.7",
            "verseOrgIds": [
              "PSA.50.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:7"
      },
      "items": [
        {
          "text": "Ndini Mwari, Mwari wenyu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.7",
            "verseOrgIds": [
              "PSA.50.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 50:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Handikutukei nokuda kwezvibayiro zvenyu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.8",
            "verseOrgIds": [
              "PSA.50.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:8"
      },
      "items": [
        {
          "text": "kana zvipiriso zvenyu zvinopiswa, zvinogara zviri pamberi pangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.8",
            "verseOrgIds": [
              "PSA.50.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 50:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Handisi kuda hando inobva mudanga rako,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.9",
            "verseOrgIds": [
              "PSA.50.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:9"
      },
      "items": [
        {
          "text": "kana mbudzi inobva muzvirugu zvako,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.9",
            "verseOrgIds": [
              "PSA.50.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 50:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti mhuka dzose dzesango ndedzangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.10",
            "verseOrgIds": [
              "PSA.50.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:10"
      },
      "items": [
        {
          "text": "nemombe pamakomo chiuru.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.10",
            "verseOrgIds": [
              "PSA.50.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 50:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinoziva shiri dzose dziri mumakomo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.11",
            "verseOrgIds": [
              "PSA.50.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:11"
      },
      "items": [
        {
          "text": "uye zvisikwa zvose zvesango ndezvangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.11",
            "verseOrgIds": [
              "PSA.50.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 50:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana dai ndaiva nenzara, handaikuudza iwe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.12",
            "verseOrgIds": [
              "PSA.50.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:12"
      },
      "items": [
        {
          "text": "nokuti nyika ndeyangu, nezvose zviri mairi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.12",
            "verseOrgIds": [
              "PSA.50.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 50:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, ndinodya nyama yehando",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.13",
            "verseOrgIds": [
              "PSA.50.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:13"
      },
      "items": [
        {
          "text": "kana kunwa ropa rembudzi here?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.13",
            "verseOrgIds": [
              "PSA.50.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 50:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bayirai zvibayiro zvokuvonga kuna Mwari,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.14",
            "verseOrgIds": [
              "PSA.50.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:14"
      },
      "items": [
        {
          "text": "zadzisai zvamakapikira Wokumusoro-soro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.14",
            "verseOrgIds": [
              "PSA.50.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 50:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye mudane kwandiri pazuva rokutambudzika;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.15",
            "verseOrgIds": [
              "PSA.50.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:15"
      },
      "items": [
        {
          "text": "ndichakurwirai, uye imi muchandikudza.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.15",
            "verseOrgIds": [
              "PSA.50.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 50:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kuna vakaipa, Mwari anoti:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.16",
            "verseOrgIds": [
              "PSA.50.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 50:16"
      },
      "items": [
        {
          "text": "\"Ko, une mvumo ipiko iwe yokuti ududzire mutemo wangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.16",
            "verseOrgIds": [
              "PSA.50.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:16"
      },
      "items": [
        {
          "text": "kana kuisa sungano yangu pamiromo yako?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.16",
            "verseOrgIds": [
              "PSA.50.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 50:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unovenga kurayira kwangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.17",
            "verseOrgIds": [
              "PSA.50.17"
            ]
          }
