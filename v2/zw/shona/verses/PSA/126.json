      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 126:3"
      },
      "items": [
        {
          "text": "uye tazara nomufaro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.3",
            "verseOrgIds": [
              "PSA.126.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
