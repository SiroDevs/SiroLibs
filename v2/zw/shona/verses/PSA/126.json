      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 126:4"
      },
      "items": [
        {
          "text": "sehova dzeNegevhi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.4",
            "verseOrgIds": [
              "PSA.126.4"
            ]
          }
        }
      ]
    },
