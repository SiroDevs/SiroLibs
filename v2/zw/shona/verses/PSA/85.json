  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "85",
        "style": "c",
        "sid": "PSA 85"
      },
      "items": [
        {
          "text": "85",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Pisarema 85",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kumutungamiri wokuimba waVanakomana vaKora. Pisarema.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 85:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makanzwira nyasha nyika yenyu, imi Jehovha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.1",
            "verseOrgIds": [
              "PSA.85.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 85:1"
      },
      "items": [
        {
          "text": "makadzosera Jakobho nhaka yake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.1",
            "verseOrgIds": [
              "PSA.85.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 85:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makakanganwira kutadza kwavanhu venyu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.2",
            "verseOrgIds": [
              "PSA.85.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 85:2"
      },
      "items": [
        {
          "text": "uye mukafukidza zvivi zvavo zvose.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.2",
            "verseOrgIds": [
              "PSA.85.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sera",
              "type": "text",
              "attrs": {
                "verseId": "PSA.85.2",
                "verseOrgIds": [
                  "PSA.85.3"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 85:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makaisa parutivi hasha dzenyu dzose,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.3",
            "verseOrgIds": [
              "PSA.85.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 85:3"
      },
      "items": [
        {
          "text": "mukadzoka pakutsamwa kwenyu kunotyisa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.3",
            "verseOrgIds": [
              "PSA.85.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 85:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tidzoreizve, imi Mwari Muponesi wedu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.4",
            "verseOrgIds": [
              "PSA.85.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 85:4"
      },
      "items": [
        {
          "text": "mugoisa kure nemi kusafara kwenyu pamusoro pedu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.4",
            "verseOrgIds": [
              "PSA.85.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 85:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mucharamba makatitsamwira nokusingaperi here?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.5",
            "verseOrgIds": [
              "PSA.85.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 85:5"
      },
      "items": [
        {
          "text": "Mucharega kutsamwa kwenyu kuripo kusvikira kuzvizvarwa zvose here?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.5",
            "verseOrgIds": [
              "PSA.85.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 85:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, hamungatimutsiridzizve here,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.6",
            "verseOrgIds": [
              "PSA.85.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 85:6"
      },
      "items": [
        {
          "text": "kuti vanhu venyu vagofara mamuri?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.6",
            "verseOrgIds": [
              "PSA.85.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 85:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiratidzei ngoni dzenyu, imi Jehovha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.7",
            "verseOrgIds": [
              "PSA.85.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 85:7"
      },
      "items": [
        {
          "text": "mugotipawo ruponeso rwenyu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.7",
            "verseOrgIds": [
              "PSA.85.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 85:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichateerera zvichataurwa naJehovha Mwari;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.8",
            "verseOrgIds": [
              "PSA.85.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 85:8"
      },
      "items": [
        {
          "text": "anovimbisa rugare kuvanhu vake, vatsvene vake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.8",
            "verseOrgIds": [
              "PSA.85.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 85:8"
      },
      "items": [
        {
          "text": "asi ngavasadzokerazve kuupenzi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.8",
            "verseOrgIds": [
              "PSA.85.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 85:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chokwadi, ruponeso rwake rwuri pedyo navanomutya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.9",
            "verseOrgIds": [
              "PSA.85.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 85:9"
      },
      "items": [
        {
          "text": "kuti kubwinya kwake kugogara munyika yedu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.9",
            "verseOrgIds": [
              "PSA.85.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 85:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rudo nokutendeka zvinosangana pamwe chete;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.10",
            "verseOrgIds": [
              "PSA.85.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 85:10"
      },
      "items": [
        {
          "text": "kururama norugare zvinosvetana.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.10",
            "verseOrgIds": [
              "PSA.85.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 85:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutendeka kunomera panyika,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.11",
            "verseOrgIds": [
              "PSA.85.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 85:11"
      },
      "items": [
        {
          "text": "kururama kunotarira pasi kuri kudenga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.11",
            "verseOrgIds": [
              "PSA.85.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 85:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chokwadi, Jehovha achapa zvinhu zvakanaka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.12",
            "verseOrgIds": [
              "PSA.85.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 85:12"
      },
      "items": [
        {
          "text": "uye nyika yedu ichabereka mukoho wayo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.12",
            "verseOrgIds": [
              "PSA.85.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 85:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kururama kuchamutungamirira,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.13",
            "verseOrgIds": [
              "PSA.85.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 85:13"
      },
      "items": [
        {
          "text": "uye kuchamugadzirira nzira yetsoka dzake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.13",
            "verseOrgIds": [
              "PSA.85.14"
            ]
          }
        }
      ]
    }
  ],
