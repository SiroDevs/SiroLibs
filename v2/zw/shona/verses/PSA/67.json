      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 67:4"
      },
      "items": [
        {
          "text": "nokuti munotonga marudzi nokururamisira,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.4",
            "verseOrgIds": [
              "PSA.67.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 67:4"
      },
      "items": [
        {
          "text": "uye munotungamirira ndudzi dzenyika.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.4",
            "verseOrgIds": [
              "PSA.67.5"
            ]
          }
        },
        {
          "name": "char",
