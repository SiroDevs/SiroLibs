      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 67:6"
      },
      "items": [
        {
          "text": "uye Mwari, Mwari wedu, achatiropafadza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.6",
            "verseOrgIds": [
              "PSA.67.7"
            ]
          }
        }
      ]
    },
