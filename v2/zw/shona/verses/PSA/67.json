          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo nyika ichabereka mukohwo wayo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.6",
            "verseOrgIds": [
              "PSA.67.7"
            ]
