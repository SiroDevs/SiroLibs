      },
      "items": [
        {
          "text": "86",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Pisarema 86",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Munyengetero waDhavhidhi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 86:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzwai, imi Jehovha, mundipindure,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.1",
            "verseOrgIds": [
              "PSA.86.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:1"
      },
      "items": [
        {
          "text": "nokuti ndiri murombo uye ndinoshayiwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.1",
            "verseOrgIds": [
              "PSA.86.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 86:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chengetai upenyu hwangu, nokuti ndakazvipa kwamuri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.2",
            "verseOrgIds": [
              "PSA.86.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:2"
      },
      "items": [
        {
          "text": "Muri Mwari wangu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.2",
            "verseOrgIds": [
              "PSA.86.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:2"
      },
      "items": [
        {
          "text": "ponesai muranda wenyu anovimba nemi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.2",
            "verseOrgIds": [
              "PSA.86.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 86:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinzwirei ngoni, imi Ishe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.3",
            "verseOrgIds": [
              "PSA.86.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:3"
      },
      "items": [
        {
          "text": "nokuti ndinodana kwamuri zuva rose.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.3",
            "verseOrgIds": [
              "PSA.86.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 86:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vigirai muranda wenyu mufaro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.4",
            "verseOrgIds": [
              "PSA.86.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:4"
      },
      "items": [
        {
          "text": "nokuti kwamuri, imi Ishe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.4",
            "verseOrgIds": [
              "PSA.86.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:4"
      },
      "items": [
        {
          "text": "ndinosimudzira mweya wangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.4",
            "verseOrgIds": [
              "PSA.86.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 86:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imi munokanganwira uye makanaka, imi Ishe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.5",
            "verseOrgIds": [
              "PSA.86.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:5"
      },
      "items": [
        {
          "text": "muzere norudo kuna vose vanodana kwamuri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.5",
            "verseOrgIds": [
              "PSA.86.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 86:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzwai munyengetero wangu, imi Jehovha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.6",
            "verseOrgIds": [
              "PSA.86.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:6"
      },
      "items": [
        {
          "text": "inzwai kuchemera kwangu ngoni dzenyu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.6",
            "verseOrgIds": [
              "PSA.86.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 86:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichadana kwamuri pazuva rokutambudzika kwangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.7",
            "verseOrgIds": [
              "PSA.86.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:7"
      },
      "items": [
        {
          "text": "nokuti muchandipindura.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.7",
            "verseOrgIds": [
              "PSA.86.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 86:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa Ishe, hakuna akafanana nemi pakati pavamwari;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.8",
            "verseOrgIds": [
              "PSA.86.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:8"
      },
      "items": [
        {
          "text": "hakuna mabasa akaita seenyu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.8",
            "verseOrgIds": [
              "PSA.86.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 86:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndudzi dzose dzamakaita dzichauya",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.9",
            "verseOrgIds": [
              "PSA.86.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:9"
      },
      "items": [
        {
          "text": "kuzonamata pamberi penyu, imi Ishe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.9",
            "verseOrgIds": [
              "PSA.86.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:9"
      },
      "items": [
        {
          "text": "dzicharumbidza zita renyu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.9",
            "verseOrgIds": [
              "PSA.86.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 86:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti imi muri mukuru uye munoita zvinhu zvinoshamisa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.10",
            "verseOrgIds": [
              "PSA.86.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:10"
      },
      "items": [
        {
          "text": "imi moga ndimi Mwari.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.10",
            "verseOrgIds": [
              "PSA.86.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 86:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa Jehovha, ndidzidzisei nzira yenyu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.11",
            "verseOrgIds": [
              "PSA.86.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:11"
      },
      "items": [
        {
          "text": "uye ndichafamba muzvokwadi yenyu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.11",
            "verseOrgIds": [
              "PSA.86.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 86:11"
      },
      "items": [
        {
          "text": "ndipei mwoyo mumwe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.11",
            "verseOrgIds": [
              "PSA.86.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:11"
      },
      "items": [
        {
          "text": "kuti ndigotya zita renyu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.11",
            "verseOrgIds": [
              "PSA.86.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 86:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichakurumbidzai, imi Ishe Mwari wangu, nomwoyo wangu wose;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.12",
            "verseOrgIds": [
              "PSA.86.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:12"
      },
      "items": [
        {
          "text": "ndicharumbidza zita renyu nokusingaperi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.12",
            "verseOrgIds": [
              "PSA.86.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 86:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti rudo rwenyu rukuru kwandiri;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.13",
            "verseOrgIds": [
              "PSA.86.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:13"
      },
      "items": [
        {
          "text": "makandirwira paguva rakadzika.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.13",
            "verseOrgIds": [
              "PSA.86.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 86:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa Mwari, vanozvikudza vari kundirwisa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.14",
            "verseOrgIds": [
              "PSA.86.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:14"
      },
      "items": [
        {
          "text": "boka ravanhu vane utsinye rinotsvaka upenyu hwangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.14",
            "verseOrgIds": [
              "PSA.86.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:14"
      },
      "items": [
        {
          "text": "vanhu vasina hanya nemi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.14",
            "verseOrgIds": [
              "PSA.86.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 86:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi, imi Ishe, mune tsitsi uye muri Mwari ane nyasha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.15",
            "verseOrgIds": [
              "PSA.86.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:15"
      },
      "items": [
        {
          "text": "anononoka kutsamwa, azere norudo nokutendeka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.15",
            "verseOrgIds": [
              "PSA.86.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 86:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dzokerai kwandiri mundinzwire ngoni;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.16",
            "verseOrgIds": [
              "PSA.86.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:16"
      },
      "items": [
        {
          "text": "ipai simba renyu kumuranda wenyu,",
