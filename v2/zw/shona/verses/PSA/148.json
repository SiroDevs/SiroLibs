          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rumbidzai Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.1",
            "verseOrgIds": [
              "PSA.148.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 148:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 148:1"
      },
      "items": [
        {
          "text": "Rumbidzai Jehovha kubva kumatenga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.1",
            "verseOrgIds": [
              "PSA.148.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:1"
      },
      "items": [
        {
          "text": "murumbidzei panzvimbo dzokumusoro-soro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.1",
            "verseOrgIds": [
              "PSA.148.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 148:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murumbidzei, imi vatumwa vake vose,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.2",
            "verseOrgIds": [
              "PSA.148.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:2"
      },
      "items": [
        {
          "text": "murumbidzei, imi hondo dzake dzose dzokudenga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.2",
            "verseOrgIds": [
              "PSA.148.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 148:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murumbidzei, imi zuva nomwedzi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.3",
            "verseOrgIds": [
              "PSA.148.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:3"
      },
      "items": [
        {
          "text": "murumbidzei, imi nyeredzi dzose dzinopenya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.3",
            "verseOrgIds": [
              "PSA.148.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 148:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murumbidzei, imi matenga ari kumusoro-soro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.4",
            "verseOrgIds": [
              "PSA.148.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:4"
      },
      "items": [
        {
          "text": "nemi mvura zhinji iri pamusoro pamatenga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.4",
            "verseOrgIds": [
              "PSA.148.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 148:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngazvirumbidze zita raJehovha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.5",
            "verseOrgIds": [
              "PSA.148.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:5"
      },
      "items": [
        {
          "text": "nokuti akarayira, izvo zvikasikwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.5",
            "verseOrgIds": [
              "PSA.148.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 148:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akazviisa panzvimbo yazvo nokusingaperi-peri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.6",
            "verseOrgIds": [
              "PSA.148.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:6"
      },
      "items": [
        {
          "text": "akapa chirevo chisingazombopfuuri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.6",
            "verseOrgIds": [
              "PSA.148.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 148:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rumbidzai Jehovha imi nyika,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.7",
            "verseOrgIds": [
              "PSA.148.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:7"
      },
      "items": [
        {
          "text": "imi zvisikwa zvikuru zvegungwa nokwakadzika kwenyanza,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.7",
            "verseOrgIds": [
              "PSA.148.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 148:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "nemi mheni nechimvuramabwe, chando namakore,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.8",
            "verseOrgIds": [
              "PSA.148.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:8"
      },
      "items": [
        {
          "text": "dutu remhepo rinoita zvaakareva,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.8",
            "verseOrgIds": [
              "PSA.148.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 148:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "imi makomo nemi zvikomo zvose,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.9",
            "verseOrgIds": [
              "PSA.148.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:9"
      },
      "items": [
        {
          "text": "miti inobereka nemisidhari yose,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.9",
            "verseOrgIds": [
              "PSA.148.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 148:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "mhuka dzesango nemombe dzose,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.10",
            "verseOrgIds": [
              "PSA.148.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:10"
      },
      "items": [
        {
          "text": "zvisikwa zvidiki neshiri dzinobhururuka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.10",
            "verseOrgIds": [
              "PSA.148.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 148:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Madzimambo enyika nendudzi dzose,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.11",
            "verseOrgIds": [
              "PSA.148.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:11"
      },
      "items": [
        {
          "text": "imi machinda nemi vatongi vose panyika,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.11",
            "verseOrgIds": [
              "PSA.148.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 148:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "majaya nemhandara,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.12",
            "verseOrgIds": [
              "PSA.148.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:12"
      },
      "items": [
        {
          "text": "vatana navana.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.12",
            "verseOrgIds": [
              "PSA.148.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 148:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngavarumbidze zita raJehovha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.13",
            "verseOrgIds": [
              "PSA.148.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:13"
      },
      "items": [
        {
          "text": "nokuti zita rake iye oga iguru;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.13",
            "verseOrgIds": [
              "PSA.148.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:13"
      },
      "items": [
        {
          "text": "kubwinya kwake kuri pamusoro penyika namatenga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.13",
            "verseOrgIds": [
              "PSA.148.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 148:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akasimudzira vanhu vake runyanga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.14",
            "verseOrgIds": [
              "PSA.148.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:14"
      },
      "items": [
        {
          "text": "iyo rumbidzo yavatsvene vake vose,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.14",
            "verseOrgIds": [
              "PSA.148.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:14"
      },
      "items": [
        {
          "text": "yaIsraeri, vanhu vari pedyo nomwoyo wake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.14",
            "verseOrgIds": [
              "PSA.148.14"
            ]
          }
        }
      ]
    },
