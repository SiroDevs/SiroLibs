          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 139:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dai ndaiverenga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.18",
            "verseOrgIds": [
              "PSA.139.18"
            ]
          }
        }
      ]
    },
