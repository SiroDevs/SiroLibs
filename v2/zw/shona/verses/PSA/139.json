          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dai mukangouraya vakaipa, imi Mwari!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.19",
            "verseOrgIds": [
              "PSA.139.19"
            ]
          }
        }
      ]
    },
