      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:22"
      },
      "items": [
        {
          "text": "ndinovati vavengi vangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.22",
            "verseOrgIds": [
              "PSA.139.22"
            ]
          }
        }
      ]
