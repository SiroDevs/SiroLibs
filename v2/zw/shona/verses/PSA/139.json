          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, ini handivengi vanokuvengai here, imi Jehovha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.21",
            "verseOrgIds": [
              "PSA.139.21"
            ]
          }
        }
      ]
