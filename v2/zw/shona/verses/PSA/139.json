          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mirangariro yenyu inokosha sei kwandiri, imi Mwari!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.17",
            "verseOrgIds": [
              "PSA.139.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:17"
      },
      "items": [
        {
          "text": "Yakakura sei pakuverengwa kwayo!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.17",
            "verseOrgIds": [
              "PSA.139.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
