          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Handina chimwe chinhu asi kuvavenga ivo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.22",
            "verseOrgIds": [
              "PSA.139.22"
            ]
          }
        }
