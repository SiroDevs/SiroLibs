      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:18"
      },
      "items": [
        {
          "text": "ingadai yaikunda tsanga dzejecha pakuwanda.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.18",
            "verseOrgIds": [
              "PSA.139.18"
            ]
          }
        }
      ]
    },
