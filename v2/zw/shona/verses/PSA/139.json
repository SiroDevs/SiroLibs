          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivo vanotaura nemi nomurangariro wakaipa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.20",
            "verseOrgIds": [
              "PSA.139.20"
            ]
          }
        }
      ]
