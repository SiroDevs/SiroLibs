      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:19"
      },
      "items": [
        {
          "text": "Endai kure neni, imi vanhu vokuteura ropa!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.19",
            "verseOrgIds": [
              "PSA.139.19"
            ]
          }
        }
      ]
    },
    {
