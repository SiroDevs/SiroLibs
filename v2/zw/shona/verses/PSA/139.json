      "attrs": {
        "style": "q2",
        "vid": "PSA 139:21"
      },
      "items": [
        {
          "text": "nokusema vaya vanokumukirai?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.21",
            "verseOrgIds": [
              "PSA.139.21"
            ]
          }
        }
      ]
    },
