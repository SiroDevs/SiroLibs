      "attrs": {
        "style": "q2",
        "vid": "PSA 139:20"
      },
      "items": [
        {
          "text": "vadzivisi venyu vanoshandisa zita renyu zvakaipa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.20",
            "verseOrgIds": [
              "PSA.139.20"
            ]
          }
        }
      ]
    },
