      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 139:18"
      },
      "items": [
        {
          "text": "Pandinopepuka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.18",
            "verseOrgIds": [
              "PSA.139.18"
            ]
          }
        }
      ]
    },
