        {
          "text": "Pisarema 80",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kumutungamiri wokuimba nomuimbiro wa \"Maruva amahapa eSungano.\" Pisarema raAsafi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 80:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinzwei, imi Mufudzi weIsraeri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.1",
            "verseOrgIds": [
              "PSA.80.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:1"
      },
      "items": [
        {
          "text": "imi makatungamirira Josefa seboka ramakwai;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.1",
            "verseOrgIds": [
              "PSA.80.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 80:1"
      },
      "items": [
        {
          "text": "iyemi munogara pachigaro choushe pakati pamakerubhi, penyai",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.1",
            "verseOrgIds": [
              "PSA.80.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 80:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamberi paEfuremu, Bhenjamini naManase.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.2",
            "verseOrgIds": [
              "PSA.80.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 80:2"
      },
      "items": [
        {
          "text": "Mutsai simba renyu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.2",
            "verseOrgIds": [
              "PSA.80.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:2"
      },
      "items": [
        {
          "text": "uyai mutiponese.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.2",
            "verseOrgIds": [
              "PSA.80.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 80:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tidzorei, imi Mwari,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.3",
            "verseOrgIds": [
              "PSA.80.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:3"
      },
      "items": [
        {
          "text": "penyesai chiso chenyu pamusoro pedu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.3",
            "verseOrgIds": [
              "PSA.80.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:3"
      },
      "items": [
        {
          "text": "kuti tiponeswe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.3",
            "verseOrgIds": [
              "PSA.80.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 80:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa Jehovha Mwari Wamasimba Ose,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.4",
            "verseOrgIds": [
              "PSA.80.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:4"
      },
      "items": [
        {
          "text": "kutsamwa kwenyu kucharamba kuchipisa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.4",
            "verseOrgIds": [
              "PSA.80.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:4"
      },
      "items": [
        {
          "text": "pamusoro peminyengetero yavanhu venyu kusvikira riniko?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.4",
            "verseOrgIds": [
              "PSA.80.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 80:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makavapa chingwa chemisodzi kuti vadye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.5",
            "verseOrgIds": [
              "PSA.80.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:5"
      },
      "items": [
        {
          "text": "makaita kuti vanwe misodzi yakawanda.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.5",
            "verseOrgIds": [
              "PSA.80.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 80:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makatiita mavambo enharo kuna vatigere navo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.6",
            "verseOrgIds": [
              "PSA.80.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:6"
      },
      "items": [
        {
          "text": "uye vavengi vedu vanotiseka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.6",
            "verseOrgIds": [
              "PSA.80.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
