      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:7"
      },
      "items": [
        {
          "text": "penyesai chiso chenyu pamusoro pedu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.7",
            "verseOrgIds": [
              "PSA.80.8"
            ]
          }
        }
      ]
    },
