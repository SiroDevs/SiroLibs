  "verseCount": 10,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "141",
        "style": "c",
        "sid": "PSA 141"
      },
      "items": [
        {
          "text": "141",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Pisarema 141",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Pisarema raDhavhidhi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 141:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa Jehovha, ndinodana kwamuri; kurumidzai kuuya kwandiri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.1",
            "verseOrgIds": [
              "PSA.141.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:1"
      },
      "items": [
        {
          "text": "Inzwai inzwi rangu pandinodana kwamuri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.1",
            "verseOrgIds": [
              "PSA.141.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 141:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyengetero wangu ngauiswe pamberi penyu sezvinonhuhwira;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.2",
            "verseOrgIds": [
              "PSA.141.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:2"
      },
      "items": [
        {
          "text": "kusimudzwa kwamaoko angu ngakuite sechibayiro chamadekwana.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.2",
            "verseOrgIds": [
              "PSA.141.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 141:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isai murindi pamuromo wangu, imi Jehovha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.3",
            "verseOrgIds": [
              "PSA.141.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:3"
      },
      "items": [
        {
          "text": "chengetai mukova wemiromo yangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.3",
            "verseOrgIds": [
              "PSA.141.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 141:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwoyo wangu ngaurege kukweverwa kune zvakaipa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.4",
            "verseOrgIds": [
              "PSA.141.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:4"
      },
      "items": [
        {
          "text": "kuti ndiitewo mabasa akaipa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.4",
            "verseOrgIds": [
              "PSA.141.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 141:4"
      },
      "items": [
        {
          "text": "navanhu vanoita zvakaipa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.4",
            "verseOrgIds": [
              "PSA.141.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:4"
      },
      "items": [
        {
          "text": "ngandirege kudya zvinozipa zvavo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.4",
            "verseOrgIds": [
              "PSA.141.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 141:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akarurama ngaandirove, ndidzo tsitsi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.5",
            "verseOrgIds": [
              "PSA.141.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:5"
      },
      "items": [
        {
          "text": "ngaanditsiure, ndiwo mafuta pamusoro wangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.5",
            "verseOrgIds": [
              "PSA.141.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:5"
      },
      "items": [
        {
          "text": "Musoro wangu hauzorambi izvozvo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.5",
            "verseOrgIds": [
              "PSA.141.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 141:5"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 141:5"
      },
      "items": [
        {
          "text": "Asi munyengetero wangu unorwisa mabasa avaiti vezvakaipa nguva dzose.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.5",
            "verseOrgIds": [
              "PSA.141.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 141:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vatongi vavo vachakandwa kumawere,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.6",
            "verseOrgIds": [
              "PSA.141.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:6"
      },
      "items": [
        {
          "text": "uye vakaipa vachadzidza kuti mashoko angu akanga akanaka kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.6",
            "verseOrgIds": [
              "PSA.141.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 141:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivo vachati, \"Sezvinoita anorima achiparura pasi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.7",
            "verseOrgIds": [
              "PSA.141.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:7"
      },
      "items": [
        {
          "text": "saizvozvo mapfupa edu akaparadzirwa pamuromo weguva.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.7",
            "verseOrgIds": [
              "PSA.141.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 141:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi meso angu anotarira kwamuri, imi Ishe Jehovha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.8",
            "verseOrgIds": [
              "PSA.141.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:8"
      },
      "items": [
        {
          "text": "ndinotizira kwamuri, regai kundiisa kurufu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.8",
            "verseOrgIds": [
              "PSA.141.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 141:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichengetei pamisungo yavakanditeya nayo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.9",
            "verseOrgIds": [
              "PSA.141.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:9"
      },
      "items": [
        {
          "text": "napaugombe hwakadzikwa navaiti vezvakaipa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.9",
            "verseOrgIds": [
              "PSA.141.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 141:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakaipa ngavawire mumimbure yavo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.10",
            "verseOrgIds": [
              "PSA.141.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:10"
      },
      "items": [
        {
          "text": "ini ndichipfuura napo norugare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.10",
            "verseOrgIds": [
              "PSA.141.10"
            ]
          }
        }
      ]
    }
  ],
