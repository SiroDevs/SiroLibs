        {
          "text": "Pisarema 42",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kumutungamiri wokuimba. Rwiyo rweMasikiri rwaVanakomana vaKora.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 42:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Senondo inodokwairira hova dzemvura,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.1",
            "verseOrgIds": [
              "PSA.42.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:1"
      },
      "items": [
        {
          "text": "saizvozvo mweya wangu unodokwairirai, imi Mwari.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.1",
            "verseOrgIds": [
              "PSA.42.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 42:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mweya wangu une nyota kuna Mwari, nyota yaMwari mupenyu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.2",
            "verseOrgIds": [
              "PSA.42.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:2"
      },
      "items": [
        {
          "text": "Ndingaenda riniko kundosangana naMwari?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.2",
            "verseOrgIds": [
              "PSA.42.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 42:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Misodzi yangu yanga iri zvokudya zvangu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.3",
            "verseOrgIds": [
              "PSA.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:3"
      },
      "items": [
        {
          "text": "masikati nousiku,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.3",
            "verseOrgIds": [
              "PSA.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 42:3"
      },
      "items": [
        {
          "text": "asi zuva rose vanhu vanoti kwandiri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.3",
            "verseOrgIds": [
              "PSA.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:3"
      },
      "items": [
        {
          "text": "\"Mwari wako aripiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.3",
            "verseOrgIds": [
              "PSA.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 42:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinorangarira zvinhu izvi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.4",
            "verseOrgIds": [
              "PSA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:4"
      },
      "items": [
        {
          "text": "pandinodurura mweya wangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.4",
            "verseOrgIds": [
              "PSA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 42:4"
      },
      "items": [
        {
          "text": "mafambiro andaiita navazhinji",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.4",
            "verseOrgIds": [
              "PSA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:4"
      },
      "items": [
        {
          "text": "ndichitungamirira mudungwe wavanhu kuimba yaMwari,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.4",
            "verseOrgIds": [
              "PSA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 42:4"
      },
      "items": [
        {
          "text": "nokupembera nomufaro uye nokuvonga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.4",
            "verseOrgIds": [
              "PSA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:4"
      },
      "items": [
        {
          "text": "pakati pavazhinji pamutambo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.4",
            "verseOrgIds": [
              "PSA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 42:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakasuwireiko, nhai mweya wangu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.5",
            "verseOrgIds": [
              "PSA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:5"
      },
      "items": [
        {
          "text": "Unotambudzwa neiko mukati mangu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.5",
            "verseOrgIds": [
              "PSA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 42:5"
      },
      "items": [
        {
          "text": "Isa tariro yako muna Mwari,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.5",
            "verseOrgIds": [
              "PSA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:5"
      },
      "items": [
        {
          "text": "nokuti ndichamurumbidzazve,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.5",
            "verseOrgIds": [
              "PSA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:5"
      },
      "items": [
        {
          "text": "Muponesi wangu naMwari wangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.5",
            "verseOrgIds": [
              "PSA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 42:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mweya wangu wakaneta mukati mangu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.6",
            "verseOrgIds": [
              "PSA.42.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:6"
      },
      "items": [
        {
          "text": "naizvozvo ndichakurangarirai",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.6",
            "verseOrgIds": [
              "PSA.42.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 42:6"
      },
      "items": [
        {
          "text": "ndiri kunyika yeJorodhani,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.6",
            "verseOrgIds": [
              "PSA.42.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:6"
      },
      "items": [
        {
          "text": "pamatunhu akakwirira eHeremoni, kubva paGomo reMizari.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.6",
            "verseOrgIds": [
              "PSA.42.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 42:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakadzika panodana pakadzika",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.7",
            "verseOrgIds": [
              "PSA.42.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:7"
      },
      "items": [
        {
          "text": "mukutinhira kwamapopopo emvura;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.7",
            "verseOrgIds": [
              "PSA.42.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 42:7"
      },
      "items": [
        {
          "text": "mafungu enyu ose namafashamu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.7",
            "verseOrgIds": [
              "PSA.42.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:7"
      },
      "items": [
        {
          "text": "akapfuura napamusoro pangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.7",
            "verseOrgIds": [
              "PSA.42.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masikati, Jehovha anorayira rudo rwake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.8",
            "verseOrgIds": [
              "PSA.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:8"
      },
      "items": [
        {
          "text": "pausiku rwiyo rwake runeni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.8",
            "verseOrgIds": [
              "PSA.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:8"
      },
      "items": [
        {
          "text": "munyengetero kuna Mwari woupenyu hwangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.8",
            "verseOrgIds": [
              "PSA.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinoti kuna Mwari Dombo rangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.9",
            "verseOrgIds": [
              "PSA.42.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:9"
      },
      "items": [
        {
          "text": "\"Mandikanganwireiko?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.9",
            "verseOrgIds": [
              "PSA.42.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 42:9"
      },
      "items": [
        {
          "text": "Ndinofambireiko ndichichema",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.9",
            "verseOrgIds": [
              "PSA.42.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:9"
      },
      "items": [
        {
          "text": "ndakadzvinyirirwa nomuvengi?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.9",
            "verseOrgIds": [
              "PSA.42.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 42:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mapfupa angu atambura nokurwadza kworufu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.10",
            "verseOrgIds": [
              "PSA.42.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:10"
      },
      "items": [
        {
          "text": "sezvo vavengi vangu vachindizvidza",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.10",
            "verseOrgIds": [
              "PSA.42.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 42:10"
      },
      "items": [
        {
          "text": "zuva rose vachiti kwandiri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.10",
            "verseOrgIds": [
              "PSA.42.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:10"
      },
      "items": [
        {
          "text": "\"Mwari wako aripiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.10",
            "verseOrgIds": [
              "PSA.42.11"
            ]
          }
        }
      ]
    },
