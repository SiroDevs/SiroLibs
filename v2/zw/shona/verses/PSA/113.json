          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rumbidzai Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.1",
            "verseOrgIds": [
              "PSA.113.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 113:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 113:1"
      },
      "items": [
        {
          "text": "Rumbidzai, imi varanda vaJehovha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.1",
            "verseOrgIds": [
              "PSA.113.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 113:1"
      },
      "items": [
        {
          "text": "rumbidzai zita raJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.1",
            "verseOrgIds": [
              "PSA.113.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 113:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zita raJehovha ngarirumbidzwe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.2",
            "verseOrgIds": [
              "PSA.113.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 113:2"
      },
      "items": [
        {
          "text": "kubva zvino kusvikira narini.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.2",
            "verseOrgIds": [
              "PSA.113.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 113:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubva pakubuda kwezuva kusvikira pakuvira kwaro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.3",
            "verseOrgIds": [
              "PSA.113.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 113:3"
      },
      "items": [
        {
          "text": "zita raJehovha rinofanira kurumbidzwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.3",
            "verseOrgIds": [
              "PSA.113.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 113:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha anosimudzirwa pamusoro pendudzi dzose;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.4",
            "verseOrgIds": [
              "PSA.113.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 113:4"
      },
      "items": [
        {
          "text": "kubwinya kwake kuri pamusoro pamatenga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.4",
            "verseOrgIds": [
              "PSA.113.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 113:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndianiko akaita saJehovha Mwari wedu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.5",
            "verseOrgIds": [
              "PSA.113.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 113:5"
      },
      "items": [
        {
          "text": "iye anogara pachigaro choushe chokumusoro-soro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.5",
            "verseOrgIds": [
              "PSA.113.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 113:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "anokotamira pasi kuti aone",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.6",
            "verseOrgIds": [
              "PSA.113.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 113:6"
      },
      "items": [
        {
          "text": "zviri kudenga napanyika?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.6",
            "verseOrgIds": [
              "PSA.113.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 113:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anosimudza murombo kubva muguruva,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.7",
            "verseOrgIds": [
              "PSA.113.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 113:7"
      },
      "items": [
        {
          "text": "uye anosimudza vanoshayiwa kubva padurunhuru ramadota;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.7",
            "verseOrgIds": [
              "PSA.113.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 113:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "anovagadza namachinda,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.8",
            "verseOrgIds": [
              "PSA.113.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 113:8"
      },
      "items": [
        {
          "text": "namachinda avanhu vavo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.8",
            "verseOrgIds": [
              "PSA.113.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 113:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anogarisa mukadzi asingabereki mumba make,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.9",
            "verseOrgIds": [
              "PSA.113.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 113:9"
      },
      "items": [
        {
          "text": "samai vavana vanofara.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.9",
            "verseOrgIds": [
              "PSA.113.9"
            ]
          }
        }
      ]
    },
