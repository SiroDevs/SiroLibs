    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 147:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rumbidzai Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.1",
            "verseOrgIds": [
              "PSA.147.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 147:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 147:1"
      },
      "items": [
        {
          "text": "Zvakanaka sei kuimbira Mwari wedu nziyo dzokurumbidza,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.1",
            "verseOrgIds": [
              "PSA.147.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:1"
      },
      "items": [
        {
          "text": "zvinofadza uye zvakafanira sei kumurumbidza!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.1",
            "verseOrgIds": [
              "PSA.147.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 147:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha anovaka Jerusarema;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.2",
            "verseOrgIds": [
              "PSA.147.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:2"
      },
      "items": [
        {
          "text": "anounganidza vakadzingwa vaIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.2",
            "verseOrgIds": [
              "PSA.147.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 147:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anoporesa vane mwoyo yakaputsika,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.3",
            "verseOrgIds": [
              "PSA.147.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:3"
      },
      "items": [
        {
          "text": "uye anosunga maronda avo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.3",
            "verseOrgIds": [
              "PSA.147.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 147:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anotara kuwanda kwenyeredzi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.4",
            "verseOrgIds": [
              "PSA.147.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:4"
      },
      "items": [
        {
          "text": "anodana imwe neimwe nezita rayo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.4",
            "verseOrgIds": [
              "PSA.147.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 147:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishe wedu mukuru uye ane simba guru;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.5",
            "verseOrgIds": [
              "PSA.147.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:5"
      },
      "items": [
        {
          "text": "kunzwisisa kwake hakuperi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.5",
            "verseOrgIds": [
              "PSA.147.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 147:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha anotsigira vanozvininipisa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.6",
            "verseOrgIds": [
              "PSA.147.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:6"
      },
      "items": [
        {
          "text": "asi anowisira pasi vakaipa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.6",
            "verseOrgIds": [
              "PSA.147.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 147:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbirai Jehovha nokuvonga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.7",
            "verseOrgIds": [
              "PSA.147.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:7"
      },
      "items": [
        {
          "text": "muimbire Mwari wedu nziyo dzokurumbidza nembira.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.7",
            "verseOrgIds": [
              "PSA.147.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 147:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anofukidza denga namakore;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.8",
            "verseOrgIds": [
              "PSA.147.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:8"
      },
      "items": [
        {
          "text": "anopa nyika mvura,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.8",
            "verseOrgIds": [
              "PSA.147.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:8"
      },
      "items": [
        {
          "text": "uye anomeresa uswa pazvikomo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.8",
            "verseOrgIds": [
              "PSA.147.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 147:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anopa mombe zvokudya",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.9",
            "verseOrgIds": [
              "PSA.147.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:9"
      },
      "items": [
        {
          "text": "navana vamakunguo pavanochema.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.9",
            "verseOrgIds": [
              "PSA.147.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 147:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mufaro wake hausi musimba rebhiza,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.10",
            "verseOrgIds": [
              "PSA.147.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:10"
      },
      "items": [
        {
          "text": "uye mufaro wake hausi pamakumbo omunhu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.10",
            "verseOrgIds": [
              "PSA.147.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 147:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha anofadzwa naavo vanomutya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.11",
            "verseOrgIds": [
              "PSA.147.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:11"
      },
      "items": [
        {
          "text": "vanoisa tariro yavo parudo rwake rusingaperi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.11",
            "verseOrgIds": [
              "PSA.147.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 147:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kudza Jehovha, iwe Jerusarema;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.12",
            "verseOrgIds": [
              "PSA.147.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:12"
      },
      "items": [
        {
          "text": "rumbidza Mwari wako, iwe Zioni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.12",
            "verseOrgIds": [
              "PSA.147.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 147:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti anosimbisa mazariro amasuo ako,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.13",
            "verseOrgIds": [
              "PSA.147.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:13"
      },
      "items": [
        {
          "text": "uye anoropafadza vanhu vako vari mauri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.13",
            "verseOrgIds": [
              "PSA.147.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 147:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anopa rugare pamiganhu yako,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.14",
            "verseOrgIds": [
              "PSA.147.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:14"
      },
      "items": [
        {
          "text": "uye anokugutsa nezviyo zvakaisvonaka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.14",
            "verseOrgIds": [
              "PSA.147.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 147:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anotuma murayiro wake kunyika;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.15",
            "verseOrgIds": [
              "PSA.147.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:15"
      },
      "items": [
        {
          "text": "shoko rake rinomhanya kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.15",
            "verseOrgIds": [
              "PSA.147.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 147:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anowarira chando samakushe amakwai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.16",
            "verseOrgIds": [
              "PSA.147.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:16"
      },
      "items": [
        {
          "text": "uye anoparadzira chando samadota.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.16",
            "verseOrgIds": [
              "PSA.147.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 147:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anokanda chimvuramabwe pasi sezvimedu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.17",
            "verseOrgIds": [
              "PSA.147.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:17"
      },
      "items": [
        {
          "text": "Ndianiko angamira kana chando chake charova?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.17",
            "verseOrgIds": [
              "PSA.147.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 147:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
