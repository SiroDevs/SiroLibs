      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Pisarema 96",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 96:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbirai Jehovha rwiyo rutsva;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.1",
            "verseOrgIds": [
              "PSA.96.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 96:1"
      },
      "items": [
        {
          "text": "imbirai Jehovha, nyika yose.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.1",
            "verseOrgIds": [
              "PSA.96.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 96:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbirai Jehovha, rumbidzai zita rake;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.2",
            "verseOrgIds": [
              "PSA.96.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 96:2"
      },
      "items": [
        {
          "text": "paridzai ruponeso rwake zuva nezuva.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.2",
            "verseOrgIds": [
              "PSA.96.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 96:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paridzai kubwinya kwake pakati pendudzi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.3",
            "verseOrgIds": [
              "PSA.96.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 96:3"
      },
      "items": [
        {
          "text": "namabasa ake anoshamisa pakati pamarudzi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.3",
            "verseOrgIds": [
              "PSA.96.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 96:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti Jehovha mukuru uye anofanira kurumbidzwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.4",
            "verseOrgIds": [
              "PSA.96.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 96:4"
      },
      "items": [
        {
          "text": "iye anofanira kutyiwa pamusoro pavamwari vose.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.4",
            "verseOrgIds": [
              "PSA.96.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 96:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti vamwari vose vendudzi zvifananidzo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.5",
            "verseOrgIds": [
              "PSA.96.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 96:5"
      },
      "items": [
        {
          "text": "asi Jehovha akaita matenga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.5",
            "verseOrgIds": [
              "PSA.96.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 96:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubwinya noumambo zviri pamberi pake;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.6",
            "verseOrgIds": [
              "PSA.96.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 96:6"
      },
      "items": [
        {
          "text": "simba nokubwinya zviri munzvimbo yake tsvene.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.6",
            "verseOrgIds": [
              "PSA.96.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 96:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Remekedzai Jehovha, imi ndudzi dzose,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.7",
            "verseOrgIds": [
              "PSA.96.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 96:7"
      },
      "items": [
        {
          "text": "ipai rukudzo nesimba kuna Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.7",
            "verseOrgIds": [
              "PSA.96.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 96:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipai kuna Jehovha rukudzo rwakafanira zita rake;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.8",
            "verseOrgIds": [
              "PSA.96.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 96:8"
      },
      "items": [
        {
          "text": "uyai nechipiriso mugopinda pavanze dzake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.8",
            "verseOrgIds": [
              "PSA.96.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 96:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namatai Jehovha mukubwinya kwoutsvene hwake;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.9",
            "verseOrgIds": [
              "PSA.96.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 96:9"
      },
      "items": [
        {
          "text": "dederai pamberi pake, imi nyika dzose.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.9",
            "verseOrgIds": [
              "PSA.96.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 96:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muti pakati pendudzi, \"Jehovha ndiye anobata ushe.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.10",
            "verseOrgIds": [
              "PSA.96.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 96:10"
      },
      "items": [
        {
          "text": "Nyika yakanyatsosimbiswa, haingazungunuswi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.10",
            "verseOrgIds": [
              "PSA.96.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 96:10"
      },
      "items": [
        {
          "text": "uye achatonga marudzi nokururama.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.10",
            "verseOrgIds": [
              "PSA.96.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 96:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kudenga denga ngakufare, nyika ngaifarisise;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.11",
            "verseOrgIds": [
              "PSA.96.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 96:11"
      },
      "items": [
        {
          "text": "gungwa ngaritinhire, nezvose zviri mariri;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.11",
            "verseOrgIds": [
              "PSA.96.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 96:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "masango ngaafare, nezvose zviri maari.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.12",
            "verseOrgIds": [
              "PSA.96.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 96:12"
      },
      "items": [
        {
          "text": "Ipapo miti yose yesango ichaimba nomufaro;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.12",
            "verseOrgIds": [
              "PSA.96.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 96:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ichaimba pamberi paJehovha, nokuti anouya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.13",
            "verseOrgIds": [
              "PSA.96.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 96:13"
      },
      "items": [
        {
          "text": "anouya kuzotonga nyika.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.13",
            "verseOrgIds": [
              "PSA.96.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 96:13"
      },
      "items": [
        {
          "text": "Achatonga nyika nokururama,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.13",
            "verseOrgIds": [
              "PSA.96.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 96:13"
      },
      "items": [
        {
          "text": "uye vanhu nechokwadi chake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.13",
            "verseOrgIds": [
              "PSA.96.13"
            ]
          }
        }
      ]
    }
  ],
