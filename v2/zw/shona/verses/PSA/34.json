  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "34",
        "style": "c",
        "sid": "PSA 34"
      },
      "items": [
        {
          "text": "34",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Pisarema 34",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Pisarema raDhavhidhi. Paakaita seanopenga pamberi paAbhimereki; uyo akamudzinga, iye akaenda hake.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinorumbidza Jehovha nguva dzose;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.1",
            "verseOrgIds": [
              "PSA.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:1"
      },
      "items": [
        {
          "text": "kurumbidzwa kwake kucharamba kuri pamiromo yangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.1",
            "verseOrgIds": [
              "PSA.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwoyo wangu uchazvirumbidza muna Jehovha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.2",
            "verseOrgIds": [
              "PSA.34.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:2"
      },
      "items": [
        {
          "text": "vanotambudzika ngavanzwe vafare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.2",
            "verseOrgIds": [
              "PSA.34.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kudzai Jehovha pamwe chete neni;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.3",
            "verseOrgIds": [
              "PSA.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:3"
      },
      "items": [
        {
          "text": "ngatikudzei zita rake pamwe chete.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.3",
            "verseOrgIds": [
              "PSA.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakachema kuna Jehovha akandipindura;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.4",
            "verseOrgIds": [
              "PSA.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:4"
      },
      "items": [
        {
          "text": "akandisunungura pakutya kwangu kwose.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.4",
            "verseOrgIds": [
              "PSA.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanotarira kwaari vanopenya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.5",
            "verseOrgIds": [
              "PSA.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:5"
      },
      "items": [
        {
          "text": "zviso zvavo hazvingambofukidzwi nenyadzi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.5",
            "verseOrgIds": [
              "PSA.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murombo uyu akadana, uye Jehovha akamunzwa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.6",
            "verseOrgIds": [
              "PSA.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:6"
      },
      "items": [
        {
          "text": "akamuponesa pakutambudzika kwake kwose.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.6",
            "verseOrgIds": [
              "PSA.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutumwa waJehovha anokomberedza avo vanomutya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.7",
            "verseOrgIds": [
              "PSA.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:7"
      },
      "items": [
        {
          "text": "uye anovasunungura.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.7",
            "verseOrgIds": [
              "PSA.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ravirai henyu muone kuti Jehovha akanaka;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.8",
            "verseOrgIds": [
              "PSA.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:8"
      },
      "items": [
        {
          "text": "akaropafadzwa munhu anovanda maari.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.8",
            "verseOrgIds": [
              "PSA.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ityai Jehovha, imi vatsvene vake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.9",
            "verseOrgIds": [
              "PSA.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:9"
      },
      "items": [
        {
          "text": "nokuti vanomutya havana chavanoshayiwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.9",
            "verseOrgIds": [
              "PSA.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shumba dzinopera simba uye dzinofa nenzara,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.10",
            "verseOrgIds": [
              "PSA.34.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:10"
      },
      "items": [
        {
          "text": "asi avo vanotsvaka Jehovha havashayiwi chinhu chakanaka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.10",
            "verseOrgIds": [
              "PSA.34.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyai, vana vangu, nditeererei;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.11",
            "verseOrgIds": [
              "PSA.34.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:11"
      },
      "items": [
        {
          "text": "ndichakudzidzisai kutya Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.11",
            "verseOrgIds": [
              "PSA.34.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani naani wenyu anoda upenyu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.12",
            "verseOrgIds": [
              "PSA.34.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:12"
      },
      "items": [
        {
          "text": "uye uchida kuona mazuva akawanda,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.12",
            "verseOrgIds": [
              "PSA.34.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "dzora rurimi rwako pane zvakaipa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.13",
            "verseOrgIds": [
              "PSA.34.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:13"
      },
      "items": [
        {
          "text": "nemiromo yako pakureva nhema.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.13",
            "verseOrgIds": [
              "PSA.34.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibva pane zvakaipa ugoita zvakanaka;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.14",
            "verseOrgIds": [
              "PSA.34.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:14"
      },
      "items": [
        {
          "text": "tsvaka rugare uye urutevere.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.14",
            "verseOrgIds": [
              "PSA.34.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meso aJehovha ari pamusoro pavakarurama",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.15",
            "verseOrgIds": [
              "PSA.34.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:15"
      },
      "items": [
        {
          "text": "uye nzeve dzake dzinonzwa kuchema kwavo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.15",
            "verseOrgIds": [
              "PSA.34.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "chiso chaJehovha chinovenga avo vanoita zvakaipa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.16",
            "verseOrgIds": [
              "PSA.34.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:16"
      },
      "items": [
        {
          "text": "kuti abvise chiyeuchidzo chavo panyika.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.16",
            "verseOrgIds": [
              "PSA.34.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakarurama vanodanidzira, uye Jehovha anovanzwa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.17",
            "verseOrgIds": [
              "PSA.34.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:17"
      },
      "items": [
        {
          "text": "anovarwira pakutambudzika kwavo kwose.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.17",
            "verseOrgIds": [
              "PSA.34.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha ari pedyo navane mwoyo yakaputsika",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.18",
            "verseOrgIds": [
              "PSA.34.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:18"
      },
      "items": [
        {
          "text": "uye anoponesa avo vakapwanyika pamweya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.18",
            "verseOrgIds": [
              "PSA.34.19"
