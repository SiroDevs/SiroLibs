      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Pisarema 29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Pisarema raDhavhidhi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipai kuna Jehovha, imi mune simba",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.1",
            "verseOrgIds": [
              "PSA.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:1"
      },
      "items": [
        {
          "text": "ipai kuna Jehovha rukudzo nesimba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.1",
            "verseOrgIds": [
              "PSA.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipai kuna Jehovha rukudzo rwakafanira zita rake;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.2",
            "verseOrgIds": [
              "PSA.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:2"
      },
      "items": [
        {
          "text": "namatai Jehovha mukubwinya kwoutsvene hwake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.2",
            "verseOrgIds": [
              "PSA.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzwi raJehovha riri pamusoro pemvura zhinji.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.3",
            "verseOrgIds": [
              "PSA.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:3"
      },
      "items": [
        {
          "text": "Mwari wokubwinya anotinhira,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.3",
            "verseOrgIds": [
              "PSA.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:3"
      },
      "items": [
        {
          "text": "Jehovha anotinhira ari pamusoro pemvura zhinji.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.3",
            "verseOrgIds": [
              "PSA.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzwi raJehovha rine simba;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.4",
            "verseOrgIds": [
              "PSA.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:4"
      },
      "items": [
        {
          "text": "inzwi raJehovha rinokudzwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.4",
            "verseOrgIds": [
              "PSA.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzwi raJehovha rinovhuna misidhari,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.5",
            "verseOrgIds": [
              "PSA.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:5"
      },
      "items": [
        {
          "text": "Jehovha anovhuna-vhuna misidhari yeRebhanoni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.5",
            "verseOrgIds": [
              "PSA.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anoita kuti Rebhanoni ikwakuke semhuru,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.6",
            "verseOrgIds": [
              "PSA.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:6"
      },
      "items": [
        {
          "text": "neSirioni senzombe yenyati.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.6",
            "verseOrgIds": [
              "PSA.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzwi raJehovha rinorova",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.7",
            "verseOrgIds": [
              "PSA.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:7"
      },
      "items": [
        {
          "text": "nokuvaima kwemheni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.7",
            "verseOrgIds": [
              "PSA.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzwi raJehovha rinozungunusa gwenga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.8",
            "verseOrgIds": [
              "PSA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:8"
      },
      "items": [
        {
          "text": "Jehovha anozungunusa Gwenga reKadheshi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.8",
            "verseOrgIds": [
              "PSA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzwi raJehovha rinomonyorora miouki",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.9",
            "verseOrgIds": [
              "PSA.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:9"
      },
      "items": [
        {
          "text": "uye rinosvuura sango rigosara rati hwe-e.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.9",
            "verseOrgIds": [
              "PSA.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 29:9"
      },
      "items": [
        {
          "text": "Uye mutemberi yake zvose zvinodana zvichiti, \"Kubwinya!\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.9",
            "verseOrgIds": [
              "PSA.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha anogara pachigaro choushe chamafashamu emvura;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.10",
            "verseOrgIds": [
              "PSA.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:10"
      },
      "items": [
        {
          "text": "Jehovha anogara ari Mambo nokusingaperi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.10",
            "verseOrgIds": [
              "PSA.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha anopa simba kuvanhu vake;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.11",
            "verseOrgIds": [
              "PSA.29.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:11"
      },
      "items": [
        {
          "text": "Jehovha anoropafadza vanhu vake norugare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.11",
            "verseOrgIds": [
              "PSA.29.11"
            ]
          }
        }
      ]
    }
  ],
