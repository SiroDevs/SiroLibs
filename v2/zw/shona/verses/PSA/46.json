  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "46",
        "style": "c",
        "sid": "PSA 46"
      },
      "items": [
        {
          "text": "46",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Pisarema 46",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kumutungamiri wokuimba waVanakomana vaKora. Namaimbirwo earamoti. Rwiyo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 46:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari ndiye utiziro hwedu nesimba redu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.1",
            "verseOrgIds": [
              "PSA.46.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:1"
      },
      "items": [
        {
          "text": "ndiye mubatsiri anogara aripo panguva yokutambudzika.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.1",
            "verseOrgIds": [
              "PSA.46.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 46:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo hatizotyi, kunyange nyika ikashanduka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.2",
            "verseOrgIds": [
              "PSA.46.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:2"
      },
      "items": [
        {
          "text": "uye makomo akawira mukatikati megungwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.2",
            "verseOrgIds": [
              "PSA.46.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 46:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunyange mvura yaro ikatinhira uye ikapupuma furo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.3",
            "verseOrgIds": [
              "PSA.46.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:3"
      },
      "items": [
        {
          "text": "uye makomo akadengenyeswa namafungu aro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.3",
            "verseOrgIds": [
              "PSA.46.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sera",
              "type": "text",
              "attrs": {
                "verseId": "PSA.46.3",
                "verseOrgIds": [
                  "PSA.46.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 46:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pane rwizi rwuripo rune hova dzinofadza guta raMwari,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.4",
            "verseOrgIds": [
              "PSA.46.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:4"
      },
      "items": [
        {
          "text": "nzvimbo tsvene yeWokumusoro-soro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.4",
            "verseOrgIds": [
              "PSA.46.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 46:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari ari mukati maro, haringawiri pasi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.5",
            "verseOrgIds": [
              "PSA.46.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:5"
      },
      "items": [
        {
          "text": "Mwari acharibatsira panguva yemambakwedza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.5",
            "verseOrgIds": [
              "PSA.46.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 46:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndudzi dzinoita bope, umambo hunoondomoka;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.6",
            "verseOrgIds": [
              "PSA.46.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:6"
      },
      "items": [
        {
          "text": "anotaura nenzwi guru, nyika yonyongodeka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.6",
            "verseOrgIds": [
              "PSA.46.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 46:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha Wamasimba Ose anesu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.7",
            "verseOrgIds": [
              "PSA.46.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:7"
      },
      "items": [
        {
          "text": "Mwari waJakobho ndiye nhare yedu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.7",
            "verseOrgIds": [
              "PSA.46.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sera",
              "type": "text",
              "attrs": {
                "verseId": "PSA.46.7",
                "verseOrgIds": [
                  "PSA.46.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 46:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyai muone mabasa aJehovha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.8",
            "verseOrgIds": [
              "PSA.46.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:8"
      },
      "items": [
        {
          "text": "kuparadza kwaakaita panyika.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.8",
            "verseOrgIds": [
              "PSA.46.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 46:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anoita kuti hondo dzigume kusvikira kumagumo enyika;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.9",
            "verseOrgIds": [
              "PSA.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:9"
      },
      "items": [
        {
          "text": "anovhuna uta uye anovhuna-vhuna mapfumo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.9",
            "verseOrgIds": [
              "PSA.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:9"
      },
      "items": [
        {
          "text": "anopisa nhoo nomoto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.9",
            "verseOrgIds": [
              "PSA.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 46:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mirai, muzive kuti ndini Mwari;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.10",
            "verseOrgIds": [
              "PSA.46.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:10"
      },
      "items": [
        {
          "text": "ndichakudzwa pakati pendudzi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.10",
            "verseOrgIds": [
              "PSA.46.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:10"
      },
      "items": [
        {
          "text": "ndichasimudzirwa panyika.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.10",
            "verseOrgIds": [
              "PSA.46.11"
            ]
          }
        }
      ]
    },
    {
