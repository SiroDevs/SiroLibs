      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 99:2"
      },
      "items": [
        {
          "text": "iye akasimudzirwa pamusoro pendudzi dzose.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.2",
            "verseOrgIds": [
              "PSA.99.2"
            ]
          }
        }
      ]
    },
    {
