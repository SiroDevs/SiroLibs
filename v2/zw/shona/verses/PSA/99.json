            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha anobata ushe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.1",
            "verseOrgIds": [
              "PSA.99.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 99:1"
      },
      "items": [
        {
          "text": "ndudzi ngadzidedere;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.1",
            "verseOrgIds": [
              "PSA.99.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 99:1"
      },
      "items": [
        {
          "text": "anogara pachigaro choushe chiri pakati pamakerubhi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.1",
            "verseOrgIds": [
              "PSA.99.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 99:1"
      },
      "items": [
        {
          "text": "nyika ngaizungunuke.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.1",
            "verseOrgIds": [
              "PSA.99.1"
            ]
          }
        }
      ]
    },
    {
