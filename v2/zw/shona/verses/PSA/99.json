      "attrs": {
        "style": "q2",
        "vid": "PSA 99:7"
      },
      "items": [
        {
          "text": "vakachengeta zvaakatema nemitemo yaakavapa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.7",
            "verseOrgIds": [
              "PSA.99.7"
            ]
