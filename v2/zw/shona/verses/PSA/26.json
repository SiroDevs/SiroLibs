      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Pisarema 26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Pisarema raDhavhidhi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nditongerei, imi Jehovha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.1",
            "verseOrgIds": [
              "PSA.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 26:1"
      },
      "items": [
        {
          "text": "nokuti ndakararama upenyu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.1",
            "verseOrgIds": [
              "PSA.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 26:1"
      },
      "items": [
        {
          "text": "husina chahungapomerwa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.1",
            "verseOrgIds": [
              "PSA.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 26:1"
      },
      "items": [
        {
          "text": "ndakavimba naJehovha ndisingazungunuki.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.1",
            "verseOrgIds": [
              "PSA.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiedzei, imi Jehovha, ndinzverei,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.2",
            "verseOrgIds": [
              "PSA.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 26:2"
      },
      "items": [
        {
          "text": "nzverai mwoyo wangu nendangariro dzangu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.2",
            "verseOrgIds": [
              "PSA.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti rudo rwenyu rwuri pamberi pangu nguva dzose,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.3",
            "verseOrgIds": [
              "PSA.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 26:3"
      },
      "items": [
        {
          "text": "uye ndinogara ndichifamba muzvokwadi yenyu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.3",
            "verseOrgIds": [
              "PSA.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Handigari navanhu vanonyengera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.4",
            "verseOrgIds": [
              "PSA.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 26:4"
      },
      "items": [
        {
          "text": "kana kufambidzana navanyengeri;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.4",
            "verseOrgIds": [
              "PSA.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndinovenga ungano yavaiti vezvakaipa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.5",
            "verseOrgIds": [
              "PSA.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 26:5"
      },
      "items": [
        {
          "text": "uye ndinoramba kugara navakaipa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.5",
            "verseOrgIds": [
              "PSA.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinoshamba maoko angu ndisina mhaka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.6",
            "verseOrgIds": [
              "PSA.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 26:6"
      },
      "items": [
        {
          "text": "uye ndinofamba-famba paaritari yenyu, imi Jehovha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.6",
            "verseOrgIds": [
              "PSA.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndichiparidza rumbidzo yenyu nenzwi guru,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.7",
            "verseOrgIds": [
              "PSA.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 26:7"
      },
      "items": [
        {
          "text": "uye ndichireva zvamabasa enyu ose anoshamisa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.7",
            "verseOrgIds": [
              "PSA.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinoda imba yamunogara, imi Jehovha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.8",
            "verseOrgIds": [
              "PSA.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 26:8"
      },
      "items": [
        {
          "text": "nzvimbo inogara kubwinya kwenyu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.8",
            "verseOrgIds": [
              "PSA.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Regai kubatanidza mweya wangu navatadzi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.9",
            "verseOrgIds": [
              "PSA.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 26:9"
      },
      "items": [
        {
          "text": "noupenyu hwangu navanoteura ropa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.9",
            "verseOrgIds": [
              "PSA.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "vana maoko akabata zvakaipa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.10",
            "verseOrgIds": [
              "PSA.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 26:10"
      },
      "items": [
        {
          "text": "vazere nefufuro mumaoko avo orudyi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.10",
            "verseOrgIds": [
              "PSA.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi ini ndinogara upenyu husina chahungapomerwa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.11",
            "verseOrgIds": [
              "PSA.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 26:11"
      },
      "items": [
        {
          "text": "ndidzikinurei uye mundinzwire ngoni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.11",
            "verseOrgIds": [
              "PSA.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsoka dzangu dzimire pakati chechetere;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.12",
            "verseOrgIds": [
              "PSA.26.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 26:12"
      },
      "items": [
        {
          "text": "ndicharumbidza Jehovha paungano huru.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.12",
            "verseOrgIds": [
              "PSA.26.12"
            ]
          }
        }
      ]
    }
  ],
