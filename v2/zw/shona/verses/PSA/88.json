  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "88",
        "style": "c",
        "sid": "PSA 88"
      },
      "items": [
        {
          "text": "88",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Pisarema 88",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Rwiyo. Pisarema ravanakomana vaKora. Kumutungamiri wokuimba namaimbirwo emaharati reanoti. Masikiri raHemani muEzrahi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 88:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa Jehovha, Mwari anondiponesa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.1",
            "verseOrgIds": [
              "PSA.88.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:1"
      },
      "items": [
        {
          "text": "ndakachema masikati nousiku pamberi penyu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.1",
            "verseOrgIds": [
              "PSA.88.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 88:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyengetero wangu ngausvike pamberi penyu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.2",
            "verseOrgIds": [
              "PSA.88.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:2"
      },
      "items": [
        {
          "text": "rerekerai nzeve yenyu kukuchema kwangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.2",
            "verseOrgIds": [
              "PSA.88.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 88:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti mweya wangu uzere nokutambudzika,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.3",
            "verseOrgIds": [
              "PSA.88.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:3"
      },
      "items": [
        {
          "text": "uye upenyu hwangu hwaswedera pedyo neguva.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.3",
            "verseOrgIds": [
              "PSA.88.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 88:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinoverengwa pakati paavo vakaburukira kugomba;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.4",
            "verseOrgIds": [
              "PSA.88.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:4"
      },
      "items": [
        {
          "text": "ndava somunhu asina simba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.4",
            "verseOrgIds": [
              "PSA.88.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 88:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakatsaurwa pamwe chete navakafa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.5",
            "verseOrgIds": [
              "PSA.88.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:5"
      },
      "items": [
        {
          "text": "savakaurayiwa vavete muguva,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.5",
            "verseOrgIds": [
              "PSA.88.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 88:5"
      },
      "items": [
        {
          "text": "vamusingacharangaririzve,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.5",
            "verseOrgIds": [
              "PSA.88.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:5"
      },
      "items": [
        {
          "text": "vakagurwa kubva pakuchengeta kwenyu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.5",
            "verseOrgIds": [
              "PSA.88.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 88:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makandiisa mugomba rakadzika dzika,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.6",
            "verseOrgIds": [
              "PSA.88.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:6"
      },
      "items": [
        {
          "text": "murima guru makadzika dzika.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.6",
            "verseOrgIds": [
              "PSA.88.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 88:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hasha dzenyu dzinorema kwazvo pamusoro pangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.7",
            "verseOrgIds": [
              "PSA.88.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:7"
      },
      "items": [
        {
          "text": "makandifukidza namafungu enyu ose.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.7",
            "verseOrgIds": [
              "PSA.88.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sera",
              "type": "text",
              "attrs": {
                "verseId": "PSA.88.7",
                "verseOrgIds": [
                  "PSA.88.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 88:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makanditorera shamwari dzangu dzapedyo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.8",
            "verseOrgIds": [
              "PSA.88.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:8"
      },
      "items": [
        {
          "text": "uye mukandiita chinhu chinonyangadza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.8",
            "verseOrgIds": [
              "PSA.88.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 88:8"
      },
      "items": [
        {
          "text": "Ndakapfigirwa uye handingatongopunyuki;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.8",
            "verseOrgIds": [
              "PSA.88.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 88:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "meso angu asviba neshungu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.9",
            "verseOrgIds": [
              "PSA.88.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 88:9"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 88:9"
      },
      "items": [
        {
          "text": "Ndinodana kwamuri, imi Jehovha, mazuva ose;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.9",
            "verseOrgIds": [
              "PSA.88.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:9"
      },
      "items": [
        {
          "text": "ndinotambanudzira maoko angu kwamuri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.9",
            "verseOrgIds": [
              "PSA.88.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 88:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, munoratidza zvishamiso zvenyu kuna vakafa here?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.10",
            "verseOrgIds": [
              "PSA.88.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:10"
      },
      "items": [
        {
          "text": "Ko, vakafa vanomuka vachikurumbidzai here?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.10",
            "verseOrgIds": [
              "PSA.88.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sera",
              "type": "text",
              "attrs": {
                "verseId": "PSA.88.10",
                "verseOrgIds": [
                  "PSA.88.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 88:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, rudo rwenyu runoparidzwa muguva,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.11",
            "verseOrgIds": [
              "PSA.88.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:11"
      },
      "items": [
        {
          "text": "nokutendeka kwenyu mukuparadzwa here?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.11",
            "verseOrgIds": [
              "PSA.88.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 88:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, zvishamiso zvenyu zvinozivikanwa munzvimbo yerima,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.12",
            "verseOrgIds": [
              "PSA.88.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:12"
      },
      "items": [
        {
          "text": "kana mabasa akarurama enyu munyika yokukanganwa here?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.12",
            "verseOrgIds": [
              "PSA.88.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 88:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi ndinochemera rubatsiro kwamuri, imi Jehovha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.13",
            "verseOrgIds": [
              "PSA.88.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:13"
      },
      "items": [
        {
          "text": "mangwanani, munyengetero wangu unosvika pamberi penyu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.13",
            "verseOrgIds": [
              "PSA.88.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 88:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seiko, imi Jehovha, muchindiramba",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.14",
            "verseOrgIds": [
              "PSA.88.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:14"
      },
      "items": [
        {
          "text": "uye muchindivanzira chiso chenyu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.14",
            "verseOrgIds": [
              "PSA.88.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 88:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubvira pauduku hwangu, ndakatambudzika zvokutosvika pedyo norufu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.15",
            "verseOrgIds": [
              "PSA.88.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:15"
      },
      "items": [
        {
          "text": "ndatambudzika nokutyisa kwenyu uye handisisina tariro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.15",
            "verseOrgIds": [
              "PSA.88.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 88:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hasha dzenyu dzakapfuura napamusoro pangu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.16",
            "verseOrgIds": [
              "PSA.88.17"
            ]
          }
        }
      ]
    },
    {
