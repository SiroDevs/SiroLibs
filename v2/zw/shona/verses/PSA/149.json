      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 149:9"
      },
      "items": [
        {
          "text": "Rumbidzai Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.9",
            "verseOrgIds": [
              "PSA.149.9"
            ]
          }
        }
