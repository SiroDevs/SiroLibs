              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rumbidzai Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.1",
            "verseOrgIds": [
              "PSA.150.1"
            ]
          }
        }
