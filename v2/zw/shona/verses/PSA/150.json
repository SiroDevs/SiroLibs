          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvinhu zvose zvinofema, ngazvirumbidze Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.6",
            "verseOrgIds": [
              "PSA.150.6"
