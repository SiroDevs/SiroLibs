          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kuna She wangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.1",
            "verseOrgIds": [
              "PSA.110.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 110:1"
      },
      "items": [
        {
          "text": "\"Gara kuruoko rwangu rworudyi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.1",
            "verseOrgIds": [
              "PSA.110.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 110:1"
      },
      "items": [
        {
          "text": "kusvikira ndaita vavengi vako",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.1",
            "verseOrgIds": [
              "PSA.110.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 110:1"
      },
      "items": [
        {
          "text": "chitsiko chetsoka dzako.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.1",
            "verseOrgIds": [
              "PSA.110.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 110:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha achatambanudza tsvimbo yesimba rako kubva muZioni;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.2",
            "verseOrgIds": [
              "PSA.110.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 110:2"
      },
      "items": [
        {
          "text": "uchatonga pakati pavavengi vako.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.2",
            "verseOrgIds": [
              "PSA.110.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 110:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mauto ako achazvipira",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.3",
            "verseOrgIds": [
              "PSA.110.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 110:3"
      },
      "items": [
        {
          "text": "pazuva rako rehondo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.3",
            "verseOrgIds": [
              "PSA.110.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 110:3"
      },
      "items": [
        {
          "text": "Wapfekedzwa nguo youshe, utsvene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.3",
            "verseOrgIds": [
              "PSA.110.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 110:3"
      },
      "items": [
        {
          "text": "kubva pachizvaro chamambakwedza",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.3",
            "verseOrgIds": [
              "PSA.110.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 110:3"
      },
      "items": [
        {
          "text": "uchagamuchira dova roujaya hwako.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.3",
            "verseOrgIds": [
              "PSA.110.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 110:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akapika,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.4",
            "verseOrgIds": [
              "PSA.110.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 110:4"
      },
      "items": [
        {
          "text": "uye haangashanduki, achiti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.4",
            "verseOrgIds": [
              "PSA.110.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 110:4"
      },
      "items": [
        {
          "text": "\"Iwe uri muprista nokusingaperi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.4",
            "verseOrgIds": [
              "PSA.110.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 110:4"
      },
      "items": [
        {
          "text": "worudzi rwaMerikizedheki.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.4",
            "verseOrgIds": [
              "PSA.110.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 110:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha ari kuruoko rwako rworudyi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.5",
            "verseOrgIds": [
              "PSA.110.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 110:5"
      },
      "items": [
        {
          "text": "achaparadza madzimambo pazuva rehasha dzake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.5",
            "verseOrgIds": [
              "PSA.110.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 110:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achatonga ndudzi, achiunganidza vakafa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.6",
            "verseOrgIds": [
              "PSA.110.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 110:6"
      },
      "items": [
        {
          "text": "uye achiparadza vatongi venyika yose.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.6",
            "verseOrgIds": [
              "PSA.110.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 110:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achanwa parukova rwuri parutivi penzira;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.7",
            "verseOrgIds": [
              "PSA.110.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 110:7"
      },
      "items": [
        {
          "text": "naizvozvo achasimudza musoro wake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.7",
            "verseOrgIds": [
              "PSA.110.7"
            ]
          }
        }
      ]
    }
