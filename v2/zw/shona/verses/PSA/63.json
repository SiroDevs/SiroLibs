        "number": "63",
        "style": "c",
        "sid": "PSA 63"
      },
      "items": [
        {
          "text": "63",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Pisarema 63",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Pisarema raDhavhidhi paakanga ari murenje reJudha.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 63:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa Mwari, ndimi Mwari wangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.1",
            "verseOrgIds": [
              "PSA.63.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:1"
      },
      "items": [
        {
          "text": "ndinokutsvakai nomwoyo wose;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.1",
            "verseOrgIds": [
              "PSA.63.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 63:1"
      },
      "items": [
        {
          "text": "mwoyo wangu une nyota kwamuri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.1",
            "verseOrgIds": [
              "PSA.63.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:1"
      },
      "items": [
        {
          "text": "muviri wangu unokupangai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.1",
            "verseOrgIds": [
              "PSA.63.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 63:1"
      },
      "items": [
        {
          "text": "munyika yakaoma",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.1",
            "verseOrgIds": [
              "PSA.63.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:1"
      },
      "items": [
        {
          "text": "uye yasakara isina mvura.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.1",
            "verseOrgIds": [
              "PSA.63.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 63:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakakuonai munzvimbo yenyu tsvene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.2",
            "verseOrgIds": [
              "PSA.63.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:2"
      },
      "items": [
        {
          "text": "uye ndikaona simba renyu nokubwinya kwenyu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.2",
            "verseOrgIds": [
              "PSA.63.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 63:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti rudo rwenyu runokunda upenyu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.3",
            "verseOrgIds": [
              "PSA.63.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:3"
      },
      "items": [
        {
          "text": "miromo yangu ichakurumbidzai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.3",
            "verseOrgIds": [
              "PSA.63.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 63:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichakurumbidzai ndichiri mupenyu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.4",
            "verseOrgIds": [
              "PSA.63.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:4"
      },
      "items": [
        {
          "text": "uye ndichasimudza maoko angu muzita renyu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.4",
            "verseOrgIds": [
              "PSA.63.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 63:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mweya wangu uchagutswa kunge wadya zvakakora kwazvo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.5",
            "verseOrgIds": [
              "PSA.63.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:5"
      },
      "items": [
        {
          "text": "muromo wangu uchakurumbidzai nemiromo inofara kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.5",
            "verseOrgIds": [
              "PSA.63.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 63:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinokurangarirai ndiri pamubhedha wangu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.6",
            "verseOrgIds": [
              "PSA.63.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:6"
      },
      "items": [
        {
          "text": "ndinokufungai panguva dzose dzousiku.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.6",
            "verseOrgIds": [
              "PSA.63.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 63:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti muri mubatsiri wangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.7",
            "verseOrgIds": [
              "PSA.63.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:7"
      },
      "items": [
        {
          "text": "ndinoimba ndiri mumumvuri wamapapiro enyu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.7",
            "verseOrgIds": [
              "PSA.63.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 63:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mweya wangu unonamatira kwamuri;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.8",
            "verseOrgIds": [
              "PSA.63.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:8"
      },
      "items": [
        {
          "text": "ruoko rwenyu rworudyi runonditsigira.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.8",
            "verseOrgIds": [
              "PSA.63.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 63:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanotsvaka upenyu hwangu vachaparadzwa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.9",
            "verseOrgIds": [
              "PSA.63.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:9"
      },
      "items": [
        {
          "text": "vachaburukira kwakadzika kwepasi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.9",
            "verseOrgIds": [
              "PSA.63.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 63:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vachaiswa kumunondo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.10",
            "verseOrgIds": [
              "PSA.63.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:10"
      },
      "items": [
        {
          "text": "vagova zvokudya zvamakava.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.10",
            "verseOrgIds": [
              "PSA.63.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 63:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi mambo achafara muna Mwari;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.11",
            "verseOrgIds": [
              "PSA.63.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:11"
      },
      "items": [
        {
          "text": "vose vanopika nezita raMwari vachamurumbidza,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.11",
            "verseOrgIds": [
              "PSA.63.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:11"
      },
      "items": [
        {
          "text": "asi miromo yavanoreva nhema ichafumbirwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.11",
            "verseOrgIds": [
              "PSA.63.12"
            ]
          }
        }
      ]
    }
  ],
