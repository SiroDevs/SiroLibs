  "verseCount": 71,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "JHN 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vanhu Zviuru Zvishanu Vanopiwa Zvokudya naJesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwaizvozvi, Jesu akayambuka akaenda mhiri kumahombekombe eGungwa reGarirea (ndiro Gungwa reTibheriasi),",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.1",
            "verseOrgIds": [
              "JHN.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye vazhinji zhinji vakamutevera nokuti vakanga vaona zviratidzo zvaakanga aita pavarwere.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.2",
            "verseOrgIds": [
              "JHN.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jesu akakwira pagomo akagara pasi navadzidzi vake.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.3",
            "verseOrgIds": [
              "JHN.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutambo wavaJudha wePasika wakanga wava pedyo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.4",
            "verseOrgIds": [
              "JHN.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati asimudza meso ake akaona vanhu vazhinji zhinji vachiuya kwaari, akati kuna Firipi, \"Tichatenga chingwa kupiko chokuti vanhu ava vadye?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.5",
            "verseOrgIds": [
              "JHN.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabvunza izvi achida chete kumuedza, nokuti akanga atoziva kare mupfungwa dzake zvaakanga achizoita.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.6",
            "verseOrgIds": [
              "JHN.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Firipi akamupindura akati, \"Mubayiro unoshandirwa kwemwedzi misere haugoni kutenga chingwa chinokwana mumwe nomumwe hake, kuti awane chimedu!\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.7",
            "verseOrgIds": [
              "JHN.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwe wavadzidzi vake, Andirea, mununʼuna waPetro, akati,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.8",
            "verseOrgIds": [
              "JHN.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Houno mukomana ane zvingwa zviduku zvebhari nehove mbiri, asi zvingasvikepiko pakati pavanhu vakawanda zvakadai?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.9",
            "verseOrgIds": [
              "JHN.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati, \"Itai kuti vanhu vagare pasi.\" Panzvimbo iyo pakanga pano uswa huzhinji kwazvo, uye varume vakagara pasi vakanga vachikarosvika zviuru zvishanu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.10",
            "verseOrgIds": [
              "JHN.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jesu akatora zvingwa zviya, akavonga, uye akazvigovera kuna vaya vakanga vagara pasi mumwe nomumwe paaida napo. Akaita zvimwe chetezvo nehove.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.11",
            "verseOrgIds": [
              "JHN.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati vadya vose, akati kuvadzidzi vake, \"Unganidzai zvimedu zvose zvasara. Musarega zvichiraswa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.12",
            "verseOrgIds": [
              "JHN.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vakazviunganidza zvikazara matengu gumi namaviri nezvimedu zvezvingwa zvebhari zvishanu, zvakanga zvasiyiwa navaya vakanga vadya.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.13",
            "verseOrgIds": [
              "JHN.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vakati vaona chiratidzo chakanga chaitwa naJesu, vakatanga kuti, \"Zvirokwazvo uyu ndiye muprofita aifanira kuuya panyika.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.14",
            "verseOrgIds": [
              "JHN.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu, akaziva kuti vaida kumumanikidza kuti vamuite mambo, akabvazve, akaenda kugomo ari oga.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.15",
            "verseOrgIds": [
              "JHN.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu Anofamba Pamusoro peMvura",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nguva yamadekwana yakati yasvika, vadzidzi vake vakaburuka vakaenda kugungwa,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.16",
            "verseOrgIds": [
              "JHN.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "uko kwavakandopinda mugwa vakasimuka vakayambuka vakaenda mhiri kwegungwa vakananga kuKapenaume. Zvino kwakanga kwasviba, uye Jesu akanga asati ava pavari.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.17",
            "verseOrgIds": [
              "JHN.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mhepo ine simba yakanga ichivhuvhuta uye kukava namafungu ane hasha.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.18",
            "verseOrgIds": [
              "JHN.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati vakwasva igwa kwamakiromita angaita mashanu kana matanhatu, vakaona Jesu achiuya kuigwa, achifamba pamusoro pemvura; uye vakatya zvikuru.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.19",
            "verseOrgIds": [
              "JHN.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi iye akati kwavari, \"Ndini; musatya.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.20",
            "verseOrgIds": [
              "JHN.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vakafara kumugamuchira mugwa; pakarepo igwa rakasvika kumahombekombe kwavakanga vakananga.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.21",
            "verseOrgIds": [
              "JHN.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fume mangwana, vanhu vazhinji vakanga vasara mhiri kwegungwa vakatanga kuona kuti pakanga pachingova neigwa rimwe chete ipapo, uye kuti Jesu haana kunge apinda mariri kuti aende navadzidzi vake, asi kuti vakanga vaenda vari voga.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.22",
            "verseOrgIds": [
              "JHN.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mamwe magwa aibva kuTibheriasi akasvika pedyo nenzvimbo yakanga yadyirwa chingwa navanhu shure kwokuvonga kwaShe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.23",
            "verseOrgIds": [
              "JHN.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vazhinji vakati vaona kuti Jesu navadzidzi vake vakanga vasisipo, vakapinda mumagwa ndokuenda kuKapenaume vachitsvaka Jesu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.24",
            "verseOrgIds": [
              "JHN.6.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu ndiye Chingwa choUpenyu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati vamuwana ari mhiri kwegungwa vakamubvunza vakati, \"Rabhi, makauya kuno riniko?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.25",
            "verseOrgIds": [
              "JHN.6.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akapindura akati, \"Ndinokuudzai chokwadi kuti, muri kunditsvaka, kwete nokuda kwokuti makaona zviratidzo, asi nokuda kwokuti makadya zvingwa uye mukaguta.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.26",
            "verseOrgIds": [
              "JHN.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musashandira zvokudya zvinopera, asi shandirai zvokudya zvinogara kuupenyu husingaperi zvamuchapiwa noMwanakomana woMunhu. Mwari Baba vakaisa chisimbiso chavo paari.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.27",
            "verseOrgIds": [
              "JHN.6.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vakamubvunza vakati, \"Tinofanira kuita seiko kuti tiite mabasa anodikanwa naMwari?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.28",
            "verseOrgIds": [
              "JHN.6.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akapindura akati, \"Basa raMwari nderiri: kuti mutende kuna iye waakatuma.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.29",
            "verseOrgIds": [
              "JHN.6.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vakamubvunza vakati, \"Muchatiratidza chiratidzo cheiko chatingaona kuti tigokutendai? Muchaiteiko?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.30",
            "verseOrgIds": [
              "JHN.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Madzibaba edu akadya mana murenje; sezvazvakanyorwa zvichinzi: 'Akavapa chingwa chakabva kudenga kuti vadye.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.31",
            "verseOrgIds": [
              "JHN.6.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati kwavari, \"Zvirokwazvo ndinoti kwamuri, haasi Mozisi akakupai chingwa chakabva kudenga, asi kuti ndiBaba vangu vanokupai chingwa chezvokwadi chinobva kudenga.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.32",
            "verseOrgIds": [
              "JHN.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti chingwa chaMwari ndiye anoburuka achibva kudenga uye anopa upenyu kunyika.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.33",
            "verseOrgIds": [
              "JHN.6.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivo vakati, \"Ishe, kubva zvino zvichienda mberi, tipei chingwa ichi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.34",
            "verseOrgIds": [
              "JHN.6.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jesu akataura achiti, \"Ndini chingwa choupenyu. Ani naani anouya kwandiri haangatongovi nenzara, uye ani naani anotenda kwandiri haangatongovi nenyota.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.35",
            "verseOrgIds": [
              "JHN.6.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 6:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi sezvandakakuudzai, makandiona uye hamutendi nazvino.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.36",
            "verseOrgIds": [
              "JHN.6.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 6:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvose zvandinopiwa naBaba zvichauya kwandiri, uye ani naani anouya kwandiri handingatongomurasiri kure.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.37",
            "verseOrgIds": [
              "JHN.6.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 6:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti handina kuburuka kubva kudenga kuti ndizoita kuda kwangu asi kuti ndizoita kuda kwaiye akandituma.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.38",
            "verseOrgIds": [
              "JHN.6.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 6:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye uku ndiko kuda kwaiye akandituma, kuti ndirege kurasikirwa navose vaakandipa, asi kuti ndivamutse pazuva rokupedzisira.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.39",
            "verseOrgIds": [
              "JHN.6.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 6:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti kuda kwaBaba vangu ndiko kuti ani naani anotarira kuMwanakomana agotenda kwaari achava noupenyu husingaperi, uye ndichamumutsa pazuva rokupedzisira.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.40",
            "verseOrgIds": [
              "JHN.6.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 6:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo, vaJudha vakatanga kugununʼuna pamusoro pake nokuti akati, \"Ndini chingwa chakaburuka kubva kudenga.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.41",
            "verseOrgIds": [
              "JHN.6.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 6:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati, \"Ko, uyu haasi Jesu, mwanakomana waJosefa here, watinoziva baba vake namai vake? Zvino anotaura sei achiti, 'Ndakaburuka kubva kudenga'?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.42",
            "verseOrgIds": [
              "JHN.6.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JHN 6:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akapindura akati, \"Regai kugununʼuna pakati penyu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.43",
            "verseOrgIds": [
              "JHN.6.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JHN 6:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuna munhu angauya kwandiri kunze kwokunge Baba vakandituma vamukweva, uye ndichamumutsa pazuva rokupedzisira.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.44",
            "verseOrgIds": [
              "JHN.6.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JHN 6:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muvaprofita makanyorwa muchinzi: 'Vose vachadzidziswa naMwari.' Ani naani anoteerera kuna Baba uye anodzidza kubva kwavari anouya kwandiri.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.45",
            "verseOrgIds": [
              "JHN.6.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JHN 6:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuna munhu akaona Baba kunze kwouyo anobva kuna Mwari; ndiye chete akaona Baba.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.46",
            "verseOrgIds": [
              "JHN.6.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JHN 6:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvirokwazvo ndinoti kwamuri, uyo anotenda ndiye ano upenyu husingaperi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.47",
            "verseOrgIds": [
              "JHN.6.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JHN 6:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndini chingwa choupenyu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.48",
            "verseOrgIds": [
              "JHN.6.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JHN 6:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Madzitateguru enyu akadya mana mugwenga, asi vakafa.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.49",
            "verseOrgIds": [
              "JHN.6.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JHN 6:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi hechino chingwa chinobva kudenga, chinoti kana munhu akadya haangafi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.50",
            "verseOrgIds": [
              "JHN.6.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JHN 6:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndini chingwa chipenyu chakaburuka kubva kudenga. Kana munhu upi zvake akadya chingwa ichi, achararama nokusingaperi. Chingwa ichi inyama yangu, yandichapa nokuda kwoupenyu hwenyika.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.51",
            "verseOrgIds": [
              "JHN.6.51"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "JHN 6:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vaJudha vakatanga kukakavadzana zvikuru pakati pavo vachiti, \"Munhu uyu angatipa nyama yake kuti tiidye seiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.52",
            "verseOrgIds": [
              "JHN.6.52"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "JHN 6:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati kwavari, \"Ndinokuudzai chokwadi kuti, kana musingadyi nyama yoMwanakomana woMunhu nokunwa ropa rake, hamuna upenyu mamuri.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.53",
            "verseOrgIds": [
              "JHN.6.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "JHN 6:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani naani anodya nyama yangu nokunwa ropa rangu anogara mandiri, uye ini maari.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.54",
            "verseOrgIds": [
              "JHN.6.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "JHN 6:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti nyama yangu ndicho chokudya chaicho.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.55",
            "verseOrgIds": [
              "JHN.6.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "JHN 6:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani naani anodya nyama yangu uye anonwa ropa rangu anogara mandiri, neni maari.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.56",
            "verseOrgIds": [
              "JHN.6.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "JHN 6:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sezvo Baba vapenyu vakandituma uye ndichirarama nokuda kwaBaba, saizvozvo uyo anodya pandiri achararama nokuda kwangu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.57",
            "verseOrgIds": [
              "JHN.6.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "JHN 6:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi ndicho chingwa chakaburuka kubva kudenga. Madzitateguru enyu akadya mana uye akafa, asi ani naani anodya chingwa ichi achararama nokusingaperi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.58",
            "verseOrgIds": [
              "JHN.6.58"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "JHN 6:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akataura izvi paakanga achidzidzisa ari musinagoge muKapenaume.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.59",
            "verseOrgIds": [
              "JHN.6.59"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vadzidzi vaJesu vazhinji vanomusiya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "60",
            "style": "v",
            "sid": "JHN 6:60"
          },
          "items": [
            {
              "text": "60",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pavakanzwa izvi, vadzidzi vake vazhinji vakati, \"Kudzidzisa uku kwakaoma. Ndianiko angakugamuchira?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.60",
            "verseOrgIds": [
              "JHN.6.60"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "61",
            "style": "v",
            "sid": "JHN 6:61"
          },
          "items": [
            {
              "text": "61",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achiziva zvake kuti vadzidzi vake vakanga vachigununʼuna pamusoro paizvozvi, Jesu akati kwavari, \"Izvi zvinokugumburai here?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.61",
            "verseOrgIds": [
              "JHN.6.61"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "62",
            "style": "v",
            "sid": "JHN 6:62"
          },
          "items": [
            {
              "text": "62",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muchaita sei kana mukaona Mwanakomana woMunhu achikwira achienda kwaaimbova kare!",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.62",
            "verseOrgIds": [
              "JHN.6.62"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "63",
            "style": "v",
            "sid": "JHN 6:63"
          },
          "items": [
            {
              "text": "63",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mweya ndiye anopa upenyu, nyama haina chainobatsira. Mashoko andataura kwamuri ndiwo mweya, uye ane upenyu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.63",
            "verseOrgIds": [
              "JHN.6.63"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "64",
            "style": "v",
            "sid": "JHN 6:64"
          },
          "items": [
            {
              "text": "64",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vamwe venyu varipo vasingatendi.\" Nokuti Jesu akanga achiziva kubva pakutanga kuti ndivanaani pakati pavo vakanga vasingatendi uye kuti ndiani aizomupandukira.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.64",
            "verseOrgIds": [
              "JHN.6.64"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "65",
            "style": "v",
            "sid": "JHN 6:65"
          },
          "items": [
            {
              "text": "65",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaenderera mberi achiti, \"Ndokusaka ndakuudzai kuti hakuna munhu angauya kwandiri kunze kwokunge azvipiwa naBaba.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.65",
            "verseOrgIds": [
              "JHN.6.65"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "66",
            "style": "v",
            "sid": "JHN 6:66"
          },
          "items": [
            {
              "text": "66",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubva panguva iyi vadzidzi vake vazhinji vakadzokera shure uye vakasazomutevera.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.66",
            "verseOrgIds": [
              "JHN.6.66"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "67",
            "style": "v",
            "sid": "JHN 6:67"
          },
          "items": [
            {
              "text": "67",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akabvunza vane gumi navaviri akati, \"Nemiwo hamusi kuda kuenda here?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.67",
            "verseOrgIds": [
              "JHN.6.67"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "68",
            "style": "v",
            "sid": "JHN 6:68"
          },
          "items": [
            {
              "text": "68",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoni akati, \"Ishe, tichaenda kuna aniko? Imi mune mashoko oupenyu husingaperi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.68",
            "verseOrgIds": [
              "JHN.6.68"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "69",
            "style": "v",
            "sid": "JHN 6:69"
          },
          "items": [
            {
              "text": "69",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinotenda uye tinoziva kuti ndimi Mutsvene waMwari.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.69",
            "verseOrgIds": [
              "JHN.6.69"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "70",
            "style": "v",
            "sid": "JHN 6:70"
          },
          "items": [
            {
              "text": "70",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jesu akati, \"Handina kukusarudzai, imi vane gumi navaviri here? Asi mumwe wenyu ndidhiabhori!\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.70",
            "verseOrgIds": [
              "JHN.6.70"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "71",
            "style": "v",
            "sid": "JHN 6:71"
          },
          "items": [
            {
              "text": "71",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanga achireva Judhasi, mwanakomana waSimoni Iskarioti, uyo, kunyange akanga ari mumwe wavane gumi navaviri, aizomupandukira.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.6.71",
            "verseOrgIds": [
              "JHN.6.71"
            ]
          }
        }
      ]
    }
