          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paakanga achipona, mumwe wavo akabudisa ruoko rwake; saka vanyamukuta vakatora rushinda rutsvuku vakamusunga paruoko rwake uye vakati, \"Uyu ndiye atanga kubuda.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.28",
            "verseOrgIds": [
              "GEN.38.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 38:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi akati adzosera ruoko rwake mukati, mununʼuna wake akabuda, uye vakati, \"Saka ndiwo mabudiro awaita nhai!\" Uye akatumidzwa zita rokuti Perezi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.29",
            "verseOrgIds": [
              "GEN.38.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 38:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mukoma wake akanga ano rushinda rutsvuku paruoko rwake, akabuda uye akatumidzwa zita rokuti Zera.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.30",
            "verseOrgIds": [
              "GEN.38.30"
            ]
