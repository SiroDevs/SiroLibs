  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "47",
        "style": "c",
        "sid": "GEN 47"
      },
      "items": [
        {
          "text": "47",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 47:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josefa akaenda akandoudza Faro akati, \"Baba vangu namadzikoma angu, pamwe chete nezvipfuwo zvavo uye nemombe dzavo nezvavo zvose, vauya vachibva kunyika yeKenani uye vava muGosheni zvino.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.1",
            "verseOrgIds": [
              "GEN.47.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 47:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akasarudza vashanu pamadzikoma ake akavaendesa pamberi paFaro.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.2",
            "verseOrgIds": [
              "GEN.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 47:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Faro akabvunza madzikoma aJosefa akati, \"Basa renyu ndereiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.3",
            "verseOrgIds": [
              "GEN.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 47:3"
      },
      "items": [
        {
          "text": "Ivo vakapindura Faro vakati, \"Varanda venyu vafudzi, sezvakanga zvakangoita madzibaba edu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.3",
            "verseOrgIds": [
              "GEN.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 47:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakatizve kwaari, \"Tauya kuzogara kuno kwechinguva, nokuti nzara yakanyanya muKenani uye zvipfuwo zvavaranda venyu hazvisisina mafuro. Saka zvino, tapota regai varanda venyu vagare muGosheni.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.4",
            "verseOrgIds": [
              "GEN.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 47:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Faro akati kuna Josefa, \"Baba vako namadzikoma ako vauya kwauri,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.5",
            "verseOrgIds": [
              "GEN.47.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 47:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye nyika yeIjipiti iri pamberi pako; garisa baba vako namadzikoma ako panzvimbo yakanakisisa munyika ino. Ngavagare muGosheni. Uye kana uchiziva kuti pakati pavo pane vamwe vane zvavanokwanisa kuita, uvaite kuti vave vatariri vezvipfuwo zvangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.6",
            "verseOrgIds": [
              "GEN.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 47:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akapinza baba vake Jakobho akavaendesa pamberi paFaro. Shure kwokuropafadzwa kwaFaro naJakobho,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.7",
            "verseOrgIds": [
              "GEN.47.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 47:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Faro akavabvunza akati, \"Mava namakore manganiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.8",
            "verseOrgIds": [
              "GEN.47.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 47:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Jakobho akati kuna Faro, \"Makore okufamba kwangu panyika izana namakumi matatu. Makore angu akanga ari mashoma uye akaoma, uye haaenzani namakore okufamba kwamadzibaba angu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.9",
            "verseOrgIds": [
              "GEN.47.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 47:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jakobho akaropafadza Faro akabva pamberi pake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.10",
            "verseOrgIds": [
              "GEN.47.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 47:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Josefa akagarisa baba vake namadzikoma ake munyika yeIjipiti uye akavapa nzvimbo mudunhu rakanakisisa munyika, dunhu reRamasesi, sokurayira kwaFaro.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.11",
            "verseOrgIds": [
              "GEN.47.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 47:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josefa akapa baba vake namadzikoma ake navose veimba yababa vake zvokudya, zvakaenzana nouwandu hwavana vavo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.12",
            "verseOrgIds": [
              "GEN.47.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Josefa neNzara",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 47:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvakadaro, kwakanga kusina zvokudya munyika yose nokuti nzara yakanga iri huru, nyika yeIjipiti nenyika yeKenani dzakaziya nokuda kwenzara.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.13",
            "verseOrgIds": [
              "GEN.47.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 47:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josefa akaunganidza mari yose yaiwanikwa muIjipiti neKenani yomuripo wezviyo zvavaitenga, uye akaenda nayo kumuzinda waFaro.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.14",
            "verseOrgIds": [
              "GEN.47.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 47:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mari yavanhu veIjipiti nevokuKenani yakati yapera, vanhu veIjipiti yose vakauya kuna Josefa vakati, \"Tipei zvokudya. Tofireiko pamberi penyu? Mari yedu yapera.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.15",
            "verseOrgIds": [
              "GEN.47.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 47:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Josefa akati, \"Uyai nezvipfuwo zvenyu. Ndichakutengeserai zvokudya ndichitsinhanisa nezvipfuwo zvenyu, sezvo mari yenyu yapera.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.16",
            "verseOrgIds": [
              "GEN.47.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 47:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vakauya nezvipfuwo zvavo kuna Josefa, uye akavapa zvokudya achitsinhanisa namabhiza avo, makwai nembudzi dzavo, mombe nembongoro dzavo. Uye akavabudisa mugore iro nezvokudya zvokutsinhana nezvipfuwo zvavo zvose.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.17",
            "verseOrgIds": [
              "GEN.47.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 47:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gore iroro rakati rapera, vakauya kwaari mugore rakatevera vakati, \"Hatingavanziri ishe wedu chokwadi chokuti sezvo mari yedu yakapera uye zvipfuwo zvedu zvava zvenyu, hapasisina chasara chatingapa ishe wedu kunze kwemiviri yedu nenyika yedu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.18",
            "verseOrgIds": [
              "GEN.47.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 47:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tichafireiko pamberi penyu, isu nenyika yeduwo? Titengei isu nenyika yedu titsinhane nezvokudya, uye isu nenyika yedu tichava varanda vaFaro. Tipeiwo mbeu kuitira kuti tirarame uye tirege kufa, uye kuti nyika irege kuparara.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.19",
            "verseOrgIds": [
              "GEN.47.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 47:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Josefa akatengera Faro nyika yose iri muIjipiti. VaIjipita vakatengesa, mumwe nomumwe munda wake, nokuti nzara yakanga iri huru kwazvo. Nyika yakava yaFaro,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.20",
            "verseOrgIds": [
              "GEN.47.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 47:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye Josefa akaita kuti vanhu vave varanda kubva kuna mamwe magumo eIjipiti kusvikira kuna mamwe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.21",
            "verseOrgIds": [
              "GEN.47.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 47:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvakadaro hazvo, haana kutenga nyika yavaprista, nokuti ivo vaigamuchira migove nguva dzose kubva kuna Faro uye vakanga vane zvokudya zvakakwana kubva pamugove wavaipiwa naFaro. Ndokusaka vasina kutengesa nyika yavo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.22",
            "verseOrgIds": [
              "GEN.47.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 47:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josefa akati kuvanhu, \"Zvino zvandakutengai nhasi imi nenyika yenyu kuti muve vaFaro, heyi mbeu yokuti mudyare muminda.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.23",
            "verseOrgIds": [
              "GEN.47.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 47:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi pamunokohwa, mupe chikamu chimwe chete kubva muzvishanu chazvo kuna Faro. Zvimwe zvikamu zvina kubva muzvishanu mungazvichengeta henyu sembeu dzomuminda nezvokudya zvenyu navari mudzimba dzenyu navana venyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.24",
            "verseOrgIds": [
              "GEN.47.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 47:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivo vakati, \"Makaponesa upenyu hwedu. Ngatiwanei hedu nyasha pamberi penyu ishe wedu; tichava varanda kuna Faro.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.25",
            "verseOrgIds": [
              "GEN.47.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 47:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Josefa akasimbisa izvi somurayiro pamusoro penyika muIjipiti, murayiro uyu uchiri kushanda nanhasi, kuti chikamu chimwe chete kubva muzvishanu chezvibereko ndechaFaro. Nyika yavaprista bedzi ndiyo yakanga isiri yaFaro.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.26",
            "verseOrgIds": [
              "GEN.47.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 47:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino vaIsraeri vakagara muIjipiti mudunhu reGosheni. Vakawana pfuma ikoko, vakabereka vana uye vakawanda zvikuru.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.27",
            "verseOrgIds": [
              "GEN.47.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 47:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakobho akagara muIjipiti kwamakore gumi namanomwe, uye akararama kwamakore zana namakumi mana namanomwe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.28",
            "verseOrgIds": [
              "GEN.47.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 47:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nguva yokufa kwaIsraeri yakati yaswedera, akadana mwanakomana wake Josefa uye akati kwaari, \"Kana ndawana nyasha pamberi pako, isa ruoko rwako pasi pechidya changu uye ugovimbisa kuti uchandinzwira ngoni uye uchava wakatendeka. Usandiviga muIjipiti,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.29",
            "verseOrgIds": [
              "GEN.47.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 47:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi pandinozorora namadzibaba angu, mundibudise muIjipiti munondiviga pavakavigwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.30",
            "verseOrgIds": [
              "GEN.47.30"
            ]
          }
        }
      ]
