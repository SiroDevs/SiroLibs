  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "32",
        "style": "c",
        "sid": "GEN 32"
      },
      "items": [
        {
          "text": "32",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jakobho anogadzirira kundosangana naEsau",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 32:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakobho akaendawo nenzira yake, uye vatumwa vaMwari vakasangana naye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.1",
            "verseOrgIds": [
              "GEN.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakobho akati achivaona, akati, \"Uyu ndiwo musasa waMwari!\" Saka akatumidza nzvimbo iyo zita rokuti Mahanaimi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.2",
            "verseOrgIds": [
              "GEN.32.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 32:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakobho akatuma nhume mberi kwake kumukoma wake Esau munyika yeSeiri, iyo nyika yeEdhomu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.3",
            "verseOrgIds": [
              "GEN.32.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akavarayira akati, \"Izvi ndizvo zvamunofanira kutaura kuna tenzi wangu Esau kuti: 'Zvanzi nomuranda wenyu Jakobho, Ndakanga ndichigara naRabhani uye ndakagarako kusvikira zvino.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.4",
            "verseOrgIds": [
              "GEN.32.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndine mombe nembongoro, makwai nembudzi, varandarume navarandakadzi. Zvino ndiri kutuma shoko iri kuna she wangu, kuti ndiwane nyasha pamberi penyu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.5",
            "verseOrgIds": [
              "GEN.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 32:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nhume dzakati dzadzoka kuna Jakobho, dzakati kwaari, \"Takaenda kumukoma wenyu Esau, uye ari kuuya zvino kuzosangana nemi, uye ana varume mazana mana.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.6",
            "verseOrgIds": [
              "GEN.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 32:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jakobho akatya zvikuru uye akatambudzika, akaparadzanisa vanhu vaakanga anavo mumapoka maviri, uye makwai nemombe nengamerawo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.7",
            "verseOrgIds": [
              "GEN.32.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akafunga akati, \"Kana Esau akasvika akaparadza rimwe boka, boka rasara ringapunyuka.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.8",
            "verseOrgIds": [
              "GEN.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 32:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jakobho akanyengetera akati, \"Haiwa Mwari wababa vangu Abhurahama, Mwari wababa vangu Isaka, imi Jehovha makati kwandiri, 'Dzokera kunyika yokwako nokuhama dzako, uye ndichaita kuti ubudirire,'",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.9",
            "verseOrgIds": [
              "GEN.32.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ini handina kufanirwa nenyasha dzenyu dzose idzi uye nokutendeka kwamakaratidza muranda wenyu. Ndakanga ndichingova netsvimbo yangu bedzi pandakayambuka Jorodhani urwu, asi zvino ndava mapoka maviri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.10",
            "verseOrgIds": [
              "GEN.32.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 32:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinokumbira kuti mundiponese kubva muruoko rwomukoma wangu Esau, nokuti ndinotya kuti achasvika akandiuraya, uyewo madzimai aya navana vavo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.11",
            "verseOrgIds": [
              "GEN.32.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 32:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi imi makati, 'Zvirokwazvo ndichaita kuti ubudirire uye kuti zvizvarwa zvako zvive sejecha regungwa, risingagoni kuverengwa.' \"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.12",
            "verseOrgIds": [
              "GEN.32.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 32:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapedza usiku hwose ipapo, uye pane zvaakanga anazvo, akatsaurira mukoma wake Esau chipo chaiti:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.13",
            "verseOrgIds": [
              "GEN.32.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 32:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "mazana maviri enhunzvi dzemakwai namakumi maviri enhongo dzembudzi, mazana maviri amatunzvi amakwai namakondobwe makumi maviri,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.14",
            "verseOrgIds": [
              "GEN.32.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 32:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngamera hadzi, makumi matatu navana vadzo, mhou dzemombe makumi mana nehando gumi, mbongoro hadzi makumi maviri uye nehono gumi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.15",
            "verseOrgIds": [
              "GEN.32.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 32:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaita kuti zvichengetwe navaranda vake, boka rimwe nerimwe riri roga, uye akati kuvaranda vake, \"Tungamirai mberi kwangu, uye musiye nzvimbo pakati pamapoka.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.16",
            "verseOrgIds": [
              "GEN.32.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 32:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akarayira uya akanga achitungamirira akati, \"Mukoma wangu Esau paanosangana nemi uye akakubvunza achiti, 'Uri waaniko iwe, uye uri kuendepi, uye pfuma yose iri mberi kwako ndeyani?'",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.17",
            "verseOrgIds": [
              "GEN.32.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 32:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ipapo iwe unofanira kupindura uchiti, 'Ndezvomuranda wenyu Jakobho. Izvi zvipo zvatumirwa kuna she wangu Esau, uye iye ari kutevera mumashure medu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.18",
            "verseOrgIds": [
              "GEN.32.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 32:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akarayirawo wechipiri, wechitatu uye navamwe vose vaitevera mapoka achiti, \"Munofanira kutaura chinhu chimwe chete kuna Esau pamunosangana naye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.19",
            "verseOrgIds": [
              "GEN.32.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 32:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye murangarire kuti, 'Muranda wenyu Jakobho ari kuuya mumashure medu.' \" Nokuti akafunga akati, \"Ndamunyaradza nezvipo zvandiri kumutumira mberi; pandinozomuona, zvichida achandigamuchira.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.20",
            "verseOrgIds": [
              "GEN.32.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 32:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka chipo chaJakobho chakatungamira mberi kwake, asi iye pachake akavata mumusasa. Nokuti akafunga akati, \"Ndichamunyaradza nezvipo zvandiri kutumira mberi; pandinozomuona, zvichida achandigamuchira.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.21",
            "verseOrgIds": [
              "GEN.32.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jakobho anoita mutsimba naMwari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 32:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usiku ihwohwo Jakobho akamuka akatora vakadzi vake vaviri, varandakadzi vake navanakomana vake gumi nomumwe vakayambuka pazambuko reJabhoki.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.22",
            "verseOrgIds": [
              "GEN.32.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 32:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwokuvayambutsa rukova, akayambutsawo zvose zvaakanga anazvo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.23",
            "verseOrgIds": [
              "GEN.32.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 32:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Jakobho akasara ari oga, uye mumwe murume akaita mutsimba naye kusvikira utonga hwatsvuka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.24",
            "verseOrgIds": [
              "GEN.32.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 32:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murume uye paakaona kuti akanga asingagoni kumukunda, akabata pahudyu yaJakobho zvokuti hudyu yakashodogoka paakanga achiita mutsimba nomunhu uyu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.25",
            "verseOrgIds": [
              "GEN.32.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 32:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo murume uya akati, \"Ndirege ndiende, nokuti utonga hwatsvuka.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.26",
            "verseOrgIds": [
              "GEN.32.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 32:26"
      },
      "items": [
        {
          "text": "Asi Jakobho akapindura akati, \"Handingatongokuregei muchienda kusvikira mandiropafadza.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.26",
            "verseOrgIds": [
              "GEN.32.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 32:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murume uya akamubvunza akati, \"Zita rako ndianiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.27",
            "verseOrgIds": [
              "GEN.32.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 32:27"
      },
      "items": [
        {
          "text": "Jakobho akapindura akati, \"Jakobho.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.27",
            "verseOrgIds": [
              "GEN.32.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 32:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo murume uya akati, \"Zita rako harichazonzi Jakobho, asi Israeri, nokuti wakarwa naMwari uye nomunhu ukakunda.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.28",
            "verseOrgIds": [
              "GEN.32.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 32:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakobho akati, \"Ndapota hangu, ndiudzei zita renyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.29",
            "verseOrgIds": [
