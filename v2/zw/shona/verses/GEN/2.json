          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo matenga nenyika zvakapera mukushongedzwa kukuru kwazvo kwose.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.1",
            "verseOrgIds": [
              "GEN.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva rechinomwe Mwari akanga apedza basa raakanga achiita; saka pazuva rechinomwe akazorora pamabasa ake ose.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.2",
            "verseOrgIds": [
              "GEN.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Mwari akaropafadza zuva rechinomwe akariita dzvene nokuti pazuva iro akazorora pabasa rose rokusika raakanga aita.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.3",
            "verseOrgIds": [
              "GEN.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Adhamu naEvha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyi ndiyo rondedzero yamatenga nenyika pazvakasikwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.4",
            "verseOrgIds": [
              "GEN.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "GEN 2:4"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 2:4"
      },
      "items": [
        {
          "text": "Jehovha Mwari paakaita nyika namatenga,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.4",
            "verseOrgIds": [
              "GEN.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye kwakanga kusati kwava namakwenzi esango panyika, uye miriwo yesango yakanga isati yamera, nokuti Jehovha Mwari akanga asati anayisa mvura panyika uye kwakanga kusina munhu wokuzorima panyika,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.5",
            "verseOrgIds": [
              "GEN.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi hova dzaibuda dzichibva pasi uye dzichinyorovesa pasi pose,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.6",
            "verseOrgIds": [
              "GEN.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha Mwari akaumba munhu kubva paguruva revhu uye akafemera mweya woupenyu mumhino dzake, uye munhu akava mupenyu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.7",
            "verseOrgIds": [
              "GEN.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Jehovha Mwari akanga adyara bindu kumabvazuva, muEdheni; uye akaisa munhu waakanga aumba imomo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.8",
            "verseOrgIds": [
              "GEN.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Jehovha Mwari akaita mhando dzose dzemiti kuti dzimere kubva muvhu, miti yaifadza meso uye yakanga yakanaka pakudya. Pakati pebindu pakanga pano muti woupenyu nomuti wokuziva zvakanaka nezvakaipa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.9",
            "verseOrgIds": [
              "GEN.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwizi rwaidiridza bindu rwaiyerera ruchibva muEdheni; kubva imomo rwakaparadzana rukava hova ina.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.10",
            "verseOrgIds": [
              "GEN.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zita rerwokutanga ndiPishoni; runopoterera nomunyika yose yeHavhira, imomo mune goridhe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.11",
            "verseOrgIds": [
              "GEN.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Goridhe romunyika iyoyo rakanaka; uyewo dheriamu nebwe reonikisi zvirimo.)",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.12",
            "verseOrgIds": [
              "GEN.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zita rorwizi rwechipiri ndiGihoni; runopoterera nomunyika yose yeEtiopia.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.13",
            "verseOrgIds": [
              "GEN.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zita rorwizi rwechitatu ndiTigirisi; runoyerera ruchitevedza rutivi rwamabvazuva eAshuri. Uye rwizi rwechina ndiYufuratesi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.14",
            "verseOrgIds": [
              "GEN.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha Mwari akatora munhu akamuisa mubindu reEdheni kuti aririme nokurichengeta.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.15",
            "verseOrgIds": [
              "GEN.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Jehovha Mwari akarayira munhu achiti, \"Wakasununguka kuti udye zvinobva pamuti upi zvawo uri mubindu;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.16",
            "verseOrgIds": [
              "GEN.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi haufaniri kudya zvinobva pamuti wokuziva zvakanaka nezvakaipa, nokuti pauchaudya uchafa zvirokwazvo.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.17",
            "verseOrgIds": [
              "GEN.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha Mwari akati, \"Hazvina kunaka kuti munhu agare ari oga. Ndichamuitira mubatsiri akamukwanira.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.18",
            "verseOrgIds": [
              "GEN.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Jehovha Mwari akanga aumba kubva muvhu, mhuka dzose dzesango neshiri dzose dzedenga. Akazviuyisa kumunhu kuti aone kuti achazvitumidza mazita api, uye chisikwa chipenyu chimwe nechimwe sezvachakatumidzwa nomunhu, ndiro rakava zita racho.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.19",
            "verseOrgIds": [
              "GEN.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka munhu akatumidza mazita kuzvipfuwo zvose, nokushiri dzose dzedenga nemhuka dzose dzesango. Asi kuna Adhamu kwakanga kusina kuwanikwa mubatsiri akamukwanira.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.20",
            "verseOrgIds": [
              "GEN.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Jehovha Mwari akaita kuti munhu avate hope huru; uye paakanga achakavata, akatora rumwe rumbabvu rwomunhu akavhara nenyama nzvimbo yaakarubvisa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.21",
            "verseOrgIds": [
              "GEN.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehovha Mwari akaita mukadzi kubva parumbabvu rwaakanga abvisa pamunhu, uye akamuuyisa kumurume.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.22",
            "verseOrgIds": [
              "GEN.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murume akati,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.23",
            "verseOrgIds": [
              "GEN.2.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 2:23"
      },
      "items": [
        {
          "text": "\"Zvino uyu ibvupa ramapfupa angu",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.23",
            "verseOrgIds": [
              "GEN.2.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 2:23"
      },
      "items": [
        {
          "text": "nenyama yenyama yangu;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.23",
            "verseOrgIds": [
              "GEN.2.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 2:23"
      },
      "items": [
        {
          "text": "achanzi 'mukadzi',",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.23",
            "verseOrgIds": [
              "GEN.2.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 2:23"
      },
      "items": [
        {
          "text": "nokuti akatorwa kubva pamurume.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.23",
            "verseOrgIds": [
              "GEN.2.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuda kwechikonzero ichi, murume achasiya baba namai vake agonamatira kumukadzi wake, uye vachava nyama imwe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.24",
            "verseOrgIds": [
              "GEN.2.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murume nomukadzi wake vakanga vasina kusimira vose, uye havana kutongonyara.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.25",
            "verseOrgIds": [
              "GEN.2.25"
            ]
          }
        }
      ]
    }
  ],
