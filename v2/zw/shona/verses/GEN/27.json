              "GEN.27.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 27:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari ngaakupe dova rokudenga",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.28",
            "verseOrgIds": [
              "GEN.27.28"
            ]
          }
        }
      ]
    },
    {
