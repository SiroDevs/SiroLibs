  "verseCount": 46,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
        "style": "c",
        "sid": "GEN 27"
      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jakobho anowana Maropafadzo aIsaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka akati akwegura uye meso ake akanga aneta zvokuti akanga asisaoni, akadana Esau mwanakomana wake mukuru akati kwaari, \"Mwanakomana wangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.1",
            "verseOrgIds": [
              "GEN.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 27:1"
      },
      "items": [
        {
          "text": "Iye akapindura akati, \"Ndiri pano.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.1",
            "verseOrgIds": [
              "GEN.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka akati, \"Zvino ndava murume mutana uye handizivi zuva rokufa kwangu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.2",
            "verseOrgIds": [
              "GEN.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo zvino tora zvombo zvako, goba rako nouta ugoenda kusango kuti unondivhimirawo mhuka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.3",
            "verseOrgIds": [
              "GEN.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Undigadzirire zvokudya zvinondinakira ugondivigira kuti ndidye, kuitira kuti ndikupe maropafadzo angu ndisati ndafa.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.4",
            "verseOrgIds": [
              "GEN.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Rabheka akanga akateerera Isaka paakanga achitaura nomwanakomana wake Esau. Esau akati aenda kusango kuti andovhima mhuka kuti agouya nayo,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.5",
            "verseOrgIds": [
              "GEN.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rabheka akati kumwanakomana wake Jakobho, \"Tarira, ndanzwa baba vako vachiti kumukoma wako Esau,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.6",
            "verseOrgIds": [
              "GEN.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Ndivigirewo mhuka ugondigadzirira nyama inonaka kuti ndidye kuitira kuti ndigokupa maropafadzo angu ndisati ndafa.'",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.7",
            "verseOrgIds": [
              "GEN.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino, chinzwa mwanakomana wangu, nyatsoteerera uye uite zvandinokuudza.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.8",
            "verseOrgIds": [
              "GEN.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enda kuzvipfuwo unondivigira mbudzana mbiri dzakaisvonaka, kuti ndigogadzirira baba vako nyama inonaka nenzira chaiyo yavanoda.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.9",
            "verseOrgIds": [
              "GEN.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ugoitora uende nayo kuna baba vako kuti vadye, kuitira kuti vagokupa maropafadzo avo vasati vafa.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.10",
            "verseOrgIds": [
              "GEN.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakobho akati kuna Rabheka mai vake, \"Asi mukoma wangu Esau munhu ane mvere, uye ini ndiri munhu ane ganda risina mvere.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.11",
            "verseOrgIds": [
              "GEN.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, kana baba vangu vakandibata? Ndichava somunhu anovanyengera uye ndikazouyisa kutukwa pamusoro pangu pachinzvimbo chokuropafadzwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.12",
            "verseOrgIds": [
              "GEN.27.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mai vake vakati kwaari, \"Mwanakomana wangu, rega kutukwa kuuye pamusoro pangu. Iwe ita zvandinoreva; enda unonditorera idzo.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.13",
            "verseOrgIds": [
              "GEN.27.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka akaenda akandodzitora akauya nadzo kuna mai vake, uye vakagadzira nyama inonaka, nenzira chaiyo yaidikanwa nababa vake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.14",
            "verseOrgIds": [
              "GEN.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Rabheka akatora nguo dzakaisvonaka dzaEsau mwanakomana wake mukuru, dzaakanga anadzo mumba, akadzipfekedza mwanakomana wake muduku iye Jakobho.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.15",
            "verseOrgIds": [
              "GEN.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akafukidzawo namatehwe embudzi, maoko ake uye nenzvimbo dzomutsipa wake dzakanga dzisina mvere.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.16",
            "verseOrgIds": [
              "GEN.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akapa kumwanakomana wake Jakobho nyama inonaka nechingwa chaakanga abika.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.17",
            "verseOrgIds": [
              "GEN.27.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaenda kuna baba vake akati, \"Baba vangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.18",
            "verseOrgIds": [
              "GEN.27.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 27:18"
      },
      "items": [
        {
          "text": "Vakapindura vakati, \"Ndiri pano mwana wangu. Ndianiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.18",
            "verseOrgIds": [
              "GEN.27.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakobho akati kuna baba vake, \"Ndini Esau dangwe renyu. Ndaita sezvamandiudza. Ndapota, mukai mudye nyama yemhuka yangu kuitira kuti mundipe maropafadzo enyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.19",
            "verseOrgIds": [
              "GEN.27.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka akabvunza mwanakomana wake akati, \"Waiwana seiko nokukurumidza zvakadai, mwanakomana wangu?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.20",
            "verseOrgIds": [
              "GEN.27.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 27:20"
      },
      "items": [
        {
          "text": "Iye akapindura akati, \"Jehovha Mwari wenyu aita kuti ndibudirire.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.20",
            "verseOrgIds": [
              "GEN.27.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Isaka akati kuna Jakobho, \"Swedera pedyo kuti ndikubate, mwana wangu, kuti ndizive kana uri Esau mwanakomana wangu chaiye kana kwete.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.21",
            "verseOrgIds": [
              "GEN.27.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakobho akaswedera kuna baba vake Isaka, iye akamubata akati, \"Inzwi, inzwi raJakobho, asi maoko maoko aEsau.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.22",
            "verseOrgIds": [
              "GEN.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haana kugona kumuziva, nokuti maoko ake aiva nemvere dzakaita sedzomukoma wake Esau; saka akamuropafadza.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.23",
            "verseOrgIds": [
              "GEN.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati, \"Ndiwe mwanakomana wangu Esau chaiye here?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.24",
            "verseOrgIds": [
              "GEN.27.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 27:24"
      },
      "items": [
        {
          "text": "Akapindura akati, \"Ndini.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.24",
            "verseOrgIds": [
              "GEN.27.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 27:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akati, \"Mwanakomana wangu, ndipe nyama yako yemhuka ndidye, kuitira kuti ndikupe maropafadzo angu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.25",
            "verseOrgIds": [
              "GEN.27.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 27:25"
      },
      "items": [
        {
          "text": "Jakobho akaiisa kwaari akadya; uye akauya newaini akanwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.25",
            "verseOrgIds": [
              "GEN.27.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo baba vake Isaka vakati kwaari, \"Uya pano mwanakomana wangu unditsvode.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.26",
            "verseOrgIds": [
              "GEN.27.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka akaenda kwaari iye akamutsvoda. Isaka akati anzwa kunhuhwira kwenguo dzake akamuropafadza achiti,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.27",
            "verseOrgIds": [
              "GEN.27.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 27:27"
      },
      "items": [
        {
          "text": "\"Haiwa kunhuhwira kwomwanakomana wangu",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.27",
            "verseOrgIds": [
              "GEN.27.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 27:27"
      },
      "items": [
        {
          "text": "kwakaita sokunhuhwira kwesango",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.27",
            "verseOrgIds": [
              "GEN.27.27"
            ]
          }
        }
      ]
    },
