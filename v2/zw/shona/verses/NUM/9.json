        "number": "9",
        "style": "c",
        "sid": "NUM 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pasika",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akataura kuna Mozisi murenje reSinai mumwedzi wokutanga wegore rechipiri shure kwokubuda kwavo muIjipiti. Akati kwaari,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.1",
            "verseOrgIds": [
              "NUM.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ita kuti vaIsraeri vapemberere Pasika panguva yakatarwa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.2",
            "verseOrgIds": [
              "NUM.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muipemberere panguva yakatarwa, panguva yorubvunzavaeni pazuva regumi namana romwedzi, maererano nemitemo yayo nemirayiro yayo yose.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.3",
            "verseOrgIds": [
              "NUM.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Mozisi akataurira vaIsraeri kuti vapemberere Pasika,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.4",
            "verseOrgIds": [
              "NUM.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ivo vakaita saizvozvo murenje reSinai panguva yorubvunzavaeni nezuva regumi namana romwedzi wokutanga. VaIsraeri vakaita zvose sezvakanga zvarayirwa Mozisi naJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.5",
            "verseOrgIds": [
              "NUM.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vamwe vavo havana kupemberera Pasika nomusi iwoyo nokuti vakanga vasina kuchena nokuda kwechitunha. Saka vakauya kuna Mozisi naAroni musi iwoyo uye,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.6",
            "verseOrgIds": [
              "NUM.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "vakati kuna Mozisi, \"Isu tava vasina kuchena nokuda kwechitunha, asi tinodzivisirweiko kuvigira Jehovha chipiriso pamwe chete navamwe vaIsraeri panguva yakatarwa?\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.7",
            "verseOrgIds": [
              "NUM.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mozisi akavapindura akati, \"Mirai kusvikira ndanzwa zvinorayirwa naJehovha pamusoro penyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.8",
            "verseOrgIds": [
              "NUM.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehovha akati kuna Mozisi,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.9",
            "verseOrgIds": [
              "NUM.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Taurira vaIsraeri kuti: 'Mumwe wenyu kana zvizvarwa zvenyu kana vasvibiswa nokuda kwechitunha uye kana kuti vari parwendo, naivowo vangapemberera Pasika yaJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.10",
            "verseOrgIds": [
              "NUM.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanofanira kuipemberera nezuva regumi namana romwedzi wechipiri panguva dzorubvunzavaeni. Vanofanira kudya gwayana, pamwe chete nechingwa chisina mbiriso nomuriwo unovava.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.11",
            "verseOrgIds": [
              "NUM.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Havafaniri kusiya chinhu kusvikira mangwanani kana kuvhuna mapfupa aro. Pavanopemberera Pasika, vanofanira kutevedza mitemo yose.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.12",
            "verseOrgIds": [
              "NUM.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana munhu akachena uye asiri parwendo akakundikana kupemberera Pasika, munhu uyo anofanira kubviswa pakati pavanhu vokwake nokuti haana kuvigira Jehovha chipiriso panguva yakatarwa. Munhu uyo achatakura zvivi zvake.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.13",
            "verseOrgIds": [
              "NUM.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Mutorwa agere pakati penyu anoda kupemberera Pasika yaJehovha anofanira kuita izvozvo maererano nemitemo nemirayiro yayo. Munofanira kuva nomutemo mumwe chete kumutorwa nokuna akaberekerwa munyika.' \"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.14",
            "verseOrgIds": [
              "NUM.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gore pamusoro peTabhenakeri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva rakamiswa tabhenakeri, iyo Tende yeChipupuriro, gore rakaifukidza. Kubva panguva dzamadekwana kusvikira mangwanani, gore rakanga riri pamusoro petabhenakeri rakanga rakaita somoto.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.15",
            "verseOrgIds": [
              "NUM.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndizvo zvarakaramba rakaita; gore rakaifukidza, uye usiku rairatidzika somoto.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.16",
            "verseOrgIds": [
              "NUM.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gore raiti kana rasimudzwa kubva pamusoro peTende, vaIsraeri vaifamba; pose paimira gore, vaIsraeri vaidzika musasa ipapo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.17",
            "verseOrgIds": [
              "NUM.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakurayira kwaJehovha, vaIsraeri vaifamba, uye pakurayira kwake, vaibva vadzika musasa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.18",
            "verseOrgIds": [
              "NUM.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gore paraimira pamusoro petabhenakeri, ivo vairamba vakadzika musasa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.19",
            "verseOrgIds": [
              "NUM.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dzimwe nguva gore raigara pamusoro petabhenakeri kwamazuva mashomanana chete; vaidzika musasa wavo sokurayira kwaJehovha uye pakurayira kwake, vaibva vafamba.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.20",
            "verseOrgIds": [
              "NUM.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dzimwe nguva gore raingogara kubva panguva dzamadekwana kusvikira mangwanani, uye paraingosimuka mangwanani vaibva vafamba. Paingosimuka gore, angava masikati kana usiku, vaibva vafamba.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.21",
            "verseOrgIds": [
              "NUM.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana gore rikagara pamusoro petabhenakeri kwamazuva maviri kana mwedzi, kana gore rimwe chete, vaIsraeri vairamba vari mumusasa uye vasingafambi; asi kana rikasimuka ivo vaibva vafamba.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.22",
            "verseOrgIds": [
              "NUM.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sokurayira kwaJehovha, vaidzika musasa, uye sokurayira kwaJehovha, vaifamba. Vakateerera kurayira kwaJehovha, maererano nokurayira kwake kubudikidza naMozisi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.23",
            "verseOrgIds": [
              "NUM.9.23"
            ]
          }
        }
      ]
    }
  ],
