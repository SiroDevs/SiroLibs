{
  "id": "NUM.13",
  "number": "13",
  "bookId": "NUM",
  "reference": "Numeri 13",
  "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "NUM 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vasori vanoona nyika yeKenani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kuna Mozisi,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.1",
            "verseOrgIds": [
              "NUM.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tuma vamwe varume kuti vandosora nyika yeKenani, yandiri kupa kuvaIsraeri. Tuma mutungamiri mumwe kubva kurudzi rumwe norumwe rwamadzitateguru avo.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.2",
            "verseOrgIds": [
              "NUM.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka, sokurayira kwaJehovha, Mozisi akavatuma vachibva nokurenje reParani. Vose vakanga vari vatungamiri vavaIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.3",
            "verseOrgIds": [
              "NUM.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haano mazita avo:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "NUM 13:4"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "NUM 13:4"
      },
      "items": [
        {
          "text": "kubva kurudzi rwaRubheni, Shamua mwanakomana waZakuri;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.4",
            "verseOrgIds": [
              "NUM.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubva kurudzi rwaSimeoni, Shafati mwanakomana waHori;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.5",
            "verseOrgIds": [
              "NUM.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubva kurudzi rwaJudha, Karebhu mwanakomana waJefune;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.6",
            "verseOrgIds": [
              "NUM.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubva kurudzi rwaIsakari, Igari mwanakomana waJosefa;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.7",
            "verseOrgIds": [
              "NUM.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubva kurudzi rwaEfuremu, Hoshea mwanakomana waNuni;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.8",
            "verseOrgIds": [
              "NUM.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubva kurudzi rwaBhenjamini, Pareti mwanakomana waRafu;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.9",
            "verseOrgIds": [
              "NUM.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubva kurudzi rwaZebhuruni, Gadhieri mwanakomana waSodhi;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.10",
            "verseOrgIds": [
              "NUM.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubva kurudzi rwaManase (rudzi rwaJosefa), Gadhi mwanakomana waSusi;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.11",
            "verseOrgIds": [
              "NUM.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubva kurudzi rwaDhani, Amieri mwanakomana waGemari;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.12",
            "verseOrgIds": [
              "NUM.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubva kurudzi rwaAsheri, Seturi mwanakomana waMikaeri;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.13",
            "verseOrgIds": [
              "NUM.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubva kurudzi rwaNafutari, Nabhi mwanakomana waVhofisi;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.14",
            "verseOrgIds": [
              "NUM.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubva kurudzi rwaGadhi, Generi mwanakomana waMaki.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.15",
            "verseOrgIds": [
              "NUM.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya ndiwo mazita avarume vakatumwa naMozisi kundosora nyika. (Mozisi akatumidza Hoshea mwanakomana waNuni zita rokuti Joshua).",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mozisi akati avatuma kundosora nyika yeKenani, akati kwavari, \"Kwidzai mupinde nechokuNegevhi uye nomunyika yamakomo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.17",
            "verseOrgIds": [
              "NUM.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundoona kuti nyika yakadini uye kuti vanhu vanogarako vakasimba here kana kuti havana, vashoma here kana kuti vazhinji.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.18",
            "verseOrgIds": [
              "NUM.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyika yavanogara yakadini? Yakanaka here kana kuti yakaipa? Maguta avagere maari akadiniko? Haana masvingo here kana kuti akakomberedzwa?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.19",
            "verseOrgIds": [
              "NUM.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, ivhu racho rakadini? Rakaorera here kana kuti kwete? Mune miti here kana kuti hamuna? Muedze kwazvo kuti muuye nezvimwe zvezvibereko zvenyika iyo.\" (Yakanga iri nguva yokutanga kuibva kwamazambiringa).",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.20",
            "verseOrgIds": [
              "NUM.13.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo vakakwidza vakandosora nyika kubva kurenje reZini kusvikira kuRehobhi, kwakanangana neRebho Hamati.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.21",
            "verseOrgIds": [
              "NUM.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakakwidza vachipinda nechokuNegevhi vakasvika kuHebhuroni paigara Ahimeni, Sheshai naTarimai, zvizvarwa zvaAnaki. (Hebhuroni rakanga ravakwa makore manomwe Zoani risati ravakwa muIjipiti).",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.22",
            "verseOrgIds": [
              "NUM.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati vasvika paMupata weEshikori, vakatema davi rimwe raiva nesumbu ramazambiringa. Vaviri vavo vakaritakura nedanda pakati pavo pamwe chete namatamba uye namaonde.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.23",
            "verseOrgIds": [
              "NUM.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzvimbo iyo yakanzi Mupata weEshikori nokuda kwesumbu ramazambiringa rakatemwa ipapo navaIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.24",
            "verseOrgIds": [
              "NUM.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazuva makumi mana akati apera, vakadzoka kubva kundosora nyika.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.25",
            "verseOrgIds": [
              "NUM.13.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vanozivisa zvokusora kwavo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakadzokera kuna Mozisi naAroni nokuungano yose yavaIsraeri paKadheshi murenje reParani. Ipapo vakazivisa kwavari nokuungano yose uye vakavaratidza zvibereko zvenyika.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.26",
            "verseOrgIds": [
              "NUM.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakapa nhoroondo iyi kuna Mozisi: \"Takaenda kunyika yamakatituma, uye inoerera mukaka nouchi! Hezvi zvibereko zvayo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.27",
            "verseOrgIds": [
              "NUM.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vanhu vanogarako vane simba kwazvo, uye maguta akakomberedzwa uye makuru kwazvo. Takaona kunyange zvizvarwa zvaAnaki ikoko.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.28",
            "verseOrgIds": [
              "NUM.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaAmareki vanogara nechokuNegevhi; vaHiti, vaJebhusi navaAmori vanogara munyika yamakomo; uye vaKenani vanogara pedyo negungwa uye nomunzvimbo inotevedza Jorodhani.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.29",
            "verseOrgIds": [
              "NUM.13.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Karebhu akanyaradza vanhu pamberi paMozisi akati, \"Tinofanira kukwidza tindotora nyika nokuti zvirokwazvo tinogona kuitora.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.30",
            "verseOrgIds": [
              "NUM.13.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi varume vakanga vaenda naye vakati, \"Hatigoni kurwisa vanhu ava; vakasimba kutipfuura isu.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.31",
            "verseOrgIds": [
              "NUM.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vakaparadzira mashoko akaipa pakati pavaIsraeri pamusoro penyika yavakanga vandosora. Vakati, \"Nyika yatakandosora inodya vaya vanogaramo. Vanhu vose vatakaona ikoko vakakura kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.32",
            "verseOrgIds": [
              "NUM.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Takaona vaNefirimi (izvo zvizvarwa zvavaAnaki vanobva kuvaNefirimi) ikoko. Isu tainge mhashu pakuona kwedu, uye tainge takadarowo pakuona kwavo.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.33",
            "verseOrgIds": [
              "NUM.13.33"
            ]
          }
        }
      ]
