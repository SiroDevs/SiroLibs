      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:17"
      },
      "items": [
        {
          "text": "madehenya avanakomana vose vaSeti.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.17",
            "verseOrgIds": [
              "NUM.24.17"
            ]
          }
        }
      ]
    },
    {
