      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:18"
      },
      "items": [
        {
          "text": "Seiri, muvengi wake, achakundwa,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.18",
            "verseOrgIds": [
              "NUM.24.18"
            ]
          }
