      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 24:20"
      },
      "items": [
        {
          "text": "\"Amareki akanga ari wokutanga pakati pendudzi,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.20",
            "verseOrgIds": [
              "NUM.24.20"
            ]
