      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 24:17"
      },
      "items": [
        {
          "text": "Achapwanya huma dzavaMoabhu,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.17",
            "verseOrgIds": [
              "NUM.24.17"
            ]
          }
        }
      ]
