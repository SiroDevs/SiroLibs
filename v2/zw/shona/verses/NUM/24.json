        "sid": "NUM 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Bharamu akati aona kuti zvinofadza Jehovha kuti aropafadze Israeri, haana kuzoita zvouroyi sepane dzimwe nguva, asi akaringisa chiso chake kurenje.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.1",
            "verseOrgIds": [
              "NUM.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bharamu akati atarisa kunze akaona vaIsraeri vagere pamusasa, rudzi norudzi, Mweya waMwari wakauya pamusoro pake",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.2",
            "verseOrgIds": [
              "NUM.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye akataura chirevo chake achiti:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.3",
            "verseOrgIds": [
              "NUM.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 24:3"
      },
      "items": [
        {
          "text": "\"Chirevo chaBharamu mwanakomana waBheori,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.3",
            "verseOrgIds": [
              "NUM.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:3"
      },
      "items": [
        {
          "text": "chirevo chaiye ana meso anonyatsoona,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.3",
            "verseOrgIds": [
              "NUM.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "chirevo chaiye anonzwa mashoko aMwari,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.4",
            "verseOrgIds": [
              "NUM.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:4"
      },
      "items": [
        {
          "text": "anoona chiratidzo chinobva kuna Wamasimba Ose,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.4",
            "verseOrgIds": [
              "NUM.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:4"
      },
      "items": [
        {
          "text": "anowira pasi nedumbu rake, uye ana meso akasvinura.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.4",
            "verseOrgIds": [
              "NUM.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Matende ako akanaka seiko, iwe Jakobho,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.5",
            "verseOrgIds": [
              "NUM.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:5"
      },
      "items": [
        {
          "text": "nougaro hwako, iwe Israeri!",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.5",
            "verseOrgIds": [
              "NUM.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Semipata, vakaita fararira,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.6",
            "verseOrgIds": [
              "NUM.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:6"
      },
      "items": [
        {
          "text": "samapindu pedyo norwizi,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.6",
            "verseOrgIds": [
              "NUM.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 24:6"
      },
      "items": [
        {
          "text": "segavakava rakasimwa naJehovha, s",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.6",
            "verseOrgIds": [
              "NUM.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:6"
      },
      "items": [
        {
          "text": "semisidhari pedyo nemvura.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.6",
            "verseOrgIds": [
              "NUM.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mvura ichayerera ichibva muzvirongo zvavo;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.7",
            "verseOrgIds": [
              "NUM.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:7"
      },
      "items": [
        {
          "text": "mbeu dzavo dzichawana mvura yakawanda.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.7",
            "verseOrgIds": [
              "NUM.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "NUM 24:7"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 24:7"
      },
      "items": [
        {
          "text": "\"Mambo wavo achava mukuru kupinda Agagi;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.7",
            "verseOrgIds": [
              "NUM.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:7"
      },
      "items": [
        {
          "text": "umambo hwavo huchasimudzirwa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.7",
            "verseOrgIds": [
              "NUM.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mwari akavabudisa muIjipiti;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.8",
            "verseOrgIds": [
              "NUM.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:8"
      },
      "items": [
        {
          "text": "vane simba renyati.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.8",
            "verseOrgIds": [
              "NUM.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 24:8"
      },
      "items": [
        {
          "text": "Vanomedza ndudzi dzine hasha",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.8",
            "verseOrgIds": [
              "NUM.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:8"
      },
      "items": [
        {
          "text": "uye vanovhuna-vhuna mapfupa adzo;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.8",
            "verseOrgIds": [
              "NUM.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:8"
      },
      "items": [
        {
          "text": "Vanovabaya nemiseve yavo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.8",
            "verseOrgIds": [
              "NUM.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seshumba vanoti vhumba vagovata pasi,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.9",
            "verseOrgIds": [
              "NUM.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:9"
      },
      "items": [
        {
          "text": "seshumbakadzi, ndianiko angashinga kuvamutsa?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.9",
            "verseOrgIds": [
              "NUM.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "NUM 24:9"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 24:9"
      },
      "items": [
        {
          "text": "\"Vose vanokuropafadza, ngavaropafadzwe",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.9",
            "verseOrgIds": [
              "NUM.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:9"
      },
      "items": [
        {
          "text": "uye vose vanokutuka, ngavatukwe!\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.9",
            "verseOrgIds": [
              "NUM.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo kutsamwa kwaBharaki kwakapfuta pamusoro paBharamu. Akarova maoko ake pamwe chete akati kwaari, \"Ndakakudanira kuzotuka vavengi vangu, asi wavaropafadza katatu kose aka.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.10",
            "verseOrgIds": [
              "NUM.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino chibva izvozvi uende kwako! Ndakati ndichakupa mubayiro wakaisvonaka, asi Jehovha akudzivisa kuti upiwe mubayiro.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.11",
            "verseOrgIds": [
              "NUM.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bharamu akapindura Bharaki akati, \"Ko, handina kutaurira nhume dzawakatuma kwandiri here kuti,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.12",
            "verseOrgIds": [
              "NUM.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Kunyange dai Bharaki andipa muzinda wake wakazara nesirivha negoridhe, handaigona kuita chinhu nokuda kwangu, chakanaka kana chakaipa, kuti ndidarike murayiro waJehovha, uye kuti ndinofanira kutaura chete zvinenge zvataurwa naJehovha here'?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.13",
            "verseOrgIds": [
              "NUM.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino ndava kudzokera kuvanhu vokwangu, asi uya ndikuyambire zvichaitirwa vanhu vako navanhu ava pamazuva anouya.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.14",
            "verseOrgIds": [
              "NUM.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chirevo chaBharamu Chechina",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
