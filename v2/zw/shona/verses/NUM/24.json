      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:17"
      },
      "items": [
        {
          "text": "Tsvimbo youshe ichamera kubva muna Israeri.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.17",
            "verseOrgIds": [
              "NUM.24.17"
            ]
          }
        }
      ]
