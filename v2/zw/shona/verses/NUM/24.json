      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 24:15"
      },
      "items": [
        {
          "text": "\"Chirevo chaBharamu mwanakomana waBheori,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.15",
            "verseOrgIds": [
              "NUM.24.15"
            ]
          }
        }
      ]
