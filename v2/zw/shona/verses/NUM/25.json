  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "NUM 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Moabhu anonyengera Israeri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva yakanga igere Israeri paShitimu, varume vakatanga kuita upombwe navakadzi vokuMoabhu,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.1",
            "verseOrgIds": [
              "NUM.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "avo vakavakoka kuti vauye kuzvibayiro zvavamwari vavo. Vanhu vakadya, vakapfugamira vamwari ava.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.2",
            "verseOrgIds": [
              "NUM.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Israeri akabatana navo pakunamata Bhaari wePeori, uye kutsamwa kwaJehovha kukapfuta pamusoro pavo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.3",
            "verseOrgIds": [
              "NUM.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kuna Mozisi, \"Tora vatungamiri vose vavanhu ava, uvauraye uvaise pachena masikati machena pamberi paJehovha, kuti kutsamwa kunotyisa kwaJehovha kudzorwe kubva pana Israeri.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.4",
            "verseOrgIds": [
              "NUM.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Mozisi akati kuvatongi veIsraeri, \"Mumwe nomumwe wenyu anofanira kuuraya varume ava vari pakati penyu, avo vakazvibatanidza pakunamata Bhaari wePeori.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.5",
            "verseOrgIds": [
              "NUM.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mumwe murume muIsraeri akauyisa kumhuri yake mukadzi womuMidhiani pamberi paMozisi chaipo, ungano yose yaIsraeri pavakanga vachichema vari pamukova weTende Rokusangana.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.6",
            "verseOrgIds": [
              "NUM.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Finehasi mwanakomana waEreazari, mwanakomana waAroni, muprista, akati achizviona, akabva paungano, akatora pfumo muruoko rwake;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.7",
            "verseOrgIds": [
              "NUM.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye akatevera muIsraeri uyo mutende. Akavabaya vose vari vaviri nepfumo kamwe chete, rikabaya muIsraeri rikapfuurira kundobaya muviri womuMidhiani. Ipapo denda rakanga riri pamusoro pavaIsraeri rakaguma;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.8",
            "verseOrgIds": [
              "NUM.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi vose vakanga vafa nedenda vakasvika zviuru makumi maviri nezvina.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.9",
            "verseOrgIds": [
              "NUM.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kuna Mozisi,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.10",
            "verseOrgIds": [
              "NUM.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Finehasi mwanakomana waEreazari, mwanakomana waAroni, muprista adzora kutsamwa kwangu kubva pavaIsraeri; nokuti akanga ane shungu sedzangu nokuda kwokusakudzwa kwangu pakati pavo, saka handina kuzovaparadza neshungu dzangu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.11",
            "verseOrgIds": [
              "NUM.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo umuudze kuti ndava kuita sungano yorugare naye.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.12",
            "verseOrgIds": [
              "NUM.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye nezvizvarwa zvake vachava nesungano youprista husingaperi, nokuti akanga ane shungu nokukudzwa kwaMwari wake, akayananisira vaIsraeri.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.13",
            "verseOrgIds": [
              "NUM.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zita romuIsraeri akaurayiwa pamwe chete nomukadzi muMidhiani rainzi Zimuri mwanakomana waSaru, mutungamiri weimwe mhuri yaSimeoni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.14",
            "verseOrgIds": [
              "NUM.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye zita romukadzi muMidhiani akaurayiwa rakanga richinzi Kozibhi, mwanasikana waZuri, mukuru weimwe mhuri yavaMidhiani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.15",
            "verseOrgIds": [
              "NUM.25.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kuna Mozisi,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.16",
            "verseOrgIds": [
              "NUM.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Muone vaMidhiani savavengi uye mugovauraya,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.17",
            "verseOrgIds": [
              "NUM.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti ivo vakakuonai savavengi pavakakunyengerai paPeori uye nehanzvadzi yavo Kozibhi, mwanasikana womutungamiri wavaMidhiani, iye mukadzi akaurayiwa pakauya denda nokuda kwePeori.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.18",
            "verseOrgIds": [
              "NUM.25.18"
            ]
          }
        }
      ]
    }
  ],
