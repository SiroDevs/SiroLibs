  "bookId": "ZEC",
  "reference": "Zekaria 8",
  "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "ZEC 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jehovha anovimbisa kuropafadza Jerusarema",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shoko raJehovha Wamasimba Ose rakasvikazve kwandiri richiti:",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.1",
            "verseOrgIds": [
              "ZEC.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvanzi naJehovha Wamasimba Ose: \"Ndine godo kwazvo pamusoro peZioni; ndiri kutsva negodo pamusoro paro.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.2",
            "verseOrgIds": [
              "ZEC.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvanzi naJehovha: \"Ndichadzokera kuZioni uye ndichagara muJerusarema. Ipapo Jerusarema richanzi Guta reZvokwadi, uye gomo raJehovha Wamasimba Ose richanzi Gomo Dzvene.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.3",
            "verseOrgIds": [
              "ZEC.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvanzi naJehovha Wamasimba Ose: \"Varume navakadzi vakwegura vachagarazve mumigwagwa yeJerusarema, mumwe nomumwe aine mudonzvo muruoko nokuda kwokukwegura kwake.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.4",
            "verseOrgIds": [
              "ZEC.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Migwagwa yeguta ichazara navakomana navasikana vanotambamo.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.5",
            "verseOrgIds": [
              "ZEC.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvanzi naJehovha Wamasimba Ose: \"Zvingaita sezvinoshamisa kuna vakasara vavanhu ava panguva iyoyo, asi zvichaita sezvinoshamisa here kwandiri?\" ndizvo zvinotaura Jehovha Wamasimba Ose.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.6",
            "verseOrgIds": [
              "ZEC.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvanzi naJehovha Wamasimba Ose: \"Ndichaponesa vanhu vangu kubva kunyika dzokumabvazuva nedzokumavirira.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.7",
            "verseOrgIds": [
              "ZEC.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichavadzosazve kuti vazogara muJerusarema; vachava vanhu vangu, uye ndichava akatendeka uye akarurama kwavari saMwari wavo.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.8",
            "verseOrgIds": [
              "ZEC.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvanzi naJehovha Wamasimba Ose: \"Imi munonzwa mashoko aya iye zvino, akataurwa navaprofita vaivapo nheyo dzemba yaJehovha Wamasimba Ose padzakateyiwa, maoko enyu ngaasimbe kuti temberi igovakwa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.9",
            "verseOrgIds": [
              "ZEC.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nguva iyoyo isati yasvika kwakanga kusina munhu aishandira mubayiro kana chipfuwo. Hapana aienda kundoita basa rake norugare nokuda kwomuvengi wake, nokuti ndakanga ndarwisanisa munhu wose nomuvakidzani wake.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.10",
            "verseOrgIds": [
              "ZEC.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi zvino handichazoitiri vanhu ava vakasara sezvandakaita pamazuva akare,\" ndizvo zvinotaura Jehovha Wamasimba Ose.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.11",
            "verseOrgIds": [
              "ZEC.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mbeu ichakura zvakanaka, muzambiringa uchabereka zvibereko zvawo, nyika ichabereka zvirimwa zvayo, uye matenga achaburutsa dova rawo. Ndichapa zvinhu zvose izvi senhaka kuna vakasara vavanhu ava.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.12",
            "verseOrgIds": [
              "ZEC.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sezvamaiva chinhu chakatukwa pakati pendudzi, imi Judha neIsraeri, saizvozvo ndichakuponesai, uye muchava chinhu chinoropafadza. Musatya, asi itai kuti maoko enyu asimbe.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.13",
            "verseOrgIds": [
              "ZEC.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvanzi naJehovha Wamasimba Ose: \"Sezvandakanga ndafunga kuuyisa njodzi pamusoro penyu, uye ndikasaitira madzibaba enyu tsitsi paakanditsamwisa,\" ndizvo zvinotaura Jehovha Wamasimba Ose,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.14",
            "verseOrgIds": [
              "ZEC.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEC 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"saka zvino ndafunga kuita zvakanakazve kuJerusarema neJudha. Musatya.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.15",
            "verseOrgIds": [
              "ZEC.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ZEC 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izvi ndizvo zvinhu zvamunofanira kuita: Tauriranai chokwadi, uye tongai nezvokwadi uye nokururamisira mumatare enyu",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.16",
            "verseOrgIds": [
              "ZEC.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ZEC 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "usarongera muvakidzani wako zvakaipa, uye usafarira kupika nhema. Ndinovenga zvose izvi,\" ndizvo zvinotaura Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.17",
            "verseOrgIds": [
              "ZEC.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ZEC 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shoko raJehovha Wamasimba Ose rakasvikazve kwandiri richiti:",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.18",
            "verseOrgIds": [
              "ZEC.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ZEC 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvanzi naJehovha Wamasimba Ose: \"Kutsanya kwomwedzi wechina, wechishanu, wechinomwe nowegumi kuchava nguva dzomufaro nokupembera, nemitambo yomufaro kuna Judha. Naizvozvo mude zvokwadi norugare.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.19",
            "verseOrgIds": [
              "ZEC.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ZEC 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvanzi naJehovha Wamasimba Ose: \"Vanhu vazhinji navagari vomumaguta mazhinji vachauyazve,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.20",
            "verseOrgIds": [
              "ZEC.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ZEC 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye vagari vomune rimwe guta vachaenda kune rimwe vachinoti, 'Ngatiendei nokuchimbidza kundokumbira nyasha kuna Jehovha, nokutsvaka Jehovha Wamasimba Ose. Ini pachangu ndiri kuenda.'",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.21",
            "verseOrgIds": [
              "ZEC.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ZEC 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye vanhu vazhinji nendudzi dzine simba vachauya kuJerusarema kuzotsvaka Jehovha Wamasimba Ose nokukumbira nyasha kwaari.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.22",
            "verseOrgIds": [
              "ZEC.8.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ZEC 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvanzi naJehovha Wamasimba Ose: \"Mumazuva iwayo varume gumi kubva kundimi dzose nendudzi dzose vachabatirira kwazvo pamupendero wenguo yomuJudha vachiti, 'Ngatiendei tose, nokuti takanzwa kuti Mwari anewe.' \"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.23",
            "verseOrgIds": [
              "ZEC.8.23"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "ZEC.9",
    "number": "9",
