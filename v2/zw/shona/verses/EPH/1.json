  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "EPH 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EPH 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pauro, mupostori waKristu Jesu nokuda kwaMwari, kuvatsvene vari muEfeso, vakatendeka muna Kristu Jesu:",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.1",
            "verseOrgIds": [
              "EPH.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EPH 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasha norugare zvinobva kuna Mwari Baba vedu nokuna Ishe Jesu Kristu ngazvive kwamuri.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.2",
            "verseOrgIds": [
              "EPH.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maropafadzo oMweya muna Kristu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EPH 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaarumbidzwe Mwari Baba vaIshe wedu Jesu Kristu, iye akatiropafadza muchadenga nokuropafadza kwose kwomweya muna Kristu Jesu.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.3",
            "verseOrgIds": [
              "EPH.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EPH 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti akatisarudza maari nyika isati yasikwa kuti tive vatsvene vasina chavanopomerwa pamberi pake. Murudo",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.4",
            "verseOrgIds": [
              "EPH.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EPH 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "akatirongera kare kuti tigoitwa vana vake kubudikidza naJesu Kristu, maererano nomufaro wake uye nokuda kwake,",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.5",
            "verseOrgIds": [
              "EPH.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EPH 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti kunakisisa kwenyasha dzake dzaakangotipa hake muna Iye waanoda kurumbidzwe.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.6",
            "verseOrgIds": [
              "EPH.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EPH 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye watine dzikunuro maari kubudikidza neropa rake, iko kuregererwa kwezvivi, zviri maererano nokupfuma kwenyasha dzaMwari",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.7",
            "verseOrgIds": [
              "EPH.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EPH 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "dzaakawanza pamusoro pedu nouchenjeri hwose uye nokunzwisisa kwose.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.8",
            "verseOrgIds": [
              "EPH.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EPH 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye akazivisa kwatiri chakavanzika chokuda kwake, maererano nomufaro wake wakanaka, waakafunga muna Kristu, kuti chiitwe pakukwana kwenguva,",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.9",
            "verseOrgIds": [
              "EPH.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EPH 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "auyise pamwe chete zvinhu zvose zviri kudenga nezviri panyika pasi pomusoro mumwe, anova Kristu.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.10",
            "verseOrgIds": [
              "EPH.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EPH 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye watakasarudzwawo maari, tarongerwa kare nhaka maererano nokuronga kwaiye anoita zvose mukusimbisa vavariro yokuda kwake,",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.11",
            "verseOrgIds": [
              "EPH.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EPH 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuitira kuti isu, vakatanga kuva netariro muna Kristu, tive rumbidzo yokubwinya kwake.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.12",
            "verseOrgIds": [
              "EPH.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EPH 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nemi makaiswawo muna Kristu pamakanzwa shoko rechokwadi, iro vhangeri rokuponeswa kwenyu. Makati matenda, makaiswa rupau maari nechisimbiso, icho chivimbiso choMweya Mutsvene,",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.13",
            "verseOrgIds": [
              "EPH.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EPH 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "anova ndiye rubatso runotitsidzira nhaka yedu kusvikira rudzikinuro rwaavo vari vaMwari chaivo rwaratidzwa, kuti kubwinya kwake kurumbidzwe.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.14",
            "verseOrgIds": [
              "EPH.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuvonga noKunyengetera",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EPH 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuda kwaizvozvi, pandakanzwa nezvokutenda kwenyu muna Ishe Jesu uye rudo rwenyu kuvatsvene vose,",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.15",
            "verseOrgIds": [
              "EPH.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EPH 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "handina kurega kuvonga nokuda kwenyu, ndichikurangarirai muminyengetero yangu.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.16",
            "verseOrgIds": [
              "EPH.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EPH 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinoramba ndichikumbira kuti Mwari waIshe wedu Jesu Kristu, Baba vokubwinya, akupei mweya wouchenjeri nokuzarurirwa, kuitira kuti mumuzive zviri nani.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.17",
            "verseOrgIds": [
              "EPH.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EPH 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinonyengeterawo kuti meso emwoyo wenyu avhenekerwe kuitira kuti mugoziva pfuma yenhaka yake yokubwinya muvatsvene,",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.18",
            "verseOrgIds": [
              "EPH.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EPH 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye nesimba rake guru risingagoni kuenzaniswa kwatiri isu vanotenda. Iroro simba rakaita sokubata kwesimba rake guru,",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.19",
            "verseOrgIds": [
              "EPH.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EPH 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "raakaita muna Kristu paakamumutsa kubva kuvakafa akamugarisa kuruoko rwake rworudyi mudenga,",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.20",
            "verseOrgIds": [
              "EPH.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EPH 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamusoro poutongi hwose noukuru, nesimba noushe, uye namazita ose angagona kurehwa, kwete panyika yazvino chete asiwo pane ichauya.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.21",
            "verseOrgIds": [
              "EPH.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EPH 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Mwari akaisa zvinhu zvose pasi petsoka dzake akamugadza kuti ave musoro wezvinhu zvose nokuda kwekereke,",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.22",
            "verseOrgIds": [
              "EPH.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EPH 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "iwo muviri wake, kuzara kwaiye anozadza zvinhu zvose munzira dzose.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.23",
            "verseOrgIds": [
              "EPH.1.23"
            ]
          }
        }
      ]
    }
  ],
