                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.21",
            "verseOrgIds": [
              "EXO.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "kodwa ilowo lalowowesifazana uzakucela kumakhelwana wakhe, lakuye ohlala endlini yakhe, izinto eziligugu zesiliva, lezinto eziligugu zegolide, lemvunulo; lizakuzinika amadodana enu lamadodakazi enu; lizakuwaphanga amaGibithe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.22",
            "verseOrgIds": [
              "EXO.3.22"
            ]
          }
        }
