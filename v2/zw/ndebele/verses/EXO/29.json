    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yilokhu ozakukwenza kubo ukubahlukanisa ukuba babe ngabapristi bokuphatha umsebenzi wami. Thatha inkabi lenqama ezimbili ezingelasici,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.1",
            "verseOrgIds": [
              "EXO.29.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.8.1+LEV.8.2+LEV.8.3+LEV.8.4+LEV.8.5+LEV.8.6+LEV.8.7+LEV.8.8+LEV.8.9+LEV.8.10+LEV.8.11+LEV.8.12+LEV.8.13+LEV.8.14+LEV.8.15+LEV.8.16+LEV.8.17+LEV.8.18+LEV.8.19+LEV.8.20+LEV.8.21+LEV.8.22+LEV.8.23+LEV.8.24+LEV.8.25+LEV.8.26+LEV.8.27+LEV.8.28+LEV.8.29+LEV.8.30+LEV.8.31+LEV.8.32+LEV.8.33+LEV.8.34+LEV.8.35+LEV.8.36"
              },
              "items": [
                {
                  "text": "Levi 8:1–36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.1",
            "verseOrgIds": [
              "EXO.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "lesinkwa esingelamvubelo lamaqebelengwana angelamvubelo ahlanganiswe lamafutha, lezinkwa ezincinyane ezingelamvubelo ezigcotshwe ngamafutha, okwenze ngempuphu ecolekileyo; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.2",
            "verseOrgIds": [
              "EXO.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukufake esitsheni sibe sinye, ukulethe ngesitsha kanye lenkabi lenqama ezimbili. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.3",
            "verseOrgIds": [
              "EXO.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usondeze uAroni lamadodana akhe emnyango wethente lokuhlangana, ubagezise ngamanzi; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.4",
            "verseOrgIds": [
              "EXO.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "uthathe izambatho, ugqokise uAroni ibhatshi, lesambatho esiyingubo yamahlombe, lengubo yamahlombe, lengubo yesifuba, umbophe ngebhanti elalukiweyo lengubo yamahlombe, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.5",
            "verseOrgIds": [
              "EXO.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "umthwalise iqhiye ekhanda lakhe lomqhele ongcwele phezu kweqhiye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.6",
            "verseOrgIds": [
              "EXO.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uthathe amagcobo okugcoba, uwathele ekhanda lakhe, umgcobe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.7",
            "verseOrgIds": [
              "EXO.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usondeze lamadodana akhe uwambathise amabhatshi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.8",
            "verseOrgIds": [
              "EXO.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubabophe ngamabhanti uAroni lamadodana akhe, ubathwalise izingowane, baphathe ubupristi ngesimiso esingapheliyo. Ngalindlela uzakugcoba uAroni lamadodana akhe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.9",
            "verseOrgIds": [
              "EXO.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.9",
            "verseOrgIds": [
              "EXO.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzakuletha inkunzi phambi kwethente lokuhlangana, ukuba uAroni lamadodana akhe babeke izandla zabo ekhanda lenkunzi; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.10",
            "verseOrgIds": [
              "EXO.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "uyihlabe inkunzi phambi kweNkosi ngasemnyango wethente lokuhlangana, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.11",
            "verseOrgIds": [
              "EXO.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "uthathe igazi lenkunzi, ulininde empondweni zealtare ngomunwe wakho, uthululele lonke igazi eliseleyo phansi ngasealtareni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.12",
            "verseOrgIds": [
              "EXO.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzathatha lonke idanga lemibilini, lamahwahwa angaphezu kwesibindi, lezinso zombili lamahwahwa azo, ukutshise ealtareni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.13",
            "verseOrgIds": [
              "EXO.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa inyama yenkunzi lesikhumba sayo lomswane wayo ukutshise ngomlilo ngaphandle kwezihonqo, ngoba kungumnikelo wesono.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.14",
            "verseOrgIds": [
              "EXO.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.14",
            "verseOrgIds": [
              "EXO.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzathatha inqama ibenye; uAroni lamadodana akhe babeke izandla zabo ekhanda lenqama. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.15",
            "verseOrgIds": [
              "EXO.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyihlabe inqama, uthathe igazi layo, ulikhaphazele ealtareni inxa zonke. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.16",
            "verseOrgIds": [
              "EXO.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyihlahlele inqama, ugezise imibilini yayo lemilenze yayo, ukubeke ndawonye lezitho zayo lekhanda layo, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.17",
            "verseOrgIds": [
              "EXO.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "utshise yonke inqama ealtareni, kube ngumnikelo wokutshiswa eNkosini, iphunga elimnandi, lomnikelo owenzelwe iNkosi ngomlilo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.18",
            "verseOrgIds": [
              "EXO.29.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.2"
              },
              "items": [
                {
                  "text": "Efe 5:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.4.18"
              },
              "items": [
                {
                  "text": "Fil 4:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.18",
            "verseOrgIds": [
              "EXO.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzathatha enye inqama; uAroni lamadodana akhe babeke izandla zabo ekhanda layo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.19",
            "verseOrgIds": [
              "EXO.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyihlabe, uthathe igazi layo, ulininde oqwangeni lwendlebe yokunene kaAroni, lasoqwangeni lwezindlebe zokunene zamadodana akhe, lasezithupheni zezandla zabo zokunene, lasemazwaneni amakhulu enyawo zabo zokunene, igazi eliseleyo likhatshazelwe ealtareni inxa zonke. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.20",
            "verseOrgIds": [
              "EXO.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzathatha igazi elisealtareni lamagcobo okugcoba, umchele ngakho uAroni lezambatho zakhe, lamadodana akhe, lezambatho zamadodana akhe, ukuba abe ngcwele lezambatho zakhe, lamadodana akhe lezambatho zawo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.21",
            "verseOrgIds": [
              "EXO.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uthathe amahwahwa enqama, lomsila ononileyo, ledanga lemibilini, lamahwahwa angaphezu kwesibindi, lezinso zombili, lamahwahwa azo, lomlenze wokunene, ngoba iyinqama yokugcotshwa kompristi; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.22",
            "verseOrgIds": [
              "EXO.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "uthathe isinkwa sibe sinye, leqebelengwana libe linye elilamafutha, lesinkwa esincinyane sibe sinye, esitsheni sesinkwa esingelamvubelo esiphambi kweNkosi, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.23",
            "verseOrgIds": [
              "EXO.29.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukubeke konke ezandleni zikaAroni lasezandleni zamadodana akhe, ukuzunguze ukuba kube ngumnikelo wokuzunguzwa phambi kweNkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.24",
            "verseOrgIds": [
              "EXO.29.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukuthathe ezandleni zabo, ukutshise ealtareni phezu komnikelo wokutshiswa, ukuba kube liphunga elimnandi phambi kweNkosi; ngoba kungumnikelo owenzelwe iNkosi ngomlilo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.25",
            "verseOrgIds": [
              "EXO.29.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzathatha isifuba senqama yokugcotshwa kukaAroni, usizunguze ukuba sibe ngumnikelo wokuzunguzwa phambi kweNkosi, sibe yisabelo sakho. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.26",
            "verseOrgIds": [
              "EXO.29.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzakusahlukanisela isifuba somnikelo wokuzunguzwa lomlenze womnikelo wokuphakanyiswa ozunguzwayo, okwenqama yokugcotshwa kompristi ngoba enikelelwa uAroni lamadodana akhe; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.27",
            "verseOrgIds": [
              "EXO.29.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuzakuba ngokukaAroni lokwamadodana akhe, kube yimfanelo engapheliyo kwabakoIsrayeli; ngoba kuyisabelo sabapristi esivela eminikelweni yokuthula yabakoIsrayeli; kungumnikelo wabo onikelwa eNkosini.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.28",
            "verseOrgIds": [
              "EXO.29.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.28",
            "verseOrgIds": [
              "EXO.29.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izambatho ezingcwele zikaAroni zizakuba ngezamadodana akhe emva kwakhe, ukuba agcotshwe, ahlukaniselwe, embethe zona. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.29",
            "verseOrgIds": [
              "EXO.29.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indodana engumpristi endaweni yakhe izakuzambatha insuku eziyisikhombisa nxa ingena ethenteni lokuhlangana ukuyakhonza endaweni engcwele.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.30",
            "verseOrgIds": [
              "EXO.29.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.30",
            "verseOrgIds": [
              "EXO.29.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 29:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzakuthatha inqama yokugcotshwa kompristi, upheke inyama yayo endaweni engcwele. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.31",
            "verseOrgIds": [
              "EXO.29.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 29:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "UAroni lamadodana akhe badle inyama yenqama lesinkwa esisesitsheni ngasemnyango wethente lokuhlangana, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.32",
            "verseOrgIds": [
              "EXO.29.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 29:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "badle lezozinto okwenziwa ngazo indlela yokubuyisana ekugcotshweni kwabo lekwahlukaniselweni kwabo; kodwa owemzini angazidli ngoba zingcwele. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.33",
            "verseOrgIds": [
              "EXO.29.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 29:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba kusala inyama yokugcotshwa kompristi lesinkwa kuze kuse, ukutshise ngomlilo, kungadliwa, ngoba kungcwele. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.34",
            "verseOrgIds": [
              "EXO.29.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 29:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzakwenza njalo kuAroni lamadodana akhe njengokukulaya kami, ukugcotshwa kwabo kuthathe insuku eziyisikhombisa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.35",
            "verseOrgIds": [
              "EXO.29.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 29:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Insuku ngensuku unikele inkunzi ibe ngumnikelo wesono wokubuyisana; futhi uzakunikelela ialtare umnikelo wesono lapho ulenzele indlela yokubuyisana, uligcobe ukuba ulahlukanisele. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.36",
            "verseOrgIds": [
              "EXO.29.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 29:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulenzele ialtare indlela yokubuyisana insuku eziyisikhombisa, ulahlukanisele ialtare, ukuba libe ngcwele kakhulu; lakho konke okulithintayo kuzakuba ngcwele.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.37",
            "verseOrgIds": [
              "EXO.29.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 29:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.37",
            "verseOrgIds": [
              "EXO.29.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 29:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yilokhu ozakukunikela ealtareni; amawundlu amabili alomnyaka munye insuku ngensuku njalonjalo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.38",
            "verseOrgIds": [
              "EXO.29.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 29:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elinye iwundlu uzanikela ngalo ekuseni, elinye unikele ngalo kusihlwa ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.39",
            "verseOrgIds": [
              "EXO.29.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EXO 29:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "kanye lelinye iwundlu unikele ingxenye ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.40",
            "verseOrgIds": [
              "EXO.29.40"
            ]
          }
        },
        {
          "text": " lempuphu ecolekileyo ixubene lokwesine ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.40",
            "verseOrgIds": [
              "EXO.29.40"
            ]
          }
        },
        {
          "text": " yamafutha okukhanywa, kanye lokwesine ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.40",
            "verseOrgIds": [
              "EXO.29.40"
            ]
          }
        },
        {
          "text": " yewayini kube ngumnikelo wokuthululwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.40",
            "verseOrgIds": [
              "EXO.29.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EXO 29:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unikele elinye iwundlu kusihlwa, unikele kanye lalo umnikelo wempuphu lomnikelo wokuthululwa njengasekuseni, kube liphunga elimnandi, umnikelo owenzelwe iNkosi ngomlilo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.41",
            "verseOrgIds": [
              "EXO.29.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EXO 29:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lo uzakuba ngumnikelo wokutshiswa wensuku zonke ezizukulwaneni zenu zonke, ngasemnyango wethente lokuhlangana phambi kweNkosi, lapho ngizahlangana khona lani, ngikhulume lawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.42",
            "verseOrgIds": [
              "EXO.29.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "EXO 29:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho ngizahlangana labantu bakoIsrayeli; ithente lizakwahlukaniselwa yinkazimulo yami. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.43",
            "verseOrgIds": [
              "EXO.29.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "EXO 29:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngizakwahlukanisela ithente lokuhlangana lealtare, ngibahlukanisele njalo loAroni lamadodana akhe ukuba babe ngabapristi bokuphatha umsebenzi wami. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.44",
            "verseOrgIds": [
              "EXO.29.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "EXO 29:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngizahlala phakathi kwabantu bakoIsrayeli, ngibe nguNkulunkulu wabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.45",
            "verseOrgIds": [
              "EXO.29.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "EXO 29:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazakwazi ukuthi ngiyiNkosi uNkulunkulu wabo, eyabakhupha elizweni laseGibithe ukuba ngihlale phakathi kwabo; ngiyiNkosi, uNkulunkulu wabo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.46",
            "verseOrgIds": [
              "EXO.29.46"
            ]
          }
        }
      ]
    }
