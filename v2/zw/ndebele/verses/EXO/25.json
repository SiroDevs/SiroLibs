          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzabeka etafuleni izinkwa ezahlukaniselwe iNkosi, zibe phambi kwami insuku zonke.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.30",
