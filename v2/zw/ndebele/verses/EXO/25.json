          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzalwenzela izibane eziyisikhombisa ezizamiswa ukuba zikhanyise phambi kwalo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.37",
