          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oluthini lwesibane kube khona imbizana ezine ezenziwe zafana lamaluba esihlahla ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.34",
            "verseOrgIds": [
              "EXO.25.34"
            ]
          }
        },
        {
          "text": ", yileyo laleyo ibe lesiduku leluba; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.34",
            "verseOrgIds": [
              "EXO.25.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 25:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "kube lesiduku ngaphansi kwengatsha ezimbili esixhumene kanye lazo, kuphindwe futhi ngaphansi kwengatsha ezinye ezimbili langaphansi kwezinye ezimbili njalo, kube njalo kuzo zonke ingatsha eziyisithupha eziphuma oluthini lwesibane. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.35",
            "verseOrgIds": [
              "EXO.25.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
