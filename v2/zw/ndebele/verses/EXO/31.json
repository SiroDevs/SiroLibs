          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiqedile ukukhuluma kuMose entabeni yaseSinayi yamnika uMose amatshe amabili obufakazi alotshwe ngomunwe kaNkulunkulu.",
          "type": "text",
          "attrs": {
