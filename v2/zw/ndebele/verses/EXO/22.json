          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba uyise esala impela ukumnika yona, uzahlawula imali elingana lelobolo lentombi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.17",
