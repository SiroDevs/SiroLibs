            "number": "22",
            "style": "v",
            "sid": "EXO 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yathi kuMose: Tshono kwabakoIsrayeli uthi: Lina ngokwenu selizibonele ukuthi ngikhulume kini ngisezulwini. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.22",
            "verseOrgIds": [
              "EXO.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lingenzi onkulunkulu besiliva ukuba babe khona kanye lami, lingazenzeli onkulunkulu begolide. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.23",
            "verseOrgIds": [
              "EXO.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lingenzele ialtare lomhlabathi, linikele kulo iminikelo yenu yokutshiswa leminikelo yenu yokuthula, izimvu lenkabi zenu. Kuzo zonke indawo lapho ngilenza ibizo lami ukuba likhunjulwe khona ngizakuza kini ngilibusise. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.24",
            "verseOrgIds": [
              "EXO.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba lingenzela ialtare lelitshe, lingalenzi ngamatshe abaziweyo; ngoba nxa lilitshaya ngensimbi yokubaza, liyalingcolisa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.25",
            "verseOrgIds": [
              "EXO.20.25"
            ]
          }
        },
