          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi lapho abantu bonke besizwa ukuduma lokukhala kophondo, lalapho bebona imibane lokuthunqa kwentaba bathuthumela, bema khatshana;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.18",
            "verseOrgIds": [
              "EXO.20.18"
            ]
          }
        },
        {
