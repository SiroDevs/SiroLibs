          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenze ingubo yesifuba yokwahlulela, kube ngumsebenzi wengcitshi, uyenze njengengubo yamahlombe, ngelembu elihle lentambo ephothiweyo yegolide leluhlaza leyibubende lebomvu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.15",
            "verseOrgIds": [
              "EXO.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kayilingane inxa zonke, iphindwe kabili, ubude bayo bube ngangengxenye yengalo, ububanzi bayo bube ngangengxenye yengalo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.16",
            "verseOrgIds": [
              "EXO.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ufake kuyo imizila emine yamatshe amahle; umzila wokuqala ube ",
