              "EXO.28.20"
            ]
          }
        },
        {
          "text": "; amatshe la azingelezelwe ngezinto ezitshiliweyo zegolide. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.20",
            "verseOrgIds": [
