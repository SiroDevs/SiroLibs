          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walibhada ngegolide elihle, ngaphezulu lezinhlangothi zalo lempondo zalo; walenzela inxa zonke umqolo wegolide. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.26",
            "verseOrgIds": [
              "EXO.37.26"
            ]
          }
        },
        {
          "name": "verse",
