              "type": "text"
            }
          ]
        },
        {
          "text": "UBezaleli wawenza ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.1",
            "verseOrgIds": [
              "EXO.37.1"
            ]
          }
        },
        {
          "text": " ngesihlahla somvagazi, ubude bawo babuzingalo ezimbili lengxenywe, lobubanzi bawo babuyingalo lengxenye, lokudepha kwawo kwakuyingalo lengxenye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.1",
            "verseOrgIds": [
              "EXO.37.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
