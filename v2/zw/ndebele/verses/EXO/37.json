          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenza ialtare lempepha ngesihlahla somvagazi, ubude balo babuyingalo lobubanzi balo babuyingalo, lilingene inxa zonke; ukudepha kwalo kwakuzingalo ezimbili; lona lempondo zalo kwaba yintonye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.25",
            "verseOrgIds": [
              "EXO.37.25"
            ]
          }
        },
        {
