        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.24",
            "verseOrgIds": [
              "GEN.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yachitha leyomizi legceke lonke, labo bonke ababehlala emizini, lalokho okuhlumayo emhlabathini. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.25",
            "verseOrgIds": [
              "GEN.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa umkaLoti wakhangela emuva, waba yinsika yetshwayi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.26",
            "verseOrgIds": [
              "GEN.19.26"
            ]
          }
        },
