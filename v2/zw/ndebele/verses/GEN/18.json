            }
          ]
        },
        {
          "text": "UAbrahama wasesithi: INkosi kayingathukutheli lapho ngikhuluma ngithi: Mhlawumbe kuzafunyanwa khona abangamatshumi amathathu. Yathi: Kangiyikukwenza uba ngifumana khona abangamatshumi amathathu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.30",
            "verseOrgIds": [
