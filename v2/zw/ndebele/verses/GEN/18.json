              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi: Khangela, sengizimisele ukukhuluma eNkosini; mhlawumbe kuzafunyanwa khona abangamatshumi amabili. Yathi: Kangiyikuwubhubhisa ngenxa yalabo abangamatshumi amabili. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.31",
            "verseOrgIds": [
