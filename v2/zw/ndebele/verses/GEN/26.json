              "type": "text"
            }
          ]
        },
        {
          "text": "UEsawu eseleminyaka engamatshumi amane wathatha uJudithi indodakazi kaBeri umHethi, loBasemathi indodakazi kaEloni umHethi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.34",
