                "loc": "EXO.13.19"
              },
              "items": [
                {
                  "text": "Eks 13:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.24.32"
              },
              "items": [
                {
                  "text": "Josh 24:32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.22"
              },
              "items": [
                {
                  "text": "Heb 11:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.25",
            "verseOrgIds": [
              "GEN.50.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 50:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJosefa wafa eleminyaka elikhulu letshumi; balungisa isidumbu sakhe ngomuthi, wafakwa ebhokisini eGibithe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.26",
            "verseOrgIds": [
              "GEN.50.26"
            ]
          }
        }
      ]
    }
  ],
