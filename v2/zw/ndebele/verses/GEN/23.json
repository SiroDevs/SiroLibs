      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukuhamba kukaSara kwaba yiminyaka elikhulu lamatshumi amabili lesikhombisa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.1",
            "verseOrgIds": [
              "GEN.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "USara wafela eKiriyathi‐Arba okuyiHebroni elizweni laseKanani. UAbrahama wamlilela uSara wamkhalela. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.2",
            "verseOrgIds": [
              "GEN.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "UAbrahama wasuka kofileyo wakhe, wakhuluma labantwana bakaHethi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.3",
            "verseOrgIds": [
              "GEN.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "wathi: Ngihlezi lani ngingowezizwe lomfokazi; nginikeni indawo phakathi kwenu yokuba ngimmbele ofileyo wami kuyo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.4",
            "verseOrgIds": [
              "GEN.23.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.9"
              },
              "items": [
                {
                  "text": "Heb 11:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.16"
              },
              "items": [
                {
                  "text": "Seb 7:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.4",
            "verseOrgIds": [
              "GEN.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantwana bakaHethi bamphendula uAbrahama, bathi kuye: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.5",
            "verseOrgIds": [
              "GEN.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkosi, sizwe! Uyisikhulu esilamandla phakathi kwethu; mbela ofileyo wakho kwelihle kuwo wonke amaliba ethu; kakho phakathi kwethu ozakwala ukukunika iliba lakhe ukuba ummbele ofileyo wakho. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.6",
            "verseOrgIds": [
              "GEN.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "UAbrahama wasesukuma, wakhothamela abantu balelolizwe, abangabantwana bakaHethi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.7",
            "verseOrgIds": [
              "GEN.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakhulumisana labo wathi: Uba kuyintando yenu ukuba ngimmbele ofileyo wami lapha, ngizweni, lingincengele kuEfroni indodana kaZohari ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.8",
            "verseOrgIds": [
              "GEN.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuze anginike ubhalu lwakhe lwaseMakaphela, olusemngceleni wesiqinti sakhe, angithengisele lona ngemali elulingeneyo, lube yindawo yami yokumbela phakathi kwenu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.9",
            "verseOrgIds": [
              "GEN.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "UEfroni wayehlezi phakathi kwabantwana bakaHethi, wamphendula uAbrahama phambi kwabantwana bakaHethi, laphambi kwabo bonke abangena esangweni lomuzi wakhe, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.10",
            "verseOrgIds": [
              "GEN.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "wathi: Atshi, nkosi, ngizwe; ngiyakunika isiqinti, ngikunike lobhalu olukuso; ngiyakunika lona phambi kwamadodana abantu bami; mbela lapho ofileyo wakho. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.11",
            "verseOrgIds": [
              "GEN.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "UAbrahama wakhothamela phansi phambi kwabantu balelolizwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.12",
            "verseOrgIds": [
              "GEN.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakhuluma loEfroni phambi kwabantu belizwe esithi: Kodwa ngilalela; ngizakukunika imali yesiqinti; yamukele kimi, ngimbele ofileyo wami khona. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.13",
            "verseOrgIds": [
              "GEN.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "UEfroni wamphendula uAbrahama esithi kuye: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.14",
            "verseOrgIds": [
              "GEN.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkosi yami, ngizwe; isiqinti esilingene ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.15",
            "verseOrgIds": [
              "GEN.23.15"
            ]
          }
        },
        {
          "text": " esiliva angamakhulu amane siyini phakathi kwami lawe na? Ngakho mbela ofileyo wakho. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.15",
            "verseOrgIds": [
              "GEN.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "UAbrahama wamlalela uEfroni, wamnika imali yesiliva ayeyibizile phambi kwabantwana bakaHethi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.16",
            "verseOrgIds": [
              "GEN.23.16"
            ]
          }
        },
        {
          "text": " esiliva angamakhulu amane avunywa ngabathengisi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.16",
            "verseOrgIds": [
              "GEN.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.16",
            "verseOrgIds": [
              "GEN.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhoke isiqinti sikaEfroni saseMakaphela esiseduze leMamre, lobhalu olukuso, lazo zonke izihlahla ezisesiqintini lezisemngceleni waso, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.17",
            "verseOrgIds": [
              "GEN.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwaba yimpahla kaAbrahama phambi kwabantwana bakaHethi laphambi kwabo bonke abangena esangweni lomuzi wakhe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.18",
            "verseOrgIds": [
              "GEN.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emva kwalokho uAbrahama wammbela uSara umkakhe obhalwini lwesiqinti saseMakaphela esiseduze leMamre okuyiHebroni elizweni laseKanani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.19",
            "verseOrgIds": [
              "GEN.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiqinti lobhalu olukuso kwanikwa uAbrahama ngabantwana bakaHethi kube yindawo yokungcwabela.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.20",
            "verseOrgIds": [
              "GEN.23.20"
            ]
          }
        }
      ]
    }
  ],
