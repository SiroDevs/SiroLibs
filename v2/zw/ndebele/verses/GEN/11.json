          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lezi yizizukulwana zikaShemu. UShemu wayeleminyaka elikhulu, wazala uArpakishadi iminyaka emibili emva kukazamcolo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.10",
            "verseOrgIds": [
              "GEN.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emva kokuzalwa kukaArpakishadi uShemu wahlala iminyaka engamakhulu amahlanu; wazala amadodana lamadodakazi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.11",
            "verseOrgIds": [
              "GEN.11.11"
            ]
          }
        }
      ]
    },
    {
