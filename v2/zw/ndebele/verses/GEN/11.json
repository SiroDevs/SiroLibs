          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emva kokuzalwa kukaShela uArpakishadi wahlala iminyaka engamakhulu amane lantathu; wazala amadodana lamadodakazi.",
          "type": "text",
          "attrs": {
