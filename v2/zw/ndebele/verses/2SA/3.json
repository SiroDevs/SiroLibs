  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "2SA 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakukhona ukulwa isikhathi eside phakathi kwendlu kaSawuli lendlu kaDavida; uDavida waya eqina, kodwa indlu kaSawuli yaya isiba buthakathaka.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.1",
            "verseOrgIds": [
              "2SA.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.1",
            "verseOrgIds": [
              "2SA.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavida wazala amadodana eHebroni; izibulo lakhe lalinguAmnoni kuAhinowama waseJezereli; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.2",
            "verseOrgIds": [
              "2SA.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "eyesibili yayinguKileyabi kuAbigayili umkaNabali waseKarmeli; eyesithathu yayinguAbisalomu indodana kaMahaka indodakazi kaTalimayi, inkosi yaseGeshuri; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.3",
            "verseOrgIds": [
              "2SA.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "eyesine yayinguAdonija indodana kaHagithi; eyesihlanu yayinguShefathiya indodana kaAbithali; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.4",
            "verseOrgIds": [
              "2SA.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "eyesithupha yayinguIthereyamu kuEgila, umkaDavida. Laba bazalwa nguDavida eHebroni.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.5",
            "verseOrgIds": [
              "2SA.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.5",
            "verseOrgIds": [
              "2SA.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khonokho kusekhona ukulwa phakathi kwendlu kaSawuli lendlu kaDavida, uAbineri waqina waba lamandla endlini kaSawuli. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.6",
            "verseOrgIds": [
              "2SA.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "USawuli wayelomunye umfazi, ibizo lakhe linguRizipha indodakazi kaAya; uIshiboshethi wathi kuAbineri: Ungeneleni kumkababa na? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.7",
            "verseOrgIds": [
              "2SA.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "UAbineri wasethukuthela kakhulu ngenxa yalawomazwi kaIshiboshethi, wasesithi: Ngiyinja yakoJuda na? Kuze kube lamuhla ngithembekile endlini kaSawuli uyihlo, lakubafowabo, lakubangane bakhe, kangikunikelanga esandleni sikaDavida; kodwa ungibeka icala ngalowesifazana. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.8",
            "verseOrgIds": [
              "2SA.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNkulunkulu amhlanekele uAbineri, engezelele futhi, uba ngingamenzeli uDavida lokho iNkosi ekufunge kuye, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.9",
            "verseOrgIds": [
              "2SA.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukususa umbuso endlini kaSawuli, kumiswe isihlalo sobukhosi sikaDavida koIsrayeli lakoJuda, kusukela koDani kuze kufike eBerisheba.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.10",
            "verseOrgIds": [
              "2SA.3.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.15.28"
              },
              "items": [
                {
                  "text": "1 Sam 15:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.10",
            "verseOrgIds": [
              "2SA.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "UIshiboshethi wayengelakumphendula uAbineri ngelinye ilizwi futhi, ngoba wayemesaba. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.11",
            "verseOrgIds": [
              "2SA.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "UAbineri wasethuma izithunywa kuDavida eHebroni, esithi: Ngelikabani ilizwe na? Yenza isivumelwano lami, ngizakukusiza ukubuyisela wonke uIsrayeli kuwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.12",
            "verseOrgIds": [
              "2SA.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavida wathi: Kulungile; ngizakwenza isivumelwano lawe, kodwa yinye into engiyifuna kuwe, ngeyokuthi kawuyikubonana lami, uba ungalethi kuqala uMikhali indodakazi kaSawuli, lapho usiza ukubonana lami. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.13",
            "verseOrgIds": [
              "2SA.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavida wasethuma izithunywa kuIshiboshethi indodana kaSawuli, esithi: Nginika umkami uMikhali engamlobola ngamajwabu alikhulu amaFilistiya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.14",
            "verseOrgIds": [
              "2SA.3.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.18.27"
              },
              "items": [
                {
                  "text": "1 Sam 18:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.14",
            "verseOrgIds": [
              "2SA.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "UIshiboshethi wasethumela, wamthatha endodeni yakhe uPalitiyeli indodana kaLayishi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.15",
            "verseOrgIds": [
              "2SA.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa indoda yakhe yahamba laye, ihamba ikhala, yamlandela kwaze kwaba seBahurimi. UAbineri wasesithi kuyo: Buyela. Yasibuyelake.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.16",
            "verseOrgIds": [
              "2SA.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.16",
            "verseOrgIds": [
              "2SA.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "UAbineri wasekhuluma labadala bakoIsrayeli esithi: Ngezikhathi ezidlulileyo lafuna ukuba uDavida abe yinkosi yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.17",
            "verseOrgIds": [
              "2SA.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwenzeni lokho khathesi, ngoba iNkosi uNkulunkulu itshilo ngoDavida ukuthi: Ngesandla senceku yami uDavida ngizakhulula abantu bami uIsrayeli ezandleni zamaFilistiya lezandleni zazo zonke izitha zabo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.18",
            "verseOrgIds": [
              "2SA.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "UAbineri wakhuluma futhi labakoBenjamini; wasesiyabikela uDavida eHebroni konke okwakukuhle koIsrayeli lakuyo yonke indlu yakoBenjamini. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.19",
            "verseOrgIds": [
              "2SA.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi efika uAbineri kuDavida eHebroni labantu abangamatshumi amabili, uDavida wamenzela idili labantu ababelaye. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.20",
            "verseOrgIds": [
              "2SA.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "UAbineri wasesithi kuDavida: Sengihamba, ngibuthanise wonke uIsrayeli kuwe, nkosi yami, ukuba benze isivumelwano lawe, ukuba ubuse kukho konke okufiswa yinhliziyo yakho. UDavida wasemvumela uAbineri ukuba ahambe, wazihambela kuhle.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.21",
            "verseOrgIds": [
              "2SA.3.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.21",
            "verseOrgIds": [
              "2SA.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inceku zikaDavida zabuya loJowabi zivela ekuhlaseleni zilempango enengi. Kodwa uAbineri wayengasekho kuDavida eHebroni, ngoba wamvumela ukuba ahambe, wazihambela kuhle. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.22",
            "verseOrgIds": [
              "2SA.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esefikile uJowabi lebutho lakhe lonke, bamtshela bathi: UAbineri indodana kaNeri ubefikile enkosini, imyekele wahamba, wazihambela kuhle. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.23",
            "verseOrgIds": [
              "2SA.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJowabi wasesiya enkosini, wathi: Wenzeni na? UAbineri ubefikile kuwe; umvumeleleni ukuba ahambe, wazihambela na? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.24",
            "verseOrgIds": [
              "2SA.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyazi ukuba uAbineri indodana kaNeri wayeze ukukukhohlisa, ukuba azi ukuhamba kwakho konke, lakho konke okwenzayo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.25",
            "verseOrgIds": [
              "2SA.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esephumile uJowabi kuDavida wathuma izithunywa ukulandela uAbineri, zambuyisa emthonjeni waseSira; kodwa uDavida wayengakwazi lokho. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.26",
            "verseOrgIds": [
              "2SA.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "UAbineri esebuyile eHebroni, uJowabi waya laye eceleni ngasesangweni ukuba bakhulume bebodwa; wasemgwaza esiswini, wafa, ephindisela uAsaheli umfowabo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.27",
            "verseOrgIds": [
              "2SA.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi uDavida esekuzwile lokho wathi: Mina lombuso wami kasilacala phambi kweNkosi kuze kube nininini ngegazi likaAbineri indodana kaNeri. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.28",
            "verseOrgIds": [
              "2SA.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalehlele ekhanda likaJowabi lakuyo yonke indlu kayise. Kungasweleki endlini kaJowabi olamanxeba abhibhidlayo, lolesifo esibi, longasebenza umsebenzi wamanina kuphela, lobulawa empini, loswela ukudla. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.29",
            "verseOrgIds": [
              "2SA.3.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJowabi loAbishayi umfowabo bambulala uAbineri, ngoba wayebulele umfowabo uAsaheli empini, eGibeyoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.30",
            "verseOrgIds": [
              "2SA.3.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavida wasesithi kuJowabi lakubo bonke abantu ababelaye: Dabulani izigqoko zenu, ligqoke izambatho zokulila, lililele uAbineri. Inkosi uDavida walandela ithala. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.31",
            "verseOrgIds": [
              "2SA.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "UAbineri bamngcwabela eHebroni, inkosi yakhala kakhulu engcwabeni lakhe, labantu bonke bakhala. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.32",
            "verseOrgIds": [
              "2SA.3.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 3:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi yamlilela uAbineri yathi:",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.33",
            "verseOrgIds": [
              "2SA.3.33"
            ]
          }
        }
      ]
