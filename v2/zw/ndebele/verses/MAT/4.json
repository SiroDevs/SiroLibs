          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kusukela kulesosikhathi uJesu waqala ukutshumayela esithi: Phendukani, ngoba umbuso wezulu ususondele.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.17",
            "verseOrgIds": [
              "MAT.4.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
