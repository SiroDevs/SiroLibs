    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.17",
            "verseOrgIds": [
              "MAT.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi uJesu ehamba ngasolwandle lwaseGalili wabona izelamani ezimbili, uSimoni othiwa nguPetro loAndreya umfowabo, bephosela imbule olwandle, ngoba babengabagoli benhlanzi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.18",
            "verseOrgIds": [
              "MAT.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasesithi kubo: Ngilandelani; ngizakulenza libe ngabagoli babantu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.19",
            "verseOrgIds": [
              "MAT.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basebetshiya amambule, bamlandela. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.20",
            "verseOrgIds": [
              "MAT.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esedlulele phambili wabona ezinye izelamani ezimbili, uJakobe kaZebediya, loJohane umfowabo, besemkolweni kanye loZebediya uyise, belungisa amambule abo; wababiza. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.21",
            "verseOrgIds": [
              "MAT.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basebetshiya masinyane umkolo loyise, bamlandela.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.22",
            "verseOrgIds": [
              "MAT.4.22"
            ]
          }
        }
      ]
    },
