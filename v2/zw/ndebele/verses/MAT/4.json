          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJesu wahambahamba elizweni lonke laseGalili efundisa emasinagogeni abo, etshumayela ivangeli lombuso, esilisa abantu ezifweni zonke lasebuthakathakeni bonke.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.23",
            "verseOrgIds": [
              "MAT.4.23"
            ]
          }
        },
