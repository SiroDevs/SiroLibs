              "type": "text"
            }
          ]
        },
        {
          "text": "Nxa umoya omubi esephumile emuntwini, uyadabula indawo ezomileyo efuna ukuphumula kodwa engakufumani. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.43",
