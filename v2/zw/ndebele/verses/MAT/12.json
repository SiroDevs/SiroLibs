              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho uthi: Ngizakubuyela endlini yami engaphuma kuyo; afikeke ayifumane ize, ithanyelwe ilungisiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.44",
