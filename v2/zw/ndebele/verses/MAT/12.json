          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngithi kini: Amazwi wonke ayize abawakhulumayo abantu, bazakuziphendulela ngawo ngosuku lokuthonisiswa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.36",
