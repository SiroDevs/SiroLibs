          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waseselulela isandla sakhe ngakubafundi bakhe, wathi: Khangelani, nangu umama labafowethu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.49",
            "verseOrgIds": [
              "MAT.12.49"
            ]
