              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho ngithi kini: Abantu bazakuthethelelwa izono zonke lokuhlambaza, kodwa ukuhlambaza uMoya kakuyikuthethelelwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.31",
            "verseOrgIds": [
              "MAT.12.31"
            ]
