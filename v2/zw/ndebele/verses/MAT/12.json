  "verseCount": 47,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "MAT 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalesosikhathi uJesu wadabula emasimini ngeSabatha; abafundi bakhe babelambile, baqala ukukha izikhwebu, badla.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.1",
            "verseOrgIds": [
              "MAT.12.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.23.25"
              },
              "items": [
                {
                  "text": "Dute 23:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.1",
            "verseOrgIds": [
              "MAT.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa kwathi abaFarisi bekubona lokho bathi kuye: Khangela, abafundi bakho benza okungavunyelwayo ngeSabatha. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.2",
            "verseOrgIds": [
              "MAT.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi kibo: Kalifundanga yini okwenziwa nguDavida mhla elambile lababelaye",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.3",
            "verseOrgIds": [
              "MAT.12.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.21.1+1SA.21.2+1SA.21.3+1SA.21.4+1SA.21.5+1SA.21.6"
              },
              "items": [
                {
                  "text": "1 Sam 21:1–6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.3",
            "verseOrgIds": [
              "MAT.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuthi wangena endlini kaNkulunkulu, wadla izinkwa ezahlukaniselwe uNkulunkulu ezingavunyelwe ukudliwa nguye lababelaye kodwa ngabapristi bodwa na?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.4",
            "verseOrgIds": [
              "MAT.12.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.24.9"
              },
              "items": [
                {
                  "text": "Levi 24:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.4",
            "verseOrgIds": [
              "MAT.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi kalifundanga yini emlayweni ukuthi ngeSabatha abapristi bayalona iSabatha ethempelini bangabi lacala na?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.5",
            "verseOrgIds": [
              "MAT.12.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.28.9"
              },
              "items": [
                {
                  "text": "Nani 28:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.28.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.5",
            "verseOrgIds": [
              "MAT.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa ngithi kini: Kukhona lapha okukhulu kulethempeli. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.6",
            "verseOrgIds": [
              "MAT.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aluba belisazi ukuba kutsho ukuthini ukuthi: Ngifuna isihawu kulomhlatshelo; ngabe kalibalahlanga labo abangelacala.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.7",
            "verseOrgIds": [
              "MAT.12.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.9.13"
              },
              "items": [
                {
                  "text": "Mat 9:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.6.6"
              },
              "items": [
                {
                  "text": "Hos 6:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.7",
            "verseOrgIds": [
              "MAT.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba iNdodana yomuntu iyiNkosi yeSabatha.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.8",
            "verseOrgIds": [
              "MAT.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.8",
            "verseOrgIds": [
              "MAT.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasuka lapho, wangena esinagogeni labo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.9",
            "verseOrgIds": [
              "MAT.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakukhona umuntu olesandla esitshwabheneyo. Bambuza bathi: Kuvunyelwe yini ukusilisa ngeSabatha? ukuze bammangalele. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.10",
            "verseOrgIds": [
              "MAT.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi kibo: Nguwuphi umuntu wakini elemvu eyodwa, uba iwele emgodini ngeSabatha ongayikuyibamba ayikhuphe na?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.11",
            "verseOrgIds": [
              "MAT.12.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.14.5"
              },
              "items": [
                {
                  "text": "Luka 14:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.11",
            "verseOrgIds": [
              "MAT.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phoke, umuntu udlula imvu kangakanani! Ngakhoke kuvunyelwe ukwenza okulungileyo ngeSabatha. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.12",
            "verseOrgIds": [
              "MAT.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasesithi kulowomuntu: Yelula isandla sakho. Waselula, sasiliswa, saba njengesinye. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.13",
            "verseOrgIds": [
              "MAT.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basebephuma abaFarisi becebisana ngaye ukuba bangambulala kanjani.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.14",
            "verseOrgIds": [
              "MAT.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.14",
            "verseOrgIds": [
              "MAT.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uJesu esekwazi lokho wasuka lapho. Abantu abanengi bamlandela, wabasilisa bonke. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.15",
            "verseOrgIds": [
              "MAT.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabalayisisa ukuba bangamvezi, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.16",
            "verseOrgIds": [
              "MAT.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuze kugcwaliseke okwakhulunywa ngumprofethi uIsaya ukuthi:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.17",
            "verseOrgIds": [
              "MAT.12.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.21",
            "verseOrgIds": [
              "MAT.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwasekulethwa kuye umuntu olomoya omubi eyisiphofu lesimungulu. Wamsilisa, kwaze kwathi oyisimungulu wakhuluma, wabona. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.22",
            "verseOrgIds": [
              "MAT.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaxuku wonke amangala, athi: Lo angaba yiyo iNdodana kaDavida na? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.23",
            "verseOrgIds": [
              "MAT.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa abaFarisi sebezwile bathi: Lumuntu uyabakhupha omoya ababi ngoBelezebule, inkosi yomoya ababi, kuphela.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.24",
            "verseOrgIds": [
              "MAT.12.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.9.34"
              },
              "items": [
                {
                  "text": "Mat 9:34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.25"
              },
              "items": [
                {
                  "text": "10:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.24",
            "verseOrgIds": [
              "MAT.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa eseyazi imicabango yabo uJesu wathi kubo: Ilowo lalowo umbuso owahlukene phakathi, uyachitheka, lalowomuzi ingabe indlu eyahlukene phakathi, ingeme. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.25",
            "verseOrgIds": [
              "MAT.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba uSathane ekhupha uSathane, wahlukene phakathi kwakhe. Pho, umbuso wakhe uzakuma kanjani na? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.26",
            "verseOrgIds": [
              "MAT.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba mina ngikhupha omoya ababi ngoBelezebule, amadodana enu abakhupha ngobani na? Ngakhoke wona azakuba ngabathonisisi benu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.27",
            "verseOrgIds": [
              "MAT.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uba mina ngikhupha omoya ababi ngoMoya kaNkulunkulu, lembala umbuso kaNkulunkulu usufikile kini. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.28",
            "verseOrgIds": [
              "MAT.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu angangena kanjani endlini yesiqhwaga, aphange impahla yaso, uba engasibophi kuqala isiqhwaga na? Kung’khona ezakuphanga indlu yaso. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.29",
