          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lowo okhuluma ilizwi elibi ngeNdodana yomuntu uzakuthethelelwa, kodwa lowo okhuluma ilizwi elibi ngoMoya oNgcwele kayikuthethelelwa kulesisikhathi lasesikhathini esizayo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.32",
            "verseOrgIds": [
