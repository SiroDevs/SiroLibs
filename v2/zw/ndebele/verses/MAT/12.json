          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abesehamba, abuye labanye omoya abayisikhombisa ababi kulaye, bangene bahlale khona; kuthi ukucina kwalowomuntu kube kubi kulokokuqala. Kuzakuba njalo kulesisizukulwana esibi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.45",
            "verseOrgIds": [
