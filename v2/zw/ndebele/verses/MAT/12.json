        {
          "text": "Omunye wathi kuye: Khangela, unyoko labafowenu bemi ngaphandle, bafuna ukukhuluma lawe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.47",
            "verseOrgIds": [
              "MAT.12.47"
            ]
          }
        },
        {
