          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umoya omubi usukhutshiwe, isimungulu sakhuluma. Amaxuku amangala, athi: Kakuzanga kubonwe okunje koIsrayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.33",
            "verseOrgIds": [
