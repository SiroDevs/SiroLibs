              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asevuleka amehlo azo. UJesu wazilayisisa, wathi: Qaphelani ukuba kungaziwa muntu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.30",
            "verseOrgIds": [
