              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekuphumeni kwazo, kwalethwa kuye isimungulu esilomoya omubi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.32",
            "verseOrgIds": [
