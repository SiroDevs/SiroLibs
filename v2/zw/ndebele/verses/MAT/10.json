          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhoke lingabesabi; ngoba kakukho okufihliweyo okungayikubonakaliswa, lokuthukuziweyo okungayikwaziwa.",
          "type": "text",
          "attrs": {
