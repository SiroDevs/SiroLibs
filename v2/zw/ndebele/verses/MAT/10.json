          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Othanda uyise ingabe unina kulami kafanele mina; lothanda indodana ingabe indodakazi kulami kafanele mina: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.37",
