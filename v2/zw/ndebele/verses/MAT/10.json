          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lizakuzondwa yibo bonke ngenxa yebizo lami; kodwa ophikelelayo kuze kube sekupheleni nguye ozakusiliswa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.22",
            "verseOrgIds": [
              "MAT.10.22"
            ]
          }
        },
