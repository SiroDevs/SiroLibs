              "type": "text"
            }
          ]
        },
        {
          "text": "Leyonceku engasizi lutho iphoseleni emnyameni ongaphandle; kuzakuba khona lapho ukukhala lokugedla amazinyo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.30",
            "verseOrgIds": [
