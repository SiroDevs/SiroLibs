            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.14",
            "verseOrgIds": [
              "EZK.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi ngafunga kibo enkangala ukuba kangiyikubaletha elizweni engangilinike bona, ilizwe eligcwele uchago lenyosi, ilizwe elihle kulawo wonke amazwe,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.15",
            "verseOrgIds": [
              "EZK.20.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.26+NUM.14.27+NUM.14.28+NUM.14.29+NUM.14.30+NUM.14.31+NUM.14.32+NUM.14.33+NUM.14.34+NUM.14.35"
              },
              "items": [
                {
                  "text": "Nani 14:26–35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.15",
            "verseOrgIds": [
              "EZK.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngoba bala imithetho yami, kabahambanga ngezimiso zami, bangcolisa amaSabatha ami, ngoba inhliziyo zabo zathanda izithombe zabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.16",
            "verseOrgIds": [
              "EZK.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanti ngabahawukela, kangibabhubhisanga ngabaqeda nya enkangala. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.17",
            "verseOrgIds": [
              "EZK.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngatsho kubantwana babo enkangala ngathi: Lingahambi ngezimiso zaboyihlo, lingagcini imithetho yabo, lingazingcolisi ngezithombe zabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.18",
            "verseOrgIds": [
              "EZK.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mina Nkosi nginguNkulunkulu wenu. Hambani ngezimiso zami, liqaphelise ukugcina imithetho yami, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.19",
            "verseOrgIds": [
              "EZK.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "lihloniphe amaSabatha ami ukuba abe yisibonakaliso phakathi kwami lani, ukuba lazi ukuthi ngiyiNkosi uNkulunkulu wenu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.20",
            "verseOrgIds": [
              "EZK.20.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.20",
            "verseOrgIds": [
              "EZK.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa labantwana bangihlamuka, kabaze bahamba ngezimiso zami, kabaqaphelisanga ukugcina imithetho yami, umuntu azaphila ngayo uba eyenza; bawangcolisa amaSabatha ami. Ngasengisithi ngizakwehlisela ukuthukuthela kwami phezu kwabo, ngibaqede ngolaka lwami enkangala. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.21",
            "verseOrgIds": [
              "EZK.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa ngazinqanda ngenxa yebizo lami, ukuba lingangcoliswa phambi kwezizwe engangibakhuphe phambi kwazo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.22",
            "verseOrgIds": [
              "EZK.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngafunga kibo futhi enkangala ukuthi ngizabachithachitha phakathi kwezizwe, ngibahlakazele emazweni wonke,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.23",
            "verseOrgIds": [
              "EZK.20.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
