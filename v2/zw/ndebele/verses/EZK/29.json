              "type": "text"
            }
          ]
        },
        {
          "text": "Ngomnyaka wetshumi, ngosuku lwetshumi lambili lwenyanga yetshumi, ilizwi leNkosi lafika kimi lathi:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.1",
            "verseOrgIds": [
              "EZK.29.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
