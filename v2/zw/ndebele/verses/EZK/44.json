                {
                  "text": "Eks 28:39–43",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.16.4"
              },
              "items": [
                {
                  "text": "Levi 16:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.17",
            "verseOrgIds": [
              "EZK.44.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 44:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bathwale amaqhiye enziwe ngelembu elihle emakhanda abo, bagqoke amabulukwe enziwe ngelembu elihle; kabayikuzibopha ngalutho oluginqisayo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.18",
            "verseOrgIds": [
              "EZK.44.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 44:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nxa sebephumela egumeni elingaphandle besiya ebantwini, bazakhumula izambatho abebezigqoke ekukhonzeni kwabo, bazibeke ezindlini ezingcwele, bagqoke ezinye izigqoko funa bathelele abantu ubungcwele ngezambatho zabo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.19",
            "verseOrgIds": [
              "EZK.44.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.16.23"
              },
              "items": [
                {
                  "text": "Levi 16:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.19",
            "verseOrgIds": [
              "EZK.44.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 44:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabayikuphuca amakhanda abo, kabayikuyekela inwele zabo zikhule zibe zinde, kodwa bazaquma inwele zamakhanda abo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.20",
            "verseOrgIds": [
              "EZK.44.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.21.5"
              },
              "items": [
                {
                  "text": "Levi 21:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.20",
            "verseOrgIds": [
              "EZK.44.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 44:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakulampristi ozakunatha iwayini lapho ezangena egumeni elingaphakathi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.21",
            "verseOrgIds": [
              "EZK.44.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.10.9"
              },
              "items": [
                {
                  "text": "Levi 10:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.21",
            "verseOrgIds": [
              "EZK.44.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 44:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabayikuthatha umfelwakazi loba owesifazana owehlukene lendoda, kodwa bazathatha intombi kuphela eyosendo lwakoIsrayeli, loba umfelwakazi ongumfelwakazi wompristi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.22",
            "verseOrgIds": [
              "EZK.44.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
