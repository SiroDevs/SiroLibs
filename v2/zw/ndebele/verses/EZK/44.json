          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabayikuzingcolisa ngokusondela emuntwini ofileyo. Kodwa ngaboyise langabonina, ngendodana langendodakazi, ngomfowabo langabodadewabo abangendanga bangazingcolisa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.25",
            "verseOrgIds": [
              "EZK.44.25"
            ]
          }
        },
        {
