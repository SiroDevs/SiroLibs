              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emva kokungcola kwabo bazakubala insuku eziyisikhombisa besebehlambuluka. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.26",
            "verseOrgIds": [
              "EZK.44.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 44:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mhla bengenayo endaweni engcwele, egumeni elingaphakathi, ukukhonza endaweni engcwele, bazanikela umnikelo wabo wesono, kutsho iNkosi uNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.27",
            "verseOrgIds": [
              "EZK.44.27"
            ]
          }
        }
