            }
          ]
        },
        {
          "text": "lendlu ekhangele inyakatho ngeyabapristi abaphethe ialtare. Ngitsho amadodana kaZadoki okuyiwona wodwa phakathi kwamadodana kaLevi angasondela eNkosini ukuyikhonza. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.46",
            "verseOrgIds": [
