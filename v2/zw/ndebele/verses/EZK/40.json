          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaphandle kwendlu esekungeneni, ngasekungeneni kwesango elingasenyakatho, kwakukhona amatafula amabili, langaphakathi kwendlu esekungeneni kwesango kwakukhona amatafula amabili. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.40",
            "verseOrgIds": [
