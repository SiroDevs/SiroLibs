          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amatafula amane ayengaphakathi, lamatafula amane ayengaphandle, eceleni kwesango, wonke ayeficaminwembili lapho kwakuzahlatshelwa khona umhlatshelo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.41",
            "verseOrgIds": [
