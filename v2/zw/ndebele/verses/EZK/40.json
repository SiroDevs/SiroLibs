          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakukhona futhi amatafula amane ayenziwe ngamatshe abaziweyo, angawomnikelo wokutshiswa, ubude bawo buyingalo lengxenye, lobubanzi bawo buyingalo lengxenye, lokuphakama kwawo kuyingalo, okwakuzabekwa kiwo izinto zokuhlaba umnikelo wokutshiswa leminye iminikelo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.42",
            "verseOrgIds": [
              "EZK.40.42"
            ]
          }
