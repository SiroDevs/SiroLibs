          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasesithi kimi: Lindlu ekhangele iningizimu ngeyabapristi abaphethe ithempeli, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.45",
            "verseOrgIds": [
