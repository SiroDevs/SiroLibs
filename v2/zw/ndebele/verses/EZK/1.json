        {
          "text": "kodwa kwakuzwakala ilizwi livela emkhathini ongaphezu kwamakhanda azo lalapho sezimi zehlise impiko zazo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.25",
