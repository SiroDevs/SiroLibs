          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho ziphapha, ngezwa umsindo wempiko zazo unjengomdumo wamanzi amanengi, unjengomdumo kaSomandla, unjengokuxokozela kwexuku. Lapho zisima zehlisa impiko zazo,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.24",
            "verseOrgIds": [
              "EZK.1.24"
