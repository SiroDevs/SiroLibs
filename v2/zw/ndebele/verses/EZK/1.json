              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaphezu komkhathi owawuphezu kwamakhanda azo kwakukhona okunjengelitshe elithiwa ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.26",
            "verseOrgIds": [
              "EZK.1.26"
            ]
