              "type": "text"
            }
          ]
        },
        {
          "text": "UNkulunkulu uYise weNkosi uJesu, obongekayo kuze kube nini lanini, uyazi ukuthi kangiqambi manga. ",
          "type": "text",
          "attrs": {
