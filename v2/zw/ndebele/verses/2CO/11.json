              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba ngimele ukuzincoma, ngizakuzincoma ngezinto zobuthakathaka bami. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.30",
            "verseOrgIds": [
