          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.22",
            "verseOrgIds": [
              "2CO.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CO 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mina ngibiza uNkulunkulu ukuba abe ngufakazi womphefumulo wami ukuthi ukungezi kwami eKorinte yikuba bengingathandi ukulihlupha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.23",
            "verseOrgIds": [
              "2CO.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CO 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakusikho ukuthi sibusa ukukholwa kwenu, kodwa sisebenzela ukuthokoza kwenu kanye lani, ngoba liqinile ekukholweni.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.24",
            "verseOrgIds": [
              "2CO.1.24"
            ]
          }
        }
      ]
    }
