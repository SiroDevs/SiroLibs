            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu baseKiriyathi‐Jeyarimi beza, bawuthatha ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.1",
            "verseOrgIds": [
              "1SA.7.1"
            ]
          }
        },
        {
          "text": " weNkosi, bawusa endlini kaAbinadaba entabeni. Bagcoba uEleyazare indodana yakhe ukuba agcine umtshokotsho weNkosi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.1",
            "verseOrgIds": [
              "1SA.7.1"
            ]
          }
        },
