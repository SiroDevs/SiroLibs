          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "laphambi kwesihlalo sobukhosi kwakukhona okunjengengilazi kufana longqoqwane. Phakathi kwesihlalo sobukhosi labadala kwakukhona izidalwa ezine eziphilayo ezilamehlo ngemuva langaphambili, zizingelezele isihlalo sobukhosi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.6",
            "verseOrgIds": [
              "REV.4.6"
            ]
          }
        },
        {
