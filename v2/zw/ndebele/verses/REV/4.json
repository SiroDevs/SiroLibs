          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isidalwa sokuqala sasifana lesilwane, isidalwa sesibili sifana lenkabi, isidalwa sesithathu silobuso bomuntu, isidalwa sesine sifana lokhozi oluphaphayo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.7",
            "verseOrgIds": [
              "REV.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izidalwa ezine eziphilayo, ileso laleso kuzo silamaphiko ayisithupha; emaceleni wonke langaphakathi zigcwele amehlo; emini lebusuku kazikhawuli ukuhlabela zisithi:",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.8",
            "verseOrgIds": [
              "REV.4.8"
            ]
          }
        }
      ]
