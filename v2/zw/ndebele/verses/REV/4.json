              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emva kwalokhu ngakhangela, ngabona umnyango uvulekile ezulwini, lelizwi lokuqala engangilizwile likhuluma lami njengophondo, lathi: Yenyukela lapha, ngizakukutshengisa lokho okuzakwenzeka emva kwalokhu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.1",
            "verseOrgIds": [
              "REV.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masinyane ngehlelwa nguMoya; ngabona isihlalo sobukhosi simi ezulwini, ngabona ohlezi phezu kwesihlalo sobukhosi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.2",
            "verseOrgIds": [
              "REV.4.2"
            ]
          }
        },
