          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lohleziyo wayefana lelitshe elithiwa ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.3",
            "verseOrgIds": [
              "REV.4.3"
            ]
          }
        },
        {
          "text": ", lelithiwa ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.3",
            "verseOrgIds": [
              "REV.4.3"
            ]
          }
        },
        {
          "text": ", ukukhangeleka kwakhe; lomchilowamakhosikazi ofana lelitshe elithiwa ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.3",
            "verseOrgIds": [
              "REV.4.3"
            ]
          }
        },
        {
          "text": " wawuzingelezele isihlalo sobukhosi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.3",
            "verseOrgIds": [
              "REV.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izihlalo zobukhosi ezingamatshumi amabili lane zazihanqe lesosihlalo sobukhosi; phezu kwazo kwakuhlezi abadala abangamatshumi amabili lane bembethe ingubo ezimhlophe, bethwele imiqhele emakhanda abo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.4",
            "verseOrgIds": [
              "REV.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lasesihlalweni sobukhosi kwakuphuma imibane, lamazwi, lokuduma; lezibane zomlilo eziyisikhombisa zazibhebha phambi kwazo, zona zingomoya abayisikhombisa bakaNkulunkulu;",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.5",
            "verseOrgIds": [
              "REV.4.5"
            ]
          }
        },
