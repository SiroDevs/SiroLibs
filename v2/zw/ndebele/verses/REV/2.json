                "loc": "ISA.48.12"
              },
              "items": [
                {
                  "text": "48:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.17"
              },
              "items": [
                {
                  "text": "Isam 1:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.13"
              },
              "items": [
                {
                  "text": "22:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.8",
            "verseOrgIds": [
              "REV.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyakwazi ukuhlupheka kwakho lobuyanga bakho — kanti wena unothile — lenhlamba yalabo abathi bangabaJuda, bona bengesibo, kodwa beyisinagoge likaSathane. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.9",
            "verseOrgIds": [
              "REV.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungesabi inhlupheko ezizakukwehlela. Khangela, uSathane uzakufaka abanye benu entolongweni ukuba lilingwe; futhi lizakuhlupheka insuku ezilitshumi. Thembeka kuze kube sekufeni, ngizakukunika umqhele wokuphila. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.10",
            "verseOrgIds": [
              "REV.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olendlebe kezwe lokho akutshoyo uMoya emabandleni. Onqobayo kasoze alinyazwa yikufa kwesibili.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.11",
            "verseOrgIds": [
              "REV.2.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.20.14"
              },
              "items": [
                {
                  "text": "Isam 20:14",
                  "type": "text"
                }
              ]
            },
