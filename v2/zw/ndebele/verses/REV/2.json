          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "REV 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhoke ngizakumlethela umkhuhlane, labaphinga laye ngibangenise ekuhluphekeni okukhulu, uba bengaphenduki emisebenzini yakhe; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.22",
            "verseOrgIds": [
              "REV.2.22"
            ]
          }
        },
