          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubambisiseni lokho elilakho ngize ngifike. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.25",
            "verseOrgIds": [
              "REV.2.25"
