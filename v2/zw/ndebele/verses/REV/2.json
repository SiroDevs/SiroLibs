          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakuso isithunywa sebandla eliseSemerna loba uthi: Nanku akutshoyo owokuqala lowokucina, owake wafa, kodwa osephila, uthi:",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.8",
            "verseOrgIds": [
              "REV.2.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
