          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakuso isithunywa sebandla eliseTiyathira loba uthi: Nanku ekutshoyo iNdodana kaNkulunkulu elamehlo anjengamalangabi omlilo, lezinyawo zayo ezifana lethusi elikhazimulayo, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.18",
            "verseOrgIds": [
              "REV.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ithi: Ngiyayazi imisebenzi yakho, lothando, lokukholwa, lokubekezela kwakho, lokuthi imisebenzi yakho yokucina minengi kuleyokuqala. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.19",
            "verseOrgIds": [
              "REV.2.19"
            ]
          }
        },
        {
