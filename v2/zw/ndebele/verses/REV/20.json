              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.8",
            "verseOrgIds": [
              "REV.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zaphumela emhlabeni wonke, zeza zazingelezela umuzi wabangcwele lomuzi othandekayo. Kodwa umlilo ovela ezulwini, waziqothula zonke; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.9",
            "verseOrgIds": [
              "REV.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "loSathane owayeziduhisile waphoselwa echibini lomlilo ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.10",
            "verseOrgIds": [
              "REV.20.10"
            ]
          }
        },
        {
          "text": ", lapho kukhona isilo lomprofethi wamanga; zizakuhlupheka khona emini lebusuku kuze kube nini lanini.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.10",
            "verseOrgIds": [
              "REV.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.10",
            "verseOrgIds": [
              "REV.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasengibona isihlalo sobukhosi esikhulu lesimhlophe lohlezi kuso; kwanyamalala ebusweni bakhe izulu lomhlaba, kakwaze kusaba khona.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.11",
            "verseOrgIds": [
              "REV.20.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.9"
              },
              "items": [
                {
                  "text": "Dan 7:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.11",
            "verseOrgIds": [
              "REV.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngabona abafileyo, abakhulu labancinyane, bemi phambi kwesihlalo sobukhosi; lezincwadi zavulwa. Kwavulwa lenye incwadi eyincwadi yokuphila. Abafileyo bahlulelwa ngalokhu okwakulotshiwe ezincwadini langalokho ababekwenzile. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.12",
            "verseOrgIds": [
              "REV.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lolwandle lwabakhupha abafileyo ababekulo, ukuFa lendawo yabafileyo kwakhupha abafileyo ababekukho; bonke bahlulelwa ngalokho ababekwenzile. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.13",
            "verseOrgIds": [
              "REV.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi ukuFa lendawo yabafileyo kwaphoselwa echibini lomlilo; lelichibi liyikufa kwesibili. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.14",
            "verseOrgIds": [
              "REV.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba ekhona ongafunyaniswanga elotshiwe encwadini yokuphila, waphoselwa echibini lomlilo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.15",
            "verseOrgIds": [
              "REV.20.15"
            ]
          }
        }
      ]
