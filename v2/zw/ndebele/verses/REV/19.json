          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Engutsheni yakhe lasethangazini lakhe kulotshwe ibizo elithi: INkosi yamakhosi loMbusi wababusi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.16",
            "verseOrgIds": [
              "REV.19.16"
            ]
          }
        }
