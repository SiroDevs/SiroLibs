          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasengisizwa kungathi yilizwi lexuku elikhulu, linjengomdumo wamanzi amanengi lokuduma okulamandla lisithi:",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.6",
            "verseOrgIds": [
              "REV.19.6"
            ]
          }
        }
      ]
    },
    {
