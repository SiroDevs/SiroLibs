          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abadala abangamatshumi amabili lane lezidalwa ezine eziphilayo zaziwisela phansi, zamdumisa uNkulunkulu ohlezi esihlalweni sobukhosi zisithi:",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.4",
