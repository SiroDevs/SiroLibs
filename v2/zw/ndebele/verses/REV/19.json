          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasengibona izulu livulekile; ngabona ibhiza elimhlophe, oligadileyo ubizwa ngokuthi ngoThembekileyo loQotho; ngoba uthonisisa, alwe ngokulunga.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.11",
            "verseOrgIds": [
              "REV.19.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
