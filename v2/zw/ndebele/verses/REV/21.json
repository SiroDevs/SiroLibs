              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.3.12"
              },
              "items": [
                {
                  "text": "Isam 3:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.2",
            "verseOrgIds": [
              "REV.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngezwa ilizwi elikhulu livela esihlalweni sobukhosi lisithi: Khangela, indawo yokuhlala uNkulunkulu isebantwini; uzakuhlala labo, bazakuba ngabantu bakhe, uNkulunkulu uqobo uzakuba labo,",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.3",
            "verseOrgIds": [
              "REV.21.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
