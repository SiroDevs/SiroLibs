            "sid": "REV 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngabona umuzi ongcwele, iJerusalema elitsha, usehla uvela ezulwini kuNkulunkulu, ulungisiwe njengomlobokazi ocecele umkakhe.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.2",
            "verseOrgIds": [
              "REV.21.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
