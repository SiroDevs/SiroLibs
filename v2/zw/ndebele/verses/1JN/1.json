      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1JN 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lokho okwakukhona kusukela ekuqaleni, esakuzwayo, sakubona ngamehlo ethu, lesakukhangelayo, lezandla zethu zakuphatha, kumayelana lelizwi lokuphila.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.1",
            "verseOrgIds": [
              "1JN.1.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.1"
              },
              "items": [
                {
                  "text": "Joha 1:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.1",
            "verseOrgIds": [
              "1JN.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1JN 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lokhokuphila kwabonakaliswa; sakubona, siyaqinisa silitshumayeza lokhukuphila okungapheliyo okwakukhona kuBaba, kwabonakaliswa kithi.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.2",
            "verseOrgIds": [
              "1JN.1.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.14"
              },
              "items": [
                {
                  "text": "Joha 1:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.2",
            "verseOrgIds": [
              "1JN.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1JN 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lokho esikubonileyo sakuzwa, silitshumayeza khona lani, ukuze lani libe lokuhlanganyela lathi; thina silokuhlanganyela loBaba kanye leNdodana yakhe uJesu Kristu. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.3",
            "verseOrgIds": [
              "1JN.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1JN 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sesiloba lezizinto ukuze ukuthokoza kwethu kuphelele.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.4",
            "verseOrgIds": [
              "1JN.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1JN 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.4",
            "verseOrgIds": [
              "1JN.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1JN 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanti ilizwi esilizwileyo kuye, esilitshumayeza lona elokuthi uNkulunkulu uyikukhanya, umnyama kawukho kuye lakanye. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.5",
            "verseOrgIds": [
              "1JN.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1JN 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba sisithi silokuhlanganyela laye sibe sisahamba emnyameni, silamanga, kasenzi iqiniso; ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.6",
            "verseOrgIds": [
              "1JN.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1JN 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kodwa uba sihamba ekukhanyeni njengalokhu yena esekukhanyeni, silokuhlanganyela omunye lomunye, legazi likaJesu iNdodana yakhe liyasihlambulula ezonweni zonke. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.7",
            "verseOrgIds": [
              "1JN.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1JN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba sisithi kasilasono, siyazikhohlisa, leqiniso kalikho kithi. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.8",
            "verseOrgIds": [
              "1JN.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1JN 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba sivuma izono zethu, uthembekile yena, ulungile futhi, ngakho uzakusithethelela izono zethu, asihlambulule kukho konke ukungalungi. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.9",
            "verseOrgIds": [
              "1JN.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1JN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba sisithi kasonanga, simenza abe ngumqambi wamanga, lelizwi lakhe kalikho kithi.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.10",
            "verseOrgIds": [
              "1JN.1.10"
            ]
          }
        }
      ]
    }
  ],
