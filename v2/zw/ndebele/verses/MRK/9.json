              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basuka lapho, badabula eGalili; wayengathandi ukuba kwaziwe ngumuntu, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.30",
            "verseOrgIds": [
