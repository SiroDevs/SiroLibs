          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngoba wayefundisa abafundi bakhe, esithi kubo: INdodana yomuntu izakunikelwa ezandleni zabantu, bazayibulala; isibulewe, ngemva kwensuku ezintathu izakuvuka. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.31",
            "verseOrgIds": [
              "MRK.9.31"
            ]
          }
        },
