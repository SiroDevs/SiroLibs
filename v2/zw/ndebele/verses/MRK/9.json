          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa kabaqedisisanga lokhukutsho, besaba ukumbuza.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.32",
            "verseOrgIds": [
              "MRK.9.32"
            ]
          }
        }
