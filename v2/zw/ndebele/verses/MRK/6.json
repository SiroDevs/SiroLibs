                "loc": "NUM.27.17"
              },
              "items": [
                {
                  "text": "Nani 27:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.22.17"
              },
              "items": [
                {
                  "text": "1 Kho 22:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.18.16"
              },
              "items": [
                {
                  "text": "2 Lan 18:16",
