                "loc": "MAT.20.16"
              },
              "items": [
                {
                  "text": "Mat 20:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.13.30"
              },
              "items": [
                {
                  "text": "Luka 13:30",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.31",
            "verseOrgIds": [
              "MRK.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babesendleleni besenyukela eJerusalema: uJesu wayehamba phambi kwabo; bamangala, lalabo ababelandela besaba. Wasethatha futhi abalitshumi lambili, waqala ukubatshela okuzamehlela, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.32",
            "verseOrgIds": [
              "MRK.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "wathi: Khangelani, senyukela eJerusalema; iNdodana yomuntu izakunikelwa kubapristi abakhulu lakubabhali; bazakuyigwebela ukufa, bayinikele kwabezizwe; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.33",
            "verseOrgIds": [
              "MRK.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "bazakuyiyangisa, bayikhafulele ngamathe, bayitshaye, bayibulale, kodwa emva kwensuku ezintathu izakuvuka.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.34",
            "verseOrgIds": [
              "MRK.10.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.34",
            "verseOrgIds": [
              "MRK.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kweza kuye uJakobe loJohane amadodana kaZebediya, bathi kuye: Mfundisi, sithanda ukuba usenzele lokho esizakukucela. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.35",
            "verseOrgIds": [
              "MRK.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi kubo: Lithanda ukuba ngilenzeleni na? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.36",
            "verseOrgIds": [
              "MRK.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bathi kuye: Siphe ukuba omunye ahlale ngakwesokunene sakho, lomunye ngakwesokhohlo sakho ebukhosini bakho. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.37",
            "verseOrgIds": [
              "MRK.10.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MRK 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJesu wathi kubo: Kalikwazi elikucelayo. Linganatha yini inkezo engiyinathayo mina, ingabe libhaphathizwe ngobhaphathizo engibhaphathizwa ngalo mina na?",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.38",
            "verseOrgIds": [
              "MRK.10.38"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.50"
              },
              "items": [
                {
                  "text": "Luka 12:50",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.38",
            "verseOrgIds": [
              "MRK.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MRK 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bathi kuye: Singakwenza. UJesu wathi kubo: Inkezo engiyinathayo mina lizakuyinatha, lizakubhaphathizwa ngobhaphathizo engibhaphathizwa ngalo mina; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.39",
            "verseOrgIds": [
              "MRK.10.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MRK 10:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "kodwa ukuhlala ngakwesokunene sami ingabe ngakwesokhohlo sami kayisikho kwami ukuphana ngakho, kodwa kungokwalabo abakulungiselweyo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.40",
            "verseOrgIds": [
              "MRK.10.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MRK 10:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.40",
            "verseOrgIds": [
              "MRK.10.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MRK 10:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sebekuzwile lokhu abalitshumi, baqala ukuthukuthela ngoJakobe loJohane. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.41",
            "verseOrgIds": [
              "MRK.10.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MRK 10:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJesu wasebabiza, wathi kibo: Liyazi ukuthi labo okuthiwa babusa izizwe bazibusa ngokulukhuni, lezikhulu zabo zisebenzisa amandla phezu kwazo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.42",
            "verseOrgIds": [
              "MRK.10.42"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.22.25+LUK.22.26"
              },
              "items": [
                {
                  "text": "Luka 22:25–26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.42",
            "verseOrgIds": [
              "MRK.10.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MRK 10:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa kakunjalo phakathi kwenu, kodwa yilowo lalowo othanda ukuba ngomkhulu phakathi kwenu kabe ngumfokazi wenu,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.43",
            "verseOrgIds": [
              "MRK.10.43"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.23.11"
              },
              "items": [
                {
                  "text": "Mat 23:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.9.35"
              },
              "items": [
                {
                  "text": "Mark 9:35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.22.26"
              },
              "items": [
                {
                  "text": "Luka 22:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.43",
            "verseOrgIds": [
              "MRK.10.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MRK 10:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "lalowo othanda ukuba ngowokuqala phakathi kwenu kabe yinceku yabo bonke. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.44",
            "verseOrgIds": [
              "MRK.10.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MRK 10:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba leNdodana yomuntu kayizanga ukukhonzwa, kodwa ukukhonza lokunika ukuphila kwayo, kube lihlawulo labanengi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.45",
            "verseOrgIds": [
              "MRK.10.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MRK 10:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.45",
            "verseOrgIds": [
              "MRK.10.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MRK 10:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bafika eJeriko. Kwathi esephuma eJeriko labafundi bakhe lexuku elikhulu, uBartimewu indodana kaTimewu, umphanzi oyisiphofu, wayehlezi endleleni. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.46",
            "verseOrgIds": [
              "MRK.10.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "MRK 10:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi esezwile ukuthi nguJesu waseNazaretha, waqala ukumemeza wathi: Jesu, Ndodana kaDavida, akungihawukele! ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.47",
            "verseOrgIds": [
              "MRK.10.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "MRK 10:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanengi bamkhuza, bathi kathule; kodwa kwang’khona ememeza kakhulu, esithi: Ndodana kaDavida, akungihawukele! ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.48",
            "verseOrgIds": [
              "MRK.10.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "MRK 10:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJesu wasesima, wathi: Mbizeni. Basibiza isiphofu, besithi kuso: Mana isibindi, sukuma, uyakubiza. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.49",
            "verseOrgIds": [
              "MRK.10.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "MRK 10:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salahla ingubo yaso, sasukuma sathi lothu, saya kuJesu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.10.50",
            "verseOrgIds": [
              "MRK.10.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
