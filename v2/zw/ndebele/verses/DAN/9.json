      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngomnyaka wokuqala kaDariyu indodana kaAhasuweru, umMede ngokuzalwa, owabekwa waba yinkosi yamaKaladiya, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.1",
            "verseOrgIds": [
              "DAN.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngomnyaka wokuqala wokubusa kwakhe, mina Daniyeli ngabona ezincwadini ukuthi ubunengi beminyaka yokuchitheka kweJerusalema, elakhuluma ngayo ilizwi leNkosi kuJeremiya umprofethi, uzakuba yiminyaka engamatshumi ayisikhombisa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.2",
            "verseOrgIds": [
              "DAN.9.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
