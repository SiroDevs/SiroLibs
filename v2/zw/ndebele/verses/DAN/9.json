                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.2",
            "verseOrgIds": [
              "DAN.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasengikhuleka eNkosini uNkulunkulu, ngayincenga, ngizila ukudla, ngigqoke izambatho zokulila, ngihlezi esilotheni. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.3",
            "verseOrgIds": [
              "DAN.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhuleka eNkosini uNkulunkulu wami, ngavuma izono ngathi: Wena Nkosi, Nkulunkulu omkhulu lowesabekayo, ogcina isivumelwano lothando olungapheliyo kwabakuthandayo labagcina imilayo yakho, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.4",
            "verseOrgIds": [
              "DAN.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "sonile, saziphatha kubi, senza okubi, sakuhlamuka, sayephula imilayo yakho lezimiso zakho; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.5",
            "verseOrgIds": [
              "DAN.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kasilalelanga inceku zakho abaprofethi, ezikhulume ebizweni lakho emakhosini ethu, lasezikhulwini zethu, lakubokhokho, lakibo bonke abantu belizwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.6",
            "verseOrgIds": [
              "DAN.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukhona ukulunga kuwe, Nkosi, kodwa kithi kukhona ihlazo njengalamhlanje ebantwini bakoJuda, labakhileyo eJerusalema, lakuIsrayeli wonke, kubo abaseduze labakhatshana, emazweni wonke obaxotshele kiwo ngenxa yenkohliso abayenze kuwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.7",
            "verseOrgIds": [
              "DAN.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukhona kithi ihlazo, Nkosi, emakhosini ethu, lasezikhulwini zethu, lakubokhokho bethu, ngoba sonile kuwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.8",
            "verseOrgIds": [
              "DAN.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuwe, Nkosi uNkulunkulu wethu, kukhona isihawu lokuthethelela; ngoba sikuhlamukile. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.9",
            "verseOrgIds": [
              "DAN.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasilalelanga ilizwi lakho ngokulandela imilayo yakho owasimisela yona ngezinceku zakho abaprofethi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.10",
            "verseOrgIds": [
              "DAN.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonke uIsrayeli waphule umlayo wakho, waphambuka kiwo, wala ukulalela ilizwi lakho. Isiqalekiso lesifungo esilotshiweyo emlayweni kaMose inceku yakho sehliselwe phezu kwethu, ngoba sonile kuwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.11",
            "verseOrgIds": [
              "DAN.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugcwalisile amazwi akho owawakhuluma ngathi langababusi bethu abasibusayo ngokusehlisela umonakalo omkhulu; ngoba emhlabeni wonke kakuzanga kwenziwe okunjengalokho okwenziwe eJerusalema. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.12",
            "verseOrgIds": [
              "DAN.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonke lumonakalo usehlele njengoba kulotshiwe emlayweni kaMose; kodwa kasiyincenganga iNkosi uNkulunkulu wethu, ukuba sitshiye izono zethu, silalele iqiniso layo. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.13",
            "verseOrgIds": [
              "DAN.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhoke iNkosi yasisidlinzeka ngomonakalo, yawehlisela phezu kwethu; ngoba iNkosi uNkulunkulu wethu ilungile emisebenzini yayo yonke eyenzileyo, thina kasililalelanga ilizwi layo. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.14",
            "verseOrgIds": [
              "DAN.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khathesike, Nkosi Nkulunkulu wethu, owabakhuphayo abantu bakho elizweni laseGibithe ngesandla esilamandla, wazenzela udumo njengalamhlanje, sonile senza okubi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.15",
            "verseOrgIds": [
              "DAN.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkosi, ngakho konke ukulunga kwakho dedisa ulaka lwakho lokuthukuthela kwakho emzini waseJerusalema, entabeni yakho engcwele. Ngoba ngenxa yezono zethu langobubi babokhokho iJerusalema labantu bakho bayisiga phakathi kwabo bonke abasihanqileyo. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.16",
            "verseOrgIds": [
              "DAN.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhoke, Nkulunkulu wethu, zwana umkhuleko wenceku yakho lokuncenga kwayo; langenxa yebizo lakho, Nkosi, ukhanyise futhi ubuso bakho endlini yakho engcwele echithekileyo. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.17",
            "verseOrgIds": [
              "DAN.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkulunkulu wami, beka indlebe yakho uzwe; vula amehlo akho ubone ukuchitheka kwethu, lokomuzi obizwa ngebizo lakho; ngoba kasikhuleki kuwe ngenxa yokulunga kwethu, kodwa ngenxa yesihawu sakho esikhulu. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.18",
            "verseOrgIds": [
              "DAN.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkosi, zwana! Nkosi, thethelela! Nkosi, lalela wenze! Ungalibali, ngenxa yebizo lakho, Nkulunkulu wami, ngoba umuzi wakho labantu bakho babizwa ngebizo lakho.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.19",
            "verseOrgIds": [
              "DAN.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.19",
            "verseOrgIds": [
              "DAN.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi ngisakhuluma ngikhuleka, ngivuma izono zami lezono zabantu bakithi uIsrayeli, ngincenga iNkosi uNkulunkulu wami ngentaba engcwele kaNkulunkulu wami, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.20",
            "verseOrgIds": [
              "DAN.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngisakhuluma ngikhuleka, lowomuntu uGabriyeli engambona embonweni kuqala waphaphela kimi masinyane ngesikhathi somnikelo wakusihlwa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.21",
            "verseOrgIds": [
              "DAN.9.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.19"
              },
              "items": [
                {
                  "text": "Luka 1:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.26"
              },
              "items": [
                {
                  "text": "26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.21",
            "verseOrgIds": [
              "DAN.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DAN 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wafika wathi kimi: Daniyeli, sengifikile ukuba ngikunike ukuhlakanipha lokuqedisisa. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.22",
            "verseOrgIds": [
              "DAN.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekuqaliseni kokuncenga kwakho kwaphuma ilizwi, ngize ukukutshela lona, ngoba uyathandeka kakhulu. Ngakhoke lilalele ilizwi, uqedisise umbono. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.23",
            "verseOrgIds": [
              "DAN.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaviki angamatshumi ayisikhombisa uNkulunkulu uwamisele abantu bakini lomuzi wakini ongcwele ukuba kuphele ukwenza okubi lezono, emva kwalokhu kuthethelelwe izono, kuqiniswe ukulunga okungapheliyo, kuze kugcwaliseke umbono lesiprofethi, kuhlanjululwe lendawo engcwele kakhulu. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.24",
            "verseOrgIds": [
              "DAN.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhoke yazi uqedisise ukuba kusukela ekuphumeni kwelizwi ukuba kwakhiwe futhi iJerusalema kuze kube sekufikeni kogcotshiweyo, ungumbusi, kuzakuba ngamaviki ayisikhombisa. IJerusalema lizahlala lakhiwe okwamaviki angamatshumi ayisithupha lambili lilezindlela lemifolo yamanzi, kodwa kuzaba yisikhathi sokuhlupheka. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.25",
            "verseOrgIds": [
              "DAN.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emva kwamaviki angamatshumi ayisithupha lambili ogcotshiweyo uzabulawa, lanxa engelacala, umuzi lendawo engcwele kuchithwe yimpi yombusi ohlaselayo; ukuphela kufike njengokwesikhukhula, kulethe ukulwa lokuchitheka okumisiweyo. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.26",
            "verseOrgIds": [
              "DAN.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umbusi uzakwenza isivumelwano esiqinileyo labanengi okweminyaka eyisikhombisa, kuthi phakathi kwayo ayivale imihlatshelo leminikelo; phakathi kwalokho ukuchitheka kufike umchithi, kuthi ekucineni kufike lokho okumisiweyo mayelana lomchithi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.27",
            "verseOrgIds": [
              "DAN.9.27"
            ]
          }
        },
        {
          "name": "note",
