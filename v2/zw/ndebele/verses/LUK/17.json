              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuzakuba khona abesifazana ababili bechola ndawonye; omunye asuswe, lomunye asale. [",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.35",
