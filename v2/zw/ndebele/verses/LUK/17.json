              "type": "text"
            }
          ]
        },
        {
          "text": "Kuzakuba khona ababili ensimini; omunye asuswe, omunye atshiywe.] ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.36",
            "verseOrgIds": [
