              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "kodwa ngosuku uLoti aphuma ngalo eSodoma lana umlilo ovela ezulwini, wababhubhisa bonke. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.29",
