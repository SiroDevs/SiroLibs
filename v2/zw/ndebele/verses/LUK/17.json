            }
          ]
        },
        {
          "text": "Ngithi kini: Ngalobobusuku kuzakuba khona ababili belele ndawonye; omunye asuswe, lomunye atshiywe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.34",
