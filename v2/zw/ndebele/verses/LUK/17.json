          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalolosuku lowo ophezu kwendlu, lempahla zakhe zisendlini, angehli ukuyazithatha; njalo losensimini angabuyeli emuva.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.31",
