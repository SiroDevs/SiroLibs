              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasesithi kubo: Batsho kanjani ukuthi uKristu uyiNdodana kaDavida na? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.41",
            "verseOrgIds": [
              "LUK.20.41"
