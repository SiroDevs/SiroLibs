              },
              "items": [
                {
                  "text": "Seb 1:9–11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.50",
            "verseOrgIds": [
              "LUK.24.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LUK 24:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi esababusisa, wehlukana labo, wenyuselwa ezulwini. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.51",
            "verseOrgIds": [
              "LUK.24.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LUK 24:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babuyela eJerusalema, belokuthokoza okukhulu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.52",
            "verseOrgIds": [
              "LUK.24.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
