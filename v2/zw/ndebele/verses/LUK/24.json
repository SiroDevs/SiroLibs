          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babekhona ethempelini njalo bemdumisa uNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.53",
            "verseOrgIds": [
              "LUK.24.53"
            ]
          }
