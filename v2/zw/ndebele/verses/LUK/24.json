    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa ngosuku lokuqala lweviki, emadabukakusa, bafika elibeni bephethe amakha ababewalungisile. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.1",
            "verseOrgIds": [
              "LUK.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bafumana ilitshe ligiqiwe elibeni. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.2",
            "verseOrgIds": [
              "LUK.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuthe bengena, kabasifumananga isidumbu seNkosi uJesu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.3",
            "verseOrgIds": [
              "LUK.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi besadidekile ngalokhu, amadoda amabili ema labo, embethe ingubo ezicwazimulayo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.4",
            "verseOrgIds": [
              "LUK.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Besaba, bakhangela phansi; amadoda athi kubo: Lifunelani ophilayo kwabafileyo na? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.5",
            "verseOrgIds": [
              "LUK.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khumbulani ukukhuluma kwakhe kini eseseGalili,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.6",
            "verseOrgIds": [
              "LUK.24.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
