                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.32",
            "verseOrgIds": [
              "LUK.1.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "uzakubusa phezu kwendlu kaJakobe kuze kube nininini, lombuso wakhe kawuzukuba lakuphela. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.33",
            "verseOrgIds": [
              "LUK.1.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 1:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMariya wathi kuso isithunywa: Lokhu kungenzeka njani, njengoba ngingazi indoda na? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.34",
            "verseOrgIds": [
              "LUK.1.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 1:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isithunywa sathi kuye: UMoya oNgcwele uzakuba phezu kwakho, lamandla oPhezukonke azakukwambesa; ngakho umntwana ozakuzalwa uzakuthiwa ungcwele, uyiNdodana kaNkulunkulu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.35",
            "verseOrgIds": [
              "LUK.1.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 1:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khangela, isinini sakho uElizabethi laye ukhulelwe yindodana esemdala; le yinyanga yesithupha kuye obekuthiwa uyinyumba. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.36",
            "verseOrgIds": [
              "LUK.1.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 1:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba kuNkulunkulu kakulalutho olwahlulayo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.37",
            "verseOrgIds": [
              "LUK.1.37"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.18.14"
              },
              "items": [
                {
                  "text": "Gen 18:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.37",
            "verseOrgIds": [
              "LUK.1.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 1:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMariya wathi: Khangela, ngiyincekukazi yeNkosi; kakube kimi njengelizwi lakho. Isithunywa sasesisuka kuye.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.38",
            "verseOrgIds": [
              "LUK.1.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 1:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.38",
            "verseOrgIds": [
              "LUK.1.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 1:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalezonsuku uMariya wasuka waya ngokuphangisa kwelezintaba, emzini waseJuda. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.39",
            "verseOrgIds": [
              "LUK.1.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wangena endlini kaZekariya, wabingelela uElizabethi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.40",
            "verseOrgIds": [
              "LUK.1.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 1:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi ukuba uElizabethi ezwe ukubingelela kukaMariya, umntwana weqa esiswini sakhe, loElizabethi wagcwaliswa ngoMoya oNgcwele, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.41",
            "verseOrgIds": [
              "LUK.1.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 1:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "wamemeza ngelizwi elikhulu, wathi: Ubusisiwe wena esifazaneni! Ibusisiwe lenzalo yesisu sakho! ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.42",
            "verseOrgIds": [
              "LUK.1.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 1:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwenzeke kanjani kimi ukuba ngihanjelwe ngunina weNkosi yami na? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.43",
            "verseOrgIds": [
              "LUK.1.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 1:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba kuthe ilizwi lokubingelela kwakho lifika endlebeni zami, umntwana weqa esiswini sami ngokuthokoza. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.44",
            "verseOrgIds": [
              "LUK.1.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 1:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubusisiwe yena okholiweyo ukuthi kuzakugcwaliseka lokho okwakhulunywa kuye yiNkosi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.45",
            "verseOrgIds": [
              "LUK.1.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "LUK 1:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.55",
            "verseOrgIds": [
              "LUK.1.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "LUK 1:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMariya wahlala laye okungaba zinyanga ezintathu, wasebuyela ekhaya.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.56",
            "verseOrgIds": [
              "LUK.1.56"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "LUK 1:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.56",
            "verseOrgIds": [
              "LUK.1.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "LUK 1:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isikhathi sikaElizabethi sokuba abelethe sesiphelele, wabeletha indodana. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.57",
            "verseOrgIds": [
              "LUK.1.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "LUK 1:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakhelene laye lezinini zakhe bezwa ukuthi iNkosi imenzele isihawu esikhulu, bathokoza laye. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.58",
            "verseOrgIds": [
              "LUK.1.58"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "LUK 1:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi ngosuku lwesificaminwembili beza ukusoka umntwana, babethanda ukumutha ibizo likayise bathi nguZekariya.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.59",
            "verseOrgIds": [
              "LUK.1.59"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.12.3"
              },
              "items": [
                {
                  "text": "Levi 12:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.59",
            "verseOrgIds": [
              "LUK.1.59"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "60",
            "style": "v",
            "sid": "LUK 1:60"
          },
          "items": [
            {
              "text": "60",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa unina wathi: Atshi bo, uzakuthiwa nguJohane. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.60",
            "verseOrgIds": [
              "LUK.1.60"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "61",
            "style": "v",
            "sid": "LUK 1:61"
          },
          "items": [
            {
              "text": "61",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bathi kuye: Kakho loyedwa ezihlotsheni zakho obizwa ngalelibizo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.61",
            "verseOrgIds": [
              "LUK.1.61"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "62",
            "style": "v",
            "sid": "LUK 1:62"
          },
          "items": [
            {
              "text": "62",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basebeqhweba uyise bambuza ukuthi yena angathanda ukumutha liphi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.62",
            "verseOrgIds": [
              "LUK.1.62"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "63",
            "style": "v",
            "sid": "LUK 1:63"
          },
          "items": [
            {
              "text": "63",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasecela into yokubhalela, wabhala ukuthi: Ibizo lakhe nguJohane. Bamangala bonke. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.63",
            "verseOrgIds": [
              "LUK.1.63"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "64",
            "style": "v",
            "sid": "LUK 1:64"
          },
          "items": [
            {
              "text": "64",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wahle wavuleka umlomo wakhe, lolimi lwakhe lwatshombuluka, wakhuluma edumisa uNkulunkulu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.64",
            "verseOrgIds": [
              "LUK.1.64"
            ]
          }
        },
