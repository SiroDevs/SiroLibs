                {
                  "text": "Mat 16:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.8.12"
              },
              "items": [
                {
                  "text": "Mark 8:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.29",
            "verseOrgIds": [
              "LUK.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba njengalokhu uJona waba yisibonakaliso kwabaseNinive, iNdodana yomuntu izakuba njalo kulesisizukulwana.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.30",
            "verseOrgIds": [
              "LUK.11.30"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JON.3.4"
              },
              "items": [
                {
                  "text": "Jona 3:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.30",
            "verseOrgIds": [
              "LUK.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosikazi yaseningizimu izakusukuma ekuthonisisweni kanye lamadoda alesisizukulwana, iwalahle; ngoba yavela emikhawulweni yomhlaba ukuzwa ukuhlakanipha kukaSolomoni; khangelani, kukhona lapha okukhulu kuloSolomoni.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.31",
            "verseOrgIds": [
              "LUK.11.31"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
