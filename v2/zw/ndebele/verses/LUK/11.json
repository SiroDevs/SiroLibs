              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.28",
            "verseOrgIds": [
              "LUK.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi sekubuthana kuye amaxuku, waqala ukukhuluma, esithi: Lesisizukulwana yisizukulwana esibi; sifuna isibonakaliso, kodwa kasiyikunikwa sibonakaliso, kuphela isibonakaliso sikaJona.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.29",
            "verseOrgIds": [
              "LUK.11.29"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
