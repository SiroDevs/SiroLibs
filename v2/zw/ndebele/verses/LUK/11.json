          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadoda aseNinive azasukuma ekuthonisisweni kanye lalesisizukulwana, asilahle; ngoba aphenduka ngokutshumayela kukaJona; khangelani, kukhona lapha okukhulu kuloJona.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.32",
