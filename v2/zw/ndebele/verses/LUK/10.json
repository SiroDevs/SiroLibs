              "LUK.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maye kuwe Korazini! Maye kuwe Betsayida! Ngoba uba kwakwenziwe eTire leSidoni imisebenzi yamandla eyenziwe kini, ngabe kade baphenduka, bahlala ngamasaka emlotheni.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.13",
            "verseOrgIds": [
              "LUK.10.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.23.1+ISA.23.2+ISA.23.3+ISA.23.4+ISA.23.5+ISA.23.6+ISA.23.7+ISA.23.8+ISA.23.9+ISA.23.10+ISA.23.11+ISA.23.12+ISA.23.13+ISA.23.14+ISA.23.15+ISA.23.16+ISA.23.17+ISA.23.18"
              },
              "items": [
                {
                  "text": "Isa 23:1–18",
                  "type": "text"
                }
              ]
            },
            {
              "text": "Hez 26:1—28:26",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
