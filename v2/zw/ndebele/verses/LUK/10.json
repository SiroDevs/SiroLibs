            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.16",
            "verseOrgIds": [
              "LUK.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babuyake abangamatshumi ayisikhombisa ngokuthokoza, besithi: Nkosi, labomoya ababi bayasithobela ngebizo lakho. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.17",
            "verseOrgIds": [
              "LUK.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi kibo: Ngabona uSathane enjengombane esiwa ezulwini. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.18",
            "verseOrgIds": [
              "LUK.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khangelani, ngilinikile amandla okunyathela inyoka lofezela, lokunyathela amandla wonke esitha; kaliyikulinyazwa lutho.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.19",
            "verseOrgIds": [
              "LUK.10.19"
            ]
          }
        },
        {
