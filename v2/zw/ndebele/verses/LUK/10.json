                "loc": "MAT.10.40"
              },
              "items": [
                {
                  "text": "Mat 10:40",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.9.37"
              },
              "items": [
                {
                  "text": "Mark 9:37",
