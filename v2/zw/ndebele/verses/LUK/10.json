          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lingathokozi ngalokho okokuthi omoya bayalithobela, kodwa thokozani ngokuthi amabizo enu alotshiwe ezulwini.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.20",
