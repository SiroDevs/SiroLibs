              "items": [
                {
                  "text": "Mat 11:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.15"
              },
              "items": [
                {
                  "text": "10:15",
                  "type": "text"
                }
              ]
            }
