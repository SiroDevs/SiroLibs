                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.13",
            "verseOrgIds": [
              "LUK.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa kuzakuba ngcono kwabaseTire leSidoni ekuthonisisweni kulakini. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.14",
            "verseOrgIds": [
              "LUK.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lawe Kapenawume uzakuphakanyiselwa ezulwini na? Atshi! Uzakwehliselwa endaweni yabafileyo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.15",
            "verseOrgIds": [
              "LUK.10.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.14.13+ISA.14.14+ISA.14.15"
              },
              "items": [
                {
                  "text": "Isa 14:13–15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.15",
            "verseOrgIds": [
              "LUK.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olizwayo lina uyangizwa mina; olalayo lina uyangala mina; ongalayo mina uyamala ongithumileyo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.16",
            "verseOrgIds": [
              "LUK.10.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
