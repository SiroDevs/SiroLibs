              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.42",
            "verseOrgIds": [
              "LUK.6.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 6:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasikho isihlahla esihle esithela isithelo esibi; futhi kasikho isihlahla esibi esithela isithelo esihle. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.43",
            "verseOrgIds": [
              "LUK.6.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 6:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba ileso laleso isihlahla saziwa ngesithelo saso. Kakuselwa umkhiwa emeveni, futhi kakukhiwa isithelo sevini evikaneni.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.44",
            "verseOrgIds": [
              "LUK.6.44"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
