              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.33"
              },
              "items": [
                {
                  "text": "Mat 12:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.44",
            "verseOrgIds": [
              "LUK.6.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 6:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu omuhle uveza okuhle enothweni enhle yenhliziyo yakhe, lomuntu omubi uveza okubi enothweni yakhe embi; ngoba umlomo wakhe ukhuluma ngokugcwala kwenhliziyo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.45",
            "verseOrgIds": [
              "LUK.6.45"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
