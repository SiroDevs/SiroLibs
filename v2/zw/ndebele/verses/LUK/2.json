          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umntwana wakhula, waba lamandla, wagcwala ukuhlakanipha; lomusa kaNkulunkulu wawuphezu kwakhe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.40",
            "verseOrgIds": [
              "LUK.2.40"
            ]
          }
        }
