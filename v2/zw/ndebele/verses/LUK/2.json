          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abazali bakhe baya eJerusalema iminyaka yonke ngomkhosi wePhasika.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.41",
            "verseOrgIds": [
              "LUK.2.41"
            ]
          }
        },
