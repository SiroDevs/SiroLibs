              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.1",
            "verseOrgIds": [
              "NUM.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tshono kuAroni uthi: Nxa umisa izibane eziyisikhombisa, zizakukhanyisa phambi koluthi lwesibane. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.2",
            "verseOrgIds": [
              "NUM.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "UAroni wenza njalo, wamisa izibane zalo ukuba zikhanyise phambi koluthi lwesibane, njengokutsho kweNkosi kuMose. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.3",
            "verseOrgIds": [
              "NUM.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loluluthi lwesibane lwenziwa ngegolide elikhandiweyo kusukela esidindini salo kusiya emalubeni alo. Uluthi lwesibane lwenziwa njengesifanekiso iNkosi emtshengise sona uMose.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.4",
            "verseOrgIds": [
              "NUM.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.4",
            "verseOrgIds": [
              "NUM.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yathi kuMose: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.5",
            "verseOrgIds": [
              "NUM.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahlukanisa amaLevi kubantu bakoIsrayeli, uwahlambulule; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.6",
            "verseOrgIds": [
              "NUM.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "wenze lokhu kuwo ukuwahlambulula, uwachele ngamanzi okuhlambulula, aziphuce umzimba wonke, agezise izigqoko zawo, azihlambulule. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.7",
            "verseOrgIds": [
              "NUM.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Athathe inkunzi kanye lomnikelo wempuphu oqondene layo, impuphu ecolekileyo ixubene lamafutha, uthathe wena enye inkunzi ibe ngumnikelo wesono. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.8",
            "verseOrgIds": [
              "NUM.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzakuwamisa amaLevi phambi kwethente lokuhlangana, ubuthanise lonke ibandla labakoIsrayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.9",
            "verseOrgIds": [
              "NUM.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nxa umisa amaLevi phambi kweNkosi, abakoIsrayeli bazakubeka izandla zabo phezu kwamaLevi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.10",
            "verseOrgIds": [
              "NUM.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "loAroni anikele amaLevi eNkosini, abe yisipho esikhulu esivela ebantwini bakoIsrayeli, ukuba abe yilabo abawenzayo umsebenzi weNkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.11",
            "verseOrgIds": [
              "NUM.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "AmaLevi azakubeka izandla zawo enhlokweni zezinkunzi; wena unikele enye ibe ngumnikelo wesono, lenye ibe ngumnikelo wokutshiswa eNkosini, ukuba wenzele amaLevi indlela yokubuyisana. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.12",
            "verseOrgIds": [
              "NUM.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzakuwamisa amaLevi phambi kukaAroni lamadodana akhe, uwanikele eNkosini abe yisipho esikhulu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.13",
            "verseOrgIds": [
              "NUM.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.13",
            "verseOrgIds": [
              "NUM.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhoke uzakwahlukanisa amaLevi kubantu bakoIsrayeli, ukuba wona abe ngawami, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.14",
            "verseOrgIds": [
              "NUM.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emva kwalokho amaLevi azakungena ukwenza umsebenzi wawo ethenteni lokuhlangana. Uzakuwahlambulula, uwanikele abe yisipho esikhulu, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.15",
            "verseOrgIds": [
              "NUM.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngoba aphiwe mina phakathi kwabantu bakoIsrayeli. Ngizithathele wona endaweni yawo wonke amazibulo abesifazana bakoIsrayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.16",
            "verseOrgIds": [
              "NUM.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba wonke amazibulo phakathi kwabantu bakoIsrayeli ngawami, awabantu lawezifuyo. Ngalolosuku engabulala ngalo wonke amazibulo eGibithe ngazahlukanisela wona;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.17",
            "verseOrgIds": [
              "NUM.8.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.13.2"
              },
              "items": [
                {
                  "text": "Eks 13:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.17",
            "verseOrgIds": [
              "NUM.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "sengithethe amaLevi endaweni yawo wonke amazibulo phakathi kwabantu bakoIsrayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.18",
            "verseOrgIds": [
              "NUM.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phakathi kwabakoIsrayeli ngiwanikile amaLevi abe yisipho sikaAroni lesamadodana akhe, ukuba enzele abakoIsrayeli inkonzo ethenteni lokuhlangana, lokuba enzele abakoIsrayeli indlela yokubuyisana, ukuze kungabi lomkhuhlane phakathi kwabakoIsrayeli nxa besondela endlini engcwele.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.19",
            "verseOrgIds": [
              "NUM.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.19",
            "verseOrgIds": [
              "NUM.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose loAroni lebandla lonke labakoIsrayeli benza njalo kumaLevi njengokutsho kweNkosi kuMose mayelana lamaLevi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.20",
            "verseOrgIds": [
              "NUM.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "LamaLevi azihlambulula, agezisa ingubo zawo; uAroni wawanikela aba yisipho esikhulu phambi kweNkosi, wawenzela indlela yokubuyisana ukuwahlambulula. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.21",
            "verseOrgIds": [
              "NUM.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emva kwalokho amaLevi angena ukwenza umsebenzi wawo ethenteni lokuhlangana phambi kukaAroni lamadodana akhe. Njengokutsho kweNkosi kuMose ngamaLevi, benza njalo kuwo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.22",
            "verseOrgIds": [
              "NUM.8.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
