          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ibandla lakhe elabalwayo lalizinkulungwane ezingamatshumi amane lesithupha, lamakhulu amahlanu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.11",
            "verseOrgIds": [
              "NUM.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labo abazakumisa eceleni kwabakoRubeni ngabesizwe sakoSimeyoni, isikhulu sabo sibe nguShelumiyeli indodana kaZurishadayi; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.12",
            "verseOrgIds": [
              "NUM.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
