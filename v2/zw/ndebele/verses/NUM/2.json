          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaseningizimu kuzakumisa isigaba sabakoRubeni ngaphansi kophawu lwezihonqo zesizwe sabo, isikhulu sabo sibe nguElizuri indodana kaShedewuri; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.10",
            "verseOrgIds": [
              "NUM.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
