          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ibandla lakhe elabalwayo lalizinkulungwane ezingamatshumi amahlanu lesificamunwemunye, lamakhulu amathathu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.13",
            "verseOrgIds": [
              "NUM.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Besekulandela isizwe sakoGadi, isikhulu saso sibe nguEliyasafi indodana kaRehuweli; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.14",
            "verseOrgIds": [
              "NUM.2.14"
            ]
          }
