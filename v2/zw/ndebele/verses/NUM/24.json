          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "UBalami wasesuka, wahamba wabuyela endaweni yakhe; loBalaki wahamba ngeyakhe indlela.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.25",
