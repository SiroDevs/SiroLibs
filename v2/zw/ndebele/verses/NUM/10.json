          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umkhokheli webandla lesizwe sabakoAsheri wayenguPagiyeli indodana kaOkirani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.26",
            "verseOrgIds": [
              "NUM.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umkhokheli webandla lesizwe sabakoNafitali wayenguAhira indodana kaEnani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.27",
            "verseOrgIds": [
              "NUM.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekusukeni kwabo abantu bakoIsrayeli bahamba, belandelana ngezigaba zabo.",
          "type": "text",
          "attrs": {
