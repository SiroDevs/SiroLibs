          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwaselusuka uphawu lwezihonqo zabakoEfrayimi lezigaba zabo; umkhokheli webandla labo wayenguElishama indodana kaAmihudi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.22",
            "verseOrgIds": [
              "NUM.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umkhokheli webandla lesizwe sabakoManase wayenguGamaliyeli indodana kaPedazuri. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.23",
            "verseOrgIds": [
              "NUM.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umkhokheli webandla lesizwe sabakoBenjamini wayenguAbidani indodana kaGideyoni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.24",
            "verseOrgIds": [
              "NUM.10.24"
            ]
          }
        }
