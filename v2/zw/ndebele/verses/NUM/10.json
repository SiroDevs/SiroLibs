          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wathi: Ake ungasitshiyi, ngoba uyazi lapho singamisa khona enkangala, uzakuba ngamehlo ethu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.31",
            "verseOrgIds": [
              "NUM.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba uhamba lathi, okuhle iNkosi ezakusenzela khona, lathi sizakukwenzela khona.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.32",
            "verseOrgIds": [
              "NUM.10.32"
            ]
          }
        }
      ]
