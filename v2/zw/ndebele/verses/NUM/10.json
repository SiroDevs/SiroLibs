            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwaselusuka uphawu lwezihonqo zabakoDani lezigaba zabo; babengabokucina ezihonqweni zonke; umkhokheli webandla labo wayenguAhiyezeri indodana kaAmishadayi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.25",
            "verseOrgIds": [
              "NUM.10.25"
            ]
          }
        },
        {
