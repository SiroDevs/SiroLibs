          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi lapho ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.17",
            "verseOrgIds": [
              "NUM.10.17"
            ]
          }
        },
        {
          "text": " lidilizwa, amadodana kaGerishoni lamadodana kaMerari asuka, alithwala iTabernakeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.17",
            "verseOrgIds": [
              "NUM.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwaselusuka uphawu lwezihonqo zabakoRubeni lezigaba zabo; umkhokheli webandla labo wayenguElizuri indodana kaShedewuri. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.18",
            "verseOrgIds": [
              "NUM.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umkhokheli webandla lesizwe sabakoSimeyoni wayenguShelumiyeli indodana kaZurishadayi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.19",
            "verseOrgIds": [
              "NUM.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umkhokheli webandla lesizwe sabakoGadi wayenguEliyasafi indodana kaDehuweli.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.20",
            "verseOrgIds": [
              "NUM.10.20"
            ]
          }
        }
      ]
