      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yathi kuMose: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.1",
            "verseOrgIds": [
              "NUM.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yenza impondo ezimbili zesiliva, uzikhande, uzisebenzise ekubizeni ibandla lasekusukeni kwabantu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.2",
            "verseOrgIds": [
              "NUM.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekukhaleni kwempondo zombili, lonke ibandla lizahlangana lawe ngasemnyango wethente lokuhlangana. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.3",
            "verseOrgIds": [
              "NUM.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uba kukhaliswa uphondo olulodwa, izikhulu zodwa ezizinhloko zezizwe zakoIsrayeli zizakuhlangana lawe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.4",
            "verseOrgIds": [
              "NUM.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.4",
            "verseOrgIds": [
              "NUM.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho lihlaba umkhosi, izihonqo ezingasempumalanga zizakusuka. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.5",
            "verseOrgIds": [
              "NUM.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lalapho liphinda ukuhlaba umkhosi ngokwesibili, izihonqo ezingaseningizimu zizakusuka. Ukuze zisuke, kakuhlatshwe umkhosi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.6",
            "verseOrgIds": [
              "NUM.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwake lapho lifuna ukubuthanisa ibandla lizakukhalisa impondo, kodwa lingahlabi umkhosi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.7",
            "verseOrgIds": [
              "NUM.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadodana kaAroni, abapristi, yiwo azakukhalisa izimpondo. Lokhu kuzakuba kini isimiso esingelakuphela ezizukulwaneni zenu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.8",
            "verseOrgIds": [
              "NUM.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.8",
            "verseOrgIds": [
              "NUM.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuzakuthi lapho liphuma impi elizweni lakini ukuyakulwa lezitha ezilicindezelayo, lihlabe umkhosi ngezimpondo, ukuba iNkosi uNkulunkulu wenu ilikhumbule, likhululwe ezitheni zenu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.9",
            "verseOrgIds": [
              "NUM.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Langezinsuku zokuthokoza kwenu, lasemikhosini yenu emisiweyo, lasekuthwaseni kwenyanga, lizakhalisa izimpondo ekunikeleni iminikelo yenu yokutshiswa lemihlatshelweni yeminikelo yenu yokuthula, ukuze zilisize ukukhumbula uNkulunkulu wenu. Mina ngiyiNkosi uNkulunkulu wenu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.10",
            "verseOrgIds": [
              "NUM.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.10",
            "verseOrgIds": [
              "NUM.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngomnyaka wesibili, ngosuku lwamatshumi amabili lwenyanga yesibili, iyezi lasuka phezu ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.11",
            "verseOrgIds": [
              "NUM.10.11"
            ]
          }
        },
        {
          "text": " lobufakazi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.11",
            "verseOrgIds": [
              "NUM.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bakoIsrayeli basuka enkangala yaseSinayi ngezigaba ngezigaba; iyezi lema enkangala yaseParani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.12",
            "verseOrgIds": [
              "NUM.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baqalisake ukusuka belaywa yiNkosi ngoMose. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.13",
            "verseOrgIds": [
              "NUM.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuqala kwasuka uphawu lwezihonqo zabakoJuda lezigaba zabo; uNashoni indodana kaAminadaba wayengumkhokheli webandla labo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.14",
            "verseOrgIds": [
              "NUM.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umkhokheli webandla lesizwe sabakoIsakari wayenguNethaneli indodana kaZuwari. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.15",
            "verseOrgIds": [
              "NUM.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umkhokheli webandla lesizwe sabakoZebuluni wayenguEliyabi indodana kaHeloni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.16",
            "verseOrgIds": [
              "NUM.10.16"
            ]
          }
        }
      ]
    },
    {
