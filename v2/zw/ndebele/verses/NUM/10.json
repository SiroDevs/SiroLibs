              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basukake entabeni yeNkosi, bahamba uhambo lwensuku ezintathu; umtshokotsho ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.33",
            "verseOrgIds": [
              "NUM.10.33"
            ]
          }
        },
        {
          "text": " seNkosi wawungaphambi kwabo okohambo losuku olulodwa ukuze ubadingele indawo yokuphumula. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.33",
            "verseOrgIds": [
              "NUM.10.33"
            ]
          }
