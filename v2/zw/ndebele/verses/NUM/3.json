          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.13",
            "verseOrgIds": [
              "NUM.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yathi kuMose enkangala yaseSinayi: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.14",
            "verseOrgIds": [
              "NUM.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bala abantwana bakaLevi ngezindlu zaboyise langensendo, ubale bonke abesilisa kusukela kulabo abalenyanga kusiya phezulu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.15",
            "verseOrgIds": [
              "NUM.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhoke uMose wababala njengokulaya kweNkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.16",
            "verseOrgIds": [
              "NUM.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanka amabizo amadodana kaLevi; uGerishoni loKohathi loMerari. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.17",
            "verseOrgIds": [
              "NUM.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanka amabizo amadodana kaGerishoni ngensendo zawo; uLibini loShimeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.18",
            "verseOrgIds": [
              "NUM.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadodana kaKohathi ngensendo zawo ayengoAmramu loIzihari loHebroni loUziyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.19",
            "verseOrgIds": [
              "NUM.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadodana kaMerari ngensendo zawo ayengoMahli loMushi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.20",
            "verseOrgIds": [
              "NUM.3.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lezi zinsendo zamaLevi ngezindlu zaboyise. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.20",
            "verseOrgIds": [
              "NUM.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "KuGerishoni kwavela usendo lwamaLibini losendo lwamaShimeyi; lezi zinsendo zamaGerishoni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.21",
            "verseOrgIds": [
              "NUM.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inani labo bonke abesilisa ababalwayo, kusukela kulabo abalenyanga kusiya phezulu, lalizinkulungwane eziyisikhombisa lamakhulu amahlanu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.22",
            "verseOrgIds": [
              "NUM.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Insendo zamaGerishoni zamisa emva ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.23",
            "verseOrgIds": [
              "NUM.3.23"
            ]
          }
        },
        {
          "text": " ngasentshonalanga; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.23",
            "verseOrgIds": [
              "NUM.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "isikhulu sendlu yamaGerishoni sasinguEliyasafi indodana kaLayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.24",
            "verseOrgIds": [
              "NUM.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umsebenzi wamadodana kaGerishoni ethenteni lokuhlangana wawuyikulondoloza iTabernakeli, lethente, lesifulelo salo, leveli lomnyango wethente lokuhlangana, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.25",
            "verseOrgIds": [
              "NUM.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "lamakhetheni eguma, leveli lomnyango weguma elizingelezele iTabernakeli lealtare, lezintambo zazo zonke lezizinto.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.26",
            "verseOrgIds": [
              "NUM.3.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.26",
            "verseOrgIds": [
              "NUM.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "KuKohathi kwavela usendo lwamaAmramu, losendo lwamaIzihari, losendo lwamaHebroni, losendo lwamaUziyeli. Lezi zinsendo zamaKohathi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.27",
            "verseOrgIds": [
              "NUM.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inani labo bonke abesilisa ababalwayo, kusukela kulabo abalenyanga kusiya phezulu, lalizinkulungwane ezificaminwembili lamakhulu ayisithupha; benza imisebenzi yendlini engcwele. ",
