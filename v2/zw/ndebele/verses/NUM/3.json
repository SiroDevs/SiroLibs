                "loc": "LEV.10.1+LEV.10.2"
              },
              "items": [
                {
                  "text": "Levi 10:1–2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.26.61"
              },
              "items": [
                {
                  "text": "Nani 26:61",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
