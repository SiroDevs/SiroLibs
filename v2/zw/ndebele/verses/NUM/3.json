            "sid": "NUM 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yasisithi kuMose: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.5",
            "verseOrgIds": [
              "NUM.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sondeza isizwe sakoLevi, usikhethele ukusiza uAroni umpristi lokumsebenzela. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.6",
            "verseOrgIds": [
              "NUM.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazakumsiza yena lebandla lonke emisebenzini yabo phambi kwethente lokuhlangana nxa besenza inkonzo ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.7",
            "verseOrgIds": [
              "NUM.3.7"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.7",
            "verseOrgIds": [
              "NUM.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazalondoloza yonke impahla yethente lokuhlangana, benzele abantu bakoIsrayeli imisebenzi nxa besenza inkonzo eTabernakelini. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.8",
            "verseOrgIds": [
              "NUM.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzakunikela amaLevi kuAroni lasemadodaneni akhe; azakunikelwa kuye ngokupheleleyo ngabantu bakoIsrayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.9",
            "verseOrgIds": [
              "NUM.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzakubeka uAroni lamadodana akhe ukuba benze umsebenzi wabo wobupristi. Kodwa uba kusondela omunye umuntu, uzabulawa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.10",
            "verseOrgIds": [
              "NUM.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
