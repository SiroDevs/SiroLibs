            "sid": "NUM 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lezi yizizukulwana zikaAroni lezikaMose ngesikhathi sokukhuluma kweNkosi kuMose entabeni yaseSinayi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.1",
            "verseOrgIds": [
              "NUM.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanka amadodana kaAroni; uNadabi izibulo, loAbihu, loEleyazare, loIthamari;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.2",
            "verseOrgIds": [
              "NUM.3.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.26.60"
              },
              "items": [
                {
                  "text": "Nani 26:60",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.2",
            "verseOrgIds": [
              "NUM.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "yiwo lawo amabizo amadodana kaAroni, abapristi abagcotshiweyo, abahlukaniselwa ukukhonza enkonzweni yobupristi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.3",
            "verseOrgIds": [
              "NUM.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwake uNadabi loAbihu bafa phambi kweNkosi, lapho benikela umlilo ongafanelanga phambi kweNkosi enkangala yaseSinayi. Babengelabantwana; ngakho uEleyazare loIthamari baphatha umsebenzi wobupristi phansi kukaAroni uyise.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.4",
            "verseOrgIds": [
              "NUM.3.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
