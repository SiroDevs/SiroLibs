          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzakunikela amaLevi kimi engiyiNkosi, endaweni yawo wonke amadodana angamazibulo abakoIsrayeli, unikele kimi lezinkomo zamaLevi endaweni yamazibulo wonke ezinkomo zabakoIsrayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.41",
