          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yathi kuMose loAroni: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.1",
            "verseOrgIds": [
              "NUM.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balani amadodana kaKohathi phakathi kwamadodana kaLevi, ngensendo zawo langezindlu zaboyise, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.2",
            "verseOrgIds": [
              "NUM.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kusukela kulabo abaleminyaka engamatshumi amathathu kusiya kulabo abaleminyaka engamatshumi amahlanu, bonke abalamandla okusebenza, ukuba benze umsebenzi ethenteni lokuhlangana. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.3",
            "verseOrgIds": [
              "NUM.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yilo umsebenzi wamadodana kaKohathi ethenteni lokuhlangana, ukulondoloza izinto ezingcwele kakhulu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.4",
            "verseOrgIds": [
              "NUM.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho kususwa izihonqo, uAroni lamadodana akhe bazakungena, behlise iveli elilikhetheni, basibekele umtshokotsho ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.5",
            "verseOrgIds": [
              "NUM.4.5"
            ]
          }
        },
        {
          "text": " ngalo, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.5",
            "verseOrgIds": [
              "NUM.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "bawembese ngezinzwezwe, bendlale phezu kwaso ilembu eliluhlaza, bafake imijabo yawo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.6",
            "verseOrgIds": [
              "NUM.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazakwendlala phezu kwetafula yezinkwa ezahlukaniselwe iNkosi ilembu eliluhlaza, babeke phezu kwalo imiganu, lenkezo zempepha, lezitsha, lezinditshi zokuthela; lesinkwa sizakuba phezu kwayo insuku zonke. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.7",
            "verseOrgIds": [
              "NUM.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phezu kwalezizinto bazakwendlala ilembu elibomvu, balembese ngezinzwezwe, bafake imijabo yayo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.8",
            "verseOrgIds": [
              "NUM.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazathatha ilembu eliluhlaza, basibekele uluthi lwesibane, lezibane zalo, lendlawu zalo, lemiganu yalo, lezitsha zonke zamafutha ezisetshenziswa kulo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.9",
            "verseOrgIds": [
              "NUM.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazalufaka kanye lezinto zalo zonke ezinzwezweni, bakugaqe konke ogodweni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.10",
            "verseOrgIds": [
              "NUM.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phezu kwealtare legolide bazakwendlala ilembu eliluhlaza, balembese ngezinzwezwe, bafake imijabo yalo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.11",
            "verseOrgIds": [
              "NUM.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazakuthatha yonke impahla esetshenziswa enkonzweni yendlu engcwele, bayifake phezu kwelembu eliluhlaza, bayembese ngezinzwezwe, bayigaqe ogodweni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.12",
            "verseOrgIds": [
              "NUM.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazakususa umlotha ealtareni, bendlale phezu kwalo ilembu eliyibubende, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.13",
            "verseOrgIds": [
              "NUM.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "babeke kulo zonke izinto zealtare ezisetshenziswa enkonzweni, izitsha zalo zokuthwala umlilo, lamafolokwe, lamafotsholo, lemiganu yokuchela, lazo zonke izinto zealtare, bendlale phezu kwalezizinto izinzwezwe, bafake imijabo yalo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.14",
            "verseOrgIds": [
              "NUM.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho uAroni lamadodana akhe sebeqedile ukusibekela impahla engcwele lazo zonke izitsha zakhona, ekususweni kwezihonqo, amadodana kaKohathi azakuza ukukuthwala, kodwa kawayikuthinta izinto ezingcwele ukuba angafi. Yizo lezo izinto zethente lokuhlangana amadodana kaKohathi azakuzithwala.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.15",
            "verseOrgIds": [
              "NUM.4.15"
            ]
          }
        }
      ]
    },
