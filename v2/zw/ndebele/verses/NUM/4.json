          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "UEleyazare indodana kaAroni umpristi uzakulondoloza amafutha esibane, lempepha elephunga elimnandi, lomnikelo wempuphu, lamagcobo okugcoba; uzalondoloza lonke ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.16",
            "verseOrgIds": [
              "NUM.4.16"
            ]
          }
        },
        {
          "text": " lakho konke okukilo, lendlu engcwele lezinto zayo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.16",
            "verseOrgIds": [
              "NUM.4.16"
            ]
          }
        }
      ]
