              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadodana kaMerari uzakuwabala ngensendo zawo langezindlu zaboyise, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.29",
            "verseOrgIds": [
