        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emva kukaAbimeleki kwavela uTola indodana kaPuwa kaDodo, owakoIsakari, ukukhulula uIsrayeli. Wayehlala eShamiri ezintabeni zakoEfrayimi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.1",
            "verseOrgIds": [
              "JDG.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waba ngumahluleli koIsrayeli iminyaka engamatshumi amabili lantathu. Wafa, wangcwatshelwa eShamiri.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.2",
            "verseOrgIds": [
              "JDG.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.2",
            "verseOrgIds": [
              "JDG.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngemva kwakhe kwavela uJayiri owaseGileyadi, waba ngumahluleli koIsrayeli iminyaka engamatshumi amabili lambili. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.3",
            "verseOrgIds": [
              "JDG.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayelamadodana angamatshumi amathathu agada obabhemi abangamatshumi amathathu, belemizi engamatshumi amathathu ethiwa yiHavothi‐Jayiri kuze kube lamhla, eselizweni laseGileyadi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.4",
            "verseOrgIds": [
              "JDG.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJayiri wafa, wangcwatshelwa eKamoni.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.5",
            "verseOrgIds": [
              "JDG.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.5",
            "verseOrgIds": [
              "JDG.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbakoIsrayeli babuya benza okubi phambi kweNkosi, bakhonza oBali ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.6",
            "verseOrgIds": [
              "JDG.10.6"
            ]
          }
        },
        {
          "text": ", onkulunkulu baseSiriya laseSidoni laseMowabi labamaAmoni labamaFilistiya; bayitshiya iNkosi, kabaze bayikhonza. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.6",
            "verseOrgIds": [
              "JDG.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yamthukuthelela uIsrayeli, yamnikela ezandleni zamaFilistiya lamaAmoni ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.7",
            "verseOrgIds": [
              "JDG.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "abahlupha abacindezela bonke abakoIsrayeli ababengaphetsheya kweJordani elizweni lamaAmori eliseGileyadi iminyaka elitshumi leficaminwembili. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.8",
            "verseOrgIds": [
              "JDG.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "AmaAmoni achapha iJordani ukuba alwe labakoJuda labakoBenjamini labakoEfrayimi; uIsrayeli wahlupheka kakhulu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.9",
            "verseOrgIds": [
              "JDG.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbakoIsrayeli bakhala eNkosini bathi: Sonile kuwe, ngoba sikutshiyile, Nkulunkulu wethu, sakhonza ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.10",
            "verseOrgIds": [
              "JDG.10.10"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.10",
            "verseOrgIds": [
              "JDG.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yathi kibo: Kangilikhululanga yini kwabaseGibithe lakumaAmori lakumaAmoni lakumaFilistiya na? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.11",
            "verseOrgIds": [
              "JDG.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lalapho amaSidoni lawo lamaAmaleki lamaMidiyani elicindezela, lakhala kimi, ngalikhulula ezandleni zawo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.12",
            "verseOrgIds": [
              "JDG.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kantike lingitshiyile lakhonza abanye onkulunkulu; ngalokhoke kangisayikulikhulula futhi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.13",
            "verseOrgIds": [
              "JDG.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hambani liyekhala kulabonkulunkulu elibakhethileyo, balikhulule bona ngesikhathi sokuhlupheka kwenu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.14",
            "verseOrgIds": [
              "JDG.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbakoIsrayeli bathi eNkosini: Sonile; yenza kithi lokho okubona kulungile kuwe; ake usikhulule lamhla kodwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.15",
            "verseOrgIds": [
              "JDG.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basebekhupha onkulunkulu bezizweni phakathi kwabo, bakhonza iNkosi eyayingebe isakumela ukuhlupheka kukaIsrayeli.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.16",
            "verseOrgIds": [
              "JDG.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.16",
            "verseOrgIds": [
              "JDG.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "AmaAmoni ahloma, amisa eGileyadi, labakoIsrayeli babuthana bamisa eMizipa. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.17",
            "verseOrgIds": [
              "JDG.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu lezikhulu zaseGileyadi bakhulumisana besithi: Ngubani ozaqala ukulwa lamaAmoni na? Uzakuba yinduna yabo bonke abaseGileyadi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.18",
            "verseOrgIds": [
              "JDG.10.18"
            ]
          }
        }
      ]
    }
  ],
