            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJobe waseyiphendula iNkosi esithi:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.1",
            "verseOrgIds": [
              "JOB.42.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.8",
            "verseOrgIds": [
              "JOB.42.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho uElifazi waseTemani loBilidadi waseShuhi loZofari waseNama, basuka benza njengokutsho kweNkosi; leNkosi yawuzwa umkhuleko kaJobe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.9",
            "verseOrgIds": [
              "JOB.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.9",
            "verseOrgIds": [
              "JOB.42.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 42:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yabuya yamphumelelisa uJobe lapho esekhulekele abangane bakhe, yamnika okuphindwe kabili kulokho ayelakho kuqala.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.10",
            "verseOrgIds": [
              "JOB.42.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.1.1+JOB.1.2+JOB.1.3"
              },
              "items": [
                {
                  "text": "Jobe 1:1–3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.10",
            "verseOrgIds": [
              "JOB.42.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 42:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwasekufika kuye bonke abafowabo labo bonke odadewabo, labo bonke ababesazana laye ngaphambili, badla laye endlini yakhe; bamkhalela, bamduduza ngakho konke okubi iNkosi eyayimehlisele khona. Bonke bamnika imali lesongo legolide. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.11",
            "verseOrgIds": [
              "JOB.42.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 42:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yazibusisa insuku zokucina zikaJobe kulezakuqala. Waba lezimvu ezizinkulungwane ezilitshumi lane, lamakamela azinkulungwane eziyisithupha, lenkabi ezizinkulungwane, lobabhemi abasikazi abayinkulungwane. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.12",
            "verseOrgIds": [
              "JOB.42.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 42:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waba lamadodana ayisikhombisa lamadodakazi amathathu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.13",
            "verseOrgIds": [
              "JOB.42.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 42:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyokuqala wayitha ibizo wathi nguJemima, eyesibili wayitha ibizo elithiwa nguKeziya, leyesithathu wayitha ibizo elithiwa nguKerenihapuki. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.14",
            "verseOrgIds": [
              "JOB.42.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 42:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elizweni lonke kwakungekho abesifazana abahle njengamadodakazi kaJobe; uyise wawanika ilifa kanye labanewabo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.15",
            "verseOrgIds": [
              "JOB.42.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 42:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.15",
            "verseOrgIds": [
              "JOB.42.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 42:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emva kwalokho uJobe wahlala iminyaka elikhulu lamatshumi amane; wabona amadodana akhe, lamadodana amadodana akhe, kwaze kwaba yizizukulwana ezine. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.16",
            "verseOrgIds": [
              "JOB.42.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 42:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wafa uJobe esemdala, eseluphele.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.17",
            "verseOrgIds": [
              "JOB.42.17"
            ]
          }
        }
      ]
    }
  ],
