          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Incwadi ezifisela abaJuda ukuthula lenhlalo enhle zathunyelwa kubo bonke abaJuda emazweni enkosi uAhasuweru alikhulu lamatshumi ayisikhombisa, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.30",
            "verseOrgIds": [
              "EST.9.30"
            ]
          }
        },
        {
          "name": "verse",
