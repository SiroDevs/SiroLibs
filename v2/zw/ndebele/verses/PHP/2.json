  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "PHP 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PHP 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhoke uba kukhona ukukhuthaza kuKristu, uba kukhona ukukhuthaza kothando, uba kukhona ukuhlanganyela kukaMoya, uba kukhona ububele lesihawu, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.1",
            "verseOrgIds": [
              "PHP.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PHP 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "gcwalisani ukuthokoza kwami ngokuba langqondonye, libe lothando lunye, libe lenhliziyonye lokuqonda kunye. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.2",
            "verseOrgIds": [
              "PHP.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PHP 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lingenzi lutho ngokubangisana langokuziqhenya, kodwa ngokuthobeka litshaye sengathi abanye bangcono kulani. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.3",
            "verseOrgIds": [
              "PHP.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PHP 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakube yilowo lalowo angakhathaleli okwakhe yedwa, kodwa kakhathalele lokwabanye. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.4",
            "verseOrgIds": [
              "PHP.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PHP 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kawube kini lowomqondo owawukhona kuKristu Jesu, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.5",
            "verseOrgIds": [
              "PHP.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PHP 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "yena owathi elesimo sikaNkulunkulu, katshongo ukuthi kuyinto yokuphangwa ukulingana loNkulunkulu, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.6",
            "verseOrgIds": [
              "PHP.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PHP 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kodwa wazidela, wathatha isimo senceku, waba ngumuntu. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.7",
            "verseOrgIds": [
              "PHP.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PHP 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi esebuntwini, wazithoba, walalela uNkulunkulu kwaze kwaba sekufeni, yebo, ekufeni esiphambanweni. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.8",
            "verseOrgIds": [
              "PHP.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PHP 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhoke uNkulunkulu wamphakamisa kakhulu, wamnika ibizo elikhulu kulawo wonke, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.9",
            "verseOrgIds": [
              "PHP.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PHP 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuze kuthi ebizweni likaJesu amadolo wonke aguqe, awabasezulwini, lawabasemhlabeni, lawabangaphansi komhlaba,",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.10",
            "verseOrgIds": [
              "PHP.2.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.45.23"
              },
              "items": [
                {
                  "text": "Isa 45:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.10",
            "verseOrgIds": [
              "PHP.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PHP 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "lezindimi zonke zivume ukuthi uJesu Kristu uyiNkosi, kube ludumo lukaNkulunkulu uYise.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.11",
            "verseOrgIds": [
              "PHP.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PHP 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.11",
            "verseOrgIds": [
              "PHP.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PHP 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhoke, bathandiweyo bami, njengalokho lilalela ngezikhathi zonke, kungesikho nxa ngikhona kuphela, kodwa ikakhulu nxa ngingekho, phelelisani umsebenzi wokusiliswa kwenu ngokwesaba langokuthuthumela, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.12",
            "verseOrgIds": [
              "PHP.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PHP 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngoba uNkulunkulu usebenza kini elenza ukuba lithande lisebenzele intando yakhe. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.13",
            "verseOrgIds": [
              "PHP.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PHP 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yenzani zonke izinto ngokungasoli langokungabuzi, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.14",
            "verseOrgIds": [
              "PHP.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PHP 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuze lingasoleki, libe msulwa, abantwana bakaNkulunkulu abangelasici phakathi kwesizukulwana esingaqondanga lesiphambeneyo, elikhanya phakathi kwaso njengezinkanyezi emhlabeni;",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.15",
            "verseOrgIds": [
              "PHP.2.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.5"
              },
              "items": [
                {
                  "text": "Dute 32:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.15",
            "verseOrgIds": [
              "PHP.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PHP 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "libambelele ngokuqinileyo elizwini lokuphila ukuba ngibe lokuzincoma osukwini lukaKristu ngokuthi kangigijimelanga ize, kangisebenzelanga ize. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.16",
            "verseOrgIds": [
              "PHP.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PHP 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yebo, loba nginikelwa emhlatshelweni ongumnikelo wokukholwa kwenu, ngiyathokoza kanye lani lonke. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.17",
            "verseOrgIds": [
              "PHP.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PHP 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokunjaloke thokozani lani, lithokoze kanye lami.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.18",
            "verseOrgIds": [
              "PHP.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PHP 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.18",
            "verseOrgIds": [
              "PHP.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PHP 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyathemba eNkosini uJesu ukuthuma uTimothi kini masinyane, ukuze lami ngithokoziswe yikuzwa indaba zenu. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.19",
            "verseOrgIds": [
              "PHP.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PHP 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kangilaye omunye onjengaye, ozananzelela indaba zenu ngobuqotho; ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.20",
            "verseOrgIds": [
              "PHP.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PHP 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngoba bonke bazifunela okwabo, bengafuni okukaJesu Kristu. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.21",
            "verseOrgIds": [
              "PHP.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PHP 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa liyakwazi ukuthembeka kukaTimothi ukuthi usebenzile kanye lami ngenxa yevangeli njengomntwana kuyise. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.22",
            "verseOrgIds": [
              "PHP.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PHP 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyathembake ukumthuma masinyane, nxa sengibonile ukuthi okuqondene lami kuphelela ngaphi. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.23",
            "verseOrgIds": [
              "PHP.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PHP 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njalo ngiyathemba eNkosini ukuthi lami ngizakuza kini masinyane. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.24",
            "verseOrgIds": [
              "PHP.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PHP 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngibonile ukuthi kufanele ngithume kini loEpafrodithu, umzalwane lesisebenzi lolibutho kanye lami, lesithunywa senu sokungisebenzela ekusweleni kwami; ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.25",
            "verseOrgIds": [
              "PHP.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PHP 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngoba wayelilangatha lonke, ekhathazekile ngoba lizwile ukuthi ubegula. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.26",
            "verseOrgIds": [
              "PHP.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PHP 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lempela wagula waphos’ukufa; kodwa uNkulunkulu wamhawukela, engahawukeli yena yedwa, kodwa ehawukela lami, ukuze ngingabi losizi phezu kolunye. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.27",
            "verseOrgIds": [
              "PHP.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PHP 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhoke ngitshisekela ukumthuma, ukuze kuthi nxa selimbona futhi, lithokoze, losizi lwami lunciphe. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.28",
            "verseOrgIds": [
              "PHP.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PHP 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mamukelenike eNkosini ngokuthokoza konke, abanjaloke libahloniphe; ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.29",
            "verseOrgIds": [
              "PHP.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PHP 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngoba ngenxa yomsebenzi kaKristu waphose wafa edela ukusila kwakhe, ukuze aphelelise okusileleyo ekungisebenzeleni kwenu.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.30",
            "verseOrgIds": [
              "PHP.2.30"
            ]
          }
        }
      ]
    }
  ],
