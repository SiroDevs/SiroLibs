            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emva kwalokho, kusabusa uAtakisekisi inkosi yasePerisiya, kwasuka uEzra owayeyindodana kaSeraya kaAzariya kaHilikiya ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.1",
            "verseOrgIds": [
              "EZR.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kaShaluma kaZadoki kaAhitubi ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.2",
            "verseOrgIds": [
              "EZR.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kaAmariya kaAzariya kaMerayothi ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.3",
            "verseOrgIds": [
              "EZR.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kaZerahiya kaUzi kaBuki ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.4",
            "verseOrgIds": [
              "EZR.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kaAbishuwa kaFiniyasi kaEleyazare kaAroni umpristi omkhulu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.5",
            "verseOrgIds": [
              "EZR.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayengumbhali owaziyo umlayo kaMose owawunikwe yiNkosi, uNkulunkulu kaIsrayeli. Inkosi yamnika konke ayekucelile, ngoba iNkosi uNkulunkulu wakhe yayilaye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.6",
            "verseOrgIds": [
              "EZR.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngomnyaka wesikhombisa wokubusa kwenkosi uAtakisekisi abanye abakoIsrayeli labapristi lamaLevi labahlabeleli labalindi bamasango lezinceku zasethempelini bahamba laye eJerusalema. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.7",
            "verseOrgIds": [
              "EZR.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wafika eJerusalema ngenyanga yesihlanu ngomnyaka wesikhombisa wokubusa kwenkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.8",
            "verseOrgIds": [
              "EZR.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasuka eBabiloni ngosuku lokuqala lwenyanga yokuqala, wayafika eJerusalema ngosuku lokuqala lwenyanga yesihlanu; ngoba uNkulunkulu wakhe wayelaye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.9",
            "verseOrgIds": [
              "EZR.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "UEzra wayezimisele ukuwufunda umlayo weNkosi lokuwenza lokufundisa imithetho lezimiso koIsrayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.10",
            "verseOrgIds": [
              "EZR.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nansi incwadi inkosi uAtakisekisi eyayinika uEzra umpristi umbhali owaziyo imilayo yeNkosi lemithetho yayo eyabekwa koIsrayeli.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.11",
            "verseOrgIds": [
              "EZR.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
