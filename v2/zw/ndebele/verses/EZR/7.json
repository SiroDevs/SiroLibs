              "EZR.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZR 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "UEzra wasesithi: Kayibongwe iNkosi uNkulunkulu wabokhokho eyafaka into enjengale enhliziyweni yenkosi ukuba ithempeli eliseJerusalema libe lodumo, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.27",
            "verseOrgIds": [
              "EZR.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZR 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "yenza inkosi lezikhulu zayo lazo zonke iziphathamandla zayo zibe lomusa kimi. Ngaba lesibindi ngoba iNkosi uNkulunkulu wami yayilami, ngabuthanisa izikhulu zakoIsrayeli ukuhamba lami.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.28",
            "verseOrgIds": [
              "EZR.7.28"
            ]
          }
        }
      ]
    }
