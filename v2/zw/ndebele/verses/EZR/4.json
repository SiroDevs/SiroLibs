          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi lapho izitha zakoJuda lezakoBenjamini sezizwile ukuthi abantu ababuyileyo ekuthunjweni babesakhela iNkosi uNkulunkulu kaIsrayeli ithempeli, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.1",
            "verseOrgIds": [
              "EZR.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "baya kuZerubabeli loJeshuwa lezinhloko zezindlu bathi kibo: Sivumeleni sakhe lani, ngoba sikhonza uNkulunkulu wenu njengani, sinikele imihlatshelo kuye kusukela ensukwini zikaEsarihadoni inkosi yaseAsiriya owasiletha lapha.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.2",
            "verseOrgIds": [
              "EZR.4.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
