          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.5",
            "verseOrgIds": [
              "EZR.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekuqaliseni kokubusa kukaAhasuweru abantu balelolizwe bagwala izincwadi bemangalela abakoJuda labaseJerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.6",
            "verseOrgIds": [
              "EZR.4.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
