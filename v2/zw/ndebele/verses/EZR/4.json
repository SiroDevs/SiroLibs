          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.22",
            "verseOrgIds": [
              "EZR.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZR 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi incwadi yenkosi uAtakisekisi isifundiwe kuboRehuma loShimishayi umbhali lababelabo, baya masinyane kubaJuda abaseJerusalema, babamisa ngamandla ukwakha. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.23",
            "verseOrgIds": [
              "EZR.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZR 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasusimake umsebenzi wokwakha indlu kaNkulunkulu eseJerusalema; wema kwaze kwaba ngumnyaka wesibili wokubusa kukaDariyu inkosi yasePerisiya.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.24",
            "verseOrgIds": [
              "EZR.4.24"
            ]
          }
        }
      ]
    }
