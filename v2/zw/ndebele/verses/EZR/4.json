              },
              "items": [
                {
                  "text": "Esta 1:1",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.6",
            "verseOrgIds": [
              "EZR.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensukwini zokubusa kukaAtakisekisi inkosi yasePerisiya oBishilamu loMithiredathi loTabeyeli labanye abakibo bagwalela uAtakisekisi incwadi eyayilotshwe ngesiAramu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.7",
            "verseOrgIds": [
              "EZR.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "URehuma induna loShimishayi umbhali babhalela inkosi uAtakisekisi bemangalela iJerusalema bathi:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.8",
            "verseOrgIds": [
              "EZR.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.16",
            "verseOrgIds": [
              "EZR.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi yasiphendula isithi: KuboRehuma induna loShimishayi umbhali lakwabanye benu abahlala eSamariya lakulo lonke ilizwe elingaphetsheya komfula iYufrathi ngiyabingelela. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.17",
            "verseOrgIds": [
              "EZR.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZR 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Incwadi elingithumele yona ifundiwe kuhle kimi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.18",
            "verseOrgIds": [
              "EZR.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZR 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngenze umthetho, ukuba kuhlolisiswe, kwabonakala ukuba lokho kusukela endulo lumuzi uhlala uvukela amakhosi, umvukela lokuhlamuka kuhlala kukhona. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.19",
            "verseOrgIds": [
              "EZR.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZR 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakhosi alamandla ake aba khona eJerusalema abusa ilizwe lonke elingaphetsheya komfula iYufrathi, kwathelwa kuwo imithelo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.20",
            "verseOrgIds": [
              "EZR.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZR 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhoke yenzani umthetho ukuba lababantu bamiswe ukuba lumuzi ungakhiwa ngize ngenze umthetho mina. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.21",
            "verseOrgIds": [
              "EZR.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZR 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qaphelisani ukuthi kaliyekethisi kulindaba ukuba kungabi khona okudumaza amakhosi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.22",
            "verseOrgIds": [
              "EZR.4.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
