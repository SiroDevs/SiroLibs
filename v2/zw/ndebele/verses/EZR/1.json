            }
          ]
        },
        {
          "text": "Ngomnyaka wokuqala wokubusa kukaKurosi inkosi yasePerisiya, ukuba kugcwaliseke ilizwi leNkosi eyalikhuluma ngoJeremiya, iNkosi yavusa inhliziyo kaKurosi ukuba amemezele embusweni wakhe wonke, alobe futhi athi:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.1",
            "verseOrgIds": [
              "EZR.1.1"
            ]
