              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.37",
            "verseOrgIds": [
              "JHN.19.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emva kwalokhu uJosefa waseArimathiya, owayengumfundi kaJesu kodwa ekufihla ngenxa yokwesaba abaJuda, wacela kuPilatu ukuba asuse isidumbu sikaJesu; uPilatu wavuma. Ngakho weza, wasisusa isidumbu sakhe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.38",
            "verseOrgIds": [
              "JHN.19.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 19:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kweza loNikodima laye, owake wafika kuye kuqala ebusuku, ephethe ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.39",
            "verseOrgIds": [
              "JHN.19.39"
            ]
          }
        },
        {
          "text": " lixutshaniswe lenhlaba, ubunengi bayo bungangemifuma eminengi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.39",
            "verseOrgIds": [
              "JHN.19.39"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
