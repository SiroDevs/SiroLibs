              },
              "items": [
                {
                  "text": "Joha 3:1–2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.39",
            "verseOrgIds": [
              "JHN.19.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 19:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basebesithatha isidumbu sikaJesu, basigoqela ngamalembu kanye lamakha njengomkhuba welahlo labaJuda. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.40",
            "verseOrgIds": [
              "JHN.19.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 19:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuleyondawo lapho ayebethelwe khona kwakukhona insimu, ensimini kukhona iliba elitsha okwakungazanga kubekwe umuntu kulo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.41",
            "verseOrgIds": [
              "JHN.19.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 19:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngenxa yokulungiselela kwabaJuda bambeka laphoke uJesu, ngoba iliba laliseduze.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.42",
            "verseOrgIds": [
              "JHN.19.42"
            ]
          }
        }
      ]
    }
