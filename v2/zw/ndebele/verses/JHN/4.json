              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.4.24"
              },
              "items": [
                {
                  "text": "Luka 4:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.44",
            "verseOrgIds": [
              "JHN.4.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JHN 4:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi esefikile eGalili, abaseGalili bamamukela bebonile konke akwenzayo eJerusalema emkhosini; ngoba labo babeyile emkhosini.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.45",
            "verseOrgIds": [
              "JHN.4.45"
            ]
          }
        },
        {
          "name": "note",
