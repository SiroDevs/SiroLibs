  "verseCount": 54,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "JHN 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbaFarisi bezwa ukuba uJesu uyazuza abafundi, ubhaphathiza abanengi kuloJohane, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.1",
            "verseOrgIds": [
              "JHN.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "lanxa uJesu ngokwakhe wayengabhaphathizi kodwa abafundi bakhe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.2",
            "verseOrgIds": [
              "JHN.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJesu esezwile lokhu wasuka eJudiya, wabuyela futhi eGalili. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.3",
            "verseOrgIds": [
              "JHN.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwasweleka ukuba adabule eSamariya. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.4",
            "verseOrgIds": [
              "JHN.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wafika emzini waseSamariya okuthiwa yiSikari, eduze lesiqinti uJakobe asinika indodana yakhe uJosefa.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.5",
            "verseOrgIds": [
              "JHN.4.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.33.19"
              },
              "items": [
                {
                  "text": "Gen 33:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.24.32"
              },
              "items": [
                {
                  "text": "Josh 24:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.5",
            "verseOrgIds": [
              "JHN.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umthombo kaJakobe wawulapho. UJesu ekhathele yikuhamba wahlala emthonjeni. Kwakusemini. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.6",
            "verseOrgIds": [
              "JHN.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwafika owesifazana womSamariya ukuba akhe amanzi. UJesu wathi kuye: Nginathisa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.7",
            "verseOrgIds": [
              "JHN.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba abafundi bakhe babehambile baya emzini ukuba bathenge ukudla. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.8",
            "verseOrgIds": [
              "JHN.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwang’khona owesifazana womSamariya wathi kuye: Kungani wena ungumJuda ucela ukunathiswa yimi ngingowesifazana womSamariya na? — Ngoba abaJuda kabadlelani lamaSamariya.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.9",
            "verseOrgIds": [
              "JHN.4.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.4.1+EZR.4.2+EZR.4.3+EZR.4.4+EZR.4.5"
              },
              "items": [
                {
                  "text": "Ezra 4:1–5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.4.1+NEH.4.2"
              },
              "items": [
                {
                  "text": "Neh 4:1–2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.9",
            "verseOrgIds": [
              "JHN.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJesu wathi kuye: Uba ubusazile isiphiwo sikaNkulunkulu lokuthi ungubani othi kuwe: Nginathisa; ubuzakucela kuye, yena ubezakukunika amanzi aphilisayo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.10",
            "verseOrgIds": [
              "JHN.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi kuye: Nkosi, kawulalutho lokukha, lomthombo uyatshona, uwathathaphi pho lamanzi aphilisayo na? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.11",
            "verseOrgIds": [
              "JHN.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wena umkhulu kulokhokho uJakobe owasinika umthombo, wanatha kiwo, yena lamadodana akhe lemihlambi yakhe, na? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.12",
            "verseOrgIds": [
              "JHN.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJesu waphendula, wathi kuye: Ilowo lalowo onatha lamanzi uzakoma futhi; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.13",
            "verseOrgIds": [
              "JHN.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kodwa lowo onatha amanzi engizakumnika wona kasayikoma; amanzi engizakumnika wona azakuba ngumthombo ogobhozayo phakathi kwakhe, kube yikuphila okungapheliyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.14",
            "verseOrgIds": [
              "JHN.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owesifazana wathi kuye: Nkosi, nginike lawomanzi ukuze ngingomi, ngingabe ngiseza ukukha lapha.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.15",
            "verseOrgIds": [
              "JHN.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.15",
            "verseOrgIds": [
              "JHN.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi kuye: Hamba ubize indoda yakho, uze lapha. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.16",
            "verseOrgIds": [
              "JHN.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owesifazana waphendula wathi kuye: Kangilandoda. UJesu wathi kuye: Utsho kuhle ukuthi kawulandoda; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.17",
            "verseOrgIds": [
              "JHN.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngoba usuke waba lamadoda amahlanu; le olayo khathesi kayisiyo indoda yakho. Lokhu ukutsho uqinisile. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.18",
            "verseOrgIds": [
              "JHN.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owesifazana wathi kuye: Nkosi, ngiyabona ukuthi wena ungumprofethi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.19",
            "verseOrgIds": [
              "JHN.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhokho babekhonza kulintaba; kodwa lina lithi eJerusalema yindawo lapho kufanele abantu bakhonze khona. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.20",
            "verseOrgIds": [
              "JHN.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJesu wathi kuye: Mama, kholwa kimi, isikhathi siyeza, lapho lingasayikukhonza uBaba kulintaba ingabe eJerusalema. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.21",
            "verseOrgIds": [
              "JHN.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lina likhonza elingakwaziyo, thina sikhonza esikwaziyo; ngoba ukusiliswa kuvela kubaJuda. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.22",
            "verseOrgIds": [
              "JHN.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa isikhathi siyeza, njalo sesifikile, lapho abakhonzi abaqotho bazakukhonza uBaba ngomoya langeqiniso; ngoba uBaba ufuna abamkhonzayo babe njalo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.23",
            "verseOrgIds": [
              "JHN.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNkulunkulu unguMoya; labo abamkhonzayo bafanele ukukhonza ngomoya langeqiniso. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.24",
            "verseOrgIds": [
              "JHN.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owesifazana wathi kuye: Ngiyazi ukuthi uMesiya uyeza, yena okuthiwa nguKristu; nxa esefikile, uzakusitshela konke. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.25",
            "verseOrgIds": [
              "JHN.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJesu wathi kuye: Mina engikhuluma lawe nginguye.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.26",
            "verseOrgIds": [
              "JHN.4.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.26",
            "verseOrgIds": [
              "JHN.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalesosikhathi bafika abafundi bakhe; bamangala ngoba ekhuluma lowesifazana; kodwa kakho owathi: Ufunani na? Ukhulumelani laye na? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.27",
            "verseOrgIds": [
              "JHN.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owesifazana wasetshiya imbiza yakhe, waya emzini, wathi ebantwini: ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.28",
            "verseOrgIds": [
              "JHN.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wozani libone umuntu ongitshele konke engikwenzileyo; kungaba nguye uKristu lo, kambe? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.29",
            "verseOrgIds": [
              "JHN.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baphuma emzini beza kuye. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.30",
            "verseOrgIds": [
              "JHN.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kusenjalo abafundi bamncenga besithi: Mfundisi, dlana. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.31",
            "verseOrgIds": [
              "JHN.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa wathi kibo: Ngilakho ukudla engikudlayo elingakwaziyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.32",
            "verseOrgIds": [
              "JHN.4.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basebekhulumisana abafundi, besithi: Ukhona yini omlethele ukudla na? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.33",
            "verseOrgIds": [
              "JHN.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJesu wathi kibo: Ukudla kwami kuyikwenza intando yongithumileyo, lokuqeda umsebenzi wakhe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.34",
            "verseOrgIds": [
              "JHN.4.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalitsho yini ukuthi kusasele inyanga ezine kufike ukuvuna na? Khangelani, ngithi kini: Phakamisani amehlo enu, libone ukuthi amabele asemhlophe, aselungele ukuvunwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.35",
            "verseOrgIds": [
              "JHN.4.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ovunayo wamukela umvuzo, abuthe isithelo esiba yikuphila okungapheliyo ukuze ohlanyelayo lovunayo bathokoze bebonke. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.36",
            "verseOrgIds": [
              "JHN.4.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba kulokhu ilizwi liqinisile elokuthi: Omunye uyahlanyela, lomunye uyavuna. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.37",
            "verseOrgIds": [
              "JHN.4.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 4:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalithuma ukuvuna lokho elingakusebenzelanga; abanye basebenzile, lina selingenile emsebenzini wabo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.38",
            "verseOrgIds": [
              "JHN.4.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 4:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.38",
            "verseOrgIds": [
              "JHN.4.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 4:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "AmaSamariya amanengi akulowomuzi akholwa kuye ngenxa yobufakazi bowesifazana obokuthi: Ungitshele konke engikwenzileyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.39",
            "verseOrgIds": [
              "JHN.4.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 4:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi esefikile kuye amaSamariya amcela ukuba ahlale lawo; wahlala khona insuku ezimbili. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.40",
            "verseOrgIds": [
              "JHN.4.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 4:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanye abanengi bakholwa ngenxa yelizwi lakhe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.41",
            "verseOrgIds": [
              "JHN.4.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 4:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bathi kowesifazana: Kasisakholwa ngenxa yamazwi akho nje, ngoba sesizizwele thina, siyazi ukuba isibili lo unguMsilisi womhlaba.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.42",
            "verseOrgIds": [
              "JHN.4.42"
            ]
          }
        }
      ]
    },
    {
