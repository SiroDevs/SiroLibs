          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabuya wawelela ngaphetsheya kweJordani kuleyondawo lapho uJohane wayebhaphathiza khona kuqala, wahlala khona.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.40",
            "verseOrgIds": [
              "JHN.10.40"
            ]
          }
