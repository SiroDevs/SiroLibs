          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "JHN 7:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.52",
            "verseOrgIds": [
              "JHN.7.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "JHN 7:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basebesuka, ilowo lalowo waya ekhaya.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.53",
            "verseOrgIds": [
              "JHN.7.53"
            ]
          }
        }
