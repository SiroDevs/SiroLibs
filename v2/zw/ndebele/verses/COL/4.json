          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konke okumaqondana lami uzakulitshela uTikiko, umzalwane othandekayo lesikhonzi esithembekileyo eNkosini.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.7",
            "verseOrgIds": [
