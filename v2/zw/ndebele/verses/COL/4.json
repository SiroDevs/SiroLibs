          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "loJoshuwa othiwa nguJustusi. Yibo bodwa abokusoka abasebenzela umbuso kaNkulunkulu kanye lami, abakade beyinduduzo kimi. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.11",
            "verseOrgIds": [
              "COL.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "COL 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyalibingelela uEpafra omunye wakini, inceku kaKristu Jesu; uyalikhulekela kakhulu ngezikhathi zonke ukuba lime liphelele liqine entandweni yonke kaNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.12",
            "verseOrgIds": [
              "COL.4.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
