          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nguye esimtshumayelayo, seluleka wonke umuntu, sifundisa bonke abantu ngokuhlakanipha konke, ukuze sibalethe bonke kuKristu bephelele. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.28",
            "verseOrgIds": [
              "COL.1.28"
            ]
          }
        },
        {
