          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngitshikatshikela khona lokho, ngizama ngamandla wonke kaKristu asebenza ngawo kimi.",
          "type": "text",
