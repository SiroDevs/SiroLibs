              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "lafika futhi ensukwini zikaJehoyakimi indodana kaJosiya, inkosi yakoJuda, kwaze kwaba sekupheleni komnyaka wetshumi lanye kaZedekiya indodana kaJosiya, inkosi yakoJuda, kwaze kwaba sekuthunjweni kweJerusalema enyangeni yesihlanu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.3",
