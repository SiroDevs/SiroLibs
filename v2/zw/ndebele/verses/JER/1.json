              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nansi indaba kaJeremiya, indodana kaHilikiya omunye wabapristi ababeseAnathothi elizweni lakoBenjamini. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.1",
            "verseOrgIds": [
              "JER.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilizwi leNkosi lafika kuye ensukwini zikaJosiya indodana kaAmoni, inkosi yakoJuda, ngomnyaka wetshumi lantathu wokubusa kwakhe;",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.2",
            "verseOrgIds": [
              "JER.1.2"
            ]
          }
        },
