            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "2 Kho 22:3—23:27; 2 Lan 34:8—35:19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.2",
            "verseOrgIds": [
              "JER.1.2"
            ]
