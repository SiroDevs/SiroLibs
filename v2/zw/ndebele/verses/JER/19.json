            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yathi: Hamba uyethenga inqayi; uthathe abanye abadala babantu labanye abapristi abadala, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.1",
            "verseOrgIds": [
              "JER.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye esihotsheni seBeni‐Hinomu eSangweni leziNdengezi, utshumayele khona amazwi engikutshela wona.",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.2",
            "verseOrgIds": [
              "JER.19.2"
            ]
          }
        },
        {
