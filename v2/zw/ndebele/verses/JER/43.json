      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 43:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi lapho uJeremiya eseqedile ukukhuluma ebantwini wonke lamazwi eNkosi uNkulunkulu wabo eyayimthume wona kibo, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.1",
            "verseOrgIds": [
              "JER.43.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 43:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "uAzariya indodana kaHoshaya, loJohanani indodana kaKareya, labo bonke abantu abazikhukhumezayo, bathi kuJeremiya: Uqamba amanga. INkosi uNkulunkulu wethu kayikuthumanga ukuba uthi kithi: Lingayi eGibithe ukuba lihlale khona; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.2",
            "verseOrgIds": [
              "JER.43.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 43:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kodwa uBaruki indodana kaNeriya uyakuxabanisa lathi ukuba asinikele kumaKaladiya ukuze asibulale, kumbe asithumbe asise eBabiloni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.3",
            "verseOrgIds": [
              "JER.43.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 43:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho uJohanani indodana kaKareya, lazo zonke induna zempi, labo bonke abantu kabalilalelanga ilizwi leNkosi ukuba bahlale elizweni lakoJuda. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.4",
            "verseOrgIds": [
              "JER.43.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 43:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJohanani indodana kaKareya lazo zonke induna zempi bathatha bonke abaseleyo bakoJuda ababebuyele ukuhlala elizweni lakoJuda bevela kuzo zonke izizwe ababexotshelwe kuzo, baya labo eGibithe,",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.5",
            "verseOrgIds": [
              "JER.43.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.25.26"
              },
              "items": [
                {
                  "text": "2 Kho 25:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.5",
            "verseOrgIds": [
              "JER.43.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 43:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "amadoda, labafazi, labantwana, amadodakazi enkosi, bonke abantu uNebuzaradani induna yabalindi ayebatshiye kuGedaliya indodana kaAhikamu, indodana kaShafani; bathatha loJeremiya umprofethi loBaruki indodana kaNeriya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.6",
            "verseOrgIds": [
              "JER.43.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 43:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayafika eGibithe, ngoba kabalilalelanga ilizwi leNkosi; bafikela eTahafanesi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.7",
            "verseOrgIds": [
              "JER.43.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 43:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.7",
            "verseOrgIds": [
              "JER.43.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 43:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laselifika ilizwi leNkosi kuJeremiya eseTahafanesi, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.8",
            "verseOrgIds": [
              "JER.43.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 43:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "lathi: Thatha amatshe amakhulu, uwabhade endaweni egandelweyo ngasesangweni lesigodlo sikaFaro eTahafanesi, phambi kwabantu bakoJuda, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.9",
            "verseOrgIds": [
              "JER.43.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 43:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "uthi kibo: INkosi yamabandla, uNkulunkulu kaIsrayeli, ithi: Ngizabiza uNebukadineza inkosi yaseBabiloni inceku yami; uzamisa isihlalo sakhe sobukhosi phezu kwalamatshe engiwabekileyo, amise ithente lakhe phezu kwawo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.10",
            "verseOrgIds": [
              "JER.43.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 43:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzafika, ahlasele ilizwe laseGibithe, labo abamiselwe umkhuhlane abanikele emkhuhlaneni, abamiselwe ukuthunjwa abanikele ekuthunjweni, labamiselwe umkhonto abanikele emkhontweni; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.11",
            "verseOrgIds": [
              "JER.43.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 43:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "aphembe umlilo emathempelini abonkulunkulu baseGibithe, abatshise, abathumbe, alicuthe ilizwe laseGibithe njengomalusi ecutha isigqoko sakhe esigcwele izibungu, asuke khona esenqobile. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.12",
            "verseOrgIds": [
              "JER.43.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 43:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzakwaphula insika zokukhonzela zaseHeliyopolisi elizweni laseGibithe, atshise ngomlilo amathempeli abonkulunkulu baseGibithe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.13",
            "verseOrgIds": [
              "JER.43.13"
            ]
          }
        }
      ]
    }
  ],
