            "sid": "JER 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuzakuthi lapho besala ukuyamukela inkezo esandleni sakho, ukuba banathe, uthi kibo: INkosi yamabandla ithi: Limele ukunatha impela. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.28",
            "verseOrgIds": [
              "JER.25.28"
            ]
          }
        },
