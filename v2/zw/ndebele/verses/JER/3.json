            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.23",
            "verseOrgIds": [
              "JER.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.24",
            "verseOrgIds": [
              "JER.3.24"
            ]
          }
        },
        {
          "text": ", into elehlazo iqedile wonke umsebenzi wabokhokho kusukela ebutsheni bethu, izimvu zabo lenkomo zabo, amadodana abo lamadodakazi abo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.24",
            "verseOrgIds": [
              "JER.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asilale phansi silenhloni, sibanjwe zinhloni zethu; ngoba sonile eNkosini uNkulunkulu wethu, thina labokhokho, kusukela ebutsheni bethu kuze kube lamuhla; kasilalelanga ilizwi leNkosi uNkulunkulu wethu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.25",
            "verseOrgIds": [
              "JER.3.25"
            ]
          }
        }
      ]
    }
