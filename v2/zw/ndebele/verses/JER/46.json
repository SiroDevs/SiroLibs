              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yamabandla, uNkulunkulu kaIsrayeli, ithi: Ngizatshaya uAmoni waseThebesi, loFaro, leGibithe kanye labonkulunkulu babo, lamakhosi alo, yebo uFaro kanye labamthembayo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.25",
            "verseOrgIds": [
              "JER.46.25"
            ]
          }
        },
        {
