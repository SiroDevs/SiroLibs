            "sid": "JER 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yathi kimi: Ungakhulekeli lababantu ukuba baphiwe okuhle. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.11",
            "verseOrgIds": [
              "JER.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loba bezila ukudla, kangiyikuzwa ukukhala kwabo; loba benikela umnikelo wokutshiswa lomnikelo wempuphu, kangiyikuthokoza ngabo; kodwa ngizabaqeda ngempi langendlala langomkhuhlane.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.12",
            "verseOrgIds": [
              "JER.14.12"
            ]
          }
        }
      ]
    },
    {
