          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "UZefaniya umpristi wayifunda lincwadi, uJeremiya umprofethi esizwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.29",
            "verseOrgIds": [
              "JER.29.29"
            ]
          }
