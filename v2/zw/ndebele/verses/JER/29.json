          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thumela ilizwi kubo bonke abathunjiweyo uthi: INkosi ithi ngoShemaya waseNehelamu: Njengoba uShemaya etshumayele kini ngingamthumanga mina, walenza ukuba lithembe ize, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.31",
            "verseOrgIds": [
              "JER.29.31"
            ]
          }
        },
        {
