              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phoke, uyekeleleni ukumkhuza uJeremiya waseAnathothi olitshumayezayo na? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.27",
            "verseOrgIds": [
              "JER.29.27"
            ]
          }
        },
