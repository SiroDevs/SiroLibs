              "items": [
                {
                  "text": "2 Kor 10:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.24",
            "verseOrgIds": [
              "JER.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khangela, insuku ziyeza, kutsho iNkosi, lapho ngizatshaya bonke abasokileyo kodwa bengasokanga enhliziyweni; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.25",
            "verseOrgIds": [
              "JER.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngitsho iGibithe loJuda loEdoma loAmoni loMowabi, labo bonke abahlala enkangala abagela inwele zabo emaceleni; ngoba zonke lezizizwe kazisokanga, layo yonke indlu kaIsrayeli kayisokanga enhliziyweni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.26",
            "verseOrgIds": [
              "JER.9.26"
            ]
          }
        }
