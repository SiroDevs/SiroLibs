          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadodana kaAsheri ayengoImina loIshiva loIshivi loBeriya; lodadewabo wayenguSera. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.30",
            "verseOrgIds": [
              "1CH.7.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadodana kaBeriya ayengoHeberi loMalikiyeli uyise kaBirizayithi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.31",
            "verseOrgIds": [
              "1CH.7.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "UHeberi wazala uJafileti loShomeri loHothamu lodadewabo uShuwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.32",
            "verseOrgIds": [
              "1CH.7.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadodana kaJafileti ayengoPasaki loBimihali loAshivathi; yiwo lawo amadodana kaJafileti. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.33",
            "verseOrgIds": [
              "1CH.7.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadodana kaShomeri umfowabo ayengoRohiga loJehuba loAramu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.34",
            "verseOrgIds": [
              "1CH.7.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadodana kaHathamu umfowabo ayengoZofa loImina loSheleshi loAmali. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.35",
            "verseOrgIds": [
              "1CH.7.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadodana kaZofa ayengoSuwa loHarineferi loShuwali loBeri loImra ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.36",
            "verseOrgIds": [
              "1CH.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "loBezeri loHodi loShama loShilisha loIthirani loBera. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.37",
            "verseOrgIds": [
              "1CH.7.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadodana kaJetheri ayengoJefune loPisipa loAra. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.38",
            "verseOrgIds": [
              "1CH.7.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 7:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadodana kaUla ayengoAra loHaniyeli loRiziya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.39",
            "verseOrgIds": [
              "1CH.7.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 7:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bonke labo babengabakoAsheri, izinhloko zezindlu, abantu abakhethiweyo, bengamaqhawe alamandla. Balotshwa ngezizukulwana zabo ukuba baphume impi; babezinkulungwane ezingamatshumi amabili lesithupha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.40",
            "verseOrgIds": [
              "1CH.7.40"
            ]
          }
        }
