          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kakudinganga eNkosini. Ngalokhoke iNkosi yambulala, umbuso yawunika uDavida indodana kaJese.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.14",
