            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJowabi indodana kaZeruya waqalisa ukubala abantu, kodwa kabaqedanga. Ulaka lweNkosi uNkulunkulu lwehlela phezu kukaIsrayeli ngenxa yalokho, isibalo kasisalotshwanga engwalweni zendaba zenkosi uDavida.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.24",
            "verseOrgIds": [
              "1CH.27.24"
            ]
          }
        },
