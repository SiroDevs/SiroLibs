          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavida kabalanga labo ababengaphansi kweminyaka engamatshumi amabili, ngoba iNkosi uNkulunkulu yayithembise ukwenza abakoIsrayeli babe banengi njengezinkanyezi zaphezulu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.23",
            "verseOrgIds": [
              "1CH.27.23"
            ]
          }
        },
        {
