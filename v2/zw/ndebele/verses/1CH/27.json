      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanka amabizo abakoIsrayeli, inhloko zezindlu, abaphathi bezinkulungwane labamakhulu, lababhali babo, ababesebenzela inkosi emisebenzini yezigaba zabo; zona zazophisana inyanga ngenyanga ukusebenza kuwo wonke umnyaka. Leso lalesosigaba sasilabantu abazinkulungwane ezingamatshumi amabili lane.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.1",
            "verseOrgIds": [
              "1CH.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.1",
            "verseOrgIds": [
              "1CH.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJashobeyamu indodana kaZabidiyeli wayephethe isigaba sokuqala enyangeni yokuqala; esigabeni sakhe kwakulabantu abazinkulungwane ezingamatshumi amabili lane; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.2",
            "verseOrgIds": [
              "1CH.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "wayengowosendo lukaPerezi, eyinduna yabo bonke abaphathi bempi enyangeni yokuqala. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.3",
            "verseOrgIds": [
              "1CH.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDodayi wakoAhohi wayephethe isigaba sesibili senyanga; esigabeni sakhe kwakulabantu abazinkulungwane ezingamatshumi amabili lane. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.4",
            "verseOrgIds": [
              "1CH.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umphathi wesithathu enyangeni yesithathu wayenguBenaya indodana kaJehoyada umpristi omkhulu; esigabeni sakhe kwakulabantu abazinkulungwane ezingamatshumi amabili lane. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.5",
            "verseOrgIds": [
              "1CH.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena uBenaya wayeliqhawe labangamatshumi amathathu, eyinduna yabo. UAmizabadi indodana yakhe wathatha isikhundla sakhe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.6",
            "verseOrgIds": [
              "1CH.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umphathi wesine wayenguAsaheli umfowabo kaJowabi enyangeni yesine; walandelwa yindodana yakhe uZebadiya; esigabeni sakhe kwakulabantu abazinkulungwane ezingamatshumi amabili lane. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.7",
            "verseOrgIds": [
              "1CH.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umphathi wesihlanu enyangeni yesihlanu wayenguShamihuthi wakoIzira; esigabeni sakhe kwakulabantu abazinkulungwane ezingamatshumi amabili lane. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.8",
            "verseOrgIds": [
              "1CH.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umphathi wesithupha enyangeni yesithupha wayenguIra indodana kaIkheshi waseTekowa; esigabeni sakhe kwakulabantu abazinkulungwane ezingamatshumi amabili lane. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.9",
            "verseOrgIds": [
              "1CH.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umphathi wesikhombisa enyangeni yesikhombisa wayenguHelezi wasePeloni wakoEfrayimi; esigabeni sakhe kwakulabantu abazinkulungwane ezingamatshumi amabili lane. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.10",
            "verseOrgIds": [
              "1CH.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umphathi wesificaminwembili enyangeni yesificaminwembili wayenguSibekayi umHushathi wakoZerahi; esigabeni sakhe kwakulabantu abazinkulungwane ezingamatshumi amabili lane. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.11",
            "verseOrgIds": [
              "1CH.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umphathi wesificamunwemunye enyangeni yesificamunwemunye wayenguAbiyezeri waseAnathothi wakoBenjamini; esigabeni sakhe kwakulabantu abazinkulungwane ezingamatshumi amabili lane. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.12",
            "verseOrgIds": [
              "1CH.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umphathi wetshumi enyangeni yetshumi wayenguMahariyi waseNetofa wakoZerahi; esigabeni sakhe kwakulabantu abazinkulungwane ezingamatshumi amabili lane. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.13",
            "verseOrgIds": [
              "1CH.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umphathi wetshumi lanye enyangeni yetshumi lanye wayenguBenaya wasePirathoni wakoEfrayimi; esigabeni sakhe kwakulabantu abazinkulungwane ezingamatshumi amabili lane. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.14",
            "verseOrgIds": [
              "1CH.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umphathi wetshumi lambili enyangeni yetshumi lambili wayenguHelidayi waseNetofa wakoOthiniyeli; esigabeni sakhe kwakulabantu abazinkulungwane ezingamatshumi amabili lane.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.15",
            "verseOrgIds": [
              "1CH.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.15",
            "verseOrgIds": [
              "1CH.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanzi izinduna ezinkulu ezaziphethe izizwe zakoIsrayeli. KwabakoRubeni uEliyezeri indodana kaZikiri wayeyinduna enkulu. KwabakoSimeyoni kwakunguShefethiya indodana kaMahaka. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.16",
            "verseOrgIds": [
              "1CH.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "KwabakoLevi kwakunguHashabiya indodana kaKemuweli; koAroni kunguZadoki. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.17",
            "verseOrgIds": [
              "1CH.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "KwabakoJuda kwakunguElihu omunye wabafowabo bakaDavida. KwabakoIsakari kwakunguOmri indodana kaMikayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.18",
            "verseOrgIds": [
              "1CH.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "KwabakoZebuluni kwakunguIshmaya indodana kaObadiya. KwabakoNafitali kwakunguJeremothi indodana kaAziriyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.19",
            "verseOrgIds": [
              "1CH.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "KwabakoEfrayimi kwakunguHosheya indodana kaAzaziya. Engxenyeni yesizwe sabakoManase kwakunguJoweli indodana kaPedaya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.20",
            "verseOrgIds": [
              "1CH.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakwenye ingxenye yesizwe zabakoManase eGileyadi kwakunguIdo indodana kaZekariya. KwabakoBenjamini kwakunguJahasiyeli indodana kaAbineri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.21",
            "verseOrgIds": [
              "1CH.27.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "KwabakoDani kwakunguAzareli indodana kaJerohamu. Yibo labo ababezinduna zezizwe zakoIsrayeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.22",
            "verseOrgIds": [
              "1CH.27.22"
            ]
          }
        }
      ]
    },
    {
