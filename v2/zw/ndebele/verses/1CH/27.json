          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "UAzimavethi indodana kaAdiyeli wayephethe inotho yenkosi; uJonathani indodana kaUziya wayephethe inotho eyayiselizweni eyemizi leyemizana leyezinqaba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.25",
            "verseOrgIds": [
              "1CH.27.25"
            ]
          }
        },
        {
