          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "UEzri indodana kaKelubi wayephethe labo ababesebenza emasimini belima. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.26",
            "verseOrgIds": [
              "1CH.27.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "UShimeyi waseRama wayephethe izivini. UZabidi waseShefama wayephethe izithelo zezivini zokwenza iwayini. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.27",
            "verseOrgIds": [
              "1CH.27.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 27:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "UBali‐Hanani waseGederi wayephethe izihlahla ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.28",
            "verseOrgIds": [
              "1CH.27.28"
            ]
          }
        },
        {
          "text": " lezamaphane ezaziseShefela. UJowashi wayephethe izindlu zamafutha. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.28",
            "verseOrgIds": [
              "1CH.27.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "UShitirayi waseSharoni wayephethe inkomo ezazisidla eSharoni. UShafati indodana kaAdilayi wayephethe inkomo ezazisezigodini. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.29",
            "verseOrgIds": [
              "1CH.27.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 27:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "UObili wakoIshmayeli wayephethe amakamela; uJehideya waseMeronothi ephethe obabhemikazi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.30",
            "verseOrgIds": [
              "1CH.27.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 27:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "uJaziri umHagiri ephethe izimvu. Bonke labo babengabaphathi bempahla zenkosi uDavida. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.31",
            "verseOrgIds": [
              "1CH.27.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 27:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJonathani, isihlobo sikaDavida, wayengumeluleki, eyindoda ehlakaniphileyo lombhali; yena loJehiyeli indodana kaHakimoni babephethe abantwana benkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.32",
            "verseOrgIds": [
              "1CH.27.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 27:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "UAhithofeli wayengumeluleki wenkosi, loHushayi waseArki wayengumngane wenkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.33",
            "verseOrgIds": [
              "1CH.27.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 27:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "UAhithofeli walandelwa nguJehoyada indodana kaBenaya languAbiyatha. UJowabi wayengumphathi wempi yenkosi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.34",
            "verseOrgIds": [
              "1CH.27.34"
            ]
          }
        }
      ]
    }
