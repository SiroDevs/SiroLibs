    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mina Pawuli, obizwe ngentando kaNkulunkulu ukuba ngumphostoli kaJesu Kristu kanye lomzalwane uSostenesi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.1",
            "verseOrgIds": [
              "1CO.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "sithi kulo ibandla likaNkulunkulu eliseKorinte, kubo abahlukaniselwe kuKristu Jesu, ababizelwe ukuba ngabangcwele, kanye labo bonke abakhuleka ebizweni leNkosi yethu uJesu Kristu endaweni zonke, iNkosi yabo leyethu:",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.2",
            "verseOrgIds": [
              "1CO.1.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.1"
              },
              "items": [
                {
                  "text": "Seb 18:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.2",
            "verseOrgIds": [
              "1CO.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakube kini umusa lokuthula okuvela kuNkulunkulu uBaba laseNkosini uJesu Kristu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.3",
            "verseOrgIds": [
              "1CO.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.3",
            "verseOrgIds": [
              "1CO.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyambonga uNkulunkulu ngesikhathi sonke ngani ngenxa yomusa kaNkulunkulu eliwuphiweyo kuKristu Jesu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.4",
            "verseOrgIds": [
              "1CO.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuthi ezintweni zonke linothisiwe kuye, ekukhulumeni konke lekwazini konke, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.5",
            "verseOrgIds": [
              "1CO.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "njengalokhu ubufakazi ngoKristu buqinisiwe kini. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.6",
            "verseOrgIds": [
              "1CO.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho kalisileli lasinye isiphiwo somusa, lisalindele ukwambulwa kweNkosi yethu uJesu Kristu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.7",
            "verseOrgIds": [
              "1CO.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "yena ozakuliqinisa kuze kube sekupheleni, lingabi lacala ngosuku lweNkosi yethu uJesu Kristu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.8",
            "verseOrgIds": [
              "1CO.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNkulunkulu uthembekile, owalibizela ekuhlanganyeleni leNdodana yakhe, uJesu Kristu iNkosi yethu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.9",
            "verseOrgIds": [
              "1CO.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.9",
            "verseOrgIds": [
              "1CO.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyalincenga, bazalwane, ngebizo leNkosi yethu uJesu Kristu, ukuthi lonke likhulume ilizwi libe linye, kungabi khona ukwahlukana phakathi kwenu, kodwa lipheleliswe emqondweni munye lasekuboneni kunye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.10",
            "verseOrgIds": [
              "1CO.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba ngitsheliwe ngabantu bakoKlowe ukuthi kukhona ukuxabana phakathi kwenu, bazalwane bami. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.11",
            "verseOrgIds": [
              "1CO.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngitsho lokhu kokuthi ilowo lalowo wenu uthi: Mina ngingokaPawuli; mina ngingokaApolosi; mina ngingokaKefasi; mina ngingokaKristu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.12",
            "verseOrgIds": [
              "1CO.1.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.24"
              },
              "items": [
                {
                  "text": "Seb 18:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.12",
            "verseOrgIds": [
              "1CO.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "UKristu wahlukanisiwe yini? UPawuli wabethelwa ngenxa yenu na? Labhaphathizwa ebizweni likaPawuli na? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.13",
            "verseOrgIds": [
              "1CO.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyambonga uNkulunkulu ngoba kangibhaphathizanga lamunye wenu, kuphela oKrispusi loGayusi,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.14",
            "verseOrgIds": [
              "1CO.1.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.8"
              },
              "items": [
                {
                  "text": "Seb 18:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.19.29"
              },
              "items": [
                {
                  "text": "19:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.16.23"
              },
              "items": [
                {
                  "text": "Roma 16:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.14",
            "verseOrgIds": [
              "1CO.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "funa kube khona othi labhaphathizwa ebizweni lami. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.15",
            "verseOrgIds": [
              "1CO.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa ngabhaphathiza abendlu kaStefana; ngaphandle kwalabo kangikhumbuli ukuthi ngabhaphathiza omunye.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.16",
            "verseOrgIds": [
              "1CO.1.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.16.15"
              },
              "items": [
                {
                  "text": "1 Kor 16:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.16",
            "verseOrgIds": [
              "1CO.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba uKristu kangithumanga ukuba ngibhaphathize, kodwa ukuba ngitshumayele ivangeli kungesikho ngokuhlakanipha kwamazwi, funa isiphambano sikaKristu senziwe ize.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.17",
            "verseOrgIds": [
              "1CO.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.17",
            "verseOrgIds": [
              "1CO.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indaba yesiphambano iyibuthutha kulabo ababhubhayo, kodwa kithi abasiliswayo ingamandla kaNkulunkulu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.18",
            "verseOrgIds": [
              "1CO.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba kulotshiwe ukuthi:",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.19",
            "verseOrgIds": [
              "1CO.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.25",
            "verseOrgIds": [
              "1CO.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khangelani ukubizwa kwenu, bazalwane; kini kababanengi abahlakaniphileyo ngokomhlaba, kababanengi abalamandla, kababanengi abayizikhulu; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.26",
            "verseOrgIds": [
              "1CO.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CO 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "kodwa uNkulunkulu ukhethile izinto zobuthutha zomhlaba ukuba ayangise abahlakaniphileyo; uNkulunkulu ukhethile okubuthakathaka komhlaba ukuba ayangise okulamandla; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.27",
            "verseOrgIds": [
              "1CO.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CO 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "lezinto eziphansi zomhlaba lezinto ezidelelekayo uNkulunkulu uzikhethile, lezinto ezingekho ukuba achithe izinto ezikhona, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.28",
            "verseOrgIds": [
              "1CO.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CO 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuze kungabi khona umuntu ozincomayo phambi kukaNkulunkulu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.29",
            "verseOrgIds": [
              "1CO.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CO 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "NgoNkulunkulu lina likuKristu Jesu, ngoba uNkulunkulu wamenzela thina ukuhlakanipha lokulunga lokwahlukaniselwa lokukhululwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.30",
            "verseOrgIds": [
              "1CO.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CO 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhoke njengokulotshiweyo: Ozincomayo kazincome eNkosini.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.31",
            "verseOrgIds": [
              "1CO.1.31"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
