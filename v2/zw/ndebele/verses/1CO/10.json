              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "bonke babhaphathizwa kuMose eyezini lasolwandle; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.2",
            "verseOrgIds": [
              "1CO.10.2"
            ]
