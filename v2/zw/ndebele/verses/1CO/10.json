            "sid": "1CO 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "bonke banatha ukunatha kunye komoya; ngoba banatha edwaleni lomoya elahamba labo; lelodwala lalinguKristu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.4",
            "verseOrgIds": [
              "1CO.10.4"
            ]
