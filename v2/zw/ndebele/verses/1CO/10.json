        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.16",
            "verseOrgIds": [
              "1CO.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njengoba isinkwa sisinye, thina esibanengi singumzimba munye, ngoba thina sonke sihlanganyela lesosinkwa sinye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.17",
            "verseOrgIds": [
              "1CO.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khangelani isizwe sakoIsrayeli. Abadlayo imihlatshelo kabasibo abahlanganyela lealtare na?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.18",
            "verseOrgIds": [
              "1CO.10.18"
            ]
          }
        },
