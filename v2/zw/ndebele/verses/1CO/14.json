          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba umuntu engakwazi lokhu, kahlale engaziwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.38",
            "verseOrgIds": [
              "1CO.14.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
