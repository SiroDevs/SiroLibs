        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazalwane, ngithanda ukulikhumbuza ngevangeli engalitshumayeza lona, lelalamukelayo lelimi kulo, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.1",
            "verseOrgIds": [
              "1CO.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "lelisiliswa ngalo uba libambelela kulo, uba kambe lingakholwanga ize. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.2",
            "verseOrgIds": [
              "1CO.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okokuqala ngalinika lokho engakwamukelayo okukuthi uKristu wafela izono zethu njengokwemibhalo,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.3",
            "verseOrgIds": [
              "1CO.15.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.53.5+ISA.53.6+ISA.53.7+ISA.53.8+ISA.53.9+ISA.53.10+ISA.53.11+ISA.53.12"
              },
              "items": [
                {
                  "text": "Isa 53:5–12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.3",
            "verseOrgIds": [
              "1CO.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "lokuthi wambelwa, lokuthi wavuswa kwabafileyo ngosuku lwesithathu njengokwemibhalo,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.4",
            "verseOrgIds": [
              "1CO.15.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.16.8+PSA.16.9+PSA.16.10"
              },
              "items": [
                {
                  "text": "Hubo 16:8–10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.40"
              },
              "items": [
                {
                  "text": "Mat 12:40",
                  "type": "text"
                }
              ]
            },
            {
