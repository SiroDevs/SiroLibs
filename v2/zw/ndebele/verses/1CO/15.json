              "items": [
                {
                  "text": "Joha 20:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.5",
            "verseOrgIds": [
              "1CO.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngemva kwalokho wabonakala ngesikhathi sinye kubazalwane abedlula amakhulu amahlanu, ubunengi babo basekhona lalamhla, lanxa abanye sebafa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.6",
            "verseOrgIds": [
              "1CO.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabuya wabonakala kuJakobe, wasebonakala lakubaphostoli bonke. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.7",
            "verseOrgIds": [
              "1CO.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekucineni kwabo bonke wabonakala kimi enginjengozelwe kungakabi yisikhathi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.8",
            "verseOrgIds": [
              "1CO.15.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.9.3+ACT.9.4+ACT.9.5+ACT.9.6"
              },
              "items": [
                {
                  "text": "Seb 9:3–6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.8",
            "verseOrgIds": [
              "1CO.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba ngingomncinyane kubaphostoli, engingafanele ukuthiwa ngumphostoli, ngoba ngazingela ibandla likaNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.9",
            "verseOrgIds": [
              "1CO.15.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.8.3"
              },
              "items": [
                {
                  "text": "Seb 8:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.9",
            "verseOrgIds": [
              "1CO.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa ngomusa kaNkulunkulu ngiyikho lokho engiyikho khona, umusa wakhe kimi kawubanga yize; isibili, ngisebenze kakhulu kulabo bonke; kanti kasimi engasebenzayo, kodwa ngumusa kaNkulunkulu okimi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.10",
            "verseOrgIds": [
              "1CO.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhoke loba kuyimi loba kuyibo, sitshumayela ngokunjalo, lakholwa ngokunjalo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.11",
            "verseOrgIds": [
              "1CO.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.11",
            "verseOrgIds": [
              "1CO.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba uKristu etshunyayelwa ukuthi uvusiwe kwabafileyo, batsho kanjani abanye phakathi kwenu ukuthi kakukho ukuvuka kwabafileyo na? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.12",
            "verseOrgIds": [
              "1CO.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba kungekho ukuvuka kwabafileyo, kavuswanga laye uKristu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.13",
            "verseOrgIds": [
              "1CO.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba uKristu engavuswanga kwabafileyo, ukutshumayela kwethu kuyize, lokukholwa kwenu kuyize. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.14",
            "verseOrgIds": [
              "1CO.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lathi sifunyanwa singofakazi bamanga ngoNkulunkulu, ngoba safakaza ukuthi uNkulunkulu wamvusa uKristu; kodwa yena engamvusanga, uba kanti abafileyo bengavuswa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.15",
            "verseOrgIds": [
              "1CO.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba uba abafileyo bengavuswa, kavuswanga laye uKristu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.16",
            "verseOrgIds": [
              "1CO.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba uKristu engavuswanga, ukukholwa kwenu kuyize, lisesezonweni zenu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.17",
            "verseOrgIds": [
              "1CO.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lalabo asebafa bekuKristu sebaphela. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.18",
            "verseOrgIds": [
              "1CO.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba singabathembela kuKristu kulokhukusila kuphela, singabokukhalelwa kulabantu bonke.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.19",
            "verseOrgIds": [
              "1CO.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.19",
            "verseOrgIds": [
              "1CO.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwake uKristu wavuswa isibili kwabafileyo, waba yingqabutho yabafileyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.20",
            "verseOrgIds": [
              "1CO.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba lokhu ukufa kweza ngomuntu, ukuvuka kwabafileyo lakho kweza ngomuntu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.21",
            "verseOrgIds": [
              "1CO.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njengalokhu kuAdamu bonke bayafa, ngokunjalo futhi kuKristu bonke bazakuvuswa baphile. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.22",
            "verseOrgIds": [
              "1CO.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa yilowo lalowo ngesigaba sakhe, uKristu kuqala, besekusiba ngabakaKristu ekufikeni kwakhe, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.23",
            "verseOrgIds": [
              "1CO.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "andubana kufike ukuphela, lapho esenikela umbuso kuNkulunkulu uYise, lalapho esechithile konke ukubusa, lobukhosi, lamandla. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.24",
            "verseOrgIds": [
              "1CO.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba umele ukubusa, aze abeke izitha zakhe ngaphansi kwenyawo zakhe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.25",
            "verseOrgIds": [
              "1CO.15.25"
            ]
          }
        },
        {
          "name": "note",
