          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mayelana leziphiwo zokomoya, bazalwane, kangithandi ukuba lingazi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.1",
            "verseOrgIds": [
              "1CO.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Liyazi ukuthi lapho lalisengabezizwe, laholelwa ezithombeni eziyizimungulu, langaziphi indlela elaholelwa ngazo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.2",
            "verseOrgIds": [
              "1CO.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhoke ngiyalazisa ukuthi kakho umuntu okhuluma ngoMoya kaNkulunkulu ongathi: Kathukwe uJesu. Futhi kakho umuntu ongathi uJesu uyiNkosi; kuphela ngaye uMoya oNgcwele.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.3",
            "verseOrgIds": [
              "1CO.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.3",
            "verseOrgIds": [
              "1CO.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukhona iziphiwo ezehlukeneyo, kodwa uMoya munye.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.4",
            "verseOrgIds": [
              "1CO.12.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.6+ROM.12.7+ROM.12.8"
              },
              "items": [
                {
                  "text": "Roma 12:6–8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.4",
            "verseOrgIds": [
              "1CO.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukhona izinkonzo ezehlukeneyo, kodwa iNkosi yinye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.5",
            "verseOrgIds": [
              "1CO.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukhona imisebenzi yamandla eyehlukeneyo, kodwa munye uNkulunkulu osebenza konke kibo bonke. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.6",
            "verseOrgIds": [
              "1CO.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa ilowo lalowo uphiwa okubonakalisa uMoya kube ngokokusiza. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.7",
            "verseOrgIds": [
              "1CO.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omunye uphiwa ngoMoya ukukhuluma ngokuhlakanipha, omunye aphiwe ilizwi lokwazi ngaye lowoMoya, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.8",
            "verseOrgIds": [
              "1CO.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "omunye aphiwe ukukholwa ngalowoMoya, lomunye aphiwe iziphiwo zokusilisa ngaye uMoya lowo, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.9",
            "verseOrgIds": [
              "1CO.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "omunye aphiwe ukwenza izimangaliso, omunye aphiwe ukutshumayela, omunye aphiwe ukwahlukanisa omoya, lomunye ukukhuluma indimi ngendimi, lomunye ukuchasisa indimi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.10",
            "verseOrgIds": [
              "1CO.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konke lokho kungumsebenzi walowoMoya munye, ebabela ilowo lalowo njengokuthanda kwakhe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.11",
            "verseOrgIds": [
              "1CO.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.11",
            "verseOrgIds": [
              "1CO.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba njengoba umzimba umunye kodwa ulezitho ezinengi, loba zizinengi, zonke zingumzimba munye, kunjaloke loKristu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.12",
            "verseOrgIds": [
              "1CO.12.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.4"
              },
              "items": [
                {
                  "text": "Roma 12:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.12",
            "verseOrgIds": [
              "1CO.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba ngoMoya munye thina sonke sabhaphathizwa sibe mzimba munye, loba singabaJuda loba singamaGriki, loba siyizigqili loba singabakhululekileyo. Thina sonke sanathiswa Moya munye.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.13",
            "verseOrgIds": [
              "1CO.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.13",
            "verseOrgIds": [
              "1CO.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umzimba kawusiso isitho sinye kodwa ungezinengi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.14",
            "verseOrgIds": [
              "1CO.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba unyawo lusithi: Lokhu ngingesisandla, kangisikho okomzimba; lokho kungeze kwalwenza ukuba lungabi yikho okomzimba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.15",
            "verseOrgIds": [
              "1CO.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba indlebe isithi: Lokhu ngingesilo ilihlo, kangisikho okomzimba; lokho kungeze kwayenza ukuba ingabi yikho okomzimba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.16",
            "verseOrgIds": [
              "1CO.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba umzimba wonke ubuyilihlo, ngabe kungaphi ukuzwa na? Uba umzimba wonke ubuyindlebe, ngabe kungaphi ukunuka na? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.17",
            "verseOrgIds": [
              "1CO.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwake uNkulunkulu umisile izitho zonke emzimbeni, yileso laleso njengokuthanda kwakhe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.18",
            "verseOrgIds": [
              "1CO.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba zonke beziyisitho sinye, umzimba ngabe ungaphi na? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.19",
            "verseOrgIds": [
              "1CO.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwake izitho zinengi, kanti umzimba munye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.20",
            "verseOrgIds": [
              "1CO.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilihlo kalilakutsho esandleni ukuthi: Kangikudingi wena. Futhi lekhanda kalilakutsho enyaweni ukuthi: Kangikudingi wena. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.21",
            "verseOrgIds": [
              "1CO.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Impela lezozitho zomzimba ezikhangeleka zibuthakathaka kulezinye ziyadingeka; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.22",
            "verseOrgIds": [
              "1CO.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "lalezozitho zomzimba esithi zidelelekile kulezinye, yizo esizazisa kakhulu; lezitho zethu esilenhloni ngazo siziphatha ngokuhlonipheka okukhulu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.23",
            "verseOrgIds": [
              "1CO.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanti izitho zethu ezilesimo esihle kazikudingi lokho. Kodwa uNkulunkulu wawuhlanganisa umzimba, enika ingxenye edelelekileyo yomzimba udumo olukhulu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.24",
            "verseOrgIds": [
              "1CO.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuze kungabi khona ukwahlukana emzimbeni, kodwa ukuze izitho zonke zomzimba zinanzelelane ngokufananayo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.25",
            "verseOrgIds": [
              "1CO.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba kuhlupheka isitho sinye, zonke zihlupheke kanye laso; uba kudunyiswa sibe sinye, zonke zijabule kanye laso.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.26",
            "verseOrgIds": [
              "1CO.12.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.26",
            "verseOrgIds": [
              "1CO.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CO 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Linake lingumzimba kaKristu lezitho zakhe ngamunye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.27",
            "verseOrgIds": [
              "1CO.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CO 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNkulunkulu umisile abathile ebandleni; kuqala abaphostoli, okwesibili abaprofethi, okwesithathu abafundisi, besekusiba abenzi bezimangaliso, besekusiba abasilisayo, labasizayo, labaphathi, labakhuluma ngendimi ezehlukeneyo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.28",
            "verseOrgIds": [
              "1CO.12.28"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
