          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umfazi ubotshelwe endodeni yakhe uba isekhona; kodwa uba isifa, ukhululekile ukuba endele kulowo amthandayo, kodwa ngokufanele iNkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.39",
            "verseOrgIds": [
              "1CO.7.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CO 7:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa ngokubona kwami ubusisiwe, uba ehlala njengalokho enjalo; lami ngithi ngiloMoya kaNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.40",
            "verseOrgIds": [
              "1CO.7.40"
            ]
          }
