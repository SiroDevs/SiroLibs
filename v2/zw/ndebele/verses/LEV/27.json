              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izibulo lenyamazana, ngoba izibulo ngeleNkosi, kalisoze lehlukaniselwa iNkosi ngumuntu; loba lingelenkomo loba lingelemvu, lingeleNkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.26",
            "verseOrgIds": [
              "LEV.27.26"
            ]
          }
        },
        {
          "name": "verse",
