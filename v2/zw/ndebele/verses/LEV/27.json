          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.21",
            "verseOrgIds": [
              "LEV.27.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba esahlukanisela iNkosi insimu ayithengileyo, engesiyo insimu eyilifa lakhe, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.22",
            "verseOrgIds": [
              "LEV.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "umpristi uzakubala imali yeminyaka eseleyo kuze kufike umnyaka ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.23",
            "verseOrgIds": [
              "LEV.27.23"
            ]
          }
        },
        {
          "text": ", lomuntu akhuphe leyomali ngalolosuku, ibe yinto engcwele eNkosini. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.23",
            "verseOrgIds": [
              "LEV.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngomnyaka weJubili insimu izabuyiselwa kulowo eyathengwa kuye, ngoba insimu iyilifa lakhe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.24",
            "verseOrgIds": [
              "LEV.27.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 27:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konke ukulinganisa kuzakuba ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.25",
            "verseOrgIds": [
              "LEV.27.25"
            ]
          }
        },
        {
          "text": " lendlu engcwele; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.25",
            "verseOrgIds": [
              "LEV.27.25"
            ]
          }
        },
        {
          "text": " angamatshumi amabili azakulingana ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.25",
            "verseOrgIds": [
              "LEV.27.25"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.25",
            "verseOrgIds": [
              "LEV.27.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
