          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba umuntu efisa ukuhlenga okuthile okokwetshumi kwakhe, uzakwengezelela kukho okwesihlanu kwakho. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.31",
            "verseOrgIds": [
              "LEV.27.31"
            ]
