          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba liyinyamazana engcolileyo, umuntu angalihlenga ngokunika okulingana lalo, kodwa engezelele kulo okwesihlanu; uba lingahlengwa, lizakuthengiswa ngokulinganiswa kwalo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.27",
            "verseOrgIds": [
              "LEV.27.27"
            ]
          }
        }
      ]
