              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wathatha isifuba, wasizunguza saba ngumnikelo wokuzunguzwa phambi kweNkosi; sasiyisabelo sakhe senqama yenkonzo yokugcotshwa, njengokulaywa kwakhe yiNkosi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.29",
            "verseOrgIds": [
              "LEV.8.29"
            ]
          }
        }
      ]
