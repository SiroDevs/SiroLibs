          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wasethatha amagcobo okugcoba legazi elalisealtareni, wachela ngakho uAroni lezambatho zakhe, lamadodana akhe lezambatho zawo. Ngalokhu wahlukanisela iNkosi uAroni lezambatho zakhe, lamadodana akhe lezambatho zawo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.30",
            "verseOrgIds": [
              "LEV.8.30"
            ]
          }
        }
      ]
