              },
              "items": [
                {
                  "text": "Eks 29:1–37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.1",
            "verseOrgIds": [
              "LEV.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thatha uAroni lamadodana akhe, lezambatho, lamagcobo okugcoba, lenkunzi yomnikelo wesono, lezinqama ezimbili, lesitsha sezinkwa ezingelamvubelo, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.2",
            "verseOrgIds": [
              "LEV.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ubuthanise lonke ibandla ngasemnyango wethente lokuhlangana. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.3",
            "verseOrgIds": [
              "LEV.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wenza njengokutsho kweNkosi kuye, ibandla labuthana ngasemnyango wethente lokuhlangana. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.4",
            "verseOrgIds": [
              "LEV.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wathi ebandleni: Yikho lokhu iNkosi elaye ukuba kwenziwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.5",
            "verseOrgIds": [
              "LEV.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wasondeza uAroni lamadodana akhe, wabagezisa ngamanzi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.6",
            "verseOrgIds": [
              "LEV.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "UAroni wamambathisa ibhatshi, wambopha ngebhanti, wamgqokisa isigqoko lengubo yamahlombe, wambopha ngebhanti elalukiweyo lengubo yamahlombe, wayibophela kuye ngalo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.7",
            "verseOrgIds": [
              "LEV.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamambathisa ingubo yesifuba, wabeka inkatho iUrimi leThumimi engutsheni yesifuba. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.8",
            "verseOrgIds": [
              "LEV.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamthwalisa iqhiye ekhanda lakhe; phezu kweqhiye, ngaphambili, wabeka incence yegolide, umqhele ongcwele, njengalokhu iNkosi imlayile.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.9",
            "verseOrgIds": [
              "LEV.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.9",
            "verseOrgIds": [
              "LEV.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wasethatha amagcobo okugcoba, waligcoba ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.10",
            "verseOrgIds": [
              "LEV.8.10"
            ]
          }
        },
        {
          "text": " lakho konke okuphakathi kwalo, wakwahlukanisela iNkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.10",
            "verseOrgIds": [
              "LEV.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wafafaza ngawo ialtare kasikhombisa, wagcoba ialtare lezitsha zalo zonke, lomkolo walo lenyawo zawo, ukuba akwahlukanisele iNkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.11",
            "verseOrgIds": [
              "LEV.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathela amagcobo okugcoba ekhanda likaAroni, wamgcoba, ukuba amahlukanisele iNkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.12",
            "verseOrgIds": [
              "LEV.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wasesondeza amadodana kaAroni, wawambathisa amabhatshi, wawabopha ngamabhanti, wawathwalisa izingowane, njengalokhu iNkosi imlayile.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.13",
            "verseOrgIds": [
              "LEV.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.13",
            "verseOrgIds": [
              "LEV.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waseletha inkunzi yomnikelo wesono; uAroni lamadodana akhe babeka izandla zabo enhlokweni yenkunzi yomnikelo wesono. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.14",
            "verseOrgIds": [
              "LEV.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wayihlaba, wathatha igazi, walininda ngomunwe wakhe empondweni zealtare inxa zonke, wahlambulula ialtare, wathululela igazi phansi kwealtare, walahlukanisela iNkosi ukuba alenzele indlela yokubuyisana. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.15",
            "verseOrgIds": [
              "LEV.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathatha lonke idanga lemibilini, lamahwahwa angaphezu kwesibindi, lezinso zombili lamahwahwa azo, wakutshisa ealtareni. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.16",
            "verseOrgIds": [
              "LEV.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa inkunzi, lesikhumba sayo, lenyama yayo, lomswane wayo wakutshisa ngomlilo ngaphandle kwezihonqo, njengalokhu iNkosi imlayile.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.17",
            "verseOrgIds": [
              "LEV.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.17",
            "verseOrgIds": [
              "LEV.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waseletha inqama yomnikelo wokutshiswa; uAroni lamadodana akhe babeka izandla zabo enhlokweni yenqama. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.18",
            "verseOrgIds": [
              "LEV.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wayihlaba, wakhaphazela igazi ealtareni inxa zonke. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.19",
            "verseOrgIds": [
              "LEV.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho uMose esehlahlele inqama, watshisa inhloko lezitho lamahwahwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.20",
            "verseOrgIds": [
              "LEV.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wagezisa imibilini lemilenze ngamanzi, watshisa inqama yonke ealtareni, yaba ngumnikelo wokutshiswa olephunga elimnandi, lomnikelo owenzelwe iNkosi ngomlilo, njengokutsho kwayo kuMose.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.21",
            "verseOrgIds": [
              "LEV.8.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.21",
            "verseOrgIds": [
              "LEV.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waseletha enye inqama, inqama esetshenziswa ekugcotshweni kompristi; uAroni lamadodana akhe babeka izandla zabo enhlokweni yenqama. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.22",
            "verseOrgIds": [
              "LEV.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wayihlaba, wathatha igazi layo, walininda oqwangeni lwendlebe yokunene kaAroni, lasesithupheni sesandla sakhe sokunene, lasezwaneni elikhulu lonyawo lwakhe lokunene. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.23",
            "verseOrgIds": [
              "LEV.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasesondeza amadodana kaAroni, waninda igazi oqwangeni lwezindlebe zawo zokunene, lasezithupheni zezandla zawo zokunene, lasemazwaneni amakhulu enyawo zawo zokunene, wakhaphazela igazi ealtareni inxa zonke. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.24",
            "verseOrgIds": [
              "LEV.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasethatha amahwahwa, lomsila ononileyo, ledanga lonke lemibilini, lamahwahwa angaphezu kwesibindi, lezinso zombili lamahwahwa azo, lomlenze wokunene, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.25",
            "verseOrgIds": [
              "LEV.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakhupha esitsheni sezinkwa ezingelamvubelo esasiphambi kweNkosi iqebelangwana laba linye elingelamvubelo, leqebelengwana laba linye elilamafutha, lesinkwa esincinyane, wakubeka phezu kwamahwahwa laphezu komlenze wokunene; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.26",
            "verseOrgIds": [
              "LEV.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakubeka konke ezandleni zikaAroni lezandleni zamadodana akhe, wakuzunguza kwaba ngumnikelo wokuzunguzwa phambi kweNkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.27",
            "verseOrgIds": [
              "LEV.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wasekuthatha ezandleni zabo, wakutshisa ealtareni lomnikelo wokutshiswa, kwaba ngumnikelo wenkonzo yokugcotshwa olephunga elimnandi, umnikelo owenzelwe iNkosi ngomlilo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.28",
            "verseOrgIds": [
              "LEV.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
