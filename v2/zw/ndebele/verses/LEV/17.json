          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba umuntu wendlu kaIsrayeli, loba owemzini ohlala phakathi kwabo, esidla igazi, ngizakumelana laye olidlayo, ngimkhuphe ebantwini bakibo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.10",
            "verseOrgIds": [
              "LEV.17.10"
            ]
          }
        },
