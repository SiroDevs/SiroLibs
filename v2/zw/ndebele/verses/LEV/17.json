          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.7",
            "verseOrgIds": [
              "LEV.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tshono kubo uthi: Yilowo lalowomuntu wendlu kaIsrayeli, loba owemzini ohlala phakathi kwabo, onikela umnikelo wokutshiswa loba umhlatshelo, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.8",
            "verseOrgIds": [
              "LEV.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "angawulethi emnyango wethente lokuhlangana ukuba awunikele eNkosini, uzakukhutshwa ebantwini bakibo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.9",
            "verseOrgIds": [
              "LEV.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
