        },
        {
          "text": "Ungalali lowesilisa njengowesifazana, ngoba kuyinto embi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.22",
            "verseOrgIds": [
              "LEV.18.22"
            ]
          }
        },
        {
