              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungasondeli kowesifazana wambule ubunqunu bakhe esangcoliswe yikuba semfuleni.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.19",
