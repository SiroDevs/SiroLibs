            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungavumi ukuba abantwana bakho banikelwe kunkulunkulu uMoloki, ukuba uhlambaze ibizo likaNkulunkulu wakho. NgiyiNkosi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.21",
            "verseOrgIds": [
              "LEV.18.21"
            ]
          }
        },
