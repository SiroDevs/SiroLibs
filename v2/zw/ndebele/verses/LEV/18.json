                "loc": "DEU.22.30"
              },
              "items": [
                {
                  "text": "Dute 22:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.20"
              },
              "items": [
                {
                  "text": "27:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.8",
            "verseOrgIds": [
              "LEV.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungambuli ubunqunu bukadadewenu, indodakazi kayihlo loba indodakazi kanyoko, loba ezelwe kini loba ezelwe kwelinye ilizwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.9",
            "verseOrgIds": [
              "LEV.18.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.20.17"
              },
              "items": [
                {
                  "text": "Levi 20:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.22"
              },
              "items": [
                {
                  "text": "Dute 27:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.9",
            "verseOrgIds": [
              "LEV.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungambuli ubunqunu bendodakazi yendodana yakho, loba obendodakazi yendodakazi yakho, ngoba ubunqunu babo yibunqunu bakho. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.10",
            "verseOrgIds": [
              "LEV.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungambuli ubunqunu bendodakazi bomkayihlo ezelwe nguyihlo, lokhu ingudadewenu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.11",
            "verseOrgIds": [
              "LEV.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungambuli ubunqunu bukadadewabo kayihlo, ngoba eyisihlobo sikayihlo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.12",
            "verseOrgIds": [
              "LEV.18.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.20.19+LEV.20.20"
              },
              "items": [
                {
                  "text": "Levi 20:19–20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.12",
            "verseOrgIds": [
              "LEV.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungambuli ubunqunu bukadadewabo kanyoko, ngoba eyisihlobo sikanyoko. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.13",
            "verseOrgIds": [
              "LEV.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungambuli ubunqunu bomfowabo kayihlo; ungasondeli kumkakhe, ngoba eyisihlobo sakho. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.14",
            "verseOrgIds": [
              "LEV.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungambuli ubunqunu bukamalokozana; ungambuli ubunqunu bakhe lokhu engumkamntanakho.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.15",
            "verseOrgIds": [
              "LEV.18.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
