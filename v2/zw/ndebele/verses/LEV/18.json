              "items": [
                {
                  "text": "Levi 20:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.16",
            "verseOrgIds": [
              "LEV.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungambuli ubunqunu bowesifazana kanye lobendodakazi yakhe; ungathathi indodakazi yendodana yakhe loba indodakazi yendodakazi yakhe, ukuba uveze ubunqunu bayo; ngoba bayizihlobo zakho, lokho kuyibubi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.17",
            "verseOrgIds": [
              "LEV.18.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
