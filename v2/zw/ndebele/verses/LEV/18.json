              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungalali lenyamazana, uzingcolise ngayo; futhi owesifazana angazinikeli enyamazaneni, alale layo; lokhu kulihlazo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.23",
            "verseOrgIds": [
