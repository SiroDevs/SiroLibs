      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yathi kuMose loAroni: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.1",
            "verseOrgIds": [
              "LEV.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nxa kukhona emzimbeni womuntu ithumba loba inxeba elibhibhidlayo, loba ibala, lokhu kubonakalisa ukuthi umuntu lo ulobulephero emzimbeni wakhe, kalethwe kuAroni umpristi ingabe kwenye yamadodana akhe angabapristi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.2",
            "verseOrgIds": [
              "LEV.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umpristi uzakukhangela isifo esisemzimbeni walowomuntu; uba uboya obukhona sebuphendukile baba mhlophe, lesifo sesitshonile enyameni yakhe, kuyisifo sobulephero. Umpristi esemhlolile uzakutsho ukuthi ungcolile. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.3",
            "verseOrgIds": [
              "LEV.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uba ibala elisemzimbeni wakhe limhlophe, lingabonakali ukuthi litshonile, loboya obukhona bungaphendukanga baba mhlophe, umpristi uzakumvalela olesifo insuku eziyisikhombisa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.4",
            "verseOrgIds": [
              "LEV.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngosuku lwesikhombisa umpristi uzakumhlola; uba kubonakala kuye ukuthi isifo sisemi, singandanga emzimbeni wakhe, umpristi uzamvalela ezinye insuku eziyisikhombisa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.5",
            "verseOrgIds": [
              "LEV.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngosuku lwesikhombisa umpristi abuye amhlole; uba ibala lifiphele, lesifo singandanga emzimbeni, umpristi uzakutsho ukuthi usehlambulukile; kulibala nje. Kagezise ingubo zakhe, ahlambuluke. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.6",
            "verseOrgIds": [
              "LEV.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uba ibala lisanda emzimbeni wakhe emva kokuzibonakalisa kwakhe kumpristi ngokuhlambuluka kwakhe, kabuye azibonakalise kumpristi futhi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.7",
            "verseOrgIds": [
              "LEV.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "umpristi amhlole; uba ibala landile emzimbeni, umpristi uzakutsho ukuthi ungcolile, ngoba kuyisifo sobulephero.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.8",
            "verseOrgIds": [
              "LEV.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.8",
            "verseOrgIds": [
              "LEV.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho umuntu elobulephero, uzakulethwa kumpristi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.9",
            "verseOrgIds": [
              "LEV.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "umpristi amhlole; uba kukhona emzimbeni wakhe ithumba elimhlophe, eliphendule uboya baba mhlophe, futhi uba ithumba lilomlomo, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.10",
            "verseOrgIds": [
              "LEV.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuyibulephero obudala emzimbeni wakhe; umpristi uzakutsho ukuthi ungcolile, angamvaleli ngoba engcolile. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.11",
            "verseOrgIds": [
              "LEV.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba ubulephero busanda emzimbeni, buze bube semzimbeni wonke womuntu olesifo, kusukela ekhanda kuze kufike enyaweni, njengokubona kompristi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.12",
            "verseOrgIds": [
              "LEV.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "umpristi uzakumhlola; uba wonke umzimba wakhe ulobulephero, umpristi uzakutsho ukuthi uhlambulukile; ngoba konke kuphendukile kwaba mhlophe, uhlambulukile. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.13",
            "verseOrgIds": [
              "LEV.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa nxa kubonakala kuye inyama ebomvu, uzakuba ngongcolileyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.14",
            "verseOrgIds": [
              "LEV.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umpristi uzakuhlola inyama ebomvu, atsho ukuthi ungcolile; inyama ebomvu ingcolile, ngoba iyibulephero. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.15",
            "verseOrgIds": [
              "LEV.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uba inyama ebomvu iphenduka ibe mhlophe, uzakuya kumpristi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.16",
            "verseOrgIds": [
              "LEV.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "umpristi amhlole; uba inyama ebomvu iphendukile yaba mhlophe, umpristi uzakutsho ukuthi olesifo uhlambulukile; uhlambulukile sibili.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.17",
            "verseOrgIds": [
              "LEV.13.17"
            ]
          }
        }
      ]
    },
    {
