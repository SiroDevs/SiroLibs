          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nxa owesifazana loba owesilisa elesilonda ekhanda loba esilevini, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.29",
            "verseOrgIds": [
              "LEV.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "umpristi uzakuhlola isilonda; uba sibonakala ukuthi sitshonile, lezinwele lendevu ezikhona zimpofana zingakhuli, umpristi uzakutsho ukuthi ungcolile; ngoba eloqweqwe olulumayo oluyibulephero ekhanda loba esilevini. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.30",
            "verseOrgIds": [
              "LEV.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba umpristi ebona ukuthi isilonda esilumayo kasitshonanga, lokuthi kakukho inwele ezimpofana kuso, umpristi uzamvalela lowomuntu olesilonda insuku eziyisikhombisa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.31",
            "verseOrgIds": [
              "LEV.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngosuku lwesikhombisa umpristi uzakuhlola isilonda; uba uqweqwe olulumayo lungandanga, futhi kungekho kuso inwele ezimpofana, loqweqwe lubonakala ukuthi kalutshonanga, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.32",
            "verseOrgIds": [
              "LEV.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "umuntu uzakuziphuca, kodwa angaziphuci lapho kukhona uqweqwe, umpristi amvalele olesilonda lesi ezinye insuku eziyisikhombisa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.33",
            "verseOrgIds": [
              "LEV.13.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngosuku lwesikhombisa umpristi uzakukhangela uqweqwe olulumayo; uba lungandanga emzimbeni, futhi lubonakala ukuthi kalutshonanga, umpristi uzakutsho ukuthi uhlambulukile, agezise ingubo zakhe, ahlambuluke. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.34",
            "verseOrgIds": [
              "LEV.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uba uqweqwe lusanda emzimbeni emva kokuhlanjululwa kwakhe, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.35",
            "verseOrgIds": [
              "LEV.13.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "umpristi uzakumhlola; uba uqweqwe lwandile emzimbeni, umpristi kangadingi inwele ezimpofana; ungcolile. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.36",
            "verseOrgIds": [
              "LEV.13.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uba kubonakala kuye ukuthi uqweqwe lusemi, lenwele ezimnyama sezimilile khona, uqweqwe selupholile, lowomuntu uhlambulukile; umpristi katsho ukuthi usehlambulukile.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.37",
            "verseOrgIds": [
              "LEV.13.37"
            ]
          }
        }
      ]
