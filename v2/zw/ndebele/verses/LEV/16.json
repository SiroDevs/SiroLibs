          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba ngalolusuku lizakwenzelwa indlela yokubuyisana ukuba lihlanjululwe; lizahlambuluka kuzo zonke izono zenu phambi kweNkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.30",
            "verseOrgIds": [
              "LEV.16.30"
            ]
          }
        },
        {
          "name": "verse",
