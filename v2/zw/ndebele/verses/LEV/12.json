                {
                  "text": "Gen 17:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.2.21"
              },
              "items": [
                {
                  "text": "Luka 2:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.3",
            "verseOrgIds": [
              "LEV.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owesifazana uzakuhlala nje insuku ezingamatshumi amathathu lantathu, lize lihlambuluke igazi lakhe, angathinti lutho olungcwele, angangeni endlini engcwele, zize ziphelele insuku zokuhlanjululwa kwakhe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.4",
            "verseOrgIds": [
              "LEV.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uba ebeletha inkazana, uzakuba ngongcolileyo amaviki amabili, njengalokhu engcolile nxa esemfuleni; uzakuhlala enjalo insuku ezingamatshumi ayisithupha lesithupha lize lihlambuluke igazi lakhe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.5",
            "verseOrgIds": [
              "LEV.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.5",
            "verseOrgIds": [
              "LEV.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho seziphelile insuku zakhe zokuhlanjululwa, ngomfana loba ngenkazana, kalethe kumpristi ngasemnyango wethente lokuhlangana iwundlu elilomnyaka munye, libe ngumnikelo wokutshiswa, lejuba loba inkwilimba kube ngumnikelo wesono, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.6",
            "verseOrgIds": [
              "LEV.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "umpristi akunikele eNkosini, amenzele indlela yokubuyisana; ng’khona ezakuhlambuluka. Lowo ngumlayo omayelana lalowo obeletha umfana loba inkazana. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.7",
            "verseOrgIds": [
              "LEV.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba esehluleka ukunikela ngemvu, kathathe amajuba amabili loba inkwilimba ezimbili, okunye kube ngumnikelo wokutshiswa lokunye kube ngumnikelo wesono, umpristi amenzele indlela yokubuyisana, ahlambuluke.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.8",
            "verseOrgIds": [
              "LEV.12.8"
            ]
          }
