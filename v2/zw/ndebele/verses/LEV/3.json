          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umpristi uzakukutshisa ealtareni kube yikudla, kube ngumnikelo owenziwe ngomlilo olephunga elimnandi. Wonke amahwahwa ngaweNkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.16",
            "verseOrgIds": [
              "LEV.3.16"
