          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lokhu kuzakuba yisimiso esingelakuphela ezizukulwaneni zenu zonke, emizini yenu yonke, sokuthi lingadli amahwahwa legazi.",
          "type": "text",
