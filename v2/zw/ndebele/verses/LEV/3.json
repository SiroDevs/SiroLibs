          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "abeke isandla sakhe enhlokweni yayo, ayihlabe ngaphambi kwethente lokuhlangana; amadodana kaAroni akhaphazele igazi layo ealtareni inxa zonke. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.13",
            "verseOrgIds": [
