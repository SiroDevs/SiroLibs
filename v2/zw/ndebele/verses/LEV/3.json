          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzakuthatha kiyo, anikele umnikelo owenzelwe iNkosi ngomlilo, idanga lemibilini, lamahwahwa wonke asemibilinini, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.14",
