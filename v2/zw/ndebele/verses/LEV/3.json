              "type": "text"
            }
          ]
        },
        {
          "text": "Uba umnikelo wakhe uyimbuzi, kayinikele phambi kweNkosi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.12",
            "verseOrgIds": [
              "LEV.3.12"
