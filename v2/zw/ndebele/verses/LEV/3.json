          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umpristi uzakukutshisa ealtareni kube yikudla, kube ngumnikelo owenzelwe iNkosi ngomlilo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.11",
            "verseOrgIds": [
              "LEV.3.11"
            ]
