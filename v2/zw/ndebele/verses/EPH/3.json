          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.19",
            "verseOrgIds": [
              "EPH.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EPH 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhoke yena olamandla okwenza okukhulu kakhulu ukwedlula konke esikucelayo lesikunakanayo ngamandla akhe asebenza kithi, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.20",
            "verseOrgIds": [
              "EPH.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EPH 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kakube kuye udumo ebandleni lakuKristu Jesu ezizukulwaneni zonke kuze kube nini lanini. Ameni.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.21",
            "verseOrgIds": [
              "EPH.3.21"
            ]
          }
        }
      ]
    }
