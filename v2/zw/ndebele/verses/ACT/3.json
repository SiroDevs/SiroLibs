          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.14",
            "verseOrgIds": [
              "ACT.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "labulala iNkosi yokuphila ayivusayo uNkulunkulu kwabafileyo, esingofakazi bakho thina. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.15",
            "verseOrgIds": [
              "ACT.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokukholwa ebizweni layo lumuntu elimbonayo lelimaziyo wenziwe waqina, langokukholwa okungoJesu wamukeliswe ukuphila okupheleleyo phambi kwenu lonke.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.16",
            "verseOrgIds": [
              "ACT.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.16",
            "verseOrgIds": [
              "ACT.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa, bazalwane, ngiyazi ukuba lakwenza lokhu ngokungazi njengababusi benu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.17",
            "verseOrgIds": [
              "ACT.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa lokho uNkulunkulu akukhuluma ngaphambili ngomlomo wabaprofethi bonke ukuthi uKristu wakhe uzakuhlupheka, ukwenze kwagcwaliseka. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.18",
            "verseOrgIds": [
              "ACT.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho phendukani, libuye futhi ukuze kuhlanjululwe izono zenu, ukuze kufike izikhathi zokuhlumelela ezivela ebusweni beNkosi, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.19",
            "verseOrgIds": [
              "ACT.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuze ithumele uKristu elimmiselweyo, uJesu, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.20",
            "verseOrgIds": [
              "ACT.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "okumele ukuba izulu limamukele, kuze kufike isikhathi sokubuyisela konke lokhu uNkulunkulu akutshoyo endulo ngomlomo wabaprofethi bakhe abangcwele. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.21",
            "verseOrgIds": [
              "ACT.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wathi: INkosi uNkulunkulu izakulivusela umprofethi kubazalwane benu onjengami; lizakumlalela kukho konke azakukukhuluma kini.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.22",
            "verseOrgIds": [
              "ACT.3.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.18.15"
              },
              "items": [
                {
                  "text": "Dute 18:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.18.18"
              },
              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.22",
            "verseOrgIds": [
              "ACT.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuzakuthi wonke umuntu ongayikumlalela lowomprofethi achithwe ebantwini.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.23",
            "verseOrgIds": [
              "ACT.3.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.18.19"
              },
              "items": [
                {
                  "text": "Dute 18:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.23",
            "verseOrgIds": [
              "ACT.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yebo, labaprofethi bonke, kusukela kuSamuweli labalandelayo, bonke batshumayela ngalezinsuku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.24",
            "verseOrgIds": [
              "ACT.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lina lingamadodana abaprofethi lawesivumelwano uNkulunkulu asenza labokhokho benu, esithi kuAbrahama: Ngenzalo yakho zizakubusiswa zonke izizukulwana zomhlaba.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.25",
            "verseOrgIds": [
              "ACT.3.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.22.18"
              },
              "items": [
                {
                  "text": "Gen 22:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.25",
            "verseOrgIds": [
              "ACT.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 3:26"
          },
          "items": [
            {
              "text": "26",
