                "loc": "MAT.3.11"
              },
              "items": [
                {
                  "text": "Mat 3:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.1.8"
              },
              "items": [
                {
                  "text": "Mark 1:8",
                  "type": "text"
                }
              ]
