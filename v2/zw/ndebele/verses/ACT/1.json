              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.5",
            "verseOrgIds": [
              "ACT.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi sebebuthene laye bambuza bathi: Nkosi, uzabuyisela umbuso kuIsrayeli kulesisikhathi na? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.6",
            "verseOrgIds": [
              "ACT.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi kubo: Kakusikho okwenu ukwazi isikhathi lemizuzu ayimisileyo uBaba ngamandla akhe; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.7",
            "verseOrgIds": [
              "ACT.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kodwa lina lizakwamukela amandla, esefikile phezu kwenu uMoya oNgcwele, libe ngofakazi bami eJerusalema, lakulo lonke elaseJudiya laseSamariya kuze kube semikhawulweni yomhlaba.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.8",
            "verseOrgIds": [
              "ACT.1.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.28.19"
              },
              "items": [
                {
                  "text": "Mat 28:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.16.15"
              },
              "items": [
                {
                  "text": "Mark 16:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.24.47"
