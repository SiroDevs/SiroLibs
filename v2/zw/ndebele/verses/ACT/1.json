                "loc": "MAT.10.2+MAT.10.3+MAT.10.4"
              },
              "items": [
                {
                  "text": "Mat 10:2–4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.3.16+MRK.3.17+MRK.3.18+MRK.3.19"
              },
              "items": [
                {
                  "text": "Mark 3:16–19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.6.14+LUK.6.15+LUK.6.16"
              },
              "items": [
                {
                  "text": "Luka 6:14–16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.13",
            "verseOrgIds": [
              "ACT.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bonke laba bakhuthalela ukukhuleka nganhliziyonye kanye labesifazana, loMariya unina kaJesu, labafowabo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.14",
            "verseOrgIds": [
              "ACT.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
