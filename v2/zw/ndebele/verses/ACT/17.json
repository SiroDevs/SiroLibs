                "loc": "1KI.8.27"
              },
              "items": [
                {
                  "text": "1 Kho 8:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.42.5"
              },
              "items": [
                {
                  "text": "Isa 42:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.48"
              },
              "items": [
                {
                  "text": "Seb 7:48",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.24",
            "verseOrgIds": [
              "ACT.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "futhi kakhonzwa ngezandla zabantu njengokungathi uswele ulutho, ngoba yena uqobo lwakhe uyabapha bonke abantu ukusila lokuphefumula lakho konke; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.25",
            "verseOrgIds": [
              "ACT.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "wazenza izizwe zonke ngazinye ukuba zihlale ebusweni bonke bomhlaba, wazimisela izikhathi eziqunyiweyo lemikhawulo yokuhlala kwazo, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.26",
            "verseOrgIds": [
              "ACT.17.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuba zifune uNkulunkulu, ukuze mhlawumbe zimuzwe, zimfumane, kanti kakhatshana kulowo lalowo wethu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.27",
            "verseOrgIds": [
              "ACT.17.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 17:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba sisila, sihambe, sihlale ngaye, njengokuba imbongi ezithile zakini zitshilo zathi: Ngoba futhi siyinzalo yakhe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.28",
            "verseOrgIds": [
              "ACT.17.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 17:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhoke lokhu siyinzalo kaNkulunkulu, kakufanele ukuba sinakane ukuthi ubuNkulunkulu bunjengegolide ingabe isiliva loba ilitshe okwenziweyo ngeminwe langokunakana kwabantu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.29",
            "verseOrgIds": [
              "ACT.17.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 17:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba izikhathi zokungamazi uNkulunkulu wazibekezelela, kodwa khathesi uyalaya bonke abantu endaweni zonke ukuba baphenduke, ",
          "type": "text",
