          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekuphumeni kwabo esinagogeni abantu bacela ukuba lawomazwi akhulunywe futhi ngeSabatha elilandelayo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.42",
            "verseOrgIds": [
              "ACT.13.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "ACT 13:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi inkonzo yesinagoge isiphumile, abaJuda abanengi labezizwe abakholwayo balandela uPawuli loBarnabasi; bona bakhuluma labo, bebakhuthaza ukuba babambelele emuseni kaNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.43",
            "verseOrgIds": [
              "ACT.13.43"
            ]
          }
        }
      ]
    },
