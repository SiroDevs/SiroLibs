          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabonwa insuku ezinengi yilabo ababekhuphuke laye eGalili ukuya eJerusalema, asebengofakazi bakhe ebantwini.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.31",
            "verseOrgIds": [
