              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lathi sililethela ivangeli lesithembiso esenziwa kubokhokho ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.32",
            "verseOrgIds": [
              "ACT.13.32"
