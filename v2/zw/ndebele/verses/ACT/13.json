              "items": [
                {
                  "text": "Nani 14:34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.1.31"
              },
              "items": [
                {
                  "text": "Dute 1:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.18",
            "verseOrgIds": [
              "ACT.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa esechithile izizwe eziyisikhombisa elizweni laseKanani, wabanika ilizwe lazo libe ngelabo okweminyaka engamakhulu amane lamatshumi amahlanu;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.19",
            "verseOrgIds": [
              "ACT.13.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
