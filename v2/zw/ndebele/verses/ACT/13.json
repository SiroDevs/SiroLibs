                "loc": "DEU.7.1"
              },
              "items": [
                {
                  "text": "Dute 7:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.14.1"
              },
              "items": [
                {
                  "text": "Josh 14:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.19",
            "verseOrgIds": [
              "ACT.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "emva kwalokho wabanika abathonisisi kwaze kwavela uSamuweli umprofethi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.20",
            "verseOrgIds": [
              "ACT.13.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
