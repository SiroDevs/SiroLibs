  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "ACT 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakukhona ebandleni laseAntiyoki abaprofethi labafundisi, oBarnabasi, loSimiyoni othiwa nguNigeri, loLukiyu waseKurene, loManayeni owayondliwe kanye loHerodi umbusi, loSawuli. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.1",
            "verseOrgIds": [
              "ACT.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi bekhonza iNkosi, bezila ukudla, uMoya oNgcwele wathi: Ngahlukaniselani oBarnabasi loSawuli ukuba baye emsebenzini engibabizele wona. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.2",
            "verseOrgIds": [
              "ACT.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sebezile ukudla bakhuleka, babeka izandla zabo phezu kwabo, babathuma.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.3",
            "verseOrgIds": [
              "ACT.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.3",
            "verseOrgIds": [
              "ACT.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bonake sebethunyiwe nguMoya oNgcwele behlela eSelukiya; basuka lapho, baya eKuprosi ngomkolo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.4",
            "verseOrgIds": [
              "ACT.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sebefikile eSalamisi batshumayela ilizwi likaNkulunkulu emasinagogeni abaJuda; babeloJohane engumsizi wabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.5",
            "verseOrgIds": [
              "ACT.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi sebedabule isihlenge sonke, bafika ePafosi, bafumana indoda ethile eyisanuse lomprofethi wamanga, umJuda othiwa nguBarjesu, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.6",
            "verseOrgIds": [
              "ACT.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "wayelombusi uSegiyu Pawuli, indoda ehlakaniphileyo. Yena wabiza uBarnabasi loSawuli efuna ukuzwa ilizwi likaNkulunkulu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.7",
            "verseOrgIds": [
              "ACT.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lesisanuse, uEluma, ngoba litsho njalo ibizo lakhe, waphikisana labo efisa ukuphambukisa umbusi ekukholweni. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.8",
            "verseOrgIds": [
              "ACT.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uSawuli othiwa nguPawuli, egcwele uMoya oNgcwele, wamjolozela ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.9",
            "verseOrgIds": [
              "ACT.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "wathi: Wena ndodana kaSathane, uyisitha sakho konke ukulunga, ugcwele inkohliso yonke lobubi bonke, kawuyekeli ukuphambukisa indlela eziqondileyo zeNkosi na? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.10",
            "verseOrgIds": [
              "ACT.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khangela, isandla seNkosi siphezu kwakho; uzakuba yisiphofu okwesikhathi ungaliboni ilanga. Kwasekumfikela masinyane ukufiphala lomnyama, wahamba edinga abazamdonsa ngesandla. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.11",
            "verseOrgIds": [
              "ACT.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwang’khona umbusi esebonile okwenziweyo wakholwa, emangaliswa yimfundiso yeNkosi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.12",
            "verseOrgIds": [
              "ACT.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.12",
            "verseOrgIds": [
              "ACT.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "UPawuli lababelaye basuka ePafosi ngomkolo, bafika ePerga elasePamfiliya; kodwa uJohane wehlukana labo, wabuyela eJerusalema. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.13",
            "verseOrgIds": [
              "ACT.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bona basuka ePerga baya eAntiyoki elasePisidiya; ngeSabatha bangena esinagogeni, bahlala phansi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.14",
            "verseOrgIds": [
              "ACT.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sekufundiwe umlayo labaprofethi, abaphathi besinagoge bathumela kubo besithi: Bazalwane, uba lilelizwi lokulaya abantu, khulumani. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.15",
            "verseOrgIds": [
              "ACT.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho uPawuli wasukuma, eqhweba ngesandla sakhe, wathi: Madoda akoIsrayeli, lani elesaba uNkulunkulu, lalelani. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.16",
            "verseOrgIds": [
              "ACT.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNkulunkulu walesisizwe sakoIsrayeli wakhetha okhokho, wabaphakamisa abantu bengabafokazana nje elizweni laseGibithe; wabakhupha kulo ngamandla amakhulu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.17",
            "verseOrgIds": [
              "ACT.13.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.1.7"
              },
              "items": [
                {
                  "text": "Eks 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.51"
              },
              "items": [
                {
                  "text": "12:51",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.17",
            "verseOrgIds": [
              "ACT.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wababekezelela okweminyaka engamatshumi amane enkangala.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.18",
            "verseOrgIds": [
              "ACT.13.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
