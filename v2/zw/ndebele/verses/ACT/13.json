              "items": [
                {
                  "text": "16:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.89.20"
              },
              "items": [
                {
                  "text": "Hubo 89:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.22",
            "verseOrgIds": [
              "ACT.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enzalweni yalumuntu uNkulunkulu ulethele uIsrayeli uMsilisi uJesu njengokuthembisa kwakhe; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.23",
            "verseOrgIds": [
              "ACT.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "engakafiki yena uJohane wayesetshumayele ubhaphathizo lokuphenduka kubo bonke abantu bakoIsrayeli.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.24",
            "verseOrgIds": [
              "ACT.13.24"
            ]
          }
        },
        {
          "name": "note",
