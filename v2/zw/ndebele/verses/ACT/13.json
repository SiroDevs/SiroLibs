          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuthi uNkulunkulu usigcwalisile sona kubantwana bethu ngokumvusa uJesu, njengokuba kulotshiwe futhi kulo ihubo lesibili ukuthi:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.33",
            "verseOrgIds": [
