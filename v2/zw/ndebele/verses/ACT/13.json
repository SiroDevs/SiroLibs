            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.3.20"
              },
              "items": [
                {
                  "text": "1 Sam 3:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.20",
            "verseOrgIds": [
              "ACT.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basebecela inkosi; uNkulunkulu wabanika uSawuli indodana kaKishi, umuntu wesizwe sakoBenjamini, okweminyaka engamatshumi amane.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.21",
            "verseOrgIds": [
              "ACT.13.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.8.5"
              },
              "items": [
                {
                  "text": "1 Sam 8:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.10.21"
              },
              "items": [
                {
                  "text": "10:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.21",
            "verseOrgIds": [
              "ACT.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esemkhuphile wabamisela uDavida abe yinkosi yabo, afakaza ngaye ngokuthi: Ngimfumene uDavida indodana kaJese, engumuntu engimthandayo, ozakwenza konke engikuthandayo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.22",
            "verseOrgIds": [
              "ACT.13.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.13.14"
              },
              "items": [
                {
                  "text": "1 Sam 13:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
