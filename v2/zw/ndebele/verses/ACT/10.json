            "number": "33",
            "style": "v",
            "sid": "ACT 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.33",
            "verseOrgIds": [
              "ACT.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwang’khona uPetro wavula umlomo wakhe, wathi: Impela ngiyabona ukuthi uNkulunkulu kakhangeli ubuso bomuntu,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.34",
            "verseOrgIds": [
              "ACT.10.34"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.10.17"
              },
              "items": [
                {
                  "text": "Dute 10:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.34",
            "verseOrgIds": [
              "ACT.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "kodwa ezizweni zonke omesabayo lowenza ukulunga uyamukeleka kuye. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.35",
            "verseOrgIds": [
              "ACT.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yilo ilizwi alithumela kuIsrayeli, etshumayela ivangeli lokuthula ngoJesu Kristu; yena uyiNkosi yabo bonke. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.36",
            "verseOrgIds": [
              "ACT.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Liyalazi ilizwi elamenyezelwa eJudiya lonke, kusukela eGalili emva kobhaphathizo olwatshunyayelwa nguJohane ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.37",
            "verseOrgIds": [
              "ACT.10.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "lokuthi: UNkulunkulu wammisa uJesu waseNazaretha ngoMoya oNgcwele langamandla, lokuthi wahamba esenza okulungileyo, esilisa bonke labo ababesemandleni kaSathane, ngoba uNkulunkulu wayelaye. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.38",
            "verseOrgIds": [
              "ACT.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lathi singofakazi bezinto zonke azenzayo elizweni labaJuda laseJerusalema, bambulala ngokumphanyeka esiphambanweni. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.39",
            "verseOrgIds": [
              "ACT.10.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 10:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uNkulunkulu wamvusa ngosuku lwesithathu, wambonakalisa, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.40",
            "verseOrgIds": [
              "ACT.10.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 10:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "kungesikho kubo bonke abantu kodwa kithi esasikhethwe ngaphambili nguNkulunkulu ukuba ngofakazi, thina esadla sanatha kanye laye emva kokuvuka kwakhe kwabafileyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.41",
            "verseOrgIds": [
              "ACT.10.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "ACT 10:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasilayela ukuba sitshumayele ebantwini, sifakaze ukuthi nguye omiswe nguNkulunkulu ukuba nguMthonisisi wabasilayo labafileyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.42",
            "verseOrgIds": [
              "ACT.10.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "ACT 10:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaye bonke abaprofethi bafakaza ukuthi ngebizo lakhe bonke abakholwa kuye bazakwamukela ukuthethelelwa kwezono.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.43",
            "verseOrgIds": [
              "ACT.10.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
