          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.43",
            "verseOrgIds": [
              "ACT.10.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "ACT 10:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi uPetro esakhuluma lawomazwi, uMoya oNgcwele wehlela phezu kwabo bonke abalizwayo ilizwi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.44",
            "verseOrgIds": [
              "ACT.10.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "ACT 10:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbaJuda abakholwayo ababefike loPetro bamangala, ngoba isiphiwo sikaMoya oNgcwele sathelwa laphezu kwabezizwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.45",
            "verseOrgIds": [
              "ACT.10.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "ACT 10:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba babezwa bekhuluma ngendimi, bedumisa uNkulunkulu. Kwang’khona uPetro wathi: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.46",
            "verseOrgIds": [
              "ACT.10.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "ACT 10:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukhona yini ongala lamanzi ukuba lababantu bangabhaphathizwa abamukele uMoya oNgcwele njengathi na? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.47",
            "verseOrgIds": [
              "ACT.10.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "ACT 10:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waselayela ukuba babhaphathizwe ebizweni likaJesu Kristu. Bamcela ukuba ahlale labo insukwana.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.48",
            "verseOrgIds": [
              "ACT.10.48"
            ]
          }
        }
      ]
    }
