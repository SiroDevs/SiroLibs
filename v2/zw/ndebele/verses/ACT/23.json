              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "wathi: Ngizakuyizwa kuhle indaba yakho, sebefikile abakumangalelayo; walaya ukuba alondolozwe endlini kaHerodi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.35",
