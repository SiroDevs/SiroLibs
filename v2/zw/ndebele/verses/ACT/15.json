              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwasekuvela ukuphikisana okukhulu, basebesahlukana; uBarnabasi wathatha uMarko, wahamba laye ngomkolo, baya eKuprosi.",
          "type": "text",
          "attrs": {
