          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uPawuli wathi kakufanele ukuba bahambe laye owabatshiya ePamfiliya, kaze aya labo emsebenzini.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.38",
            "verseOrgIds": [
              "ACT.15.38"
            ]
          }
