          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emva kwensuku ezithile uPawuli wasesithi kuBarnabasi: Ake sibuye sihambele abazalwane emizini yonke lapho esatshumayela khona ilizwi leNkosi, sibone ukuba bahlezi njani. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.36",
            "verseOrgIds": [
              "ACT.15.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
