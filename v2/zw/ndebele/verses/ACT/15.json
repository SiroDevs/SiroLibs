            "sid": "ACT 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa kwaba kuhle kuSilasi ukuba asale khona.] ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.34",
            "verseOrgIds": [
              "ACT.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uPawuli loBarnabasi basala eAntiyoki, befundisa betshumayela ilizwi leNkosi kanye labanye abanengi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.35",
            "verseOrgIds": [
              "ACT.15.35"
            ]
          }
        }
      ]
