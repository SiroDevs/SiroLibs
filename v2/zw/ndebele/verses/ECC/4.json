      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasengibuya ngibone ukucindezela okwenziwa ngaphansi kwelanga; abacindezelwayo babekhala inyembezi, kodwa kungekho obaduduzayo. Kwakungekho abaduduzayo, ngoba abacindezeli babe lamandla. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.1",
            "verseOrgIds": [
              "ECC.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngathi bayadela abafileyo, ngoba sebefile, bangcono kakhulu kulabaphilayo abasekhona. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.2",
            "verseOrgIds": [
              "ECC.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa ongcono kulabo bonke yilowo ongazanga abe khona ongabubonanga ububi obenziwayo ngaphansi kwelanga.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.3",
            "verseOrgIds": [
              "ECC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.3",
            "verseOrgIds": [
              "ECC.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasengibona ukuthi ukusebenza lakho konke ukuphumelela kuvela ekuncintanisaneni kwabantu. Lokho lakho kulize lamaya.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.4",
            "verseOrgIds": [
              "ECC.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.4",
            "verseOrgIds": [
              "ECC.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bathi: Isiphukuphuku sigoqa izandla zaso sidle inqweqwe zomlomo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.5",
            "verseOrgIds": [
              "ECC.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.5",
            "verseOrgIds": [
              "ECC.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwake kungcono isandla esisodwa esigcweleyo kanye lokuthula kulezandla ezimbili ezigcwele ukutshikatshika kanye lamaya.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.6",
            "verseOrgIds": [
              "ECC.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.6",
            "verseOrgIds": [
              "ECC.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngabuya ngabona ize ngaphansi kwelanga; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.7",
            "verseOrgIds": [
              "ECC.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngabona umuntu ongelabani indodana kumbe umfowabo etshikatshika njalonjalo enganeliswa yinotho yakhe engazibuzi ukuthi: Ngitshikatshikela bani, ngidele ukuzithokozisa na? Lokho lakho kulize lomsebenzi omubi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.8",
            "verseOrgIds": [
              "ECC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.8",
            "verseOrgIds": [
              "ECC.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ababili bangcono kuloyedwa, ngoba bayazuza umvuzo omuhle ngokutshikatshika kwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.9",
            "verseOrgIds": [
              "ECC.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba uba omunye esiwa umnakwabo uzamvusa; kodwa maye kulowo owayo eyedwa kungekho ongamvusa. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.10",
            "verseOrgIds": [
              "ECC.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi uba ababili belele ndawonye bayakhudumezana; oyedwa angakhudumala kanjani na? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.11",
            "verseOrgIds": [
              "ECC.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu angamahlula oyedwa, kodwa ababili bangamelana laye; intambo elemicu emithathu kayiqamuki masinyane.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.12",
            "verseOrgIds": [
              "ECC.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.12",
            "verseOrgIds": [
              "ECC.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umfana ongumyanga ohlakaniphileyo ungcono kulenkosi endala eyisithutha engasavumi ukwelulekwa, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.13",
            "verseOrgIds": [
              "ECC.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngoba angaphuma entolongweni abe yinkosi lanxa wayezelwe engumyanga elizweni asezakulibusa. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.14",
            "verseOrgIds": [
              "ECC.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa ngihlolisisile bonke abantu abakhona ngaphansi kwelanga, ngabona ukuthi umfana angathathelwa isikhundla sakhe ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.15",
            "verseOrgIds": [
              "ECC.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ozabusa abantu abanengi abangelakubalwa; laye kayikuthandeka kulabo abeza emva kwakhe. Lokho lakho kulize lamaya.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.16",
            "verseOrgIds": [
              "ECC.4.16"
            ]
          }
        }
      ]
    }
