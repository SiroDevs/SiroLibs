      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konke kulesikhathi sakho, lakho konke okwenzakalayo kulesibanga sakho ngaphansi kwelanga. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.1",
            "verseOrgIds": [
              "ECC.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukhona isikhathi sokuzalwa, lesikhathi sokufa; isikhathi sokuhlanyela, lesikhathi sokusiphuna okuhlanyelweyo; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.2",
            "verseOrgIds": [
              "ECC.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "isikhathi sokubulala, lesikhathi sokuphilisa; isikhathi sokudiliza, lesikhathi sokwakha; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.3",
            "verseOrgIds": [
              "ECC.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "isikhathi sokukhala, lesikhathi sokuhleka; isikhathi sokulila, lesikhathi sokugida; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.4",
            "verseOrgIds": [
              "ECC.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "isikhathi sokuhlakaza amatshe, lesikhathi sokubuthelela amatshe; isikhathi sokugona, lesikhathi sokungagoni; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.5",
            "verseOrgIds": [
              "ECC.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "isikhathi sokudinga, lesikhathi sokulahlekelwa; isikhathi sokulondoloza, lesikhathi sokulahla; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.6",
            "verseOrgIds": [
              "ECC.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "isikhathi sokudabula, lesikhathi sokuthunga; isikhathi sokuthula, lesikhathi sokukhuluma; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.7",
            "verseOrgIds": [
              "ECC.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "isikhathi sokuthanda, lesikhathi sokuzonda; isikhathi sempi, lesikhathi sokuthula.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.8",
            "verseOrgIds": [
              "ECC.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.8",
            "verseOrgIds": [
              "ECC.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzuzani umuntu ngokusebenza kwakhe na? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.9",
            "verseOrgIds": [
              "ECC.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiwubonile umsebenzi uNkulunkulu awunike abantu ukuba bawenze. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.10",
            "verseOrgIds": [
              "ECC.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukwenzile konke ukuba kube kuhle ngesikhathi sakho; wamnika lomuntu ukwazi isikhathi esidlulileyo lesizayo; kodwa kalakho ukuqedisisa umsebenzi kaNkulunkulu kusukela ekuqaleni kuze kube sekucineni. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.11",
            "verseOrgIds": [
              "ECC.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyazi ukuthi kakukho okungcono kuye ukwedlula ukuthaba lokuzithokozisa esaphila, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.12",
            "verseOrgIds": [
              "ECC.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "lokuthi kuyisipho sikaNkulunkulu ebantwini ukuba bonke badle banathe bazithokozise ngomsebenzi wabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.13",
            "verseOrgIds": [
              "ECC.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyazi ukuthi konke uNkulunkulu akwenzayo kuhlala kokuphela; kakukho okwengezelelwa kukho lokuphungulwa kukho; uNkulunkulu wakwenza kwaba njalo ukuze umuntu esabe phambi kwakhe. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.14",
            "verseOrgIds": [
              "ECC.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lokho okukhona yikho okwakukhona, lalokho okuzaba khona yikho okwakukhona; uNkulunkulu uyaphinda akubuyise futhi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.15",
            "verseOrgIds": [
              "ECC.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.15",
            "verseOrgIds": [
              "ECC.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi ngabona ngaphansi kwelanga ukuthi lapho kufanele kube khona ukwahlulela kwakukhona ububi, lalapho kufanele kube khona ukulunga kwakukhona ububi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.16",
            "verseOrgIds": [
              "ECC.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasengisithi: UNkulunkulu uzathonisisa abalungileyo lababi ngoba kumisiwe isikhathi sakho konke okuqondiweyo lokwenziweyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.17",
            "verseOrgIds": [
              "ECC.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ECC 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasengisithi mayelana labantu: UNkulunkulu uyabahlola ukuba abatshengise ukuthi bafanana lenyamazana. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.18",
            "verseOrgIds": [
              "ECC.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ECC 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba isiphelo sabantu lesiphelo sezinyamazana sinye; njengoba okunye kusifa, konke kuyafa. Konke kuphefumula moya munye, lomuntu kazedluli inyamazana; ngoba konke kulize. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.19",
            "verseOrgIds": [
              "ECC.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ECC 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konke kuya endaweninye, konke kuvela othulini, kubuyele futhi othulini. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.20",
            "verseOrgIds": [
              "ECC.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ECC 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngubani owaziyo ukuba umoya womuntu uya phezulu lokuba owenyamazana uya phansi na? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.21",
            "verseOrgIds": [
              "ECC.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ECC 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasengibona ukuthi kakukho okungcono okwedlula ukuba umuntu azithokozise ngomsebenzi wakhe, ngoba lokhu kuyisabelo sakhe. Ngubani ongamenza abone lokho okuzakwenzeka engasekho na?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.22",
            "verseOrgIds": [
              "ECC.3.22"
            ]
          }
        }
      ]
    }
  ],
