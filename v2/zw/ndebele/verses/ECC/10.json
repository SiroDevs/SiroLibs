  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "ECC 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Impukane ezifileyo zenza amagcobo omthaki ukuba anuke kubi; ngokunjalo ubuthutha obuncinyane nje bungachitha ukuhlakanipha lodumo. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.1",
            "verseOrgIds": [
              "ECC.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inhliziyo yohlakaniphileyo imdonsela kokulungileyo, kodwa inhliziyo yesithutha isidonsela kokubi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.2",
            "verseOrgIds": [
              "ECC.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho isithutha sihamba emgwaqweni kasilangqondo, sitshengisa bonke ukuthi siyisithutha. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.3",
            "verseOrgIds": [
              "ECC.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba umbusi ekuthukuthelela, ungasuki endaweni yakho, ukuthobeka kuyalungisa iziphambeko ezinkulu. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.4",
            "verseOrgIds": [
              "ECC.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukhona ububi esengibubonile ngaphansi kwelanga, iphutha elenziwa kanengi ngababusi; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.5",
            "verseOrgIds": [
              "ECC.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngibonile ubuphukuphuku buphakanyiswa, lonothileyo ehlaliswa endaweni ephansi; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.6",
            "verseOrgIds": [
              "ECC.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngibonile lezigqili zigade amabhiza, izikhulu zihamba ngenyawo njengezigqili. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.7",
            "verseOrgIds": [
              "ECC.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lowo omba umgodi uzawela kuwo; lodiliza umthangala uzalunywa yinyoka.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.8",
            "verseOrgIds": [
              "ECC.10.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.7.15"
              },
              "items": [
                {
                  "text": "Hubo 7:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.26.27"
              },
              "items": [
                {
                  "text": "Zaga 26:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.8",
            "verseOrgIds": [
              "ECC.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omba amatshe ayamlimaza; lobanda izigodo usengozini yazo. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.9",
            "verseOrgIds": [
              "ECC.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba ihloka libuthundu lingalolwa, umuntu uyavinyelela ngamandla; kodwa ukuhlakanipha kuyamsiza umuntu ukuba aphumelele. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.10",
            "verseOrgIds": [
              "ECC.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba inyoka iluma ingakalunjwa, umlumbi kasasizi lutho.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.11",
            "verseOrgIds": [
              "ECC.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.11",
            "verseOrgIds": [
              "ECC.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amazwi omuntu ohlakaniphileyo amenzela umusa, kodwa ulimi lwesithutha luyasichitha. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.12",
            "verseOrgIds": [
              "ECC.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siqala ngokukhuluma ubuthutha, siyecina ngokukhuluma ububi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.13",
            "verseOrgIds": [
              "ECC.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isithutha siyaphophotha nje, kanti kakulamuntu owaziyo lokho okuzakuba khona lalokho okuzakuza emva kwakhe; ngubani ongamtshela khona na? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.14",
            "verseOrgIds": [
              "ECC.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukutshikatshika kwesithutha kuyasidinisa ukuze singayazi lendlela eya emzini waso.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.15",
            "verseOrgIds": [
              "ECC.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.15",
            "verseOrgIds": [
              "ECC.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maye kuwe, wena lizwe, onkosi yakho ingumntwana lezikhulu zakho ziba ledili ekuseni! ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.16",
            "verseOrgIds": [
              "ECC.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubusisiwe, wena lizwe, onkosi yakho iyindodana yezikhulu, lezikhulu zakho ziba ledili ngesikhathi esifaneleyo, ukuba zizuze amandla, zingadakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.17",
            "verseOrgIds": [
              "ECC.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ECC 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngobuvila uphahla luyatshona, langokungananzi indlu iyanetha. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.18",
            "verseOrgIds": [
              "ECC.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ECC 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukudla kwenzelwe ukuhleka, lewayini lithokozisa ukusila; ngemali umuntu angazuza konke. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.19",
            "verseOrgIds": [
              "ECC.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ECC 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lasemicabangweni yakho ungayithuki inkosi, lasendlini yakho yokulala ungamthuki onothileyo; ngoba inyoni yaphezulu izathwala ilizwi lakho, lento ephaphayo ibike indaba.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.20",
            "verseOrgIds": [
              "ECC.10.20"
            ]
          }
        }
      ]
    }
  ],
