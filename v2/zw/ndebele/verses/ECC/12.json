        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi khumbula uMenzi wakho ensukwini zobutsha bakho zingakafiki insuku ezimbi, ingakasondeli iminyaka, lapho uzakuthi: Kangithokozi ngayo. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.1",
            "verseOrgIds": [
              "ECC.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkhumbule kungakafiphali ilanga lenyanga lezinkanyezi lamayezi engakabuyi lezulu ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.2",
            "verseOrgIds": [
              "ECC.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "lapho abagcini bendlu bezakuthuthumela, lamadoda alamandla akhokhobe, labacholayo bengasacholi ngoba sebebalutshwana, lalabo abalunguza ngamawindi bafiphale, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.3",
            "verseOrgIds": [
              "ECC.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuvalwe izivalo zomnyango, lapho umsindo wokuchola usuncipha, lokukhala kwentaka sekuncipha, lokuhlabela ingoma sekuphela, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.4",
            "verseOrgIds": [
              "ECC.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "lapho abantu sebesesaba ukukhwela umqanso, sebesesaba lokuhamba, lapho isihlahla sesilempoko ezimhlophe, lentothoviyane isitotoba, lenhliziyo isimnyama. Ngoba umuntu usesiya ekhaya lakhe elingapheliyo, labalilayo sebezulazula endleleni. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.5",
            "verseOrgIds": [
              "ECC.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umkhumbule kungakaqamuki intambo yesiliva, kungakafi isibane segolide, lembiza ingakaphahlazeki emthonjeni, lendirayo ingakephuki emgodini wamanzi, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.6",
            "verseOrgIds": [
              "ECC.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "lothuli lungakabuyeli emhlabathini lapho lwavela khona, lomoya ubuyela kuNkulunkulu owawunikayo. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.7",
            "verseOrgIds": [
              "ECC.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ize leze, kutsho umtshumayeli, konke kulize.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.8",
            "verseOrgIds": [
              "ECC.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.8",
            "verseOrgIds": [
              "ECC.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuhlakanipha umtshumayeli wabafundisa abantu ulwazi, esecabangile wafunda walungisa izaga ezinengi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.9",
            "verseOrgIds": [
              "ECC.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umtshumayeli wazama ukugwala ngendlela ekholisayo, waloba imicabango eliqiniso ngendlela eqondileyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.10",
            "verseOrgIds": [
              "ECC.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amazwi abahlakaniphileyo anjengencijo lanjengezipikili ezibethelwe zatshona; ayalikhokhela ibandla ngoba avela kumalusi munye. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.11",
            "verseOrgIds": [
              "ECC.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nansi esinye isixwayiso, mntanami; ukwenziwa kwezingwalo kakupheli, lokufunda okunengi kuyadinisa. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.12",
            "verseOrgIds": [
              "ECC.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanko ukuphela kwendaba. Usuyizwile yonke. Mesabe uNkulunkulu, ulalele imilayo yakhe; kakukho okwedlula lokho emuntwini. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.13",
            "verseOrgIds": [
              "ECC.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba uNkulunkulu uzakwahlulela konke esikwenzayo layo yonke imfihlo, okuhle lokubi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.14",
            "verseOrgIds": [
              "ECC.12.14"
            ]
          }
        }
      ]
    }
  ],
