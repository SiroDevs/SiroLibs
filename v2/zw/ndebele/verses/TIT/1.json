            "sid": "TIT 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mina Pawuli, inceku kaNkulunkulu lomphostoli kaJesu Kristu wokwakha ukukholwa kwabakhethiweyo bakaNkulunkulu lowokwandisa ukwazi iqiniso elimayelana lokukhonza uNkulunkulu, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.1",
            "verseOrgIds": [
              "TIT.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "TIT 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngilethemba lokuphila okungapheliyo, uNkulunkulu ongaqambi manga akuthembisa ekuqaleni kwesikhathi. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.2",
            "verseOrgIds": [
              "TIT.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "TIT 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngesikhathi esifaneleyo wabonakalisa ilizwi lakhe ngentshumayelo engayiphathiswa ngokulaya kukaNkulunkulu uMsilisi wethu. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.3",
            "verseOrgIds": [
              "TIT.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "TIT 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngithi kuTitosi umntanami impela ngokukholwa esikuhlanganyele sonke: Kakube kuwe umusa lokuthula okuvela kuNkulunkulu uBaba lakuKristu Jesu uMsilisi wethu.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.4",
            "verseOrgIds": [
              "TIT.1.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
