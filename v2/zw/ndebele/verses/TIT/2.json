        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.14",
            "verseOrgIds": [
              "TIT.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "TIT 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tshumayela lezizinto, ulaye, ukhuze ngamandla wonke. Ungadelelwa muntu.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.15",
