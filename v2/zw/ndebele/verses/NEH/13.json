          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaphikisana labo, ngabaqalekisa, ngatshaya abanye babo, ngangcothula inwele zabo; ngabafungisa ngebizo likaNkulunkulu ukuba bathi: Kasisayikwendisela amadodakazi ethu amadodana abo, loba sithathele amadodana ethu amadodakazi abo, ingabe sizithathele thina. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.25",
            "verseOrgIds": [
              "NEH.13.25"
            ]
          }
        },
        {
          "name": "verse",
