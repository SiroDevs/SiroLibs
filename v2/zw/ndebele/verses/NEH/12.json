        },
        {
          "text": "Ngoba ensukwini zikaDavida uAsafi wabekwa waba yinduna yabahlabeleli bokudumisa lokubonga uNkulunkulu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.46",
