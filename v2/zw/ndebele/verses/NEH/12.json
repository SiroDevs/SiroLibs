            "sid": "NEH 12:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "labapristi abathile bephethe impondo zokukhaliswa, bengoZekariya indodana kaJonathani kaShemaya kaMathaniya kaMikaya kaZakuri kaAsafi, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.35",
            "verseOrgIds": [
              "NEH.12.35"
            ]
          }
        },
        {
