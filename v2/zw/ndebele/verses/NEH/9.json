              "NEH.9.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NEH 9:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngenxa yakho konke lokhu senza isivumelwano esiqinileyo, siyasigcwalisa, izikhulu zethu lamaLevi ethu labapristi bafake uphawu lwabo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.38",
            "verseOrgIds": [
              "NEH.9.38"
            ]
          }
