            "number": "29",
            "style": "v",
            "sid": "NEH 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "bazihlanganisa labakibo, izikhulu zabo, bazibopha ngesifungo sokuhamba ngomlayo kaNkulunkulu owanikwa ngoMose inceku kaNkulunkulu, lokuyigcina bayenze yonke imilayezelo yeNkosi yethu lemithetho yayo lezimiso zayo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.29",
            "verseOrgIds": [
              "NEH.10.29"
            ]
          }
        },
        {
          "name": "verse",
