          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasiyikwendisela abantu balelilizwe amadodakazi ethu loba sithathele amadodana ethu amadodakazi abo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.30",
