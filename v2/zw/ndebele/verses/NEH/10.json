          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siyazimisela ukuletha izithelo zokuqala zomhlaba wethu lezithelo zokuqala zezihlahla zonke ethempelini iminyaka ngeminyaka;",
          "type": "text",
