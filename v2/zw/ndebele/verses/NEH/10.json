          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "leyesinkwa esahlukaniselwe uNkulunkulu, leyomnikelo wempuphu wensuku zonke, leyomnikelo wokutshiswa wensuku zonke, leyamaSabatha, leyokuthwasa kwenyanga, leyemikhosi emisiweyo, leyeziphiwo ezingcwele, leyeminikelo yesono ukwenzela uIsrayeli ukubuyisana, leyawo wonke umsebenzi wendlu kaNkulunkulu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.33",
            "verseOrgIds": [
              "NEH.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NEH 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thina abapristi lamaLevi labantu senzile inkatho mayelana lenkuni zeminikelo ukuba zilethwe endlini kaNkulunkulu wethu yizindlu zonke ngokuzophisana, ngezikhathi ezimisiweyo iminyaka ngeminyaka, zibaswe phezu kwealtare likaNkulunkulu wethu njengokulotshiweyo emlayweni. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.34",
            "verseOrgIds": [
              "NEH.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
