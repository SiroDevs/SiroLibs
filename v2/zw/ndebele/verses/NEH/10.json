        },
        {
          "text": "Abantu abaseleyo abangabapristi lamaLevi labalindi bamasango labahlabeleli lezinceku zasethempelini labo bonke abazahlukanisayo ebantwini bezizwe ukuba bagcine umlayo kaNkulunkulu, labomkabo lamadodana abo lamadodakazi abo, labo bonke abantwana abaqedisisayo, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.28",
            "verseOrgIds": [
              "NEH.10.28"
            ]
          }
        },
        {
          "name": "verse",
