              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mina omdala, ngithi kuye uGeyu othandekayo, engimthanda ngeqiniso:",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.1",
            "verseOrgIds": [
              "3JN.1.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
