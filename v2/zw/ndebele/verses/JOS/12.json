              "type": "text"
            }
          ]
        },
        {
          "text": "La ngamakhosi elizwe anqotshwa nguJoshuwa labakoIsrayeli ngasentshonalanga kweJordani, kusukela eBali‐Gadi esihotsheni saseLebanoni kusiya entabeni elugwadule kusiya eSeyiri. UJoshuwa walabela abakoIsrayeli ilizwe lawo, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.7",
            "verseOrgIds": [
              "JOS.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ezintabeni, eShefela, eAraba, emaqaqeni, enkangala, eNegebi, ilizwe lamaHethi lamaAmori lamaKanani lamaPerizi lamaHivi lamaJebusi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.8",
            "verseOrgIds": [
              "JOS.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi yaseJeriko, leyaseAyi eliphansi kweBetheli, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.9",
            "verseOrgIds": [
              "JOS.12.9"
