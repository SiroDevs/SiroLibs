          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkatho yesithupha yadla isizwe sakoNafitali ngosendo lwaso. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.32",
            "verseOrgIds": [
              "JOS.19.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umngcele waso wasuka eHelefi, esihlahleni esikhulu saseZananimi leAdami‐Nekebi leJabineli, waze wayafika eLakumi, waphelela eJordani; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.33",
            "verseOrgIds": [
              "JOS.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOS 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "wasuphenduka uqonda entshonalanga usiya eAzinothi‐Tabori, wadlula lapho waya eHukoki, wagudla iZebuluni ngaseningizimu, leAsheri ngasentshonalanga, leJordani ngasempumalanga. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.34",
            "verseOrgIds": [
              "JOS.19.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOS 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imizi ebiyelweyo yayiyile; iZidimi leZeri leHamathi leRakathi leKinerethi ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.35",
            "verseOrgIds": [
              "JOS.19.35"
            ]
          }
        },
