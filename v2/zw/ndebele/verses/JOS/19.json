          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leli yilizwe lesizwe sakoNafitali ngosendo lwaso, imizi lemizana yayo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.39",
            "verseOrgIds": [
