          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waloba ematsheni phambi kwabakoIsrayeli amazwi omlayo uMose ayewalobile. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.32",
            "verseOrgIds": [
              "JOS.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bonke abakoIsrayeli, abadala lezinduna labahluleli, bema ngapha langapha ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.33",
            "verseOrgIds": [
              "JOS.8.33"
            ]
          }
        },
        {
          "text": ", bekhangelene labapristi abangamaLevi abathwala umtshokotsho wesivumelwano seNkosi, bonke abakoIsrayeli abokuzalwa labezizweni. Ingxenye yabo yema ikhangelene lentaba yaseGerizimi lengxenye ikhangelene lentaba yaseEbali, njengokulaya kokuqala kukaMose inceku yeNkosi ukuba kubusiswe abakoIsrayeli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.33",
            "verseOrgIds": [
              "JOS.8.33"
            ]
          }
