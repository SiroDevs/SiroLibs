              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emva kwalokho wasewafunda wonke amazwi omlayo, awokubusisa lawokuqalekisa, njengakho konke okulotshiweyo ogwalweni lomlayo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.34",
