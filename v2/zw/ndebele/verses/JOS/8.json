              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ialtare lalingelamatshe angabazwanga ngento yensimbi njengomlayo kaMose inceku yeNkosi kwabakoIsrayeli osogwalweni lomlayo kaMose. Banikela eNkosini iminikelo yokutshiswa lemihlatshelo yokuthula.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.31",
            "verseOrgIds": [
              "JOS.8.31"
            ]
          }
        },
        {
          "name": "note",
