                "loc": "NUM.27.1+NUM.27.2+NUM.27.3+NUM.27.4+NUM.27.5+NUM.27.6+NUM.27.7"
              },
              "items": [
                {
                  "text": "Nani 27:1–7",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.4",
            "verseOrgIds": [
              "JOS.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho abakoManase basebezuza izabelo ezilitshumi ngaphandle kwelizwe leGileyadi leBashani, elingaphetsheya kweJordani, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.5",
            "verseOrgIds": [
              "JOS.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngoba amadodakazi kaManase ayenikwe ilizwe kanye lamadodana akhe. Ilizwe laseGileyadi lanikwa abanye abakoManase. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.6",
            "verseOrgIds": [
              "JOS.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umngcele wabakoManase wasukela eAsheri, waya eMikimethathi ngasempumalanga kweShekema, wasuqonda eningizimu ngaseEni‐Tapuwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.7",
            "verseOrgIds": [
              "JOS.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilizwe laseTapuwa lalingelakoManase, kodwa umuzi waseTapuwa owawusemngceleni wakoManase wawungowabakoEfrayimi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.8",
            "verseOrgIds": [
              "JOS.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umngcele wasusehlela esifuleni iKana. Imizi yalapho engaseningizimu kwesifula phakathi kwemizi yakoManase ngeyakoEfrayimi. Umngcele wakoManase udlula ngasenyakatho kwesifula, uphelele olwandle. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.9",
            "verseOrgIds": [
              "JOS.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilizwe laseningizimu ngelakoEfrayimi, elasenyakatho ngelakoManase, ulwandle lungumngcele wawo. Bafinyelela kwelakoAsheri ngasenyakatho, lakwelakoIsakari ngasempumalanga. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.10",
            "verseOrgIds": [
              "JOS.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi koIsakari lakoAsheri uManase wabelwa iBeti‐Sheyani lemizana yalo, leIbileyamu lemizana yalo, labaseDori lemizana yalo, labaseEni‐Dori lemizana yalo, labaseTanaki lemizana yalo, labaseMegido lemizana yalo — owesithathu uyisigaba saseDori — ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.11",
            "verseOrgIds": [
              "JOS.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa abakoManase bahluleka ukuthatha leyomizi, ngakho amaKanani ahlala njalo kulelolizwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.12",
            "verseOrgIds": [
              "JOS.17.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.1.27+JDG.1.28"
              },
              "items": [
                {
                  "text": "Hlu 1:27–28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.12",
            "verseOrgIds": [
              "JOS.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa lapho abakoIsrayeli sebelamandla bawasebenzisa nzima amaKanani, kabawaxotshanga aphela nya.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.13",
            "verseOrgIds": [
              "JOS.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.13",
            "verseOrgIds": [
              "JOS.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbakoJosefa bakhuluma loJoshuwa bathi: Usinikeleni isabelo saba sinye nje ukuba sibe yilifa lethu lokhu siyisizwe esikhulu, leNkosi isibusisile kuze kube lamuhla na? ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.14",
            "verseOrgIds": [
              "JOS.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJoshuwa wathi kubo: Uba liyisizwe esikhulu, yanini eguswini, lizicentele khona indawo elizweni lamaPerizi lamaRefa, lokhu izintaba zakoEfrayimi ziminyene. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.15",
            "verseOrgIds": [
              "JOS.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbakoJosefa bathi: Izintaba kazisanelanga, kanti amaKanani ahlala emagcekeni alezinqola zokulwa zensimbi, wonke aseBeti‐Sheyani kanye lemizi yalo lawesigodini seJezereli. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.16",
            "verseOrgIds": [
              "JOS.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJoshuwa wasesithi kwabakoJosefa abangabakoEfrayimi labakoManase: Lina liyisizwe esikhulu, futhi lilamandla amakhulu; kaliyikuphiwa isabelo sibe sinye, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.17",
            "verseOrgIds": [
              "JOS.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kodwa lezintaba zizakuba ngezenu; lanxa zingamagusu lizakuzicenta zibe ngezenu kuze kube semikhawulweni yazo, liwaxotshe amaKanani lanxa elenqola zokulwa zensimbi, lanxa elamandla.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.18",
            "verseOrgIds": [
              "JOS.17.18"
            ]
          }
        }
      ]
    }
  ],
