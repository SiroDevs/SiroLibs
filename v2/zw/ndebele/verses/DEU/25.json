          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.16",
            "verseOrgIds": [
              "DEU.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khumbulani lokho uAmaleki akwenza kini endleleni ekuphumeni kwenu eGibithe,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.17",
            "verseOrgIds": [
              "DEU.25.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
