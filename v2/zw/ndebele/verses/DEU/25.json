          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungayifaki isayeke inkabi nxa ibhula amabele.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.4",
            "verseOrgIds": [
              "DEU.25.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
