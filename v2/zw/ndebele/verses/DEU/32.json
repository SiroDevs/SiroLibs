              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yathi kuMose ngalona lolosuku:",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.48",
            "verseOrgIds": [
              "DEU.32.48"
            ]
