              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uba umuntu ehlangana lentombi ekhombileyo egangeni, ayibambe, alale layo, kakubulawe lowomuntu kuphela olele layo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.25",
            "verseOrgIds": [
