          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba indoda ifunyanwa ilele lomfazi wenye indoda, bobabili bazabulawa, indoda ebilele lomfazi kanye lomfazi. Ngalokhu lizaqeda ububi koIsrayeli.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.22",
            "verseOrgIds": [
              "DEU.22.22"
            ]
          }
        }
