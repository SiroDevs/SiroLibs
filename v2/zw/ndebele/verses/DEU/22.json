          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "lizakubakhuphela ngasesangweni lalowomuzi bobabili, libakhande ngamatshe libabulale; likhande ngamatshe intombi ngoba ingahlabanga umkhosi lanxa ibiphakathi komuzi, lendoda ngoba imonile umkamakhelwana wakhe. Ngalokhu lizaqeda ububi phakathi kwenu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.24",
            "verseOrgIds": [
              "DEU.22.24"
            ]
          }
        }
