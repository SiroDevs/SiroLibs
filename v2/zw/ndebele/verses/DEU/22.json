              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uba umuntu ehlangana lentombi ekhombileyo phakathi komuzi, alale layo, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.23",
            "verseOrgIds": [
              "DEU.22.23"
            ]
          }
