          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngoba ehlangene layo egangeni. Lanxa intombi ekhombileyo ibihlabe umkhosi, bekungelamuntu wokuyilamulela.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.27",
            "verseOrgIds": [
              "DEU.22.27"
            ]
          }
        }
