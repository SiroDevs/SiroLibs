          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa lingenzi lutho entombini, ngoba kayilacala elifanele ukufa; lindaba ifanana leyomuntu ovukela umakhelwana wakhe ambulale; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.26",
            "verseOrgIds": [
              "DEU.22.26"
            ]
          }
        },
