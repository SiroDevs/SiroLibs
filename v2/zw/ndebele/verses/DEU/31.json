              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose eseqedile ukuloba amazwi alumlayo ogwalweni, kusukela ekuqaleni kwaze kwaba sekucineni, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.24",
            "verseOrgIds": [
              "DEU.31.24"
            ]
          }
        },
        {
          "name": "verse",
