              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "walaya amaLevi ayethwala umtshokotsho ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.25",
            "verseOrgIds": [
              "DEU.31.25"
            ]
          }
        },
        {
          "text": " seNkosi wathi: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.25",
            "verseOrgIds": [
              "DEU.31.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 31:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thathani lolugwalo lomlayo, lilubeke ngaseceleni komtshokotsho wesivumelwano seNkosi uNkulunkulu wenu, ukuba luhlale khona, lube yibufakazi ngabantu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.26",
            "verseOrgIds": [
              "DEU.31.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 31:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba ngiyazi ukuthi lingabaxhwalayo, lenhliziyo zenu zilukhuni; lanxa ngisekhona beliyihlamuka iNkosi; pho, lizahlamuka kangakanani lapho sengifile na? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.27",
            "verseOrgIds": [
              "DEU.31.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 31:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buthanisani kimi bonke abalisa bezizwe zenu lezinduna zenu ukuba ngikhulume amazwi la kibo, ngibize izulu lomhlaba ukufakaza ngabo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.28",
            "verseOrgIds": [
              "DEU.31.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 31:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba ngiyazi ukuthi emva kokufa kwami lizakona, liphambuke endleleni engililaye yona; lizakwehlelwa ngokubi ngensuku ezizayo, ngoba lizakwenza okubi emehlweni eNkosi, liyithukuthelise ngomsebenzi wezandla zenu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.29",
            "verseOrgIds": [
              "DEU.31.29"
            ]
          }
        }
      ]
