              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angithi zona ziphetsheya kweJordani ngasentshonalanga kwendlela, elizweni lamaKanani ahlala eAraba, maqondana leGiligali, eduze lezihlahla ezinkulu zaseMore na? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.30",
            "verseOrgIds": [
              "DEU.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
