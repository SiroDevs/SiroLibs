          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuzakuthi lapho iNkosi uNkulunkulu wenu ilingenisa elizweni eliya ukulithumba, limemezele isibusiso entabeni yaseGerizimi, lesiqalekiso entabeni yaseEbali.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.29",
            "verseOrgIds": [
