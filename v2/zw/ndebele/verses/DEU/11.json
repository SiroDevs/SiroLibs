          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba selizakuchapha iJordani ukuba lingene lithumbe ilizwe iNkosi uNkulunkulu wenu elinika lina. Lizakulithumba, lihlale kilo, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.31",
            "verseOrgIds": [
              "DEU.11.31"
            ]
          }
        },
