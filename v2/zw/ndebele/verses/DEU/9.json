          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Layithukuthelisa futhi iNkosi eTabera, laseMasa, laseKiribothi‐Hathava.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.22",
