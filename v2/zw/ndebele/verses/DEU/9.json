              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaziwisela phansi phambi kweNkosi kulezonsuku ezingamatshumi amane lobusuku obungamatshumi amane, ngoba iNkosi yathi izakulichitha. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.25",
            "verseOrgIds": [
              "DEU.9.25"
            ]
          }
        },
        {
          "name": "verse",
