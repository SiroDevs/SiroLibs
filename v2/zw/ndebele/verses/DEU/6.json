                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.10",
            "verseOrgIds": [
              "DEU.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "lezindlu ezigcwele zonke izinto ezinhle ongazigcwalisanga, lemithombo ongayimbanga, lezivini lezihlahla ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.11",
            "verseOrgIds": [
              "DEU.6.11"
            ]
          }
        },
        {
          "text": " ongazihlanyelanga, ongadla kuzo usuthe, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.11",
            "verseOrgIds": [
              "DEU.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "qaphela, ukuba ungayikhohlwa iNkosi eyakukhupha eGibithe, endaweni yobugqili. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.12",
            "verseOrgIds": [
              "DEU.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzakuyesaba iNkosi uNkulunkulu wakho, uyikhonze, ufunge ngebizo layo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.13",
            "verseOrgIds": [
              "DEU.6.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
