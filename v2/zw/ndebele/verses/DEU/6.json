              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.4.8"
              },
              "items": [
                {
                  "text": "Luka 4:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.13",
            "verseOrgIds": [
              "DEU.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungalandeli abanye onkulunkulu, onkulunkulu babantu abakhe eduze lawe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.14",
            "verseOrgIds": [
              "DEU.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba iNkosi uNkulunkulu wakho ophakathi kwakho inguNkulunkulu olomona. Qaphela, funa iNkosi uNkulunkulu wakho ikuthukuthelele, ikuchithe emhlabeni. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.15",
            "verseOrgIds": [
              "DEU.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungayilingi iNkosi uNkulunkulu wakho njengalokhu wayilinga eMasa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.16",
            "verseOrgIds": [
              "DEU.6.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
