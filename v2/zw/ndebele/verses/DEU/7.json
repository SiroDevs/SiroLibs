          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.11",
            "verseOrgIds": [
              "DEU.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuzakuthi uba lilalela lezizimiso, lizigcine, lizenze, iNkosi uNkulunkulu izagcina isivumelwano eyasifunga kubokhokho benu, ibe lothando olungapheliyo kini.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.12",
            "verseOrgIds": [
              "DEU.7.12"
            ]
          }
        },
        {
