        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ophindisela labo abamzondayo, ababhubhise. Kayikuphuza ukumphindisela omzondayo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.10",
            "verseOrgIds": [
              "DEU.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho lizakugcina imilayo lezimiso lezahlulelo engililaya zona lamuhla.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.11",
            "verseOrgIds": [
              "DEU.7.11"
            ]
          }
        }
      ]
    },
    {
