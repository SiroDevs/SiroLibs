              "attrs": {
                "loc": "DEU.11.1+DEU.11.2+DEU.11.3+DEU.11.4+DEU.11.5+DEU.11.6+DEU.11.7+DEU.11.8+DEU.11.9+DEU.11.10+DEU.11.11+DEU.11.12+DEU.11.13+DEU.11.14+DEU.11.15+DEU.11.16+DEU.11.17"
              },
              "items": [
