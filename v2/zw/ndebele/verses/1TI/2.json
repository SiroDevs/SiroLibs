    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TI 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhoke kuqala kukho konke ngilaya ukuba ukunxusa lokukhuleka lokucela lokubonga kwenzelwe abantu bonke, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.1",
            "verseOrgIds": [
              "1TI.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "amakhosi lazo zonke izikhulu, ukuze sihlale kuhle langokuthula, sikhonze uNkulunkulu sibe lokuhlonipha konke. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.2",
            "verseOrgIds": [
              "1TI.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TI 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lokhu kuhle, kuyabongeka phambi kukaNkulunkulu uMsilisi wethu ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.3",
            "verseOrgIds": [
              "1TI.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TI 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "othanda ukuba bonke abantu basiliswe, bafinyelele ekwazini iqiniso. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.4",
            "verseOrgIds": [
              "1TI.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TI 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba munye uNkulunkulu; munye umlamuli phakathi kukaNkulunkulu labantu, umuntu uKristu Jesu, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.5",
            "verseOrgIds": [
              "1TI.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TI 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "owazinikela yena abe yinhlawulo yabo bonke; lokhu kwafakazelwa ngesikhathi esifaneleyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.6",
            "verseOrgIds": [
              "1TI.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TI 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngamiselwa khona mina ukuba ngibe ngumtshumayeli lomphostoli; ngikhuluma iqiniso, kangiqambi manga; yebo, ngibe ngumfundisi wabezizwe ekukholweni laseqinisweni.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.7",
            "verseOrgIds": [
              "1TI.2.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.1.11"
              },
              "items": [
                {
                  "text": "2 Tim 1:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.7",
            "verseOrgIds": [
              "1TI.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TI 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho ngithanda ukuba amadoda akhuleke endaweni zonke, ephakamisa izandla ezingcwele, engalalaka lokuxabana. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.8",
            "verseOrgIds": [
              "1TI.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TI 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokunjalo labesifazana bagqoke izigqoko ezifaneleyo, bacece ngokuhlonipha langokuqonda, kungabi ngenwele ezelukiweyo, langegolide, langamangqongqo aligugu, langezambatho ezibiza imali enengi;",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.9",
            "verseOrgIds": [
              "1TI.2.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.3.3"
              },
              "items": [
                {
                  "text": "1 Pet 3:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.9",
            "verseOrgIds": [
              "1TI.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TI 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kodwa kabacece ngemisebenzi emihle, okufanele abesifazana abathi bakhonza uNkulunkulu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.10",
            "verseOrgIds": [
              "1TI.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TI 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owesifazana kafunde ngokuthula langokuzithoba konke. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.11",
            "verseOrgIds": [
              "1TI.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TI 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kangivumeli owesifazana ukuba afundise lokuba abe lamandla phezu kwabesilisa; kodwa kathule. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.12",
            "verseOrgIds": [
              "1TI.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TI 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba uAdamu wabunjwa kuqala, emva kwalokho kwabunjwa uEva.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.13",
            "verseOrgIds": [
              "1TI.2.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.2.7"
              },
              "items": [
                {
                  "text": "Gen 2:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.2.21+GEN.2.22"
              },
              "items": [
                {
                  "text": "21–22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.13",
            "verseOrgIds": [
              "1TI.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TI 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi uAdamu kakhohliswanga, kanti owesifazana wakhohliswa, waphambuka.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.14",
            "verseOrgIds": [
              "1TI.2.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.3.1+GEN.3.2+GEN.3.3+GEN.3.4+GEN.3.5+GEN.3.6"
              },
              "items": [
                {
                  "text": "Gen 3:1–6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.14",
            "verseOrgIds": [
              "1TI.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TI 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa owesifazana uzakusiliswa ngokuzala abantwana, uba ehlala ekukholweni lasothandweni lasebungcweleni langokuqonda.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.15",
            "verseOrgIds": [
              "1TI.2.15"
            ]
          }
        }
