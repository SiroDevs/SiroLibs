      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TH 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Liyazi lani, bazalwane, ukuthi ukufika kwethu kini kakubanga yize. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.1",
            "verseOrgIds": [
              "1TH.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TH 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa lanxa sasihluphekile kuqala saphathwa kubi eFiliphi, njengoba lisazi lani, saba lesibindi kuNkulunkulu sokulitshumayeza ivangeli likaNkulunkulu phakathi kobunzima obukhulu.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.2",
            "verseOrgIds": [
              "1TH.2.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.16.19+ACT.16.20+ACT.16.21+ACT.16.22+ACT.16.23+ACT.16.24"
              },
              "items": [
                {
                  "text": "Seb 16:19–24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.17.1+ACT.17.2+ACT.17.3+ACT.17.4+ACT.17.5+ACT.17.6+ACT.17.7+ACT.17.8+ACT.17.9"
              },
              "items": [
                {
                  "text": "17:1–9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.2",
            "verseOrgIds": [
              "1TH.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TH 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilizwi lethu kayisilo elokuduha lelokungcola lelobuqili, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.3",
            "verseOrgIds": [
              "1TH.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TH 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kodwa njengoba sivunyiwe nguNkulunkulu ukuba siphathiswe ivangeli, siyakhulumake, singenzeli ukuthokozisa abantu kodwa ukuthokozisa uNkulunkulu ohlolayo inhliziyo zethu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.4",
            "verseOrgIds": [
              "1TH.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TH 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasizanga sisebenzise amazwi okulalisa ngolimi, njengoba lani lisazi; kasizanga futhi siwasebenzise ukufihla ubuhwaba ngawo, njengoba uNkulunkulu engufakazi. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.5",
            "verseOrgIds": [
              "1TH.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TH 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasifunanga udumo ebantwini, oluvela kini ingabe kwabanye, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.6",
            "verseOrgIds": [
              "1TH.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TH 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "loba sasingaba lamandla okulufuna njengoba singabaphostoli bakaKristu. Kodwa saba mnene phakathi kwenu njengomdlezane esondla abantwana bakhe. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.7",
            "verseOrgIds": [
              "1TH.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TH 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njengoba besilithanda kangaka, safisa ukulinika kungesilo ivangeli likaNkulunkulu kuphela, kodwa lokusila kwethu uqobo, ngoba laselingabathandekayo kithi. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.8",
            "verseOrgIds": [
              "1TH.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TH 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Liyakhumbula, bazalwane, ukusebenza lokutshikatshikeka kwethu, sisebenza ubusuku lemini, ukuze singabi ngumthwalo lakoyedwa wenu, lapho silitshumayeza ivangeli likaNkulunkulu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.9",
            "verseOrgIds": [
              "1TH.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TH 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lina lingofakazi kanye loNkulunkulu, bokuthi sahlala kanjani phakathi kwenu lina elikholwayo ukuthi ukuhlala kwethu kwakungobungcwele, langokulunga, langokungasoleki, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.10",
            "verseOrgIds": [
              "1TH.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TH 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "njengokuba lisazi ukuthi saliphatha ngamunye njengoyise ephatha abantwana bakhe; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.11",
            "verseOrgIds": [
              "1TH.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "sililaya, silimisa isibindi, silitshela ukuba lihambe ngokufaneleyo phambi kukaNkulunkulu olibizela embusweni lebukhosini bakhe.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.12",
            "verseOrgIds": [
              "1TH.2.12"
            ]
          }
        }
      ]
    },
    {
