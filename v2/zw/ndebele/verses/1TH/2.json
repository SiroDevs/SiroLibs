              "items": [
                {
                  "text": "Seb 17:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.14",
            "verseOrgIds": [
              "1TH.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TH 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ababulala leNkosi uJesu labaprofethi, basixotsha lathi. Kabamthokozisi uNkulunkulu, bamelana labantu bonke,",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.15",
            "verseOrgIds": [
              "1TH.2.15"
            ]
          }
        },
