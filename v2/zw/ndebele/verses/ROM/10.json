  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "ROM 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazalwane, ukufisa kwenhliziyo yami lokukhuleka kwami kuNkulunkulu ngabakithi kuyikuba basiliswe. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.1",
            "verseOrgIds": [
              "ROM.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyabafakazela ukuthi batshisekela uNkulunkulu, kodwa ukutshiseka kwabo kakulakwazi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.2",
            "verseOrgIds": [
              "ROM.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba kabakwazi ukulunga okuvela kuNkulunkulu, kodwa bafuna ukumisa okwabo; kabazehliseli ngaphansi kokulunga kukaNkulunkulu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.3",
            "verseOrgIds": [
              "ROM.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba uKristu uyawuqeda umlayo, alethele bonke abakholwayo ukulunga.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.4",
            "verseOrgIds": [
              "ROM.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.4",
            "verseOrgIds": [
              "ROM.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose uloba ukuthi lowo owenza ukulunga okungomlayo uzakuphila ngakho.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.5",
            "verseOrgIds": [
              "ROM.10.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.5"
              },
              "items": [
                {
                  "text": "Levi 18:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.5",
            "verseOrgIds": [
              "ROM.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa ukulunga okungokukholwa kuthi: Ungatsho enhliziyweni yakho ukuthi: Ngubani ozakwenyukela ezulwini? — okuyikuthi ukumehlisa uKristu — ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.6",
            "verseOrgIds": [
              "ROM.10.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.30.12+DEU.30.13+DEU.30.14"
              },
              "items": [
                {
                  "text": "Dute 30:12–14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.6",
            "verseOrgIds": [
              "ROM.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "lokuthi: Ngubani ozakwehlela emgodini ongelamkhawulo? — okuyikuthi ukumkhuphula uKristu kwabafileyo — ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.7",
            "verseOrgIds": [
              "ROM.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa kuthini na? Kuthi: Ilizwi liseduze lawe, lisemlonyeni lasenhliziyweni yakho; okutsho ilizwi lokukholwa esilitshumayelayo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.8",
            "verseOrgIds": [
              "ROM.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba uba uvuma ngomlomo wakho ukuthi uJesu uyiNkosi, ukholwa enhliziyweni yakho ukuthi uNkulunkulu wamvusa kwabafileyo, uzasiliswa. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.9",
            "verseOrgIds": [
              "ROM.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba ukukholwa okusenhliziyweni kuletha ukulunga; lokuvuma ngomlomo kuletha ukusiliswa. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.10",
            "verseOrgIds": [
              "ROM.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umbhalo uthi: Lowo okholwa kuye kayikuyangeka.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.11",
            "verseOrgIds": [
              "ROM.10.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.28.16"
              },
              "items": [
                {
                  "text": "Isa 28:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.11",
            "verseOrgIds": [
              "ROM.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho kakukho ukwahlukana phakathi komJuda lomGriki, ngoba iNkosi yona yiNkosi yabo bonke, inothele bonke abakhuleka kuyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.12",
            "verseOrgIds": [
              "ROM.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba kuthiwa: Bonke abazakukhuleka ebizweni leNkosi bazakusiliswa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.13",
            "verseOrgIds": [
              "ROM.10.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.32"
              },
              "items": [
                {
                  "text": "Jow 2:32",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.13",
            "verseOrgIds": [
              "ROM.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa bazakukhuleka kuyo kanjani abangakholwanga kuyo na? Futhi, bazakukholwa kuyo kanjani abangezwanga ngayo na? Futhi, bazakuzwa kanjani bengelamtshumayeli na? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.14",
            "verseOrgIds": [
              "ROM.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazakutshumayela kanjani uba bengathunywa na? Njengokulotshiweyo ukuthi: Yeka ubuhle bezinyawo zabo abatshumayela izindaba ezinhle!",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.15",
            "verseOrgIds": [
              "ROM.10.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.52.7"
              },
              "items": [
                {
                  "text": "Isa 52:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.15",
            "verseOrgIds": [
              "ROM.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa kabalilalelanga bonke ivangeli; ngoba uIsaya uthi: Nkosi, ngubani owakholwa ilizwi lethu na?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.16",
            "verseOrgIds": [
              "ROM.10.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.53.1"
              },
              "items": [
                {
                  "text": "Isa 53:1",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    }
