            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.18"
              },
              "items": [
                {
                  "text": "Levi 19:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.9",
            "verseOrgIds": [
              "ROM.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uthando kalwenzi okubi kumakhelwana; ngakho uthando luyikugcwaliseka komlayo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.10",
            "verseOrgIds": [
              "ROM.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.10",
            "verseOrgIds": [
              "ROM.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Langaphandle kwalokhu yazini ukuthi lesisikhathi sinjani; yisikhathi sokuba livuke ebuthongweni. Ngoba ukusiliswa kwethu sekusondele kithi khathesi kulalesosikhathi esaqala ukukholwa ngaso. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.11",
            "verseOrgIds": [
              "ROM.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubusuku sebudlulile, sekuzakusa. Ngakhoke asilahle imisebenzi yomnyama, sihlome izikhali zokukhanya. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.12",
            "verseOrgIds": [
              "ROM.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asihambe ngokufaneleyo njengasemini, singahambi ngokuminza langokudakwa, langokufeba, langokungabi lanhloni, langokuxabana, langomona. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.13",
            "verseOrgIds": [
              "ROM.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa yambathani iNkosi uJesu Kristu; lingananzeleli ngokusuthisa inkanuko zomzimba.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.14",
            "verseOrgIds": [
              "ROM.13.14"
            ]
          }
        }
      ]
    }
