          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalokhoke yabathumela inkosi yamaKaladiya eyabulala amajaha abo lasendlini yabo engcwele, ingahawukeli amajaha lezintombi, abadala lamaxhegu; iNkosi uNkulunkulu yabanikela bonke esandleni sayo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.17",
            "verseOrgIds": [
              "2CH.36.17"
            ]
          }
        },
