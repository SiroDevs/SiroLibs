              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.19",
            "verseOrgIds": [
              "2CH.36.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 36:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yathumbela eBabiloni bonke labo ababesile ekubulaweni empini, baba zinceku zayo lezabantwana bayo kwaze kwaba yisikhathi sombuso wamaPerisiya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.20",
            "verseOrgIds": [
              "2CH.36.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lagcwaliseka ngokunjalo ilizwi leNkosi eyalikhuluma ngoJeremiya isithi: Kuze kube yisikhathi lelilizwe lizakuzuza ukuphumula kwalo kweSabatha, kuze kwedlule iminyaka engamatshumi ayisikhombisa, lizagcina iSabatha insuku zalo zonke zokuchitheka kwalo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.21",
            "verseOrgIds": [
              "2CH.36.21"
            ]
          }
        },
