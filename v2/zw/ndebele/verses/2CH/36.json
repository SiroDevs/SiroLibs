          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNebukadineza wathatha ingxenye yezitsha zethempeli, wazisa eBabiloni, wazifaka esigodlweni sakhe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.7",
            "verseOrgIds": [
              "2CH.36.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezinye indaba zikaJehoyakimi, lamanyala wonke awenzayo, lamacala akhe, kulotshiwe ogwalweni lwamakhosi akoIsrayeli lawakoJuda. UJehoyakini indodana yakhe waba yinkosi esikhundleni sakhe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.8",
            "verseOrgIds": [
              "2CH.36.8"
            ]
          }
        }
