            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu belizwe bathatha uJehowahazi indodana kaJosiya, bambeka inkosi esikhundleni sikayise eJerusalema. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.1",
            "verseOrgIds": [
              "2CH.36.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehowahazi wayeleminyaka engamatshumi amabili lantathu lapho eqalisa ukubusa; wabusa inyanga ezintathu eJerusalema. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.2",
            "verseOrgIds": [
              "2CH.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi yaseGibithe yamsusa esikhundleni eJerusalema, yathelisa ilizwe umthelo ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.3",
            "verseOrgIds": [
              "2CH.36.3"
            ]
          }
        },
        {
          "text": " esiliva alikhulu ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.3",
            "verseOrgIds": [
              "2CH.36.3"
            ]
          }
        },
        {
          "text": " elilodwa legolide. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.3",
            "verseOrgIds": [
              "2CH.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yabeka uEliyakimi umfowabo ukuba abe yinkosi koJuda laseJerusalema, yaliphendula ibizo lakhe yathi nguJehoyakimi; yamthatha umfowabo uJehowahazi yamusa eGibithe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.4",
            "verseOrgIds": [
              "2CH.36.4"
            ]
          }
        },
        {
