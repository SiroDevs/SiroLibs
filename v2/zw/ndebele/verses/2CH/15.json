  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "2CH 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umoya kaNkulunkulu wehlela phezu kukaAzariya indodana kaOdedi; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.1",
            "verseOrgIds": [
              "2CH.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "waphuma ukuhlangabezana loAsa, wathi kuye: Lalela, Asa, lani lonke abakoJuda labakoBenjamini; iNkosi uNkulunkulu ilani nxa lani liselayo. Uba liyidinga, izalivumela ukuba liyifumane; kodwa uba liyilahla, layo izalilahla. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.2",
            "verseOrgIds": [
              "2CH.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isikhathi eside abakoIsrayeli babengelaye uNkulunkulu weqiniso, bengelaye umpristi wokubafundisa, bengelawo umlayo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.3",
            "verseOrgIds": [
              "2CH.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa kwathi osizini lwabo baphendukela eNkosini, uNkulunkulu kaIsrayeli, bamdinga, wabavumela ukuba bamfumane. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.4",
            "verseOrgIds": [
              "2CH.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalezozikhathi kwakungelakuthula ekuhambeni kwabantu, ngoba bonke abantu bamazwe behlelwa zinhlupheko ezinengi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.5",
            "verseOrgIds": [
              "2CH.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakukhona ukuchitheka endaweni zonke, isizwe sisilwa lesizwe, lomuzi usilwa lomuzi, ngoba uNkulunkulu wabehlisela inhlobo zonke zosizi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.6",
            "verseOrgIds": [
              "2CH.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa lina manini isibindi, liqine, ngoba umsebenzi wenu uzakuba lomvuzo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.7",
            "verseOrgIds": [
              "2CH.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho uAsa ewezwa wonke lamazwi kaAzariya indodana kaOdedi, waqunga isibindi, wakhupha zonke izithombe eziyisinengiso elizweni lonke lakoJuda lakoBenjamini lemizini ayeyithumbile entabeni zakoEfrayimi, walungisa ialtare leNkosi elalingaphambi komkoto wethempeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.8",
            "verseOrgIds": [
              "2CH.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabuthanisa bonke abakoJuda labakoBenjamini lalabo ababevela koEfrayimi lakoManase lakoSimeyoni ababehlala phakathi kwabo; ngoba abantu abanengi babalekela kuye bevela koIsrayeli lapho bebona ukuthi iNkosi uNkulunkulu wakhe yayilaye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.9",
            "verseOrgIds": [
              "2CH.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babuthana eJerusalema ngomnyaka wetshumi lanhlanu wokubusa kukaAsa, ngenyanga yesithathu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.10",
            "verseOrgIds": [
              "2CH.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayihlabela iNkosi uNkulunkulu ngalolosuku empangweni ababeyilethile inkabi ezingamakhulu ayisikhombisa lezimvu ezizinkulungwane eziyisikhombisa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.11",
            "verseOrgIds": [
              "2CH.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benza isivumelwano sokuba bayidinge iNkosi, uNkulunkulu wabokhokho babo, ngenhliziyo yabo yonke langomoya wabo wonke; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.12",
            "verseOrgIds": [
              "2CH.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "bathi lowo ongayidingi iNkosi uNkulunkulu kaIsrayeli uzabulawa, omutsha lomdala, owesilisa lowesifazana. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.13",
            "verseOrgIds": [
              "2CH.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bafunga isifungo eNkosini ngokumemeza langokukhala kwempondo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.14",
            "verseOrgIds": [
              "2CH.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bonke abakoJuda bathokoza ngesifungo, ngoba babefungile ngenhliziyo yabo yonke, beyidingile ngeqiniso, yabavumela ukuyifumana; ngakho iNkosi uNkulunkulu yabanika ukuthula inxa zonke. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.15",
            "verseOrgIds": [
              "2CH.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi uAsa yakhupha loninakhulu uMahaka esikhundleni sokuba yindlovukazi, ngoba wayemenzele unkulunkulukazi ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.16",
            "verseOrgIds": [
              "2CH.15.16"
            ]
          }
        },
        {
          "text": " isithombe esinengisayo. UAsa wasigamula isithombe, wasigxoba, wasitshisela esifuleni iKidroni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.16",
            "verseOrgIds": [
              "2CH.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanti indawo eziphakemeyo zokukhonzela kazivalwanga koIsrayeli; kodwa inhliziyo kaAsa yayiqotho insuku zakhe zonke. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.17",
            "verseOrgIds": [
              "2CH.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wangenisa endlini kaNkulunkulu izinto uyise ayezahlukanisele iNkosi, kanye lezakhe izinto ezahlukaniselwe iNkosi, isiliva legolide lezitsha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.18",
            "verseOrgIds": [
              "2CH.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakusabanga khona impi kwaze kwaba ngumnyaka wamatshumi amathathu lanhlanu wokubusa kukaAsa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.19",
            "verseOrgIds": [
              "2CH.15.19"
            ]
          }
        }
      ]
    }
  ],
