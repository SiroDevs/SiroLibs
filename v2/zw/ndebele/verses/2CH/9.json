              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.1",
            "verseOrgIds": [
              "2CH.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "USolomoni wayiphendula yonke imibuzo yayo, kwakungekho lutho olwamcatshelayo ehluleka ukuluchasisa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.2",
            "verseOrgIds": [
              "2CH.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosikazi yaseSheba isibonile konke ukuhlakanipha kukaSolomoni, lesigodlo ayesakhile, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.3",
            "verseOrgIds": [
              "2CH.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "lokudla kwakhe, lokuhlala kwezinduna zakhe, lokuhlelwa kwezinceku zakhe lezigqoko zazo, labaphathi bezitsha lezigqoko zabo, leminikelo yokutshiswa ayeyinikela ethempelini, kwayiqeda amandla. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.4",
            "verseOrgIds": [
              "2CH.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yathi enkosini: Yayiliqiniso imibiko engayizwa elizweni lami ngezindaba zakho langokuhlakanipha kwakho, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.5",
            "verseOrgIds": [
              "2CH.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kangiyikholwanga leyomibiko ngaze ngafika ngazibonela ngamehlo. Khangela, bengingatshelwanga ngitsho lengxenye nje yobukhulu bokuhlakanipha kwakho; wena umkhulu kulalokho engakuzwayo ngawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.6",
            "verseOrgIds": [
              "2CH.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayadela abafazi bakho. Ziyadela inceku zakho ezikusebenzelayo insuku zonke zizwe ukuhlakanipha kwakho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.7",
            "verseOrgIds": [
              "2CH.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kayibongwe iNkosi uNkulunkulu wakho ekuthandileyo, yakubeka ukuba ube yinkosi ebizweni leNkosi uNkulunkulu wakho. Ngoba uNkulunkulu uyabathanda abakoIsrayeli, uzakubaqinisa kuze kube nininini, ukubekile waba yinkosi yabo ukuba ubuse ngomthetho langokulunga. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.8",
            "verseOrgIds": [
              "2CH.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosikazi yaseSheba yasinika inkosi uSolomoni igolide ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.9",
            "verseOrgIds": [
              "2CH.9.9"
            ]
          }
        },
        {
          "text": " alikhulu lamatshumi amabili, lamakha amanengi kakhulu, lamatshe amahle. Kakuzanga kulethwe ngaphambili amakha amanengi njengala inkosikazi yaseSheba eyawanika inkosi uSolomoni.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.9",
            "verseOrgIds": [
              "2CH.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.9",
            "verseOrgIds": [
              "2CH.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi izinceku zikaHuramu lezikaSolomoni ezazithwala igolide livela eOfiri, zamlethela uSolomoni izigodo zomkampa lamatshe amahle. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.10",
            "verseOrgIds": [
              "2CH.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngezigodo zomkampa inkosi yenza izikhwelo zethempeli lezendlu yayo, yenza lemihubhe lamachacho abahlabeleli; kakuzanga kubonwe futhi izigodo ezifana lazo elizweni lakoJuda langaphambili.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.11",
            "verseOrgIds": [
              "2CH.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.11",
            "verseOrgIds": [
              "2CH.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi uSolomoni yanika inkosikazi yaseSheba konke ekufisayo lekucelayo, ngaphezu kwezipho zayo zokwenana izipho zenkosikazi. Yasibuyelake elizweni layo lezinceku zayo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.12",
            "verseOrgIds": [
              "2CH.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.12",
            "verseOrgIds": [
              "2CH.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubunzima begolide elalifika kuSolomoni ngomnyaka ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.13",
            "verseOrgIds": [
              "2CH.9.13"
            ]
          }
        },
        {
          "text": " angamakhulu ayisithupha lamatshumi ayisithupha lesithupha, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.13",
            "verseOrgIds": [
              "2CH.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngaphandle kwalelo elalivela emithelweni yabathengisi lenzuzweni yabathengi; wonke amakhosi aseArabiya lababusi belizwe baletha igolide lesiliva. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.14",
            "verseOrgIds": [
              "2CH.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi uSolomoni yenza izihlangu ezinkulu ezingamakhulu amabili ngegolide elikhandiweyo, sisinye senziwe ngegolide ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.15",
            "verseOrgIds": [
              "2CH.9.15"
            ]
          }
        },
        {
          "text": " angamakhulu ayisithupha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.15",
            "verseOrgIds": [
              "2CH.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yenza lamahawu angamakhulu amathathu ngegolide elikhandiweyo, lilinye lenziwe ngegolide ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.16",
            "verseOrgIds": [
              "2CH.9.16"
            ]
          }
        },
        {
          "text": " alikhulu lamatshumi amathathu. Yakufaka endlini ethiwa ngeyeGusu laseLebanoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.16",
            "verseOrgIds": [
              "2CH.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yenza lesihlalo sobukhosi esikhulu ngempondo zendlovu, yasinameka ngegolide elihle. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.17",
            "verseOrgIds": [
              "2CH.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izikhwelo eziyisithupha zesihlalo lesigcabha saso kwakunanyekwe ngegolide; emaceleni aso kulezindawo zokubeka ingalo, lezilwane ezimbili eceleni kwendawo zokubeka ingalo; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.18",
            "verseOrgIds": [
              "2CH.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwakumi izilwane ezilitshumi lambili ezikhwelweni eziyisithupha, esinye isilwane singapha lesinye singale kwesikhwelo. Kakwenziwanga isihlalo sobukhosi esinjalo lakuwuphi omunye umbuso. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.19",
            "verseOrgIds": [
              "2CH.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zonke inkezo zokunatha zenkosi uSolomoni zazenziwe ngegolide, lezitsha zonke zendlu ethiwa ngeyeGusu laseLebanoni zazenziwe ngegolide elihle; isiliva sasiyinto engasilutho ensukwini zikaSolomoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.20",
            "verseOrgIds": [
              "2CH.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi yayilemikolo emikhulu yokuthwala impahla olwandle eyayisiya eTarshishi lezinceku zikaHuramu; limikolo yokuthwala impahla yayibuya kanye ngeminyaka emithathu ithwele igolide lesiliva lempondo zendlovu lezindwangu lezinkawu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.21",
            "verseOrgIds": [
              "2CH.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.21",
            "verseOrgIds": [
              "2CH.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi uSolomoni yawadlula wonke amakhosi omhlaba ngokunotha langokuhlakanipha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.22",
            "verseOrgIds": [
              "2CH.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonke amakhosi omhlaba eza kuSolomoni ukuzwa ukuhlakanipha uNkulunkulu ayekufake engqondweni yakhe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.23",
            "verseOrgIds": [
              "2CH.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonke amlethela izipho, izinto zesiliva lezegolide, lezambatho, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.24",
            "verseOrgIds": [
              "2CH.9.24"
            ]
          }
        },
        {
          "text": ", lamakha, lamabhiza lezimbongolo; kwaba njalo iminyaka ngeminyaka.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.24",
            "verseOrgIds": [
              "2CH.9.24"
            ]
          }
        }
      ]
    },
    {
