              "type": "text"
            }
          ]
        },
        {
          "text": "USolomoni wahlala eJerusalema ebusa uIsrayeli wonke iminyaka engamatshumi amane. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.30",
            "verseOrgIds": [
