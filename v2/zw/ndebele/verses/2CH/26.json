                "loc": "EXO.30.7"
              },
              "items": [
                {
                  "text": "Eks 30:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.30.8"
              },
              "items": [
                {
                  "text": "8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.3.10"
              },
              "items": [
                {
                  "text": "Nani 3:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.18",
            "verseOrgIds": [
              "2CH.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasethukuthela uUziya. Wayephethe udengezi ukuba atshise impepha; esebathukuthelele abapristi, waba lobulephero ebunzini lakhe phambi kwabapristi ethempelini eduze lealtare lempepha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.19",
            "verseOrgIds": [
              "2CH.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "UAzariya umpristi omkhulu kanye labo bonke abapristi bamkhangela, babona ukuthi uselobulephero ebunzini lakhe; basebemkhupha masinyane, laye uqobo waphangisa ukuphuma, ngoba iNkosi yayisimtshayile. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.20",
            "verseOrgIds": [
              "2CH.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi uUziya yaba lobulephero yaze yafa; ngoba elobulephero wahlala endlini yakhe yedwa, wavalelwa ukuya ethempelini. UJothamu indodana yakhe wayegcina isigodlo senkosi, ephethe labantu belizwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.21",
            "verseOrgIds": [
              "2CH.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezinye indaba zikaUziya, kusukela ekuqaleni kuze kube sekucineni, zalotshwa nguIsaya umprofethi, indodana kaAmozi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.22",
            "verseOrgIds": [
              "2CH.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "U‐Uziya waya kwabaphansi, bamngcwaba kuboyise emalibeni angayisiwo awamakhosi, ngoba bathi: Ulobulephero. UJothamu indodana yakhe waba yinkosi esikhundleni sakhe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.23",
            "verseOrgIds": [
              "2CH.26.23"
            ]
          }
        },
        {
