          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezinye indaba zikaAmaziya, kusukela ekuqaleni kuze kube sekucineni, zilotshiwe ogwalweni lwamakhosi akoJuda lawakoIsrayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.26",
            "verseOrgIds": [
              "2CH.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kusukela esikhathini atshiya ngaso iNkosi bamenzela icebo eJerusalema, wasebalekela eLakishi; kodwa bathumela abantu khona, bambulalela khona. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.27",
            "verseOrgIds": [
              "2CH.25.27"
            ]
          }
        },
        {
