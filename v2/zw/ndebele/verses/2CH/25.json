              "type": "text"
            }
          ]
        },
        {
          "text": "UAmaziya indodana kaJowashi inkosi yakoJuda waphila iminyaka elitshumi lanhlanu ngemva kokufa kukaJowashi indodana kaJehowahazi inkosi yakoIsrayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.25",
            "verseOrgIds": [
              "2CH.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
