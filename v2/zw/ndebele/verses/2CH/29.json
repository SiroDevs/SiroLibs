            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "UHezekiya inkosi lezikhulu balaya amaLevi ukuba ayidumise iNkosi ngokuhlabela amazwi kaDavida lakaAsafi umboni. Ayidumisa ngokuhlabela, athokoza, athi mbo ngobuso phansi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.30",
            "verseOrgIds": [
              "2CH.29.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.30",
            "verseOrgIds": [
              "2CH.29.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 29:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "UHezekiya wasesithi ebantwini: Selizahlukanisele iNkosi; sondelani lilethe imihlatshelo yenu leminikelo yokubonga ethempelini. Ibandla laseliletha imihlatshelo leminikelo yokubonga; bonke ababelenhliziyo ezinhle baletha iminikelo yokutshiswa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.31",
            "verseOrgIds": [
              "2CH.29.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 29:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iminikelo yokutshiswa eyalethwa libandla yayizinkunzi ezingamatshumi ayisikhombisa, lenqama ezilikhulu, lamawundlu angamakhulu amabili; konke lokhu kwakungokomnikelo wokutshisela iNkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.32",
            "verseOrgIds": [
              "2CH.29.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 29:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwahlukaniselwe iNkosi kwakuzinkunzi ezingamakhulu ayisithupha lezimvu ezizinkulungwane ezintathu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.33",
            "verseOrgIds": [
              "2CH.29.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2CH 29:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa abapristi babebalutshwana, behluleka ukuyihlinza yonke iminikelo yokutshiswa; abanye abapristi bengakazihlambululi izihlobo zabo amaLevi abasiza, waze waphela umsebenzi, ngoba amaLevi akhuthalela ukuzihlambulula kulabapristi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.34",
            "verseOrgIds": [
              "2CH.29.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2CH 29:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaphandle kobunengi beminikelo yokutshiswa kwakukhona amahwahwa leminikelo yokuthula leminikelo yokuthululwa, leminikelo yokutshiswa. Yabuyiselwa ngokunjaloke inkonzo yethempeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.35",
            "verseOrgIds": [
              "2CH.29.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2CH 29:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "UHezekiya labantu bonke bathokoza ngalokho uNkulunkulu abenzele khona, lokuthi kwenzakala masinyane.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.36",
            "verseOrgIds": [
              "2CH.29.36"
            ]
          }
        }
      ]
