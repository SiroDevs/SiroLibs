          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngomnyaka wetshumi lambili wokubusa kukaJehoramu indodana kaAhabi inkosi yakoIsrayeli uAhaziya indodana kaJoramu, inkosi yakoJuda, waba yinkosi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.25",
            "verseOrgIds": [
              "2KI.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "UAhaziya wayeleminyaka engamatshumi amabili lambili lapho eqalisa ukubusa, wabusa eJerusalema umnyaka owodwa. Ibizo likanina lalinguAthaliya, umntanomntanakhe kaOmri inkosi yakoIsrayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.26",
            "verseOrgIds": [
              "2KI.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laye walandela izindlela zendlu kaAhabi, wenza okubi phambi kweNkosi njengendlu kaAhabi, ngoba wayengumkhwenyana wakhona. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.27",
            "verseOrgIds": [
              "2KI.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waphuma loJehoramu indodana kaAhabi ukuyahlasela uHazayeli inkosi yaseSiriya eRamothi‐Gileyadi, lapho amaSiriya amlimaza khona uJehoramu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.28",
            "verseOrgIds": [
              "2KI.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehoramu wabuyela eJezereli ukuba kuyekwelatshwa amanxeba ayewalinyazwe ngamaSiriya eRama ekuhlaseleni kwakhe uHazayeli inkosi yaseSiriya. UAhaziya indodana kaJoramu inkosi yakoJuda wahamba ukuyabona uJehoramu indodana kaAhabi eJezereli, ngoba wayegula.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.29",
            "verseOrgIds": [
              "2KI.8.29"
            ]
          }
        }
      ]
