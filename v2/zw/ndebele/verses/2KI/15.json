          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngomnyaka wamatshumi amahlanu wokubusa kukaAzariya inkosi yakoJuda uPekahiya indodana kaMenahema waba yinkosi koIsrayeli eSamariya, wabusa iminyaka emibili. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.23",
            "verseOrgIds": [
              "2KI.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenza okubi phambi kweNkosi, kazitshiyanga izono zikaJerobowamu indodana kaNebati ezenza uIsrayeli one. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.24",
            "verseOrgIds": [
              "2KI.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "UPeka indodana kaRemaliya, induna yakhe, wamenzela amacebo kanye labantu baseGileyadi abangamatshumi amahlanu, bambulala eSamariya enqabeni yesigodlo. Wabulala inkosi, waba yinkosi esikhundleni sayo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.25",
            "verseOrgIds": [
              "2KI.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezinye indaba zikaPekahiya lakho konke akwenzayo kulotshiwe ogwalweni lwezindaba zamakhosi akoIsrayeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.26",
            "verseOrgIds": [
              "2KI.15.26"
            ]
          }
        }
      ]
