              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngomnyaka wesibili wokubusa kukaPeka indodana kaRemaliya inkosi yakoIsrayeli uJothamu indodana kaUziya inkosi yakoJuda waba yinkosi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.32",
