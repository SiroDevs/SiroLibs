          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yenza isivumelwano labo, yabalaya yathi: Kaliyikukhonza abanye onkulunkulu, likhothamele kibo, libasebenzele, linikele iminikelo kibo,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.35",
            "verseOrgIds": [
              "2KI.17.35"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
