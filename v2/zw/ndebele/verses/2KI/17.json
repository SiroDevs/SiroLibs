          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basayenza imikhuba yabo emidala kuze kube lamuhla. Kabayikhonzi iNkosi uNkulunkulu, kabalandeli izimiso lemithetho lomlayo lezimemezelo iNkosi eyalaya ngakho abantwana bakaJakobe eyambiza ngokuthi nguIsrayeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.34",
            "verseOrgIds": [
              "2KI.17.34"
            ]
          }
        },
        {
