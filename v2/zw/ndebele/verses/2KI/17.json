          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "kodwa lizakhonza iNkosi eyalikhupha eGibithe ngamandla amakhulu langengalo elamandla, likhothame kuyo, linikele iminikelo kiyo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.36",
            "verseOrgIds": [
              "2KI.17.36"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
