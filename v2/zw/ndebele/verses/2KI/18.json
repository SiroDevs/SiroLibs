          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.35",
            "verseOrgIds": [
              "2KI.18.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 18:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bathula, kabaze baphendula langelilodwa ilizwi, ngoba inkosi yayithe: Lingamphenduli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.36",
            "verseOrgIds": [
              "2KI.18.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 18:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "UEliyakimi indodana kaHilikiya owayengumgcini wesigodlo, loShebina umabhalane, loJowa indodana kaAsafi, owayengumbhali, beza kuHezekiya izigqoko zabo zidatshuliwe, bamtshela amazwi enceku enkulu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.37",
            "verseOrgIds": [
              "2KI.18.37"
            ]
          }
        }
      ]
