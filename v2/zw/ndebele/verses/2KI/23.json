            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "EBetheli wadiliza ialtare elalisendaweni ephakemeyo yokukhonzela elamiswa nguJerobowamu indodana kaNebati owenza uIsrayeli ukuba one, walichitha kanye lendawo ephakemeyo yokukhonzela, wadiliza amatshe alo, wawachoboza aba luthuli, watshisa insika kankulunkulukazi ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.15",
            "verseOrgIds": [
              "2KI.23.15"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.15",
            "verseOrgIds": [
              "2KI.23.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
