                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.15",
            "verseOrgIds": [
              "2KI.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho uJosiya ethalaza wabona amaliba phezulu entabeni, wathumela abantu ukukhupha amathambo emalibeni, wawatshisela phezu kwealtare, walingcolisa, njengelizwi leNkosi elakhulunywa ngumuntu kaNkulunkulu lapho uJerobowamu emi eduze lealtare ngesikhathi somkhosi. Kodwa lapho uJosiya ebona iliba lomuntu kaNkulunkulu owabikezela lezizinto,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.16",
            "verseOrgIds": [
              "2KI.23.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
