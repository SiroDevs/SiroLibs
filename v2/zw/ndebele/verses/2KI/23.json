              },
              "items": [
                {
                  "text": "1 Kho 13:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.16",
            "verseOrgIds": [
              "2KI.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "wabuza esithi: Yisikhumbuzo sani lesiyana na? Abantu bomuzi bamtshela bathi: Lingcwaba lomuntu kaNkulunkulu owavela koJuda wabikezela lezizinto ozenzileyo ealtareni laseBetheli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.17",
            "verseOrgIds": [
              "2KI.23.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
