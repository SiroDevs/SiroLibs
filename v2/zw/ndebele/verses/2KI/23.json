                {
                  "text": "2 Kho 21:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.33.3"
              },
              "items": [
                {
                  "text": "2 Lan 33:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.4",
            "verseOrgIds": [
              "2KI.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakhupha abapristi bezithombe amakhosi akoJuda ayebabekile ukutshisa impepha endaweni eziphakemeyo zokukhonzela emizini yakoJuda langaseJerusalema, lalabo ababetshisela uBali impepha lelanga lenyanga lezinkanyezi zonke zaphezulu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.5",
            "verseOrgIds": [
              "2KI.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakhupha ethempelini insika emiselwe unkulunkulukazi uAshera, wayisa esifuleni iKidroni ngaphandle kweJerusalema, wayitshisa khona, wayicubuza yaba luthuli, waluphosela emalibeni abantukazana. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.6",
            "verseOrgIds": [
              "2KI.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wadiliza izindlu zamadoda angamawule ezazikhona ethempelini lapho abesifazana babesalukela khona amaveli kankulunkulukazi uAshera.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.7",
            "verseOrgIds": [
              "2KI.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.7",
            "verseOrgIds": [
              "2KI.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakhupha bonke abapristi emizini yakoJuda, wangcolisa indawo eziphakemeyo zokukhonzela lapho abapristi babetshisela khona impepha, kusukela eGeba kusiya eBerisheba. Wavala indawo eziphakemeyo zokukhonzela zabomoya ababi ngaphambi kwesango likaJoshuwa umphathi womuzi, ngasekhohlo kwesango lomuzi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.8",
            "verseOrgIds": [
              "2KI.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labobapristi bendawo eziphakemeyo zokukhonzela kabezanga ealtareni leNkosi uNkulunkulu eJerusalema, kodwa badla isinkwa esingelamvubelo phakathi kwezihlobo zabo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.9",
            "verseOrgIds": [
              "2KI.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wangcolisa iTofethi elisesihotsheni saseBeni‐Hinomu ukuze kungabi khona umuntu otshisa indodana yakhe kumbe indodakazi yakhe ibe ngumnikelo kunkulunkulu uMoloki.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.10",
            "verseOrgIds": [
              "2KI.23.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
