                "loc": "JER.41.1+JER.41.2+JER.41.3"
              },
              "items": [
                {
                  "text": "Jer 41:1–3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.25",
            "verseOrgIds": [
              "2KI.25.25"
            ]
