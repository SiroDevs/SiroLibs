          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bonke abantu abakhulu labancinyane lenduna zamabutho basuka babalekela eGibithe, ngoba besaba amaKaladiya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.26",
            "verseOrgIds": [
              "2KI.25.26"
            ]
          }
