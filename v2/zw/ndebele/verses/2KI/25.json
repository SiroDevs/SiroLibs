                "loc": "JER.40.7+JER.40.8+JER.40.9"
              },
              "items": [
                {
                  "text": "Jer 40:7–9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.22",
            "verseOrgIds": [
              "2KI.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi zonke induna zamabutho, kanye lamabutho azo, sezizwile ukuthi inkosi yaseBabiloni ibeke uGedaliya ukuba ngumbusi, zeza labantu bazo kuGedaliya eMizipa, zazingoIshmayeli indodana kaNethaniya loJohanani indodana kaKareya loSeraya indodana kaTanihumethi waseNetofa loJazaniya indodana kaMahakathi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.23",
            "verseOrgIds": [
              "2KI.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "UGedaliya wafunga kuzo lakubantu bazo wathi: Lingesabi induna zamaKaladiya; hlalani elizweni, likhonze inkosi yaseBabiloni, kuzalilungela. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.24",
            "verseOrgIds": [
              "2KI.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa ngenyanga yesikhombisa uIshmayeli indodana kaNethaniya kaElishama, owendlu yobukhosi, wafika lamadoda alitshumi, bamhlasela bambulala uGedaliya kanye labaJuda lamaKaladiya ayelaye eMizipa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.25",
            "verseOrgIds": [
              "2KI.25.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
