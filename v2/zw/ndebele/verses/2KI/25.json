          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "wayelesabelo esimiyo esenzuku zonke, asinikwa yinkosi njengokuswela kwakhe insuku zonke zokuhamba kwakhe, waze wafa.",
          "type": "text",
          "attrs": {
