          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNebukadineza inkosi yaseBabiloni yabeka uGedaliya indodana kaAhikamu kaShafani ukuba ngumbusi wabantu abasala koJuda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.22",
            "verseOrgIds": [
              "2KI.25.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
