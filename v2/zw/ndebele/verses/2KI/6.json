              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi yathi: UNkulunkulu kangihlanekele ngokwengezelelweyo uba ngingamqumi ikhanda uElisha indodana kaShafati lamuhla.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.31",
            "verseOrgIds": [
              "2KI.6.31"
            ]
          }
        }
