              "items": [
                {
                  "text": "29:1–2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.12",
            "verseOrgIds": [
              "2KI.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "yathumba layo yonke inotho yethempeli lenotho yesigodlo senkosi, yabulala zonke izitsha zegolide ezisethempelini leNkosi, uSolomoni inkosi yakoIsrayeli owayezenzile, njengokutsho kweNkosi uNkulunkulu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.13",
            "verseOrgIds": [
              "2KI.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yathumba abaseJerusalema, izikhulu zonke, lawo wonke amadoda empi, abantu abazinkulungwane ezilitshumi, kanye lezingcitshi zemisebenzi labakhandi; kwasala abantukazana belizwe kuphela. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.14",
            "verseOrgIds": [
              "2KI.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehoyakini yamusa eBabiloni kanye lonina, lamakhosikazi akhe, labathenwa bakhe, lezikhulu zelizwe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.15",
            "verseOrgIds": [
              "2KI.24.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.17.12"
              },
              "items": [
                {
                  "text": "Hez 17:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.15",
            "verseOrgIds": [
              "2KI.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yathumbela eBabiloni wonke amadoda angamaqhawe, abantu abazinkulungwane eziyisikhombisa, lezingcitshi zemisebenzi labakhandi, abantu abayinkulungwane, bonke bengabantu abaqinileyo abangaphuma impi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.16",
            "verseOrgIds": [
              "2KI.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi yaseBabiloni yabeka uMathaniya uyise omncinyane kaJehoyakini ukuba abe yinkosi, waphendula ibizo lakhe wathi nguZedekiya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.17",
            "verseOrgIds": [
              "2KI.24.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
