              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenza okubi phambi kweNkosi njengokwenza konke kukaJehoyakimi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.19",
            "verseOrgIds": [
              "2KI.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "IJerusalema loJuda bayithukuthelisa kakhulu iNkosi uNkulunkulu yaze yabaxotsha phambi kwayo. UZedekiya wayivukela inkosi yaseBabiloni.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.20",
            "verseOrgIds": [
              "2KI.24.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
