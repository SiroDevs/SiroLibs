                "loc": "EXO.19.12"
              },
              "items": [
                {
                  "text": "Eks 19:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.19.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.20",
            "verseOrgIds": [
              "HEB.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HEB 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Impela kwakusesabeka lokho okwabonwayo, uMose waze wathi: Ngilovalo ngiyathuthumela.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.21",
            "verseOrgIds": [
              "HEB.12.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.9.19"
              },
              "items": [
                {
                  "text": "Dute 9:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.21",
            "verseOrgIds": [
              "HEB.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HEB 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa lina lize entabeni yaseZiyone lasemzini kaNkulunkulu ophilayo, iJerusalema elasezulwini, lakuzithunywa eziyizigidi ezingelakubalwa ezihlangene ngokuthokoza, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.22",
            "verseOrgIds": [
              "HEB.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HEB 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "lasemhlanganweni wamazibulo abhalwe ezulwini, lakuNkulunkulu umahluleli wakho konke, lakumimoya yabalungileyo abaphelelisiweyo, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.23",
            "verseOrgIds": [
              "HEB.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "HEB 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "lakuJesu umlamuli wesivumelwano esitsha, ogazi lakhe elifafaziweyo likhuluma okuhle kakhulu kulelikaAbela.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.24",
            "verseOrgIds": [
              "HEB.12.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.4.10"
              },
              "items": [
                {
                  "text": "Gen 4:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.24",
            "verseOrgIds": [
              "HEB.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "HEB 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qaphelani ukuba lingali ukulalela ilizwi lakhe okhulumayo; ngoba uba bengaphephanga labo abala ukumlalela lowo owabaxwayisa emhlabeni, kakhulu kasiyikuphepha thina esimalayo lowo oxwayisa esezulwini.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.25",
            "verseOrgIds": [
              "HEB.12.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.22"
              },
              "items": [
                {
                  "text": "Eks 20:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.25",
            "verseOrgIds": [
              "HEB.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "HEB 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalesosikhathi ilizwi lakhe lanyikinya umhlaba, kodwa khathesi uthembisile ukuthi: Ngizakuphinda futhi ukunyikinya, kungasumhlaba wodwa, kodwa lamazulu futhi.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.26",
            "verseOrgIds": [
              "HEB.12.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAG.2.6"
              },
              "items": [
                {
                  "text": "Hag 2:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.26",
            "verseOrgIds": [
              "HEB.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "HEB 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lamazwi okuthi ngizakuphinda futhi, atsho ukuthi lezozinto ezidaliweyo ezinyikinyiweyo zizakususwa, ukuze kusale kuphela lokho okunganyikinyekiyo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.27",
            "verseOrgIds": [
              "HEB.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "HEB 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umbuso esiwuphiweyo kawulakunyikinyekiswa; ngakho asimbonge uNkulunkulu, ukuze simkhonze njengokuba efanele ukukhonzwa, ngokuthobeka langokwesaba; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.28",
            "verseOrgIds": [
              "HEB.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "HEB 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngoba uNkulunkulu wethu ungumlilo oqothulayo.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.29",
            "verseOrgIds": [
              "HEB.12.29"
            ]
          }
        },
