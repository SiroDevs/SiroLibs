          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalizanga kukho okungazwiwa ngokuthintwa, emlilweni ovuthayo, lasemnyameni, lasekufiphaleni, lasesivunguvungwini,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.18",
            "verseOrgIds": [
              "HEB.12.18"
            ]
          }
        },
        {
