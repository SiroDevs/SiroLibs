          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "elealtare legolide lokutshisela impepha, lomtshokotsho ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.4",
            "verseOrgIds": [
              "HEB.9.4"
            ]
          }
        },
        {
          "text": " obhadwe ngegolide inxa zonke, okwakukhona kuwo inqayi yegolide ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.4",
            "verseOrgIds": [
              "HEB.9.4"
            ]
          }
        },
        {
          "text": " phakathi, lenduku kaAroni eyahlumayo, lamatshe esivumelwano;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.4",
            "verseOrgIds": [
              "HEB.9.4"
            ]
