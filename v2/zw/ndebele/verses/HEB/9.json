              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasemva kweveli lesibili kwakukhona ithente elibizwa ngokuthi yiNdawo engcwele kakhulu,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.3",
            "verseOrgIds": [
              "HEB.9.3"
            ]
          }
        },
