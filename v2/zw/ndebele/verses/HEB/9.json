          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba lapho isimenyezelwe imithetho yonke yomlayo nguMose ebantwini bonke, wathatha igazi lamankonyane lelembuzi kanye lamanzi loboya obubomvu lozipho, wafafaza incwadi labantu bonke,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.19",
            "verseOrgIds": [
              "HEB.9.19"
            ]
          }
        },
        {
