            }
          ]
        },
        {
          "text": "Lesivumelwano sokuqala sasilezimiso zenkonzo lendawo engcwele yasemhlabeni. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.1",
            "verseOrgIds": [
              "HEB.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba kwakhiwa ithente elokuqala elibizwa ngokuthi yiNdawo engcwele, okwakukhona kulo uluthi lwesibane letafula lezinkwa ezahlukaniselwe uNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.2",
            "verseOrgIds": [
              "HEB.9.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
