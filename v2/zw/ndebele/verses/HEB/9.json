              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "phezu kwawo kwakukhona ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.5",
            "verseOrgIds": [
              "HEB.9.5"
            ]
          }
        },
        {
          "text": " enkazimulo engamele isihlalo somusa. Singekhulume kakhulu ngalezizinto khathesinje.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.5",
            "verseOrgIds": [
              "HEB.9.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
