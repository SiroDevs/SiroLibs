              "attrs": {
                "loc": "EXO.25.18+EXO.25.19+EXO.25.20+EXO.25.21+EXO.25.22"
              },
              "items": [
                {
                  "text": "Eks 25:18–22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.5",
            "verseOrgIds": [
              "HEB.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sezilungisiwe lezizinto ngokunjalo, abapristi bangena njalonjalo ethenteni lokuqala besenza umsebenzi wabo wokukhonza;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.6",
            "verseOrgIds": [
              "HEB.9.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.2+NUM.18.3+NUM.18.4+NUM.18.5+NUM.18.6"
              },
              "items": [
                {
                  "text": "Nani 18:2–6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.6",
            "verseOrgIds": [
              "HEB.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kodwa kwelesibili kungena umpristi omkhulu yedwa, laye engena kanye ngomnyaka, ephethe igazi anikela ngalo ngenxa yakhe langenxa yeziphambeko zabantu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.7",
            "verseOrgIds": [
              "HEB.9.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.16.2+LEV.16.3+LEV.16.4+LEV.16.5+LEV.16.6+LEV.16.7+LEV.16.8+LEV.16.9+LEV.16.10+LEV.16.11+LEV.16.12+LEV.16.13+LEV.16.14+LEV.16.15+LEV.16.16+LEV.16.17+LEV.16.18+LEV.16.19+LEV.16.20+LEV.16.21+LEV.16.22+LEV.16.23+LEV.16.24+LEV.16.25+LEV.16.26+LEV.16.27+LEV.16.28+LEV.16.29+LEV.16.30+LEV.16.31+LEV.16.32+LEV.16.33+LEV.16.34"
              },
              "items": [
                {
                  "text": "Levi 16:2–34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.7",
            "verseOrgIds": [
              "HEB.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalokhu uMoya oNgcwele utshengisa ukuthi indlela yokungena endaweni engcwele kayikavuleki lapho lisekhona ithente lokuqala. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.8",
            "verseOrgIds": [
              "HEB.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konke lokhu kungumfanekiso walesisikhathi. Iminikelo lemihlatshelo emiswe lapho kayilamandla okwenza okhonzayo aphelele maqondana lesazela sakhe. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.9",
            "verseOrgIds": [
              "HEB.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa yona imayelana lokudla lokunatha lokugeza okwezinhlobonhlobo, iyizimiso ezimayelana lomzimba nje kuze kufike isikhathi sokupheleliswa kwezinto.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.10",
            "verseOrgIds": [
              "HEB.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
