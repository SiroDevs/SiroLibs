                "loc": "EXO.24.6+EXO.24.7+EXO.24.8"
              },
              "items": [
                {
                  "text": "Eks 24:6–8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.19",
            "verseOrgIds": [
              "HEB.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
