              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNkulunkulu wakhuluma endulo kubokhokho ngabaprofethi ngamathuba amanengi langezindlela ezinengi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.1",
            "verseOrgIds": [
              "HEB.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa kulezinsuku zokucina ukhulume kithi ngeNdodana ayimise ibe yindlalifa yezinto zonke, yona adala ngayo futhi umhlaba. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.2",
            "verseOrgIds": [
              "HEB.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yona iyikubenyezela kwenkazimulo kaNkulunkulu, ifuze yena uqobo, iphethe izinto zonke ngelizwi layo lamandla. Lapho isiyenzile ukuhlanjululwa kwezono, yahlala phansi ngakwesokunene soMkhulu phezulu, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.3",
            "verseOrgIds": [
              "HEB.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaba nkulu kulezithunywa, njengalokhu ibizo eliyilifa layo lilikhulu kulelazo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.4",
            "verseOrgIds": [
              "HEB.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba yisiphi isithunywa uNkulunkulu ake atsho kuso na ukuthi:",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.5",
            "verseOrgIds": [
              "HEB.1.5"
            ]
          }
        }
      ]
