            "sid": "HEB 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhoke asiqaphelisise esikuzwileyo funa mhlawumbe siduhe kukho. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.1",
            "verseOrgIds": [
              "HEB.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba uba ilizwi elakhulunywa yizithunywa laqiniseka, lakho konke ukuphambuka lokungalaleli kwaphindiselwa ngokufaneleyo, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.2",
            "verseOrgIds": [
              "HEB.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "thina sizakuphepha kanjani, uba sidelela ukusiliswa okungaka na? Kwakhulunywa kuqala yiNkosi, kwafakazwa kithi yilabo abayizwayo, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.3",
            "verseOrgIds": [
              "HEB.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "uNkulunkulu futhi efakaza kanye labo ngezibonakaliso langezimangaliso langemisebenzi yamandla eyizinhlobonhlobo langeziphiwo zikaMoya oNgcwele, ezabelwa ngokwentando yakhe. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.4",
            "verseOrgIds": [
              "HEB.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba kwakungesizo izithunywa uNkulunkulu ehlisela ngaphansi kwazo ilizwe elizayo esikhuluma ngalo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.5",
            "verseOrgIds": [
              "HEB.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kufakaziwe endaweni ethile ngokuthi:",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.6",
            "verseOrgIds": [
              "HEB.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.13",
            "verseOrgIds": [
              "HEB.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhoke njengoba abantwana behlanganyela inyama legazi, laye uqobo wahlanganyela khona lokho, ukuze ngokufa amchithe yena obelamandla okufa onguSathane, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.14",
            "verseOrgIds": [
              "HEB.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "abakhulule ebugqilini bonke labo abathi ngokwesaba ukufa ekuphileni kwabo konke baba yizigqili. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.15",
            "verseOrgIds": [
              "HEB.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba phela kasizi izithunywa, kodwa usiza inzalo kaAbrahama. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.16",
            "verseOrgIds": [
              "HEB.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhoke kwamfanela ukuba abe njengabafowabo kukho konke, ukuze abe ngumpristi omkhulu olesihawu lothembekileyo enkonzweni kaNkulunkulu, ukuba abe yinhlawulo yezono zabantu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.17",
            "verseOrgIds": [
              "HEB.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba lokhu wahlupheka yena uqobo elingwa, ulamandla okusiza abalingwayo.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.18",
            "verseOrgIds": [
              "HEB.2.18"
            ]
          }
        }
      ]
    }
