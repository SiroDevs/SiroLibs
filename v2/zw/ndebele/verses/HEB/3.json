              },
              "items": [
                {
                  "text": "Nani 12:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.2",
            "verseOrgIds": [
              "HEB.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJesu kwathiwa ufanele udumo olukhulu kuloMose, njengoba umakhi wendlu ulodumo olukhulu kulendlu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.3",
            "verseOrgIds": [
              "HEB.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba indlu ileyo laleyo yakhiwa ngothile; kodwa umakhi wezinto zonke nguNkulunkulu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.4",
            "verseOrgIds": [
              "HEB.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose kambe wayethembekile endlini yonke kaNkulunkulu njengenceku, ukuze kufakazelwe lokho obekuzakukhulunywa; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.5",
            "verseOrgIds": [
              "HEB.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kodwa uKristu uthembekile phezu kwendlu kaNkulunkulu njengendodana. Thina siyindlu yakhe, uba sihlala silesibindi siziqhenya ngethemba lethu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.6",
            "verseOrgIds": [
              "HEB.3.6"
            ]
          }
        }
      ]
    },
