              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kokunye lisenziwa umbukiso ngenhlamba langezinhlupheko, kokunye lihlanganyela labanye ababephathwa ngokunjalo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.33",
            "verseOrgIds": [
              "HEB.10.33"
            ]
          }
        },
