          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba lifanele ukubekezela, ukuze kuthi seliyenzile intando kaNkulunkulu lamukeliswe okwathenjiswayo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.36",
