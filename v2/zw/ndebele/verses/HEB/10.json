          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba lazwelana lababotshiweyo, lavuma ngokuthokoza ukwamukwa impahla yenu, lokhu lisazi ukuthi lina lilempahla enhle kulaleyo, impahla engapheliyo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.34",
            "verseOrgIds": [
              "HEB.10.34"
            ]
          }
        },
