                "loc": "DEU.31.6"
              },
              "items": [
                {
                  "text": "Dute 31:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.31.8"
              },
              "items": [
                {
                  "text": "8",
