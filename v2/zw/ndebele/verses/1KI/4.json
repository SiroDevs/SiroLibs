        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.32",
            "verseOrgIds": [
              "1KI.4.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakhuluma ngezihlahla kusukela emikuswini yaseLebanoni kwaze kwafika kuzintelezi ezimila emidulini; wakhuluma ngenyamazana langezinyoni langezinanakazana langenhlanzi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.33",
            "verseOrgIds": [
              "1KI.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakufika abantu bevela ezizweni zonke ukuzwa ukuhlakanipha kukaSolomoni, bevela emakhosini wonke omhlaba ayezwe ngokuhlakanipha kwakhe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.34",
            "verseOrgIds": [
              "1KI.4.34"
            ]
          }
        }
