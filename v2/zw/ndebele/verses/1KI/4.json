        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.28",
            "verseOrgIds": [
              "1KI.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNkulunkulu wamnika uSolomoni ukuhlakanipha lokuqedisisa okukhulu, lengqondo ebanzi kakhulu, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.29",
            "verseOrgIds": [
              "1KI.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwaze kwathi ukuhlakanipha kwakhe kwadlula ukuhlakanipha kwabo bonke abantu basempumalanga lokuhlakanipha konke kwaseGibithe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.30",
            "verseOrgIds": [
              "1KI.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba wayehlakaniphile kulabo bonke abantu, wayehlakaniphile ukwedlula uEthani waseEzira loHemani loKalikoli loDarida amadodana kaMaholi; lodumo lwakhe lwagcwala ezizweni zonke ezazizingelezele. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.31",
            "verseOrgIds": [
              "1KI.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waqamba izaga ezizinkulungwane ezintathu, lengoma zakhe zaziyinkulungwane lanhlanu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.32",
            "verseOrgIds": [
              "1KI.4.32"
            ]
          }
        },
        {
