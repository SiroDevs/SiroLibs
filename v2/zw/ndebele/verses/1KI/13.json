            "number": "32",
            "style": "v",
            "sid": "1KI 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba ilizwi leNkosi alitsho ngealtare eliseBetheli, langawo wonke amathempeli ezindawo eziphakemeyo zokukhonzela emizini yonke yaseSamariya lizagcwaliseka sibili.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.32",
            "verseOrgIds": [
              "1KI.13.32"
            ]
          }
        }
      ]
