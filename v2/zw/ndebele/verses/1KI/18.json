      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.29",
            "verseOrgIds": [
              "1KI.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "UElija wasesithi ebantwini bonke: Sondelani kimi. Bonke abantu basondela. Waselungisa ialtare leNkosi elaselidilikile. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.30",
            "verseOrgIds": [
              "1KI.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathatha amatshe alitshumi lambili, alingana ubunengi bezizwe zamadodana kaJakobe okwafika kuye ilizwi leNkosi lisithi: Ibizo lakho lizakuba nguIsrayeli.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.31",
            "verseOrgIds": [
              "1KI.18.31"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.32.28"
              },
              "items": [
                {
                  "text": "Gen 32:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.35.10"
              },
              "items": [
                {
                  "text": "35:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.31",
            "verseOrgIds": [
              "1KI.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalawomatshe wakha ialtare ebizweni leNkosi. Wemba umgelo ozingelezela ialtare, okungangena kuwo igokoko lenhlanyelo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.32",
            "verseOrgIds": [
              "1KI.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waselungisa inkuni, wayihlahlela iziqa inkunzi, wazibeka phezu kwenkuni, wasesithi: Gcwalisani imbiza ezine ngamanzi, liwathele phezu komnikelo laphezu kwenkuni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.33",
            "verseOrgIds": [
              "1KI.18.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi: Phindani futhi. Basebephinda. Wathi: Phindani okwesithathu. Basebephinda okwesithathu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.34",
            "verseOrgIds": [
              "1KI.18.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 18:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amanzi ageleza, azingelezela ialtare, agcwalisa lomgelo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.35",
            "verseOrgIds": [
              "1KI.18.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 18:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi ngesikhathi sokunikelwa komnikelo uElija wasondela wathi: Nkosi, Nkulunkulu kaAbrahama lokaIsaka lokaIsrayeli, kakwaziwe lamhla ukuthi nguwe onguNkulunkulu koIsrayeli; lokuthi mina ngiyinceku yakho, lokuthi ngizenzile zonke lezizinto ngokutsho kwakho. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.36",
            "verseOrgIds": [
              "1KI.18.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 18:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ake ungiphendule, Nkosi, ungiphendule ukuba lababantu bazi ukuthi wena Nkosi unguNkulunkulu, lokuthi uziphendulele kuwe inhliziyo zabo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.37",
            "verseOrgIds": [
              "1KI.18.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 18:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasusehla umlilo kaNkulunkulu, watshisa umnikelo wokutshiswa lenkunzi lamatshe lenhlabathi, waqeda lamanzi asemgelweni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.38",
            "verseOrgIds": [
              "1KI.18.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 18:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi abantu bonke bekubona lokhu bathi mbo ngobuso phansi, bathi: INkosi yiyo enguNkulunkulu; iNkosi yiyo enguNkulunkulu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.39",
            "verseOrgIds": [
              "1KI.18.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 18:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "UElija wasesithi kibo: Babambeni abaprofethi bakaBali, kungaphunyuki loyedwa wabo. Basebebabamba. UElija wabehlisela esifuleni iKishoni, wababulalela khona.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.40",
            "verseOrgIds": [
              "1KI.18.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 18:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.40",
            "verseOrgIds": [
              "1KI.18.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 18:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "UElija wasesithi kuAhabi: Buyela, uyekudla unathe, ngoba izulu selihuba. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.41",
            "verseOrgIds": [
              "1KI.18.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 18:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasebuyelake uAhabi ukuba ayekudla anathe. UElija wakhwela engqongeni yentaba iKarmeli; wakhothamela phansi emhlabathini, wafaka ikhanda lakhe phakathi kwamadolo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.42",
            "verseOrgIds": [
              "1KI.18.42"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.5.18"
              },
              "items": [
                {
                  "text": "Jak 5:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.42",
            "verseOrgIds": [
              "1KI.18.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 18:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi encekwini yakhe: Akuhambe, ukhangele ngasolwandle. Yahambake, yakhangela, yathi: Kakulalutho. UElija wathi: Hamba futhi uphinde kasikhombisa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.43",
            "verseOrgIds": [
              "1KI.18.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1KI 18:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngesikhathi sesikhombisa yathi: Ngibone iyezana elingangesandla somuntu liphuma olwandle. Wathi: Hamba uyetshela uAhabi ukuba abophele inqola yakhe yokulwa, ahambe, funa izulu limvalele. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.44",
            "verseOrgIds": [
              "1KI.18.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1KI 18:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi ngemva kwesikhatshana kwaba mnyama phezulu ngamayezi, umoya wavunguza, kwana izulu elikhulu. UAhabi wakhwela inqola yakhe, waya eJezereli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.45",
            "verseOrgIds": [
              "1KI.18.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1KI 18:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amandla eNkosi uNkulunkulu ehlela kuElija; wakhwica ingubo yakhe, wagijima phambi kukaAhabi, waze wafika esangweni laseJezereli.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.46",
            "verseOrgIds": [
              "1KI.18.46"
            ]
          }
        }
      ]
    }
