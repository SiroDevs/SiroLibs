              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yilo lelilizwi iNkosi elikhulume ngoMowabi ezikhathini ezidlulileyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.13",
            "verseOrgIds": [
