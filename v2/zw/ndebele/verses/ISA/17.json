              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalolosuku abantu bazamkhumbula uMenzi wabo, amehlo abo akhangele koNgcwele kaIsrayeli; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.7",
            "verseOrgIds": [
              "ISA.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kabayikukhathalela ama‐altare, umsebenzi wezandla zabo; kabayikuthemba kokwenziweyo ngezandla zabo, insika ezimiselwe unkulunkulukazi uAshera loba ama‐altare empepha. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.8",
            "verseOrgIds": [
              "ISA.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalolosuku imizi yabo eqinileyo izakuba njengezindawo ezideliweyo zamaHivi lamaAmori, azidela ekungeneni kwabakoIsrayeli; izakuba yinkangala.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.9",
