              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.14",
            "verseOrgIds": [
              "ISA.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi uNkulunkulu wamabandla yathi kimi: Hamba uye enduneni uShebina, umphathi wesigodlo, uthi kuye: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.15",
            "verseOrgIds": [
              "ISA.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenzani lapha, futhi ulelungelo bani, ukuba uzimbele ingcwaba wena ozimbela ingcwaba phezulu, ozimbela indawo yokuhlala edwaleni na? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.16",
            "verseOrgIds": [
              "ISA.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba iNkosi izakukujikijela khatshana, wena muntu olamandla; izakukubamba ikuqinise, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.17",
            "verseOrgIds": [
              "ISA.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ikuzunguze, ikuphose njengegade elizweni elibanzi, ufele khona; kuzakuba khona lapho lezinqola zakho ezinhle, wena olihlazo endlini yenkosi yakho! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.18",
            "verseOrgIds": [
              "ISA.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi izakukukhupha esikhundleni sakho, ikuwise endaweni yakho ephakemeyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.19",
            "verseOrgIds": [
              "ISA.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalolosuku, kutsho iNkosi, ngizabiza inceku yami uEliyakimi indodana kaHilikiya; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.20",
            "verseOrgIds": [
              "ISA.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngizakumambathisa ingubo yakho, ngimbophe ngebhanti lakho, nginikeze amandla akho kuye; yena uzakuba nguyise wabantu abaseJerusalema labakoJuda. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.21",
            "verseOrgIds": [
              "ISA.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngizabeka emahlombe akhe ikhiye yendlu kaDavida; yena uzavula, kungavali muntu, avale, kungavuli muntu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.22",
            "verseOrgIds": [
              "ISA.22.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.3.7"
              },
              "items": [
                {
                  "text": "Isam 3:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.22",
            "verseOrgIds": [
              "ISA.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngizakumbethela abe njengesikhonkwane esiqinileyo; uzakuba yisihlalo sobukhosi esilodumo endlini kayise. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.23",
            "verseOrgIds": [
              "ISA.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazamethwesa lonke udumo lwendlu kayise, inzalo labantwana bayo, zonke izitsha ezincinyane, inkezo lezinkamba. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.24",
            "verseOrgIds": [
              "ISA.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalolosuku, kutsho iNkosi yamabandla, isikhonkwane esabethelwa saqina sizakhumuka, saphuke siwe; lomthwalo obuphezu kwaso udilike; ngoba iNkosi ikhulumile.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.25",
            "verseOrgIds": [
              "ISA.22.25"
            ]
          }
        }
      ]
    }
