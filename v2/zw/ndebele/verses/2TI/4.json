              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "UAleksandro umkhandi wethusi wangenzela okubi okunengi; iNkosi izakumbuyisela ngokwemisebenzi yakhe. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.14",
