          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngoba uDema, ngokuthanda lumhlaba, ungihlamukile, waya eTesalonika, uKresena uye eGalathiya, uTitosi eDalmathiya; ",
          "type": "text",
          "attrs": {
