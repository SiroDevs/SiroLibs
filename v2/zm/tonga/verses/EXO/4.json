              "attrs": {
                "loc": "LUK.21.14"
              },
              "items": [
                {
                  "text": "21:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbubo, koya. Njooba amulomo wako, njookwiisya mboelede kwaamba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.12",
            "verseOrgIds": [
              "EXO.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
