              "items": [
                {
                  "text": "Dt 5:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino uleelede kwaambaula awe akubika majwi mukanwa lyakwe, Ambebo njooba amulomo wako amulomo wakwe, njoomwiisya mbumweelede kucita. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.15",
            "verseOrgIds": [
              "EXO.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.7.1"
              },
              "items": [
                {
                  "text": "Kul 7:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.18.19"
              },
              "items": [
                {
                  "text": "18:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ngonguwe uuyooambila bantu mucibaka cako, Uyooba mulomo wako, ayebo uyoomubeda mbuli Leza, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.16",
            "verseOrgIds": [
              "EXO.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awalo musako oyu, koutola mujanza lyako, nkaambo ngonguwo ngoyoocitya malele.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.17",
            "verseOrgIds": [
              "EXO.4.17"
            ]
          }
        }
      ]
