                "loc": "JHN.1.3"
              },
              "items": [
                {
                  "text": "Joh 1:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakati, Akaka Mwami! Tuma kujanza lyamuntu umbi, kufumbwa ngokonzya. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.13",
            "verseOrgIds": [
              "EXO.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpoonya awo bukali bwa-Jehova bwakabukila Musa. Wakati, Sa Aroni mu-Levi teensi munyoko? Ndizi kuti walo ncobeni ulizi kwaamba. Alimwi bona! Uleza kuzookutambula, Akubona, uyookondwa mumoyo wakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.14",
            "verseOrgIds": [
              "EXO.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 4:15"
          },
          "items": [
