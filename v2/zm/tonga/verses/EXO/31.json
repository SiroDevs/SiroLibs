        },
        {
          "text": "Mazuba aali musanu abumwi kulacitwa milimo, pele mubuzuba bwamusanu aabili mbobuzuba bwa-Sabata bwakulyokezya, buzuba busalala kuli-Jehova, Kufumbwa muntu uucita milimo mubuzuba bwa-Sabata ncobeni uleelede kufwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.15",
            "verseOrgIds": [
              "EXO.31.15"
            ]
          }
        },
