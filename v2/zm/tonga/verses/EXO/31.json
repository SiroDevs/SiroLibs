        },
        {
          "text": "Alimwi bona! Antoomwe ayooyo ndabika Aholiabu mwana wa-Ahisamaki, muntu wamusyobo wa-Dani, Alimwi mumyoyo yabasongo boonse ndabika busongo kuti bacite milimo yoonse njindakulailila: ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.6",
            "verseOrgIds": [
              "EXO.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
