                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndamuzuzya muuya wa-Leza, maanu abuuza, aluzibo lwamilimo yoonse, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.3",
            "verseOrgIds": [
              "EXO.31.3"
            ]
          }
        },
