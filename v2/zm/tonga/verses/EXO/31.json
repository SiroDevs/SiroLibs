                "loc": "EXO.36.8"
              },
              "items": [
                {
                  "text": "Kul 36:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Itente lyambunganino, abbokesi lyamulao, acuuno caluzyalo cili alindilyo, azibelesyo zyoonse zyatente, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.7",
            "verseOrgIds": [
              "EXO.31.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "antafule azibelesyo zyayo, acikazikilo cisalala camalampi azibelesyo zyaco zyoonse, acipaililo cakutentela tununkilizyo, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.8",
            "verseOrgIds": [
              "EXO.31.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "acipaililo cazituuzyo zitentwa azibelesyo zyaco zyoonse, acisambilo atako lyaco, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.9",
            "verseOrgIds": [
              "EXO.31.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "azyakusama zilukidwe, azyakusama zisalala zya-Aroni mupaizi, azyakusama zyabana bakwe zyakucitya milimo yabupaizi, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.10",
            "verseOrgIds": [
              "EXO.31.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "amafuta aakunanika, atununkilizyo tuli abweema twakubusena busalala. Zyoonse buyo nzindakulailila balazicira.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.11",
            "verseOrgIds": [
              "EXO.31.11"
            ]
          }
        }
