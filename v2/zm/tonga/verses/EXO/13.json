              "items": [
                {
                  "text": "Dt 6:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eci ciyanza cibe mbuli citondezyo cakujanza lyako na mbuli ciibalusyo akati kameso aako, nkaambo kunguzu zyajanza lyakwe Jehova wakatupozya kuzwa ku-Egepita.",
          "type": "text",
          "attrs": {
