        },
        {
          "text": "Ciyoomubeda mbuli citondezyo cakujanza lyako na mbuli ciibalusyo akati kameso aako, kuti mulao wa-Jehova ube mukanwa lyako, nkaambo Jehova wakamupozya kuzwa ku-Egepita ajanza ijumu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.9",
            "verseOrgIds": [
              "EXO.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kako uleelede kubamba ciyanza eci kuciindi ceelede myaka yoonse.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.10",
            "verseOrgIds": [
