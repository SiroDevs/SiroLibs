              "items": [
                {
                  "text": "Int 44:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo mubuzuba obo uleelede kupandulwida mwana wako kuti, Nkaambo kaceeco Jehova ncaakandicitila nendakazwa ku-Egepita. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.8",
            "verseOrgIds": [
              "EXO.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
