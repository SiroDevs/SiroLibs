        },
        {
          "text": "Lino kuciindi ciboola, mwanaako aakubuzya kuti, Nkutyeni eci? uleelede kumwaambila kuti, Kunguzu zyajanza lyakwe Jehova wakatupozya kuzwa ku-Egepita kuŋanda yabuzike. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.14",
            "verseOrgIds": [
              "EXO.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
