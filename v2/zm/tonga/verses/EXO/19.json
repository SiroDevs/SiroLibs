                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino cilundu coonse ca-Sinai cakali kuuntumuka busi, nkaambo Jehova wakaselukila mpawo mumulilo. Busi bwaco bwakali kulundumuka mbuli busi bwaceengelo, acilundu coonse cakali kukankama loko. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.18",
            "verseOrgIds": [
              "EXO.19.18"
            ]
          }
        },
        {
          "name": "verse",
