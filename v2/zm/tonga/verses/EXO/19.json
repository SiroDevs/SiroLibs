        {
          "text": "Mpawo Musa wakaakwiita bapati babantu, wabaambila majwi aya oonse Jehova ngaakamulailila. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.7",
            "verseOrgIds": [
