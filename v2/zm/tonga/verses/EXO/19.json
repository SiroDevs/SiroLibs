                {
                  "text": "Dt 4:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo Musa wakaita bantu kuti bazwe muzilao kuzooswanaana a-Leza, nkabela bakaima munsi acilundu. ",
          "type": "text",
          "attrs": {
