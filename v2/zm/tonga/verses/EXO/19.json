              "items": [
                {
                  "text": "Int 81:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino ijwi lyamweembo nelyakali kuya bukomenesya, Musa wakatalika kwaamba, alakwe Leza wakamuvwiila akudilima. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.19",
            "verseOrgIds": [
              "EXO.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova wakaselukila acilundu ca-Sinai atala lyacilundu, elyo Jehova wakaita Musa kuti atante atala lyacilundu, nkabela Musa wakatanta. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.20",
            "verseOrgIds": [
              "EXO.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
