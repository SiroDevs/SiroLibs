              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwezi watatu, bana ba-Israyeli kabazwide munyika ya-Egepita, mubuzuba obo mbubonya bakasika kunkanda ya-Sinai. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.1",
            "verseOrgIds": [
              "EXO.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo nebakazwa ku-Refidimu bakasika kunkanda ya-Sinai, akuyaka zilao zyabo oko kunkanda. Nkabela bantu bakakala-kala kunembo lyacilundu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.2",
            "verseOrgIds": [
              "EXO.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
