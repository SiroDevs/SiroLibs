                "loc": "ACT.7.38"
              },
              "items": [
                {
                  "text": "Inc 7:38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Musa wakatanta nkwaakabede Leza, Jehova wakamwiita kuzwa kucilundu, wati, Mbuboobu mboelede kwaambila luzubo lwa-Jakobo akulwiida luzubo lwa-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.3",
            "verseOrgIds": [
              "EXO.19.3"
            ]
          }
        },
