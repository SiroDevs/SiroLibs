            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.6.7"
              },
              "items": [
                {
                  "text": "2 Sam 6:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abalo bapaizi baswenenena kuli-Jehova abalisalazye, kuti Jehova ataboonzomokeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.22",
            "verseOrgIds": [
              "EXO.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Musa wakaambila Jehova kuti, Bantu tabakonzyi kutanta ano acilundu ca-Sinai, pe, nkaambo wakatulailila kuti, Amubikile cilundu migaano, citondwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.23",
            "verseOrgIds": [
              "EXO.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova wakamwaambila kuti, Koya, seluka, ukatante yebo a-Aroni. Pele bapaizi abantu boonse bataanduli inzila yakutanta kuli-Jehova pe, kuti ataboonzomokeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.24",
            "verseOrgIds": [
              "EXO.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo Musa wakaseluka, waakwaambila bantu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.25",
            "verseOrgIds": [
              "EXO.19.25"
            ]
