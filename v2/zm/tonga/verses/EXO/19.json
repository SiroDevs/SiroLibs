                  "text": "Lev 15:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Jehova wakaambila Musa kuti, Koya kubantu, ubasalazye sunu ajunza, Basanzye zyakusama zyabo, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.10",
