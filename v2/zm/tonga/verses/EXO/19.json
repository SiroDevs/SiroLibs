                  "text": "Dt 33:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "balibambile buzuba bwatatu, nkaambo mubuzuba bwatatu Jehova uyooseluka acilundu ca-Sinai mumeso aabantu boonse. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.11",
            "verseOrgIds": [
              "EXO.19.11"
            ]
          }
        },
        {
