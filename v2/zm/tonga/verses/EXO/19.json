                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela bantu boonse bakavuwa camoyo womwe kuti, Coonse buyo Jehova ncaamba tulacicita. Elyo Musa wakapilusizya Jehova majwi aabantu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.8",
