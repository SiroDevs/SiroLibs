                }
              ]
            }
          ]
        },
        {
          "text": "Lino Jehova wakaambila Musa kuti, Bona! Ndakubika ube mbuli Leza kuli-Farao, alakwe munyoko Aroni uyooba musinsimi wako. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.1",
            "verseOrgIds": [
              "EXO.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uleelede kwaamba zyoonse nzendakwaambila. Munyoko Aroni ulaambila Farao kuti aleke bana ba-Israyeli, bazwe mucisi cakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.2",
            "verseOrgIds": [
              "EXO.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
