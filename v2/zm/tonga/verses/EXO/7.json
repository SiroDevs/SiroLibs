                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele njooyumya moyo wa-Farao, aboobo njoovuzya zitondezyo zyangu amalele aangu munyika ya-Egepita. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.3",
            "verseOrgIds": [
              "EXO.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
