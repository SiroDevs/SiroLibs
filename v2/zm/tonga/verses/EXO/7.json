        {
          "text": "Lino baEgepita bayooziba kuti ndime Jehova nenjootandabika ijanza lyangu ku-Egepita akupozya bana ba-Israyeli kuzwa akati kabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.5",
            "verseOrgIds": [
              "EXO.7.5"
            ]
          }
        },
        {
