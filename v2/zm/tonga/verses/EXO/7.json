          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo ba-Musa a-Aroni bakacita obo. Bakacita mbubonya mbuli Jehova mbwaakabalailila. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.6",
