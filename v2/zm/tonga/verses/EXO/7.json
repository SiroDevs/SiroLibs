              "items": [
                {
                  "text": "10:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Farao uyookaka kumumvwa, aboobo njoobika ijanza lyangu ku-Egepita, nkabela njoopozya impi zyangu abantu bangu bana ba-Israyeli kuzwa kunyika ya-Egepita ambeta impati. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.4",
            "verseOrgIds": [
              "EXO.7.4"
            ]
          }
        },
