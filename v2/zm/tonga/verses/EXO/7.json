                  "text": "Tus 29:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo Farao wakafutamuka, wanjila muŋanda yakwe, katabiki moyo wakwe kumakani aya. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.23",
            "verseOrgIds": [
              "EXO.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela ba-Egepita boonse bakali kusya mikalo yakunywa maanzi kumbali alwizi, nkaambo bakakacilwa kunywa maanzi aamulwizi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.24",
            "verseOrgIds": [
              "EXO.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo kwakamana mazuba aali musanu aabili, Jehova naakamana kusofwaazya lwizi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.25",
