              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakawaala umwi aumwi musako wakwe ansi, elyo yakaba inzoka. Pele musako wa-Aroni wakamena misako yabo yoonse. ",
          "type": "text",
          "attrs": {
