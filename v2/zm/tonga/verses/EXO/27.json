          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.38.9"
              },
              "items": [
                {
                  "text": "Kul 38:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.100.4"
              },
              "items": [
                {
                  "text": "Int 100:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi ukacite lubuwa lwacikombelo. Kulubazu lwakumusanza lube amasani aalukidwe kabotu aalengelela. Bulamfu bwakulubazu lomwe bube tukokola tuli mwanda. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.9",
            "verseOrgIds": [
              "EXO.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Misumpululu ibe makumi obile, azyalo zikazikilo zyayo zibe makumi obile; zibe zyamukuba, pele manembe aamisumpululu aminkulu yayo zyoonse zibe zyansiliva. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.10",
            "verseOrgIds": [
              "EXO.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwalo kulubazu lwakunyika kube masani aalengelela aali abulamfu bwatukokola tuli mwanda; misumpululu ibe makumi obile azikazikilo zyayo zibe makumi obile; zibe zyamukuba, pele manembe aamisumpululu aminkulu yayo zyoonse zibe zyansiliva. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.11",
            "verseOrgIds": [
              "EXO.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akulubazu lwakumbo kube masani aalengelela aali abulamfu bwatukokola tuli makumi osanwe; misumpululu ibe ikumi, azikazikilo zyayo zibe ikumi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.12",
            "verseOrgIds": [
              "EXO.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akulubazu lwakujwe bwaamba bwalubuwa bube tukokola tuli makumi osanwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.13",
            "verseOrgIds": [
              "EXO.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuntu kulengelela masani kulubazu lumwi lwamulyango kube abulamfu bwatukokola tuli ikumi amusanu; misumpululu yakooko ibe yotatwe, azikazikilo zyayo zibe zyotatwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.14",
            "verseOrgIds": [
              "EXO.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwalo kuntu kulengelela masani kulubazu lwabili lwamulyango kube abulamfu bwatukokola tuli ikumi amusanu; misumpululu yakooko ibe yotatwe, azikazikilo zyayo zibe zyotatwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.15",
            "verseOrgIds": [
              "EXO.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amulyango walubuwa ube acisitilizyo cili abulamfu bwatukokola tuli makumi obile, camasani aanyanzabili amasani aakamwemvwe amasani aasalala pyu amasani aalukidwe kabotu, masani aamanyengwe-manyengwe. Misumpululu yawo ibe yone, azikazikilo zyayo zibe zyone. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.16",
            "verseOrgIds": [
              "EXO.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Misumpululu yoonse yakulubuwa kumabazu oonse ibe aminkulu yansiliva; manembe aayo abe ansiliva, azikazikilo zyayo zibe zyamukuba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.17",
            "verseOrgIds": [
              "EXO.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bulamfu bwalubuwa bube tukokola tuli mwanda, bwaamba bube tukokola tuli makumi osanwe, abwiime bube tukokola tosanwe. Lube amasani aalengelela aalukidwe kabotu, azikazikilo zyamukuba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.18",
            "verseOrgIds": [
              "EXO.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azibelesyo zyamilimo yoonse yacikombelo, amanembe aaco, amanembe oonse aalubuwa, zyoonse zibe zyamukuba,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.19",
            "verseOrgIds": [
              "EXO.27.19"
            ]
          }
        }
      ]
    },
