                  "text": "Ezk 43:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi ucite cipaililo camuunga; bulamfu bwaco bube tukokola tosanwe, abwaamba bwaco bube tukokola tosanwe; cipaililo cibe azyooko zyone, zyoonse zileelene; abwiime bwaco bube tukokola totatwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.1",
            "verseOrgIds": [
              "EXO.27.1"
            ]
          }
        },
        {
