                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.44"
              },
              "items": [
                {
                  "text": "Inc 7:44",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yaka cipaililo cifokokede amapulanga. Kociyaka mbubonya mbowakatondezegwa mucilundu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.8",
            "verseOrgIds": [
              "EXO.27.8"
            ]
          }
        }
      ]
    },
