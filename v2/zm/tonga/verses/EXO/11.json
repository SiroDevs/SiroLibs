              "items": [
                {
                  "text": "Am 5:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kuyooba kulila kupati munyika yoonse ya-Egepita kutanabwenwe, alimwi takukooyooba limbi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.6",
            "verseOrgIds": [
              "EXO.11.6"
            ]
          }
        },
