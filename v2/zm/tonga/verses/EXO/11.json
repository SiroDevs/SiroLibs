              "items": [
                {
                  "text": "Mal 3:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele bana ba-Israyeli, takukooyooba naba mubwa uubavulumina, naba muntu naba munyama, mukazibe kuti Jehova waanzaanya ba-Egepita aba-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.7",
            "verseOrgIds": [
              "EXO.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba balanda bako boonse bayooza kukundikotamina, cakuti, Zwa, yebo abantu boonse bakutobela, Kusule lyayaaya njoozwa. Mpawo wakazwa kuli-Farao kafundilide bukali. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.8",
            "verseOrgIds": [
              "EXO.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Jehova wakaambila Musa kuti, Farao takooyooswiilila pe, kuti maleele aangu avule munyika yaEgepita.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.9",
            "verseOrgIds": [
              "EXO.11.9"
            ]
          }
        }
