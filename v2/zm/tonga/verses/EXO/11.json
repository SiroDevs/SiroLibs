        },
        {
          "text": "Elyo Musa wakati, Mbuboobu mbwaamba Jehova. Mbuli akati kamalangasiku ndainda munyika ya-Egepita, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.4",
            "verseOrgIds": [
