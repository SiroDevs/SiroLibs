                "loc": "EXO.12.35"
              },
              "items": [
                {
                  "text": "12:35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino amba mumatwi aabantu kuti bakumbile, mwaalumi umwi aumwi kumweenzinyina, amwanakazi umwi aumwi kumweenzinyina, zintu zyansiliva azintu zyangolida. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.2",
            "verseOrgIds": [
              "EXO.11.2"
            ]
          }
        },
