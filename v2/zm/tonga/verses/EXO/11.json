              "attrs": {
                "loc": "AMO.4.10"
              },
              "items": [
                {
                  "text": "Am 4:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nkabela bana bataanzi boonse bamucisi ca-Egepita balafwa, kuzwa kumwana mutaanzi wa-Farao uukede acuuno cabwami kusikila kumwana mutaanzi wamwanakazi muzike sikuziya, abalo bana bataanzi boonse baŋombe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.5",
            "verseOrgIds": [
              "EXO.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
