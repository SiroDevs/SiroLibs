              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Jehova wakaambila Musa kuti, Nciletela Farao aba-Egepita euumo comwe, Camana buyo eco, uyoomuleka kuti mupole okuno, Amuleka buyo ncobeni uyoomutandilila kuzwa okuno. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.1",
            "verseOrgIds": [
              "EXO.11.1"
            ]
          }
        },
