                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Jehova wakapa bantu luzyalo mumeso aaba-Egepita. Alakwe oyo muntu Musa kali mulemu loko munyika ya-Egepita mumeso aabalanda ba-Farao amumeso aabantu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.3",
            "verseOrgIds": [
              "EXO.11.3"
            ]
          }
        }
