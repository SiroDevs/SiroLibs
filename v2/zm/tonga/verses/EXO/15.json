        {
          "text": "Mpoonya awo Miriamu musinsimi, mucizi wa-Aroni, wakabweza insaka mujanza lyakwe, abanakazi boonse bakamutobela ansaka akuzyana. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.20",
            "verseOrgIds": [
