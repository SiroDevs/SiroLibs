                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino umwi mwaalumi waluzubo lwa-Levi wakaakukwata mwana musimbi wa-Levi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.1",
            "verseOrgIds": [
              "EXO.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.20"
              },
              "items": [
                {
                  "text": "Inc 7:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.23"
              },
              "items": [
                {
                  "text": "Heb 11:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela oyo mwanakazi wakaminta, wazyala mwana mulombe. Abone kuti mubotu, wakamusisa myezi yotatwe ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.2",
            "verseOrgIds": [
              "EXO.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo naatakacili kukonzya kumusisa, wakabweza cinzuma camatete, wacisyungulula abulongo abunzuka, wabika mwana mulincico, wacibika akati kamatete kunkomwe yalwizi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.3",
            "verseOrgIds": [
              "EXO.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.15.20"
              },
              "items": [
                {
                  "text": "Kul 15:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.26.59"
              },
              "items": [
                {
                  "text": "My 26:59",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela mucizi wakwe kaimvwi kulekule kuti abone cisi citike kulinguwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.4",
            "verseOrgIds": [
              "EXO.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.21"
              },
              "items": [
                {
                  "text": "Inc 7:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo mwana musimbi wa-Farao wakeza kuzoosamba kulwizi, abalanda bakwe basimbi bakali kweenda kumbali lyalwizi. Lino wakabona cinzuma akati kamatete, watuma mulanda wakwe musimbi, wacibweza. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.5",
            "verseOrgIds": [
              "EXO.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo naakacivununa, wakabona mwana, nkabela mulombe wakali kulila. Mpoonya awo wakamufwida luzyalo, wati, Nguumwi wabana baba-Hebrayo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.6",
            "verseOrgIds": [
              "EXO.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mucizi wakwe wakaambila mwana wa-Farao kuti, Sa njiinke kuyookuyandawida sikumulela akati kabanakazi ba-hebrayo, kuti akulelele mwana? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.7",
            "verseOrgIds": [
              "EXO.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana wa-Farao wakamuvwiila kuti, Koya. Mpawo musimbi wakaya, waita banyina mwana. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.8",
            "verseOrgIds": [
              "EXO.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela mwana wa-Farao wakamwaambila kuti, Bweza oyu mwana, undilelele; nookuvozya mali, Lino mwanakazi wakabweza mwana, waakumulela. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.9",
            "verseOrgIds": [
              "EXO.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.21"
              },
              "items": [
                {
                  "text": "Inc 7:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aboobo mwana wakakula, nkabela wakamubweedezya kumwana wa-Farao. Wakaba mwana wakwe. Nkabela wakamuulika izina lya-Musa, nkaambo wakati, Ndakamununa mumaanzi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.10",
            "verseOrgIds": [
              "EXO.2.10"
            ]
          }
        }
      ]
    },
