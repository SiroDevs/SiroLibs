                  "text": "31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo Jetero syanyinazyala Musa wakatolela Leza cipaizyo azituuzyo, nkabela ba-Aroni abapati boonse baIsrayeli bakeza kuzoolya insima asyanyinazyala Musa kunembo lya-Leza,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.12",
            "verseOrgIds": [
              "EXO.18.12"
            ]
          }
        }
