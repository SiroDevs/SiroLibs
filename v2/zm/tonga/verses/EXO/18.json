      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino jetero mupaizi waku-Midyani, syanyinazyala Musa, wakamvwa makani oonse Leza nga aka citila Musa aba-Israyeli bantu bakwe, Wakamvwa makani aa-Jehova mbwaakapozya ba-Israyeli kuzwa ku-Egepita. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.1",
            "verseOrgIds": [
              "EXO.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.2.21+EXO.2.22"
              },
              "items": [
                {
                  "text": "Kul 2:21-22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo jetero syanyinazyala Musa wakatolelela Zipora, mwanakazi wa-Musa, Musa naakamupilusizye, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.2",
            "verseOrgIds": [
              "EXO.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.29"
              },
              "items": [
                {
                  "text": "Inc 7:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "abana bakwe bobile, Izine lyamwana umwi kali Gerisomu (nkaambo wakati, Ndakali mweenzu mucisi cabantu), ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.3",
            "verseOrgIds": [
              "EXO.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "azina lyawabili kali Eliezere (nkaambo wakati, Leza wataata nguwakandigwasya, wakandivuna kupanga lya-Farao). ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.4",
            "verseOrgIds": [
              "EXO.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Jetero syanyinazyala Musa abana bakwe amwanakazi wakwe bakasika kuli-Musa, kunkanda nkwaakakede kucilundu ca-Leza. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.5",
            "verseOrgIds": [
              "EXO.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino wakatumina Musa mulazyo wakuti, Mebo nde-Jetero syanyokozyala ndeza kulinduwe, ndeza abanako abana bako bobile. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.6",
            "verseOrgIds": [
              "EXO.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amvwe obo Musa wakainka kuyoobaswana syanyinazyala, wamukotamina, wamumyonta, Lino bakajuzyanya, banjila mutente. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.7",
            "verseOrgIds": [
              "EXO.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Musa wakaambila syanyinazyala zintu zyoonse Jehova nzyaakacitila Farao aba-Egepita kukugwasya ba-Israyeli, amapenzi oonse ngebakajana munzila, a-Jehova mbwaakabavuna. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.8",
            "verseOrgIds": [
              "EXO.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Jetero wakakondwa kumvwa milimo mibotu yoonse Jehova njaakacitila ba-Israyeli kukubavuna kumaanza aaba-Egepita.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.9",
            "verseOrgIds": [
              "EXO.18.9"
            ]
          }
        }
      ]
    },
