          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino jetero wakati, Alumbwe Jehova iwakamuvuna kumaanza aabaEgepita akumaanza aa-Farao. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.10",
