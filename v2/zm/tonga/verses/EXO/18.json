              "items": [
                {
                  "text": "My 36:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na balijisi makani baleza kulindime. Ndime embeteka makani aamuntu umwi aumwi amweenzinyina. Alimwi ndime embazibya imbeta zya-Leza amilao yakwe, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.16",
            "verseOrgIds": [
              "EXO.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele syanyinazyala Musa wakamwaambila kuti, Eci ncocita tacili cibotu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.17",
            "verseOrgIds": [
              "EXO.18.17"
            ]
          }
        },
        {
