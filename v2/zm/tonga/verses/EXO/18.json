              "items": [
                {
                  "text": "Lk 1:51",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino ndazibisya kuti Jehova mupati kwiinda baleza boonse, nkaambo wakavuna bantu bakwe kumaanza aabaEgepita nebakabacitila cakulisumpula. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.11",
            "verseOrgIds": [
              "EXO.18.11"
            ]
          }
        },
        {
