                {
                  "text": "12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ncobeni ulalijaya, yebo abantu mboli abo, nkaambo makani akulemena; tokonzyi kwaacita olike pe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.18",
