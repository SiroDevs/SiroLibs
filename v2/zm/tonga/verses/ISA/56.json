                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbuboobu mbwaamba Mwami Jehova uubunganya batandidwe bacisi ca-Israyeli. Nzoobunganya kulinguwe abamwi kutaamba abo babungikidwe kale.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.8",
            "verseOrgIds": [
              "ISA.56.8"
