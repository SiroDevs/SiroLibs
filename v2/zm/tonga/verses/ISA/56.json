        },
        {
          "text": "Muŋanda yangu amukati kamalambo aangu njoobapa ciibalusyo azina ibotu kwiinda bana balombe abasimbi. Njoobapa izina litamani litakonzya kuloba. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.5",
            "verseOrgIds": [
              "ISA.56.5"
            ]
          }
