                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uli acoolwe muntu uucita obo ayooyo uubika moyo wakwe kumakani, uulikasya kusofwaazya buzuba bwa-Sabata akukasya maanza aakwe kucita bubi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.2",
            "verseOrgIds": [
