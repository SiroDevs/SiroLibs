              "items": [
                {
                  "text": "Mt 15:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.3.2"
              },
              "items": [
                {
                  "text": "Flp 3:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basikulindila bakwe mboofu, boonse babula luzibo, boonse mba bwa bataambi batezi kukuwa. Balalota buyo, baloona, balayandisya ŋonzi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.10",
            "verseOrgIds": [
              "ISA.56.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 56:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba babwa mbasyacivulamwangu, tabakonzyi kukuta. Abalo beembeli tabaswiilili, batola umwi aumwi inzila yakwe mwini, boonse buyo balayeeya kulijanina impindu buyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.11",
            "verseOrgIds": [
              "ISA.56.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 56:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bati, Amuboole, tulete bukoko, tunywe cakukolwa. Alyalo junza liyooba mbubonya mbuli buzuba obuno, buzuba bupati loko.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.12",
            "verseOrgIds": [
