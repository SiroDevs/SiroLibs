                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alakwe muzwakule uuliswangaanya a-Jehova ataambi kuti, Ncobeni Jehova ulandaandaanya abantu bakwe, Alakwe muzibe ataambi kuti, Mebo ndi musamu uuyumide buyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.3",
            "verseOrgIds": [
              "ISA.56.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 56:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo mbuboobu Jehova mbwaambila bazibe balemeka masabata aangu akusala zintu zindibotezya akujatisya cizuminano cangu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.4",
            "verseOrgIds": [
              "ISA.56.4"
            ]
          }
        },
