        },
        {
          "text": "Nubanyama boonse bamusokwe amuboole kuzoolya. Nubanyama boonse bamuzisaka amuboole. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.9",
            "verseOrgIds": [
              "ISA.56.9"
            ]
          }
        },
        {
