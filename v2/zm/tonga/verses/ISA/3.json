                "loc": "JER.14.2"
              },
              "items": [
                {
                  "text": "Jer 14:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LAM.1.4"
              },
              "items": [
                {
                  "text": "Malo 1:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Milyango yakwe iyoolila akoomoka, nkabela uyoosaalwa akukala ansi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.26",
            "verseOrgIds": [
