              "items": [
                {
                  "text": "Zef 3:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.1.11"
              },
              "items": [
                {
                  "text": "Mal 1:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kuciindi eco Jehova wamakamu uyooletelelwa mutelo kuzwa kumusyobo wabantu balamfu banjelema, bantu ibakali kuyoosya lyoonse kuzwa kumatalikilo, musyobo singuzu uuya bulyataula zisi, bantu bali anyika iiandawidwe tulonga-longa, Uyooletwa kubusena bwazina lya-Jehova wamakamu, kucilundu ca-Ziyoni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.7",
            "verseOrgIds": [
              "ISA.18.7"
            ]
          }
        }
      ]
