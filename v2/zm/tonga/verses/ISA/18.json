              },
              "items": [
                {
                  "text": "Zef 2:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maawe! Nyika yakusokonya kwamababa iili kutala lyamilonga yaEtiopiya! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.1",
            "verseOrgIds": [
              "ISA.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilatuma batumwa alwizi mumaato aamatete aaenda atala lyamaanzi. Ilati, Kamuya, nubatumwa basiluno, kumusyobo wabantu balamfu banjelema, bantu ibakali kuyoosya lyoonse kuzwa kumatalikilo, musyobo singuzu uuya bulyataula zisi, bantu bali anyika iiandawidwe tulonga-longa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.2",
            "verseOrgIds": [
              "ISA.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubantu boonse banyika, nyoonse nomukede ansi, citondezyo niciyoosumpulwa atala lyazilundu, amubone; mweembo nuuyoolizigwa, amuswiilile. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.3",
            "verseOrgIds": [
              "ISA.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kkaambo mbuboobu Jehova mbwaakandaambila. Nkaumune, nkalange mucikalilo cangu, mbuli mumuni wazuba uubekabeka, mbuli ijoba lyamume mukati kankasaalo yakutebula. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.4",
            "verseOrgIds": [
              "ISA.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo nibatana kutebula, malubaluba naamana, micelo yamusaansa niitalika kubizwa, uyoogonka tumintenga azizibyo, ayalo mitabi iiyandabede uyooitenda akwiisowa, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.5",
            "verseOrgIds": [
              "ISA.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo iyoosiilwa bayuni bapati bamuzilundu abanyama bamusokwe. Bayuni bapati bayoosaninwa njiyo ciindi cacilimo, abalo banyama bamusokwe bayoosaninwa njiyo ciindi campeyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.6",
            "verseOrgIds": [
              "ISA.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
