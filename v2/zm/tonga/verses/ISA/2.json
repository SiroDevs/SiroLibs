        },
        {
          "text": "Kumamanino aaciindi cilundu caŋanda ya-Jehova ciyooimikwa atala lyazilundu akusumpulwa kwiinda tulundulundu toonse, nkabela masi oonse anooya bukunka kulincico. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.2",
            "verseOrgIds": [
              "ISA.2.2"
            ]
          }
        },
        {
          "name": "verse",
