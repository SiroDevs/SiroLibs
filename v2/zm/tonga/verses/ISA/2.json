              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "O luzubo lwa-Jakobo, amuboole, tweende mumumuni wa-Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.5",
            "verseOrgIds": [
              "ISA.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.18.14"
              },
              "items": [
                {
                  "text": "Dt 18:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo wabaleka bantu bako baluzubo lwa-Jakobo, nkaambo kakuti bazula ziyanza zyakujwe, alimwi mbasondi mbuli ba-Filisti, alimwi balatanga mulongo abana babeenzu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.6",
            "verseOrgIds": [
              "ISA.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyika yabo ilizwide insiliva angolida; zintu zyabo ziyandisi tazibaliki. Nyika yabo ilizwide mabbiza, azyalo inkalaki zyabo tazibaliki. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.7",
            "verseOrgIds": [
              "ISA.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyika yabo ilizwide zikozyano zyamituni; balakomba milimo yamaanza aabo beni azintu minwe yabo beni nziyakapanga. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.8",
            "verseOrgIds": [
              "ISA.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu mutengwana ulakotama, alakwe mupati ulalibombya. Nkaambo kako utabalubi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.9",
            "verseOrgIds": [
              "ISA.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.6.15"
              },
              "items": [
                {
                  "text": "Ciy 6:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.1.9"
              },
              "items": [
                {
                  "text": "2 Tes 1:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Njila mukati kamandomba, koyuba mulusuko, kuzwa kukuyoowegwa kwa-Jehova abulemu bwabupati bwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.10",
            "verseOrgIds": [
              "ISA.2.10"
            ]
          }
        },
