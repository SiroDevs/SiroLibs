          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.8.21"
              },
              "items": [
                {
                  "text": "Zek 8:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.24.47"
              },
              "items": [
                {
                  "text": "Lk 24:47",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Misyobo minji inooya bwaamba kuti, Atwiinke, tukaye kucilundu ca-Jehova, kuŋanda ya-Leza wa-Jakobo, elyo uyootwiisya inzila zyakwe, nkabela tuyooenda muziyanza zyakwe. Nkaambo mu-Ziyoni muyuozwa mulao, alyalo ijwi lya-Jehova liyoozwa mu-Jerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.3",
            "verseOrgIds": [
              "ISA.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
