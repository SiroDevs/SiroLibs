                "loc": "HOS.2.18"
              },
              "items": [
                {
                  "text": "Hos 2:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela uyoobeteka akati kamasi akukosola makani aamisyobo minji, Lino bayoofula mapanga aabo abe maamba aakulimya, amasumo aabo abe zizibyo zyamisamu. Cisi tacikooyoobweza ipanga lyakulwisya cisinyina. Tabakooyooiya inkondo limbi pe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.4",
            "verseOrgIds": [
              "ISA.2.4"
            ]
          }
        }
      ]
    },
    {
