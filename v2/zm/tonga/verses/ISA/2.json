                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kulisumpula kwamuntu kuyoobombesegwa, akulilemeka kwabantu kuyoosisigwa ansi. Jehova alike nguuyoolemekwa mubuzuba obo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.11",
            "verseOrgIds": [
              "ISA.2.11"
            ]
          }
        }
      ]
