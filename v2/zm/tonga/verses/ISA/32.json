            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayo makani ayooba mane lumwi tukatililwe Muuya kuzwa kujulu, elyo inkanda iyooba muunda wambolezi, awalo muunda wambolezi uyooyeeyegwa kuti ndusaka. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.15",
            "verseOrgIds": [
              "ISA.32.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 32:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.8.3"
              },
              "items": [
                {
                  "text": "Zek 8:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino lubeta lubotu luyookala munkanda, abululami buyookalilila mumuunda wambolezi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.16",
            "verseOrgIds": [
              "ISA.32.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 32:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
