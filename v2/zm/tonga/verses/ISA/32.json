                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.2.14"
              },
              "items": [
                {
                  "text": "Lk 2:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela milimo yabululami iyooba luumuno, acilenge cabululami ciyooba luumuno alusyomo lutamani. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.17",
            "verseOrgIds": [
              "ISA.32.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 32:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu bangu bayookala mucikalilo caluumuno amumaanda aalusyemo amumasena aacilyokezezyo aakuliiba. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.18",
            "verseOrgIds": [
              "ISA.32.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 32:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.11.2"
              },
              "items": [
                {
                  "text": "Zek 11:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele lusaka niluyootemwa kuyooloka civulamabwe, elyo kufwinsigwa munzi uyoofwinsigwa ncobeni. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.19",
            "verseOrgIds": [
              "ISA.32.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 32:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.30.24"
              },
              "items": [
                {
                  "text": "Is 30:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Muli acoolwe inywe numubyala kumbali lyamaanzi oonse akutuma nkuko myeendo yabasune ayambongolo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.20",
            "verseOrgIds": [
