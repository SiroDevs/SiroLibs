              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inywe nubanakazi baliibide, amubuke, muswiilile ijwi lyangu, Nubasimbi batalipenzyi amumvwe majwi aangu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.9",
            "verseOrgIds": [
              "ISA.32.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamana mwaka akaindi buyo, muyookankama inywe nubanakazi batalipenzyi, nkaambo misaansa tiikooyootebulwa, tamukooyoojana micelo yabutebuzi pe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.10",
            "verseOrgIds": [
              "ISA.32.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 32:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amuyoowesye nubanakazi baliibide! Amukankame inywe nubatapengede! Amusamunune, mube acinswe. Amusame zisani zyamasaka muzikungu zyanu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.11",
            "verseOrgIds": [
              "ISA.32.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 32:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amulyuume azyamba zyanu cakulila myuunda mibotu amasaansa aazyala micelo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.12",
            "verseOrgIds": [
              "ISA.32.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 32:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.9.6"
              },
              "items": [
                {
                  "text": "Hos 9:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anyika yabantu bangu ayoomena mamvwa amitubetube buyo. Ayoomena atala lyamaanda oonse aakukondwa mumunzi wabusekelezi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.13",
            "verseOrgIds": [
              "ISA.32.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 32:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo iŋanda yabwami iyoolekwa. Munzi uuli abantu banji uyooba itongo, Cilundu ca-Ofeli aŋanda yakulangilila, zyoonse ziyooba malyango aabanyama mazuba oonse mane kukabe kutamani. Ziyooba butelo bwambongolo zyamusokwe amacelelo aamatanga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.14",
            "verseOrgIds": [
              "ISA.32.14"
            ]
          }
        }
      ]
    },
