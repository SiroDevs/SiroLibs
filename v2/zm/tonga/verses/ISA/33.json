            "verseOrgIds": [
              "ISA.33.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.18.18"
              },
              "items": [
                {
                  "text": "2 Bam 18:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amuswiilile basilumamba babo mbubalila anze! Batumwa baluumuno balalila loko. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.7",
            "verseOrgIds": [
              "ISA.33.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.5.6"
              },
              "items": [
                {
                  "text": "Bab 5:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.18.14"
              },
              "items": [
                {
                  "text": "2 Bam 18:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Migwagwa yabula bantu, basilweendo tababoneki limbi. Wajaya cizuminano, wasampaula minzi, talemeki bantu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.8",
            "verseOrgIds": [
              "ISA.33.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyika ilalila, ilanyana. Lebano wafwa insoni, wapusama. Saroni waba inkanda buyo. Ku-Basana aku-Karimeli misamu yoonse yatikinizigwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.9",
            "verseOrgIds": [
              "ISA.33.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.36"
              },
              "items": [
                {
                  "text": "Dt 32:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.43"
              },
              "items": [
                {
                  "text": "43",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.12.5"
              },
              "items": [
                {
                  "text": "Int 12:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.42.13"
              },
              "items": [
                {
                  "text": "Is 42:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.42.14"
              },
              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEP.3.8"
              },
              "items": [
                {
                  "text": "Zef 3:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Jehova wati, Ndabuka, nkasumpulwe, nkalemekwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.10",
            "verseOrgIds": [
              "ISA.33.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muyoominta buungu, muyoozyala zisikosiko buyo. Luyooyo lwanu luyooba mulilo wakumutenta, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.11",
            "verseOrgIds": [
              "ISA.33.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu bayooba mbuli kutentwa kwamulambo, mbuli mamvwa aagonkedwe aatentwa mumulilo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.12",
            "verseOrgIds": [
              "ISA.33.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.12",
            "verseOrgIds": [
              "ISA.33.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inywe nemuli kule, amuswiilile ncindacita. Anywebo nemuli kufwaafwi, amuzibe inguzu zyangu mbuzibede. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.13",
            "verseOrgIds": [
              "ISA.33.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basizibi bamu-Zioni balayoowa, basimasampu bajatwa kukankama. Nguni akati kesu uuti kale amulilo uutentesya? Nguni akati kesu uuti kale akutentwa kutamani? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.14",
            "verseOrgIds": [
              "ISA.33.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo uuenda mubululami, uuamba zintu ziluleme, uusampaula impindu iizwa kukupenzya bantu, uukaka kutambula masinkamulomo, uusinka matwi aakwe kuti atamvwi makani aabulowa, akufwinya meso aakwe kuti atalangi bubi, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.15",
            "verseOrgIds": [
              "ISA.33.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngonguwe uuti kale kujulu. Macijilo aakwe ayooba mampangala aasyomeka aamumandomba, Cilyo cakwe uyoocipegwa, amaanzi aakwe akunywa taakooyoobulika. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.16",
            "verseOrgIds": [
              "ISA.33.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meso aako ayoobona mwami mubweebesi bwakwe, ayoobona cisi cakwe citandabede kule. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.17",
            "verseOrgIds": [
              "ISA.33.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.1.20"
              },
              "items": [
                {
                  "text": "1 Kor 1:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Moyo wako nuuyeeya bantu ibakayoosya, uyoolibuzya kuti, Ino uli kuli mabbalani? Uli kuli oyo iwakali kupimya mali aamutelo? Uli kuli oyo iwakali kubala maanda malamfu? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.18",
            "verseOrgIds": [
              "ISA.33.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 33:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.5.15"
              },
              "items": [
                {
                  "text": "Jer 5:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tokooyoobona limbi bantu bakali, bantu abo baamba mwaambo muyumu ngotamvwi, mulaka mweenzu ngotakonzyi kuswiililisya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.19",
            "verseOrgIds": [
              "ISA.33.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pe! Langa Zioni munzi wamapobwe esu. Meso aako ayoobona Jerusalemu, cikalilo cakuliiba, itente litatuntuliki litanonkwedwa abuniini manembe aalyo, azyalo intambo zyalyo tazinunsuki. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.20",
            "verseOrgIds": [
              "ISA.33.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 33:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.2.5"
              },
              "items": [
                {
                  "text": "Zek 2:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo oko Jehova Mulemu uyootubeda mucibaka camilonga iikwazeme atulongalonga. Oko takukooyooinda bwaato bukwasulwa ankasi niciba cikwepe cilemu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.21",
            "verseOrgIds": [
              "ISA.33.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 33:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.44.4"
              },
              "items": [
                {
                  "text": "Int 44:4",
                  "type": "text"
                }
