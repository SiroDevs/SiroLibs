              "attrs": {
                "loc": "REV.13.10"
              },
              "items": [
                {
                  "text": "Ciy 13:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maawe kulinduwe, webo owakasaala bamwi pele tonasaalidwe omwini, owakacitila bamwi bumpele pele tabana kukucitila bumpele yebo. Wamana kusaala uyoosaalwa omwini, waleka kucita bumpele uyoocitilwa bumpele ayebo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.1",
            "verseOrgIds": [
              "ISA.33.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "O Jehova, kotufwida luzyalo, nkaambo twali kululangila. Koba kuboko kwesu zifumo zyoonse alufutuko lwesu kuciindi camapenzi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.2",
            "verseOrgIds": [
              "ISA.33.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lupyopyongano mbulwamvwigwa bamasi bacija. Mbowalibusya bantu bamwaika. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.3",
            "verseOrgIds": [
              "ISA.33.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo imbono zilasaalwa mbubasaala bacamusokonya; bantu balasotoka alinzizyo mbuzisotoka zisozi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.4",
            "verseOrgIds": [
              "ISA.33.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.97.9"
              },
              "items": [
                {
                  "text": "Int 97:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jehova ulisumpwidwe, nkaambo ulakala kujulu. Ulazuzya Zioni lubeta abululami. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.5",
            "verseOrgIds": [
              "ISA.33.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.1.7"
              },
              "items": [
                {
                  "text": "Tus 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.33"
              },
              "items": [
                {
                  "text": "Mt 6:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uyooba kusyomeka kwaziindi zyako. Lufutuko abusongo aluzibo, zyoonse ziyoovula. Kulemeka Jehova nee cintu cakwe ciyandisi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.6",
            "verseOrgIds": [
              "ISA.33.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
