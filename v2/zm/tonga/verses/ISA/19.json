              },
              "items": [
                {
                  "text": "Jer 46:2-26",
                  "type": "text"
                }
              ]
            },
            {
              "text": "Ezk 29:1–32:32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaaya makani aasinsimwa aa-Egepita. Amubone! Jehova uleza ulitantide ajoba lyaluno, ulanjila mu-Egepita, elyo zikozyano zyamituni zya-Egepita ziyookankama kubusyu bwakwe, nkabela moyo wa-Egepita uyooenzunuka mukati kaco. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.1",
            "verseOrgIds": [
              "ISA.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.7.22"
              },
              "items": [
                {
                  "text": "Bab 7:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.14.16"
              },
              "items": [
                {
                  "text": "1 Sam 14:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.20.23"
              },
              "items": [
                {
                  "text": "2 Mak 20:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela njoobusya ba-Egepita kuti balwisye ba-Egepitanyina. Bayoolwana, umwi aumwi amuzyalwenyina, umwi aumwi amweenzinyina. Munzi uyoolwisya munzinyina, acisi ciyoolwisya cisinyina. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.2",
            "verseOrgIds": [
              "ISA.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moyo wa-Egepita uyooata mucamba cakwe, amakanze aakwe oonse njooapilinganya. Elyo bayoobika myoyo yabo kumituni akubasondi akubasibusangu akubalozi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.3",
            "verseOrgIds": [
              "ISA.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino njooaba ba-Egepita mumaanza aamwami muyumu. Mwami mukali uyoobaendelezya, mbwaamba Mwami Jehova wamakamu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.4",
            "verseOrgIds": [
              "ISA.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.51.36"
              },
              "items": [
                {
                  "text": "Jer 51:36",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.30.12"
              },
              "items": [
                {
                  "text": "Ezk 30:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo maanzi aakulwizi ayoomana, amulonga uyooleka kweenda, uyooyuminina. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.5",
            "verseOrgIds": [
              "ISA.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.19.24"
              },
              "items": [
                {
                  "text": "2 Bam 19:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Milonga iyoonunka. Tulongalonga twa-Egepita tuyoomaninwa maanzi mane tukayuminine. Matete amalelebu oonse ayoobola. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.6",
            "verseOrgIds": [
              "ISA.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafulo aakulwizi, kunkomwe yalwizi, azyoonse zibyalidwe kulwizi, zyoonse ziyooyuminina, ziyootandwa mane tazikooyooba limbi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.7",
            "verseOrgIds": [
              "ISA.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalo basikuzuba bayoolila, aboonse bawaala tulobyo mulwizi bayoopenga, abaabo bateya tunyandi mumaanzi bayoofwaba. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.8",
            "verseOrgIds": [
              "ISA.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo babeleka milimo yabutonje abaabo bapesa masani aatuba, boonse bayoousa insoni. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.9",
            "verseOrgIds": [
              "ISA.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Minsemu yakwe iyoopwayaulwa, aboonse babelekela mali bayoousa mumyoyo yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.10",
            "verseOrgIds": [
              "ISA.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basilutwe ba-Zoani mbafubafuba buyo. Basinkuta bacenjede ba-Farao, lulayo lwabo lwasampuka. Uyooambila buti Farao kuti, Ndi mwana wabasongo, mwami wabami baciindi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.11",
            "verseOrgIds": [
              "ISA.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.41.22"
              },
              "items": [
                {
                  "text": "Is 41:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.41.23"
              },
              "items": [
                {
                  "text": "23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.22"
              },
              "items": [
                {
                  "text": "Inc 7:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.1.20"
              },
              "items": [
                {
                  "text": "1 Kor 1:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "No bali kuli basongo bako? Bakulwiide, bazibe makani Jehova wamakamu ngaakanzide aa-Egepita. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.12",
            "verseOrgIds": [
              "ISA.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.2.16"
              },
              "items": [
                {
                  "text": "Jer 2:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.9.6"
              },
              "items": [
                {
                  "text": "Hos 9:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basilutwe ba-Zoani bafubaala, basilutwe ba-Nefi baenwa. Bami bamikowa yakwe mbobamuleesya Egepita munzila. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.13",
            "verseOrgIds": [
              "ISA.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova wavwelenganya miyeeyo yamyoyo yabo alweeno, aboobo balaleesya Egepita mumilimo yakwe yoonse mbubonya mbuli mukolwi mbwapampalika mukuluka kwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.14",
            "verseOrgIds": [
              "ISA.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Takukoosyaalilwa Egepita milimo niiba imwi iikonzya kucitwa kumuntu, nuuba mutwe nuuba mucila, nituba tukunka naaba matete.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.15",
            "verseOrgIds": [
              "ISA.19.15"
            ]
          }
        }
      ]
    },
