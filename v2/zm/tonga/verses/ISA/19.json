          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubuzuba obo kuyooba minzi yosanwe munyika ya-Egepita ilaamba mwaambo wa-Kanana akukonka muzina lya-Jehova wamakamu, Umwi uyooambwa kuti Munzi wazuba,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.18",
            "verseOrgIds": [
              "ISA.19.18"
            ]
          }
        }
