                }
              ]
            }
          ]
        },
        {
          "text": "Mubuzuba obo ba-Egepita bayooba mbuli banakazi. Bayooyoowa akukankama nkaambo kakuzungaanya kwajanza lya-Jehova wamakamu ndyazungaanya kulimbabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.16",
            "verseOrgIds": [
              "ISA.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela nyika ya-Juda iyoobeda ba-Egepita ciyoosya. Kufumbwa muntu uuambilwa izina lyayo uyooyoowa, nkaambo kamakanze aa-Jehova wamakamu ngaakanzide kulinjiyo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.17",
            "verseOrgIds": [
              "ISA.19.17"
            ]
          }
        }
      ]
    },
