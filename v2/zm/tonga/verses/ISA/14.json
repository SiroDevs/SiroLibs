          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaaya makani aakanzwa aanyika yoonse. Ndeeli ijanza litandabikidwe kukulwisya bamasi boonse. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.26",
            "verseOrgIds": [
              "ISA.14.26"
            ]
          }
        },
        {
