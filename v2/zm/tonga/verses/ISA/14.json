          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njoopwaya muAsuri mucisi cangu akumulyataula azilundu zyangu. Elyo ijoko lyakwe liyoozwa kulimbabo, amukuli wakwe uyoogwisigwa kumakuko aabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.25",
            "verseOrgIds": [
              "ISA.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
