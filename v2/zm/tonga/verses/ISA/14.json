              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele uwe wasoowegwa kuzwa kukabanda kako mbuli mutabi uusesemya, ulisamide bajayidwe bayasidwe apanga, baseluka kumabwe aamucilindi, mbuli mutunta uulyatwiidwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.19",
            "verseOrgIds": [
              "ISA.14.19"
            ]
          }
        },
        {
