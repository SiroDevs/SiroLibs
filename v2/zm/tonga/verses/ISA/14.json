              "items": [
                {
                  "text": "Mt 23:35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amubambile bana bakwe bujayi nkaambo kamilandu yawisaabo, kuti batabuki kukuvuba nyika akuzuzya nyika yoonse minzi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.21",
            "verseOrgIds": [
              "ISA.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 14:22"
          },
          "items": [
