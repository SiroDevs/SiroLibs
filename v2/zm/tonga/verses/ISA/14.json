          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tookooyooswananizigwa abo mukuzikwa, nkaambo nyika yako waibisizya, abalo bantu bako wabajaya. Bana basikucitazibi tabakooyooambwa lyoonse. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.20",
            "verseOrgIds": [
              "ISA.14.20"
            ]
          }
