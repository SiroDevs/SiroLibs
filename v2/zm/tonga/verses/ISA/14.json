                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.11.23"
              },
              "items": [
                {
                  "text": "Mt 11:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.10.15"
              },
              "items": [
                {
                  "text": "Lk 10:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakaamba mumoyo wako kuti, Nkatante kujulu. Nkaimike cuuno cangu cabwami kujulu lyanyenyeezi zya-Leza. Nkakale atala lyacilundu cambunganino kumabazu aakumusanza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.13",
            "verseOrgIds": [
              "ISA.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEP.2.15"
              },
              "items": [
                {
                  "text": "Zef 2:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.2.4"
              },
              "items": [
                {
                  "text": "2 Tes 2:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkatante kujulu loko kwiinda mayoba. Nkakozyane a-Leza Mupati. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.14",
            "verseOrgIds": [
              "ISA.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.47.8"
              },
              "items": [
                {
                  "text": "Is 47:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.28.8"
              },
              "items": [
                {
                  "text": "Ezk 28:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.28.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.11.23"
              },
              "items": [
                {
                  "text": "Mt 11:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.12.23"
              },
              "items": [
                {
                  "text": "Inc 12:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nekubaboobo uzooselusigwa kucikalilo cabafu, kumagolelo aacilindi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.15",
            "verseOrgIds": [
              "ISA.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boonse bakubona bayookweebela, bayookuyeeya kuti, Sa ngooyu muntu iwakazungaanya nyika? Sa ngooyu iwakateketya masi? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.16",
            "verseOrgIds": [
              "ISA.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sa ngooyu iwakasaala nyika yoonse kuti ibe mbuli inkanda? Sa nguwenya iwakavwinyuna minzi yayo? Sa nguwenya iwakakasya baange bakwe kuzwa muntolongo? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.17",
            "verseOrgIds": [
              "ISA.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bami babamasi boonse buyo baloona cabulemu, umwi aumwi muŋanda yakwe mwini. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.18",
            "verseOrgIds": [
              "ISA.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 14:19"
