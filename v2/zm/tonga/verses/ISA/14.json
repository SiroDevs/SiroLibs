              "attrs": {
                "loc": "PRO.10.7"
              },
              "items": [
                {
                  "text": "Tus 10:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Njoobuka kukubalwisya, mbwaamba Jehova wamakamu; njoonyonyweda Babuloni izina abantu basyaala, abana alunungu, mbwaamba Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.22",
            "verseOrgIds": [
              "ISA.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njooubika kuti ube cikalilo canungu, ube maziba aamaanzi. Njooukukuzya cikukuzyo calunyonyoono, mbwaamba Jehova wamakamu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.23",
