            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.10"
              },
              "items": [
                {
                  "text": "1 Pet 2:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tokooyooambwa limbi Uulekedwe, anyika yako tiikooyooambwa limbi Matongo, pe. Uyooambwa izina lya-Muyandwi wangu, anyika yako iyoopegwa izina lya-Uukwetwe, nkaambo Jehova ulakuyandisya, anyika yako iyookwatwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.4",
            "verseOrgIds": [
              "ISA.62.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 62:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbubonya mbuli musankwa mbwakwata nakalindu, sikuyaka wako uyookukwata mbubonya. Mbubonya mbuli sibwiinga mbwakondelwa nabwiinga wakwe, a-Leza wako uyookondelwa nduwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.5",
            "verseOrgIds": [
              "ISA.62.5"
            ]
          }
        }
      ]
