            "number": "2",
            "style": "v",
            "sid": "ISA 62:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.65.15"
              },
              "items": [
                {
                  "text": "Is 65:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.3.12"
              },
              "items": [
                {
                  "text": "Ciy 3:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bamasi bayoobona bululami bwako, abami boonse bayoobona bulemu bwako, nkabela uyooulikwa izina lipya lizwa kumulomo wa-Jehova, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.2",
            "verseOrgIds": [
              "ISA.62.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 62:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.9.16"
              },
              "items": [
                {
                  "text": "Zek 9:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino uyooba musini wabweebesi mujanza lya-Jehova, ingala yabwami mujanza lya-Leza wako. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.3",
            "verseOrgIds": [
              "ISA.62.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
