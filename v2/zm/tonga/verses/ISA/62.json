        },
        {
          "text": "Ndibikide balangizi amalambo aako, O Jerusalemu. Tabakooyooumuna abuniini ciindi coonse isikati amasiku. Inywe numwiibalusya Jehova, mutaumuni, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.6",
