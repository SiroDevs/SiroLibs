              "items": [
                {
                  "text": "Jer 5:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jehova wakonkezya kujanza lyakwe lyalulyo akukuboko kwakwe kuyumu kuti, Ncobeni nsikooyooaba limbi maila aako abe zilyo zyabasinkondonyoko, abazwakule tabakooyoonywa limbi musinza wamisaansa yako njiwakabelekela, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.8",
            "verseOrgIds": [
              "ISA.62.8"
            ]
          }
        },
        {
