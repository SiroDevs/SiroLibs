        },
        {
          "text": "Nkaambo ka-Zioni nsikooyooumuna, nkaambo ka-Jerusalemu nsikooyoolyokezya, mane lumwi bululami bwakwe buboneke mbuli mumuni uubekabeka, alufutuko lwakwe mbuli ilampi liyakisya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.1",
            "verseOrgIds": [
              "ISA.62.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
