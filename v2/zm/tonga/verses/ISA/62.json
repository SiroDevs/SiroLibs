                {
                  "text": "Dt 12:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "pele basikwaatebula bayoolya ngao cakutembaula Jehova, abasikucela misaansa mbobayooinywa mumbanza zyacikombelo cangu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.9",
