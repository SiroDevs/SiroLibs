          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela bayooambwa kuti mbantu basalala, banunwidwe ba-Jehova, Ayebo uyooambwa kuti ulisalidwe, munzi uutasiidwe.",
          "type": "text",
