              "items": [
                {
                  "text": "Zef 3:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "mutamuleki muluumuno, mane akasimpikizye Jerusalemu, utembaulwe moonse munyika. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.7",
            "verseOrgIds": [
