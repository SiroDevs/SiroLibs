          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ambila abo bakankama mumyoyo yabo kuti, Amuyume, mutayoowi, Amubone! Leza wanu uleza ankoto, uleza abulumbu bwa-Leza, uleza kuti amufutule. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.4",
            "verseOrgIds": [
              "ISA.35.4"
            ]
          }
        },
