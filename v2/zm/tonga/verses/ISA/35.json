                }
              ]
            }
          ]
        },
        {
          "text": "Cilema unooya busotauka mbuli insya, alulimi lwasyataambi luyooimbisya. Nkaambo maanzi ayooboneka munkanda atulongalonga tuyookunka mugundu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.6",
            "verseOrgIds": [
              "ISA.35.6"
            ]
          }
        },
        {
