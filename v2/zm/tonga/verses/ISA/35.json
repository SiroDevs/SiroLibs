              "items": [
                {
                  "text": "Is 11:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Takukooyooba mulavu oko, takakooyooinda banyama bamwi baluma. Abo boonse tabakooyoojanwa, pele bantu banunwidwe mbobati ende mulinjiyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.9",
            "verseOrgIds": [
