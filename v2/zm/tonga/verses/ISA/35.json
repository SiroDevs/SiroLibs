                  "text": "Heb 12:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amuyumye maboko mateteete, aalo mazwi aakankama amwaape inguzu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.3",
            "verseOrgIds": [
              "ISA.35.3"
            ]
          }
        },
        {
