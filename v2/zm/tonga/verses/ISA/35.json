          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musenga uupisya uyoosanduka kuba iziba, ayalo nyika injumu iyooba tusensa twamaanzi. Muŋanda yabamwaba mubakalede muyooba mani amatete amalelebo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.7",
            "verseOrgIds": [
              "ISA.35.7"
            ]
          }
