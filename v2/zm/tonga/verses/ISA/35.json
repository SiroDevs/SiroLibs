              "items": [
                {
                  "text": "Ciy 21:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela nkukonya oko kuyooba mugwagwa anzila. Iyootegwa Inzila yabusalazi. Mulinjiyo tamukooyooinda basofweede, pele iyooba yabantu bakwe. Sinyenda abafubafuba tabakooyooleya mulinjiyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.8",
            "verseOrgIds": [
              "ISA.35.8"
            ]
          }
        },
        {
