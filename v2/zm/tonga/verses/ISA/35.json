              "type": "text"
            }
          ]
        },
        {
          "text": "Inkanda amatongo zyoonse ziyoosekelela, alyalo igundu liyookondwa akusyuuka malubaluba aaebeka. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.1",
            "verseOrgIds": [
              "ISA.35.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kusyuuka liyoosyuuka loko, akusekelela liyoosekelela akwiimba, Liyoopegwa bulemu bwa-Lebano abweebesi bwa-Karimeli abwa-Saroni. Bayoobona bulemu bwa-Jehova, bweebesi bwa-Leza wesu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.2",
            "verseOrgIds": [
              "ISA.35.2"
            ]
          }
        }
      ]
    },
