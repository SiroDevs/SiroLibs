            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuboobu mbwaamba Jehova, Munununi wako, Uusalala wa-Israyeli. Ndime Jehova Leza wako. Ndime uukwiiyisya kuti ugwasigwe. Ndime uukweenzya munzila njoelede kutola. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.17",
            "verseOrgIds": [
              "ISA.48.17"
            ]
          }
        },
