              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.13"
              },
              "items": [
                {
                  "text": "22:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Undiswiilile O Jakobo, ayebo O Israyeli ngundiitide. Ime ndime. Ndime mutaanzi, alimwi ndime mamanino. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.12",
            "verseOrgIds": [
              "ISA.48.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 48:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.102.25"
              },
              "items": [
                {
                  "text": "Int 102:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maanza aangu ngaakabika intalisyo yanyika, alyalo ijanza lyangu lyalulyo ndelyakakwazamika ijulu. Zyoonse buyo, na ndaziita, zilalibonya antoomwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.13",
            "verseOrgIds": [
              "ISA.48.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 48:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amubungane nyoonse, muswiilile. Nguni akati kabo iwakaluula makani aya? Jehova ulamuyandi-sya, Ulacitila Babuloni makani ngaakanzide, akuboko kwakwe kuyoolwisya ba-Kasidi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.14",
            "verseOrgIds": [
              "ISA.48.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 48:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndime, ndime ndakaamba, ndakamwiita, Ndime ndamusisya, nkabela uyoojana coolwe munzila yakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.15",
            "verseOrgIds": [
              "ISA.48.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 48:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.2.8"
              },
              "items": [
                {
                  "text": "Zek 2:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.2.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amuswene kulindime, muswiilile makani aya. Kuzwa kumatalikilo nsina kwaamba kumbali. Kuzwa kuciindi eco makani naakaba ndakali nkuko. Lino sunu Mwami Jehova wandituma, alakwe Muuya wakwe wandituma.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.16",
            "verseOrgIds": [
              "ISA.48.16"
            ]
          }
        }
      ]
    },
