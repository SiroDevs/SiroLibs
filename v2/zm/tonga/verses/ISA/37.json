          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngaaya majwi Jehova ngaamba aanguwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.22",
            "verseOrgIds": [
              "ISA.37.22"
            ]
          }
        }
      ]
    },
