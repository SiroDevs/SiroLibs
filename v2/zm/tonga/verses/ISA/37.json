          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo Isaya mwana wa-Amozi wakatumina Hezekiya ijwi lyakuti, Mbuboobu mbwaamba Jehova Leza wa-Israyeli. Mbuli mbondipailila aamakani aa-Sanakeribu mwami wa-Asuri, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.21",
            "verseOrgIds": [
              "ISA.37.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
