              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kako mbuboobu mbwaamba Jehova aamwami wa-Asuri. Takooyoonjila mununzi uno, nikuba kufusa muvwi mulinguwo, nikuba kulibonya kunembo lyawo antobo, nikuba kuyaka citantilo cavu kulinguwo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.33",
            "verseOrgIds": [
              "ISA.37.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ISA 37:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzila eyo njiyonya njaakaleta ulapiluka mulinjiyo. Takoozoonjila mumunzi uno pe, mbwaamba Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.34",
            "verseOrgIds": [
              "ISA.37.34"
            ]
          }
        },
