          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo Sanakeribu mwami wa-Asuri wakanyampuka, wapiluka kuyookala ku-Nineve. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.37",
            "verseOrgIds": [
              "ISA.37.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ISA 37:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela naakali kukomba muŋanda ya-Nisiroki Leza wakwe, Adrameleki a-Sarezere bana bakwe bakamujaya apanga. Lino bakalobokela kucisi ca-Ararati, nkabela mwanaakwe Esari-hadoni wakalya izina lyakwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.38",
            "verseOrgIds": [
              "ISA.37.38"
