              "type": "text"
            }
          ]
        },
        {
          "text": "Lino angelo wa-Jehova wakainka kuyoojaya kuzilao zyaba-Asuri zyuulu zyabantu zili mwaanda amakumi aali musanu aatatu amusanu, nkabela bantu nibakafuma kubuka bajana kuti boonse mitunta iifwide. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.36",
            "verseOrgIds": [
              "ISA.37.36"
            ]
          }
        },
        {
          "name": "verse",
