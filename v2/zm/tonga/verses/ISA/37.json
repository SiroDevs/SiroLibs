          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela cipanzi caluzubo lwa-Juda cicisyeede ciyooboola kusimpa miyanda ansi akuzyala micelo ajulu, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.31",
            "verseOrgIds": [
              "ISA.37.31"
            ]
          }
        },
        {
