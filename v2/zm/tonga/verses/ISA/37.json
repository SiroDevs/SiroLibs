              },
              "items": [
                {
                  "text": "2 Bam 19:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nkaambo mu-Jerusalemu mulazwa basyeede, amucilundu ca-Ziyoni mulazwa inkamu yabalobosi. Busungu bwa-Jehova wamakamu mbobuyoocita obo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.32",
