        },
        {
          "text": "Mpawo mwami Hezekiya naakamvwa, wakazapaula zyakusama zyakwe, wasama zisani zyamasaka, akunjila muŋanda ya-Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.1",
            "verseOrgIds": [
