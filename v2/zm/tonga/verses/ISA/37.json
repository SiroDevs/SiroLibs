              "attrs": {
                "loc": "JER.34.7"
              },
              "items": [
                {
                  "text": "Jer 34:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Rabisake naakapiluka, wakajana mwami wa-Asuri ulalwisya Libina, nkaambo kamvwide kale kuti mwami waleka Lakisi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.8",
            "verseOrgIds": [
              "ISA.37.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 37:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakamvwa impuwo ya-Tirihaka mwami wa-Etiopiya yakuti, Bona! Weza kuzookulwisya. Elyo naakamvwa wakatuma batumwa kuli-Hezekiya, wabaambila kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.9",
            "verseOrgIds": [
              "ISA.37.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 37:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuboobu mbumweelede kwaambila Hezekiya mwami wa-Juda. Leza wako ngosyoma atakweeni cakwaamba kuti, Jerusalemu tokooyooabwa mumaanza aamwami wa-Asuri. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.10",
            "verseOrgIds": [
              "ISA.37.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 37:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulimvwide bami ba-Asuri ncibacitila zisi zyoonse, mbubazinyonyoona. Lino uwe uyoovunwa buti? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.11",
            "verseOrgIds": [
              "ISA.37.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 37:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.11.31"
              },
              "items": [
                {
                  "text": "Matl 11:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo zisi bamatata nzibakanyonyoona, sa ba-Leza bazyo bakazivuna? Nkukuti zisi mbuli Gozani a-Harani a-Resefi abana ba-Edeni ibakakede mu-Telesara. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.12",
            "verseOrgIds": [
              "ISA.37.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 37:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.49.23"
              },
              "items": [
                {
                  "text": "Jer 49:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uli kuli mwami wa-Hamati, amwami wa-Aripadi, amwami wamunzi wa-Safaravaimu, awa-Hena, awa-Iva?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.13",
            "verseOrgIds": [
              "ISA.37.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
