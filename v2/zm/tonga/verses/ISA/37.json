        },
        {
          "text": "Ambweni Jehova Leza wako wamvwa majwi aa-Rabisake, mwami wa-Asuri simalelo wakwe ngwaakatuma kuti asampaule Leza muumi. Ambweni Jehova Leza wako uyootapatila majwi ngaamvwide. Lino cikombyo cako ciye kujulu cakukombela bantu basyeede.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.4",
            "verseOrgIds": [
              "ISA.37.4"
            ]
          }
        }
      ]
