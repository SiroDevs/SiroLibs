                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi wakatuma Eliyakimu mupati wabasiŋanda a-Sebina mulembi abapaizi bapati, balisamide zisani zyamasaka, kuli-Isaya musinsimi mwana wa-Amozi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.2",
            "verseOrgIds": [
              "ISA.37.2"
            ]
          }
        },
        {
