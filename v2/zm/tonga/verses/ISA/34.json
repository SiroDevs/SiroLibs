              "items": [
                {
                  "text": "Dan 7:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.3.16"
              },
              "items": [
                {
                  "text": "Mal 3:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amuyandaule makani mubbuku lya-Jehova, mwaabale. Akati kabaabo takukooyooba umwi uubulika. Takukooyooba mwanakazi uubula mweenze wakwe, Nkaambo mulomo wangu nguwakalailila obo, amuuya wangu nguwakababunganya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.16",
            "verseOrgIds": [
              "ISA.34.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.78.55"
              },
              "items": [
                {
                  "text": "Int 78:55",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.16.33"
              },
              "items": [
                {
                  "text": "Tus 16:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ngonguwe uwakabawaalila cisolo, ajanza lyakwe ndelyakaceelesya akubaabila. Bayoocivuba lyoonse, bayookala mumonya mazuba oonse amuya mazyalani amazyalani.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.17",
            "verseOrgIds": [
              "ISA.34.17"
            ]
          }
        }
