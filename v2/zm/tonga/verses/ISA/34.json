              "type": "tag",
              "attrs": {
                "loc": "PSA.56.8"
              },
              "items": [
                {
                  "text": "Int 56:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.10"
