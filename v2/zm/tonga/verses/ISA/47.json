            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.50"
              },
              "items": [
                {
                  "text": "Dt 28:50",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndakakalalila bantu bangu, aboobo ndakasofwaazya lukono lwangu akubaaba mumaanza aako. Pele teewakabafwida luzyalo pe, Bacembele wabalemezya loko ijokwe lyako. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.6",
            "verseOrgIds": [
              "ISA.47.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 47:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.18.7"
              },
              "items": [
                {
                  "text": "Ciy 18:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi wakaamba kuti, Njooba namalelo lyoonse. Aboobo tokwe wakabika moyo wako kumakani aya, tokwe nowakayeeya mamanino aao.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.7",
            "verseOrgIds": [
              "ISA.47.7"
            ]
          }
        }
      ]
