              "items": [
                {
                  "text": "Jer 48:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": "Is 13:1–14:23; Jer 50:1–51:64",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seluka, ukale akati kamatombe, O mwana musimbi wa-Babuloni. Kala ansi aatakwe cuuno, O mwana musimbi waba-Kasidi, nkaambo tokooyooambwa limbi mutete na simacece. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.1",
            "verseOrgIds": [
              "ISA.47.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 47:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.11.5"
              },
              "items": [
                {
                  "text": "Kul 11:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bweza maziyo, ukaziye busu. Gwisya cisitilizyo cako, samununa malogwe aako, vumbulula maulu aako, ukainde akati kamaanzi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.2",
            "verseOrgIds": [
              "ISA.47.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 47:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NAM.3.5"
              },
              "items": [
                {
                  "text": "Nah 3:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.7.2"
              },
              "items": [
                {
                  "text": "Mt 7:2",
