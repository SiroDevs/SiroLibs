              },
              "items": [
                {
                  "text": "Ciy 9:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Zintu ezi zyoonse zyobile ziyookusikila antoomwe mubuzuba bomwe, nkukuti kufwidwa bana bako abukamufu. Ncobeni ziyookusikila loko, nekuba kuti zisondyo zyako nzinji, azyalo insengo zyako zyavulisya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.9",
            "verseOrgIds": [
              "ISA.47.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 47:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.52.7"
              },
              "items": [
                {
                  "text": "Int 52:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.8.12"
              },
              "items": [
                {
                  "text": "Ezk 8:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakali kusyoma bubi bwako, wakali kwaamba kuti, Taakwe uundibona. Busongo bwako aluzibo lwako, zyakuleesya munzila, aboobo wakaamba mumoyo wako kuti, Mpondi mebo, taakwe umbi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.10",
            "verseOrgIds": [
              "ISA.47.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 47:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.13.6"
              },
              "items": [
                {
                  "text": "Is 13:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.5.30"
              },
              "items": [
                {
                  "text": "Dan 5:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.27"
              },
              "items": [
                {
                  "text": "Lk 17:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kako uyoosikilwa mapenzi, nkabela tokooyooziba misamu yakwaatanda. Uyoosikilwa mafwabi ngotakonzyi kuliya. Lunyonyooko luyoofwamba kukujana notezi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.11",
            "verseOrgIds": [
              "ISA.47.11"
            ]
          }
        }
      ]
    },
    {
