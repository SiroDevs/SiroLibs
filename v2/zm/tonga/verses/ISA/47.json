            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.19"
              },
              "items": [
                {
                  "text": "Rom 12:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Cinswe cako ciyoovumbululwa, insoni yako iyooboneka. Njooliya inkoto, nsikooyoofwida muntu luzyalo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.3",
            "verseOrgIds": [
              "ISA.47.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 47:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munununi wesu, Jehova wamakamu ndizina lyakwe, Uusalala wa-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.4",
            "verseOrgIds": [
              "ISA.47.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 47:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.2.9"
              },
              "items": [
                {
                  "text": "1 Sam 2:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.2.37"
              },
              "items": [
                {
                  "text": "Dan 2:37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kokala cakuumuna, unjile mumudima, O mwana musimbi waba-Kasidi, nkaambo tokooyoobandwa limbi Namalelo wazisi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.5",
            "verseOrgIds": [
              "ISA.47.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 47:6"
          },
          "items": [
