          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.15.18"
              },
              "items": [
                {
                  "text": "Dt 15:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.15.5"
              },
              "items": [
                {
                  "text": "Is 15:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino sunu Jehova waamba kuti, Kwamana myaka yotatwe, mbuli myaka yasimilimo, bulemu bwa-Moabu buyoosampaulwa, amakamu makamu aakwe oonse, Abaabo bayoosyaala bayooba bace buyo, tabakooyooba amakani pe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.14",
            "verseOrgIds": [
              "ISA.16.14"
            ]
          }
        }
      ]
    }
