                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amutume tubelele kuliyooyo uuendelezya nyika yoonse kuzwa ku-Sela kulangene inkanda kusikila kucilundu camwana musimbi wa-Ziyoni. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.1",
            "verseOrgIds": [
              "ISA.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.21.13"
              },
              "items": [
                {
                  "text": "My 21:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela mbuli bayuni batuntulika, ambuli tuyuni tumwaikide kuzwa kuciteente, mbubonya obo mbubayooba bana basimbi ba-Moabu kuzito zya-Arinoni. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.2",
            "verseOrgIds": [
              "ISA.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bati, Mutulaye, mutukoswede makani. Cenzule cako cibe mbuli masiku izuba nilibala ciindi casikati. Sisa batandidwe, Utayubununi basimutuntuli. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.3",
            "verseOrgIds": [
              "ISA.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batandidwe bangu bakale-kale kulinduwe. BaMoabu, kobabeda ciyubilo cakubavuna kubasikusaala. Nkaambo kunyanzya kwamana, kusaala kwalesegwa, abalo basikupenzya banyonyoonwa mucisi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.4",
            "verseOrgIds": [
              "ISA.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.89.14"
              },
              "items": [
                {
                  "text": "Int 89:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.20.28"
              },
              "items": [
                {
                  "text": "Tus 20:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.14"
              },
              "items": [
                {
                  "text": "Dan 7:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino cuuno cabwami ciyooimikwa aluzyalo, nkabela kuyooba uukala alincico calusyomo mucilao ca-Davida. Ulabeteka akubamba imbeta akufwanzya bululami.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.5",
            "verseOrgIds": [
              "ISA.16.5"
            ]
          }
        }
      ]
    },
    {
