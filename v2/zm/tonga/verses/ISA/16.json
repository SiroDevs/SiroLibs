          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.48.29"
              },
              "items": [
                {
                  "text": "Jer 48:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twamvwa makani aakulisumpula kwa-Moabu. Ulalikankaizya loko. Twamvwa kulisumpula kwakwe akulikankaizya kwakwe abukali bwakwe. Cisapi cakwe ncabuyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.6",
            "verseOrgIds": [
              "ISA.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.3.25"
              },
              "items": [
                {
                  "text": "2 Bam 3:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino ba-Moabu bayoolilila ba-Moabunyina. Boonse buyo bayoolila. Muyoosukama zibunge zyamicelo zya-Kirihareseti. Muyoopenga loko. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.7",
            "verseOrgIds": [
              "ISA.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo myuunda ya-Hesiboni yapusama, ayalo misaansa yaku-Sibima. Bami babamasi bamwaya misamu yabo mibotu. Bakasika aku-Jazeri, baya bweendeenda munkanda. Mitabi yabo yakamwaika, yazubuka lwizi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.8",
            "verseOrgIds": [
              "ISA.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kako njoolilila misaansa yaku-Sibima kulila kwa-Jazeri. Njookutuntulwida amisozi yangu, O Hesiboni a-Eleale, nkaambo micelo yako iibizidwe akutebula kwako zyoonse zyasikilwa cikwala cankondo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.9",
            "verseOrgIds": [
              "ISA.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwafwa lukondo abusekelezi boonse mumyuunda yambolezi, amwalo mumyuunda yamasaansa taakwe kwiimba akusekelela. Taakwe uulyataula waini muzisinino. Koonzomoka kwakutebuzya masaansa ndakulesya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.10",
            "verseOrgIds": [
              "ISA.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kako mala aangu alalilila Moabu mbuli kantimbwa, amoyo wangu ulalilila Kiriheresi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.11",
            "verseOrgIds": [
              "ISA.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
