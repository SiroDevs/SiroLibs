              "items": [
                {
                  "text": "My 22:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.48.35"
              },
              "items": [
                {
                  "text": "Jer 48:35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.15.2"
              },
              "items": [
                {
                  "text": "Is 15:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Moabu naazooboneka akulikataazya kucilundu, naazoosika kubusena bwakwe busalala kukukomba, takoozookonzya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.12",
            "verseOrgIds": [
              "ISA.16.12"
            ]
          }
        }
      ]
    },
