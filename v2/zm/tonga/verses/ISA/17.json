                  "text": "21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Waluba Leza walufutuko lwako, andomba yanguzu zyako tona kwiiyeeya pe. Nkaambo kako, nekuba kuti uyoozikila miziki mibotu akubyala imbuto zyazizikilo zyeenzu, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.10",
            "verseOrgIds": [
              "ISA.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nekuba kuti mubuzuba bwakuzikila kwako uyoozyungulusya muunda lubaya, alimwi uyookuzya imbuto zyako cifumo, kutebula kuyoofwililila mubuzuba bwamapenzi abwabuusu bugambya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.11",
            "verseOrgIds": [
              "ISA.17.11"
            ]
          }
        }
