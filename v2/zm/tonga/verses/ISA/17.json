                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mubuzuba obo muntu uyoolangila Mubambi wakwe, ameso aakwe ayootongomwena Musalazi wa-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.7",
            "verseOrgIds": [
              "ISA.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Takooyoolangila zipaililo nzyaakapanga maanza aakwe, nikuba kutongomwena zintu nziyakacita minwe yakwe, zikozyano zyamisamu azikozyano zyazuba,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.8",
            "verseOrgIds": [
              "ISA.17.8"
            ]
          }
        }
      ]
