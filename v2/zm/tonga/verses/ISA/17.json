              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maawe! Mandondomo aabantu banji loko! Balandondoma mbuli mandondomo aalwizi. Kubbobboma kwabamasi! Balabbobboma mbuli kubbobboma kwamaanzi manji! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.12",
            "verseOrgIds": [
              "ISA.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamasi balabbobboma mbuli maanzi manji, Pele uyoobatapatila, elyo bayoocijila kule, bayootandwa mbuli buungu buulusigwa amuuwo kuzilundu ambuli lusuko lulundumuka nilyuungisya iguwo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.13",
            "verseOrgIds": [
              "ISA.17.13"
            ]
          }
