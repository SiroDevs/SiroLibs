              "type": "text"
            }
          ]
        },
        {
          "text": "Mubuzuba obo minzi yanu yamalinga iyooba mbuli matongo aaba-Amori aba-Hivi, ngebakasia nibakalwisigwa bana ba-Israyeli. Tiikooyookalwa limbi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.9",
            "verseOrgIds": [
              "ISA.17.9"
            ]
          }
        },
