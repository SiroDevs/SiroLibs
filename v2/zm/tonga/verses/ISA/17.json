                }
              ]
            }
          ]
        },
        {
          "text": "Ayalo iŋanda yakulwisya iyoolekwa mucisi ca-Efraimu, a-Damasko acisi coonse ca-Aramu uyoofwidwa bwami. Bayooba mbubonya mbuli bulemu bwabana ba-Israyeli, mbwaamba Jehova wamakamu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.3",
            "verseOrgIds": [
              "ISA.17.3"
            ]
          }
        }
      ]
