        },
        {
          "text": "Koswiilila uwe O julu, ayebo O nyika teelela, nkaambo Jehova waamba, Wati, Ndakalela bana akubakuzya, pele sunu bandipapila. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.2",
            "verseOrgIds": [
              "ISA.1.2"
            ]
          }
        },
        {
