            }
          ]
        },
        {
          "text": "Maawe! Munzi musyomesi wasanduka buti kuba simamambe! Kuuzwide imbeta, abululami bwakalikede mulinguwo, anu sunu mobali bajayi buyo, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.21",
            "verseOrgIds": [
              "ISA.1.21"
            ]
          }
        },
        {
          "name": "verse",
