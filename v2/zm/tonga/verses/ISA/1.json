          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Insiliva yako yasanduka, yabija. Waini wako ulivwelene amaanzi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.22",
            "verseOrgIds": [
              "ISA.1.22"
            ]
          }
