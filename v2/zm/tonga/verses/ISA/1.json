                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "pele na mwakaka akupapila, muyooligwa ipanga, nkaambo mbuboobo mbwiiamba milomo ya-Jehova.",
          "type": "text",
          "attrs": {
