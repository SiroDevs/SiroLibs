              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kamakani aya, mbuboobu mbwaamba Jehova, Mwami wamakamu, mupati wa-Israyeli, Wati, Maawe! Nzoolilemununa makataazyo aabaabo bandikazya, nzooliya inkoto kulibasinkondoma. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.24",
            "verseOrgIds": [
              "ISA.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
