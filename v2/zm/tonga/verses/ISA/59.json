              "type": "tag",
              "attrs": {
                "loc": "ROM.3.15"
              },
              "items": [
                {
                  "text": "Rom 3:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo maanza aanu asofwaazigwa bulowa, ayalo minwe yanu ilijisi milandu. Milomo yanu ilaamba zyakubeja, andimi zyanu zilanununa bubi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.3",
            "verseOrgIds": [
              "ISA.59.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 59:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.15.35"
              },
              "items": [
                {
                  "text": "Job 15:35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.7.14"
              },
              "items": [
                {
                  "text": "Int 7:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Taakwe uuleta makani mubululami, taakwe uunjila mukubetekana calusinizyo. Balasyoma makani aapilingene akwaamba zintu zyabuyo, balaminta miyeeyo mibi akuzyala zibi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.4",
            "verseOrgIds": [
              "ISA.59.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 59:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.8.14"
              },
              "items": [
                {
                  "text": "Job 8:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Balakumba mai aacipile, balaluka luubilili lwangubi. Kufumbwa uulya mai aabo ulafwa, amulilelyo lipwayidwe mulazwa inzoka. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.5",
            "verseOrgIds": [
              "ISA.59.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 59:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ingubilili zyabo tazikonzyi kuba zyakusama, tabakonzyi kulivumbya milimo yabo. Milimo yabo njemilimo yabu bi, amumaanza aabo momuli bucigebenga. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.6",
            "verseOrgIds": [
              "ISA.59.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 59:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.1.16"
              },
              "items": [
                {
                  "text": "Tus 1:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.3.15+ROM.3.16+ROM.3.17"
              },
              "items": [
                {
                  "text": "Rom 3:15-17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maulu aabo aali aluno lwakucita bubi. Balazuzaanina kutila bulowa bwabatakwe mulandu. Miyeeyo yabo njemiyeeyo yabumumvwazyakwe. Kusaala akunyonyoona nzezili munzila zyabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.7",
            "verseOrgIds": [
              "ISA.59.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 59:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.125.5"
              },
              "items": [
                {
                  "text": "Int 125:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.2.15"
              },
              "items": [
                {
                  "text": "Tus 2:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Inzila yaluumuno tabaizi. Tamukwe bululami mukweenda kwabo. Balicitila inzila zipilingene; kufumbwa muntu uuenda mulinzizyo takonzyi kuziba luumuno.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.8",
            "verseOrgIds": [
              "ISA.59.8"
            ]
          }
        }
      ]
    },
