              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Jehova naakabona, makani akabija mumeso aakwe kuti taakwe lubeta. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.15",
            "verseOrgIds": [
              "ISA.59.15"
            ]
