                "loc": "JER.8.15"
              },
              "items": [
                {
                  "text": "Jer 8:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ncobeni nciceeco kubetekwa kabotu neekubeda kule kuzwa kulindiswe, abululami tabusiki nkutubede. Tulalindila mumuni pele tulajana mudima buyo, Tulalangila bucedo pele nkutweenda kucisia mbi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.9",
            "verseOrgIds": [
              "ISA.59.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 59:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.29"
              },
              "items": [
                {
                  "text": "Dt 28:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.8.9"
              },
              "items": [
                {
                  "text": "Am 8:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEP.1.17"
              },
              "items": [
                {
                  "text": "Zef 1:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tulaampaampa bulambo mbuli boofu, tulaampaampa mbuli batakwe meso, tulalifumpula ciindi casikati mbubonya mbukulifumpulwa kumabbililo aazuba, tuli mbuli bafu akati kabaabo bacili bayumu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.10",
            "verseOrgIds": [
              "ISA.59.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 59:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toonse tulavuluma mbuli banengo, tulapululuzya mbuli inziba. Tulalindila lubeta pele taluwo; tulalangila lufutuko pele luli kule. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.11",
            "verseOrgIds": [
              "ISA.59.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 59:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo insotoko zyesu zyavula kumeso aako, azibi zyesu zilatupa kaambo, Nkaambo insotoko zyesu tuli azyo, amilandu yesu tuliibwene: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.12",
            "verseOrgIds": [
              "ISA.59.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 59:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.34"
              },
              "items": [
                {
                  "text": "Mt 12:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kusotoka mulao akweena-ena Jehova, kupiluka kunsi kuzwa kutobela Leza wesu, kwaamba makani aakupenzya akupapila, kuyeeya majwi aalweeno mumyoyo yesu akwaamba ngao. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.13",
            "verseOrgIds": [
              "ISA.59.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 59:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.8.1"
              },
              "items": [
                {
                  "text": "Neh 8:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lubeta lwapiluka kunsi, abululami buliimvwi kule, nkaambo lusinizyo lwafumpulwa mumigwagwa yamuminzi, abululami tabukonzyi kunjila, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.14",
            "verseOrgIds": [
              "ISA.59.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 59:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwabula lusyomo abuniini, akufumbwa uulipambula abubi ulalyaaba mumaanza aabasikusaala.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.15",
            "verseOrgIds": [
              "ISA.59.15"
            ]
          }
        }
      ]
    },
    {
