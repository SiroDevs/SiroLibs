                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mubuzuba obo kuyooba mutabi wa-Jehova uuli abweebesi abulemu, nkabela micelo yanyika iyooba abubotu abweebesi kulibaabo ba-Israyeli ibalobokede. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.2",
            "verseOrgIds": [
              "ISA.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo oyo uusyeede mu-Ziyoni ayooyo uucikede mu-Jerusalemu uyooambwa kuti ulasalala, nkukuti boonse balembedwe mbuli baumi mu-Jerusalemu, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.3",
            "verseOrgIds": [
              "ISA.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova naazoomana kusanzya itombe lyabana basimbi ba-Ziyoni akusalazya bulowa bwa-Jerusalemu mukati kawo kumuuya wakubeteka awakutenta. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.4",
            "verseOrgIds": [
              "ISA.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 4:5"
          },
