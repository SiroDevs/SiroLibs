              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubuzuba obo muntu uyooembela impwizi yaŋombe ambelele zyobile, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.21",
            "verseOrgIds": [
              "ISA.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
