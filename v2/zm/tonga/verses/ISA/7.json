              "attrs": {
                "loc": "2CH.28.5+2CH.28.6"
              },
              "items": [
                {
                  "text": "2 Mak 28:5-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mumazuba aa-Ahazi mwana wa-Jotamu mwana wa-Uziya mwami waJuda, kwakasika Rezini mwami wa-Aramu a-Peka mwana wa-Remaliya mwami wa-Israyeli kuzoolwisya Jerusalemu, pele bakakacilwa kuuzunda. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.1",
            "verseOrgIds": [
              "ISA.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo luzubo lwa-Davida lwakaambilwa kuti, Ba-Aramu balitangene mulongo aba-Efraimu, Nkabela moyo wakwe amyoyo yabantu bakwe yakakankama mbubonya mbuli misamu yamusokwe mbiizungaana nuunga muuwo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.2",
            "verseOrgIds": [
              "ISA.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
