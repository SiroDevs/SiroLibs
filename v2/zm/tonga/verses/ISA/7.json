                "loc": "2KI.18.17"
              },
              "items": [
                {
                  "text": "2 Bam 18:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.36.2"
              },
              "items": [
                {
                  "text": "Is 36:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpoonya awo Jehova wakaambila Isaya kuti, Koya ukacinge Ahazi, uwe a-Searijasubu mwanaako, kumagolelo aamufolo waziba lyakujulu kumugwagwa wamuunda wabasikusanzya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.3",
            "verseOrgIds": [
              "ISA.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino uleelede kumwaambila kuti, Cenjela! Umuna! Utayoowi! Moyo wako utawizuki nkaambo kazeezi zifumpu zyobile zyazisisi zisunta, Utayoowi bukali bwa-Rezini abwabaAramu abwamwana wa-Remaliya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.4",
            "verseOrgIds": [
              "ISA.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba-Aramu bavwiya makani mabi aakukubisizya, abalo ba-Efraimu amwana wa-Remaliya. Bati, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.5",
            "verseOrgIds": [
              "ISA.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katuya, tukalwisye cisi ca-Juda, tukacisaale akucipwaya, elyo tuyoobika mwami umbi mukati kaco, nkukuti mwana wa-Tabeeli. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.6",
            "verseOrgIds": [
              "ISA.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele mbuboobu mbwaamba Mwami Jehova. Makani taakooyoocitwa obo pe. Taakooyooba. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.7",
            "verseOrgIds": [
              "ISA.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.8.6"
              },
              "items": [
                {
                  "text": "2 Sam 8:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo mutwe wa-Aramu ngu-Damasko, amutwe wa-Damasko ngu-Rezini. Myaka iili makumi aali musanu alimwi aisanu niitana kumana, ba-Efraimu balapwayigwa, tabakooyooba limbi cisi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.8",
            "verseOrgIds": [
              "ISA.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutwe wa-Efraimu nguSamariya, amutwe wa-Samariya ngumwana wa-Remaliya. Na mwakaka kuzumina, ncobeni tamukooyooimisigwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.9",
            "verseOrgIds": [
              "ISA.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.9",
            "verseOrgIds": [
              "ISA.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Jehova wakaambila Ahazi lwabili kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.10",
            "verseOrgIds": [
              "ISA.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kokumbila citondezyo kuli-Jehova Leza wako, Kokumbila citondezyo camubulondo bwamaanzi niciba cakujulu kujulu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.11",
            "verseOrgIds": [
              "ISA.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele Ahazi wakavuwa kuti, Nsikookumbili pe. Nsikoesunkisya Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.12",
            "verseOrgIds": [
              "ISA.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo wakati, Amuswiilile nuluzubo lwa-Davida, Sa kukataazya bantu takumulami? Sa mulayanda kukataazya Leza wangu alakwe? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.13",
            "verseOrgIds": [
              "ISA.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.1.23"
              },
              "items": [
                {
                  "text": "Mt 1:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.35"
              },
              "items": [
                {
                  "text": "Lk 1:35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.9.6"
              },
              "items": [
                {
                  "text": "Is 9:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.3.16"
              },
              "items": [
                {
                  "text": "1 Tim 3:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Mwami mwini ulamupa citondezyo. Amubone! Musimbi uyoomita, uyoozyala mwana mulombe, uyoomuulika izina lya-Imanueli. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.14",
            "verseOrgIds": [
              "ISA.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyoolya buci amabisi naazookula akuziba kukaka bubi akusala bubotu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.15",
            "verseOrgIds": [
              "ISA.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.15.30"
              },
              "items": [
                {
                  "text": "2 Bam 15:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo naacitana kuziba kukaka bubi akusala bubotu, nyika njoyoowa bami bayo bobile iyoosaalwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.16",
            "verseOrgIds": [
              "ISA.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 7:17"
          },
          "items": [
