                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.12.16"
              },
              "items": [
                {
                  "text": "1 Bam 12:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jehova uyoosisya kulinduwe akubantu bako akuluzubo lwauso mazuba aatana kusika kuzwa kuciindi eciya cisi ca-Efraimu nicakaandaanisigwa acisi ca-Juda. Uyoosisya mwami wa-Asuri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.17",
            "verseOrgIds": [
              "ISA.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
