              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubuzuba obo masena oonse aakajisi misaansa iili cuulu iiulwa mali aansiliva aali cuulu ayooba amaunga amitubetube buyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.23",
            "verseOrgIds": [
              "ISA.7.23"
            ]
          }
        },
        {
