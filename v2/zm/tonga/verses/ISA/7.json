          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu asika nkuko uyooletelela mivwi abuta, nkaambo nyika yoonse iyoozula maunga amitubetube. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.24",
            "verseOrgIds": [
              "ISA.7.24"
            ]
          }
        },
        {
          "name": "verse",
