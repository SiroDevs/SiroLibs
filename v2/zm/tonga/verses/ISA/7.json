            "style": "v",
            "sid": "ISA 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela nkaambo kamukupa munji nguzikamwa uyoolya mabisi. Nkaambo boonse bantu bacisyeede munyika bayoolya mabisi abuci.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.22",
            "verseOrgIds": [
              "ISA.7.22"
            ]
          }
        }
