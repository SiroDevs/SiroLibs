        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.17",
            "verseOrgIds": [
              "ISA.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mubuzuba obo Jehova uyoosibila luuka luli kumagolelo aamilonga ya-Egepita anzuki zili mucisi ca-Asuri. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.18",
            "verseOrgIds": [
              "ISA.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela zyoonse ziyoosika, ziyookala muminkuni iitakwe bantu amumpako zyamandomba amumaunga amumani oonse.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.19",
            "verseOrgIds": [
              "ISA.7.19"
            ]
          }
        }
      ]
    },
