                "loc": "ISA.8.7"
              },
              "items": [
                {
                  "text": "Is 8:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.8.8"
