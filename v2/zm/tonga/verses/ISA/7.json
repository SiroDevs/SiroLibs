            }
          ]
        },
        {
          "text": "Mubuzuba obo Mwami uyoosakuzya lunyoolo lubbadelelwa luli mutala lyamulonga, nkukuti mwami wa-Asuri, mutwe aboya bwamumaulu. Acalo cilezu coonse luyoocimana.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.20",
            "verseOrgIds": [
