              "items": [
                {
                  "text": "Kul 14:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sa teensi nduwe iwakayuminizya lwizi, maanzi aamuziba ipati? Sa teensi nduwe iwakabika inzila akati kabulolo bwalwizi kuti banunwidwe bainde? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.10",
            "verseOrgIds": [
              "ISA.51.10"
            ]
          }
        },
        {
