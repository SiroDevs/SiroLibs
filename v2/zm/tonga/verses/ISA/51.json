                  "text": "Rom 1:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bululami bwangu buli kufwaafwi, lufutuko lwangu lwaboneka kale, akuboko kwangu kulabeteka misyobo yabantu, Nyika zyakunkomwe yalwizi ziyoondilangila, ziyoosyoma kuboko kwangu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.5",
            "verseOrgIds": [
              "ISA.51.5"
            ]
          }
        },
        {
