              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taakwe uumweenzya akati kabana boonse mbaazyede. Taakwe uumujata kujanza akati kabana boonse mbaakalela. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.18",
            "verseOrgIds": [
