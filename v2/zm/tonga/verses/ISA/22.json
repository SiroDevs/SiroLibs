                "loc": "1KI.4.6"
              },
              "items": [
                {
                  "text": "1 Bam 4:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbuboobu mbwaamba Mwami Jehova wamakamu. Koya kuliyooyo sikuyobolamali, kuli Sebina mupati waŋanda, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.15",
            "verseOrgIds": [
              "ISA.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukamwaambile kuti, Ucitanzi okuno? Nguni simukowanyoko okuno? Nkaambonzi nolibezela kabanda okuno? Ulalibezela kabanda kujulu! Ulalisida cikalilo mundomba! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.16",
            "verseOrgIds": [
              "ISA.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Swiilila! Jehova uyookusowa anze cakuwaala anguzu! Ncobeni uyookuvunga cakuvungisya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.17",
            "verseOrgIds": [
              "ISA.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyookulambaila mbuli impila, uyookuwaala munyika impati, elyo uyoofwa nkukonya oko, azyalo inkalaki zyabulemu bwako ziyooba nkuko, uwe nousya luzubo lwamwami wako insoni. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.18",
            "verseOrgIds": [
              "ISA.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njookutonta kuzwa kumilimo yako, akukugwisya mubusena bwako. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.19",
            "verseOrgIds": [
              "ISA.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.18.18"
              },
              "items": [
                {
                  "text": "2 Bam 18:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino mubuzuba obo njooita mulanda wangu Eliyakimu mwana wa-Hilikiya, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.20",
            "verseOrgIds": [
              "ISA.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.29.16"
              },
              "items": [
                {
                  "text": "Job 29:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nkabela njoomusamika cikobela cako akumuyumya alutambo lwako, abwalo bwami bwako njoobwaaba mumaanza aako. Elyo uyooba wisaabo bantu bakede mu-Jerusalemu aluzubo lwa-Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.21",
            "verseOrgIds": [
              "ISA.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
