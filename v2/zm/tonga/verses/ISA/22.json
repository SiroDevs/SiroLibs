                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.15.32"
              },
              "items": [
                {
                  "text": "1 Kor 15:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "pele bona! Kwaboneka buyo kusekelela akukondwa, kujaya basune akujaya imbelele, kulya nyama akunywa bukoko, cakwaamba kuti, Atulye akunywa, nkaambo junza tulafwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.13",
            "verseOrgIds": [
              "ISA.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.3.14"
              },
              "items": [
                {
                  "text": "1 Sam 3:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.24.13"
              },
              "items": [
                {
                  "text": "Ezk 24:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Jehova wamakamu wakandiyubunwida makani mumatwi aangu. Ncobeni mulandu wanu wazibi zili boobu tuukonzyi kumana cita mufwe, mbwaamba Mwami Jehova wamakamu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.14",
            "verseOrgIds": [
              "ISA.22.14"
            ]
          }
        }
      ]
    },
    {
