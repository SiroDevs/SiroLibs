              "items": [
                {
                  "text": "45:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele taakwe cilwisyo niciba comwe cibumbwa kukulwisya nduwe cikonzya kujana coolwe, andimi zyoonse zibuka kukubeteka uyoozipa mulandu, Nciceeco caabilo cabalanda ba-Jehova akululamikwa kwabo kuzwa kulindime, mbwaamba Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.17",
