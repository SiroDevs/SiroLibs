              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Webo opengede, otengaukide kuguwo, obulide luumuno, bona! Nzoonamatizya mabwe aako acizilo, antalisyo zyako nzooziyaka amabwe aa-Safiro. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.11",
            "verseOrgIds": [
              "ISA.54.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 54:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Insonge zyako nzooziyasya mabwe aasalala pyu, makoma aako nzooayasya mabwe aabekema, aalo malambo aako oonse azooyasigwa mabwe mayandisi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.12",
            "verseOrgIds": [
              "ISA.54.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
