              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.14.27"
              },
              "items": [
                {
                  "text": "14:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bana bako boonse bayooiyisigwa Jehova. Ncobeni bana bako bayooba acoolwe cipati. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.13",
            "verseOrgIds": [
              "ISA.54.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 54:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubululami momuti ime nji. Mapenzi ayootantamuka kule kuzwa kulinduwe, nkaambo tokooyooyoowa. Zintu ziyoosya tazikooyooswena nkobede pe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.14",
            "verseOrgIds": [
              "ISA.54.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 54:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na muntu uukubusizya inkondo, makani taazwi kulindime pe, Kufumbwa uumubusizya inkondo uyoonyonyooka nkaambo kanu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.15",
            "verseOrgIds": [
              "ISA.54.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 54:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amubone! Ndime ndakalenga mufuzi uuvukuta malasa mumulilo akupanga cilwisyo cakubelesya, Alimwi ndime ndakalenga sikunyonyoona kuti ajaye. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.16",
            "verseOrgIds": [
              "ISA.54.16"
            ]
          }
        },
