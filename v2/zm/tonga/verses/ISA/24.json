              "ISA.24.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.76.12"
              },
              "items": [
                {
                  "text": "Int 76:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mubuzuba obo Jehova uyookoma makamu aabantu basumpukide bakujulu, abalo bami banyika bali ansi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.21",
            "verseOrgIds": [
              "ISA.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela bayooyobololwa mbuli baangidwe mbubayobolwedwe muntolongo. Bayoojayilwa muntolongo, elyo amane mazuba manji, bayooswayigwa. ",
          "type": "text",
