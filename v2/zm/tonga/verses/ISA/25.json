        },
        {
          "text": "Lino Jehova wamakamu uyoocitila bantu boonse mucilundu ecino ipobwe lyazintu zyamafuta, ipobwe lyawaini uulwela, zintu zyamafuta zibotu, waini uulwela uusefedwe kabotu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.6",
            "verseOrgIds": [
