                "loc": "JER.51.37"
              },
              "items": [
                {
                  "text": "Jer 51:37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo wakamwaya munzi kuti ube citantaala, amunzi uuli alubaya kuti ube matongo, Iŋanda yabwami bwabazwakule wainyonyoona, aboobo tuucili munzi, tuukooyooyakululwa limbi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.2",
            "verseOrgIds": [
              "ISA.25.2"
            ]
          }
        },
        {
          "name": "verse",
