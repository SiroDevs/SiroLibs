              },
              "items": [
                {
                  "text": "Ciy 11:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kamakani aya bantu bayumu bayookulemeka, awalo munzi wamisyobo iiyoosya uyookuyoowa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.3",
            "verseOrgIds": [
              "ISA.25.3"
