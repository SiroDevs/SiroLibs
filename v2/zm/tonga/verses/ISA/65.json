          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balanda bangu bayooimba cakukondwa mumoyo, pele inywe muyoolila mumause aamyoyo yanu, muyoomoka mukupenga kwamyuuya yanu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.14",
            "verseOrgIds": [
              "ISA.65.14"
            ]
