            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.48"
              },
              "items": [
                {
                  "text": "Joh 12:48",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kako, mbubonya mbuli mabangabanga mbwaalya zisikosiko, abuungu mbubuwa mukati kamulilo, mbubonya obo muyanda wabo uyooba mbuli bubozi, amalubaluba aabo ayoomwaika mbuli lusuko. Nkaambo basampaula mulao wa-Jehova wamakamu, alyalo ijwi lya-Musalazi wa-Israyeli balikwiilila.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.24",
            "verseOrgIds": [
              "ISA.5.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 5:24"
          },
          "items": [
