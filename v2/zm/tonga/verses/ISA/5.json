          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maawe kulibaabo balipa busongo mumeso aabo beni, alimwi balayeeya kuti tuli bacenjede.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.21",
            "verseOrgIds": [
              "ISA.5.21"
            ]
          }
        }
