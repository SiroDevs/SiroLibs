              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maawe kulibaabo baamba kuti bubotu mbubi, bubi mbubotu; babika mumuni mucibaka camudima amudima mucibaka camumuni; babika kulula mucibaka cabunono abunono mucibaka cakulula.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.20",
