        },
        {
          "text": "Nciceeco bantu bangu ncibatolelwa mubuzike nkaambo kakubula luzibo, Balemu babo bafwa inzala, ababuleya bawizuka nkaambo kanyotwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.13",
            "verseOrgIds": [
              "ISA.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kako cikalilo cabafwa calikomezya, caasamuna mulomo waco cakuteelekeka, nkabela bulemu bwabo alupyopyongano lwabo abuvubi bwabo ayooyo uusekelela, zyoonse zilaselukila mulincico. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.14",
            "verseOrgIds": [
              "ISA.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu mutengwana ulakotama, alakwe mupati ulalibombya, aalo meso aabasikulisumpula alafwiinsigwa, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.15",
            "verseOrgIds": [
              "ISA.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "pele Jehova wamakamu ulalemekwa mukubeteka, Leza uusalala ulasalazigwa mubululami. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.16",
            "verseOrgIds": [
              "ISA.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino tubelele tuyoocela mumani aabo, aalo masena aasaalidwe aabaneneede tupongo tuyooalya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.17",
            "verseOrgIds": [
              "ISA.5.17"
            ]
          }
        }
