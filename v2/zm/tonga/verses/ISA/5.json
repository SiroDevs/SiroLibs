          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbombabo balulamika sizibi kuti balye makulo, abululami bwamululami balamunyanzya mbubo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.23",
