          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maawe kulibaabo bali anguzu zyakunywa waini, abasinguzu bavwelanya zya kunywa zikola. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.22",
            "verseOrgIds": [
              "ISA.5.22"
            ]
          }
        },
        {
          "name": "verse",
