              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.24",
            "verseOrgIds": [
              "ISA.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kako bukali bwa-Jehova bwabukila bantu bakwe. Watandabika ijanza lyakwe, wabauma, nkabela zilundu zyakankama, ayalo mitunta yabo yaba mbuli bufumba mukati kamigwagwa. Nekubaboobo bukali bwakwe tabuna kumana, ijanza lyakwe licitandabikidwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.25",
            "verseOrgIds": [
              "ISA.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ISA 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela uyoosumpwida bamasi bazwa kule citondezyo akubasibila kuzwa kumagolelo aanyika, elyo bayoofwambaana kuza aluno. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.26",
            "verseOrgIds": [
              "ISA.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ISA 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Takukooyooba muntu naba omwe akati kabo uukataala naba uulifumpuzya, Takukooyooba naba omwe uuona naba uuli muŋonzi. Takukooyooba naba omwe uuangulukidwe lutambo lwakucibunu cakwe naba uukonokelwa intambo zyansangu zyakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.27",
            "verseOrgIds": [
              "ISA.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ISA 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mivwi yabo yoonse ilinonedwe, amata aabo oonse alibambidwe. Insumba zyambizi zyabo zyayuma nta mbuli mabwe, amavwili aabo alayeeyegwa kuti ali aluno mbuli kambizi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.28",
            "verseOrgIds": [
              "ISA.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ISA 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuvuluma kwabo kuli mbuli kuvuluma kwamulavu. Balavuluma mbuli basyuumbwa, Balalila, balajata nyama, balainka ayo, nkabela taakwe uukonzya kwiivuna. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.29",
            "verseOrgIds": [
              "ISA.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ISA 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balavuluma kulimbabo mubuzuba obo mbuli kuvuluma kwalwizi. Elyo uulanga nyika uyoobona mudima buyo amapenzi. Mumuni ulasiizigwa mumayoba aabo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.30",
            "verseOrgIds": [
              "ISA.5.30"
            ]
          }
        }
      ]
    }
