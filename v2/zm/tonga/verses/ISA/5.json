              "type": "text"
            }
          ]
        },
        {
          "text": "Maawe kulibaabo baswaananya iŋanda kuŋandanyina akubika muunda kumuundanyina mane taakwe busena busyaala, aboobo mulakala amulike mukati kanyika. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.8",
            "verseOrgIds": [
              "ISA.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
