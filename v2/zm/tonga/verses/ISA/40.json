            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.2.10"
              },
              "items": [
                {
                  "text": "Lk 2:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino bulemu bwa-Jehova buyooyubununwa, nkabela bantu boonse bayoobubona antoomwe, nkaambo mulomo wa-Jehova nguwakacaamba. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.5",
            "verseOrgIds": [
              "ISA.40.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 40:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.1.10+JAS.1.11"
              },
              "items": [
                {
                  "text": "Jak 1:10-11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.1.24+1PE.1.25"
              },
              "items": [
                {
                  "text": "1 Pet 1:24-25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwakamvwigwa ijwi lyakuti, Kwiila. Elyo ndakabuzya kuti, Nkwiile makaninzi? Lyakati, Nyama yoonse mbwizu buyo, abweebesi bwayo boonse buli mbuli malubaluba aamusokwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.6",
            "verseOrgIds": [
              "ISA.40.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 40:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwizu bulanyana, malubaluba alapusama, luyooyo lwa-Jehova lwaziyooyela. Ncobeni bantu mbwizu buyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.7",
            "verseOrgIds": [
              "ISA.40.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 40:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwizu bulanyana, malubaluba alapusama, pele majwi aa-Leza wesu ayoobedelela.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.8",
            "verseOrgIds": [
              "ISA.40.8"
            ]
          }
        }
      ]
    },
    {
