                "loc": "JHN.1.23"
              },
              "items": [
                {
                  "text": "Joh 1:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ijwi lyasikoompolola munkanda lyakuti, Amubambe mugwagwa waJehova, amululamikile Leza wesu inzila iiandula musokwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.3",
            "verseOrgIds": [
              "ISA.40.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 40:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makuti oonse ayoosumpulwa, zilundu zyoonse atulundulundu ziyoofwinsigwa. Masena aapilingene ayoocincimikwa, amasena mabi ayoobungusanizigwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.4",
            "verseOrgIds": [
              "ISA.40.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 40:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
