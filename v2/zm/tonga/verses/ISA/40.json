              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amuumuzye, amuumuzye bantu bangu, mbwaamba Leza wanu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.1",
            "verseOrgIds": [
              "ISA.40.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 40:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amuumuzye moyo wa-Jerusalemu, mumukwiilile kuti inkondo yakwe yamana, milandu yakwe yalekelelwa, nkaambo kakuti bulumbu bwazibi zyakwe kuzwa kumaanza aa-Jehova wabutambula kobile.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.2",
            "verseOrgIds": [
              "ISA.40.2"
            ]
          }
        }
      ]
    },
