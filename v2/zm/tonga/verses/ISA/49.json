                  "text": "Zek 2:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bona! Ndeengede cifwanikisyo cako mumaanza aangu, Malambo aako aboneka kumeso aangu lyoonse. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.16",
            "verseOrgIds": [
              "ISA.49.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 49:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu balafwambaana kukuyaka. Abo ibakali kukusaala akukunyonyoona bayookuleka. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.17",
            "verseOrgIds": [
              "ISA.49.17"
            ]
          }
        },
        {
