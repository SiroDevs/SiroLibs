            }
          ]
        },
        {
          "text": "Nkaambo matongo aako amasena aako aabulide bantu anyika yako iisaalidwe ncobeni zyoonse zilaata bantu bakukalide, abaabo ibakakumenede bayooba kule. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.19",
            "verseOrgIds": [
              "ISA.49.19"
            ]
          }
        },
        {
