              "items": [
                {
                  "text": "26:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wati, Ncintu ciniini buyo kulinduwe kuba mulanda: wangu wakubusya misyobo ya-Jakobo awakupilusya ba-Israyeli bafutukide. Njookubika kuti ube mumuni wabamasi abalo, ube lufutuko lwangu koonse akusikila kumagolelo aanyika.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.6",
            "verseOrgIds": [
              "ISA.49.6"
            ]
          }
        }
