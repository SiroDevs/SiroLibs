              "items": [
                {
                  "text": "Jer 31:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino uyooamba mumoyo wako kuti, Ino nguni wandizyalila aba? Ndakafwidwa, ndakali musundi, ndakali mubuzike, ndakalitandidwe, lino aba nguni wabalela? Ndakasyaala endike, lino aba bazwa kuli?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.21",
            "verseOrgIds": [
