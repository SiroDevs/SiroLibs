              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuboobu mbwaamba Jehova, Munununi wa-Israyeli, Musalazi wakwe, Ulaambila umwi uusampaulwa, uusesemya bamasi, muzike wabeendelezi. Bami bayoobona, bayoobuka, abasilutwe bayookotama, nkaambo ka-Jehova uusyomeka, nkaambo ka-Musalazi wa-Israyeli uukusalide.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.7",
            "verseOrgIds": [
              "ISA.49.7"
            ]
          }
        }
      ]
