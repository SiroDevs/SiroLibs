                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bana ibakazyalwa kuciindi cakufwidwa kwako bayooamba mumatwi aako kuti, Kuntu okuno kwandaatila; kondiswena, kuti nkale kabotu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.20",
