              },
              "items": [
                {
                  "text": "Joh 13:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino wakandaambila kuti, Nduwe mulanda wangu, Israyeli ngunjoolemezegwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.3",
            "verseOrgIds": [
              "ISA.49.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 49:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.3.19"
              },
              "items": [
                {
                  "text": "Ezk 3:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndakaamba kuti, Milimo njindabeleka njabuyo. Ndupilingano azintu zitagwasya nzindasowela inguzu zyangu. Pele ncobeni Jehova nguuti ndibeteke, abulumbu bwangu nkubuli kuli-Leza wangu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.4",
            "verseOrgIds": [
              "ISA.49.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 49:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mbuboobu mbwaamba Jehova iwakandibumba mwida kuti mbe mulanda wakwe, kuti nkamuboozezye Jakobo, aba-Israyeli bayobololwe kulinguwe. (Ndalemekwa mumeso aa-Jehova, a-Leza wangu nguwaba inguzu zyangu.) ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.5",
            "verseOrgIds": [
              "ISA.49.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
