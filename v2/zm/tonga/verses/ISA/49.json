                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakacita mulomo wangu mbuli ipanga libosya. Mucenzule cajanza lyakwemowakandisisa, Wakandibika kuti mbe muvwi uubeka-beka, akundiyubika munkomo yakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.2",
            "verseOrgIds": [
              "ISA.49.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
