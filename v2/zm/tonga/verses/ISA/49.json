                }
              ]
            }
          ]
        },
        {
          "text": "Sa lusaalo lulakonzya kunyanzigwa singuzu? Sa bazike mbaarolede mukali balakonzya kuvunwa? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.24",
