              "items": [
                {
                  "text": "Tus 17:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lanzya meso aako koonse koonse, ubone. Boonse balibungene, beza kulinduwe. Ncobeni mbundi muumi, mbwaamba Jehova, uyoobasama boonse mbuli zyakulizakila, uyoobaanga mbuli mbwaanga nabwiinga. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.18",
            "verseOrgIds": [
              "ISA.49.18"
            ]
          }
        },
        {
          "name": "verse",
