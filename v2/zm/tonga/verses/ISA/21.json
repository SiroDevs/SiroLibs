              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaaya makani aasinsimwa aa-Arabiya, Mulusaka mu-Arabiya momuyoona masiku inywe nubasilweendo ba-Dedani. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.13",
            "verseOrgIds": [
              "ISA.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
