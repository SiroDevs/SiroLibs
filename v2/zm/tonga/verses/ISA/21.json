              "attrs": {
                "loc": "REV.18.2"
              },
              "items": [
                {
                  "text": "18:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino bona! Njeeyi inkamu yabantu, baleenda bo bile bobile amabbiza. Mpawo wakavuwa kuti, Wawa! Wawa Babuloni! Zikozyano zyoonse zyamizimu yawo zyapwayigwa ansi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.9",
            "verseOrgIds": [
              "ISA.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.51.33"
              },
              "items": [
                {
                  "text": "Jer 51:33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.4.13"
              },
              "items": [
                {
                  "text": "Mik 4:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAB.3.12"
              },
              "items": [
                {
                  "text": "Hab 3:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maawe! Kupola kwangu! Maila aakucipolelo cangu! Eco ncindakamvwa kuli-Jehova wamakamu Leza wa-Israyeli ndamulwiida ncico,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.10",
            "verseOrgIds": [
              "ISA.21.10"
            ]
          }
        }
      ]
