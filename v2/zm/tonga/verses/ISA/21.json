        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.6.19"
              },
              "items": [
                {
                  "text": "Job 6:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Oyo iwakafwa nyota bakamutekela maanzi. Bantu ibakakede munyika ya-Tema bakafwambaana kuletela bacijide insima. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.14",
            "verseOrgIds": [
              "ISA.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo bakacija mapanga, ipanga lisomwedwe, abuta butalamikidwe, amapenzi aankondo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.15",
            "verseOrgIds": [
              "ISA.21.15"
            ]
          }
        },
        {
