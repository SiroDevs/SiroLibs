              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.9.28+LUK.9.29+LUK.9.30+LUK.9.31+LUK.9.32+LUK.9.33+LUK.9.34+LUK.9.35"
              },
              "items": [
                {
                  "text": "Lk 9:28-35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Twakabona naakatambula kuli-Leza Wisi lulemeko abulemu, nkabela wakasikilwa eli ijwi lizwa kubulemu bupati lyakuti, Ngooyu Mwanaangu uuyandwa ngwenkondelwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.17",
            "verseOrgIds": [
              "2PE.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2PE 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eli ijwi twakalimvwa, lyakazwa kujulu notwakali awe kucilundu cisalala.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.18",
            "verseOrgIds": [
              "2PE.1.18"
            ]
          }
        }
      ]
