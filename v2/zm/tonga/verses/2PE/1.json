          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo nitwakamuzibya makani aanguzu zya-Jesu Kristo akuboola kwakwe, teetwakali kutobela zyamankwangwaalizya zicitwa akusongwaalasongwaala kwabantu, pe, nkaambo twakabona bupati bwakwe mumeso, esu tubeni. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.16",
            "verseOrgIds": [
              "2PE.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2PE 1:17"
          },
          "items": [
