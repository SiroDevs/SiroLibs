            "sid": "2PE 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndime Simoni Petro, muzike aapostolo wa-Jesu Kristo. Ndamujuzya nywebo nomuli alusyomo luyandisi mbuli lwesu, ndomulolezedwe mubululami bwa-Leza abwa-Mufutuli wesu Jesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.1",
            "verseOrgIds": [
              "2PE.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2PE 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JUD.1.2"
              },
              "items": [
                {
                  "text": "Jud 1:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amuvuzizigwe luzyalo aluumuno mukumuzibisya Leza a-Jesu Mwami wesu.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.2",
            "verseOrgIds": [
              "2PE.1.2"
            ]
          }
        }
      ]
    },
