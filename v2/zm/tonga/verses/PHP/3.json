                  "text": "1 Kor 9:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "aboobo nja bubindaanina kumagolelo, kuti nkajane bulumbu bwakujulu mbwatwiitila Leza muli-Kristo Jesu. ",
          "type": "text",
