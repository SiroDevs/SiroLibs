          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakwesu, nsiyeeyi kuti ndicijene kale, pe, pele cintu comwe ncencita nceeci. Ndaziluba zintu zili musule, ndadunamina zintu zili kunembo, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.13",
            "verseOrgIds": [
              "PHP.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
