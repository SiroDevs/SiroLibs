                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo basibupalule bwinibwini ndiswe, nitukomba Leza camu-Muuya akulikankaizizya Jesu Kristo akutasyoma makani aakumeso buyo, ",
          "type": "text",
          "attrs": {
