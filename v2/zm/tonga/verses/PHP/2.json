        },
        {
          "text": "Mutaciti cintu niciba comwe cabbivwe nanka cakulisumpula, pele umwi aumwi akati kanu alibombye mumoyo, akuyeeya kuti mweenzuma mubotu kwiinda ndime, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.3",
            "verseOrgIds": [
              "PHP.2.3"
            ]
          }
