                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tamweelede kuyeeya kuligwasya nubeni luzutu, pe, umwi aumwi uleelede kwiingasila kugwasya mweenzinyina.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.4",
            "verseOrgIds": [
              "PHP.2.4"
