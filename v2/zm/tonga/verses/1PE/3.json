              "items": [
                {
                  "text": "Tus 3:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mulizi Sara mbwaakali kuswiilila kuli-Abrahamu akumwaamba kuti mwami, nkabela nywebo muli bana ba-Sara na mwacita kabotu akutazundwa kumacijo aali buti.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.6",
            "verseOrgIds": [
              "1PE.3.6"
            ]
