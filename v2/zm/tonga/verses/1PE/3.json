                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kulisakatizya kwanu kutabi kwaatala, kwakupesa masusu akusama ingolida akusamisya masini, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.3",
            "verseOrgIds": [
              "1PE.3.3"
            ]
          }
        },
