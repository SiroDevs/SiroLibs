              "items": [
                {
                  "text": "2 Tes 2:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Acimwi cintu ncotumulumbila Leza cakutaleka nceeci. Ciindi ncimwakatambula makani aa-Leza ngomwakamvwa kulindiswe, tamukwe mwakaatambula mbuli makani aabantu, mwakaatambula mbuli mbwaabede ncobeni, nkukuti mbuli makani aa-Leza aali anguzu zyakubelekabeleka mumyoyo yanu nobasyomi. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.13",
            "verseOrgIds": [
              "1TH.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
