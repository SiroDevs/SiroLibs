              "attrs": {
                "loc": "ACT.17.5"
              },
              "items": [
                {
                  "text": "Inc 17:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo nywebo, nobakwesu, mwakaba abatobela imbungano zya-Leza zyamu-Judaya mwa-Jesu Kristo, ikuti mwakapenzegwa kulibasimusyobonyokwe mbubonya mbuli mbobakapenzegwa abalo kuba-Juda, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.14",
