              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.11.20"
              },
              "items": [
                {
                  "text": "Jer 11:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.1.10"
              },
              "items": [
                {
                  "text": "Gal 1:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.1.11"
              },
              "items": [
                {
                  "text": "1 Tim 1:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "pe, pele mbuli mbotwakasunkwa kuli-Leza akusyomenwa milimo ya-Makani Mabotu, tulaamba mbubonya, Tatubotezyi bantu, pe, tulabotezya Leza, nguwenya uusunka myoyo yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.4",
            "verseOrgIds": [
              "1TH.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TH 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.33"
              },
              "items": [
                {
                  "text": "Inc 20:33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.12.40"
              },
              "items": [
                {
                  "text": "Mk 12:40",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.2.3"
              },
              "items": [
                {
                  "text": "2 Pet 2:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ikuti tatukwe notwakaamba majwi aakutembaulatembaula (mulizi obo), nanka kuba abuliinsyo bwakulikumbuzya (Leza ngukamboni wesu kumakani aya), ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.5",
            "verseOrgIds": [
              "1TH.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TH 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.5.41"
              },
              "items": [
                {
                  "text": "Joh 5:41",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.5.44"
              },
              "items": [
                {
                  "text": "44",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "alimwi tatukwe notwakaliyandawida bulemu kubantu, nokuba kulindinywe nokuba kulibamwi (nokuba kuti twakalikweelede kulibika bulemu ambuli baapostolo ba-Kristo). ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.6",
            "verseOrgIds": [
              "1TH.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TH 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twakaba batete myoyo akati kanu, mbuli uunyonsya mbwabukata bana bakwe mwini. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.7",
            "verseOrgIds": [
              "1TH.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TH 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mbuli mbotwakali kumusukamina, cintu ncitwakali kuyanda kumwaabila kaciteensi Makani aa-Leza luzutu pele amyoyo yesu tubeni, nkaambo mwakali bayandwi besu, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.8",
            "verseOrgIds": [
              "1TH.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TH 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.4.12"
              },
              "items": [
                {
                  "text": "1 Kor 4:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.34"
              },
              "items": [
                {
                  "text": "Inc 20:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mulaibulukwa, bakwesu, milimo yesu amaminwa esu, ikuti eco ciindi ncitwakali kumukambaukila Makani aa-Leza, twakali kubeleka lyoonse, isikati amasiku, kuti tutalemeni muntu naba omwe akati kanu, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.9",
            "verseOrgIds": [
              "1TH.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TH 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muli bakamboni, alakwe Leza ngukamboni, mbotwakalicita cakusalala acakululama acakutaba akaambo kulindinywe nobasyomi, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.10",
            "verseOrgIds": [
              "1TH.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TH 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.31"
              },
              "items": [
                {
                  "text": "Inc 20:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mulizi kuti twakamucitila umwi aumwi mbuli wisi mbwacitila bana bakwe. Twakali kumukombelezya akumusenengezya akumulungulwida, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.11",
            "verseOrgIds": [
              "1TH.2.11"
            ]
          }
        },
        {
