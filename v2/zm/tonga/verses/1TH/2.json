                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kuti mweende munzila iielede kumeso aa-Leza iwakamwiitila bulemu bwakwe abwami bwakwe.",
          "type": "text",
          "attrs": {
