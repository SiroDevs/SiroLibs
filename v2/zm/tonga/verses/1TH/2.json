                  "text": "17:1-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nokuba kuti twakapenzegwa kale akucitilwa bubi ku-Filipi, mbomuziba, twakaba akaanzambwene muli-Leza wesu kumwaambila Makani Mabotu aa-Leza akati kankondo zinjizinji. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.2",
            "verseOrgIds": [
              "1TH.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TH 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kukombelezya kwesu takuli kwakubeja nanka kwabubi nanka kwakweena-ena, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.3",
            "verseOrgIds": [
              "1TH.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
