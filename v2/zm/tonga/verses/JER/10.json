        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.10",
            "verseOrgIds": [
              "JER.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Mbuboobu mbumweelede kubaambila. Baleza abo ibatakalenga ijulu anyika bayoomaninina munyika, tabakooyoobonwa limbi ansi ano.)",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.11",
