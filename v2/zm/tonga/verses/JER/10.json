              },
              "items": [
                {
                  "text": "Inc 14:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nguwe iwakalenga nyika kunguzu zyakwe, iwa bamba luwa mubusongo bwakwe, akutandabika majulu mumaanu aakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.12",
            "verseOrgIds": [
              "JER.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijwi lyakwe nilimvwigwa, maanzi alapyopyongana kujulu, asikunku ulamuuntumusya kuzwa kumagolelo aanyika, Ulacitila imvula indabo, amuzilondwedo zyakwe mwaagwisya muuwo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.13",
            "verseOrgIds": [
              "JER.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu boonse mbafubafuba, babula luzibo. Bafuzi boonse zikozyano zyabo nzibafula zilabausya insoni, nkaambo zikozyano zyabo nzyabuyo, taziyooyi pe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.14",
            "verseOrgIds": [
              "JER.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tazijisi milimo, pe, nzilenge zyalweeno, aboobo mubuzuba bwakuswayigwa kwazyo ziyooloba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.15",
            "verseOrgIds": [
              "JER.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
