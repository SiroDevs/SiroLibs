              "items": [
                {
                  "text": "Dt 32:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.74.2"
              },
              "items": [
                {
                  "text": "Int 74:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Caabilo ca-Jakobo tacili mbuli ezi pe; nkaambo ngonguwe iwakabumba zintu zyoonse, abaIsrayeli ngomusyobo ngwakonede. Jehova wamakamu ndizina lyakwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.16",
            "verseOrgIds": [
              "JER.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
