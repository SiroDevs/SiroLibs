                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maawe! Ndapenga! Mibunda ilacisa. Pele ndakaamba kuti, Obu bulwazi bwangu nsikonzyi kubucija. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.19",
            "verseOrgIds": [
              "JER.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itente lyangu lyafwa, intambo zyangu zyoonse zyadunsuka, bana bangu bandisia, tabawo, taakwe limbi uukonzya kukankamina itente lyangu nikuba kubamba zisitilizyo zyangu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.20",
            "verseOrgIds": [
              "JER.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo beembeli bafubaala, tababuzyi makani kuli-Jehova. Nciceeco ncibatajanina coolwe, amatanga aabo oonse amwaika. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.21",
            "verseOrgIds": [
              "JER.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yamvwigwa impuwo! Alasika makani! Lupyopyongano lupati lulazwa mucisi cakunyika, lulasaala minzi ya-Juda, ibe cikalilo cabamwaaba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.22",
            "verseOrgIds": [
              "JER.10.22"
            ]
          }
        },
