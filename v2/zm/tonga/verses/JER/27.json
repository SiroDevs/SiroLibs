              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele kufumbwa cisi na musyobo uukaka kumubelekela milimo, oyu Nebukadinezara mwami wa-Babuloni, akubika insingo yawo kunsi lyajoko lyamwami wa-Babuloni, oyo musyobo njooupenzya apanga apamba amalwazi, mbwaamba Jehova, mane lumwi nkaumanisye kujanza lyakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.8",
            "verseOrgIds": [
              "JER.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
