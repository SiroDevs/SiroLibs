                  "text": "Ezk 4:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbu­ boobu Jehova mbwaandaambila. Kolicitila zyaanzyo azikeyi zyajoko, ukalyaanzye nzizyo ansingo yako. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.2",
            "verseOrgIds": [
              "JER.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino tuma mulazyo kumwami waEdomu, kumwami wa-Moabu, kumwami wabana ba-Amoni, kumwami wa-Turo akumwami wa-Sidoni, kumilomo yaba tumwa basika ku-Jerusalemu kuli-Zedekiya mwami wa-Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.3",
            "verseOrgIds": [
              "JER.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uleelede kubalailila kutolela bami babo majwi aya aakuti, Mbuboobu mbwaamba Jehova wamakamu Leza waIsrayeli. Mbuboobu mbumweelede kwaambila basimalelo banu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.4",
            "verseOrgIds": [
              "JER.27.4"
            ]
          }
        },
