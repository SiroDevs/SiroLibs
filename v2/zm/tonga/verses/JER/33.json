                "loc": "JER.30.17"
              },
              "items": [
                {
                  "text": "Jer 30:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amubone! Njoouletela buumi abuponi. Njoobaponya akubayubunwida ziyobwedo zyaluumuno azyalusinizyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.6",
            "verseOrgIds": [
              "JER.33.6"
            ]
          }
        },
        {
          "name": "verse",
