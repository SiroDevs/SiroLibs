              "attrs": {
                "loc": "JER.6.7"
              },
              "items": [
                {
                  "text": "Jer 6:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kufumbwa ciindi nindaamba, ndoonzomoka cakwaamba kuti, Maawe! Ndasaalwa! Ndafwa! Nkaambo ijwi lya-Jehova lyandibeda cisampauzyo acisekesyo buzuba boonse. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.8",
            "verseOrgIds": [
              "JER.20.8"
            ]
          }
        },
