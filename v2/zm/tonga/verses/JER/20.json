                  "text": "Int 31:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo ndateelela bantu banji balavwiya. Ciyoosyo nkucili koonse koonse, Kwaaba atumwaabe! mbubaamba beenzuma boonse bandiziba. Balalindila buwe bwangu. Bati, Ambweni ulakonzya kucegwa, kuti tumuzunde akuliya inkoto,",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.10",
            "verseOrgIds": [
