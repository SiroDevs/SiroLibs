              "items": [
                {
                  "text": "28:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ayebo, Pasuri, aboonse bakede muŋanda yako, muyootolwa mubuzike. Uyoosika ku-Babuloni, nkukonya oko nkoyoofwida akuzikwa, webo abeenzinyoko boonse mbowakasinsimina zyakubeja.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.6",
            "verseOrgIds": [
              "JER.20.6"
