              "attrs": {
                "loc": "JER.3.24"
              },
              "items": [
                {
                  "text": "Jer 3:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abwalo buvubi boonse bwamunzi uno, ambono zyawo zyoonse, azintu zyawo ziyandisi, azilondwedo zyoonse zyabami ba-Juda, zyoonse buyo njoozyaaba mumaanza aabasinkondonyina, nkabela bazoozisaala akuzitola akuya azyo ku-Babuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.5",
            "verseOrgIds": [
              "JER.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
