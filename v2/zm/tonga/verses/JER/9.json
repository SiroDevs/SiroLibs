              "items": [
                {
                  "text": "Gal 1:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "pele beenda muzinguni zyamyoyo yabo akutobela mizimu yamawisaabo mbubakabaiyiisya, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.14",
            "verseOrgIds": [
              "JER.9.14"
            ]
          }
        },
        {
