                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.15.34"
              },
              "items": [
                {
                  "text": "1 Kor 15:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Indimi zyabo zilyoongomene mbuli mata, balaziwaazya majwi aakulengelela, Baba anguzu akati kanyika, pele teensi lusyomo ndubabelesezya inguzu zyabo pe, nkaambo balavuzya bubi atala lyabubinyina, pele mebo tabandizi, mbwaamba Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.3",
            "verseOrgIds": [
              "JER.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.7.5"
              },
              "items": [
                {
                  "text": "Mik 7:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.7.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Muntu acenjele mweenzinyina, atasyomi simukowanyina pe, nkaambo basimukowanyina boonse mbasilweeno, abeenzinyina boonse balaya bumulengelela. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.4",
            "verseOrgIds": [
              "JER.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boonse balabeja akweena umwi aumwi mweenzinyina, taakwe naba omwe uuamba lusinizyo pe. Indimi zyabo baziiyiisya kwaamba cakubeja. Balalikataazya buyo kuti bacite bubi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.5",
            "verseOrgIds": [
              "JER.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.1.24"
              },
              "items": [
                {
                  "text": "Tus 1:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Cikalilo cako cili akati kalweeno, Mulweeno lwabo balakaka kundiziba, mbwaamba Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.6",
            "verseOrgIds": [
              "JER.9.6"
            ]
          }
        }
      ]
    },
    {
