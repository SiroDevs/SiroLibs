      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.9",
            "verseOrgIds": [
              "JER.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolila akoomoka nkaambo kazilundu, aalo macelelo aamunkanda koacitila cililo, nkaambo zyoonse zyapya, taakwe muntu uuinda mulinzizyo, alimwi ijwi lyaŋombe talimvwigwi limbi, Bayuni bakujulu abanyama boonse bacija, bainka. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.10",
            "verseOrgIds": [
              "JER.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njoosandula Jerusalemu ube zitantaala, bulyango bwabamwaaba, ayalo minzi yoonse ya-Juda njooisandula ibe matongo aabula bantu bakala mumo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.11",
            "verseOrgIds": [
              "JER.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.107.43"
              },
              "items": [
                {
                  "text": "Int 107:43",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.42.23"
              },
              "items": [
                {
                  "text": "Is 42:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.14.9"
              },
              "items": [
                {
                  "text": "Hos 14:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nguni muntu musongo uukonzya kumvwisya aya makani? Nguni muntu mulomo wa-Jehova nguwakalwiida kuti akanane? Ino nkaambonzi nyika yanyonyooka? Nkaambonzi ilipide mbuli inkanda, alimwi taakwe muntu uuinda mulinjiyo?",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.12",
            "verseOrgIds": [
              "JER.9.12"
            ]
          }
        }
      ]
    },
