                "loc": "EZK.5.2"
              },
              "items": [
                {
                  "text": "Ezk 5:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Njoobamwaisya akati kabamasi mbobatana kuziba, nibaba beni nibaba bamawisaabo, nkabela njoobatandya ipanga mane lumwi nkabamanisye.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.16",
            "verseOrgIds": [
