            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LAM.3.15"
              },
              "items": [
                {
                  "text": "Malo 3:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "lino mbuboobu mbwaamba Jehova wamakamu Leza wa-Israyeli. Amubone! Njoosanizya bantu aba kabindaula akubanywisya maanzi aamululwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.15",
            "verseOrgIds": [
              "JER.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 9:16"
          },
          "items": [
