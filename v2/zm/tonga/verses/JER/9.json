          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nicakabota mutwe wangu niwakali maanzi, ameso aangu naakali kasensa kamisozi, elyo nindakalila isikati amasiku nkaambo kabajayidwe ba­ mwana musimbi wabantu bangu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.1",
            "verseOrgIds": [
              "JER.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
