            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova wati, Mbuli mbubasoowede mulao wangu ngundakababikila, alimwi tabana kuswiilila ijwi lyangu nikuba kweenda mbulyakabalailila, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.13",
            "verseOrgIds": [
              "JER.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
