                }
              ]
            }
          ]
        },
        {
          "text": "Lino Jeremiya naakamana kwaambila bantu boonse majwi aya conse aa-Jehova Leza wabo, Jehova Lcia wabo ngaakamutuma ao kuli­ mbabo, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.1",
            "verseOrgIds": [
              "JER.43.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 43:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azariya mwana wa-Hosaya a-Johanani mwana wa-Kareya abantu boonse basizisapi bakaambila Jeremiya kuti, Ulaamba zyakubeja, Teensi Jehova Leza wesu iwakakutuma kulindiswe kukwaamba kuti, Mutainki ku-Egepita kuyookala nkuko, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.2",
            "verseOrgIds": [
              "JER.43.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 43:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baruki mwana wa-Neriya nguwakubusya kuti utukataazye akutwaaba mumaanza aaba-Kasidi, tujayigwe na kutolwa mubuzike ku-Babuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.3",
            "verseOrgIds": [
              "JER.43.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 43:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aboobo Johanani mwana wa-Kareya abasilutwe boonse babasilumamba abantu boonse bakakaka kuswiilila ijwi lya-Jehova lyakuti, Kamukede munyika ya-Juda, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.4",
            "verseOrgIds": [
              "JER.43.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 43:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.40.11"
              },
              "items": [
                {
                  "text": "Jer 40:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.40.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Johanani mwana wa-Kareya abasilutwe boonse babasilumamba bakatolelela ba-Juda boonse ibakacisyeede ibakaboola kuzwa kuzisi zyoonse nkubakatandilidwe kuzookala mucisi caJuda. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.5",
            "verseOrgIds": [
              "JER.43.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 43:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.39.10"
              },
              "items": [
                {
                  "text": "Jer 39:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bakatolelela baalumi, abanakazi, abanikenike, abana basimbi bamwami, abantu boonse Nebuzaradana silutwe wampi mbaakaabide mumaanzanza aa-Gedaliya mwana wa-Ahikamu mwana wa-Safani, alakwe Jeremiya musinsimi a-Baruki mwana wa-Neriya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.6",
            "verseOrgIds": [
              "JER.43.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 43:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.2.16"
              },
              "items": [
                {
                  "text": "Jer 2:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.44.1"
              },
              "items": [
                {
                  "text": "44:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bakainka kunyika ya-Egepita, nkaambo bakakaka kuswiilila ijwi lya-Jehova, nkabela bakasika ku-Tahapanesi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.7",
            "verseOrgIds": [
              "JER.43.7"
            ]
          }
        }
      ]
