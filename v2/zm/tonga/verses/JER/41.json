              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.2.13"
              },
              "items": [
                {
                  "text": "2 Sam 2:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "bakainka abantu babo boonse kuyoolwisya Ismayeli mwana wa-Netaniya, Nkabela bakamujana ku-Gibeoni maanzi manji mpaabede. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.12",
            "verseOrgIds": [
              "JER.41.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino bantu boonse ibakali a-Ismayeli, nibakabona Johanani mwana waKareya abasilutwe boonse babasilumamba mbaakali abo, bakakondwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.13",
            "verseOrgIds": [
              "JER.41.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 41:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aboobo bantu boonse Ismayeli mbaakatolede mubuzike kuzwa ku-Mizipa bakapiluka akuya kuli-Johanani mwana wa-Kareya. ",
          "type": "text",
          "attrs": {
