          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.3.27"
              },
              "items": [
                {
                  "text": "2 Sam 3:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Ismayeli mwana wa-Netaniya abantu abo bali ikumi mbaakali abo bakanyamuka, bayasa Gedaliya mwana waAhikamu mwana wa-Safani apanga, bamujaya, oyo mwami wa-Babuloni ngwaakabikide kuti aendelezye nyika. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.2",
            "verseOrgIds": [
              "JER.41.2"
            ]
          }
        },
