        },
        {
          "text": "Lino Johanani mwana wa-Kareya abasilutwe boonse babasilumamba mbaakali abo, nibakamvwa bubi boonse mbwaakacita Ismayeli mwana waNetaniya, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.11",
            "verseOrgIds": [
