              "items": [
                {
                  "text": "Rom 3:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abalo ba-Juda boonse Gedaliya mbaakali abo ku-Mizipa, aba-Kasidi ibakajanwa mpawo, nkokuti basilumamba, boonse buyo Ismayeli wakabajaya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.3",
            "verseOrgIds": [
              "JER.41.3"
            ]
          }
