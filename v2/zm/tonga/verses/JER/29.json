                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo mbuboobu mbwaamba Jehova, Myaka iili makumi aali musanu aabili niizoomana ku-Babuloni, njoomuswaya, njoozuzikizya cisyomezyo cangu cakumupilusya kubusena obuno. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.10",
            "verseOrgIds": [
              "JER.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo ndizi miyeeyo yangu njinjeeya aandinywe, mbwaamba Jehova. Njemiyeeyo yakuleta coolwe, teensi miyeeyo yamapenzi pe. Njanda kumupa bubotu mbumukonzya kulangila kumamanino. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.11",
            "verseOrgIds": [
              "JER.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.9.3"
              },
              "items": [
                {
                  "text": "Dan 9:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino muyoondiita, muyoosika kundikomba, nkabela njoomuswiilila. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.12",
            "verseOrgIds": [
