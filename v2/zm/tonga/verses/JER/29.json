          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulaamba kuti, Jehova watubusizya basinsimi ku-Babuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.15",
            "verseOrgIds": [
              "JER.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele mbuboobu Jehova mbwaamba aamwami uukede acuuno cabwami bwa-­Davida, abantu boonse bakede mumunzi uno, nkokuti banabakwanu ibatakainka anywebo kuya mubuzike. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.16",
            "verseOrgIds": [
              "JER.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.24.8+JER.24.9+JER.24.10"
              },
              "items": [
                {
                  "text": "Jer 24:8-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbuboobu mbwaamba Jehova wamakamu. Ncobeni njoobatumina ipanga anzala amalwazi, nkabela njoocita kuti babe mbuli inkuyu imbi zitakonzyi kuligwa nkaambo kabubi bwazyo. ",
          "type": "text",
