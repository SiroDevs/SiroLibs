              "items": [
                {
                  "text": "Ef 5:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo mbuboobu mbwaamba Jehova wamakamu Leza wa-Israyeli. Batamweeni basinsimi banu abasondi banu bakede akati kanu. Mutaswiilili ziloto zyabo nzibalota, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.8",
            "verseOrgIds": [
              "JER.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkaambo makani ngebamusinsimina muzina lyangu ngaakubeja buyo. Teensi ndime ndakabatuma pe, mbwaamba Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.9",
            "verseOrgIds": [
              "JER.29.9"
            ]
          }
        }
      ]
