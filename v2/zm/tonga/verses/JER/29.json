              "attrs": {
                "loc": "2CH.36.10"
              },
              "items": [
                {
                  "text": "2 Mak 36:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ngaaya majwi aalugwalo Jeremiya musinsimi ndwaakatuma kuzwa ku-Jerusalemu kubapati bamwi babaabo ibakatoledwe mubuzike, akubapaizi, akubasinsimi, akubantu boonse Nebukadinezara mbaakatola mubuzike ku-Babuloni kuzwa ku-Jerusalemu, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.1",
            "verseOrgIds": [
              "JER.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkukuti nibakamana kulonzegwa kuzwa ku-Jerusalemu mwami Jekoniya abanyina mwami abasiŋanda abapati bacisi ca-Juda aba-Jerusalemu abafuzi abasimilimo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.2",
            "verseOrgIds": [
              "JER.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lugwalo lwakatumwa kumaanza aa-Eleasa mwana wa-Safani a-Gemariya mwana wa-Hilikiya, mbombabo Zedekiya mwami wa-Juda mbaakatuma ku-Babuloni kuli-Nebukadinezara mwami wa-Babuloni. Lwakati, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.3",
            "verseOrgIds": [
              "JER.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuboobu Jehova wamakamu Leza wa-Israyeli mbwaambila boonse batandidwe mbendakalonzya kuzwa ku-Jerusalemu kuya mubuzike ku-Babuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.4",
            "verseOrgIds": [
              "JER.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amuyake maanda, mukale mulingao. Amulime myuunda, mulye micelo yayo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.5",
            "verseOrgIds": [
              "JER.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amukwate banakazi, muzyale bana balombe abasimbi, Amukwatye bana banu balombe banakazi, abalo bana banu basimbi ubape kuti bakwatwe baalumi, bazyale bana balombe abasimbi, kuti mukavule nkuko akutaceya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.6",
            "verseOrgIds": [
              "JER.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
