            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.46.27+JER.46.28"
              },
              "items": [
                {
                  "text": "Jer 46:27-28",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino utayoowi, O Jakobo mulanda wangu, mbwaamba Jehova. Utakankami, O Israyeli, nkaambo ncobeni njookufutula kuzwa kule, alunyungu lwako njoolufutula munyika yabuzike bwalo. Lino Jakobo uyoopiluka, uyookala aluumuno, nkabela takukooyooba naba omwe uumukataazya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.10",
            "verseOrgIds": [
              "JER.30.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo mebo ndi anywe, mbwaamba Jehova, njookuvuna, Misyobo yoonse njindakamumwaya akati kayo, njooimaninizya, pele nywebo nsikooyoomumaninizya pe. Njookuuma muciyanza ceelede buyo, nsikooyookuleka buyo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.11",
            "verseOrgIds": [
              "JER.30.11"
            ]
          }
        }
      ]
    },
