                "loc": "ISA.30.8"
              },
              "items": [
                {
                  "text": "Is 30:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbuboobu mbwaamba Jehova Leza wa-Israyeli. Lemba mubbuku majwi oonse ngendakamwaambila. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.2",
            "verseOrgIds": [
              "JER.30.2"
            ]
          }
        },
        {
