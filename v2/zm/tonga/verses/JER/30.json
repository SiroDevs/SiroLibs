              "items": [
                {
                  "text": "Dan 12:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maawe! Obo buzuba mbupati. Taakwe bweelene abo. Nceciindi Jakobo naalemenwa mapenzi, nekubaboobo uyoofutulwa kuzwa kulimbubo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.7",
            "verseOrgIds": [
              "JER.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mubuzuba obo, mbwaamba Jehova wamakamu, njootyola ijoko lyakwe lili ansingo yako akudunsula zyaanzyo zyako. Bazwakule tabakooyoobanjizya limbi mubuzike, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.8",
            "verseOrgIds": [
              "JER.30.8"
            ]
          }
        },
