              },
              "items": [
                {
                  "text": "16:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo mumazuba aaboola, mbwaamba Jehova, njooboozezya bantu bangu ba-Israyeli aba-Juda coolwe, mbwaamba Jehova, nkabela njoobapilusya kunyika eyo njindakapa bamawisaabo, kuti baivube.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.3",
            "verseOrgIds": [
              "JER.30.3"
            ]
          }
        }
      ]
    },
    {
