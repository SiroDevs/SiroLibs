        },
        {
          "text": "Lino basilutwe boonse babasilumamba ibakali musokwe, balo abantu babo, nibakamvwa kuti mwami wa-Babuloni wabika Gedaliya mwana waAhikamu kuti aendelezye nyika, alimwi waaba mumaanza aakwe baalumi abanakazi abana boonse, nkokuti batengwana banyika ibatakalina kutolwa mubuzike ku-Babuloni, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.7",
            "verseOrgIds": [
              "JER.40.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 40:8"
          },
