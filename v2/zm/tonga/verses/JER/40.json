                  "text": "Malo 1:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abalo ba-Juda boonse ibakali mucisi ca-Moabu amucisi cabana ba-Amoni amucisi caEdomu amuzisi zyoonse, nibakamvwa kuti mwami wa-Babuloni wasia bantu bamwi kuti kabacisyeede mucisi ca-Juda, alimwi wababikila Gedaliya mwana wa-Ahikamu mwana wa-Safani kuti abe mweendelezi wabo, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.11",
            "verseOrgIds": [
              "JER.40.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 40:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ba-Juda boonse bakaboola kuzwa kumasena oonse nkubakacijilide, basika kucisi caJuda kuli-Gedaliya ku-Mizipa, bakaakucela waini amicelo yamainza minji loko.",
