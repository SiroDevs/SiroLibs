              "items": [
                {
                  "text": "Dt 16:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mebo ndakala ku-Mizipa kuti mbe mutabilizi kuliba-Kasidi bazoosika kulindiswe, pele nywebo amutebule waini amicelo yamainza amafuta, muzibike muzilondwedo zyanu, akukala muminzi yanu njimuyoolibwezela. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.10",
            "verseOrgIds": [
              "JER.40.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
