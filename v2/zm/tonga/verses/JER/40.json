              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.41.1"
              },
              "items": [
                {
                  "text": "Jer 41:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "bakasika kuli-Gedaliya ku-Mizipa: Ismayeli mwana wa-Netaniya, a-Johanani a-Jonatani bana ba-Kareya, a-Seraya mwana wa-Tanumeti, abana ba-Efai waku-Netofa, a-Jezaniya mwana wamuntu waku-Maaka, balo abantu babo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.8",
            "verseOrgIds": [
              "JER.40.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 40:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Gedaliya mwana waAhikamu mwana wa-Safani wakabakonkezya, balo abantu babo, wati, Mutayoowi kumanina ba-Kasidi milimo. Amukale munyika akumanina mwami wa-Babuloni milimo, lino munookala kabotu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.9",
            "verseOrgIds": [
              "JER.40.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 40:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
