            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.63.18"
              },
              "items": [
                {
                  "text": "63:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Beembeli banji balijayide muunda wangu wamasaansa, balyataula caabilo cangu, ncobeni caabilo cangu cibotu bacisaala, caba inkanda iitakwe bantu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.10",
            "verseOrgIds": [
              "JER.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.42.25"
