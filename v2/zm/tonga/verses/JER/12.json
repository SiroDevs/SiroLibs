              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.2.2"
              },
              "items": [
                {
                  "text": "Mal 2:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Balicisaalide, akusaalwa kwaco kwanduusya buusu. Nyika yoonse yaba matongo, nkabela taakwe muntu uubika moyo wakwe kumakani. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.11",
            "verseOrgIds": [
              "JER.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atala lyabalubulansuki boonse bamunkanda kwasika basikunyonyoona, nkaambo ipanga lya-Jehova lilamanisya bantu kuzwa kumagolelo aanyika kusikila kumagolelo amwi. Taakwe muntu naba omwe uukede muluumuno. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.12",
            "verseOrgIds": [
              "JER.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.26.16"
              },
              "items": [
                {
                  "text": "Lev 26:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Balibyalide bulotwe, pele bayootebula maamvwa. Balikataazya, pele taakwe impindu njibajana. Kutebula kwabo kulabausya insoni, nkaambo ka bukali buyoosya bwaJehova.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.13",
            "verseOrgIds": [
              "JER.12.13"
            ]
          }
        }
      ]
