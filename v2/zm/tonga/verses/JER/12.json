            "number": "7",
            "style": "v",
            "sid": "JER 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaleka luzubo lwangu, ndatakata lukono lwangu, ayooyo ngunjandisya ndamwaaba mumaanza aabasinkondonyina. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.7",
            "verseOrgIds": [
              "JER.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.16"
              },
              "items": [
                {
                  "text": "2 Mak 36:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lukono lwangu lwandibeda mbuli mulavu wamusokwe. Wandikalamukila, aboobo ndimusulide. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.8",
            "verseOrgIds": [
              "JER.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sa lukono lwangu lwandibeda muyuni mukali uuli amabala mabala? Sa bayuni bakali balamulwisya kumabazu oonse? Kamuya mukabunganye banyama boonse bamusokwe, mubalete, bazoolye. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.9",
            "verseOrgIds": [
              "JER.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.6.3"
              },
              "items": [
                {
                  "text": "Jer 6:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.5.1"
              },
              "items": [
                {
                  "text": "Is 5:1",
                  "type": "text"
