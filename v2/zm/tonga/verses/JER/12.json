                "loc": "JER.49.19"
              },
              "items": [
                {
                  "text": "Jer 49:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma! Sa basimyeendo mbowasiyana abo bakukataazya? Lino ulatandana buti abasimbizi? Sa wawizuka munyika yaluumuno? Lino ulacita buti mulusaka lwa-Jordano? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.5",
            "verseOrgIds": [
              "JER.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana bakwanu abasiluzubo lwauso boonse balakuvwiya. Boonse balalila kukukubusizya inkondo. Utabasyomi pe, nekuba kuti balakwaambila majwi mabotu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.6",
            "verseOrgIds": [
              "JER.12.6"
            ]
          }
        }
      ]
    },
    {
