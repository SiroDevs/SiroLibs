                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbuboobu Jehova mbwaamba aabeenzuma boonse babisya-bisya lubono ndundakavubya bantu bangu ba-Israyeli, Ncobeni njoobanonkola kuzwa kunyika yabo, aluzubo lwa-Juda njoolunonkola akati kabo, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.14",
            "verseOrgIds": [
              "JER.12.14"
            ]
          }
        },
