                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbubonya mbundi muumi, mbwaamba Mwami, izina lyakwe ngu-Jehova wamakamu, kuyoosika umwi mupati uuli mbuli Tabori akati kazilundu ambuli Karameli kumbali lyalwizi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.18",
            "verseOrgIds": [
              "JER.46.18"
            ]
          }
        },
        {
