                  "text": "Nah 2:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amubambe intobo azitabilizyo, muswene afwaafwi kukulwisya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.3",
            "verseOrgIds": [
              "JER.46.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 46:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amwaange imbizi, mutante nubasimbizi. Amulibambe angoani zyanu, Amusyobole masumo aanu. Amusame zibaki zyankondo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.4",
            "verseOrgIds": [
              "JER.46.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 46:5"
          },
          "items": [
            {
