              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.13",
            "verseOrgIds": [
              "JER.46.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 46:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amulungulule makani mu-Egepita, amvwigwe mu-Migidoli. Makani amvwigwe mu-Nofi amu-Tahapanesi. Amwaambe kuti, Amwiimikile akulibamba, nkaambo ipanga lilaya bunyonyoona koonse koonse. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.14",
            "verseOrgIds": [
              "JER.46.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 46:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ino Apisi wacijilanzi? Nkaambonzi sintaze wako wakakacilwa kwiima nji? Nkaambo kakuti Jehova nguwakamutanda. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.15",
            "verseOrgIds": [
              "JER.46.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 46:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
