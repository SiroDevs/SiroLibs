              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.6.25"
              },
              "items": [
                {
                  "text": "Jer 6:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.20.4"
              },
              "items": [
                {
                  "text": "20:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.6.15+REV.6.16+REV.6.17"
              },
              "items": [
                {
                  "text": "Ciy 6:15-17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma! Ndabona nzi? Nkaambonzi bayoowa akupiluka kunsi? Baalumi babo basintaze bazundwa, bafwambaana kucija! Tabacebuki musule pe! Zintu ziyoosya nkuzili koonse koonse! mbwaamba Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.5",
            "verseOrgIds": [
              "JER.46.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 46:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.11.19"
              },
              "items": [
                {
                  "text": "Dan 11:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Siluno ataciji, alakwe silumamba sintaze ataloboki. Kulubazu lwakunyika, kunkomwe yamulonga wa-Firate, nkokuko nkubalebwa, nkubawida.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.6",
            "verseOrgIds": [
              "JER.46.6"
            ]
          }
        }
      ]
    },
    {
