                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ngaaya makani Jehova ngaakaambila Jeremiya musinsimi aakuboola kwa-Nebukadinezara mwami wa-Babuloni kuzoolwisya nyika ya-Egepita.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.13",
            "verseOrgIds": [
              "JER.46.13"
            ]
          }
        }
