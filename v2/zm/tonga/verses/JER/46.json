          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao mwami wa-Egepita, amumuulike izina lya-Sicikwala uusowa ciindi buyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.17",
