              "items": [
                {
                  "text": "Jer 1:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Egepita nimpwizi iiebeka loko, pele muzimbwa uuzwa kunyika ulimukede. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.20",
            "verseOrgIds": [
              "JER.46.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 46:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basilumamba bakwe baulidwe bali mukati kacisi bali mbuli boombe baneneede. Boonse buyo bapiluka, bacija, teebaima pe, nkaambo ciindi camapenzi aabo casika, ciindi cabo cakuumwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.21",
            "verseOrgIds": [
              "JER.46.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 46:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
