                  "text": "Jer 48:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amulibambile impasya zyakutolelela mubuzike, O mwana musimbi nokede mu-Egepita, nkaambo Nofi uyooba matongo, uyoopya mane ukabule bantu bakala mumo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.19",
            "verseOrgIds": [
              "JER.46.19"
            ]
          }
        },
        {
          "name": "verse",
