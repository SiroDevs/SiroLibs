            "number": "23",
            "style": "v",
            "sid": "JER 46:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayoogonka lusaka lwakwe, mbwa amba Jehova, nekuba kuti lulisinkide, nkaambo mbanji loko kwiinda cisozi, mweelwe wabo tuubaliki pe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.23",
            "verseOrgIds": [
              "JER.46.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 46:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana musimbi wa­-Egepita uyoousigwa bweeme, uyooabwa mumaanza aabantu bazwa kunyika,",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.24",
            "verseOrgIds": [
              "JER.46.24"
            ]
          }
        }
