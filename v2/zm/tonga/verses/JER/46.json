        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.25.9"
              },
              "items": [
                {
                  "text": "Jer 25:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.25.19"
              },
              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ngaaya makani aa-Egepita, makani aabasilumamba ba-Farao-Neko mwami wa-Egepita, ibakali kumbali lyamulonga wa-Firate ku-Karikemisi, Nebukadinezara mwami wa-Babuloni mbaakazunda mumwaka wane wabwami bwa-Jehoyakimu mwana wa-Josiya mwami wa-Juda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.2",
            "verseOrgIds": [
              "JER.46.2"
            ]
          }
        }
      ]
    },
