              },
              "items": [
                {
                  "text": "Is 29:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ulaya bupoota mbuli inzoka, nkaambo basinkondonyina baleenda anguzu, bamusikila atuleba, mbuli basikugonka misamu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.22",
            "verseOrgIds": [
              "JER.46.22"
            ]
          }
        },
        {
