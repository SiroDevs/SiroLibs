            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaaya makani aa-Jehova aakasika kuli-Jeremiya musinsimi aabamasi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.1",
            "verseOrgIds": [
              "JER.46.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
