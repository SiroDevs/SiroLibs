              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaaya makani aakasika kuli-Jeremiya kuzwa kuli-Jehova. Wakati, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.1",
            "verseOrgIds": [
              "JER.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buka, ukaseluke kuŋanda yamubumbi, lino njookuswiilizya majwi aangu nkukonya oko. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.2",
            "verseOrgIds": [
              "JER.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo ndakaseluka kuŋanda yamubumbi, nkabela ndakabona kuti ulabeleka milimo kumuncini wakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.3",
            "verseOrgIds": [
              "JER.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.11.15"
              },
              "items": [
                {
                  "text": "Rom 11:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino cilongo ncaakali kubumbya bulongo cakabija mujanza lyamubumbi, aboobo wakacibumbulula akucita cimbi icakalulama mumeso aamubumbi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.4",
            "verseOrgIds": [
              "JER.18.4"
            ]
          }
        }
      ]
