        },
        {
          "text": "pele cisi eco ncindaamba cilaleka bubi bwaco, lino ambebo ndakonzya kuleka mapenzi ngendakali kukanza kucicitila. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.8",
