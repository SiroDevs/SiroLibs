          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi kufumbwa ciindi nindaamba aamusyobo na aacisi kuti njoociyaka akucisimpika, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.9",
            "verseOrgIds": [
              "JER.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "pele cilatalika kubisya mumeso aangu akuleka kuswiilila ijwi lyangu, lino njooleka bubotu boonse mbundakali kukanza kucicitila. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.10",
            "verseOrgIds": [
              "JER.18.10"
            ]
          }
        },
