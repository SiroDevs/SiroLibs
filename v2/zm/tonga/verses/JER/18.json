              "items": [
                {
                  "text": "1 Kor 5:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kako mbuboobu mbwaamba Jehova. Amubuzye akati kabamasi, Nguni uumvwide makani aali boobu? Mwana musimbi wa-Israyeli wacita cintu ciyoosya loko. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.13",
            "verseOrgIds": [
              "JER.18.13"
            ]
          }
        },
        {
