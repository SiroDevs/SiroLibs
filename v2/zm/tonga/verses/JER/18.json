          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sa caanda caku-Lebano cilamana kumandomba aakuSirioni? Sa maanzi aatontola aatulonga tukunkisya muzilundu alayuminina? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.14",
            "verseOrgIds": [
