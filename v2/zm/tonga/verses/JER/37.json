              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo ijwi lya-Jehova lyakasika kuli-Jeremiya musinsimi, liti, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.6",
            "verseOrgIds": [
