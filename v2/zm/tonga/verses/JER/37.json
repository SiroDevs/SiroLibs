                "loc": "JER.21.2"
              },
              "items": [
                {
                  "text": "Jer 21:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbuboobu mbwaamba Jehova Leza wa-Israyeli. Mbuboobu mbumweelede kwaambila mwami wa-Juda iwakamutuma kulindime kuyoobuzya makani. Ncobeni impi ya-Farao iiza kukumugwasya ilapiluka kunyika yabo beni, ku-Egepita. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.7",
            "verseOrgIds": [
              "JER.37.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
