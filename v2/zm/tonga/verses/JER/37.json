              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino impi yaba-Kasidi niyakaleka kusinkinizya Jerusalemu nkaambo kampi ya-Farao, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.11",
            "verseOrgIds": [
              "JER.37.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 37:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeremiya wakazwa mu-Jerusalemu kuti aye kucisi caBenjamini kuyoovola caabilo cakwe akati kabantu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.12",
            "verseOrgIds": [
              "JER.37.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 37:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino naakali kumulyango wa-Benjamini, kakuli mulindizi, izina lyakwe kali Irija mwana waSelemiya mwana wa-Hananiya, Oyu muntu wakajata Jeremiya musinsimi, wati, Wacijila kuli ba-Kasidi! ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.13",
            "verseOrgIds": [
              "JER.37.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 37:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Jeremiya wakavuwa kuti, Wabeja. Nsicijili kuliba-Kasidi pe. Pele Irija wakakaka kumvwa, wajata Jeremiya, wamusisya kulibasilutwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.14",
            "verseOrgIds": [
              "JER.37.14"
            ]
          }
        },
