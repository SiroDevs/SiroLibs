        },
        {
          "text": "Aboobo Jeremiya wakanjila muŋanda yamumulindi, mutwaanda twakunsi, nkabela wakalikede nkuko mazuba manji.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.16",
            "verseOrgIds": [
              "JER.37.16"
            ]
          }
        }
      ]
    },
