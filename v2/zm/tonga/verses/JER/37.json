              "type": "tag",
              "attrs": {
                "loc": "JER.34.21"
              },
              "items": [
                {
                  "text": "Jer 34:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ayalo impi ya-Farao yakazwa ku-Egepita, nkabela ba-Kasidi ibakali mukusinkinizya Jerusalemu nibakamvwa impuwo yayo, bakaleka kusinkinizya Jerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.5",
            "verseOrgIds": [
              "JER.37.5"
            ]
