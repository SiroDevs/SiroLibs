        },
        {
          "text": "Lino mwami Zedekiya wakatuma Jehukali mwana wa-Selemiya aZefaniya mwana wa-Maaseya mupaizi kuli-Jeremiya musinsimi, wati, Utukombele kuli-Jehova Leza wesu, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.3",
            "verseOrgIds": [
              "JER.37.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 37:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeremiya wakacili kuya bweendeenda akati kabantu. Kabatana kumubika muntolongo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.4",
            "verseOrgIds": [
              "JER.37.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
