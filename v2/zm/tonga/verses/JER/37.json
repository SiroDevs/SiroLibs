              "attrs": {
                "loc": "JER.34.22"
              },
              "items": [
                {
                  "text": "Jer 34:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela ba-Kasidi bazooboola alimwi kuzoolwisya munzi uno, bazoouzunda akuutenta mumulilo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.8",
            "verseOrgIds": [
              "JER.37.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 37:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuboobu mbwaamba Jehova. Mutalyeeni. Mutayeeyi kuti ba-Kasidi bayoomuleka, nkaambo tabakooyoomuleka pe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.9",
            "verseOrgIds": [
              "JER.37.9"
            ]
          }
        },
        {
