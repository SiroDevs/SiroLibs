                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ncobeni nekuba kuti mwazunda impi yoonse yaba-Kasidi bamulwisya, alimwi kuyoosyaala akati kabo bantu bayasidwe luzutu, umwi aumwi mucilao cakwe, bayoobuka akutenta munzi uno amulilo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.10",
            "verseOrgIds": [
              "JER.37.10"
            ]
