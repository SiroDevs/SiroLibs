          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.9.13"
              },
              "items": [
                {
                  "text": "Is 9:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.5.3"
              },
              "items": [
                {
                  "text": "Jer 5:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndabapupuluzya acipupuluzyo mumilyango yanyika. Ndabajayila bana babo, ndabanyonyoona, aba bantu bangu batapiluki kuzwa munzila zyabo mobaleede. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.7",
            "verseOrgIds": [
              "JER.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndavuzya mweelwe wabamukabafu babo kwiinda musenga wakunkomwe yalwizi. Ndasisya kumanyina bakubusi babo sikunyonyoona ciindi casikati. Kupenga akukankama kwaongomoka kubajata, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.8",
            "verseOrgIds": [
              "JER.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.2.5"
              },
              "items": [
                {
                  "text": "1 Sam 2:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.47.9"
