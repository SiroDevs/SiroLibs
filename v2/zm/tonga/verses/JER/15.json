              "items": [
                {
                  "text": "Jer 17:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Imbono zyako azintu zyako ziyandisi zyoonse ndazipa kuti zibe zisaalo zyakubweza buyo, nkaambo kazibi zyoonse nzocitide moonse munyika yako. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.13",
