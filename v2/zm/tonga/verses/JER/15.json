                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela njoocita kuti ubelekele basinkondonyoko milimo munyika njotezi, nkaambo mubukali bwangu kwadukulwa mulilo uuyoomutenta.",
          "type": "text",
          "attrs": {
