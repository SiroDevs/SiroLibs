            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maawe! Bama bangu! Nkaambonzi mwakandizyala kuti mbe muntu wankondo, muntu wakukazyanya kubantu boonse banyika? Nsina kukolotya nikuba kukolota, pele boonse buyo balandituka. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.10",
            "verseOrgIds": [
              "JER.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akube mbuli matusi aabo, O Jehova, na nsina kubakombela kunembo lyako kukubagwasya, na nsina kukombela basinkondoma muciindi camapenzi aabo amuciindi camafwabi aabo! ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.11",
            "verseOrgIds": [
              "JER.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sa butale bulapwayika, butale buzwa kunyika, amukuba?",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.12",
            "verseOrgIds": [
              "JER.15.12"
            ]
          }
        }
      ]
