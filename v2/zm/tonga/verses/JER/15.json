          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.13.14"
              },
              "items": [
                {
                  "text": "Hos 13:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wanditakata mebo, mbwaamba Jehova, wapiluka musule. Nciceeco ncindakutandabikila ijanza lyangu kukunyonyoona. Ndacimwa kukulekelela. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.6",
            "verseOrgIds": [
              "JER.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 15:7"
          },
          "items": [
            {
              "text": "7",
