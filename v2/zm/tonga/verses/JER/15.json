                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.8.9"
              },
              "items": [
                {
                  "text": "Am 8:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Oyo uuzyede bana bali musanu ababili woongelwa, wawizuka. Izuba lyamubbilila kalicili isikati. Wausigwa insoni abweeme. Abamwi babo basyeede njoobaaba kuti bajazigwe ipanga lyabasinkondonyina, mbwaamba Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.9",
            "verseOrgIds": [
              "JER.15.9"
            ]
          }
        }
      ]
