                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.10"
              },
              "items": [
                {
                  "text": "Ciy 13:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela na bakubuzya kuti, Ino tuye kuli? uleelede kubaambila kuti, Mbuboobu mbwaamba Jehova. Kufumbwa uubikilwa lufu, aye kulufu. Kufumbwa uubikilwa ipanga aye kupanga. Kufumbwa uubikilwa inzala aye inzala nkwiibede. Ayooyo uubikilwa buzike aye kubuzike. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.2",
            "verseOrgIds": [
              "JER.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 15:3"
          },
          "items": [
