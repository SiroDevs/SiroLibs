              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.26.16"
              },
              "items": [
                {
                  "text": "Lev 26:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.26"
              },
              "items": [
                {
                  "text": "Dt 28:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Njoobabambila basikunyonyoona bamisyobo yone, mbwaamba Jehova, nkukuti ipanga lyakujazya, babwa ­bakukwamauna, bayuni bakujulu abanyama baansi bakulya akunyonyoona. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.3",
            "verseOrgIds": [
              "JER.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 15:4"
          },
