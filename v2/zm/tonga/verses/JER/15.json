                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela njoobabika kuti babe cintu cigambya kuzisi zyoonse zyaansi, nkaambo ka-Manase mwana wa-Hezekiya mwami wa-Juda, nkaambo kamilimo yakwe njaakacita mu-Jerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.4",
            "verseOrgIds": [
              "JER.15.4"
            ]
          }
        }
