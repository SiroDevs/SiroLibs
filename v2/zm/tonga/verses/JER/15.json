              "items": [
                {
                  "text": "1 Sam 7:5-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Jehova wakandaambila kuti, Nekuba kuti Musa a-Samuele bakali kwiima kubusyu bwangu, moyo wangu wakakaka bantu aba. Kobatanda, bainke kuzwa kumeso aangu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.1",
            "verseOrgIds": [
              "JER.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
