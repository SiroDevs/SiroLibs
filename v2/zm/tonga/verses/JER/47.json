                "loc": "EZK.21.3"
              },
              "items": [
                {
                  "text": "Ezk 21:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akaka, O panga lya-Jehova, uyooleka lili kukaka kuumuna? Piluka mumukutu wako, ukapumune akutontola. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.6",
            "verseOrgIds": [
              "JER.47.6"
            ]
