              "type": "tag",
              "attrs": {
                "loc": "MIC.6.9"
              },
              "items": [
                {
                  "text": "Mik 6:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma! Lilakonzya kuumuna buti? Jehova nguwalipa mulazyo wakulwisya Asikeloni ankomwe yalwizi. Ngonguwe wakali tuma.",
          "type": "text",
          "attrs": {
