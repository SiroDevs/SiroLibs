                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gaza waba alubala, Asikeloni wanyonyooka. Inywe nuba-Anakimu bacisyeede, muyooleka lili kulinengaula? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.5",
            "verseOrgIds": [
              "JER.47.5"
            ]
          }
        },
        {
