                "loc": "NAM.3.2"
              },
              "items": [
                {
                  "text": "Nah 3:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Imvwigwe buyo misindo yansumba zyambizi zyakwe, akukonkonzya kwankalaki zyakwe, akutendeleka kwamavili aakwe, bantu tabacebuki nikuba kugwasya bana babo, nkaambo maanza aabo matete, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.3",
            "verseOrgIds": [
              "JER.47.3"
            ]
          }
        },
