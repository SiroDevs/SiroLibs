                "loc": "JER.32.33"
              },
              "items": [
                {
                  "text": "Jer 32:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbuboobu mbwaamba Jehova wamakamu Leza wa-Israyeli. Koya ukaambile bantu ba-Juda abaabo bakede mu-Jerusalemu kuti, Sa tamukonzyi kulayigwa kuswiilila majwi aangu? mbwaamba Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.13",
            "verseOrgIds": [
              "JER.35.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
