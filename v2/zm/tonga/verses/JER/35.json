              "attrs": {
                "loc": "PRO.3.16"
              },
              "items": [
                {
                  "text": "Tus 3:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.6.2"
              },
              "items": [
                {
                  "text": "Ef 6:2",
                  "type": "text"
                }
