              },
              "items": [
                {
                  "text": "1 Bam 6:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Koya kuŋanda yaba-Rekabu, ukaambaule abo, alimwi kobaleta muŋanda yaJehova mukaanda kamwi akubanywisya waini. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.2",
            "verseOrgIds": [
              "JER.35.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo ndakatolelela Jazaniya mwana wa-Jeremiya mwana wa-Habazinya abana bakwabo abana bakwe boonse aluzubo loonse lwaba-Rekabu, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.3",
            "verseOrgIds": [
              "JER.35.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.12.9"
              },
              "items": [
                {
                  "text": "2 Bam 12:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.9.18"
              },
              "items": [
                {
                  "text": "1 Mak 9:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.9.19"
              },
              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ndabanjizya muŋanda yaJehova, mukaanda kabana ba-Hanani mwana wa-Gedaliya muntu wa-Leza, kalibambene akaanda kabasilutwe, kali ajulu lyakaanda ka-Maaseya mwana wa-Salumu sikulindila mulyango. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.4",
            "verseOrgIds": [
              "JER.35.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela ndakabikila bana baluzubo lwaba-Rekabu nongo zizwide waini ankomeki zyakunywida, lino ndaka baambila kuti, Amunywe waini. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.5",
            "verseOrgIds": [
              "JER.35.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.35.2"
              },
              "items": [
                {
                  "text": "Jer 35:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele bakati, Tatukonzyi kunywa waini pe, nkaambo Jonadabu mwana wa-Rekabu tateesu wakatulailila kuti, Tamweelede kunywa waini pe, nimuba ndinywe nibaba bana banu lyoonse mane kukabe kutamani. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.6",
            "verseOrgIds": [
              "JER.35.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
