              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo ijwi lya-Jehova lyakasikila Jeremiya, liti, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.12",
            "verseOrgIds": [
              "JER.35.12"
            ]
          }
        },
        {
