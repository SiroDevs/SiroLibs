              },
              "items": [
                {
                  "text": "Jer 7:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azuzikizigwa majwi aaJonadabu mwana wa-Rekabu ngaakalailila bana bakwe kuti batanywi waini. Tabanywi pe abuniini asunu, nkaambo balalemeka mulazyo wawisaabo. Pele mebo, nekuba kuti ndakasungwaala kumwaambila makani ciindi coonse, tamundiswiilili pe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.14",
            "verseOrgIds": [
              "JER.35.14"
            ]
          }
        },
