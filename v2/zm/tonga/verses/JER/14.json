              "items": [
                {
                  "text": "Mik 3:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nekuba kuti baliimya kulya, nsikooyooswiilila lukwiilo lwabo pe. Nekuba kuti batuula zipaizyo azituuzyo zyabusu, nsikooyoozitambula pe, Njoobamanya ipanga apamba amalwazi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.12",
