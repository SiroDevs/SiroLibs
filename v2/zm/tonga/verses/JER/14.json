            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nekuba kuti zibi zyesu zilatupa kaambo, kocita mbulyeelede izina lyako, Jehova, nkaambo indeyo zyesu nzinji, ncobeni twakubisizya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.7",
            "verseOrgIds": [
              "JER.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
