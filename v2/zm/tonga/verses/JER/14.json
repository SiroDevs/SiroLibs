              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Jehova wakandaambila kuti, Utakombeli bantu aba kuti bajane coolwe pe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.11",
            "verseOrgIds": [
              "JER.14.11"
            ]
          }
