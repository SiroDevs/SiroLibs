            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo ndakati, Akaka, Mwami Jehova! Bona basinsimi mbubali mukubaambila kuti, Tamukooyoobona inkondo pe, alyalo ipamba talikooyoobonwa akati kanu, pele njoomupa luumuno lwakasimpe mubusena obuno. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.13",
            "verseOrgIds": [
              "JER.14.13"
            ]
          }
        },
        {
