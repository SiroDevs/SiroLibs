                  "text": "Tus 21:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Cisi ca-Juda cilalila, Mumilyango yaco bantu balatuntuma, balikede ansi, balisamine zisia, Kulila kwa-Jerusalemu kwamvwigwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.2",
            "verseOrgIds": [
              "JER.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.40.14"
              },
              "items": [
                {
                  "text": "Int 40:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.15.30"
              },
              "items": [
                {
                  "text": "2 Sam 15:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basilutwe balatuma baniini babo kuti bateke maanzi, pele basika buyo kumikalo, tabajani maanzi pe, aboobo balapiluka antesyo zitakwe cintu. Balausa insoni, balausa bweeme, balalivumba kumutwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.3",
            "verseOrgIds": [
              "JER.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basikulima nyika bapengesya nkaambo kakutalokelwa imvula, basimapulazi bafwa insoni, balalivumba kumutwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.4",
            "verseOrgIds": [
              "JER.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Insya yamusokwe ayalo ilatakata mwana nguyazyala nkaambo kakuti taakwe mweemvwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.5",
            "verseOrgIds": [
              "JER.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.2.24"
              },
              "items": [
                {
                  "text": "Jer 2:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Imbongolo zyamusokwe ziliimvwi atala lyabalubulansuki, zilafweketa mbuli bamwaaba; meso aazyo akataala kukuyandaula zyakucela.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.6",
            "verseOrgIds": [
              "JER.14.6"
            ]
          }
        }
      ]
    },
