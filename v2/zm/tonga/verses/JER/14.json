                }
              ]
            }
          ]
        },
        {
          "text": "Lino mbuboobu Jehova mbwaamba aabasinsimi basinsima muzina lyangu nekuba kuti nsina kubatuma, baamba kuti takukooyooba inkondo niliba ipamba omuno munyika, Abo basinsimi bayoojazigwa zintu ezi nzizyonya, inkondo apamba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.15",
            "verseOrgIds": [
