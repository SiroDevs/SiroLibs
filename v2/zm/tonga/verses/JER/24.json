          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njoobatumina ipanga anzala amalwazi mane lumwi bakanyonyooke mpoonya awo anyika eyo njindakabapa balo abamawisaabo.",
          "type": "text",
