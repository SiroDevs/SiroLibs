                  "text": "Int 44:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Njoobabika kuti babe ciyoosyo kuzisi zyoonse zyanyika, izina lyabo libe lusampauko akasimpi, ijwi lyakuweezya alyakutukizya, akati kabamasi boonse nkubatandidwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.9",
            "verseOrgIds": [
              "JER.24.9"
            ]
          }
        },
