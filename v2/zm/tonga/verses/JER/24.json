        },
        {
          "text": "Lino Nebukadinezara mwami wa-Babuloni naakamana kugwisya bantu kuzwa ku-Jerusalemu, nkukuti Jekoniya mwana wa-Jehoyakimu mwami wa-Juda abasilutwe ba-Juda abasimilimo abafuzi boonse, akubatola mubuzike ku-Babuloni, Jehova wakandipa cilengano cantwida zyobile zyankuyu zilitulidwe kunembo lyantempele ya-Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.1",
            "verseOrgIds": [
              "JER.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Intwida imwi kiijisi inkuyu imbotu loko, mbubonya mbuli inkuyu iitaanguna kubizwa, pele intwida yabili kiijisi inkuyu imbi loko, zitakonzyi kuligwa nkaambo kabubi bwazyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.2",
            "verseOrgIds": [
              "JER.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Jehova wakandibuzya kuti, Ncinzi ncobona, Jeremiya? Ndakati, Ndabona inkuyu; inkuyu zimwi nzibotu loko, ankuyu zimwi nzibi loko zitakonzyi kuligwa nkaambo kabubi bwazyo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.3",
            "verseOrgIds": [
              "JER.24.3"
            ]
          }
        }
      ]
