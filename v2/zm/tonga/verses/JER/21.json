              "items": [
                {
                  "text": "2 Mak 36:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino kusule lyayaaya, mbwaamba Jehova, njooaba Zedekiya mwami wa-Juda abalanda bakwe abantu bacisyeede mumunzi uno batana kumanisigwa bulwazi niiba inkondo niliba ipamba, njoobaaba mumaanza aa-Nebukadinezara mwami wa-Babuloni amumaanza aabasinkondonyina amumaanza aabaabo bayanda kubajaya, elyo uyoobajazya mulomo wapanga. Takooyoobaleka nikuba kubafwida buuya nikuba kubafwida luzyalo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.7",
            "verseOrgIds": [
              "JER.21.7"
            ]
          }
        }
