                  "text": "Int 101:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "O luzubo lwa-Davida, mbuboobu mbwaamba Jehova. Amubeteke kabotu cifumofumo. Amuvune oyo uubbididwe mumaanza aasikubba, inga bukali bwangu bunoobuka mbuli mulilo akuyakisya cakubula uuzimya, nkaambo kabubi bwamilimo yanu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.12",
            "verseOrgIds": [
