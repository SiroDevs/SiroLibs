                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bakwesu, amuyeeye kuti ncoolwe cipati na mwasikilwa masukusyo aamisyobo misyobo, ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.2",
            "verseOrgIds": [
              "JAS.1.2"
            ]
