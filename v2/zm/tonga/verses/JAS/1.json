            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele na nkwali akati kanu uubula busongo, akumbile kuli-Leza, uubaabila boonse cabuuya acakutatongauka, nkabela ulabupegwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.5",
            "verseOrgIds": [
              "JAS.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JAS 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
