              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.1.7"
              },
              "items": [
                {
                  "text": "1 Pet 1:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nkaambo mulizi kuti kusukusigwa kwalusyomo lwanu nkokuleta lukakatilo. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.3",
            "verseOrgIds": [
              "JAS.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JAS 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno lukakatilo alukalondole mulimo walo woonse, kuti mube balondosi akuba aciimo cizulide cakutabula cintu.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.4",
            "verseOrgIds": [
              "JAS.1.4"
            ]
          }
        }
      ]
    },
