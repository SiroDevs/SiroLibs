              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.1.24"
              },
              "items": [
                {
                  "text": "1 Pet 1:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "pele muvubi abotelwe kukucesegwa kwakwe, nkaambo kakuti bavubi bayoomaninina mbuli malangalanga aamusokwe, ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.10",
            "verseOrgIds": [
              "JAS.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JAS 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo izuba lyapasula acisansa, cilayumya mani, nkabela malangalanga aao alayuminina, abweebesi bwao bulamaninina, Mbubonya obo amuvubi ulanyana mukweenda kwakwe.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.11",
            "verseOrgIds": [
              "JAS.1.11"
            ]
          }
        }
