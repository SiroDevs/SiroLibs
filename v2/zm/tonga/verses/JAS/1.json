                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ngusicoolwe oyo muntu uukakatila mumasukusyo, nkaambo na wabonwa kuti muyumu, ulapegwa musini wabuumi, ngwaakasyomezya Mwami kulibaabo bamuyanda. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.12",
            "verseOrgIds": [
              "JAS.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JAS 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na muntu watepaulwa, ataambi kuti, Ndatepaulwa kuli-Leza, nkaambo Leza tatepauliki kucibi, alimwi walo mwini tatepauli muntu pe. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.13",
            "verseOrgIds": [
              "JAS.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JAS 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.7.7+ROM.7.8+ROM.7.9+ROM.7.10"
              },
              "items": [
                {
                  "text": "Rom 7:7-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Muntu ulatepaulwa na alengawidwa akoongwa kuzisusi zyakwe mwini. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.14",
            "verseOrgIds": [
              "JAS.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JAS 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno zisusi zyamita buyo, zilazyala zibi, azyalo zibi zyakomena zilatumbuka lufu. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.15",
            "verseOrgIds": [
              "JAS.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JAS 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muteeneki, nobakwesu bayandwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.16",
            "verseOrgIds": [
              "JAS.1.16"
            ]
          }
        },
