            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mukwesu mucete abotelwe asumpulwa, ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.9",
            "verseOrgIds": [
              "JAS.1.9"
            ]
          }
        },
