                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anywebo amukazike myoyo yanu, amuliyumye, nkaambo kuboola kwa-Mwami kuli afwaafwi. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.8",
            "verseOrgIds": [
