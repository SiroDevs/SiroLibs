                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kukomba kwalusyomo kulamuponya mulwazi oyo, Mwami ulamubusya, nkabela kufumbwa zibi nzyaakacita zilajatilwa, ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.15",
