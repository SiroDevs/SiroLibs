              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amulyaambe zibi zyanu umwi aumwi kumweenzinyina, alimwi amukombelane, kuti mukapone, Kuli anguzu zinji loko kukomba kwakusinizya kwamuntu uululeme. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.16",
            "verseOrgIds": [
              "JAS.5.16"
            ]
          }
        },
