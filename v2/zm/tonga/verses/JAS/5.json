          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutatongaukani nobakwesu, kuti mutabetekwi. Amubone, mubetesi uliimvwi amulyango. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.9",
            "verseOrgIds": [
