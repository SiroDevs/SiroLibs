          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.4",
            "verseOrgIds": [
              "JAS.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JAS 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
