          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele yebo omuntu wabuyo, sa ulayanda kuziba kuti lusyomo lwaanzeene kumilimo lulifwide buyo? ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.20",
