                {
                  "text": "Mt 5:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.18.30"
              },
              "items": [
                {
                  "text": "18:30",
