                "loc": "MAT.25.46"
              },
              "items": [
                {
                  "text": "46",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo lubeta talujisi lweetelelo kuliyooyo uuteeteleli mweenzinyina, Lweetelelo lulalilumbaizya amulubeta.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.13",
            "verseOrgIds": [
              "JAS.2.13"
            ]
          }
        }
      ]
