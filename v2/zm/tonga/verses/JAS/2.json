              "JAS.2.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.1.26"
              },
              "items": [
                {
                  "text": "1 Kor 1:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.21"
              },
              "items": [
                {
                  "text": "Lk 12:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amuswiilile nobakwesu bayandwa. Sa Leza takabasalide baambwa kuti mbacete ansi ano, kuti bakabe bavubi kulusyomo abaswaana babwami mbwaakasyomezya baabo bamuyanda? ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.5",
            "verseOrgIds": [
              "JAS.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JAS 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele nywebo mwamuubaula mucete. Sa bavubi embo mbobamupenzya akumutola beni kuzibetekelo? ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.6",
            "verseOrgIds": [
              "JAS.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JAS 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sa tabalisampauli izina idemu elyo ndemwaambwa alyo? ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.7",
            "verseOrgIds": [
              "JAS.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JAS 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.18"
              },
              "items": [
                {
                  "text": "Lev 19:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ncobeni na mwatobela mulao wa-Mwami uujanwa mumagwalo mujwi eli lyakuti, Yanda mweenzinyoko mbuli mboliyanda omwini, elyo mwacita kabotu. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.8",
            "verseOrgIds": [
              "JAS.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JAS 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.1.17"
              },
              "items": [
                {
                  "text": "Dt 1:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele na mwalanga zi ziimo zyabantu, mwabisya, nkaambo mulikonedwe kumulao kuti muli basotosi,",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.9",
            "verseOrgIds": [
              "JAS.2.9"
            ]
          }
        }
      ]
    },
    {
