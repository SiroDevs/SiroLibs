              "items": [
                {
                  "text": "Matl 22:1-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abrahamu taateesu sa takakalulamikwa kumilimo, mbwaakatuula Izaka mwanaakwe acipaililo? ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.21",
