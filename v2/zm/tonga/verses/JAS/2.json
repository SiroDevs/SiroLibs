                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.21.29"
              },
              "items": [
                {
                  "text": "21:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ino kulagwasya buti, nobakwesu, na muntu waamba kuti, Mebo ndijisi lusyomo, pele tajisi milimo? Sa lusyomo olo luyoomufutula? ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.14",
            "verseOrgIds": [
              "JAS.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JAS 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na musyominyina mwaalumi naba mwanakazi wabula zyakusama azilyo zyakulya, ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.15",
            "verseOrgIds": [
              "JAS.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JAS 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.3.17"
              },
              "items": [
                {
                  "text": "1 Joh 3:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "lino umwi akati kanu abaambila kuti, Kamuya aluumuno, mujane zyakulivumba azilyo zyakumukutya, nekubaboobo tabapi zintu nzyuuyanda mubili, ino kulagwasyanzi? ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.16",
            "verseOrgIds": [
              "JAS.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JAS 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbubonya obo lusyomo lutajisi milimo mbululi lulike, lulifwide buyo.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.17",
            "verseOrgIds": [
              "JAS.2.17"
            ]
          }
        }
      ]
    },
