        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.19"
              },
              "items": [
                {
                  "text": "Mt 5:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kufumbwa muntu uutobela milao yoonse, pele alubya cintu comwe, ulijisi mulandu kuli yoonse. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.10",
            "verseOrgIds": [
              "JAS.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JAS 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.13"
              },
              "items": [
                {
                  "text": "Kul 20:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.14"
              },
              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.17"
              },
              "items": [
                {
                  "text": "Dt 5:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.18"
              },
              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo oyo uwakaamba kuti, Utabi simamambe, ngonguwe wakaamba alyalo ijwi lyakuti, Utabi nojaya, Eno wataba simamambe pele wajaya, nkokuti wasotoka mulao. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.11",
            "verseOrgIds": [
              "JAS.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JAS 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.1.25"
              },
              "items": [
                {
                  "text": "Jak 1:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amwaambe akucita lyoonse mbuli mbubeelede bantu bayandoobetekwa kumulao wabulubusi. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.12",
            "verseOrgIds": [
              "JAS.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JAS 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
