                "loc": "LEV.19.9+LEV.19.10"
              },
              "items": [
                {
                  "text": "Lev 19:9-10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.23.22"
