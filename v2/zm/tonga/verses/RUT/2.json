                "loc": "DEU.24.19"
              },
              "items": [
                {
                  "text": "Dt 24:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Rute mu­-Moabu wakaambila Naomi kuti, Nje kumyuunda, nkavulule akati kamakunka aamaila, nkatobele kufumbwa muntu uundifwida luzyalo. Mpawo wakamuvwiila kuti, Mbubo, koya mwanaangu. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.2",
            "verseOrgIds": [
              "RUT.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "RUT 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aboobo wakaya, wasika kumyuunda, wavulula uya butobela basikutebula. Nkabela mucoolwe cakwe wakasika kucipanzi camuunda icakali ca-Boazi siluzubonyina Elimeleki. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.3",
            "verseOrgIds": [
              "RUT.2.3"
            ]
          }
        },
        {
          "name": "verse",
