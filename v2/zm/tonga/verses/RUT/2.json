          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino kuciindi cakulya, Boazi wakamwaambila kuti, Swena okuno, ulye insima, akusunsa munsuma wako mumusinza. Aboobo wakakala kumbali lyabasikutebula, elyo wakamutambika musozya, nkabela wakalya, wakuta, waleka. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.14",
            "verseOrgIds": [
              "RUT.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "RUT 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino naakanyampuka kuya kukuvulula, Boazi wakalailila balombe bakwe kuti, Avulule koonse koonse, naaba akati kamisunta yamaila. Mutamukasyi pe. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.15",
            "verseOrgIds": [
              "RUT.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "RUT 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi amunonkole inkankamaanza ankankamaanza, mumusiile nzizyo, azibweze. Mutamukalalili pe.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.16",
            "verseOrgIds": [
              "RUT.2.16"
            ]
          }
        }
      ]
