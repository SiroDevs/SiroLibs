              "items": [
                {
                  "text": "1 Sam 25:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amvwe obo wakavundama ansi akumukotamina, wamwaambila kuti, Ino nkaambonzi ndajana buuya kulinduwe? Nkaambonzi nowandigwasya, nekuba kuti ndi mweenzu buyo? ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.10",
            "verseOrgIds": [
              "RUT.2.10"
            ]
