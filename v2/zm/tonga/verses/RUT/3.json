              "items": [
                {
                  "text": "Heb 6:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ona masiku ano, lino bwaca buyo, na oyo muntu ulazumina kukucitila ceelelo cabusiluzubonyoko, ncibotu, pele na moyo wakwe tuuyandi kukucitila ceelelo cabusiluzubonyoko, lino Jehova mbali muumi, nzoocita mebo. Lala, mane bukace.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.13",
            "verseOrgIds": [
