                  "text": "31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino utayoowi mwanaangu. Coonse cili buti ncoamba, nzoocicita, nkaambo basimunzima boonse balizi kuti uli mwanakazi uuzyalikene. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.11",
            "verseOrgIds": [
              "RUT.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "RUT 3:12"
