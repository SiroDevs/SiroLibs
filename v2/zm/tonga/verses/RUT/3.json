              "items": [
                {
                  "text": "1 Tes 4:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino ndime siluzubonyoko ncobeni, pele nkwali siluzubonyoko aumwi waafwiifwi kwiinda ndime. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.12",
            "verseOrgIds": [
              "RUT.3.12"
            ]
          }
        },
