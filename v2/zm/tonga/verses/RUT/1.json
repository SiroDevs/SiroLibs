          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele Rute wakavuwa kuti, Utandisungilizyi kukusia nanka kuleka kukutobela, nkaambo kufumbwa nkoya yebo ndaya ambebo, nkoyookala yebo njookala ambebo. Bantu bako bayooba bantu bangu, a-Leza wako uyooba Leza wangu. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.16",
            "verseOrgIds": [
              "RUT.1.16"
            ]
          }
        },
