                  "text": "2 Bam 6:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kufumbwa nkoyoofwida njoofwida ambebo nkuko akuzikwa nkukonya. Leza andicitile mbubonya akwiinda na ndazumizya cintu neciba cimwi cita lufu luzutu kundaanzanya ayebo. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.17",
            "verseOrgIds": [
