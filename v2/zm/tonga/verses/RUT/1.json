                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.3.30"
              },
              "items": [
                {
                  "text": "Bab 3:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Izina lyamuntu oyo kali Elimeleki, amwanakazi wakwe kali Naomi, abana bakwe bobile bakali Maloni a-Kilioni. Bakali ba-Efrata bakuBetelehemu mucisi ca-Juda. Lino bakasika kunyika ya-Moabu akukalakala nkuko. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.2",
            "verseOrgIds": [
              "RUT.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "RUT 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nbabela Elimeleki mulumi wa-Naomi wakafwa, aboobo wakasyaala alike abana bakwe balombe bobile. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.3",
            "verseOrgIds": [
              "RUT.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "RUT 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino bakakwata banakazi bakucisi ca-Moabu. Izina lyaumwi kali Olipa, awabili kali Rute. Nkabela bakalikede nkukonya oko myaka iili mbuli ikumi. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.4",
            "verseOrgIds": [
              "RUT.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "RUT 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Maloni a-Kilioni bakafwa boonse bobile. Mwanakazi wakafwidwa mulumaakwe abana bakwe boonse bobile.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.5",
            "verseOrgIds": [
              "RUT.1.5"
            ]
          }
        }
      ]
