        },
        {
          "text": "Lino mumazuba alya babetesi nebakali kubeteka kwakaba inzala munyika, nkabela umwi muntu waku-Betelehemu mucisi ca-Juda wakainka kuyoo­ kala-kala munyika ya-Moabu, kali amwanakazi wakwe abana bakwe balombe bobile. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.1",
            "verseOrgIds": [
              "RUT.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "RUT 1:2"
          },
          "items": [
