        },
        {
          "text": "Lino bakati, Bona! Mukwatwanyoko wapiluka kulibanyina akumizimu yakwe. Piluka ayebo mbuli mukwatwanyoko. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.15",
