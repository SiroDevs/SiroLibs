              "attrs": {
                "loc": "DEU.25.5+DEU.25.6"
              },
              "items": [
                {
                  "text": "Dt 25:5-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alakwe Rute muMoabu muka-Maloni ndamuula, kuti abe mukaangu, abusye izina lyamufu mucaabilo cakwe, kuti izina lyamufu litalobi akati kababunyina nimuba mumulyango wamunzi wakwe. Ndinywe bakamboni buzuba obuno. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.10",
            "verseOrgIds": [
              "RUT.4.10"
            ]
          }
        },
