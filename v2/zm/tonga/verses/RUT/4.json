        },
        {
          "text": "Nkabela wakasala baalumi bali ikumi akati kabapati bamunzi, wabaambila kuti, Anywebo amukale okuno. Lino bakakala. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.2",
            "verseOrgIds": [
