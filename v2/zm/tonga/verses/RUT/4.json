            "sid": "RUT 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo wakaambila siluzubonyina kuti, Naomi waboola kuzwa kunyika ya-Moabu, lino waulisya caabilo canyika icakali ca-Elimeleki mukwesu. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.3",
            "verseOrgIds": [
              "RUT.4.3"
            ]
          }
