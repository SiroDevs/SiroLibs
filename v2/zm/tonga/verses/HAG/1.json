                }
              ]
            }
          ]
        },
        {
          "text": "Mumwaka wabili wamwami Dariyo, mumwezi wamusanu aumwi, mubuzuba butaanzi bwamwezi, ijwi lya-Jehova lyakasika ktunulomo wa­ Hagai musinsimi kuli-Zerubabeli mwana wa-Sealitiyeli mweendelezi wa-Juda, akuli-Joshua mwana wa-Jehozadaki mupaizi mupati. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.1",
            "verseOrgIds": [
              "HAG.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HAG 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati, Mbuboobu mbwaamba Jehova wamakamu. Aba bantu balaamba kuti ciindi cakuyakulula iŋanda ya-Jehova tacina kusika.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.2",
            "verseOrgIds": [
              "HAG.1.2"
            ]
          }
        }
      ]
    },
