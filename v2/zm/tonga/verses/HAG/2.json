              "items": [
                {
                  "text": "Tit 1:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Hagai wakati, Mbubonya obo mbucibede akubantu aba akucisi eci cili kubusyu bwangu, mbwaamba Jehova. Mbwiibede amilimo yoonse yamaanza aabo, acoonse ncibatuula cilisofweede. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.14",
            "verseOrgIds": [
              "HAG.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HAG 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAG.1.5"
              },
              "items": [
                {
                  "text": "Hag 1:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino amuyeeye citi kabe kuzwa kubuzuba obuno akuya kunembo. Kuciindi eco nikwakatalina kubikwa ibbwe niliba limwi alyeenzinyina muntempele ya-Jehova, mwakasikilwa nzi? ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.15",
            "verseOrgIds": [
              "HAG.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HAG 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu naalangila insuwo zyamaila zili makumi obile, kwakajanwa insuwo zili ikumi buyo. Muntu naakasika kudindi lyawaini kuti ateke nongo zili makumi osanwe, kwakajanwa makumi obile luzutu. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.16",
            "verseOrgIds": [
              "HAG.2.16"
            ]
          }
        },
