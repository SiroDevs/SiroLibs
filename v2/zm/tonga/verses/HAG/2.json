            "number": "2",
            "style": "v",
            "sid": "HAG 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakaambilwa kuti, Ambila Zerubabeli mwana wa-Sealitiyeli mweendelezi wa-Juda, a-Joshua mwana wa-Jehozadaki mupaizi mupati, abantu boonse basyeede, kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.2",
            "verseOrgIds": [
              "HAG.2.2"
            ]
          }
        },
