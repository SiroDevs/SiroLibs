                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.20.17"
              },
              "items": [
                {
                  "text": "Matl 20:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.7.25"
              },
              "items": [
                {
                  "text": "Heb 7:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.5.16"
              },
              "items": [
                {
                  "text": "Jak 5:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino, kamuya kuli-Jobu mulanda wangu, mutolelele abasune bali musanu ababili abagutu bali musanu ababili; amulipaizizye anzizyo cipaizyo euumpwe, elyo Jobu mulanda wangu uyocmupailila; akaambo kanguwe nsikamunyonyooni mbuli mbokweelede kutaloma kwanu; nkaambo teemwakaamba ciluzi andime mbuli mbwaakaamba Jobu mulanda wangu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.8",
            "verseOrgIds": [
              "JOB.42.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aboobo Elifazi waku-Tema, a-Bilidadi waku-Suwa, a-Zofari waku-Naama bakeenda akucita mbubonya mbwaakabaambila Jehova. Jehova wakatambula mupailo wa-Jobu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.9",
            "verseOrgIds": [
              "JOB.42.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 42:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.1.1+JOB.1.2+JOB.1.3"
              },
              "items": [
                {
                  "text": "Job 1:1-3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.40.2"
              },
              "items": [
                {
                  "text": "Is 40:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi Jobu naakapailila bazwalani bakwe, Jehova wakasandula zyoolwe zyakwe; Jehova wakapa tobile kuli-Jobu kwiinda nzyaakajisi kusaanguna. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.10",
            "verseOrgIds": [
              "JOB.42.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 42:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.19.13"
              },
              "items": [
                {
                  "text": "Job 19:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo bakeza kulinguwe banabakwabo, abacizi bakwe abazwalani bakwe bakaindi; bakaiya antoomwe alakwe muŋanda yakwe, bakamulwazya akumuumuzya akaambo kamapenzi Jehova ngaakamuletela; boonse umwi aumwi bakamupa idi anwenwe yangolida. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.11",
            "verseOrgIds": [
              "JOB.42.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 42:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.8.7"
              },
              "items": [
                {
                  "text": "Job 8:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.1.3"
              },
              "items": [
                {
                  "text": "1:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbubonya Leza mbwaakalongezya mamanino aabuumi bwa-Jobu kwiinda matalikilo; wakalijisi zyuulu zili kumi azyuulu zyone zyambelele, azyuulu zyosanwe acimwi zyankamele, azyuulu zyobile zyabasune, acuulu cambongolo-nzyazi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.12",
            "verseOrgIds": [
              "JOB.42.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 42:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakalijisi bana balombe bali musanu ababili abana basimbi botatwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.13",
            "verseOrgIds": [
              "JOB.42.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 42:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakaulika mupati izina kuti, ngu-Jemima, awabili Keziya, awatatu Kerenihapuki. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.14",
            "verseOrgIds": [
              "JOB.42.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 42:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyika yoonse teekwakajanwa basimbi beebeka mbuli bana ba-Jobu; wisi wakabapa kuti bakone lukono lwakwe mbuli banabakwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.15",
            "verseOrgIds": [
              "JOB.42.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 42:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.5.26"
              },
              "items": [
                {
                  "text": "Job 5:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Munsi lyakooku, Jobu waka pona myaka iili mwaanda amyaka iili makumi one; wakabona bana bakwe abana babo kusikila kumazyalani one. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.16",
            "verseOrgIds": [
              "JOB.42.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 42:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.25.8"
              },
              "items": [
                {
                  "text": "Matl 25:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo Jobu wakafwa, kacembeede, kaponede buumi bulamfu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.17",
            "verseOrgIds": [
              "JOB.42.17"
            ]
          }
        }
