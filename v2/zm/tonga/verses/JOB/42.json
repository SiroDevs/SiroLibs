              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Jobu wakamuvuwa Jehova, wati,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.1",
            "verseOrgIds": [
              "JOB.42.1"
            ]
          }
        }
      ]
    },
    {
