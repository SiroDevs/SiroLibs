            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino kusule lyayaaya Josefa wakaambilwa kuti, Sa tobwene kuti uso waciswa? Mpawo wakatolelela bana bakwe bobile Manase a-Efrai­ mu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.1",
            "verseOrgIds": [
              "GEN.48.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 48:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Jakobo wakalwiidwa kuti, Langa! Mwanaako Josefa wasika kuzookubona. Amvwe obo, Israyeli wakaliyumya-yumya, wanongomana abule. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.2",
            "verseOrgIds": [
              "GEN.48.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 48:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.28.13"
              },
              "items": [
                {
                  "text": "Matl 28:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.28.19"
              },
              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.35.6"
              },
              "items": [
                {
                  "text": "35:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.35.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Jakobo wakaambila Josefa kuti, Leza Singuzuzyoonse wakalibonya kulindime ku-Luzi munyika ya-Kanana, wandilongezya, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.3",
            "verseOrgIds": [
              "GEN.48.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 48:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.17.8"
              },
              "items": [
                {
                  "text": "Matl 17:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "wandaambila kuti, Ncobeni njookuzyazya loko, ube banji; njoocita kuti ube misyobo misyobo yabantu, alimwi nyika eyi njooipa lunyungu lwako, kuti lwiivube lyoonse alyoonse. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.4",
            "verseOrgIds": [
              "GEN.48.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 48:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
