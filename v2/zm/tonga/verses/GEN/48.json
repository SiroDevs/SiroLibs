              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.13.7"
              },
              "items": [
                {
                  "text": "Jos 13:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.14.4"
              },
              "items": [
                {
                  "text": "14:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino aba bana bako bobile mbowakazyala munyika ya-Egepita, nkentanasika kulinduwe okuno ku-Egepita, mbibangu, Efraimu a-Manase mbibangu mbubonya mbuli Rubeni aSimeoni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.5",
            "verseOrgIds": [
              "GEN.48.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 48:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alunyungu lwako ndoyoozyala musule lyabo ndolwako. Bayooulikwa mbuli mazina aabakulana babo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.6",
            "verseOrgIds": [
              "GEN.48.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.35.16+GEN.35.17+GEN.35.18+GEN.35.19"
              },
              "items": [
                {
                  "text": "Matl 35:16-19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo ciindi eco nindakazwa ku-Padani, ndakafwidwa Rakele munyika ya-Kanana, nitwakacili munzila, nikwakacisyeede kasinzo kusika ku-Efrata, nkabela ndakamuzika nkukonya oko munzila yakuya ku-Efrata (ngonguwo Betelehemu).",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.7",
            "verseOrgIds": [
              "GEN.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.7",
            "verseOrgIds": [
              "GEN.48.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 48:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Israyeli naakabona bana ba-Josefa, wakabuzya kuti, Ino mbani aba? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.8",
            "verseOrgIds": [
              "GEN.48.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 48:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.27.4"
              },
              "items": [
                {
                  "text": "Matl 27:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.33.5"
              },
              "items": [
                {
                  "text": "33:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Josefa wakavwiila wisi kuti, Mbombabo bana bangu Leza mbaakandipa okuno. Wakati, Wence balete kulindime, mbalongezye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.9",
            "verseOrgIds": [
              "GEN.48.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 48:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.27.1"
              },
              "items": [
                {
                  "text": "Matl 27:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.27.27"
              },
              "items": [
                {
                  "text": "27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela meso aa-Israyeli akali agubi nkaambo kakucembaala, katakonzya kubona. Elyo Josefa wakabaswenya afwiifwi, nkabela wakabamyonta, wabakumbata. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.10",
            "verseOrgIds": [
              "GEN.48.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 48:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.45.26"
              },
              "items": [
                {
                  "text": "Matl 45:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Israyeli wakaambila Josefa kuti, Teendakali kuyeeya kubona busyu bwako, pele Leza wandibonya alunyungu lwako. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.11",
            "verseOrgIds": [
              "GEN.48.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 48:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Josefa wakabagwisya kumazwi aakwe, walikotamika ansi cakuvundama. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.12",
            "verseOrgIds": [
              "GEN.48.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 48:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Josefa wakabeenzya boonse bobile, Efraimu mujanza lyakwe lyalulyo kuya kucimwensi cakwe ca-Israyeli, a-Manase mujanza lyakwe lyacimwensi kuya kululyo lwa-Israyeli, wabaswenya afwiifwi kulinguwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.13",
            "verseOrgIds": [
              "GEN.48.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 48:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo Israyeli wakatandabika ijanza lyakwe lyalulyo, wajata amutwe wa-Efraimu, ngonguwe mwanike, alyalo ijanza lyakwe lyacimwensi wakalijatya amutwe wa-Manase, aboobo wakapinganya maanza aakwe, nkaambo Manase kali mutaanzi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.14",
            "verseOrgIds": [
              "GEN.48.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 48:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.21"
              },
              "items": [
                {
                  "text": "Heb 11:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino wakalongezya Josefa, wati,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.15",
            "verseOrgIds": [
              "GEN.48.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
