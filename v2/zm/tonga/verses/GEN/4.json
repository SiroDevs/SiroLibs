            "sid": "GEN 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azina lyamwanike wakwe kali Jubali, ngonguwe wisaabo boonse balizya kantimbwa anyeele. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.21",
            "verseOrgIds": [
              "GEN.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alakwe Zila wakazyala Tubala-Kaini, ngonguwe iwakali kufula zibelesyo zyoonse zyamukuba azyabutale. Amucizi wa-Tubela-Kaini kali Naama.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.22",
            "verseOrgIds": [
              "GEN.4.22"
            ]
          }
        }
