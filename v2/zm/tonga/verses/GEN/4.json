                "loc": "JER.52.3"
              },
              "items": [
                {
                  "text": "52:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Kaini wakazwa kubusyu bwa-Jehova, waakukala munyika yaNodi iili kujwe lya-Edeni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.16",
            "verseOrgIds": [
              "GEN.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.49.11"
              },
              "items": [
                {
                  "text": "Int 49:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo Kaini wakaswanana amukaakwe, nkabela wakaminta, wazyala Enoki. Alimwi wakayaka munzi, lino oyo munzi wakauulika izina lya-Enoki mbubonya mbuli izina lyamwaanakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.17",
            "verseOrgIds": [
              "GEN.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Enoki alakwe wakazyalilwa Iradi, alakwe Iradi wakazyala Mehujaeli, alakwe Mehujaeli wakazyala Metusaeli, alakwe Metusaeli wakazyala Lameki. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.18",
            "verseOrgIds": [
              "GEN.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Lameki wakakwata banakazi bobile; izina lya umwi kali Ada, azina lyawabili kali Zila. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.19",
            "verseOrgIds": [
              "GEN.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Ada ngowakazyala jabali, ngonguwe wisaabo boonse bakala mumatente akweembela iŋombe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.20",
            "verseOrgIds": [
              "GEN.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
