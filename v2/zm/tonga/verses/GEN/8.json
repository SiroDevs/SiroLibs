        },
        {
          "text": "Lino Leza wakaibaluka Nowa abaumi boonse abanyama mbaakali abo mubwaato. Mpawo Leza wakaungya muuwo anyika, nkabela maanzi akatalika kuyosa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.1",
            "verseOrgIds": [
              "GEN.8.1"
            ]
          }
        },
        {
