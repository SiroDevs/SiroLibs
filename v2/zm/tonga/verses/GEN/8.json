        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.12",
            "verseOrgIds": [
              "GEN.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mumwaka wamyanda iili musanu aumwi amwaka omwe, mumwezi mutaanzi, mubuzuba butaanzi bwamumwezi, maanzi akayuminina ansi. Mpawo Nowa wakavumbula lululi lwabwaato, wasondela, wabona kuti nyika yayuma. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.13",
            "verseOrgIds": [
              "GEN.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela mumwezi wabili, mubuzuba bwakumi amusanu aibili bwamumwezi, nyika yakayuma ntantalu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.14",
            "verseOrgIds": [
              "GEN.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Leza wakaambila Nowa kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.15",
            "verseOrgIds": [
              "GEN.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.7.13"
              },
              "items": [
                {
                  "text": "Matl 7:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.121.8"
              },
              "items": [
                {
                  "text": "Int 121:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kamuzwa mubwaato, yebo abanako, abana bako abamukabana bako boonse. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.16",
            "verseOrgIds": [
              "GEN.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.1.22"
              },
              "items": [
                {
                  "text": "Matl 1:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Banyama boonse mboli abo bamisyobo misyobo, bayuni aŋombe abauka boonse bayavula ansi, uzwe abo, kuti babe isaula ansi, bazyalisye akuvula ansi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.17",
            "verseOrgIds": [
              "GEN.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo Nowa wakazwa abana bakwe abanakwe abamukabana bakwe boonse. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.18",
            "verseOrgIds": [
              "GEN.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banyama boonse, abauka boonse abayuni boonse, boonse baumi bamisyobo misyobo bayavula ansi, boonse biyo bakazwa mubwaato.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.19",
            "verseOrgIds": [
              "GEN.8.19"
            ]
          }
        }
      ]
    },
