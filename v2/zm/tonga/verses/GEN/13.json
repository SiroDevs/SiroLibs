              "items": [
                {
                  "text": "2 Pet 2:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele bantu ba-Sodoma bakali basizibi, bakali babi loko kumeso aa-Jehova,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.13",
            "verseOrgIds": [
