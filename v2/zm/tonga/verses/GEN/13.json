              "items": [
                {
                  "text": "Jak 3:13-18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sa nyika yoonse tiili kubusyu bwako na? Atupambukane ambebo, Na ulayanda kuya kucimwesi, mebo ndaya kululyo; na ulayanda kuya kululyo, mebo ndaya kucimwesi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.9",
            "verseOrgIds": [
