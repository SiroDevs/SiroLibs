              },
              "items": [
                {
                  "text": "Matl 19:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abramu kakede munyika ya-Kanana; Loti kakede muminzi yankwaalale, kaya buyakayaka zilao zyakwe mane wakasika ku-Sodoma. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.12",
            "verseOrgIds": [
              "GEN.13.12"
            ]
          }
