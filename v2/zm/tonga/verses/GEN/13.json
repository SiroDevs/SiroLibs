                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nkaambo nyika yoonse njowabona, njoipa nduwe alunyungu lwako, mane kukabe kutamani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.15",
            "verseOrgIds": [
              "GEN.13.15"
            ]
