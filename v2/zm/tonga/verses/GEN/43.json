          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo bantu bakayoowa nkaambo kakunjizigwa muŋanda ya-Josefa, bati, Nkaambo kamali aakaboozegwa mumasaka esu mulweendo lutaanzi, ncencico ncitwaletelwa. Ulayanda kutupa mulandu akutwaanga, atutole mubuzike swebo ambongolo zyesu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.18",
            "verseOrgIds": [
              "GEN.43.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 43:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino bakaswena kufwaafwi kumubambi waŋanda ya-Josefa akwaambaula awe kumulyango waŋanda. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.19",
            "verseOrgIds": [
              "GEN.43.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 43:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakati, Koswiilila, mwami. Ncobeni twakeza mulweendo lutaanzi kuzoosunza zilyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.20",
            "verseOrgIds": [
              "GEN.43.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
