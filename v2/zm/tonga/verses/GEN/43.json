                "loc": "GEN.42.35"
              },
              "items": [
                {
                  "text": "35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi amubweze mali aamwi mumaanza aanu. Mali aakapilusigwa mumilomo yamasaka amwaapilusye mumaanza aanu; ambweni bakaaluba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.12",
            "verseOrgIds": [
              "GEN.43.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 43:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amwanike wanu amumutole, munyamuke, mubweede kumuntu oyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.13",
            "verseOrgIds": [
              "GEN.43.13"
            ]
          }
        },
