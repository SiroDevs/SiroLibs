                {
                  "text": "Tus 14:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bakamuvwiila kuti, Mulanda wako wiseesu uli kabotu, ucipona. Elyo bakasintama, bakotama.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.28",
