                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo wakababuzya mbobapona, alimwi wababuzya kuti, Sa usowanu uli kabotu, munene ngomwakandaambila? Sa ucipona? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.27",
            "verseOrgIds": [
