              "items": [
                {
                  "text": "1 Tim 5:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino oyo muntu naakanjizya bantu muŋanda ya-Josefa, wakaleta maanzi kuti basambe kumaulu, alimwi wakasanina imbongolo zyabo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.24",
            "verseOrgIds": [
              "GEN.43.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
