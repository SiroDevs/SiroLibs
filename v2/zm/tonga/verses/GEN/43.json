              },
              "items": [
                {
                  "text": "Ezk 27:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpoonya awo Israyeli wisaabo wakabaambila kuti, Mbubo, kamuya, alimwi mbuboobu mbumweelede kucita, Amutolelele micelo yanyika muzibwe zelo zyanu, mutolele muntu cipo. Amutole tumabbona, atuci, atulisyo twanikoa, atununkilizyo twaladunu, andongo aminsomwa yamaalmondi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.11",
            "verseOrgIds": [
              "GEN.43.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 43:12"
          },
          "items": [
            {
