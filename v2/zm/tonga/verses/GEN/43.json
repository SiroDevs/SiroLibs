          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela bakabamba cipo kuti bape Josefa asika isikati, nkaambo bakamvwa kuti nkobazoolida insima ciindi casikati.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.25",
            "verseOrgIds": [
              "GEN.43.25"
            ]
