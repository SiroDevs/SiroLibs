            }
          ]
        },
        {
          "text": "Leza Singuzuzyoonse amu pe luzyalo mumeso aamuntu oyo, kuti aangunune munyoko wanu uusyeede antoomwe a-Benjamini. Na ndalobelwa bana bangu, ndaloba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.14",
            "verseOrgIds": [
              "GEN.43.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 43:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo bantu bakatolelela cipo eco, amali aambi mumaanza aabo a-Benjamini mwanike wabo, banyampuka, bainka kuEgepita, baakwiima kubusyu bwa-Josefa,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.15",
            "verseOrgIds": [
              "GEN.43.15"
            ]
          }
        }
      ]
