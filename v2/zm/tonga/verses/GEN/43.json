              },
              "items": [
                {
                  "text": "39:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Josefa naakabona kuti beza a-Benjamini, wakaambila mubambi waŋanda yakwe kuti, Njizya aba bantu muŋanda, alimwi jaya munyama, utubambile, nkaambo bantu aba baleelede kulya kulindime ciindi casikati. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.16",
            "verseOrgIds": [
              "GEN.43.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 43:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino oyo muntu wakacita mbubonya mbuli Josefa mbwaakalailila. Wakanjizya bantu muŋanda ya-Josefa. ",
          "type": "text",
          "attrs": {
