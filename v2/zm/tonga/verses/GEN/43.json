                  "text": "Kul 8:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela bakamubikila cakwe alike, abalo cabo abalike, aba-Egepita mbaakali kulya abo balike, nkaambo ba-Egepita tabakonzyi kulya insima mucilido comwe aba-Hebrayo, nkaambo kucita obo kulatondwa kuba-Egepita. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.32",
            "verseOrgIds": [
              "GEN.43.32"
            ]
          }
        },
