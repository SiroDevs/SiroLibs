                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amane kulila, wakasamba kumeso, wazwa, walisimyasimya, wati, Amubike cakulya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.31",
