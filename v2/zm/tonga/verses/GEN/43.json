          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela bakakazikwa kunembo lyakwe, mupati mbuli bupati bwakwe, muniini mbuli buniini bwakwe. Lino bantu bakali kulangana cakugamba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.33",
            "verseOrgIds": [
