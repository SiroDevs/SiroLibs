        {
          "text": "Lino Leza wakaamba kuti, Maanzi oonse aali ansi lyajulu ayoboloke antoomwe, kuti intundubwi iboneke, Nkabela kwakaba obo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.9",
            "verseOrgIds": [
