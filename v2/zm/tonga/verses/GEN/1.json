                  "text": "Int 74:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino mumuni Leza wakauulika kuti ndisikati, awalo mudima wakauulika kuti masiku. Aboobo kwakaba igoko, alimwi kwakaba cifumo, buzuba bomwe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.5",
            "verseOrgIds": [
              "GEN.1.5"
            ]
          }
        }
