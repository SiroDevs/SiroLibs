          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino intundubwi Leza wakaiulika kuti ninyika, aalo maanzi mpaakayobolokela wakaaulika kuti ndwizi. Nkabela Leza wakabona kuti ncintu cibotu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.10",
            "verseOrgIds": [
              "GEN.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
