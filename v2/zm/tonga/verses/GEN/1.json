        },
        {
          "text": "Lino Leza wakaamba kuti, Akube mulengalenga akatikati kamaanzi, uanzaanye maanzi amaanzinyina. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.6",
            "verseOrgIds": [
              "GEN.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
