                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Leza wakaamba kuti, nyika isyusye mweemvwe, azisyu zizyala imbuto, amisamu iizyala micelo, umwi aumwi mbuli musyobo wawo, iijisi imbuto mukati, atala anyika, Nkabela kwakaba obo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.11",
            "verseOrgIds": [
              "GEN.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
