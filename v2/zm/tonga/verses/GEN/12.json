              },
              "items": [
                {
                  "text": "Es 2:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela bapati baFarao nebakamubona, bakamutembaula kubusyu bwa-Farao, aboobo mwanakazi wakatolwa kuŋanda ya-Farao. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.15",
            "verseOrgIds": [
              "GEN.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alakwe Abramu wakacitilwa kabotu nkaambo kakwe, nkabela wakajana imbelele aŋombe ambongolo abazike abalanda banakazi ambongolo inzyazi ankamele.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.16",
