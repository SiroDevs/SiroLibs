                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amba kuti, Ndime mucizi wakwe; aboobo makani alabota kulindime nkaambo kako. Muuya wangu upone nkaambo kanduwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.13",
