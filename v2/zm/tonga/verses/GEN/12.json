        },
        {
          "text": "Lino Farao wakaita Abramu, wati, Ino ncinzi eci ncowandicitila? Nkaambonzi tokwe kundaambila kuti ngumukaintu wangu? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.18",
            "verseOrgIds": [
