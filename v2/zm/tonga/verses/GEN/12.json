              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Abramu naakasika ku-Egepita, ba-Egepita bakabona mwanakazi, babona kuti mubotu loko. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.14",
            "verseOrgIds": [
              "GEN.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
