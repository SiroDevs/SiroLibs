              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Farao wakalailila bantu bakwe, nkabela bakamusindikizya, walo abanakwe aboonse mbaakali abo.",
          "type": "text",
          "attrs": {
