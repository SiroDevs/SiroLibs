              },
              "items": [
                {
                  "text": "Matl 24:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Juda wakajanina Eri mwanaakwe mutaanzi mwanakazi, izina lyakwe kali Tamara. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.6",
            "verseOrgIds": [
              "GEN.38.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 38:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.46.12"
              },
              "items": [
                {
                  "text": "Matl 46:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.2.3"
              },
              "items": [
                {
                  "text": "1 Mak 2:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele Eri mwana mutaanzi wa-Juda, kali mubi mumeso aa-Jehova, aboobo Jehova wakamujaya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.7",
            "verseOrgIds": [
              "GEN.38.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.22.24"
              },
              "items": [
                {
                  "text": "Mt 22:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Juda wakaambila Onani kuti, Unjilile mwanakazi wamukulana wako, ucite mbweelede mulamu wako, ukabusizye mukulana wako lunyungu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.8",
            "verseOrgIds": [
              "GEN.38.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 38:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.25.6"
              },
              "items": [
                {
                  "text": "Dt 25:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele Onani wakaziba kuti lunyungu talukooyooba lwakwe, aboobo naakaswanaana amukamukulana wakwe wakasowela anyika kuti atapi mukulana wakwe lunyungu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.9",
            "verseOrgIds": [
              "GEN.38.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 38:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.26.19"
              },
              "items": [
                {
                  "text": "My 26:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino eco ncaakacita cakabija mumeso aa-Jehova, aboobo wakamujaya alakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.10",
            "verseOrgIds": [
              "GEN.38.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 38:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.1.13"
              },
              "items": [
                {
                  "text": "Rut 1:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.22.13"
              },
              "items": [
                {
                  "text": "Lev 22:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo Juda wakaambila Tamara mukamwana wakwe kuti, Kosyaala mbuli nabutema muŋanda yauso mane mwanaangu Sela akomene. Nkaambo wakali kuyeeya kuti, Ambweni ulafwa alakwe mbubonya mbuli bakulana bakwe. Aboobo Tamara wakainka kuyookala muŋanda yawisi,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.11",
            "verseOrgIds": [
              "GEN.38.11"
            ]
          }
        }
      ]
    },
