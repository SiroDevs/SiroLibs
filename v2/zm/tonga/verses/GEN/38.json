                {
                  "text": "Matl 38:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.34.31"
              },
              "items": [
                {
                  "text": "Job 34:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Juda wakaziziba, wati, Uliluleme kwiinda ndime, nkaambo ndakabula kumupa Sela mwanaangu. Elyo takwe naakaindulula kumuziba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.26",
            "verseOrgIds": [
              "GEN.38.26"
            ]
          }
        }
      ]
