                "loc": "2SA.13.39"
              },
              "items": [
                {
                  "text": "2 Sam 13:39",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino necakaba ciindi, mwana wa-Suwa (ngonguwe muka-Juda) wakafwa. Nkabela Juda, naakaleka kulila, wakainka ku-Timna, nkobakali kuyunda imbelele zyakwe, antoomwe amuzwalani wakwe Hira mu-Adulamu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.12",
            "verseOrgIds": [
              "GEN.38.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 38:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.15.10"
              },
              "items": [
                {
                  "text": "Jos 15:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.15.57"
              },
              "items": [
                {
                  "text": "57",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo Tamara wakalwiidwa kuti, Bona, usozyala wainka ku-Timna kuyooyunda imbelele zyakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.13",
            "verseOrgIds": [
              "GEN.38.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 38:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.7.12"
              },
              "items": [
                {
                  "text": "Tus 7:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.38.11"
              },
              "items": [
                {
                  "text": "Matl 38:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.38.26"
              },
              "items": [
                {
                  "text": "26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amvwe obo, wakasamununa zyakusama zyabunabutema bwakwe, waliputilila intambala kubusyu bwakwe, walyeenyeenya, waakukala kumulyango waku-Enaimu munzila iiya ku-Timna, Nkaambo wakabona kuti Sela wakomena kale, nekubaboobo tana kumupegwa kuti amukwate. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.14",
            "verseOrgIds": [
              "GEN.38.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 38:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Juda naakabona, wakayeeya kuti ngusimamambe, nkaambo kavumbide busyu bwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.15",
            "verseOrgIds": [
              "GEN.38.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 38:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo wakaleya munzila mwaakabede, wamwaambila kuti, Wence tuswanaane ayebo, Nkaambo takwakaziba kuti ngumukamwana wakwe. Wakati, Ulandipanzi kuti uswanaane ambebo? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.16",
            "verseOrgIds": [
              "GEN.38.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 38:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.16.33"
              },
              "items": [
                {
                  "text": "Ezk 16:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakavuwa kuti, Ndakutumina mwana wampongo kuzwa kutanga, Wakati, Sa tokonzyi kundipa citondezyo calusyomo mane ukatume? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.17",
            "verseOrgIds": [
              "GEN.38.17"
            ]
          }
        },
        {
