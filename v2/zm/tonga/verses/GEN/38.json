          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 38:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino ciindi cakwe cakutumbuka necakasika, mwakajanwa mayanga muzyalilo lyakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.27",
            "verseOrgIds": [
              "GEN.38.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 38:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela mukuzyala kwakwe umwi mwana wakazuluzya ijanza lyakwe, Lino sikutumbusya wakajata ijanza lyakwe, walyaanga akatambo kasalala pyu, wati, Ngooyu mutaanzi kuzyalwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.28",
            "verseOrgIds": [
              "GEN.38.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 38:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele naakapilusya ijanza lyakwe, mweenzinyina wakazwa. Elyo wakati, Ma! Wapola buti yebo? Nciceeco izina lyakwe ncaakaulikwa kuti ngu-Perezi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.29",
            "verseOrgIds": [
              "GEN.38.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 38:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musule lyakwe mwakazyalwa mweenzinyina iwakajisi katambo kasalala ajanza lyakwe, nkabela wakaulikwa izina lya-Zera.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.30",
            "verseOrgIds": [
              "GEN.38.30"
            ]
          }
        }
