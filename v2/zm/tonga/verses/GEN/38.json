              },
              "items": [
                {
                  "text": "Dt 22:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino ciindi cili mbuli myezi yotatwe necakamana, Juda wakalwiidwa kuti, Bona! Tamara mukamwana wako wacita bwaamu, wamintila mubwaamu, Mpawo Juda wakaamba kuti, Amumugwisye, aumpwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.24",
            "verseOrgIds": [
              "GEN.38.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 38:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.37.32"
              },
              "items": [
                {
                  "text": "Matl 37:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele naakali mukugwisigwa, wakatumina wisizyala mulazyo wakuti, Muntu uuli azintu ezi nguwakandiminsya. Alimwi wakati, Bona, uzibe na nzizyani zintu ezi-cinamatizyo antambo amusako. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.25",
            "verseOrgIds": [
              "GEN.38.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 38:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
