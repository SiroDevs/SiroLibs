            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino kuciindi eco Juda wakazwa kubakulana bakwe, waakuswaya umwi muntu waku-Adulamu, izina lyakwe kali Hira. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.1",
            "verseOrgIds": [
              "GEN.38.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 38:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.34.2"
              },
              "items": [
                {
                  "text": "Matl 34:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.2.3"
              },
              "items": [
                {
                  "text": "1 Mak 2:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela nkukonya oko Juda wakabona musimbi mwana wa-Suwa umwi muntu mu-Kanana, elyo wakamukwata, waswanaana awe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.2",
            "verseOrgIds": [
              "GEN.38.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 38:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.26.19"
              },
              "items": [
                {
                  "text": "My 26:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino wakaminta, wazyala mwana mulombe, wamuulika izina lya-Eri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.3",
            "verseOrgIds": [
              "GEN.38.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 38:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.46.12"
              },
              "items": [
                {
                  "text": "Matl 46:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakaminta alimwi, wazyala mwana mulombe, wamuulika izina lya-Onani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.4",
            "verseOrgIds": [
              "GEN.38.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 38:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.26.20"
              },
              "items": [
                {
                  "text": "My 26:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi lwatatu wakazyala mwana mulombe, wamuulika izina lya-Sela. Kali ku-Kezibi naakamuzyala.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.5",
            "verseOrgIds": [
              "GEN.38.5"
            ]
          }
        }
      ]
    },
