            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolipangila bwaato bwazisamu zyagofa. Obu bwaato ubucite azimpetu, alimwi uleelede kubuziluluzya mukati aanze insakizi. ",
          "type": "text",
          "attrs": {
