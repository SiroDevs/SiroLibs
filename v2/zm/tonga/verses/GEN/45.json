        },
        {
          "text": "Mpawo Josefa wakaambila babunyina kuti, Amuze kufwafwi kulindime. Bakaswena afwaafwi. Lino wakati, Ndime Josefa mwanike wanu ngomwakasambala kuti atolwe ku-Egepita. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.4",
            "verseOrgIds": [
              "GEN.45.4"
            ]
          }
        },
