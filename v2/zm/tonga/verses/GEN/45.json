                "loc": "GEN.27.28"
              },
              "items": [
                {
                  "text": "Matl 27:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwasika, amulete usowanu abamaanda aanu boonse, muboole kulindime. Njoomupa bubotu bwanyika ya-Egepita, mulye bunono bwanyika. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.18",
            "verseOrgIds": [
              "GEN.45.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 45:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi kobalailila kuti, Mbuboobu mbumweelede kucita. Amutole iŋola kuzwa kucisi ca-Egepita zibe zyakubwezela bacece banu abanakazi banu, alimwi amunyampule usowanu, muboole. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.19",
            "verseOrgIds": [
              "GEN.45.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 45:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutalikataazyi ambono zyanu pe, nkaambo bubotu bwanyika yoonse ya-Egepita buyooba bwanu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.20",
            "verseOrgIds": [
              "GEN.45.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 45:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.20",
            "verseOrgIds": [
              "GEN.45.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 45:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino bana ba-Israyeli bakacita obo. Josefa wakabapa ŋola, mbubonya mbwaakaamba Farao, abulilu boonse wabapa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.21",
            "verseOrgIds": [
              "GEN.45.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 45:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi boonse buyo wakabapa umwi aumwi zyakuzwaata, a-Benjamini mwanike wakwe wakamupa mali aansiliva aali myanda yotatwe azyakuzwaata zyosanwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.22",
            "verseOrgIds": [
              "GEN.45.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 45:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alakwe wisi, nzeezi nzyaakamutumina: imbongolo zili ikumi ziyumwide zintu zibotu zyaku-Egepita, ambongolo inzyazi zili ikumi ziyumwide maila azilyo abulilu bwawisi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.23",
            "verseOrgIds": [
              "GEN.45.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 45:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo wakatuma babunyina, bainka. Nkabela wakabaambila kuti, Mutakalazyanyi munzila. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.24",
            "verseOrgIds": [
              "GEN.45.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 45:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo bakazwa kucisi caEgepita, basika kucisi ca-Kanana nkwaakabede Jakobo wisaabo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.25",
            "verseOrgIds": [
              "GEN.45.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 45:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
