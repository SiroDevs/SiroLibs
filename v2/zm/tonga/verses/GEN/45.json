                  "text": "Mk 6:50",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Josefa wakaambila bananyina kuti, Ndime Josefa. Sa taata ucipona? Nkabela babunyina bakakacilwa kumuvwiila, nkaambo bakali kukankama kubusyu bwakwe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.3",
            "verseOrgIds": [
              "GEN.45.3"
            ]
          }
        }
