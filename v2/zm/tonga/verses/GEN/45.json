            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.24.11"
              },
              "items": [
                {
                  "text": "Lk 24:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.24.41"
              },
              "items": [
                {
                  "text": "41",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela bakamwaambila kuti, Josefa ucipona, alimwi ngonguwe uuendelezya mucisi coonse ca-Egepita, Amvwe obo, moyo wakwe wakalebuluka, nkaambo takwakazumina. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.26",
            "verseOrgIds": [
              "GEN.45.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 45:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele nebakamulwiida majwi oonse aa-Josefa ngaakamwaambila, alimwi naakabona ŋola Josefa nzyaakatuma kukumubweza, moyo wa-Jakobo wisaabo wakabukuluka, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.27",
            "verseOrgIds": [
              "GEN.45.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 45:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israyeli wakati, Mbubo, mwanaangu Josefa ucipona, Njiinke kuyoomubona nkentanafwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.28",
            "verseOrgIds": [
              "GEN.45.28"
            ]
          }
        }
      ]
