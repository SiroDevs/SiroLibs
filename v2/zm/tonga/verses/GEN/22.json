                "loc": "1CO.5.8"
              },
              "items": [
                {
                  "text": "8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Abrahamu wakatambya meso aakwe, wabona mugutu ulipatide muciteo ameja aakwe. Nkabela Abrahamu wakaya, wajata oyo mugutu, wamutuula mbuli cituuzyo mucibaka camwanaakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.13",
            "verseOrgIds": [
              "GEN.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino oko kuntu Abrahamu wakakuulika izina lya-Jehova-Jire. Asunu kucaambwa obo. Mucilundu ca-Jehova mulaboneka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.14",
            "verseOrgIds": [
              "GEN.22.14"
            ]
          }
        }
      ]
