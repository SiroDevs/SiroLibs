              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.2.22"
              },
              "items": [
                {
                  "text": "Jak 2:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo wakati, Utatandabiki ijanza lyako kumwana nikuba kumucitila cintu, nkaambo lino ndaziba ncobeni kuti ulamuyoowa Leza, nkaambo tokwe nowandikakila mwanaako simuzyalwa alike. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.12",
            "verseOrgIds": [
              "GEN.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
