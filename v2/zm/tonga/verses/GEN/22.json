                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basike buyo kubusena obo Leza mbwaakamwaambila, Abrahamu wakayaka cipaililo nkuko, wabamba inkuni. Amane kucita obo, wakaanga Izaka mwanaakwe, wamulazika acipaililo atala lyankuni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.9",
            "verseOrgIds": [
              "GEN.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.53.6+ISA.53.7+ISA.53.8+ISA.53.9+ISA.53.10+ISA.53.11+ISA.53.12"
              },
              "items": [
                {
                  "text": "Is 53:6-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Abrahamu wakatandabika ijanza lyakwe, wabweza cifulo kuti ajaye mwanaakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.10",
            "verseOrgIds": [
              "GEN.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele angelo wa-Jehova wakamoongolola kuzwa kujulu, wati, Abrahamu! Abrahamu! Wakati, Mpondi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.11",
            "verseOrgIds": [
              "GEN.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
