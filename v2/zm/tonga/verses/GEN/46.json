        {
          "text": "Ngaaya mazina aabana ba-Israyeli ibakasika ku-Egepita, nkukuti Jakobo abana bakwe, Mwana mutaanzi wa-Jakobo kali Rubeni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.8",
            "verseOrgIds": [
              "GEN.46.8"
            ]
          }
        },
        {
