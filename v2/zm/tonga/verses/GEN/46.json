                  "text": "Matl 41:50-52",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Josefa wakazyalilwa bana munyika ya-Egepita, mbaakamuzyalila Asenati mwana musimbi wa-Potifera mupaizi waku-Oni, nkukuti Manase a-Efraimu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.20",
            "verseOrgIds": [
              "GEN.46.20"
            ]
          }
