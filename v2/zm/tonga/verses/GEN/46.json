              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baalumi abo mbeembeli, mbavubi baŋombe, alimwi baletelela imbelele zyabo aŋombe zyabo azyoonse nzebajisi. ",
          "type": "text",
          "attrs": {
