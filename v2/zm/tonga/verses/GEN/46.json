        {
          "text": "Nkabela Leza wakaambaula a-Israyeli muzilengano zyamasiku, wati, Jakobo, Jakobo. Wakati, Mpondi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.2",
