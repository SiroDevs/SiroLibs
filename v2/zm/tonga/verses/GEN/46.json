                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azyalo iŋombe zyabo ambono zyabo zyoonse nzibakajene munyika ya-Kana na bakazitola aboobo bakasika ku-Egepita, Jakobo alunyungu lwakwe loonse. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.6",
            "verseOrgIds": [
              "GEN.46.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
