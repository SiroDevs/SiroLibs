                  "text": "Lk 2:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Israyeli wakaambila Josefa kuti, Mbubo, mfwe, nkaambo ndabona busyu bwako, ndabona kuti ucipona. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.30",
            "verseOrgIds": [
              "GEN.46.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
