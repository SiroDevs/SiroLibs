          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana bakwe balombe, abazukulu bakwe, abana bakwe basimbi, abana basimbi babana bakwe, amuzukulu wakwe woonse, boonse buyo wakeza abo kunyika ya-Egepita.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.7",
            "verseOrgIds": [
