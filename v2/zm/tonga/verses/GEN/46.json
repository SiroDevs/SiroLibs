              "items": [
                {
                  "text": "1 Mak 4:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abana baSimeoni mbaaba: Jemueli, a-Jamini, a-Ohadi, a-Jakini, a-Zohari, a-Saulo mwana wamwanakazi mu-Kanana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.10",
            "verseOrgIds": [
              "GEN.46.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 46:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana ba-Levi mbaaba: Gerisoni a-Kohati a-Merari. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.11",
            "verseOrgIds": [
              "GEN.46.11"
            ]
          }
        },
