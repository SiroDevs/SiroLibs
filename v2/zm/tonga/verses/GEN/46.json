          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpoonya awo Josefa wakaambila bananyina aluzubo lwawisi kuti, Ndainka kuyooambila Farao makani, Nkamulwiide kuti, Bakulana bangu aluzubo lwataara ibakakede munyika ya-Kanana basika kulindime. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.31",
            "verseOrgIds": [
              "GEN.46.31"
            ]
          }
        },
