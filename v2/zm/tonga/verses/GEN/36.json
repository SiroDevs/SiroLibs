          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "silutwe Kenazi, silutwe Temani, silutwe Mibezari, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.42",
            "verseOrgIds": [
              "GEN.36.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
