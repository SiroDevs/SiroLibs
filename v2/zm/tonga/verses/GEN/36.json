              },
              "items": [
                {
                  "text": "Matl 26:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Esau wakakwata banakazi bamucisi ca-Kanana, Ada mwana musimbi wa-Eloni mu­ Hiti, a-Aholibama mwana musimbi wa-Ana mwana wa-Zibeoni mu-Hivi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.2",
            "verseOrgIds": [
              "GEN.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
