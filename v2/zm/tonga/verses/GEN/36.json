          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "silutwe Aholibama, silutwe Ela, silutwe Pinoni, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.41",
            "verseOrgIds": [
              "GEN.36.41"
            ]
          }
        },
        {
