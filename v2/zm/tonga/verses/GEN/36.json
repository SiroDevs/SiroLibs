                "loc": "GEN.28.9"
              },
              "items": [
                {
                  "text": "Matl 28:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "a-Basemati mwana musimbi wa-Ismayeli mucizi wa-Nebayoti. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.3",
            "verseOrgIds": [
              "GEN.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.1.35"
              },
              "items": [
                {
                  "text": "1 Mak 1:35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Ada wakazyalila Esau Elifazi, alakwe Basemati wakazyala Reueli, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.4",
            "verseOrgIds": [
              "GEN.36.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "alakwe Aholibama wakazyala Jeusi a-Jalamu a-Kora, Mbaabo bana ba-Esau mbaakazyala munyika ya-Kanana.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.5",
            "verseOrgIds": [
              "GEN.36.5"
            ]
          }
        }
      ]
    },
