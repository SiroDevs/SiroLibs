            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino njeeyi mizukulu ya-Esau, ngonguwe Edomu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.1",
            "verseOrgIds": [
              "GEN.36.1"
            ]
