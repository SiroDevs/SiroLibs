              "items": [
                {
                  "text": "Dt 23:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esau wakatola banakazi bakwe, bana bakwe balombe, bana bakwe basimbi, abasiŋanda bakwe boonse, aŋombe zyakwe amatanga aakwe, aŋombe zyakwe zyoonse nzyaakavubide munyika ya-Kanana, wakalongela kunyika imbi cakwaanzaana amwanike wakwe Jakebo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.6",
            "verseOrgIds": [
              "GEN.36.6"
            ]
          }
        },
        {
