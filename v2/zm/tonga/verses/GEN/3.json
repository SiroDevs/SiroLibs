        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.11.3"
              },
              "items": [
                {
                  "text": "2 Kor 11:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.2.14"
              },
              "items": [
                {
                  "text": "1 Tim 2:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo inzoka yakaambila mwanakazi kuti, Ne! Tamukonzyi kufwa pe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.4",
            "verseOrgIds": [
              "GEN.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo Leza ulizi kuti mubuzuba obo mbubonya mbomuyooulya, meso aanu ayoojuka, lino muyooba mbuli Leza, muyooziba bubotu abubi mbububede. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.5",
            "verseOrgIds": [
              "GEN.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.5.12+ROM.5.13+ROM.5.14+ROM.5.15+ROM.5.16+ROM.5.17+ROM.5.18+ROM.5.19"
              },
              "items": [
                {
                  "text": "Rom 5:12-19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino mwanakazi wakabona kuti musamu mubotu kukuulya, alimwi ulabotezya meso, alimwi ulayandika kukupa muntu busongo. Nkabela mpawo wakabweza micelo yawo, walya. Alakwe mulumaakwe, wakamupa, alakwe wakalya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.6",
            "verseOrgIds": [
              "GEN.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpoonya awo meso aabo boonse bobile akajaluka, nkabela bakaziba kuti bali azinswe, Lino bakatalika kusuma matu aamukuyu akulicitila zilivumbilizyo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.7",
            "verseOrgIds": [
              "GEN.3.7"
            ]
          }
        }
