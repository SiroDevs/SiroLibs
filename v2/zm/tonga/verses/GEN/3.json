                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino bakamvwa ijwi lya-Jehova Leza uleendeenda mumuunda izuba nelyakatalika kubomba, nkabela oyo muntu Adamu abanakwe bakayuba akati kamisamu yamumuunda kuti bataboneki kumeso aa-Jehova Leza. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.8",
            "verseOrgIds": [
              "GEN.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
