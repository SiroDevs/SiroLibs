                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.2.14"
              },
              "items": [
                {
                  "text": "1 Tim 2:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Jehova Leza wakaambila mwanakazi kuti, Ino ncinzi eci ncowacita? Mwanakazi wakati, Inzoka njiyakandoongelezya, aboobo ndalya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.13",
            "verseOrgIds": [
              "GEN.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
