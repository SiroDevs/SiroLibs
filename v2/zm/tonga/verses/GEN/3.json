          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyookuzyalila mamvwa amitubetube. Uyoolya zisyu zyamusokwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.18",
            "verseOrgIds": [
              "GEN.3.18"
