              "attrs": {
                "loc": "MIC.7.17"
              },
              "items": [
                {
                  "text": "Mik 7:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Jehova Leza wakaambila inzoka kuti, Mbowacita obo, ulitukidwe kwiinda iŋombe zyoonse abanyama boonse bamusokwe. Uyooenda abula bwako, abulongo buyooba zilyo zyako, mazuba oonse aabuponi bwako. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.14",
            "verseOrgIds": [
              "GEN.3.14"
            ]
          }
        },
