        },
        {
          "text": "Nkabela njoobusya inkondo akati kanduwe amwanakazi, akati kalunyungu lwako alunyungu lwakwe. Walo uyookuuma amutwe, ayebo uyoomuluma kukasinde. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.15",
            "verseOrgIds": [
              "GEN.3.15"
            ]
          }
        },
        {
          "name": "verse",
