            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.2.15"
              },
              "items": [
                {
                  "text": "1 Tim 2:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino mwanakazi wakamwaambila kuti, Njookuvuzizya macise aako akuminta kwako, uyoozyala bana amacise, alimwi uyoosukama mulumaako, ngonguwe uuti kakweendelezye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.16",
            "verseOrgIds": [
