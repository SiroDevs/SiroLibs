                  "text": "22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uyoolya insima cakufwa mitukuta mane ukapiluke kunyika, nkaambo mulinjiyo mowakagwisigwa, nkaambo uli bulongo buyo, akooko kubulongo nkoelede kupiluka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.19",
            "verseOrgIds": [
              "GEN.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
