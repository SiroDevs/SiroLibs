                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alakwe Adamu wakamwaambila kuti, Mbowaswiilila ijwi lyamukaako akulya micelo njindakulailila kuti toelede kwiilya, nyika ilitukidwe nkaambo kanduwe, Uyoolya micelo yayo mumacise mazuba oonse aabuponi bwako. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.17",
            "verseOrgIds": [
              "GEN.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
