        },
        {
          "text": "Lino mazuba aakulilwa kwakwe naakamana, Josefa wakaambila basiŋanda ba-Farao kuti, Na ndijene buuya mumeso aanu, amwaambile Farao kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.4",
            "verseOrgIds": [
              "GEN.50.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 50:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.16.14"
              },
              "items": [
                {
                  "text": "2 Mak 16:14",
