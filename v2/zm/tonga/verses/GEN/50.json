                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Josefa wakalailila balanda bakwe basilisi kuti bayanike mutunta wawisi, aboobo basilisi bakayanika mutunta wa-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.2",
            "verseOrgIds": [
