              },
              "items": [
                {
                  "text": "Dt 34:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwakamana mazuba aali makumi one, nkaambo ngomweelwe wamazuba aakuyanika mutunta. Nkabela ba-Egepita bakamulila mazuba aali makumi aali musanu aabili.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.3",
            "verseOrgIds": [
              "GEN.50.3"
            ]
          }
