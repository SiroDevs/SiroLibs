                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.27.60"
              },
              "items": [
                {
                  "text": "Mt 27:60",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Taata wakandikonkezya, wati, Ndaamba kufwa; kukabanda kangu nkendakalisida munyika ya-Kanana nkooko nkumweelede kundivwikila, Lino njiinke, nkazike taata. Njooboola. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.5",
            "verseOrgIds": [
              "GEN.50.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 50:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Farao wakati, Mbubo, inka, ukavwike uso, mbubonya mbwaakakukonkezya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.6",
            "verseOrgIds": [
              "GEN.50.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 50:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Josefa wakainka kuyoovwika wisi. Abalo balanda boonse ba-Farao bakainka awe, bapati baŋanda yakwe, abapati boonse banyika ya-Egepita, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.7",
            "verseOrgIds": [
              "GEN.50.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 50:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "aluzubo loonse lwa-Josefa, ababunyina, aluzubo lwawisi. Bacece babo luzutu, ambelele zyabo aŋombe zyabo, nzebakasia munyika ya-Goseni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.8",
            "verseOrgIds": [
              "GEN.50.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 50:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakaya ankalaki abasimbizi, inkamu impati loko. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.9",
            "verseOrgIds": [
              "GEN.50.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 50:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.8.2"
              },
              "items": [
                {
                  "text": "Inc 8:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.31.13"
              },
              "items": [
                {
                  "text": "1 Sam 31:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.2.13"
              },
              "items": [
                {
                  "text": "Job 2:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basike kubbuwa lyacipolelo lya-Atadi, kutala lya-Jordano, bakalila nkukonya oko akulila kupati kuyoosya loko, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.10",
            "verseOrgIds": [
              "GEN.50.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 50:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela bantu banyika ya-Kanana, nibakabona kulila oko kwakucipolelo ca-Atadi, bakati, Oku kulila kwaba-Egepita kulayoosya loko. Nciceeco kuntu oko ncikwakapedwa izina lya-Abeli-mizraimu. Kuli mutala lya-Jordano, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.11",
            "verseOrgIds": [
              "GEN.50.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 50:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aboobo bana bakwe bakamucitila mbubonya mbwaakabalailila. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.12",
            "verseOrgIds": [
              "GEN.50.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 50:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.23.16"
              },
              "items": [
                {
                  "text": "Matl 23:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.16"
              },
              "items": [
                {
                  "text": "Inc 7:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bana bakwe bakamutola kunyika ya-Kanana, bamuvwika musempo lyamumuunda wa-Makipela, kunembo lya-Mamre, muunda Abrahamu ngwaakaula kuli-Efroni mu-Hi ti, kuti auvube, ube mavwikilo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.13",
            "verseOrgIds": [
              "GEN.50.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 50:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amane kuzika wisi, Josefa wakapiluka ku-Egepita ababunyina aboonse mbaakainkide abo kuyoovwika wisi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.14",
            "verseOrgIds": [
              "GEN.50.14"
            ]
          }
        }
      ]
    },
