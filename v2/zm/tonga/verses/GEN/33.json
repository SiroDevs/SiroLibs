              },
              "items": [
                {
                  "text": "Jer 10:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele Esau wakazuzaana kukumuswanganya, wamukumbata, wawida ansingo yakwe, wamumyonta. Nkabela balila. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.4",
            "verseOrgIds": [
              "GEN.33.4"
            ]
          }
        },
        {
