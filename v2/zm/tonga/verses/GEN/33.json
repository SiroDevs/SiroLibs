                {
                  "text": "Matl 32:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Jakobo wakatambya meso aakwe, wabona kuti Esau uleza abantu bali myanda yone. Abone obo, wakapambukanya bana a-Leya a-Rakele abalanda basimbi bobile. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.1",
            "verseOrgIds": [
              "GEN.33.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela balanda basimbi abana babo wakababika kunembo, musule lyabo wakabika Leya abana bakwe, musule lyabaabo wakabika Rakele a-Josefa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.2",
            "verseOrgIds": [
              "GEN.33.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.18.2"
              },
              "items": [
                {
                  "text": "Matl 18:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.42.6"
              },
              "items": [
                {
                  "text": "42:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino walo mwini wakainda kunembo, wakali kuya bukotama ansi ziindi zili musanu azibili mane wakasika kumukulana wakwe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.3",
            "verseOrgIds": [
              "GEN.33.3"
            ]
          }
        }
      ]
    },
