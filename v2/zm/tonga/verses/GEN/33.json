                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.18.10"
              },
              "items": [
                {
                  "text": "Mt 18:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele Jakobo wakati, Akaka! Na ndijene luzyalo mumeso aako, wence tambula cipo cizwa kumaanza aangu, nkaambo kubona busyu bwako kuli mbubonya mbuli kubona busyu bwa-Leza. Wanditambula kabotu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.10",
            "verseOrgIds": [
              "GEN.33.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.1.15"
              },
              "items": [
                {
                  "text": "Bab 1:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.25.27"
              },
              "items": [
                {
                  "text": "1 Sam 25:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.5.15"
              },
              "items": [
                {
                  "text": "2 Bam 5:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.4.18"
              },
              "items": [
                {
                  "text": "Flp 4:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.5.23"
              },
              "items": [
                {
                  "text": "2 Bam 5:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wence tambula cilumbyo cangu ncowaletelwa, nkaambo Leza wandifwida luzyalo, alimwi ndijisi zinji. Aboobo wakamukombelezya mane wakatambula.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.11",
            "verseOrgIds": [
              "GEN.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.11",
            "verseOrgIds": [
              "GEN.33.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo Esau wakati, Atweende, ndakuzulwida. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.12",
            "verseOrgIds": [
              "GEN.33.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele wakamuvwiila kuti, Mwami wangu ulizi kuti bana mbaniini, alimwi ndijisi imbelele atjombe zinyonsya, Na bazibingisya buzuba bomwe, imbelele zyoonse zilafwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.13",
            "verseOrgIds": [
              "GEN.33.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.32.3"
              },
              "items": [
                {
                  "text": "Matl 32:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwami wangu aye kunembo lyamulanda wakwe, Mebo nooza bweenda kabotu kabotu, mbuli mbuzikonzya kweenda iŋombe, ambuli mbubakonzya kweenda bana, mane nkasike kumwami wangu ku-Seiri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.14",
            "verseOrgIds": [
              "GEN.33.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
