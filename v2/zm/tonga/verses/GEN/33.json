            "verseId": "GEN.33.15",
            "verseOrgIds": [
              "GEN.33.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.2.13"
              },
              "items": [
                {
                  "text": "Rut 2:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Esau wakati, Nkusiile bamwi babantu mbondi abo, Pele wakati, Nkaambonzi? Nkajane buuya mumeso aasimalelaangu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.15",
            "verseOrgIds": [
              "GEN.33.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo Esau wakanyampuka mubuzuba obo mbubonya kuti apiluke ku-Seiri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.16",
            "verseOrgIds": [
              "GEN.33.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.13.27"
              },
              "items": [
                {
                  "text": "Jos 13:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.8.5"
              },
              "items": [
                {
                  "text": "Bab 8:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele Jakobo wakaya ku-Sukoti, waakuliyakila iŋanda. Azyalo iŋombe zyakwe wakaziyakila zibaya. Nciceeco oku kuntu ncikuulikidwe izina lya-Sukoti.",
          "type": "text",
