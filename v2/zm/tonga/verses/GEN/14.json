              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mwami wa-Sodoma wakaambila Abramu kuti, Kondipa bantu, pele imbono uzitole biyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.21",
