                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alumbwe Leza Mupatikampatila iwakaaba basinkondonyoko mumaanza aako. Elyo wakamupa cipanzi cakumi cambono zyoonse, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.20",
            "verseOrgIds": [
              "GEN.14.20"
            ]
          }
        },
        {
