                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.107.34"
              },
              "items": [
                {
                  "text": "Int 107:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aba boonse bakalibungene mukuti lya-Sidimu (ndondulo Lwizi lwa-Munyo). ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.3",
            "verseOrgIds": [
              "GEN.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myaka iili ikumi aibili bakali bazike ba-Kedorelaomere, pele mumwaka wakumi aitatu bakapapila. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.4",
            "verseOrgIds": [
              "GEN.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mumwaka wakumi aine bakeza ba-Kedorelaomere abami mbaakali abo, bazunda ba-Refaimu mu-Aseterote-kamaimu, aba-Zuzi mu-Hamu, aba-Emi mu-Savekiriyataimu, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.5",
            "verseOrgIds": [
              "GEN.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "aba-Hori mucilundu cabo caku-Seiri, akusikila ku-Eliparana uuli munkanda. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.6",
            "verseOrgIds": [
              "GEN.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.20.2"
              },
              "items": [
                {
                  "text": "2 Mak 20:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino kuzwa oko bakaboola, basika ku-Eni-Misipati (ngonguwo Kadesi), bazunda cisi coonse cabaAmaleki, abalo ba-Amori ibakakede mu-Hazezoni-tamara. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.7",
            "verseOrgIds": [
              "GEN.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo kwakazwa mwami wa-Sodoma, amwami wa-Gomora, amwami wa-Adima, amwami wa-Zeboimu, amwami wa-Bela (ngonguwo Zoari), baswanana akubamba mindando yabo yakulwisya mukuti lya-Sidimu, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.8",
            "verseOrgIds": [
              "GEN.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "balwisye Kedorelaomere mwami wa-Elamu, a-Tidala mwami wa-Goimu, a-Amarafele mwami wa-Sinara, a-Arioki mwami wa-Elasara, Bami bone bakalwisya bami bosanwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.9",
            "verseOrgIds": [
              "GEN.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.11.3"
              },
              "items": [
                {
                  "text": "Matl 11:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.17"
              },
              "items": [
                {
                  "text": "19:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.30"
              },
              "items": [
                {
                  "text": "30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela ikuti lya-Sidimu kalizwide migodi yamulambo. Lino bami ba-Sodoma a-Gomora bakacija, bawida mumonya, abaabo ibakacisyeede bakacijila kucilundu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.10",
            "verseOrgIds": [
              "GEN.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo bakatola imbono zyoonse zyaku-Sodoma azyaku-Gomora, azilyo zyabo zyoonse, bainka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.11",
            "verseOrgIds": [
              "GEN.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.11.31"
              },
              "items": [
                {
                  "text": "Matl 11:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.13.12"
              },
              "items": [
                {
                  "text": "13:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.2.17"
              },
              "items": [
                {
                  "text": "Jer 2:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.2.19"
              },
              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alakwe Loti mwana wamunyina Abramu, iwakakede ku-Sodoma, bakamutolelela ambono zyakwe, bainka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.12",
            "verseOrgIds": [
              "GEN.14.12"
            ]
          }
        }
      ]
    },
