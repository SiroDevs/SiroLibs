                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo kwakasika mulobosi, walwiida Abramu mu-Hebrayo, iwakakede kumibanga ya-Mamre mu-Amori munyina Esikoli, munyina Anere, nkaambo abo kabatangene buzwalani a-Abramu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.13",
            "verseOrgIds": [
              "GEN.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
