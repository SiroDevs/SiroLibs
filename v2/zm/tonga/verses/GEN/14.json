                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela wakaboozya imbono zyoonse, alakwe Loti munyina wakamuboozya ambono zyakwe abanakazi abantu boonse.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.16",
