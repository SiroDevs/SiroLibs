            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.41.2"
              },
              "items": [
                {
                  "text": "Is 41:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Abramu naakamvwa kuti mwanaakwabo watolwa mubuzike, wakayobolola basilumamba bakwe bazyale muŋanda yakwe, bantu bali myanda yotatwe akumi amusanu abatatu, wabatobela mane kusikila ku-Dani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.14",
            "verseOrgIds": [
              "GEN.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino ciindi camasiku bakalipambukanya tukamu tukamu akubalwisya, walo abalanda bakwe, babauma, babatobela mane kusikila ku-Hoba uuli kulubazu lwalumwesi lwaDamasko. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.15",
            "verseOrgIds": [
              "GEN.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.30.8"
              },
              "items": [
                {
                  "text": "1 Sam 30:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.30.18"
