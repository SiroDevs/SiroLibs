              "attrs": {
                "loc": "GEN.19.22"
              },
              "items": [
                {
                  "text": "Matl 19:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "bakacita inkondo a-Bera mwami wa-Sodoma, a-Birasa mwami wa-Gomora, a-Sinabi mwami wa-Adima a-Semebere mwami wa-Zeboimu, amwami wa-Bela (ngonguwo Zoari). ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.2",
            "verseOrgIds": [
              "GEN.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 14:3"
          },
