                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Melkisideke mwami wa-Salemu wakaleta zinkwa awaini. Kali mupaizi wa-Leza Mupatikampatila. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.18",
            "verseOrgIds": [
