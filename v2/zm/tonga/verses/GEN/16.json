                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Sarai muka-Abramu katazyede mwana, nkabela kajisi mulanda musimbi mu-Egepita, izina lyakwe kali Hagare, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.1",
            "verseOrgIds": [
              "GEN.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.30.2"
              },
              "items": [
                {
                  "text": "Matl 30:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Sarai wakaa­ mbila Abramu kuti, Bona! Jehova wandikasya kuzyala bana, Wence swanana amulanda wangu; ambweni kulinguwe nkonjoopegwa bana. Mpawo Abramu wakaswiilila ijwi lya-Sarai. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.2",
            "verseOrgIds": [
              "GEN.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aboobo Sarai muka-Abramu wakabweza Hagare mu-Egepita, mulanda wakwe musimbi, Abramu naakamana kukala myaka iili ikumi munyika ya-Kanana, wamupa Abramu mulumaakwe kuti amukwate. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.3",
            "verseOrgIds": [
              "GEN.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.30.23"
              },
              "items": [
                {
                  "text": "Tus 30:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo wakaswanana a-Hagare, nkabela wakaminta, Abone buyo kuti waminta, bamalelo aakwe bakasampaulwa mumeso aakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.4",
            "verseOrgIds": [
              "GEN.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.5.21"
              },
              "items": [
                {
                  "text": "Kul 5:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Sarai wakaambila Abramu kuti, Ma! Wandibisizya, Ndakakupa mulanda wangu musimbi kuti mukumbatane, lino naakabona kuti waminta, ndakasampaulwa mumeso aakwe. Jehova abeteke makani esu, yebo ambebe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.5",
            "verseOrgIds": [
              "GEN.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abramu wakavwiila Sarai kuti, Musimbi wako uli mumaanza aako. Komucitila kufumbwa cibotu mumeso aako, Lino Sarai wakamufwabya, mane lumwi wakacija kuzwa kulinguwe,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.6",
            "verseOrgIds": [
              "GEN.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
