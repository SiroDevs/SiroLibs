              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Hagare wakazyalila Abramu mwana mulombe, nkabela Abramu wakaulika eyo mwana Hagare ngwaakazyala izina lya-Ismayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.15",
            "verseOrgIds": [
              "GEN.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abramu kajisi myaka iili makumi aali musanu aatatu amusanu aumwi kuciindi eco Hagare naakazyala Ismayeli.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.16",
            "verseOrgIds": [
              "GEN.16.16"
            ]
          }
