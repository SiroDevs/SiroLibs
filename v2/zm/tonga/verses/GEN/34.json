          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino majwi aabo akabota mumeso aa-Hamori amumeso aa-Sekemu mwana wa-Hamori. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.18",
            "verseOrgIds": [
              "GEN.34.18"
            ]
          }
        },
