              "items": [
                {
                  "text": "Tit 2:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Dina, mwana musimbi wa-Leya ngwaakazyalila Jakobo, wakaya kuswaya-swaya kubanakazi bacisi eco. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.1",
            "verseOrgIds": [
              "GEN.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.6.2"
              },
              "items": [
                {
                  "text": "Matl 6:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.14.1"
              },
              "items": [
                {
                  "text": "Bab 14:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Sekemu mwana wa-Hamori mu-Hiti mwami wacisi, naakamubona, wakamutizya, woona awe, wamubisizya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.2",
            "verseOrgIds": [
              "GEN.34.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.40.2"
              },
              "items": [
                {
                  "text": "Is 40:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.2.14"
              },
              "items": [
                {
                  "text": "Hos 2:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Moyo wakwe wakasukama Dina mwana musimbi wa-Jakobo nkabela wakayandisya musimbi akumwaambila cakumoongelezya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.3",
            "verseOrgIds": [
              "GEN.34.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.14.2"
              },
              "items": [
                {
                  "text": "Bab 14:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo Sekemu wakaambila Hamori wisi kuti, Kondeendela oyo musimbi, nkamukwate. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.4",
            "verseOrgIds": [
              "GEN.34.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Jakobo wakamvwa kuti wasofwaazya Dina mwanaakwe musimbi, pele bana bakwe balombe bakali mukweembela iŋombe musokwe, aboobo Jakobo wakaumuna buyo mane bakasika. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.5",
            "verseOrgIds": [
              "GEN.34.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Hamori wisi Sekemu wakainka kuli-Jakobo kuyooambaula awe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.6",
            "verseOrgIds": [
              "GEN.34.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
