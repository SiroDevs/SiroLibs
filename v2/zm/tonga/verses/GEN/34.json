            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.23.17"
              },
              "items": [
                {
                  "text": "Dt 23:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abalo bana balombe ba-Jakobo, nibakamvwa makani, bakaboola kuzwa musokwe, nkabela abo basankwa bakabijilwa akukalala loko nkaambo kabufubafuba obo mbwaakacitide mumukowa wa-Israyeli mukulalika mwana musimbi waJakobo, nkaambo cilatondwa kucita obo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.7",
            "verseOrgIds": [
              "GEN.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
