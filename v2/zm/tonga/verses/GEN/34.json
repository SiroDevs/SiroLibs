            "sid": "GEN 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.7",
            "verseOrgIds": [
              "GEN.34.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele Hamori wakabaambila kuti, Moyo wa-Sekemu mwanaangu ulisukeme mwanaanu musimbi. Wence mumupe nguwe, amukwate. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.8",
            "verseOrgIds": [
              "GEN.34.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.32"
              },
              "items": [
                {
                  "text": "Kul 23:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi atutangane buzwalani bwalukwatano, kuti mutupe bana banu basimbi, anywebo mutole bana besu basimbi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.9",
            "verseOrgIds": [
              "GEN.34.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.13.9"
              },
              "items": [
                {
                  "text": "Matl 13:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.20.15"
              },
              "items": [
                {
                  "text": "20:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.42.34"
              },
              "items": [
                {
                  "text": "42:34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.47.27"
              },
              "items": [
                {
                  "text": "47:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino amukale kulindiswe; nyika yoonse iyoomujalukila, kuti mukale, musambale, mube ambono mulinjiyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.10",
            "verseOrgIds": [
              "GEN.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alakwe Sekemu wakaambila wisi musimbi abakulana bakwe kuti, Mfwidwe buuya kulindinywe, elyo kufumbwa ncomwaamba ndamupa ncico. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.11",
            "verseOrgIds": [
              "GEN.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.22.16"
              },
              "items": [
                {
                  "text": "Kul 22:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.22.29"
              },
              "items": [
                {
                  "text": "Dt 22:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.18.25"
              },
              "items": [
                {
                  "text": "1 Sam 18:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amwaambe luselo lunji azipo zinji mbubonya mbuli mbumuyanda, njoomupa ncomwaamba, pele amundipe musimbi, mukwate.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.12",
            "verseOrgIds": [
              "GEN.34.12"
            ]
          }
        }
