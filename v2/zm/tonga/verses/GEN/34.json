        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.17",
            "verseOrgIds": [
              "GEN.34.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
