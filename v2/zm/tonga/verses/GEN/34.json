                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela mulombe takwaakamuka kucita obo, nkaambo kayandisya mwana musimbi wa-Jakobo. Kali mulemu kwiinda basiŋanda boonse bawisi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.19",
            "verseOrgIds": [
              "GEN.34.19"
            ]
          }
        },
        {
