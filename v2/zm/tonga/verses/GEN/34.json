                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino buzuba bwatatu nibwakaca, nibakali kuciswa, bana bobile baJakobo, nkukuti Simeoni a-Levi bakulana ba-Dina, bakatola umwi aumwi ipanga lyakwe, boongomokela munzi, bajaya baalumi boonse. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.25",
            "verseOrgIds": [
              "GEN.34.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alakwe Hamori amwanaakwe Sekemu, boonse bakabajaya apanga, elyo bakagwisya Dina muŋanda ya-Sekemu, bamutola. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.26",
            "verseOrgIds": [
              "GEN.34.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 34:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana ba-Jakobo bakasika kuli bajayidwe, akusaala munzi, nkaambo kakuti mucizi wabo kasofwaazidwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.27",
            "verseOrgIds": [
              "GEN.34.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakatola imbelele zyabo aŋombe zyabo ambongolo zyabo, azintu zyoonse zyamumunzi azyamumyuunda, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.28",
            "verseOrgIds": [
              "GEN.34.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 34:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "imbono zyabo zyoonse, atwana twabo toonse abanakazi babo boonse, zyoonse buyo zyamuŋanda bakazisaala akuzitola. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.29",
            "verseOrgIds": [
