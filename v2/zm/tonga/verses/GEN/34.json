                "loc": "GEN.23.10"
              },
              "items": [
                {
                  "text": "Matl 23:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpoonya awo boonse ibakali kunjila mumulyango wamunzi wakwe bakaswiilila Hamori a-Sekemu mwanaakwe. Baalumi boonse bakapalulwa, boonse buyo ibakali kunjila mumulyango wamunzi wakwe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.24",
            "verseOrgIds": [
              "GEN.34.24"
            ]
          }
        }
