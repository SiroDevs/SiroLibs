              "items": [
                {
                  "text": "Rom 8:2-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino sa Mulao ulalwisya zisyomezyo zya-Leza na? Ne! Nkaambo Mulao niwakubede uukonzya kupa buumi, elyo ncobeni bululami nibwakuzwide ku-Mulao. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.21",
            "verseOrgIds": [
              "GAL.3.21"
            ]
          }
