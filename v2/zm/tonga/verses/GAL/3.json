        },
        {
          "text": "Lino ngweenzi Mulao? Wakayungizizigwa nkaambo kansotoko, mane kusikila kuciindi nciyakasika eyo Imbuto iyakapegwa cisyomezyo. Wakatumikizigwa abaangelo kujanza lyasikwiimaakati. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.19",
            "verseOrgIds": [
              "GAL.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
