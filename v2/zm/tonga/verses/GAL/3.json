            "number": "15",
            "style": "v",
            "sid": "GAL 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino bakwesu, ndaleta cikozyano camakani aabantu. Cizuminano camuntu, na cilijatisidwe kale, taakwe muntu uukonzya kucilobya nanka kuciyungizizya. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.15",
            "verseOrgIds": [
              "GAL.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
