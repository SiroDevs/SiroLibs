                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.22.18"
              },
              "items": [
                {
                  "text": "22:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.24.7"
              },
              "items": [
                {
                  "text": "24:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino zisyomezyo zyakaambilwa Abrahamu ambuto yakwe. Tacaambwi kuti imbuto zyako, nkukuti zinji, caambwa kuti “imbuto yako”, nkukuti yomwe, nkukuti Kristo, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.16",
            "verseOrgIds": [
              "GAL.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.40"
              },
              "items": [
                {
                  "text": "Kul 12:40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino cintu ncindaamba nceeci. Eco cizuminano ncaakasaanguna kujatisya Leza, tuukonzyi kucilobya Mulao iwakasika kusule amyaaka iili myaanda yone amakumi otatwe, alimwi tuukonzyi kubisizya cisyomezyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.17",
            "verseOrgIds": [
              "GAL.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GAL 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.4.14"
              },
              "items": [
                {
                  "text": "Rom 4:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.11.6"
              },
              "items": [
                {
                  "text": "11:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lukono kuti lwazwa ku-Mulao, talucizwi kucisyomezyo, pele ncisyomezyo Leza ncaakalupesya Abrahamu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.18",
            "verseOrgIds": [
              "GAL.3.18"
            ]
          }
        },
