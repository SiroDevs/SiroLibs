            "number": "20",
            "style": "v",
            "sid": "GAL 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Lino sikwiimaakati nkukwaamba kuti bavula bantu, pele Leza nguumwi luzutu). ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.20",
            "verseOrgIds": [
