        },
        {
          "text": "Sa zilyo teezyakasigwa kumeso esu? Lukondo alutangalo sa teezyamana kuŋanda ya-Leza wesu? ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.16",
