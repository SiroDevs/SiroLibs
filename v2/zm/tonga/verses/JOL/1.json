                }
              ]
            }
          ]
        },
        {
          "text": "Amubambe ciindi cakuliimya kulya, amucite imbungano, mubunganye banene abantu boonse bamunyika kuŋanda ya-Jehova Leza wanu, mukwiile kuli-Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.14",
            "verseOrgIds": [
