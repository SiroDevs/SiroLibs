              "type": "text"
            }
          ]
        },
        {
          "text": "Inseke zyanyana kunsi lyamaganko aazyo. Zibambilo zilisaalidwe, amatala alimwaikide, nkaambo maila abola. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.17",
