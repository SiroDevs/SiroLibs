                "loc": "JER.14.3"
              },
              "items": [
                {
                  "text": "Jer 14:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Balimi balyuuside, abasimisaansa balalila, nkaambo kabulotwe abbaale, nkaambo zitebulwa zyamumyuunda zilimanide. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.11",
            "verseOrgIds": [
              "JOL.1.11"
            ]
          }
        },
