                  "text": "Ciy 9:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kuleza bantu kuzoosaala nyika yangu, Mbayumu, alimwi tababaliki. Meno aabo ali mbuli meno aamulavu, abakampanga babo bali mbuli basyuumbwa, ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.6",
            "verseOrgIds": [
              "JOL.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOL 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
