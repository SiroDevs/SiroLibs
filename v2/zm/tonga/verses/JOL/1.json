              "attrs": {
                "loc": "ISA.5.6"
              },
              "items": [
                {
                  "text": "Is 5:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Banyonyoona musaansa wesu, amikuyu yesu baibisya. Kukupulula baikupulula akwiisowa, amitabi yayo baisonzoola, yasalala ngende.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.7",
            "verseOrgIds": [
              "JOL.1.7"
            ]
          }
        }
