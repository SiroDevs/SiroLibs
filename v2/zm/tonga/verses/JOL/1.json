            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.12.11"
              },
              "items": [
                {
                  "text": "Jer 12:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.24.7"
              },
              "items": [
                {
                  "text": "Is 24:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Myuunda ilisaalidwe, nyika ilalila, nkaambo maila alisaalidwe, awaini wayuminina, aalo mafuta alimanide. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.10",
            "verseOrgIds": [
              "JOL.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOL 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
