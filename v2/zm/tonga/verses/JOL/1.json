                "loc": "PSA.78.4"
              },
              "items": [
                {
                  "text": "Int 78:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amwaambile bana banu makani, abalo bana banu baambile bana babo, abana babo baambile izyalani limbi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.3",
            "verseOrgIds": [
              "JOL.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOL 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eco cakasyaala kudiingo cakacilya cisozi, aceeco cakasyaala kucisozi yakacilya inswabanda, aceeco cakasyaala kunswabanda camusokonya nguwakacilya. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.4",
            "verseOrgIds": [
              "JOL.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOL 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.32.10"
              },
              "items": [
                {
                  "text": "Is 32:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amubuke nubakolwi, mulile. Amuwuule nyoonse nubasikunywa waini, nkaambo kambote, ikuti yanyanzigwa kumilomo yanu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.5",
            "verseOrgIds": [
              "JOL.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
