                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amoomoke mbuli nakalindu uusamide masaka, uulila mulumi wakwe iwakamukwata lino lino. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.8",
