          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.14"
              },
              "items": [
                {
                  "text": "Joel 2:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo cituuzyo calesegwa, acipaizyo cakunywa coonse, kuŋanda ya-Jehova. Bapaizi basimilimo ba-Jehova balalila. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.9",
            "verseOrgIds": [
              "JOL.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
