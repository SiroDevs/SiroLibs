        },
        {
          "text": "Amuswiilile, nubapati. Amuteelele nubantu boonse bamunyika. Sa kwa­ kaboneka makani aali boobu, kuciindi canu nanka kuciindi camauso? ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.2",
            "verseOrgIds": [
              "JOL.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOL 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
