            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino nibakasika kucipolelo ca-Kidroni, Uza wakatandabika ijanza lyakwe kuti ajate ibbokesi, nkaambo basune bakali kulizungaanya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.9",
            "verseOrgIds": [
              "1CH.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
