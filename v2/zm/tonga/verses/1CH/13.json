        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.10.7"
              },
              "items": [
                {
                  "text": "1 Mak 10:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.37.4"
              },
              "items": [
                {
                  "text": "Is 37:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Davida wakaambila imbungano yoonse yaba-Israyeli kuti, Na cabota mumeso aanu, alimwi na Jehova Leza wesu ulayanda, atutumine bakwesu bamwi bali munyika yoonse ya-Israyeli, abapaizi aba-Levi bakede muminzi iili amweemvwe, kuti bayoboloke kulindiswe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.2",
            "verseOrgIds": [
              "1CH.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
