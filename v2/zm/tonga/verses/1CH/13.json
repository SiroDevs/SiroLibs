                "loc": "1SA.4.4"
              },
              "items": [
                {
                  "text": "1 Sam 4:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Davida aba-Israyeli boonse bakainka ku-Baala, ngonguwo Kiriyati-Jearimu mucisi ca-Juda kuti bagwisye nkuko ibbokesi lya-Leza uutegwa Jehova uukede akati kabakerebimu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.6",
            "verseOrgIds": [
              "1CH.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.4.15"
              },
              "items": [
                {
                  "text": "My 4:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino bakabika ibbokesi lya-Leza aŋola impiya, baligwisya muŋanda ya-Aminadabu. Uza a-Ahio mbobakali kweenzya iŋola. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.7",
            "verseOrgIds": [
              "1CH.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.6.5"
              },
              "items": [
                {
                  "text": "2 Sam 6:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Davida aba-Israyeli boonse bakali kusekelela kubusyu bwa-Jehova canguzu zyoonse, anyimbo abanamalwa atuntimbwa atugoma ansaka amyeembo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.8",
            "verseOrgIds": [
              "1CH.13.8"
            ]
          }
        }
