              "items": [
                {
                  "text": "Lev 10:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo bukali bwa-Jehova bwakabukila Uza, aboobo wakamuuma nkaambo kakutandabika ijanza lyakwe kubbokesi. Wakafwa mpoonya awo kubusyu bwaJehova. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.10",
            "verseOrgIds": [
              "1CH.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Davida wakabijilwa nkaambo kakuti Jehova wakasotokela Uza, aboobo oko kuntu wakakuulika izina lya-Luumo-lwa-Uza, mbukucaambwa asunu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.11",
            "verseOrgIds": [
              "1CH.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Davida wakayoowa Leza mubuzuba obo, wati, Ndete buti ibbokesi lya-Leza kulindime? ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.12",
            "verseOrgIds": [
              "1CH.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kako Davida taakwe naakasisya ibbokesi kulinguwe kumunzi wa-Davida, wakalitola kumbi kuŋanda ya-Obedi-Edomu mu-Giti. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.13",
            "verseOrgIds": [
              "1CH.13.13"
            ]
          }
        },
