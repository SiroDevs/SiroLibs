                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele wina naakabala misyobo yobile ya-Levi a-Benjamini, nkaambo ijwi lyamwami lyakasesemya Joabu,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.6",
            "verseOrgIds": [
