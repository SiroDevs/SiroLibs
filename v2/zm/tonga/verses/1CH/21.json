                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Davida wakayakila Jehova cipaililo nkukonya oko, watuula zituuzyo azipaizyo zyakutontozya, wakwiilila Jehova, nkabela wakamuvwiizya mulilo uuzwa kujulu, walokela acipaililo cakutuuzya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.26",
            "verseOrgIds": [
              "1CH.21.26"
            ]
          }
        },
        {
