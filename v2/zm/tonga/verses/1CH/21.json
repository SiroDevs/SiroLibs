                "loc": "2SA.24.24"
              },
              "items": [
                {
                  "text": "2 Sam 24:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aboobo Davida wakapa Orinani masyekeli aangolida aali myaanda iili musanu aumwi, ibe muulo wakuntu oko. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.25",
            "verseOrgIds": [
              "1CH.21.25"
            ]
          }
