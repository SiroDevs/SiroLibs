        },
        {
          "text": "Mwana wa-Solomoni kali Rehoboamu, ngonguwe iwakazyala Abiya, iwakazyala Asa, iwakazyala Jehosafati, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.10",
            "verseOrgIds": [
              "1CH.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
