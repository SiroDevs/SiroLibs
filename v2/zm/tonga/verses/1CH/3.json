                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino mbaaba mbaakazyalilwa mu-Jerusalemu: Simeya, a-Sobabu, a-Natani, a-Solomoni, bana bone mbaakazyala Batisua mwana musimbi wa-Amiyeli, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.5",
            "verseOrgIds": [
              "1CH.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "a-Ibara, a-Elisama, a-Elifeleti, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.6",
            "verseOrgIds": [
              "1CH.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
