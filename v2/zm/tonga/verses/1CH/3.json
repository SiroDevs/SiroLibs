                "loc": "EZR.3.2"
              },
              "items": [
                {
                  "text": "Ezr 3:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abana ba-Pedaya mbaaba: Zerubabeli a-Simei. Abana ba-Zerubabeli mbaaba: Mesulamu, a-Hananiya, a-Selomiti mucizi wabo, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.19",
            "verseOrgIds": [
              "1CH.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "a-Hasuba, a-Oheli, a-Berekiya, a-Hasadiya, a-Jusabihesedi, bana bosanwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.20",
            "verseOrgIds": [
              "1CH.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana ba-Hananiya mbaaba: Pelatiya, a-Jesaya, bana ba-Refaya, bana ba-Arinani, bana ba-Obadiya, bana ba-Sekaniya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.21",
            "verseOrgIds": [
              "1CH.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
