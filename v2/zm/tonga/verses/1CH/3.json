                  "text": "2 Sam 3:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "awamusanu kali Sefatiya mwana wa-Abitali; awamusanu aumwi kali Itreamu ngwaakazyala mukaakwe Egila. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.3",
            "verseOrgIds": [
              "1CH.3.3"
            ]
          }
        },
