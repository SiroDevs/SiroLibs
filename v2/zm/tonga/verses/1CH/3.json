              "items": [
                {
                  "text": "14:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbaabo boonse bana ba-Davida, kutaamba bana babasimamambe, a-Tamara mucizi wabo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.9",
