              "items": [
                {
                  "text": "2 Bam 24:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi jehoyakimu wakazyala Jekoniya, ngonguwe iwakazyala Zedekiya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.16",
            "verseOrgIds": [
              "1CH.3.16"
            ]
          }
        }
