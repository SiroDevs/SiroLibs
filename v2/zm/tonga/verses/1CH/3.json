            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana ba-Jekoniya iwakatolwa mubuzike mbaaba: Sealitiyeli mwana wakwe, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.17",
            "verseOrgIds": [
              "1CH.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "a-Malikiramu, a-Pedayu, a-Senazara, a-Jekamiya, a-Hosama, a-Nedabiya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.18",
            "verseOrgIds": [
              "1CH.3.18"
            ]
          }
        },
        {
