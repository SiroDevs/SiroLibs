              "items": [
                {
                  "text": "2 Sam 5:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "a-Elisama, a-Eliada, a-Elifeleti, bana bali musanu abane. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.8",
            "verseOrgIds": [
              "1CH.3.8"
            ]
          }
        },
