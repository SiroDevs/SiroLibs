          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "awatatu kali Abisalomu mwana wa-Maaka mwana musimbi wa-Talimai mwami wa-Gesuri; awane kali Adonija mwana wa-Hagiti; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.2",
            "verseOrgIds": [
              "1CH.3.2"
            ]
          }
        },
        {
