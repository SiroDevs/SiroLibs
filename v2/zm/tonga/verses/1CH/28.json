            }
          ]
        },
        {
          "text": "Nekubaboobo Jehova Leza wa-Israyeli nguwakandisala mebo akati kabasiŋanda boonse bataata kuti mbe mwami wa-Israyeli lyoonse, nkaambo wakasala musyobo wa-Juda kuti ube musolozi, alimwi mumusyobo wa-Juda wakasala luzubo lwataata, alimwi akati kabana bataata wakasala ndime kuti mbe mwami wacisi coonse ca-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.4",
            "verseOrgIds": [
              "1CH.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
