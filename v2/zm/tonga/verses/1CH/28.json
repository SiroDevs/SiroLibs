                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela bwami bwakwe njoobwiimika nji na wakakatila kukubamba milao yangu ambeta zyangu mbubonya mbwacita sunu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.7",
            "verseOrgIds": [
              "1CH.28.7"
            ]
          }
