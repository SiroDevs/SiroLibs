              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "abulemu bwangolida yazibelesyo zyoonse zyangolida izyakacitilwa mulimo umwi aumwi, abulemu bwansiliva yazibelesyo zyoonse zyansiliva izyakacitilwa mulimo umwi aumwi, ",
          "type": "text",
          "attrs": {
