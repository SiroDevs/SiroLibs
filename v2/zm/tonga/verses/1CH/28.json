                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela akati kabana bangu (nkaambo Jehova wandipa bana banji) wasala Solomoni kuti akale acuuno cabwami bwa-Jehova mucisi ca-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.5",
            "verseOrgIds": [
              "1CH.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 28:6"
