                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.13.5"
              },
              "items": [
                {
                  "text": "13:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.31.1"
              },
              "items": [
                {
                  "text": "31:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino ba-Filisti bakalwisya ba-Israyeli, nkabela bantu ba-Israyeli bakacija ba-Filisti, bakawa bufwide mucilundu citegwa Giliboa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.1",
            "verseOrgIds": [
              "1CH.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo ba-Filisti bakeenzya Saulo abana bakwe, nkabela ba-Filisti bakajaya Jonatani a-Abinadabu a-Malikisuwa bana ba-Saulo, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.2",
            "verseOrgIds": [
              "1CH.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkondo yakamuyumina Saulo, nkaambo basimata bakamujana, nkabela bakamuyasa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.3",
            "verseOrgIds": [
              "1CH.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.16.21"
              },
              "items": [
                {
                  "text": "Bab 16:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Saulo wakaambila sikuyumuna zilwisyo zyakwe kuti, Somona ipanga lyako, undiyasye ndilyo, kuti aba batapalwidwe batasiki ­kuzoondiweela. Pele sikuyumuna zilwisyo zyakwe wakakaka, nkaambo wakali kuyoowa loko, Lino Saulo wakabweza ipanga akuwa alindilyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.4",
            "verseOrgIds": [
              "1CH.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo sikuyumuna zilwisyo zyakwe, naakabona kuti Saulo wafwa, wakawa alakwe apanga lyakwe, wafwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.5",
            "verseOrgIds": [
              "1CH.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuboobo Saulo mbwaakafwa. Abalo bana bakwe botatwe aluzubo lwakwe loonse bakafwa boonse antoomwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.6",
            "verseOrgIds": [
              "1CH.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela bantu boonse ibakakede mukuti, nibakabona kuti basilumamba bacija, alimwi Saulo abana bakwe balifwide, bakasiya minzi yabo, bacija. Elyo ba-Filisti bakeza kuzookala mulinjiyo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.7",
            "verseOrgIds": [
              "1CH.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.7",
            "verseOrgIds": [
              "1CH.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino nibwakaca, ba-Filisti bakasika kuzoosaala bajayidwe, nkabela bakajana Saulo abana bakwe balifwide nkukonya oko kucilundu citegwa Giliboa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.8",
            "verseOrgIds": [
              "1CH.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo bakamusaala, batola mutwe wakwe azilwisyo zyakwe, batuma batumwa munyika yoonse iiengelede yaba-Filisti kuti balwiide ba-Leza babo abantu babo aya makani mabotu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.9",
            "verseOrgIds": [
              "1CH.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.31.10"
              },
              "items": [
                {
                  "text": "1 Sam 31:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.48.5"
              },
              "items": [
                {
                  "text": "Is 48:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azilwisyo zyakwe bakazibika muŋanda yabaLeza babo, akalo kapapa kamutwe wakwe bakakakankamina muŋanda yaDagoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.10",
            "verseOrgIds": [
              "1CH.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele bantu boonse baku-Jabesi-Gileadi, nibakamvwa zintu ezi zyoonse ba-Filisti nzibakacitila Saulo, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.11",
            "verseOrgIds": [
              "1CH.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "baalumi babo basinguzu bakanyamuka boonse, baakuleta mutunta wa-Saulo amitunta yabana bakwe, baisisya ku-Jabesi, akuzika zifuwa zyabo munsi lyamubanga mu-Jabesi, Elvo bakalila mazuba aali musanu aabili.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.12",
            "verseOrgIds": [
              "1CH.10.12"
            ]
          }
        }
      ]
    },
