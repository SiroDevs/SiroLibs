                  "text": "1 Sam 28:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbuboobo Saulo mbwaakafwa nkaambo kakutasyomeka kwakwe, Taakwe naakasyomeka kumeso aa-Jehova, nkaambo takwakacita Jehova ngaakamulailila, alimwi wakabuzya makani kumuntu iwakajisi muuya wabusondi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.13",
            "verseOrgIds": [
              "1CH.10.13"
            ]
          }
        },
