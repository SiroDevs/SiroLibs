              "items": [
                {
                  "text": "15:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "takwakabuzya makani kuli-Jehova, Nciceeco Jehova ncaakamujayila akwaaba mwami mumaanza aa-Davida mwana wa-Jese.",
          "type": "text",
          "attrs": {
