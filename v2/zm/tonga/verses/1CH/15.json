              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "bana ba-Merari, Asaya silutwe abeenzinyina bali myaanda yobile amakumi obile; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.6",
            "verseOrgIds": [
              "1CH.15.6"
            ]
          }
        },
