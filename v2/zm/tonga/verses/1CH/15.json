              "items": [
                {
                  "text": "Int 81:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abapaizi Sebaniya a-Josafati a-Netaneli a-Amasai a-Zekariya a-Benaya a-Eliezeri mbobakali kulizya myeembo kunembo lyabbokesi lya-Leza. Abalo Obedi-Edomu a-Jehiya bakali basimulyango babbokesi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.24",
