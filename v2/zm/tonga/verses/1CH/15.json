        },
        {
          "text": "Elyo ba-Levi bakabika Hemani mwana wa-Joeli, aumwi wababunyina, Asafu mwana wa-Berekiya; amubana ba-Merari bakwabo, Etani mwana wa-Kusaya; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.17",
            "verseOrgIds": [
              "1CH.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "abakwabo batobela lwabili, Zekariya, Beni, a-Jaazieli, aSemiramoti, a-Jeieli, a-Uni, Eliabu, a-Benaya, a-Maaseya, a-Matitiya, a-Elifelehu, a-Mikineya, abasimilyango Obedi-Edomu a-Icieli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.18",
            "verseOrgIds": [
              "1CH.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasikwiimba: Hemani a-Asafu a-Etani mbobakali kulizya zigweele zyamukuba; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.19",
            "verseOrgIds": [
              "1CH.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "a-Zekariya a-Azieli a-Semiramoti a-Jehieli a-Uni a-Eliabu a-Maaseya a-Benaya mbobakali kulizya nyeele zyansenseeku; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.20",
            "verseOrgIds": [
              "1CH.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "a-Matitiya a-Elifelehu a-Mikineya a-Obedi-Edomu a-Jeieli a-Azaziya mbobakali kulizya tuntimbwa twasyamupa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.21",
            "verseOrgIds": [
              "1CH.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "A-Kenaniya mwiimbi simutwe waba-Levi nguwakeelede kwiimbya, nkaambo kezi loko. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.22",
            "verseOrgIds": [
              "1CH.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "A-Berekiya a-Elikana mbobakali basimulyango babbokesi lya-Leza. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.23",
            "verseOrgIds": [
              "1CH.15.23"
            ]
          }
        },
