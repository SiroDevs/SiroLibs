              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.13.8"
              },
              "items": [
                {
                  "text": "1 Mak 13:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aboobo ba-Israyeli boonse bakaleta ibbokesi lyacizuminano ca-Jehova, bali kuyobayoba, akulizya mweembo ampeta azigweele, akulizya nyeele atuntimbwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.28",
