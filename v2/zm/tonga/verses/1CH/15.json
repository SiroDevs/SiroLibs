        {
          "text": "bana ba-Kohati, Urieli silutwe abeenzinyina bali mwaanda amakumi obile; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.5",
            "verseOrgIds": [
              "1CH.15.5"
