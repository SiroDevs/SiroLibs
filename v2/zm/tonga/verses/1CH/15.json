                  "text": "Job 42:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Leza mbwaakali kugwasya ba-Levi ibakayumwide ibbokesi lyacizuminano ca-Jehova, bakatuula bacende bali musanu ababili abagutu bambelele bali musanu ababili. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.26",
            "verseOrgIds": [
              "1CH.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Davida kasamine cikobela casani lituba, abalo ba-Levi ibakayumwide ibbokesi, abasikwiimba, a-Kenaniya musolozi wabasikwiimba. Alimwi Davida kasamine cibaki cabupaizi casani lituba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.27",
            "verseOrgIds": [
              "1CH.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 15:28"
          },
          "items": [
