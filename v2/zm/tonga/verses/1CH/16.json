          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Davida wakasia Asafu ababunyina nkukonya oko kunembo lyabbokesi lyacizuminano ca-Jehova, kuti babeleke milimo kunembo lyabbokesi mazuba oonse, mbukweelede kubuzuba bumwi abumwi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.37",
            "verseOrgIds": [
              "1CH.16.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 16:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "alakwe ObediEdomu, ababunyina bali makumi aali musanu alimwi amusanu abatatu, Obedi-Edomu mwana wa-Jedutuni a-Hosa mbobakali kulindila milyango. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.38",
            "verseOrgIds": [
              "1CH.16.38"
            ]
          }
        },
