        },
        {
          "text": "Bakali a-Hemani a-Jedutani abamwi ibakasalwa akulembwa mazina kuti batembaule Jehova, nkaambo luse lwakwe talweeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.41",
            "verseOrgIds": [
              "1CH.16.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CH 16:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hemani a-Jedutuni bakali amyeembo azigweele zyakulizya azyakwiimbya nyimbo zya-Leza. Abalo bana ba-Jedutuni mbobakabikwa kuti balange mulyango.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.42",
            "verseOrgIds": [
              "1CH.16.42"
            ]
          }
        }
