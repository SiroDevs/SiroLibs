              "type": "text"
            }
          ]
        },
        {
          "text": "Lino ndoolu lutembauzyo Davida ndwaakataanguna kubika mubuzuba obo kuti lwiimbilwe Jehova kumilomo ya-Asafu ayababunyina.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.7",
            "verseOrgIds": [
              "1CH.16.7"
            ]
          }
        }
