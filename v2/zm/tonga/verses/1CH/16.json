                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alakwe Zadoki mupaizi abapaizinyina wakabasia kunembo lyatente lyambunganino lya-Jehova, kucilundu cakukombela caku-Gibeoni, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.39",
            "verseOrgIds": [
              "1CH.16.39"
            ]
          }
        },
