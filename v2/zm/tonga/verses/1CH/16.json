              "items": [
                {
                  "text": "My 28:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kuti bapaizizye Jehova zipaizyo acipaililo cakutuula, mazuba oonse cifumo amangolezya, akucita zyoonse zilembedwe mumulao wa-Jehova nzyaakalailila ba-Israyeli, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.40",
