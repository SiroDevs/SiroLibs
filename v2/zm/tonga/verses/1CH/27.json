          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asilutwe wasanu wamumwezi wasanu kali Samuti mu-Izra, Munkamu yakwe kamuli bantu bali zyuulu zili makumi obile azine. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.8",
            "verseOrgIds": [
