                  "text": "1 Bam 4:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi silutwe wampi mumwezi watatu kali Benaya mwana wa-Jehoyada mupaizi mupati. Munkamu yakwe kamuli bantu bali zyuulu zili makumi obile azine, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.5",
            "verseOrgIds": [
