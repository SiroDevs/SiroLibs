              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.24.15"
              },
              "items": [
                {
                  "text": "2 Sam 24:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.21.7"
              },
              "items": [
                {
                  "text": "1 Mak 21:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Joabu mwana wa-Zeruya wakatalika kubala, pele taakwe naakabamana. Ba-Israyeli bakabukilwa bukali nkaambo kamakani aya, aboobo mweelwe teewakalembwa mubbuku lyamakani aaciindi lyamwami Davida.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.24",
            "verseOrgIds": [
              "1CH.27.24"
            ]
          }
        }
      ]
    },
    {
