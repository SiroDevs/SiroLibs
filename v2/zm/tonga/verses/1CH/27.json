              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.38.29"
              },
              "items": [
                {
                  "text": "Matl 38:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kali waluzubo lwa-Perezi, nkabela kali mupati wabasilutwe boonse bampi mumwezi mutaanzi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.3",
            "verseOrgIds": [
              "1CH.27.3"
            ]
