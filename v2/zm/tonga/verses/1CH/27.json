                "loc": "HEB.11.12"
              },
              "items": [
                {
                  "text": "Heb 11:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele Davida taakwe naakabala bantu ibakajisi myaka iili makumi obile na bacili kunsi, nkaambo Jehova wakasyomezya kuvuzya ba-Israyeli mbubonya mbuli inyenyeezi zyakujulu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.23",
            "verseOrgIds": [
              "1CH.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 27:24"
          },
          "items": [
