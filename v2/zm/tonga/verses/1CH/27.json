              "items": [
                {
                  "text": "1 Sam 16:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "mwami waba-Juda kali Elihu umwi wababunyina ba-Davida; mwami wa-Isakara kali Omri mwana wa-Mikayeli; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.18",
            "verseOrgIds": [
              "1CH.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwami wa-Zebuloni kali Isimaya mwana wa-Obadiya; mwami wabaNafitali kali Jeremoti mwana wa-Azrieli; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.19",
            "verseOrgIds": [
              "1CH.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwami wabana ba-Efraimu kali Hosea mwana wa-Azaziya; mwami wacisela camusyobo wa-Manase kali Joeli mwana wa-Pedaya; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.20",
            "verseOrgIds": [
              "1CH.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwami wacisela camusyobo wa-Manase cakuGileadi kali Ido mwana wa-Zekariya; mwami waba-Benjamini kali Jasiyeli mwana wa-Abineri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.21",
            "verseOrgIds": [
              "1CH.27.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwami waba-Dani kali Azareli mwana wa-Jerohamu. Mbaabo bami bamisyobo yaba-Israyeli, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.22",
            "verseOrgIds": [
              "1CH.27.22"
            ]
          }
        },
        {
