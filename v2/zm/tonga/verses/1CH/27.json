              },
              "items": [
                {
                  "text": "2 Sam 23:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Dodai mu-Ahohi kali silutwe wankamu yamwezi wabili. Munkamu yakwe kamuli bantu bali zyuulu zili makumi obile azine. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.4",
            "verseOrgIds": [
              "1CH.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
