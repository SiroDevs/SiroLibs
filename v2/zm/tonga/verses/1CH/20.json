                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino nilwakasika lwaka, ciindi bami nibazibilila kuya kunkondo, Joabu wakatola impi yabasilumamba akusaala cisi caba-Amoni. Lino wakasika ku-Raba akusinkinizya munzi oyo, pele Davida kacikede mu-Jerusalemu. Nkabela Joabu wakakoma Raba akuunyonyoona. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.1",
            "verseOrgIds": [
              "1CH.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.12.30"
              },
              "items": [
                {
                  "text": "2 Sam 12:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.12.31"
              },
              "items": [
                {
                  "text": "31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Davida wakagwisya munsini wamwami wabo kumutwe wakwe, wajana kuti bulemu bwawo nditalenta lyangolida, alimwi kuujisi mabwe mayandisi. Elyo wakabikwa amutwe wa-Davida, Nkabela wakagwisya zisaalo zinji loko omo mununzi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.2",
            "verseOrgIds": [
              "1CH.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalo bantu ibakali mumo, wakabagwisya akubabika kumasaha, akuzisagwidyo zyabutale, atuleba. Mbuboobo Davida mbwaakacitila minzi yoonse yaba-Amoni. Lino Davida wakapiluka abantu boonse ku-Jerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.3",
            "verseOrgIds": [
              "1CH.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.3",
            "verseOrgIds": [
              "1CH.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino musule lyayaaya kwakabuka inkondo aba-Filisti ku-Gezeri. Elyo Sibekai mu-Husati wakajaya Sipai umwi wabana ba-Refaya, aboobo ba-Filisti bakakomwa, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.4",
            "verseOrgIds": [
              "1CH.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino kwakabuka inkondo aimwi aba-Filisti, nkabela Elihanani mwana wa-Jairi wakajaya Lami munyina Goliati mu-Giti, Luti lwasumo lyakwe lwakali mbuli cisamu casikuluka. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.5",
            "verseOrgIds": [
              "1CH.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ankondo imwi yakabuka ku-Gati, Oko kakuli muntu uuli aciimo cipati. Kajisi minwe iili musanu aumwi kujanza limwi alimwi, atunwe tuli musanu akamwi kukuulu kumwi akumwi, nkukuti yoonse kiili makumi obile aine. Alakwe kali umwi wabana ba-Refaya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.6",
            "verseOrgIds": [
              "1CH.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino oyo naakasampaula ba-Israyeli, jonatani mwana wa-Simeya munyina Davida wakamujaya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.7",
            "verseOrgIds": [
              "1CH.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba boonse kabali bana baRefaya baku-Gati, Bakajayigwa kumaanza aa-Davida akumaanza aabalanda bakwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.8",
            "verseOrgIds": [
              "1CH.20.8"
            ]
          }
        }
      ]
    }
