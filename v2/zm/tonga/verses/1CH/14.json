                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Davida naakabuzya kuli-Leza, Leza wakamwaambila kuti, Utainki kuyoobalwisya pe. Koya buzyunguluka kuti ubajane kulangene amikunka. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.14",
            "verseOrgIds": [
              "1CH.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino umvwe buyo musoso wakweenda kumpela yamikunka, nyamuka ndilyonya kuyoobalwisya, nkaambo Leza wakuzulwida kuya kukukoma impi yaba-Filisti. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.15",
            "verseOrgIds": [
              "1CH.14.15"
            ]
          }
        },
        {
