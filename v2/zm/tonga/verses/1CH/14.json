            "number": "2",
            "style": "v",
            "sid": "1CH 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Davida wakazibisya kuti Jehova ulimwiimikide nji mbuli mwami wabaIsrayeli, alimwi kuti wasumpula bwami bwakwe nkaambo kabantu bakwe ba-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.2",
            "verseOrgIds": [
              "1CH.14.2"
            ]
          }
        }
      ]
    },
