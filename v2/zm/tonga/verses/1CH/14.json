        },
        {
          "text": "Elyo Davida wakakwata banakazi abambi mu-Jerusalemu, nkabela Davida wakazyala abambi bana balombe abasimbi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.3",
            "verseOrgIds": [
              "1CH.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
