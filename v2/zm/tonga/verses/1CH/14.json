                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo Davida wakacita mbubonya mbuli Leza mbwaakamulailila­, aboobo wakazunda impi yaba-Filisti kuzwa ku-Gibeoni kusikila ku-Gezeri, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.16",
            "verseOrgIds": [
              "1CH.14.16"
            ]
          }
