        },
        {
          "text": "Mpawo Hiramu mwami wa-Turo wakatuma batumwa kuli-Davida, amisamu yakedari, abayaki ababezi, kuti bamuyakile iŋanda, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.1",
            "verseOrgIds": [
