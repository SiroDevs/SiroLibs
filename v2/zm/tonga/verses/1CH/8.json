              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Ahazi wakazyala Jehoada, alakwe Jehoada wakazyala Alemeti, a-Azmaveti, aZimri. Alakwe Zimri wakazyala Moza, ",
          "type": "text",
          "attrs": {
