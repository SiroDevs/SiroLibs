            }
          ]
        },
        {
          "text": "Abana ba-Mika mbaaba: Pitoni, a-Meleki, a-Tareya, a-Ahazi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.35",
            "verseOrgIds": [
