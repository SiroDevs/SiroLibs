              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana ba-Joeli: wakazyala Semaya, iwakazyala Gogo, iwakazyala Simeyi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.4",
            "verseOrgIds": [
