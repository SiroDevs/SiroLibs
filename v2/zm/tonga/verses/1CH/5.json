          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joeli kali mutaanzi, a-Safamu wabili, a-Janai, aSafati, munyika ya-Basana, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.12",
            "verseOrgIds": [
              "1CH.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
