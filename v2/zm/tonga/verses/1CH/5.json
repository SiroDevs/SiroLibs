          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "iwakazyala Mika, iwakazyala Reaya, iwakazyala Baala, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.5",
            "verseOrgIds": [
              "1CH.5.5"
