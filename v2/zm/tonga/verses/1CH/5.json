        },
        {
          "text": "Lino bana ba-Gadi kabakede bubambene abo munyika ya-Basana mane kusikila ku-Saleka. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.11",
            "verseOrgIds": [
              "1CH.5.11"
            ]
          }
        },
        {
