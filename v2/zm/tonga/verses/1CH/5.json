                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela mumazuba aa-Saulo bakalwisya ba-Hagiri, babazunda akukala muzilao zyabo moonse mucisi cili kujwe lya-Gileadi,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.10",
