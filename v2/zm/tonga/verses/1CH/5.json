          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ababunyina baluzubo lwawisi mbaaba: Mikayeli, a-Mesulamu, a-Seba, a-Jorai, a-Jakani, a-Ziya, a-Eberi, bantu bali musanu ababili. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.13",
            "verseOrgIds": [
              "1CH.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbaabo bana ba-Abihaili mwana wa-Huri mwana wa-Jarowa mwana wa-Gileadi mwana wa-Mikayeli mwana wa-Jesisai mwana wa-Jado mwana wa-Buzi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.14",
            "verseOrgIds": [
              "1CH.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahi mwana wa-Abidieli mwana waGuni kali silutwe waluzubo lwabo, ",
          "type": "text",
