              "type": "text"
            }
          ]
        },
        {
          "text": "Ababunyina anzubo zyabo, mbubalembedwe mubbuku lyabansiku, mbaaba: mutaanzi kali jeyeli, aZekariya, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.7",
