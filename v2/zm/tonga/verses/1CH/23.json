        {
          "text": "Bana ba-Musa mbaaba: Gerisomu a-Eliezeri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.15",
            "verseOrgIds": [
              "1CH.23.15"
            ]
          }
