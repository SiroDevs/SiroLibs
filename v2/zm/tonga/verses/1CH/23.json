          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana ba-Gerisomu mbaaba: Ladani a-Simeyi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.7",
            "verseOrgIds": [
              "1CH.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana ba-Ladani mbaaba: Jehieli mupati, a-Zetamu a-Joeli, bali botatwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.8",
            "verseOrgIds": [
              "1CH.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana baSimeyi mbaaba: Selomoti a-Hazieli a-Hanani, bali botatwe. Mbombabo basilutwe banzubo zya-Ladani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.9",
            "verseOrgIds": [
              "1CH.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana ba-Simeyi mbaaba: jahati aZina a-Jeusi a-Beriya. Aba bone boonse bakali bana ba-Simeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.10",
            "verseOrgIds": [
              "1CH.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jahati kali mutaanzi, a-Zina kali wabili, pele Jeusi a-Beriya teebakazyede bana banji, aboobo bana babo bakabalwa mbuli luzubo lomwe buyo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.11",
            "verseOrgIds": [
              "1CH.23.11"
            ]
          }
        }
      ]
