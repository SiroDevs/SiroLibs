          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana ba-Gerisomu: Sebuyeli mutaanzi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.16",
            "verseOrgIds": [
              "1CH.23.16"
            ]
          }
        },
        {
