          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana ba-Izara mbaaba: Selomiti mutaanzi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.18",
            "verseOrgIds": [
              "1CH.23.18"
            ]
          }
        },
        {
          "name": "verse",
