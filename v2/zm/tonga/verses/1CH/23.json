                  "text": "My 4:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ba-Levi boonse ibakajisi myaka iili makumi otatwe nanka kuya kunembo bakabalwa, nkabela mweelwe wabaalumi wakasika kuzyuulu zili makumi otatwe amusanu azitatu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.3",
            "verseOrgIds": [
              "1CH.23.3"
            ]
          }
        },
