          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana ba-Eliezeri: Rehabiya mutaanzi. Eliezeri katakwe bana bambi, pele bana ba-Rehabiya bakali banji loko. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.17",
            "verseOrgIds": [
              "1CH.23.17"
            ]
          }
        },
        {
