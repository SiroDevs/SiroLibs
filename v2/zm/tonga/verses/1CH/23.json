                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino ba-Levi tabaceelede kuyumuna itente lyambungano azibelesyo zyamilimo yalyo, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.26",
            "verseOrgIds": [
              "1CH.23.26"
            ]
          }
        },
