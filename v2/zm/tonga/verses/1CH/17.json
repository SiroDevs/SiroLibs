                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Njooba wisi, alakwe uyooba mwanaangu. Nsikooyoomunyanzya luzyalo lwangu mbundakanyanzya oyo iwakakutaangunina mubwami. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.13",
            "verseOrgIds": [
              "1CH.17.13"
            ]
          }
        },
