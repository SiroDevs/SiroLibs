          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo wandiyubunwida ndemulanda wako, O Leza wangu, kuti uyoondiyakila iŋanda. Nciceeco ndemulanda wako ncindalijanina bukozu bwakukukombela cikombyo eci. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.25",
            "verseOrgIds": [
              "1CH.17.25"
            ]
          }
