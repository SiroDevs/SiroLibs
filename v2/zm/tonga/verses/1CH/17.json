                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Njoocita kuti aime nji muŋanda yangu amubwami bwangu mazuba oonse aakutamani. Cuuno cabwami bwakwe ciyoosimpikwa mane kukabe kutamani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.14",
            "verseOrgIds": [
              "1CH.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Natani wakaambila Davida majwi aya oonse acilengano coonse ncaakabwene.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.15",
            "verseOrgIds": [
              "1CH.17.15"
            ]
          }
        }
      ]
