                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.49.17"
              },
              "items": [
                {
                  "text": "Is 49:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi nzoobikila bantu bangu ba-Israyeli busena, akubasimpika kuti bakale kabotu mpobabede akutazungaana limbi. Bantu babi tabakooyoobapenzya limbi, mbubakali kutaanguna kubapenzya, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.9",
            "verseOrgIds": [
              "1CH.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuzwa kumazuba alya nindakaboola bantu bangu ba-Israyeli babetesi. Nkabela njoobombya basinkondonyoko boonse. Alimwi ndakulwiida kuti Jehova uyookuyakila iŋanda. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.10",
            "verseOrgIds": [
              "1CH.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mazuba aako naazoozulila aakuya nkubabede bamauso bafwide, njookubusizya inyungu zyako, umwi wabana bako uuelede kulya izina lyako, nkabela njoosimpika kabotu bwami bwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.11",
            "verseOrgIds": [
              "1CH.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngonguwe uuti ndiyakile iŋanda, nkabela njoosimpika cuuno cabwami bwakwe kuti citazungaani mazuba oonse. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.12",
            "verseOrgIds": [
              "1CH.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
