            }
          ]
        },
        {
          "text": "Lino Davida naakakede muŋanda yakwe, Davida wakaambila Natani musinsimi kuti, Bona! Mebo ndikede muzjanda yazisamu zyakedari, pele ibbokesi lyacizuminano ca-Jehova cili mucilao camasani buyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.1",
            "verseOrgIds": [
              "1CH.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo Natani wakaambila Davida kuti, Mbubo, kocita zyoonse zili mumoyo wako, nkaambo Leza uli ayebo,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.2",
            "verseOrgIds": [
              "1CH.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
