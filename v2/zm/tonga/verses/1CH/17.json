                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aboobo izina lyako liyooyumisigwa akulemekwa lyoonse. Kuyooambwa kuti, Jehova wamakamu Leza wa-Israyeli ngonguwe Leza waba-Israyeli. Alwalo luzubo lwa-Davida mulanda wako luyooima nji kubusyu bwako. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.24",
            "verseOrgIds": [
              "1CH.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
