              "items": [
                {
                  "text": "Joh 21:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Davida acaambe buti kulinduwe, mbolemeka mulanda wako? Nkaambo ulizi mulanda wako. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.18",
            "verseOrgIds": [
              "1CH.17.18"
            ]
          }
