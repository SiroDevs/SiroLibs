                }
              ]
            }
          ]
        },
        {
          "text": "Mbuboobo Leza mbwaakabombya Jabini mwami wa-Kanana buzuba obo kubusyu bwabana ba-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.23",
