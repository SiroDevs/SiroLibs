          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele Baraki wakacili kuya butobela inkalaki abasimpi mane kusikila ku-Haroseti wabamasi, nkabela basimpi boonse ba-Sisera bakajazigwa ipanga, teekwakasyaala muntu naba omwe.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.16",
            "verseOrgIds": [
              "JDG.4.16"
            ]
          }
