              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.5.26"
              },
              "items": [
                {
                  "text": "Bab 5:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Jaeli muka-Heberi mu-Keni wakabweza inembe yacilao, alimwi wakabweza insando mujanza lyakwe, wakeza nkwakabede cakubelelela, wakamuumya inembe mumpobe zyakwe, akumukankamina ansi. Wakali muŋonzi impati, nkaambo wakakataala, aboobo wakafwa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.21",
            "verseOrgIds": [
              "JDG.4.21"
            ]
          }
        }
