          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo Baraki wakabunganya inkalaki zyakwe zyoonse, inkalaki zyabutale zili myaanda iili musanu aine, abantu boonse mbaakali abo, kuzwa ku-Haroseti wabamasi akusikila kukalonga ka-Kisoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.13",
            "verseOrgIds": [
              "JDG.4.13"
            ]
          }
        },
