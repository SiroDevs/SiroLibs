                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Jehova wakapyopyonganya Sisera ankalaki zyakwe zyoonse abasimpi bakwe boonse kumulomo wapanga kubusyu bwa-Baraki, elyo Sisera wakazwa munkalaki yakwe, wakacija amaulu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.15",
            "verseOrgIds": [
              "JDG.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
