              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musule lyayooyo, Abidoni mwana wa-Hilelu mu-Piratoni nguwakali kubeteka ba-Israyeli, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.13",
