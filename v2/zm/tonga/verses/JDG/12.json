          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Jefita wakabeteka ba-Israyeli myaka iili musanu aumwi. Nkabela Jefita mu-Gileadi naakafwa, wakazikwa mumunzi wakwe waku-Gileadi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.7",
            "verseOrgIds": [
              "JDG.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
