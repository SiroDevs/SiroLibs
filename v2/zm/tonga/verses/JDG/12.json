          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino jefita naakamana kufwa, Ibizani waku-Betelehemu nguwakali kubeteka ba-Israyeli, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.8",
            "verseOrgIds": [
              "JDG.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kazyede bana balombe bali makumi otatwe abana basimbi bali makumi otatwe. Basimbi wakabakwatya kumbi, alimwi wakaleta basimbi bali makumi otatwe bazwa kumbi kuzookwatwa kubana bakwe balombe. Wakabeteka ba-Israyeli myaka iili musanu aibili ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.9",
            "verseOrgIds": [
              "JDG.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Ibizani naakafwa, wakazikwa ku-Betelehemu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.10",
            "verseOrgIds": [
              "JDG.12.10"
            ]
          }
        }
      ]
    },
