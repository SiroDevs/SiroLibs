                  "text": "10:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kajisi bana bali makumi one abazukulu bali makumi otatwe, ibakali kweenda balitantide ambongolo zili makumi aali musanu aabili. Wakabeteka ba-Israyeli myaka iili musanu aitatu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.14",
            "verseOrgIds": [
