              "items": [
                {
                  "text": "Bab 8:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino bantu ba-Efraimu, nibakaitwa kunkondo, bakainda ku-Zafoni, bakaambila jefita kuti, Ino nkaambonzi teewakatwiita akuya aswebo, ciindi eco niwakainka kuyoolwisya bana ba-Amoni. Tulatenta iŋanda yako amulilo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.1",
            "verseOrgIds": [
              "JDG.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jefita wakabaambila kuti, Twakali ankondo loko abana baAmoni, mebo abantu bangu. Nkabela ndakamwiita, pele teemwakandivuna kumaanza aabo pe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.2",
            "verseOrgIds": [
              "JDG.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
