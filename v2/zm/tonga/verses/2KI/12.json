        },
        {
          "text": "Lino Joasi wakaambila bapaizi kuti, Mali oonse aazintu zisalala aaletwa muŋanda ya-Jehova, naaba mali aamutelo muntu umwi aumwi ngaatelesegwa, naaba mali ngaleta mukuyanda kwamoyo wakwe mwini, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.4",
            "verseOrgIds": [
              "2KI.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "bapaizi baatambule, umwi aumwi kumaanza aabazolwani bakwe, bamamike iŋanda kufumbwa nkwiielede kumamikwa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.5",
            "verseOrgIds": [
              "2KI.12.5"
            ]
          }
        }
      ]
    },
    {
