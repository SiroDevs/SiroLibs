        },
        {
          "text": "Mumwaka wamusanu aibili wabwami bwa-Jehu, Joasi naakalya bwami. Nkabela wakeendelezya mu-Jerusalemu myaka iili makumi one. Izina lyabanyina kabali Zibiya waku-Beeri-seba. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.1",
            "verseOrgIds": [
              "2KI.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Joasi wakacita ziluleme mumeso aa-Jehova mazuba oonse ngaakali kupona, nkaambo Jehoyada mupaizi wakali kumulaya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.2",
            "verseOrgIds": [
              "2KI.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 12:3"
          },
          "items": [
