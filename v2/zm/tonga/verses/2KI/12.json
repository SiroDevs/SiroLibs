                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nekubaboobo zipaililo zyakuzilundu taakwe naakazigwisya pe; bantu bakacili kupaila akutenta tununkilizyo kulinzizyo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.3",
            "verseOrgIds": [
              "2KI.12.3"
            ]
          }
        }
