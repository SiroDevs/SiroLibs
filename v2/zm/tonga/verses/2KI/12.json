              "items": [
                {
                  "text": "2 Mak 24:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele mumwaka wamakumi obile aitatu wabwami bwa-Joasi, bapaizi kabatana kutalika kumamika iŋanda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.6",
            "verseOrgIds": [
              "2KI.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo mwami Joasi wakaita Jehoyada mupaizi abapaizinyina, wababuzya kuti, Ino nkaambonzi tamuna kumamika iŋanda? Lino amuleke kutambula mali kubazolwani banu, mwaalete kukumamika iŋanda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.7",
            "verseOrgIds": [
              "2KI.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo bapaizi bakazumina kuleka kutambula mali kubantu, alimwi kutamamika iŋanda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.8",
            "verseOrgIds": [
              "2KI.12.8"
            ]
          }
        }
      ]
    },
    {
