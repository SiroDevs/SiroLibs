              "items": [
                {
                  "text": "Lk 21:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele Jehoyada mupaizi wakabweza ibbokesi, watulula ajulu, walibika kumbali lyacipaililo kululyo lwamanjililo aaŋanda ya-Jehova, nkabela bapaizi ibakali kulanga cikunguzyo bakabika mulindilyo mali oonse aakaletwa muŋanda ya-Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.9",
            "verseOrgIds": [
              "2KI.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino nibakabona kuti mali aamubbokesi avula, mulembi wamwami amupaizi mupati bali kusika kuzoobala akwaanga mali aakajanwa muŋanda ya-Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.10",
            "verseOrgIds": [
              "2KI.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mali amane kubalwa, bakaaba mumaanza aabasimilimo ibakali kulanga iŋanda ya-Jehova, abalo bakabbadela basikubeza zisamu abayaki ibakali kubeleka muŋanda ya-Jehova, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.11",
            "verseOrgIds": [
              "2KI.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "abasikubumba zitina abasikubeza mabwe, akuula zisamu, amabwe aabezedwe aakumamika iŋanda ya-Jehova, azintu zimwi izyakayandika kuŋanda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.12",
            "verseOrgIds": [
              "2KI.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele ayo mali aakaletwa muŋanda ya-Jehova taakwe naakabelesegwa kucitya mitiba yansiliva, nituba tugele, niiba migaano, niiba myeembo, niziba zibelesyo zimwi zyangolida na zyansiliva. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.13",
            "verseOrgIds": [
              "2KI.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapegwa basimilimo, kuti baabelesye kukumamika iŋanda ya-Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.14",
            "verseOrgIds": [
              "2KI.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
