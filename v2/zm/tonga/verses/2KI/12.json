                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele mali aazipaizyo zyamilandu azipaizyo zyazibi taakwe naakaletwa muŋanda ya-Jehova pe, akali aabapaizi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.16",
