                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.8.20"
              },
              "items": [
                {
                  "text": "2 Kor 8:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela abo bantu mbubakaabila mali aakubbadela basimilimo, teebakabuzya makani aamali mbwaabelesegwa pe, nkaambo bantu bakalisyomekede. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.15",
            "verseOrgIds": [
              "2KI.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
