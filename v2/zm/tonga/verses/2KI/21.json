          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo bantu bacisi bakajaya bantu abo ibakavwiyide mwami Amoni. Nkabela bantu bacisi bakabika bwami bwakwe mumaanza aamwanaakwe Josiya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.24",
            "verseOrgIds": [
