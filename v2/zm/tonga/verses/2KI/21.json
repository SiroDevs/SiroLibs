        {
          "text": "Nkabela wakayaka zipaililo munanda ya-Jehova, njenjiyo Jehova njaakaamba kuti, Mu-Jerusalemu monjoobika izina lyangu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.4",
