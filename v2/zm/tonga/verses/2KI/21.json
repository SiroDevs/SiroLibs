                  "text": "2 Mak 33:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo Manase naakafwa, wakazikwa mumuunda waŋanda yakwe, mumuunda wa-Uza, nkabela Amoni mwanaakwe wakalya izina lyakwe.",
          "type": "text",
          "attrs": {
