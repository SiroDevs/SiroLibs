              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amoni kajisi myaka iili makumi obile aibili naakaba mwami, nkabela wakeendelezya mu-Jerusalemu myaka yobile. Izina lyabanyina bakali Mesulemeti mwana wa-Haruzi waku-Jotiba. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.19",
            "verseOrgIds": [
              "2KI.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela wakacita bubi mumeso aa-Jehova mbubonya mbwaakacita wisi Manase. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.20",
            "verseOrgIds": [
              "2KI.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakeenda munzila eyo njiyonya njaakeenda wisi, kukukomba mituni njaakali kukomba wisi akwiikotamina. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.21",
            "verseOrgIds": [
              "2KI.21.21"
            ]
          }
        },
