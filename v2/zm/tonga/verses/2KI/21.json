            }
          ]
        },
        {
          "text": "Lino balanda ba-Amoni bakamuvwiya, bajaya mwami muŋanda yakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.23",
            "verseOrgIds": [
