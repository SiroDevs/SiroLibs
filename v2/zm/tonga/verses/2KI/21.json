            }
          ]
        },
        {
          "text": "Njoosowa bantu bacaabilo cangu bacisyeede akubaaba mumaanza aabasinkondonyina, nkabela bayoosaalwa akunyonyoonwa kulibasinkondonyina boonse. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.14",
            "verseOrgIds": [
