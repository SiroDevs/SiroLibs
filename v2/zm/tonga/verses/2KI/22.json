                  "text": "1 Kor 4:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele mali aanjila mumaanza aabo taelede kubalilizigwa pe, nkaambo balacita cabusyomesi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.7",
            "verseOrgIds": [
              "2KI.22.7"
