                "loc": "JER.36.21"
              },
              "items": [
                {
                  "text": "Jer 36:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi Safani mulembi wakaambila mwami kuti, Hilikiya mupaizi wandipa ibbuku, elyo Safani wakalibala mumatwi aamwami.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.10",
            "verseOrgIds": [
              "2KI.22.10"
            ]
          }
        }
