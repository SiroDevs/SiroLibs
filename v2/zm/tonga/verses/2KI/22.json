            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mwami amvwe buyo majwi aabbuku lya-Mulao, wakazapaula zyakusama zyakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.11",
            "verseOrgIds": [
              "2KI.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela mwami wakalailila Hilikiya mupaizi aAhikamu mwana wa-Safani a-Akiboro mwana wa-Mikaya a-Safani mulembi a-Asaya mulanda wamwami, kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.12",
            "verseOrgIds": [
              "2KI.22.12"
            ]
          }
        },
        {
