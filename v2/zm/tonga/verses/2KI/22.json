        {
          "text": "Koya kuli-Hilikiya mupaizi mupati, kuti abale mali aaletwa muŋanda ya-Jehova, basikulindila mulyango ngebatambula kumaanza aabantu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.4",
            "verseOrgIds": [
              "2KI.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.12.11+2KI.12.12+2KI.12.13+2KI.12.14"
              },
              "items": [
                {
                  "text": "2 Bam 12:11-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Apegwe mumaanza aabasimilimo balanga Iŋanda ya-Jehova, kuti bape basimilimo bali kuŋanda ya-Jehova, bamamike iŋanzi zyaŋanda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.5",
            "verseOrgIds": [
              "2KI.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bape babezi abayaki abasikuzilulula, akuula zisamu amabwe aabezedwe kukumamika iŋanda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.6",
            "verseOrgIds": [
              "2KI.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
