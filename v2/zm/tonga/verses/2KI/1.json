                "loc": "1SA.5.10"
              },
              "items": [
                {
                  "text": "1 Sam 5:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi Ahaziya wakawida ansi kuzwa kumpalangwizyo yaŋanda yakwe yakujulu yaku-Samariya, aboobo wakaciswa. Elyo wakatuma batumwa, wabaambila kuti, Kamuya, mukabuzye kuli-Baala-Zebubi Leza wa-Ekroni, nkazibe na ndapona mubulwazi obu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.2",
            "verseOrgIds": [
              "2KI.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
