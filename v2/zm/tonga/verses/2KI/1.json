              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo batumwa bakapiluka kumwami, Nkabela wakababuzya kuti, Ino mwaboolelanzi? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.5",
            "verseOrgIds": [
              "2KI.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.14.32"
              },
              "items": [
                {
                  "text": "Tus 14:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bakavuwa kuti, Kwakeza muntu kuzootuswana, watwaambila kuti, Kamuya, mupiluke kumwami iwamutuma, mumwaambile kuti, Mbuboobu mbwaamba Jehova. Sa nkaambo kakuti tamukwe Leza mucisi ca-Israyeli ncimutumina kukusonda kuli-Baala-Zebubi Leza wa-Ekroni na? Nkaambo kako tokooyooseluka abulo obo mpotantide pe. Ncobeni uyoofwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.6",
            "verseOrgIds": [
              "2KI.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino wakababuzya kuti, Ino uli buti muntu ngumwa-swanana awe iwamwaambila aya makani? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.7",
            "verseOrgIds": [
              "2KI.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.13.4"
              },
              "items": [
                {
                  "text": "Zek 13:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.3.4"
              },
              "items": [
                {
                  "text": "Mt 3:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bakati, Kasamide masani aaboya, alutambo lwacikanda mucibuno cakwe. Wakati, Nguwe Eliya waku-Tisibe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.8",
            "verseOrgIds": [
              "2KI.1.8"
            ]
