              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.2.10+JER.2.11+JER.2.12+JER.2.13"
              },
              "items": [
                {
                  "text": "Jer 2:10-13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.2.8"
              },
              "items": [
                {
                  "text": "Joh 2:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele angelo wa-Jehova wakaambila Eliya waku-Tisibe kuti, Nyamuka, ukacinge batumwa bamwami wa-Samariya, ukababuzye kuti, Sa nkaambo kakuti taakwe Leza mucisi ca-Israyeli ncimwiinkila kuyoosonda kuli-Baala-Zebubi Leza wa-Ekroni na? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.3",
            "verseOrgIds": [
              "2KI.1.3"
            ]
          }
        },
