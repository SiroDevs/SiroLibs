        },
        {
          "text": "Nkaambo kako mbuboobu mbwaamba Jehova. Tokooyooseluka abulo obo mpotantide pe. Ncobeni uyoofwa, Elyo Eliya wakainka.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.4",
