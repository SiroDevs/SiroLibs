                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "balombe batakwe tumpenda, bali aziwa zibotu, bajisi maanu abusongo boonse, babwene makani aakumvwisya luzibo, beelede kubeleka milimo muŋanda yamwami, akubaiisya malembo amwaambo waba-Kasidi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.4",
            "verseOrgIds": [
              "DAN.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela mwami wakababambila zilyo zyabuzuba abuzuba, caabilo cazilyo zinono nzyaakali kulya mwami acawaini ngwaakali kunywa. Wakalailila kuti balelwe myaka yotatwe; yamana myaka yotatwe, baime kubusyu bwamwami. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.5",
            "verseOrgIds": [
              "DAN.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino akati kabo kakuli bamwi bana ba-Juda, Daniele, Hananiya, Misayeli a-Azariya. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.6",
            "verseOrgIds": [
              "DAN.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.41.45"
              },
              "items": [
                {
                  "text": "Matl 41:45",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.5.12"
              },
              "items": [
                {
                  "text": "Dan 5:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela silutwe wabazibe wakabaulika mazina. Daniele, wakamuulika izina lya-Belitsazara; a-Hananiya, wakamupa izina lya-Sadrake; Misayeli, wakamupa lya-Mesaki; a-Azariya wakamupa lyaAbedinego.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.7",
            "verseOrgIds": [
              "DAN.1.7"
            ]
          }
        }
      ]
