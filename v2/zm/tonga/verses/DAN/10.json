            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.8.18"
              },
              "items": [
                {
                  "text": "Dan 8:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amane kundaambila majwi aali boobo, ndakawida ansi cakuvundama, ndaba syataambi, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.15",
            "verseOrgIds": [
              "DAN.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.6.7"
              },
              "items": [
                {
                  "text": "Is 6:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.1.9"
              },
              "items": [
                {
                  "text": "Jer 1:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino umwi uuli mbuli muntu waansi wakandaampa kumilomo, nkabela mpawo ndakabbanuna mulomo wangu akwaamba. Ndakaambila oyo iwakaimvwi kubusyu bwangu kuti, O mwami wangu, nkaambo kacilengano ndajatwa mause, anguzu zyangu zyandimanina. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.16",
            "verseOrgIds": [
              "DAN.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mebo ndemulanda wamwami wangu nkaambaule buti ayebo mwami wangu? Nkaambo ciindi ecino ndabulilwa inguzu, akuyeeya kwandikacila,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.17",
            "verseOrgIds": [
              "DAN.10.17"
            ]
          }
        }
      ]
    },
    {
