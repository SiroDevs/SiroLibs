                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.14"
              },
              "items": [
                {
                  "text": "Ciy 1:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mubili wakwe kuuli mbuli ibbwe lyaberulo, busyu bwakwe kabuli mbuli lulabo, meso aakwe kaakozyene amalampi aamulilo, maboko aakwe amaulu aakwe kaanyengema mbuli mukuba uusyobwedwe, ajwi lyamwaambo wakwe kalili mbuli ijwi lyamakamu. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.6",
            "verseOrgIds": [
              "DAN.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mebo endike nde-Daniele ndime ndakabona cilengano, nkaambo bantu mbendakali abo teebakabona cilengano pe, bakasikilwa kukankama kupati, bakacija kuyooyuba, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.7",
            "verseOrgIds": [
              "DAN.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.17.1"
              },
              "items": [
                {
                  "text": "Mt 17:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.17.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "aboobo ndakasyaala endike, akubona cilengano eci cipati. Mpawo katakwe inguzu zyakasyaala mulindime abuniini. Busyu bwangu bwakabalangala bwakasanduka cakuyoosya, anguzu zyangu zyakandimanina. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.8",
            "verseOrgIds": [
              "DAN.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "SNG.5.2"
              },
              "items": [
                {
                  "text": "Lwi 5:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo ndakamvwa ijwi lyakwaamba kwakwe. Mvwe buyo ijwi lyakwaamba kwakwe, ndakafwida muŋonzi cakuvundama ansi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.9",
            "verseOrgIds": [
              "DAN.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.9",
            "verseOrgIds": [
              "DAN.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mpawo ijanza lyakandiguma, lyandibusya aamazwi aangu amaanza aangu, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.10",
            "verseOrgIds": [
              "DAN.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo wakandaambila kuti, O Daniele, muntu uuyandwa loko, swiilila majwi ngendi mukukwaambila, Ima kabotu, nkaambo ciindi ecino ndatumwa kulinduwe. Andaambile buyo majwi aya, ndakaima cakukankama, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.11",
            "verseOrgIds": [
              "DAN.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.2.10"
              },
              "items": [
                {
                  "text": "Lk 2:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo wakandaambila kuti, Utayoowi, Daniele, nkaambo kuzwa kubuzuba butaanzi, nowakabika moyo wako kukumvwisya makani, akulibombya kubusyu bwa-Leza wako, majwi aako akali kumvwigwa. Lino ndasika nkaambo kamajwi aako. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.12",
            "verseOrgIds": [
              "DAN.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.12.1"
              },
              "items": [
                {
                  "text": "Dan 12:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JUD.1.9"
              },
              "items": [
                {
                  "text": "Jud 1:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.12.7"
              },
              "items": [
                {
                  "text": "Ciy 12:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwami wacisi ca-Persia wakasi yande kundikasya mazuba aali makumi obile abuzuba bomwe, pele Mikayeli umwi wabasilutwe bapati wakeza kuzoondigwasya, aboobo ndakamusiya nkukonya oko abami ba-Persia. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.13",
            "verseOrgIds": [
              "DAN.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndeza kukuzibya makani aayoocitwa kubantu bako kumazuba aakumamanino. Nkaambo cilengano ncamazuba aacili kule.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.14",
            "verseOrgIds": [
              "DAN.10.14"
            ]
          }
        }
      ]
    },
    {
