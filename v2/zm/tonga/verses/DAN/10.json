        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwaka watatu wabwami bwa-Koresi mwami wa-Persia, makani akayubunwidwa Daniele, ngonguwe iwakapegwa izina lya-Belitsazara Ayo makani akali aakusinizya, makani aankondo impati, alimwi wakaswiilila makani akumvwisya cilengano.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.1",
            "verseOrgIds": [
              "DAN.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.1",
            "verseOrgIds": [
              "DAN.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumazuba ayo mebo nde-Daniele ndakali kulila insondo zyotatwe zizwide. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.2",
            "verseOrgIds": [
              "DAN.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Teendakali kulya zilyo zinono pe, Katakwe nyama naba waini iwakanjila mukanwa lyangu, alimwi nsikwe nendakalinanika, mane insondo zyotatwe zyakamaninina. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.3",
            "verseOrgIds": [
              "DAN.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mubuzuba bwamakumi obile aane bwamwezi mutaanzi nendakaimvwi ankomwe yamulonga mupati, nkokuti Hidekeli, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.4",
            "verseOrgIds": [
              "DAN.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.13+REV.1.14+REV.1.15"
              },
              "items": [
                {
                  "text": "Ciy 1:13-15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.2.18"
              },
              "items": [
                {
                  "text": "2:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.19.12"
              },
              "items": [
                {
                  "text": "19:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ndakatambya meso aangu, nkabela ndakabona umwi muntu uusamine masani aatuba, uuangide kucibunu lukumba lwangolida ya-Ufazi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.5",
            "verseOrgIds": [
              "DAN.10.5"
            ]
          }
        }
      ]
    },
    {
