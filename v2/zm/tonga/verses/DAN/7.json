          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "amakani aameja aali ikumi aakali amutwe wakwe aluja lumwi ilwakamena, ameja otatwe aakawa kunembo lyalo, luja ilwakajisi meso amulomo wakwaambya zintu ziyoosya, aciwa cibi cipati kwiinda ziwa zyabeenzinyina, ",
          "type": "text",
          "attrs": {
