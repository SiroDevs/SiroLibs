            }
          ]
        },
        {
          "text": "Uyooamba majwi aakusampaula Sijulu, abalo basalali ba-Sijulu uyoobafwabya. Uyooyeeya kusandula ziindi amilao, Nkabela bayooabwa mumaanza aakwe mwaka amyaka yobile acisela camwaka. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.25",
            "verseOrgIds": [
              "DAN.7.25"
            ]
          }
        },
