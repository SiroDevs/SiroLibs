                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.20.12"
              },
              "items": [
                {
                  "text": "20:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Oko nkwaakabede kwakazwa mulonga wamulilo. Basimilimo bakwe bakali cuulu cazyuulu, abaabo ibakaimvwi kubusyu bwakwe bakali zyuulu zili ikumi zyazyuulu zili ikumi. Lino basinkuta bakakala, amabuku akajalulwa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.10",
            "verseOrgIds": [
              "DAN.7.10"
            ]
          }
        }
      ]
    },
