              },
              "items": [
                {
                  "text": "Dan 2:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwaka mutaanzi wabwami bwa-Belisazara mwami wa-Babuloni, Daniele wakalota ciloto akubona zilengano mumoyo wakwe naakelede abulo bwakwe. Mpawo wakalemba ciloto akwaamba mitwe yamakani. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.1",
            "verseOrgIds": [
              "DAN.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daniele wakati, Ndakabona cilengano cangu ciindi camasiku. Ndakabona myuuwo yone yakujulu ilakopenganya maanzi aamulwizi lupati. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.2",
            "verseOrgIds": [
              "DAN.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.6.1+ZEC.6.2+ZEC.6.3+ZEC.6.4"
              },
              "items": [
                {
                  "text": "Zek 6:1-4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.1"
              },
              "items": [
                {
                  "text": "Ciy 13:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.17.8"
              },
              "items": [
                {
                  "text": "17:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo mulwizi mwakazwa banyama bapati bone. Boonse bone kabali amisyobo misyobo. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.3",
            "verseOrgIds": [
              "DAN.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.49"
              },
              "items": [
                {
                  "text": "Dt 28:49",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.4.7"
              },
              "items": [
                {
                  "text": "Jer 4:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.4.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.2"
              },
              "items": [
                {
                  "text": "Ciy 13:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mutaanzi kali mbuli mulavu, alimwi kajisi mababa aasikwaze. Lino nendakacili kweebela, mababa aakwe akamonsoka, alimwi wakasumpulwa kuzwa ansi akwiimikwa azituta zyakwe zyobile mbuli muntu, alimwi wakapegwa moyo wabuntu, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.4",
            "verseOrgIds": [
              "DAN.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.2.39"
              },
              "items": [
                {
                  "text": "Dan 2:39",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino kwakaboneka munyama aumwi wabili, kali mbuli masekese, kanyampwide cituta kulubazu lomwe, alimwi kalumide mampango otatwe mukanwa lyakwe, Lino wakaambilwa kuti, Buka, ulye nyama nyingi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.5",
            "verseOrgIds": [
              "DAN.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.8.8"
              },
              "items": [
                {
                  "text": "Dan 8:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.8.22"
              },
              "items": [
                {
                  "text": "22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino ndaka langa alimwi, ndabona aumwi munyama uuli mbuli siluwe, kajisi mababa one aamuyuni andelo zyakwe. Oyu munyama kajisi mitwe yone, nkabela wakapegwa bwami. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.6",
            "verseOrgIds": [
              "DAN.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.12.3"
              },
              "items": [
                {
                  "text": "Ciy 12:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.1"
              },
              "items": [
                {
                  "text": "13:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino kusule lyayaaya ndakacili kubona muzilengano zyamasiku, nkabela ndakabona munyama aumwi wane, munyama uuyoosya uugambya, uujisi inguzu loko. Kajisi meno mapati aalubulo, nkabela wakali kulya akutyolaula, aceeco icakasyeede wakacilyataula ansumba zyakwe, Kaandeene abanyama boonse ibakamutaangunina, alimwi kajisi meja aali ikumi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.7",
            "verseOrgIds": [
              "DAN.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.8.9"
              },
              "items": [
                {
                  "text": "Dan 8:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.5+REV.13.6"
              },
              "items": [
                {
                  "text": "Ciy 13:5-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino nendakacili kweebela meja, ndakabona kuti kwakamena keja akamwi akati kao. Lino kunembo lyakaako meja mataanzi otatwe akanonkolwa, Alimwi mukeja ako mwakali meso mbuli meso aamuntu amulomo uuamba makani aayoosya.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.8",
            "verseOrgIds": [
              "DAN.7.8"
            ]
          }
        }
      ]
    },
