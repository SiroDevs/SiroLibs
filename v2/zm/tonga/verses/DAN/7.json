              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.14"
              },
              "items": [
                {
                  "text": "1:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino nendakacili kweebela, ndakabona zyuuno zibikidwe, nkabela kwakakede umwi sinsiku. Zyakusama zyakwe zyakali kutuba buu mbuli nyengenge, amasusu aakumutwe wakwe akali mbuli boya bwambelele bubotu. Cuuno cakwe cakali mabangabanga aamulilo, amavili aaco akali mulilo uuyakisya. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.9",
            "verseOrgIds": [
              "DAN.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 7:10"
          },
          "items": [
