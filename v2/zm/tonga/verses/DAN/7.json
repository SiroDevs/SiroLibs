                "loc": "REV.19.20"
              },
              "items": [
                {
                  "text": "Ciy 19:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo ndakalanga nkaambo kamajwi aayoosya keja ngekakali kwaamba. Nkabela nindakacili kulanga, munyama wakajayigwa, amutunta wakwe wakanyonyoonwa, wawaalwa mumulilo kuti utentwe, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.11",
            "verseOrgIds": [
              "DAN.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanyama bamwi, bakanyanzigwa bwami bwabo, pele kupona bakazumizigwa kucipona mane kusikila kuciindi ceelede.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.12",
            "verseOrgIds": [
              "DAN.7.12"
            ]
          }
        }
      ]
    },
    {
