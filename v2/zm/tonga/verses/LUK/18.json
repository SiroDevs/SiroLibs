              "attrs": {
                "loc": "MAT.19.13+MAT.19.14+MAT.19.15"
              },
              "items": [
                {
                  "text": "Mt 19:13-15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.10.13+MRK.10.14+MRK.10.15+MRK.10.16"
              },
              "items": [
                {
                  "text": "Mk 10:13-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo bakamuletela bana kuti abajate, pele basikwiiya bakwe nobakababona bakabakasya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.15",
            "verseOrgIds": [
              "LUK.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walo Jesu wakabaita kulinguwe wakati, Amuzumizye bana kuti baboole kulindime, mutabakasyi, nkaambo Bwami bwa-Leza mbubwabo abali bobuya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.16",
            "verseOrgIds": [
              "LUK.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.18.3"
              },
              "items": [
                {
                  "text": "Mt 18:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ncobeni ndamwaambila kuti, Uutatambuli bwami bwa-Leza mbuli mwana, takooyoobunjila akaniini pe,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.17",
            "verseOrgIds": [
              "LUK.18.17"
            ]
          }
        }
      ]
    },
