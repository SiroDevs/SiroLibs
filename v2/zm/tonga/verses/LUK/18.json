              },
              "items": [
                {
                  "text": "1 Tes 5:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo wakabaambila cikozyano cakuti baleelede kukomba lyoonse, batalengaali. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.1",
            "verseOrgIds": [
              "LUK.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakateeti, Kumunzi umwi kwakali mubetesi uwata­ kali kuyoowa Leza, nokuba kulemya bantu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.2",
            "verseOrgIds": [
              "LUK.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi kwakali mukamufu kumunzi oyo, walo wakaboola kulinguwe kanjikanji wakati, Ndikosweda mulandu kuluundisesa, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.3",
            "verseOrgIds": [
              "LUK.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno wakakaka kaindi, pele munsi wakalyaambya mucamba cakwe kuti, Nentayoowi Leza, nentalemeki muntu, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.4",
            "verseOrgIds": [
              "LUK.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.11.7"
              },
              "items": [
                {
                  "text": "Lk 11:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.11.8"
              },
              "items": [
                {
                  "text": "8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nokubaboobo mukamufu oyo mbwaandikataazya ndamukosweda; na pe, unoondi-kataazya kwiindilila kukusika kwakwe lyoonse. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.5",
            "verseOrgIds": [
              "LUK.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpoonya Mwami wakateeti, Amumvwe oku nkwaamba mubetesi uutaluleme, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.6",
            "verseOrgIds": [
              "LUK.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sena Leza takooyoobakosweda abo mbasalide, aboompolola kulinguwe isikati amasiku, anatola ciindi kulimbabo? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.7",
            "verseOrgIds": [
              "LUK.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndamwaambila kuti uyoofwamba kubakosweda, Kwalo Mwana a-Muntu aakuboola, sena uzoojana lusyomo ansi?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.8",
            "verseOrgIds": [
              "LUK.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.8",
            "verseOrgIds": [
              "LUK.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ecalo cikozyano eci wakabaambila abalisyoma kululama, abasampaula bamwi boonse, wakati, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.9",
            "verseOrgIds": [
              "LUK.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baalumi bobile bakanjila muntempele kuti bakombe, umwi wakali mu-Farisi, umwi wakali simutelo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.10",
            "verseOrgIds": [
              "LUK.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.58.2"
              },
              "items": [
                {
                  "text": "Is 58:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.58.3"
              },
              "items": [
                {
                  "text": "3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.16.15"
              },
              "items": [
                {
                  "text": "Lk 16:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mu-Farisi oyo wakaimikila, wakakomba obo wakati, Ndakulumba, O Leza, nkaambo nsili mbuli bantu bamwi, ababbi abataluleme abasimamambe, ambuli simutelo oyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.11",
            "verseOrgIds": [
              "LUK.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.23.23"
              },
              "items": [
                {
                  "text": "Mt 23:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndilaliimya kulya tobile munsondo yomwe, alimwi ndilapa cimanyakumi kulizyoonse nzyenjisi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.12",
            "verseOrgIds": [
              "LUK.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.51.1"
              },
              "items": [
                {
                  "text": "Int 51:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele simutelo oyo wakaima kulekule, takali kulanga kujulu, pele wakalyuumauma acamba cakwe wati, Leza, ndifwida luzyalo, ndi mucitazibi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.13",
            "verseOrgIds": [
              "LUK.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.23.12"
              },
              "items": [
                {
                  "text": "Mt 23:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.14.11"
              },
              "items": [
                {
                  "text": "Lk 14:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.21.31"
              },
              "items": [
                {
                  "text": "Ezk 21:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndamwaambila kuti, Oyu wakabweeda kuŋanda yakwe ulilulamikidwe kwiinda oyo umwi, nkaambo umwi umwi uulisumpula ulafwiinsigwa, uulifwiinsya ulasumpulwa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.14",
            "verseOrgIds": [
              "LUK.18.14"
            ]
          }
        }
      ]
    },
    {
