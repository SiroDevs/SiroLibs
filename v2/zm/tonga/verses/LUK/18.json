                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela wakabatola kumbali abali kumi abobile, wabaambila kuti, Amubone, tuya ku-Jerusalemu, eno makani oonse aakalembwa basinsimi ayoocitwa ku-Mwana a-Muntu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.31",
            "verseOrgIds": [
              "LUK.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo uyooabwa kulibamasi, akusabwidwa, akucitwa bubi, akuswidwa mate, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.32",
            "verseOrgIds": [
              "LUK.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "bayoomuuma akumujaya, kwala mubuzuba bwatatu uyoobuka. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.33",
            "verseOrgIds": [
              "LUK.18.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.9.32"
              },
              "items": [
                {
                  "text": "Mk 9:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eno taakwe ncobakamvwa, makani aya akasiswa kulimbabo, tabakali kuzi ncaakali kwaamba,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.34",
            "verseOrgIds": [
              "LUK.18.34"
            ]
          }
        }
      ]
    },
