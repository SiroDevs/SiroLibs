            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.18.36"
              },
              "items": [
                {
                  "text": "Joh 18:36",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.3"
              },
              "items": [
                {
                  "text": "3:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo ba-Farisi nobakamubuzya kuti, Bwami bwa-Leza buzoosika lili? wakabavuwa wati, Ukusika kwa-Bwami bwa-Leza takubonwa. ",
          "type": "text",
