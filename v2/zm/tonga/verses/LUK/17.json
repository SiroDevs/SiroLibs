              "LUK.17.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.9.51"
              },
              "items": [
                {
                  "text": "Lk 9:51",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.13.22"
              },
              "items": [
                {
                  "text": "13:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mulweendo lwakwe kuya ku-Jerusalemu, wakainda akati ka-Samariya a-Galilaya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.11",
            "verseOrgIds": [
              "LUK.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.13.45"
              },
              "items": [
                {
                  "text": "Lev 13:45",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.13.46"
              },
              "items": [
                {
                  "text": "46",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naakanjila mumunzi umwi, kwakamucinga baalumi abali kumi basicinsenda. Bakaima kulaale, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.12",
            "verseOrgIds": [
              "LUK.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "boompolola bati, O mwami Jesu, tufwide luzyalo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.13",
            "verseOrgIds": [
              "LUK.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.13.49"
              },
              "items": [
                {
                  "text": "Lev 13:49",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.14.1+LEV.14.2+LEV.14.3+LEV.14.4+LEV.14.5+LEV.14.6+LEV.14.7+LEV.14.8+LEV.14.9+LEV.14.10+LEV.14.11+LEV.14.12+LEV.14.13+LEV.14.14+LEV.14.15+LEV.14.16+LEV.14.17+LEV.14.18+LEV.14.19+LEV.14.20+LEV.14.21+LEV.14.22+LEV.14.23+LEV.14.24+LEV.14.25+LEV.14.26+LEV.14.27+LEV.14.28+LEV.14.29+LEV.14.30+LEV.14.31+LEV.14.32"
              },
              "items": [
                {
                  "text": "14:1-32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.5.14"
              },
              "items": [
                {
                  "text": "Lk 5:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naakababona wakabaambila kuti, Kamuya mukalitondezye kubapaizi, Nobakali kuya bweenda bakasalazigwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.14",
            "verseOrgIds": [
              "LUK.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela umwi wabo naakabona kuti wapona, wakapiluka walumbaizya Leza ejwi ipati, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.15",
            "verseOrgIds": [
              "LUK.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "wavundama kumatende aa-Jesu, wamulumba. Walo wakali muSamariya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.16",
            "verseOrgIds": [
              "LUK.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu wakavuwa kuti, Sena tabasalede abali kumi? Ino bali kuli abali musanu mubane? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.17",
            "verseOrgIds": [
              "LUK.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sena taakwe uwaboola kulumbaizya Leza, pele oyu uwamasi? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.18",
            "verseOrgIds": [
              "LUK.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.7.50"
              },
              "items": [
                {
                  "text": "Lk 7:50",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakamwaambila kuti, Buka uende, lusyomo lwako lwakufutula.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.19",
            "verseOrgIds": [
              "LUK.17.19"
            ]
          }
        }
      ]
    },
