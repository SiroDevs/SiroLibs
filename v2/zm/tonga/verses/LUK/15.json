        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.5.29+LUK.5.30"
              },
              "items": [
                {
                  "text": "Lk 5:29-30",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno basimutelo abacitazibi boonse bakaswena afwaafwi kulinguwe kumuswiilila. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.1",
            "verseOrgIds": [
              "LUK.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.5.30"
              },
              "items": [
                {
                  "text": "Lk 5:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela aba-Farisi abalembi bakatongauka bati, Oyu muntu utambula bacitazibi, ulalya abalo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.2",
            "verseOrgIds": [
              "LUK.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.2",
            "verseOrgIds": [
              "LUK.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo wakabaambila cikozyano eci cakuti, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.3",
            "verseOrgIds": [
              "LUK.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.18.12+MAT.18.13+MAT.18.14"
              },
              "items": [
                {
                  "text": "Mt 18:12-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.34.11"
              },
              "items": [
                {
                  "text": "Ezk 34:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.34.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.19.10"
              },
              "items": [
                {
                  "text": "Lk 19:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ino nguuli muntu akati kanu uujisi mbelele izili mwaanda, nkabela kusweeke yomwe kulinzizyo, sena inga takoozisia musokwe izili makumi aali musanu mwaane amusanu muzine, ainke kuyoolangaula iyakasweeka mane akiibone? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.4",
            "verseOrgIds": [
              "LUK.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aakwiibona, uliibika aziwezo zyakwe akubotelwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.5",
            "verseOrgIds": [
              "LUK.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asika kumunzi ulaita beenzinyina ambobayakide abo, ateeti kulimbabo, Amubotelwe amebo nkaambo ndiibona mbelele yangu iyali kusweekede. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.6",
            "verseOrgIds": [
              "LUK.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndamwaambila kuti, Mbubonya obo akujulu kunooli kubotelwa nkaambo kaumwi mucitazibi uwasanduka, kwiinda baluleme abali makumi aali musanu mwaane amusanu mubane abatabuli kusanduka.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.7",
            "verseOrgIds": [
              "LUK.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.7",
            "verseOrgIds": [
              "LUK.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukaintu nguuli uujisi masheleni aali kumi, asweekelwa lyomwe, sena takootomeka lambe, akukulisye moonse muŋanda, akalangaulisye, mane alibone? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.8",
            "verseOrgIds": [
              "LUK.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alibona ulaita beenzinyina ambobayakide abo ateeti, Kamubotelwa amebo nkaambo ndaliiana isheleni lyangu ilyali kusweekede, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.9",
            "verseOrgIds": [
              "LUK.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.3.10"
              },
              "items": [
                {
                  "text": "Ef 3:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbubonya obo ndamwaambila kuti nkokuli kubotelwa kubaangelo ba-Leza nkaambo kaumwi mucitazibi uwasanduka.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.10",
            "verseOrgIds": [
              "LUK.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.10",
            "verseOrgIds": [
              "LUK.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi wakaamba kuti, Muntu umwi wakali kujisi bana bobile balombe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.11",
            "verseOrgIds": [
              "LUK.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuniini wakaambila wisi kuti, Taata, ndipa caabilo calubono iceelede ndime. Nkabela wakabaabanya lubono lwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.12",
            "verseOrgIds": [
              "LUK.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.29.3"
              },
              "items": [
                {
                  "text": "Tus 29:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naakamana mazuba mace buyo, oyo muniini wakabungika zyakwe zyoonse, wainka kucisi icili kule, oko wakaakusowaila lubono lwakwe kubutaka, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.13",
            "verseOrgIds": [
              "LUK.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naakamana kulusowa loonse, kwakaba nzala mpati mucisi eco, walo wakatalika kupenga. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.14",
            "verseOrgIds": [
              "LUK.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela wakainka walinjizya kumuntu wamucisi eco, oyo wakamutuma mumakula aakwe kuti aembele ngulube. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.15",
            "verseOrgIds": [
              "LUK.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.23.31"
              },
              "items": [
                {
                  "text": "Tus 23:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakali kuyanda kukusya ida lyakwe amakweleele aalya ngulube, kwalo taakwe muntu uwakamupa, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.16",
            "verseOrgIds": [
              "LUK.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele naakayeeya wakati, Taata ulijisi bazike banjibanji abakuta nsima mane baliileka, pele mebo kuno ndafwa nzala. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.17",
            "verseOrgIds": [
              "LUK.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.3.12"
              },
              "items": [
                {
                  "text": "Jer 3:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.3.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.51.4"
              },
              "items": [
                {
                  "text": "Int 51:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nandoobuka, ndiinke kulitaata, ndikamwaambile kuti, Taata, ndabisizya ijulu ayebo, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.18",
            "verseOrgIds": [
              "LUK.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nsiceelede kutegwa mwanaako, undicite mbuli umwi wabazike bako, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.19",
            "verseOrgIds": [
              "LUK.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndilyonya wakanyamuka wainka kuliwisi, kwalo naakacili kulekule wisi wakamubona, wamufwida luzyalo, watijaana, wawida kunsingo yakwe, wamumyontesya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.20",
            "verseOrgIds": [
              "LUK.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpoonya mwana wakamwaambila kuti, Taata, ndabisizya ijulu ayebo, nsiceelede kutegwa mwanaako. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.21",
            "verseOrgIds": [
              "LUK.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele wisi wakaambila bazike bakwe kuti, Kamuleta cisamo cibotu, mumusamike, mumubike nweenwe kujanza lyakwe, mumusamike endyasyo kumatende aakwe, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.22",
            "verseOrgIds": [
              "LUK.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "alimwi mulete moombe uuneneede, mumujaye, tulye tusekelele. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.23",
            "verseOrgIds": [
              "LUK.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
