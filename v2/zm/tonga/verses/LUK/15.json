                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.14"
              },
              "items": [
                {
                  "text": "5:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo oyu mwanaangu wakali mufu, sunu wapona, wakalisweekede, sunu wabonwa. Ndilyonya bakatalika kusekelela. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.24",
            "verseOrgIds": [
              "LUK.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno mwanaakwe mupati wakali mumuunda, Naakasika afwaafwi aŋanda, wakamvwa kwiimba akuzyana. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.25",
            "verseOrgIds": [
              "LUK.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakaita muzike umwi, wamubuzya kuti, Ino ninzi eco? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.26",
            "verseOrgIds": [
              "LUK.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakamuvuwa kuti, Mwanaakwanu wasika, uso wajaya moombe uuneneede, mbwaamubona ucipona, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.27",
            "verseOrgIds": [
              "LUK.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.15.2"
              },
              "items": [
                {
                  "text": "Lk 15:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele wakanyema, wakaka kunjila, elyo wisi wakazwa wamukombelezya, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.28",
            "verseOrgIds": [
              "LUK.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwalo mwana wakavuwa, waambila wisi kuti, Bona, imyaaka yavula njendakubelekela, nsinasotokede nuuba omwe mulao wako, nekubaboobo tonandipede nekaba kapongo kuti tusekelele abeenzuma. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.29",
            "verseOrgIds": [
              "LUK.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele oyu mwanaako uwakamwaya lubono lwako antoomwe abasibaalumi, mbwaasika buyo wamujayila moombe uuneneede, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.30",
            "verseOrgIds": [
              "LUK.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.17.10"
              },
              "items": [
                {
                  "text": "Joh 17:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakati kulinguwe Mwanaangu, tuli ayebo ciindi coonse, zyoonse zyangu nzizyako. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.31",
            "verseOrgIds": [
              "LUK.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twaleelede kusekelela akubotelwa, nkaambo oyu mwanikaako wakalifwide, sunu wapona, wakalisweekede, sunu wabonwa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.32",
            "verseOrgIds": [
              "LUK.15.32"
            ]
          }
        }
      ]
    }
