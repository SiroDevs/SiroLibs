          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi wakatalika kulungulula, wati,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.23",
            "verseOrgIds": [
              "NUM.24.23"
            ]
