              "NUM.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo Balamu wakanyamuka, watola lweendo lwakwe, wapiluka kulinguwe. Alakwe Balaki wakainka.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.25",
