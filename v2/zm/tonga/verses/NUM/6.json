              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazuba oonse aabu-Naziri bwakwe ulasalalila Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.8",
