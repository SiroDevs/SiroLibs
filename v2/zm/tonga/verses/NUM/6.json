              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazuba oonse aabu-Naziri bwakwe teelede kulya cintu niciba comwe cizwa kumusaansa, niziba ŋoogo niciba cikanda.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.4",
            "verseOrgIds": [
              "NUM.6.4"
            ]
          }
