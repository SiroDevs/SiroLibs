                  "text": "My 9:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na wafwidwa wisi na banyina, munyina na mucizi wakwe, teelede kulisofwaazya cakulila mbabo, pe, nkaambo cikonke cakulisalazizya Leza wakwe mpocili alinguwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.7",
            "verseOrgIds": [
