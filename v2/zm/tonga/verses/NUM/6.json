                  "text": "Lk 1:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "uleelede kuliimya waini azyakunywa zyoonse zikola, Teelede kunywa cilula cawaini na cazyakunywa zimwi zikola, teelede kunywa musinza wamasaansa abuniini, alimwi teelede kulya masaansa naaba matete naaba aayanikidwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.3",
            "verseOrgIds": [
              "NUM.6.3"
            ]
          }
        },
        {
