        },
        {
          "text": "Na muntu waanzamuka kukufwa kumbali lyakwe, aboobo ulasofwaazya mutwe wabu-Naziri bwakwe, uleelede kunyoola mutwe wakwe mubuzuba bwakulisalazya; anyoole mubuzuba bwamusanu aabili. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.9",
            "verseOrgIds": [
              "NUM.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
