                  "text": "Inc 7:44",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Aroni wakatuula misako kubusyu bwa-Jehova mutente lyambunganino.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.7",
            "verseOrgIds": [
              "NUM.17.7"
