                  "text": "My 31:19-26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Jehova wakaambila Musa kuti, Pilusya musako wa-Aroni kunembo lyabbokesi lyamulao, ube citondezyo kumeso aabasikupapila­, ubalesye kunditongauka, kuti batafwi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.10",
            "verseOrgIds": [
              "NUM.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Musa wakacita obo, Wakacita mbubonya mbuli Jehova mbwaakamulailila.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.11",
            "verseOrgIds": [
              "NUM.17.11"
            ]
          }
        }
