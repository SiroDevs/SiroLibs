            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.31.19+NUM.31.20+NUM.31.21+NUM.31.22+NUM.31.23+NUM.31.24+NUM.31.25+NUM.31.26"
              },
              "items": [
