              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.16.5"
              },
              "items": [
                {
                  "text": "My 16:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela oyo muntu ngonsala, musako wakwe ulasyuuka, aboobo njoolesya kutongauka kwabana ba-Israyeli nkobanditongauka. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.5",
            "verseOrgIds": [
              "NUM.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpoonya Musa wakaambila bana baIsrayeli, nkabela basilutwe boonse bakamupa misako, musako omwe kulisilutwe wamusyobo umwi aumwi, nkokuti misako iili ikumi aibili; awalo musako wa-Aroni wakali akati kamisako yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.6",
            "verseOrgIds": [
              "NUM.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
