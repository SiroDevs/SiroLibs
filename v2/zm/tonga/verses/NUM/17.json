                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino nibwakaca, Musa naakanjila mutente lyacizuminano, wakajana kuti musako wa-Aroni mu-Levi wasyuuka, waba ampumpu, wafulula maluba, wazyala maalmondi aabizwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.8",
            "verseOrgIds": [
              "NUM.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo Musa wakagwisya misako yoonse, waileta kubantu ba-Israyeli, nkabela bakalanga akulibwezela umwi aumwi musako wakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.9",
            "verseOrgIds": [
              "NUM.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
