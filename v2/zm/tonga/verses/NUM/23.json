              },
              "items": [
                {
                  "text": "2 Pet 2:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Balamu wakaambila Balaki kuti, Undiyakile zipaililo zili musanu azibili mpoonya ano, alimwi undibambile basune bali musanu ababili abagutu bali musanu ababili. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.29",
            "verseOrgIds": [
              "NUM.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Balaki wakacita mbubonya mbuli Balamu mbwaakaamba, akupaizya musune amugutu acipaililo cimwi acimwi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.30",
