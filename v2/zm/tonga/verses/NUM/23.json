                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo wakatalika kulungulula. Wakati,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.7",
            "verseOrgIds": [
              "NUM.23.7"
