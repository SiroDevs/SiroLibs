              },
              "items": [
                {
                  "text": "Bab 3:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo wakatalika kulungulula, wati,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.18",
            "verseOrgIds": [
              "NUM.23.18"
            ]
          }
        }
      ]
