                  "text": "Neh 13:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Balaki wakaambila Balamu kuti, Ma! Wandicitilanzi? Ndakakwiita kuti utukile basinkondoma pele ncobeni wabalongezya buyo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.11",
            "verseOrgIds": [
              "NUM.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakavuwa kuti, Kufumbwa cintu Jehova ncabika mumulomo wangu, sa teensi ncico ncenjeelede kwaamba?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.12",
            "verseOrgIds": [
              "NUM.23.12"
            ]
          }
        }
      ]
