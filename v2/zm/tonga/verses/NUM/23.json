          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Balaki wakamwaambila kuti, Katuya ayebo kubusena bumbi, nkokonzya kubabona. Ula bona magolelo buyo aabantu, tokoobona boonse pe. Lino nditukilile bantu nkukonya oko. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.13",
            "verseOrgIds": [
              "NUM.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
