              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaabo babambana awe babe musyobo wa-Simeoni. Silutwe wabana ba-Simeoni abe Selumiyeli mwana wa-Zurisadai. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.12",
            "verseOrgIds": [
