        {
          "text": "Abo bayaka kujwe kubuzwezuba babe bandembela yalabba lya-Juda munkamu zyabo, Silutwe wabana ba-Juda abe Nasoni mwana wa-Aminadabu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.3",
            "verseOrgIds": [
              "NUM.2.3"
            ]
          }
