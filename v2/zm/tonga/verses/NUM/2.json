              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awalo musyobo wa-Gadi. Silutwe wabana ba-Gadi abe Eliyasafe mwana wa-Reueli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.14",
            "verseOrgIds": [
