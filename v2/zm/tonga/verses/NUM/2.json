              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu bankamu yakwe ibakabalwa bakali zyuulu zili makumi aali musanu aabili azine amyanda iili musanu aumwi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.4",
            "verseOrgIds": [
              "NUM.2.4"
