              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu bankamu yakwe ibakabalwa bakali zyuulu zili makumi one amusanu acimwi amyanda yosanwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.11",
