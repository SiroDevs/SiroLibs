              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu bankamu yakwe ibakabalwa bakali zyuulu zili makumi osanwe amusanu azine amyanda yotatwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.13",
            "verseOrgIds": [
              "NUM.2.13"
