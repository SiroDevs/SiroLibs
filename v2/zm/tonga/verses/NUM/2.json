              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu bankamu yakwe ibakabalwa bakali zyuulu zili makumi osanwe amusanu azibili amyanda yone. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.8",
