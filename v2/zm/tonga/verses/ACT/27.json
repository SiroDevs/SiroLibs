  "reference": "Incito 27",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 44,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
        "style": "c",
        "sid": "ACT 27"
      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokwakakanzwa kuti tuye ku-Italiya abwaato, bakaaba Paulo abamwi baange kumusunguli uutegwa Juliyo, wankamu ya-Agusto, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.1",
            "verseOrgIds": [
              "ACT.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twa­ kanjila mubwaato bwaku-Andramutiyo ubwati kainke kuminzi yakunkomwe ya-Asiya, twakainka a-Aristarko waku-Tesalonika, munzi wamu-Makedoniya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.2",
            "verseOrgIds": [
              "ACT.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nobwakaca twakasika ku-Sidoni. Juliyo wakamubamba kabotu Paulo, wamuzumizya kuswaya beenzinyina kuti akatalukwe, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.3",
            "verseOrgIds": [
              "ACT.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Notwakazwa oko, twakeenda akusitililwa cilwa ca-Kupro, nkaambo iguwo lyakatucinjila. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.4",
            "verseOrgIds": [
              "ACT.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Notwakazubuka lwizi ulubambene a-Kilikiya a-Pamfiliya, twakasika kuMura, munzi wamu-Lukiya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.5",
            "verseOrgIds": [
              "ACT.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oko musunguli wakajana bwaato bwakuAlesandriya ubuya ku-Italiya, nkabela watunjizya mumo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.6",
            "verseOrgIds": [
              "ACT.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo notwakeenda kaniini-niini mazuba manjimanji cakusungwaala twakasika kumbali a-Kando, nkaambo keguwo ilyakatucinjila twakeenda cakusitililwa cilwa ca-Krete kumbali a-Salmone, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.7",
            "verseOrgIds": [
              "ACT.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Notwakainda mumbali lyenkomwe cakulikakatizya, twakasika kubusena ubutegwa Ikoba Bbotu, afwaafwi amunzi wa-Laseya.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.8",
            "verseOrgIds": [
              "ACT.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.8",
            "verseOrgIds": [
              "ACT.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokwakainda ciindi cilamfu, alimwi mbokwakaba mapenzi kuceenda abwaato, kuliimya zilyo kwaba-Juda kakumanide kale, Paulo wakabalaya, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.9",
            "verseOrgIds": [
              "ACT.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "wabaambila kuti, Nobaalumi, ndabona kuti olu lweendo lulaba akusweekelwa akumwaigwa kupati, nsyaambi kwalubono buyo abwaato, pele akwabuumi bwesu, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.10",
            "verseOrgIds": [
              "ACT.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwalo musunguli wakamvwa kwaamba kwasikweenzya bwaato akwamukamwini wabo kwiinda ezyo izyakaambwa Paulo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.11",
            "verseOrgIds": [
              "ACT.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno ikoba mbolyatakali bbotu kukala mumo mapeyo, banjibanji bakati kuleelede kuti tubweze, tusoleke na tulakonzya kusika ku-Fonika akukala nkuko mapeyo, elyo ndikoba lya-Krete, lilanga kujwe kubbazu lyakunyika alyakumabizi, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.12",
            "verseOrgIds": [
              "ACT.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokwaunga muuwo wakumusanza, bakayeeya anga bakujana nkobayanda, bakabweza, bainda mumbali lyenkomwe ya-Krete. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.13",
            "verseOrgIds": [
              "ACT.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele munsi lyakaindi, kucilwa kwakazwa iguwo pati ilitegwa Urokulo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.14",
            "verseOrgIds": [
              "ACT.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno bwaato nobwakajatwa akukakilwa kulangana amuuwo twakabuleka twapepaulwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.15",
            "verseOrgIds": [
              "ACT.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Notwakayaama kukalwa akategwa Kauda, twakakonzya, kukucita enguzu, kujata kaato. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.16",
            "verseOrgIds": [
              "ACT.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nobakakanantula, bakainzya zyaanzyo kunsi lyabwaato, babwaanga, nkabela mbobakayoowa kuti antela balabbila mubulobe bakaselusya sila ilyeenzya bwaato bapepulwa buyo obo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.17",
            "verseOrgIds": [
              "ACT.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbotwakali kuya buzuwaikwa enguzu, nobwakaca bakatalika kusowaila lubono mulwizi, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.18",
            "verseOrgIds": [
              "ACT.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubuzuba bwatatu bakasowaila zintu zyabwaato kumaanza aabo beni. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.19",
            "verseOrgIds": [
              "ACT.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbolyatakali kubonwa zuba enyenyeezi mazuba manjimanji, pele iguwo pati lyakali kutusinkilide, limwi twakaleka kusyoma kuti tulafutulwa, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.20",
            "verseOrgIds": [
              "ACT.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo nocakalampa ciindi cakutalya, Paulo wakaima akati kabo wakati, Nobaalumi, mwali kweelede kundiswiilila mebo, akutazwa mu-Krete, mapenzi­ aya aakusweekelwa oku nokwatabawo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.21",
            "verseOrgIds": [
              "ACT.27.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno ndamukombelela kuti mukalike myoyo, nkaambo akati kanu taakwe uuti sweekelwe buumi bwakwe, pele bwaato bwalo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.22",
            "verseOrgIds": [
              "ACT.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo sunu masiku wandisikila angelo wa-Leza oyo ngwendi wakwe, ngwendibelekela, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.23",
            "verseOrgIds": [
              "ACT.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "wati, Utayoowi, Paulo, uleelede kuyooima kumbele lya-Kaisara. Eno swiilila, Leza wakupa boonse aba mboenda abo, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.24",
            "verseOrgIds": [
              "ACT.27.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 27:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaako nobaalumi, amukalike myoyo, nkaambo ndisyoma Leza kuti kuyooba mbubonya mbuli mbwendaambilwa, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.25",
            "verseOrgIds": [
              "ACT.27.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwalo ­tuyoosowelwa acilwa cimwi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.26",
            "verseOrgIds": [
              "ACT.27.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.26",
            "verseOrgIds": [
              "ACT.27.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokwakaba buzuba bwekumi mwaane, notwakali kuzuwaikwa oku akooku mulwizi lwa-Adriya, akati kamasiku abeenzya bwaato bakayeeya kuti, Twasika afwaafwi enyika imwi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.27",
            "verseOrgIds": [
              "ACT.27.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 27:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nobakeeleka bulamfu bwamaanzi, bakajana mbwamaboko aalandabulwa aali makumi obile. Nobakeenda kaniini, bakeeleka alimwi, bajana mbwamaboko aali kumi mwasanu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.28",
            "verseOrgIds": [
              "ACT.27.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela mbotwakayoowa kuti ambweni tulalyuuma kumabwe, bakawaala zijasyo zyone kunkombo yamunsi lyabwaato, balangila kuti buce. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.29",
            "verseOrgIds": [
              "ACT.27.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 27:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeenzya bwaato bakasoleka kuloboka mubwaato, bakaselusya kaato mumaanzi, babaanga bandoodumpukizya zijasyo kumbele. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.30",
            "verseOrgIds": [
              "ACT.27.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 27:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele Paulo wakaambila musunguli abasilumamba kuti, Aba batakala mubwaato, tamukoofutulwa pe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.31",
            "verseOrgIds": [
              "ACT.27.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 27:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndilyonya basilumamba bakakosola zyaanzyo zyakaato, bakaleka kainka, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.32",
            "verseOrgIds": [
              "ACT.27.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 27:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno nobwati kace, Paulo wakabakombelezya boonse kuti balye cilyo wakati, Sunu mbuzuba bwekumi mwaane kamulindila akuliimya, kamutalyi cintu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.33",
            "verseOrgIds": [
              "ACT.27.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 27:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaako ndamukombelela kuti mulye, nkaambo eci ncakumufutula, nkaambo akati kanu taakwe uuti sweekelwe nekaba kasusu komwe kamutwe wakwe, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.34",
            "verseOrgIds": [
              "ACT.27.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 27:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naakaamba obo wakabweza mukamu, walumba Leza kumbele lyabo boonse, wuukomona, watalika kulya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.35",
            "verseOrgIds": [
              "ACT.27.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 27:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndilyonya boonse bakakalika myoyo, balya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.36",
            "verseOrgIds": [
              "ACT.27.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 27:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Swebo toonse totwakali mubwaato twakali myaanda yobile amakumi aali musanu mwaabili abantu bosanwe muumwi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.37",
            "verseOrgIds": [
              "ACT.27.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 27:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nobakakuta, bakaubya bwaato, maila bakaasowela mulwizi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.38",
            "verseOrgIds": [
              "ACT.27.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 27:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela nobwakaca teebakali kwiizi nyika eyo, pele bakabona ikoba ilijisi nkomwe yamusenga, bakayanda kuti, na balakonzya, batole nkuko bwaato. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.39",
            "verseOrgIds": [
              "ACT.27.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 27:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakakosola zijasyo, bazileka zyabbila mulwizi, baangununa zyaanzyo izyakali kwaangwa azintu zyakuzyuulula, bakalandabula sila lyaluuwo kumbele. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.40",
            "verseOrgIds": [
              "ACT.27.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 27:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele nobakasika abusena aaswaanina inzi zyobile, bakapatizya bwaato ansi, inkombo yakumbele yakasimpa ilipatide, pele yamunsi yakatalika kutyoka nkaambo kenguzu zyamayuwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.41",
            "verseOrgIds": [
              "ACT.27.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "ACT 27:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo basilumamba bakakanza kujaya baange, kuti kutabi uuyamba akuloboka. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.42",
            "verseOrgIds": [
              "ACT.27.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "ACT 27:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwalo musunguli mbwaakali kuyanda kufutula Paulo, wakakasya kukanza kwabo, walailila kuti abo abakuzi kusamba abaliwaale mumaanzi, basaangune balo kuyoosika kunkomwe, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.43",
            "verseOrgIds": [
              "ACT.27.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "ACT 27:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkokuya abasyaala baligwasye bamwi kuzisamu, bamwi kuzintu zimwi zyabwaato, Aboobo kwakaba kuti boonse bakafutulwa, basika kunkomwe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.44",
            "verseOrgIds": [
              "ACT.27.44"
            ]
          }
        }
      ]
