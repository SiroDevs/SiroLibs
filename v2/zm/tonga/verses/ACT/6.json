    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumazuba ayo nobakali kuya buvula basikwiiya, ba-Giriki bakatongaukila ba-Hebrayo, nkaambo bamukabafu bakulimbabo bakalengaalwa kumwaabo wabuzuba bumwi bumwi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.1",
            "verseOrgIds": [
              "ACT.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela abali kumi mubabili bakaita mbungano yabasikwiiya bati, Takweelede kuti swebo tuleke makani aa-Leza, tugame kwaaba zilyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.2",
            "verseOrgIds": [
              "ACT.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aboobo, bakwesu, amusale akati kanu baalumi abali musanu mubabili, abali empuwo mbotu, abazywide Muuya Uusalala abusongo, mbotuti bike mumulimo oyo, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.3",
            "verseOrgIds": [
              "ACT.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwalo swebo tuyoojatisya kukukomba akumulimo wamakani. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.4",
            "verseOrgIds": [
              "ACT.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno ijwi elyo lyakakonda bantu boonse, Bakasala Stefano, mwaalumi uuzywide lusyomo a-Muuya Uusalala, antoomwe a-Filipo, a-Prokoro, a-Nikanora, a-Timo, a-Parmena, a-Nikolao, musyomi waku-Antiokeya, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.5",
            "verseOrgIds": [
              "ACT.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakabaimika kumbele lyabaapostolo. Nkabela nobakamana kukomba, bakabika maanza alimbabo,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.6",
            "verseOrgIds": [
              "ACT.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.6",
            "verseOrgIds": [
              "ACT.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo makani aa-Leza akaanda, basikwiiya bakavulisya mu-Jerusalemu, abapaizi banjibanji bakasyoma.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.7",
            "verseOrgIds": [
              "ACT.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.7",
            "verseOrgIds": [
              "ACT.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno Stefano mbwaakazywide luzyalo enguzu, wakali kucita ziyoosya ezitondezyo zipati akati kabantu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.8",
            "verseOrgIds": [
              "ACT.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela bakanyamuka bamwi bacikombelo icitegwa caba-Libertino, abaku-Kurene, abaku-Alesandreyo, abazwa ku-Kilikiya, aku-Asiya, bakazyanya a-Stefano, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.9",
            "verseOrgIds": [
              "ACT.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwalo teebakali enguzu kukazya busongo a-Muuya ngwaambya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.10",
            "verseOrgIds": [
              "ACT.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndilyonya bakaleta baalumi abakati, Twakamumvwa ulaamba majwi aakusampaula Musa a-Leza, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.11",
            "verseOrgIds": [
              "ACT.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela bakasungilizya bantu, abapati, abalembi. Baboola bamujata, bamutola alubeta. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.12",
            "verseOrgIds": [
              "ACT.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpoonya bakanyamusya bakamboni bakubeja abakateeti, Oyu muntu taleki kwaamba majwi aakusampaula busena obu busalala amulao, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.13",
            "verseOrgIds": [
              "ACT.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkaambo twakamumvwa uti, Oyu Jesu wa-Nazareta uyoobumwaya busena obu, asandule ziyanza nzyaakatupa Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.14",
            "verseOrgIds": [
              "ACT.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boonse abakede mulubeta bamulangisisya, babona busyu bwakwe bwaba mbuli busyu bwaangelo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.15",
            "verseOrgIds": [
              "ACT.6.15"
            ]
          }
        }
      ]
    }
  ],
