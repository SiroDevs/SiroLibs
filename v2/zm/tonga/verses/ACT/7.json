  "reference": "Incito 7",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 59,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "ACT 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo mupaizi mupati wakati, Sena mbwaabede aya? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.1",
            "verseOrgIds": [
              "ACT.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakavuwa wati, Nobaalumi bakwesu anomatata, amuswiilile. Leza wabulemu wakali­ bonya kuli-Abrahamu tateesu naakali ku-Mesopotamiya, katana kukala ku-Harani, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.2",
            "verseOrgIds": [
              "ACT.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakamwaambila kuti, Kozwa mucisi cabanamuzeenu, akumikowa yako, uye kucisi ncenti kakutondezye ncico. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.3",
            "verseOrgIds": [
              "ACT.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndilyonya wakazwa mucisi caba-Kaldayo, wakala mu-Harani. Elyo naakafwa wisi, Leza wakamulongezya muliceecino cisi ncomukede sunu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.4",
            "verseOrgIds": [
              "ACT.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele takamupede lukono omuno pe, nobuba busena bwakulyatika tende lyomwe, kwala wakamusyomezya kuyoomupa ncico cibe cakwe, ecabana bakwe munsi lyakwe, katana kuba amwana. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.5",
            "verseOrgIds": [
              "ACT.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno mbombuboobo Leza mbwaakaamba kuti bana bakwe bayookala mucisi cabamasi, bayoobacita bazike bakabalele bubi myaaka iili myaanda yone. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.6",
            "verseOrgIds": [
              "ACT.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele cisi iciyoobacita bazike ndiyoocibeteka, mbwaakaamba Leza, Munsi lyakooko bayoozwa bakandikombele muliboobuno busena, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.7",
            "verseOrgIds": [
              "ACT.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakamupa cizuminano cakupalulwa, aboobo Abrahamu wakazyala Izaka, wakamupalula kubuzuba bwamusanu mwaatatu. Izaka wakazyala Jakobo, Jakobo wakazyala basikale abali kumi mubabili. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.8",
            "verseOrgIds": [
              "ACT.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno basikale, nkaambo kebbivwe, bakamuuzya Josefa ku-Egepita, kwalo Leza wakali awe, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.9",
            "verseOrgIds": [
              "ACT.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "wamuvuna kumapenzi aakwe oonse, wamupa luzyalo abusongo kumbele lya-Farao, mwami wa-Egepita, wamucita mweendelezi wa-Egepita awaŋanda yakwe yoonse. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.10",
            "verseOrgIds": [
              "ACT.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo kwakaba nzala mucisi coonse ca-Egepita eca-Kanana, amapenzi mapati, matateesu tabakajene kulya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.11",
            "verseOrgIds": [
              "ACT.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele Jakobo, naakamvwa kuti maila nkwaali ku-Egepita, wakatuma matateesu lutaanzi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.12",
            "verseOrgIds": [
              "ACT.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulweendo lwabili Josefa wakazibwa banabakwabo, awalo mukowa wa-Josefa wakaambwa kuli-Farao, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.13",
            "verseOrgIds": [
              "ACT.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Josefa wakatumina wisi Jakobo, wakamwiita abeŋanda yakwe boonse, bantu abali makumi aali musanu mwaabili amusanu, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.14",
            "verseOrgIds": [
              "ACT.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Jakobo wakalonga wainka ku-Egepita, wakafwa walo, amatateesu, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.15",
            "verseOrgIds": [
              "ACT.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakatolwa ku-Sekemu, bazikwa mucuumbwe ncaakaula Abrahamu muulo wensiliva kubana ba-Emori mu-Sekemu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.16",
            "verseOrgIds": [
              "ACT.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele mbecakaswena ciindi cacisyomezyo, Leza ncaakasyomezya Abrahamu, bantu bakavula, baba banjibanji mu-Egepita, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.17",
            "verseOrgIds": [
              "ACT.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "limwi kwakaba umbi mwami mu-Egepita uwatakali kumuzi Josefa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.18",
            "verseOrgIds": [
              "ACT.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walo wakacitila mukowa wesu camaanu, wakapenzya matateesu kuti basowe bavwanda babo, kuti bataponi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.19",
            "verseOrgIds": [
              "ACT.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ncencico ciindi ncaakazyalwa Musa, mwana uuebeka, wakalelwa myeezi yotatwe muŋanda yakwabo, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.20",
            "verseOrgIds": [
              "ACT.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkabela naakasowegwa, mwana a-Farao musimbi wakamubweza, wakamulela mbuli mwanaakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.21",
            "verseOrgIds": [
              "ACT.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa wakaiisigwa busongo boonse bwa-Egepita, wakaba anguzu kumajwi akumilimo yakwe, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.22",
            "verseOrgIds": [
              "ACT.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno naakali emyaaka iili makumi one, kwakanjila mumoyo wakwe kuti aswaye banabakwabo, bana ba-Israyeli, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.23",
            "verseOrgIds": [
              "ACT.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo naakabona umwi wabo ulapenzegwa wamuvuna, wamulwanina uupenzegwa, wajaya mu-Egepita, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.24",
            "verseOrgIds": [
              "ACT.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wali kuyeeya kuti, banabakwabo balaziba kuti Leza ulabaangulula ajanza lyakwe, kwalo tabakazibide, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.25",
            "verseOrgIds": [
              "ACT.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nobwakaca wakajana bamwi balalwana, wakabakombelezya kuti balekane wati, Nobaalumi, muli babunyina, mulwaninanzi? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.26",
            "verseOrgIds": [
              "ACT.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele oyo uwakasumuna mweenzinyina, wakamutonka wati, Nguni wakubika bwami abubetesi kulindiswe? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.27",
            "verseOrgIds": [
              "ACT.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sena uyanda kundijaya mbubonya mbookajaya mu-Egepita jilo? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.28",
            "verseOrgIds": [
              "ACT.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa naakamvwa obo wakatija, waakukala mucisi ca-Midiani, nkwaakazyalila bana bobile. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.29",
            "verseOrgIds": [
              "ACT.7.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokwakamana myaaka iili makumi one angelo wakalibonya kulinguwe mukasaka kacilundu ca-Sinai, mubbalabala lyamulilo muciteo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.30",
            "verseOrgIds": [
              "ACT.7.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno Musa naakacibona, wakayoowa kucilengaano, naakaswena afwaafwi kulangisisya, kwakasika ijwi lya-Jehova, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.31",
            "verseOrgIds": [
              "ACT.7.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "lyakati, Ndime Leza wabauso, Leza wa-Abrahamu, awa-Izaka, awa-Jakobo. Musa wakazyangama, takali ecamba cakulangisisya, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.32",
            "verseOrgIds": [
              "ACT.7.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova wakamwaambila kuti, Gwisya ndyasyo kumatende aako, nkaambo abusena awo mpoimvwi mpaansi aasalala, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.33",
            "verseOrgIds": [
              "ACT.7.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ncobeni ndabona mapenzi aabantu bangu abali mu­-Egepita, ndamvwa manyonausi aabo, ndaseluka kuti ndibavune. Eno koboola ndikutume ku-Egepita. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.34",
            "verseOrgIds": [
              "ACT.7.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa oyo ngobakakaka bati, Nguni wakubika bwami abubetesi? Leza wakamutuma oyo, abe mwami amuvuni, ajanza lyaangelo uwakalibonya kulinguwe muciteo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.35",
            "verseOrgIds": [
              "ACT.7.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walo wakabagwisya, wakacita ziyoosya azitondezyo mucisi ca-Egepita, amu-Lwizi Lusalala, amunkanda myaaka iili makumi one. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.36",
            "verseOrgIds": [
              "ACT.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngonguwe Musa oyu, uwakaambila bana ba-Israyeli kuti, Jehova Leza wanu uyoomubusizya musinsimi kubanabakwanu uuli mbuli ndime. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.37",
            "verseOrgIds": [
              "ACT.7.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyu ngonguwe uwakali mumbungano munkanda, antoomwe aangelo uwakaamba anguwe mucilundu ca-Sinai, antoomwe amatateesu. Nguwakatambula makani maumi akutupa swebo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.38",
            "verseOrgIds": [
              "ACT.7.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 7:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele bamatateesu tabakazumide kumuswiilila, bakamukaka, myoyo yabo yakapiluka ku-Egepita, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.39",
            "verseOrgIds": [
              "ACT.7.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 7:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakaambila Aroni kuti, Tucitile mizimo itusolwedele, nkaambo Musa oyo uwakatugwisya mucisi ca-Egepita, tatuzi na wakasikilwanzi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.40",
            "verseOrgIds": [
              "ACT.7.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 7:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumazuba ayo bakacita cikozyano camoombe, bakapaila cikozyano eco, babotelwa amilimo yamaanza aabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.41",
            "verseOrgIds": [
              "ACT.7.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "ACT 7:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leza wakabafutatila, wabasowa kuti bakombe makamu aakujulu, mbubonya mbokulembedwe mubbuku lyabasinsimi kuti,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.42",
            "verseOrgIds": [
              "ACT.7.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "ACT 7:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.43",
            "verseOrgIds": [
              "ACT.7.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "ACT 7:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamatateesu bakali kujisi cikombelo cabukamboni, mbubonya mbuli kulailila kwayooyo uwakaambila Musa kuti acicite akucikozyanya eco ncaakabona. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.44",
            "verseOrgIds": [
              "ACT.7.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "ACT 7:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ncenciceeco njobakaletelela bamatateesu a-Joshua, nobakatola nyika yabamasi mbaakatanda Leza kubusyu bwamatateesu, mane kusikila kumazuba aa-Davida, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.45",
            "verseOrgIds": [
              "ACT.7.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "ACT 7:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walo wakajana luzyalo kumbele ya-Leza, wakakumbila kujanina Leza wa-Jakobo cikombelo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.46",
            "verseOrgIds": [
              "ACT.7.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "ACT 7:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele Solomoni nguwakamuyakila nganda, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.47",
            "verseOrgIds": [
              "ACT.7.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "ACT 7:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nekubaboobo Sijulu lyamajulu takali mumaanda aacitwa amaanza, mbubonya mbwaakaamba musinsimi kuti,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.48",
            "verseOrgIds": [
              "ACT.7.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "ACT 7:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.50",
            "verseOrgIds": [
              "ACT.7.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "ACT 7:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nywebo nobasicinguni abatapalwidwe kumyoyo akumatwi, lyoonse mulakasya Muuya Uusalala, mbubonya mbobakacita bamauso anywebo mbomucita. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.51",
            "verseOrgIds": [
              "ACT.7.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "ACT 7:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nguuli musinsimi bamauso ngobatakapenzya? Bakabajaya abakali kusinsima kusika kwa-Uululeme, oyo ngomwabeda baabi abajayi, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.52",
            "verseOrgIds": [
              "ACT.7.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "ACT 7:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "nywebo nomwakatambula mulao kumaanza aabaangelo, pele tamukaucitide. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.53",
            "verseOrgIds": [
              "ACT.7.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "ACT 7:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nobakamvwa obo, bakaciswa kumyoyo, bamulumina ntwino, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.54",
            "verseOrgIds": [
              "ACT.7.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "ACT 7:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele walo, mbwaakazywide Muuya Uusalala, wakalangisisya kujulu, wabona bulemu bwa-Leza, a-Jesu uliimvwi kululyo lwa-Leza, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.55",
            "verseOrgIds": [
              "ACT.7.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "ACT 7:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "wati, Amulange, ndabona ijulu lili bukwazi, a-Mwana a-Muntu uliimvwi kululyo lwa-Leza, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.56",
            "verseOrgIds": [
              "ACT.7.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "ACT 7:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndilyonya bakoompolola ejwi pati, balisinka mumatwi aabo, bamukulumukila antoomwe, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.57",
            "verseOrgIds": [
              "ACT.7.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "ACT 7:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "bamutandila anze amunzi, bamuwaala mabwe, Bakamboni bakabika zyakusama zyabo kumatende aamwaalumi uutegwa Saulo, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.58",
            "verseOrgIds": [
              "ACT.7.58"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "ACT 7:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakamufusa mabwe Stefano, walo ulakomba uti, Mwami Jesu, tambula muuya wangu, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.59",
            "verseOrgIds": [
              "ACT.7.59"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "60",
            "style": "v",
            "sid": "ACT 7:60"
          },
          "items": [
            {
              "text": "60",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela wakafugama amazwi, woompolola ejwi pati wati, Mwami, utababiki mulandu acibi eci, Naakaamba obo, woona.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.60",
            "verseOrgIds": [
              "ACT.7.60"
            ]
          }
        }
      ]
    }
