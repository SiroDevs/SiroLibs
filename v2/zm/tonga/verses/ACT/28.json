  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "ACT 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Notwakafutuka twakaziba kuti cilwa eco cilategwa Melita, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.1",
            "verseOrgIds": [
              "ACT.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basicisi bakatutambula aluzyalo lwinilwini, bakutula mulilo, batutambula toonse nkaambo kemvula iyali kuwa empeyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.2",
            "verseOrgIds": [
              "ACT.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo naakatebba cileye cankuni akucibika amulilo, yakazwa nzoka nkaambo kakukasaala, yalamatila kujanza lyakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.3",
            "verseOrgIds": [
              "ACT.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basicisi nobakabona muuka ulalengelela kujanza lyakwe, bakalyaambauzya beni bakati, Ncobeni oyu muntu mujayi, naafutuka mulwizi bululami tabuzumini kuti kacipona, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.4",
            "verseOrgIds": [
              "ACT.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokubaboobo wakasansamwida muuka mumulilo, taakwe ambwaakaba. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.5",
            "verseOrgIds": [
              "ACT.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakali kulanga bati ulazimba, na ulawida ansi afwe mpoonya, pele nobakalangila ciindi cilamfu akubona kuti taakwe ambwaaba, bakasanduka bati muzimo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.6",
            "verseOrgIds": [
              "ACT.28.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.6",
            "verseOrgIds": [
              "ACT.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno kufwaafwi kubusena obo kwakali nyika yamuntu uutegwa Popliyo, mwami wacilwa, Wakatutambula akutubamba kabotu mazuba otatwe, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.7",
            "verseOrgIds": [
              "ACT.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele wisi Popliyo wakalilede, wali kuciswa mutwe akupulumba. Paulo wakanjila kulinguwe, wakomba, wabika maanza alinguwe, wamuponya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.8",
            "verseOrgIds": [
              "ACT.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokwakacitwa obo, bakaboola abamwi bamucilwa abakali azilwazi, baponezegwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.9",
            "verseOrgIds": [
              "ACT.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakatulemeka amalemeko manjimanji, alimwi notwakainka bakatubikila mubwaato kufumbwa zintu nzotwali kubula.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.10",
            "verseOrgIds": [
              "ACT.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.10",
            "verseOrgIds": [
              "ACT.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno munsi lyamyeezi yotatwe twakainka abwaato bwaku-Alesandriya, ubwakakede mucilwa mapeyo. Bulembo bwabo bwakali bwa-Bana Balombe Bamayanga. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.11",
            "verseOrgIds": [
              "ACT.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Notwakasika ku-Surakusa, twakalyokezya mazuba otatwe, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.12",
            "verseOrgIds": [
              "ACT.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuzwa awo twakeenda cakuzinguluka, twasika ku-Regiyo. Elyo nobwakaca wakaunga muuwo wakumusanza, abwabili twakasika ku-Putiyolo, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.13",
            "verseOrgIds": [
              "ACT.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oko twakajana babunyina, batukombelela kukala abo mazuba aali musanu mwaabili, nkokuya tusike ku-Roma, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.14",
            "verseOrgIds": [
              "ACT.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwalo oko babunyina nobakatumvwa, bakazootucinga, mane basika ku-Ibbuwa lya-Apiyo aku-Maanda Otatwe. Paulo ababone buyo, walumba Leza, wakalika moyo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.15",
            "verseOrgIds": [
              "ACT.28.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.15",
            "verseOrgIds": [
              "ACT.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Notwakanjila mu-Roma, musunguli wakaaba baange kumusolozi wabalindizi, pele Paulo wakazumizigwa kukala alike asilumamba oyo uwali kumulindila.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.16",
            "verseOrgIds": [
              "ACT.28.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.16",
            "verseOrgIds": [
              "ACT.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela munsi lyamazuba otatwe, Paulo wakaita abo abakali bapati baba-Juda. Nobakabungana wakabaambila kuti, Nobaalumi bakwesu, nentacitide cintu icaandeene abantu neziba eziyanza zyamatateesu, nokubaboobo ku-Jerusalemu ndakaabwa ndi mwaange kumaanza aaba-Roma. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.17",
            "verseOrgIds": [
              "ACT.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balo nobakandibuzya, bakayanda kundyaangununa, nkaambo teekwakali kaambo kulindime akeelede lufu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.18",
            "verseOrgIds": [
              "ACT.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele ba-Juda nobakakaka, ndakasungilizigwa kulisisya kuli-Kaisara, nokubaboobo takuli kuti ndakabika mulandu kucisi cakwesu pe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.19",
            "verseOrgIds": [
              "ACT.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ncendamwiita nkaambo kamakani aya, kuti muzoondibone, twaambaule anywebo. Eno nkaambo kakusyoma mbuli ba-Israyeli ncendaangilwa enketani ezi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.20",
            "verseOrgIds": [
              "ACT.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela bakamuvuwa kuti, Tatukatambwide magwalo aazwa ku-Judaya aakulungulula, alimwi takukasikide naba omwe wabakwesu uwakatulungulwida, nokuba kwaamba cibi ayebo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.21",
            "verseOrgIds": [
              "ACT.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele tulayanda kukumvwa mboyeeya, nkaambo tulizi kuti anooli aankamu eyi, alakazigwa kumasena oonse.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.22",
            "verseOrgIds": [
              "ACT.28.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.22",
            "verseOrgIds": [
              "ACT.28.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo kubuzuba mbobakamubikila, kwakasika banjibanji muŋanda mwakakede. Kuzwida cifumofumo mane kusikila kumazuba wakabapandulwida makani, ulalungulula aa-Bwami bwa-Leza, akubakombelezya makani aa-Jesu, aazwa kumulao akubasinsimi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.23",
            "verseOrgIds": [
              "ACT.28.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamwi bakasyoma ayo aakaambwa, bamwi pe tabakasyomede. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.24",
            "verseOrgIds": [
              "ACT.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela mbobatakazuminana akati kabo bakamwaika, Paulo naakamana kwaamba ijwi eli lyomwe lyakuti, Ngakasimpe ayo Muuya Uusalala ngaakaambya Isaya musinsimi kumatateesu ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.25",
            "verseOrgIds": [
              "ACT.28.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "aakuti,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.26",
            "verseOrgIds": [
              "ACT.28.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 28:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.29",
            "verseOrgIds": [
              "ACT.28.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 28:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno Paulo wakamanizya myaaka yobile muŋanda yakwe njaakali kutelela, watambula boonse abali kumuniilila, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.30",
            "verseOrgIds": [
              "ACT.28.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 28:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ulakambauka a-Bwami bwaLeza, akwiisya ecamba makani aa-Mwami Jesu Kristo, kakutakwe uumukasya.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.31",
            "verseOrgIds": [
              "ACT.28.31"
            ]
          }
        }
      ]
    }
  ],
