                  "text": "Ef 5:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkikaambo kazintu ezi nkibuzida bukali bwa-Leza kubana batamvwi. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.6",
            "verseOrgIds": [
              "COL.3.6"
