              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati kabaaba mpomwakali kweendela anywebo kalekale nimwakacili kupona mukati kazintu ezi, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.7",
