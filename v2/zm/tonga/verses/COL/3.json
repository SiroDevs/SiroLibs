                {
                  "text": "Mt 6:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amupangike myoyo yanu kuzintu zili kujulu, mutaipangiki kuzintu zyaansi pe. ",
          "type": "text",
