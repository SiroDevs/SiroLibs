          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kufumbwa cintu ncimucita, milimo yanu ibe yamoyo woonse, ibe mbuli milimo iicitilwa Mwami, itabi yakubelekela bantu buyo pe. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.23",
            "verseOrgIds": [
