                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mutaambilani cakubeja, pe, nkaambo mulisamunwide buntu bukulukulu amilimo yambubo, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.9",
