                  "text": "Ef 5:19-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Makani aa-Kristo abe mbuli buvubi bukalilila mumyoyo yanu. Amwiisyanye akucenjezyanya cabusongo bunji antembauzyo anyimbo zya-Leza amalelebu, akuya bwiimba lyoonse cakulumba Leza mumyoyo yanu. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.16",
            "verseOrgIds": [
              "COL.3.16"
            ]
          }
