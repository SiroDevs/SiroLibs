            "number": "4",
            "style": "v",
            "sid": "JOS 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amubone! Ndamwaabila ezi zisi zisyeede, kuti zivubwe kumikowa yanu, kuzwa ku-Jordano, amisyobo yoonse njindanyonyoona, mane kusikila kulwizi lupati lwakububbila. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.4",
            "verseOrgIds": [
              "JOS.23.4"
            ]
          }
