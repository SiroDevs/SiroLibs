              "type": "text"
            }
          ]
        },
        {
          "text": "Lino inywe mwabona zintu zyoonse Jehova Leza wanu nzyaakacitila misyobo eyi yoonse kubusyu bwanu, nkaambo Jehova Leza wanu nguwakamulwida. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.3",
            "verseOrgIds": [
              "JOS.23.3"
            ]
          }
        },
        {
          "name": "verse",
