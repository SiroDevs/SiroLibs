        },
        {
          "text": "Sihoni mwami waba-Amori iwakakede ku-Hesiboni, iwakali kweendelezya cisi kuzwa ku­-Aroeri kunkomwe yamulonga wa-Arinoni amunzi uuli akati kamwaakwe, acisela canyika ya-Gileadi, mane kusikila kumulonga wa-Jaboki uubambene acisi cabana ba-Amoni; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.2",
            "verseOrgIds": [
              "JOS.12.2"
            ]
          }
        },
