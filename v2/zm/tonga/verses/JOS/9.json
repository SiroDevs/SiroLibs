            }
          ]
        },
        {
          "text": "Lino bakasika kuliJoshua kuzilao nkwaakakede ku-Giligala, bakaambila nguwe abana baIsrayeli kuti, Twazwa kucisi cakule, Lino atutangane anywebo cizuminano. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.6",
