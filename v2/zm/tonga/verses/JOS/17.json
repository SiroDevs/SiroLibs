            }
          ]
        },
        {
          "text": "Pele Zelofehadi mwana wa-Heferi mwana wa-Gileadi mwana wa-Makiri mwana wa-Manase katazyedebana baalumi pe, kazyede banakazi luzutu, Mazina aabana bakwe basimbi ngaaya:— Mala, a-Nowa, Hogila, Milika a-Tiriza. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.3",
            "verseOrgIds": [
              "JOS.17.3"
            ]
          }
        },
