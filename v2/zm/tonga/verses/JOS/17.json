        },
        {
          "text": "Nkabela bakeza kuli-Eleazara mupaizi akuli-Joshua mwana wa-Nuni akubapati, bakati, Jehova wakalailila Musa kuti tupegwe lukono akati kabakwesu baalumi. Mpawo wakacita mbubonya mbwaakalailila Jehova, wakabapa caabilo akati kabakulana bamawisi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.4",
            "verseOrgIds": [
              "JOS.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aboobo bana ba-Manase bakapegwa zyaabilo zili ikumi, kutaamba nyika ya-Gileadi aBasana yamutala lya-Jordano. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.5",
            "verseOrgIds": [
              "JOS.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 17:6"
          },
          "items": [
