                  "text": "41",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo bana basimbi ba-Manase bakaabilwa lukono akati kabana bakwe baalumi, alimwi bana bamwi ba-Manase kabajisi nyika ya-Gileadi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.6",
            "verseOrgIds": [
              "JOS.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mugaano wabana ba-Manase wakazwa ku-Aseri kusikila ku-Mika-metatu uuli kunembo lya-Sekemu; alimwi kululyo mugaano wakainda kubantu ibakakede ku-Enitapua, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.7",
            "verseOrgIds": [
              "JOS.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.12.17"
              },
              "items": [
                {
                  "text": "Jos 12:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.15.34"
              },
              "items": [
                {
                  "text": "15:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Cisi ca-Tapua cakali ca-Manase, pele munzi wa-Tapua walo kuuli kumagolelo aacisi ca-Manase, wakali wabana ba-Efraimu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.8",
            "verseOrgIds": [
              "JOS.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.16.8"
              },
              "items": [
                {
                  "text": "Jos 16:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.16.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo mugaano wakaseluka mane kusikila kukalonga ka-Kana, akusotoka kalonga kuya kumusanza. Eyi minzi yakali yaba-Efraimu akati kaminzi yaba-Manase. Nkabela mugaano wa-Manase wakainda kubbazu lyakunyika lyakalonga, amagolelo aawo akali kulwizi lupati. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.9",
            "verseOrgIds": [
              "JOS.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyika yakumusanza yakali ya-Efraimu, nyika yakunyika yakali ya-Manase, amagolelo aanyika yakwe akali kulwizi, alimwi bakalibambene aba-Aseri kubbazu lyakunyika, aba-Isakara kubbazu lyakujwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.10",
            "verseOrgIds": [
              "JOS.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
