              "items": [
                {
                  "text": "My 33:52",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nekubaboobo bana ba-Manase bakakacilwa kutanda bantu ibakakede muminzi eyi. Ba-Kanana bakakolela kukala omo munyika. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.12",
            "verseOrgIds": [
              "JOS.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.16.10"
              },
              "items": [
                {
                  "text": "Jos 16:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino bana ba-Israyeli nibakaba anguzu, bakanjizya ba-Kanana mucibalo, pele kutanda teebakabatandilila pe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.13",
            "verseOrgIds": [
              "JOS.17.13"
            ]
          }
        }
      ]
