                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino mwanakazi wakabweza abo bantu bobile, wakabasisa, elyo wakati, Ncobeni ndakasikilwa bantu, pele teendakezi na bazwa kuli, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.4",
            "verseOrgIds": [
              "JOS.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkabela nikwakadimaana, ciindi mulyango wamunzi nuujalwa, abo bantu bakainka. Nsizi na bantu baya kuli, pe. Amufwambaane kubatobela, mulabeenzya. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.5",
            "verseOrgIds": [
              "JOS.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
