        },
        {
          "text": "Elyo mwami wa-Jeriko wakaambilwa kuti, Bona! K wasika bantu bazwa kubana baIsrayeli, beza kuzoolanga nyika mbwiibede. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.2",
            "verseOrgIds": [
              "JOS.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo mwami wa-Jeriko wakatumina Rahabu, wakati, Leta abo bantu ibakasika kulinduwe, nkaambo kulanga-langa nyika yoonse nciceeco ncibazida. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.3",
            "verseOrgIds": [
              "JOS.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
