                  "text": "Kul 1:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele kabatansikide atala alululi lwaŋanda, akubasisa kunsi lyazisiko zyabutonje nzyaakayanikide alululi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.6",
            "verseOrgIds": [
              "JOS.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo bantu bakali kuya bubatobela munzila iiya ku-Jordano kusikila kucito. Nkabela basikutobela bamane buyo kuya anze, ndilyonya bakajala mulyango wamunzi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.7",
            "verseOrgIds": [
              "JOS.2.7"
            ]
