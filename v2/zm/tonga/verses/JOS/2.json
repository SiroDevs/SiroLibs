        {
          "text": "Lino Joshua mwana wa-Nuni wakatuma bantu bobile kuzwa ku-Sitimu kuyoolanga nyika cuumunizi. Wakati, Kamuya, mukalange nyika, amunzi waku-Jeriko, Nkabela bakainka, bakaakunjila muŋanda yamwanakazi simamambe, zina lyakwe kali Rahabu, nkubakaakuona. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.1",
            "verseOrgIds": [
              "JOS.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
