        },
        {
          "text": "Lailila bapaizi basikuyumuna ibbokesi lyabukamboni kuti bazwe mu-Jordano. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.16",
            "verseOrgIds": [
