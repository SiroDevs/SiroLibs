              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "elyo muleelede kuzibya bana banu kuti, Mpoonya awa ba-Israyeli mpobakazubukila Jordano maanzi naakayuminina. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.22",
