          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amabwe ayo aali ikumi aabili ngebakagwisya mu-Jordano, Joshua wakaaimikizya nkukonya ku-Giligala. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.20",
            "verseOrgIds": [
              "JOS.4.20"
            ]
          }
        },
