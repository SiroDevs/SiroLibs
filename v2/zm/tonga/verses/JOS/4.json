            "number": "5",
            "style": "v",
            "sid": "JOS 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakabaambila kuti, Amwiinde kunembo lyabbekesi lya-Jehova Leza wanu kusika akati ka-Jordano, mubweze umwi aumwi ibbwe aciwezo cakwe, abe mbubonya mbuli mweelwe wamikowa yabana ba-Israyeli, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.5",
            "verseOrgIds": [
              "JOS.4.5"
            ]
