                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi Joshua wakaimika mabwe aali ikumi aabili akati ka-Jordano mpoonya awo mpozyakaimvwi zituta zyabapaizi basikuyumuna ibbokesi lyacizuminano, nkabela mpaacili akusikila sunu, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.9",
            "verseOrgIds": [
              "JOS.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo bapaizi basikuyumuna ibbokesi bakaliimvwi akati ka-Jordano mane zintu zyoonse nizyakamana Jehova nzyaakalailila Joshua kuti aambile bantu, mbubonya Musa mbwaakalailila Joshua. Nkabela bantu bakafwambaana kuzubuka. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.10",
            "verseOrgIds": [
              "JOS.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino bantu boonse nibakamana kuzubuka, alyalo ibbokesi lya-Jehova lyakazubuka abapaizi kumeso aabantu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.11",
            "verseOrgIds": [
