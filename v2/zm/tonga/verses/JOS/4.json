          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakaambila bana ba-Israyeli kuti, Bana banu nibayoomubuzya junza kuti, Ino mabwe aya alaambanzi? ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.21",
            "verseOrgIds": [
