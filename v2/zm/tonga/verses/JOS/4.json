          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Joshua wakalailila bapaizi kuti, Amuzwe mu-Jordano. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.17",
            "verseOrgIds": [
              "JOS.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo bapaizi basikuyumuna ibbokesi lyacizuminano ca-Jehova, mbubakamana buyo kuzwa mukati ka-Jordano, andyato zyamaulu aabapaizi mbuzyakaampa buyo nyika injumu, maanzi aa-Jordano akaboola mpaakabede, akapaya munkomwe zyawo moonse mbubonya mbaakali kupaya kukutaanguna,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.18",
            "verseOrgIds": [
              "JOS.4.18"
            ]
          }
        }
