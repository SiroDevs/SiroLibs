              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.9",
            "verseOrgIds": [
              "JOS.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino kuciindi eco, Joshua naakaboola, wakazunda Hazori, amwami wawo wakamujazya ipanga, nkaambo kumatalikilo cisi caku-Hazori kacili cipati akati kazisi ezi zyoonse. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.10",
            "verseOrgIds": [
              "JOS.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu boonse ibakali mumo bakabajazya ipanga, akubanyonyoona. Teebakasia muumi naba omwe, pe, alimwi munzi wa-Hazori bakautenta mumulilo, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.11",
            "verseOrgIds": [
              "JOS.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.33.52"
              },
              "items": [
                {
                  "text": "My 33:52",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.7.2"
              },
              "items": [
                {
                  "text": "Dt 7:2",
