            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.20.16"
              },
              "items": [
                {
                  "text": "20:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.20.17"
              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela minzi yoonse yabami aba Joshua wakaisaala, abami bayo boonse. Wakabajazya ipanga akubanyonyoona, mbubonya mbuli Musa mulanda wa-Jehova mbwaakalailila. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.12",
            "verseOrgIds": [
              "JOS.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele minzi iyakayakidwe atala atulundu ba-Israyeli teebakaitenta pe, cita Hazori ulike Joshua ngwaakatenta. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.13",
            "verseOrgIds": [
              "JOS.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino zisaalo zyaminzi eyi, aŋombe, bana ba-Israyeli bakalibwezela zyoonse, pele boonse bantu bakabajazya ipanga akubanyonyoona mane teekwakasyaala naba omwe muumi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.14",
            "verseOrgIds": [
              "JOS.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 11:15"
          },
          "items": [
