        },
        {
          "text": "Nkabela bakazwa boonse abami babo, bantu banji loko mbuli musee wamunkomwe yalwizi, ambizi ankalaki zinji loko. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.4",
            "verseOrgIds": [
              "JOS.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba bami boonse bakabungana, bakeza kuzookala-kala kudambwa lya-Meromu kuti balwisye ba-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.5",
            "verseOrgIds": [
              "JOS.11.5"
            ]
          }
        }
