                  "text": "Jos 1:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbuli Jehova mbwaakalailila Musa mulanda wakwe, alakwe Musa mbwaakalailila Joshua, mbubonya obo Joshua mbwaakacita. Teewakaleka ijwi niliba lyomwe akati kamakani oonse Jehova ngaakalailila Musa,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.15",
            "verseOrgIds": [
              "JOS.11.15"
            ]
          }
        }
