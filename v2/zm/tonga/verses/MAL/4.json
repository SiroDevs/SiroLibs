              },
              "items": [
                {
                  "text": "Mik 7:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela muyoolyataula basizibi, nkaambo bayooba mulota kunsi lyazituta zyamaulu aanu mubuzuba obo mbwenti cite makani aya, mbwaamba Jehova wamakamu.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.3",
            "verseOrgIds": [
              "MAL.4.3"
            ]
          }
        }
