              "items": [
                {
                  "text": "2 Pet 1:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele inywe numulemeka izina lyangu, izuba lyabululami liyoomupaswida, lileza anguzu zyakuponya mumababa aalyo. Lino muyooinka busotauka mbuli boombe bazwa mucimpati. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.2",
            "verseOrgIds": [
              "MAL.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
