              },
              "items": [
                {
                  "text": "Hos 13:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino amutontozye busyu bwaLeza kuti atufwide luzyalo. Pele na mwasika acipo cili boobo mumaanza aanu, sa uyoomufwida insoni na? mbwaamba Jehova wamakamu, ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.9",
            "verseOrgIds": [
              "MAL.1.9"
            ]
          }
        },
