                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.15.21"
              },
              "items": [
                {
                  "text": "Dt 15:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na mwaleta munyama moofu wakupaizya, sa eco taceensi cibi na? Alimwi na mwaleta uulemene naba mulwazi, sa eco taceensi cibi na? Na watola cintu cili boobo kumwami wako wacisi, sa walo ulabotelwa na? Sa ulakukondelelwa na? mbwaamba Jehova wamakamu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.8",
            "verseOrgIds": [
              "MAL.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAL 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
