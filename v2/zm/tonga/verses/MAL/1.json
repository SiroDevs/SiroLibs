            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.83.18"
              },
              "items": [
                {
                  "text": "83:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Meso aanu ayoobona makani aya, lino muyooamba kuti, Jehova ngusinguzu koonse akunze lyanyika ya-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.5",
            "verseOrgIds": [
              "MAL.1.5"
            ]
          }
        }
