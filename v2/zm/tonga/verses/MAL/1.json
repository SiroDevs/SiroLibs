                "loc": "EZK.41.22"
              },
              "items": [
                {
                  "text": "Ezk 41:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwandisampaula kukutuula acipaililo cangu zilyo zisofweede. Pele mulabuzya kuti, Ino twazisofwaazya buti? Mwazisofwaazya kukuyeeya kuti intafule ya-Jehova ilisampaukide. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.7",
            "verseOrgIds": [
              "MAL.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAL 1:8"
          },
          "items": [
