            }
          ]
        },
        {
          "text": "Nkabela njoomutapatilila sikulyabantu, kuti atanyonyooni micelo yanyika, Misaansa yanu taikooyoosowa limbi micelo yayo mumuunda ciindi ceelede nicitana kusika, mbwaamba Jehova wamakamu, ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.11",
            "verseOrgIds": [
              "MAL.3.11"
            ]
          }
        },
