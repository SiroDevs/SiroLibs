                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sa ncibotu kuti muntu abbide Leza? Nkaambo inywe mulabba kulindime. Pele mwati, Twakubbida nzi? Mwandibbida zipanzi zyakumi azituuzyo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.8",
            "verseOrgIds": [
              "MAL.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
