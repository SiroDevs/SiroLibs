                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo bantu bamisyobo yoonse bayooamba kuti muli acoolwe, nkaambo muyooba cisi ciyandwa, mbwaamba Jehova wamakamu.",
          "type": "text",
          "attrs": {
