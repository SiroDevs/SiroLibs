              },
              "items": [
                {
                  "text": "Ciy 6:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alakwe Johane wakalungulula makani aa-Leza abukamboni bwa-Jesu Kristo azintu zyoonse nzyaakabona. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.2",
            "verseOrgIds": [
              "REV.1.2"
            ]
          }
        },
