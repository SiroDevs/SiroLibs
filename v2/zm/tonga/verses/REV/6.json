                  "text": "6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo ndakabona imbizi iituba, nkabela oyo iwakakede alinjiyo wakalijisi buta, alimwi wakapegwa musini, mpawo wakainka kuya buzunda akuzunda.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.2",
            "verseOrgIds": [
              "REV.6.2"
            ]
