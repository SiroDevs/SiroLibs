          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo ndakamvwa ijwi mukati kabanyama bone lyakati, Mweelo wabulotwe ulaulwa isheleni, amyeelo yotatwe yabbaale ilaulwa isheleni, pele utacesyi mafuta awaini.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.6",
            "verseOrgIds": [
              "REV.6.6"
            ]
