                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo kwakazwa imbizi imbi, yakali kusalala, nkabela oyo iwakakede alinjiyo wakapegwa inguzu zyakugwisya luumuno ansi, kuti bakajayane, alimwi wakapegwa ipanga ipati.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.4",
