            }
          ]
        },
        {
          "text": "Lino abo bakala ansi bayookondwa akusekelela akupana zipego, nkaambo aba basinsimi bobile bakali kubapenzya bantu bakala ansi. ",
          "type": "text",
          "attrs": {
