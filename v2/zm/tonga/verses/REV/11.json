              "type": "text"
            }
          ]
        },
        {
          "text": "Lino bantu bazwa kumikowa yoonse akumisyobo yoonse akumyaambo yoonse akumasi oonse bayoobona mitunta yabo mazuba otatwe acisela, pele tabakooyoozumina kuti mitunta yabo izikwe mutubanda, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.9",
            "verseOrgIds": [
              "REV.11.9"
            ]
          }
        },
        {
