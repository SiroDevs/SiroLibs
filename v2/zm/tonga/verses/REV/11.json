              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino bakamboni bangu bobile njoobapa inguzu zyakusinsima mazuba aali cuulu amyaanda yobile amakumi aali musanu alimwi, nkabela banooyoosamide cisani camasaka. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.3",
            "verseOrgIds": [
              "REV.11.3"
            ]
          }
        },
