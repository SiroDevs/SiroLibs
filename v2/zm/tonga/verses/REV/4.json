                "loc": "EZK.1.26+EZK.1.27+EZK.1.28"
              },
              "items": [
                {
                  "text": "Ezk 1:26-28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Oyo iwakakede, ciwa cakwe cakalikozyenye amabwe aategwa jaspi asandiyo, nkabela cuuno cakalizyungulukidwe fulicoongo mbuli ibbwe litegwa smaragido. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.3",
            "verseOrgIds": [
              "REV.4.3"
            ]
          }
        },
        {
