        {
          "text": "Nkabela mpawo ndakatolwa Muuya, ndabona cuuno cabwami cibikidwe kujulu, alimwi alincico ali umwi uukede. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.2",
