              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo kumulomo wakwe muzoka wakaselulila mwanakazi maanzi mbuli izambangulwe, kuti mwanakazi akatolwe ndilyo. ",
          "type": "text",
          "attrs": {
