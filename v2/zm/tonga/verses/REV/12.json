                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino mwanakazi wakapegwa mababa obile aamusika mupati kuti auluke munkanda kubusena bwakwe nkwakaleledwe ciindi comwe aziindi zyobile acisela, cakusiswa kubusyu bwamuzoka. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.14",
            "verseOrgIds": [
