              "items": [
                {
                  "text": "3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpoonya awo mwanakazi wakacijila kunkanda, nkwajisi busena mbwaakamubambila Leza, kuti bamusanine oko mazuba aali cuulu amyaanda yobile amakumi aali musanu alimwi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.6",
            "verseOrgIds": [
              "REV.12.6"
            ]
