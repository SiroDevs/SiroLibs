              "items": [
                {
                  "text": "Ciy 19:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo wakatumbuka mwana mulombe, nguwenya uyoolela masi oonse amusako walubulo, nkabela oyo mwanaakwe wakatolwa kujulu kuli-Leza akucuuno cakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.5",
            "verseOrgIds": [
              "REV.12.5"
            ]
          }
        },
        {
