                  "text": "Ciy 22:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo umwi wabapati wakandaambila kuti, Utalili. Bona, Mulavu wamusyobo wa-Juda, cisyuukila camuyanda wa-Davida, nguwe iwakazunda kuvununa ibbuku akunamatula zinamatizyo zili musanu azibili.",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.5",
            "verseOrgIds": [
              "REV.5.5"
            ]
