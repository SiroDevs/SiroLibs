        },
        {
          "text": "Lino Mwanambelele oyo wakasika, wabweza ibbuku kujanza lyalulyo lyayooyo uukede acuuno cabwami, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.7",
