                "loc": "EZK.48.30+EZK.48.31+EZK.48.32+EZK.48.33+EZK.48.34+EZK.48.35"
              },
              "items": [
                {
                  "text": "Ezk 48:30-35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi wakalijisi bwaanda bupati bulamfu, amilyango iili ikumi aibili. Kumilyango yawo kuli baangelo bali ikumi ababili, alimwi mpaali mazina aalembedwe alinjiyo, nge mazina aamisyobo iili ikumi aibili yabana ba-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.12",
            "verseOrgIds": [
              "REV.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Milyango yotatwe yakali kujwe, milyango yotatwe yakali kunyika, milyango yotatwe yakali kumusanza, aimwi milyango yotatwe yakali kumbo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.13",
            "verseOrgIds": [
              "REV.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi bwaanda bwamunzi bwakalijisi matalikilo aali ikumi aabili, nkabela mulingao mwali mazina aali ikumi aabili aabaapostolo ba-Mwanambelele.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.14",
            "verseOrgIds": [
              "REV.21.14"
            ]
          }
        }
