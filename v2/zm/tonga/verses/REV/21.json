                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Matalikilo aabwaanda bwamunzi alisakatide amabwe mayandisi aamisyobo misyobo. Mazina aamabwe aakumatalikilo ngaaya, Itaanzi ngu-Jaspi, lyabili ngu-Safiro, lyatatu ngu-Kalikedo, lyane ngu-Smaragido, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.19",
            "verseOrgIds": [
              "REV.21.19"
            ]
          }
        },
        {
