          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "lyasanu ngu-Sardoni, lyamusanu alimwi ngu-Sardio, lyamusanu aabili ngu-Krusolito, lyamusanu aatatu ngu-Berulo, lyamusanu aane ngu-Topazio, lyakumi ngu-Krusoprazo, lyakumi alimwi ngu-Huakinto, lyakumi aabili ngu-Amutusto, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.20",
            "verseOrgIds": [
              "REV.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "REV 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi milyango iili ikumi aibili njangale zili ikumi azibili, umwi aumwi mulyango ngwangale yomwe, awalo mugwagwa wamunzi ngwangolida iisalala iinyengema mbuli ciboniboni cinjoloma.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.21",
