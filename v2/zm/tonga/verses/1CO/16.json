                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino aamilumbo yakugwasya basalali, amucite anywebo mbubonya mbundakalailila imbungano zyaku-Galatiya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.1",
