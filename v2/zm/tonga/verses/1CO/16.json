              },
              "items": [
                {
                  "text": "Inc 20:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lyoonse abuzuba bwansondo umwi aumwi akati kanu aliyobwede cimwi cintu, mbuli mbwajana coolwe, kuti kutabi milimo yakubunganya zipo ciindi ncenti sike. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.2",
            "verseOrgIds": [
              "1CO.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndasika buyo, abo mbomuti sale nzoobapa magwalo kuti bakatole milumbo yanu ku-Jerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.3",
            "verseOrgIds": [
              "1CO.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela na cileelede kuti nje ambebo, elyo tulaya abo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.4",
            "verseOrgIds": [
              "1CO.16.4"
            ]
          }
        }
      ]
    },
