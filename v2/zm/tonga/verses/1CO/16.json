            }
          ]
        },
        {
          "text": "Ambweni nzookala kulindinywe ciindi cilamfu-lamfu, cita kumamanino aamweto, kuti mundisindikizye kulweendo luli buti ndunti tole. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.6",
            "verseOrgIds": [
              "1CO.16.6"
            ]
          }
