          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele teensi kwaamba kuti mutavwelani abasibwaamu boonse baansi ano, nibaba basikulikumbuzya nibaba basilunyanzyo nibaba basikukomba mituni, nkaambo kuti kwaba boobo, ncobeni nimweelede kulongelela kuzwa ansi ano, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.10",
            "verseOrgIds": [
              "1CO.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
