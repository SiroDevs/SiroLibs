                "loc": "MRK.4.11"
              },
              "items": [
                {
                  "text": "Mk 4:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo teensi makani aangu kubeteka baanze pe, Makani aanu kubeteka abo bali mukati na? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.12",
            "verseOrgIds": [
              "1CO.5.12"
            ]
