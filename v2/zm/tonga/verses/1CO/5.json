                  "text": "2 Tes 3:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndakamulembela mulugwalo lwangu kuti mutavwelani abasibwaamu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.9",
            "verseOrgIds": [
              "1CO.5.9"
            ]
          }
        },
        {
