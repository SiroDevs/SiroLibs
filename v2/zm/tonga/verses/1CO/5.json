                "loc": "2JN.1.10"
              },
              "items": [
                {
                  "text": "2 Joh 1:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ngindemba lino ngaaya. Kuti kuli muntu naba umwi uuambwa kuti sibunyina bwa-Kristo, pele uli sibwaamu na sikulikumbuzya na sikukomba mituni na simatusi na mukolwi na silunyanzyo, mutavwelani ayooyo pe nikuba kulya awe, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.11",
            "verseOrgIds": [
              "1CO.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
