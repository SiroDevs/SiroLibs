                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi imwi impuwo iigambya njeeyi, yakuti kuli bwaamu akati kanu, nkabela obu bwaamu taakwe cintu cili mbuli mbubo cibonwa nikuba kubahedeni, nkaambo umwi muntu ulikwete mukawisi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.1",
            "verseOrgIds": [
              "1CO.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele inywe mulalisumpula na? Anukuti mwaleelede kulila, kuti oyo simalweza atandwe akati kanu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.2",
            "verseOrgIds": [
              "1CO.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.2.5"
              },
              "items": [
                {
                  "text": "Kol 2:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo mebo nentali anywe kumubili, moyo wangu waliko, nkabela aboobo ndamubeteka kale oyo iwakacita obo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.3",
            "verseOrgIds": [
              "1CO.5.3"
            ]
          }
        },
        {
