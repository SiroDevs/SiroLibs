              "items": [
                {
                  "text": "2 Kor 13:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndabeteka kale muzina lya-Mwami wesu Jesu Kristo, nkaambo moyo wangu waliswaangene antoomwe andinywe anguzu zya-Mwami wesu Jesu Kristo, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.4",
            "verseOrgIds": [
              "1CO.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
