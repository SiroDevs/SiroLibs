              "items": [
                {
                  "text": "1 Pet 4:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kuti oyo simalweza uleelede kwaabwa mumaanza aa-Saatani, kuti nyama inyonyoonwe, amuuya wakwe ufutuke mubuzuba bwa-Mwami Jesu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.5",
            "verseOrgIds": [
              "1CO.5.5"
            ]
          }
