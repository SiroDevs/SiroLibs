                "loc": "EPH.4.14"
              },
              "items": [
                {
                  "text": "Ef 4:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.3.12"
              },
              "items": [
                {
                  "text": "Flp 3:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.3.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nubakwesu, mutabi mbuli bana kumakani aabusongo. Kumakani aabubi amube bacece buyo, pele kumakani aabusongo amube bazonokede. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.20",
            "verseOrgIds": [
              "1CO.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.28.11+ISA.28.12"
              },
              "items": [
                {
                  "text": "Is 28:11-12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.49"
              },
              "items": [
                {
                  "text": "Dt 28:49",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kulilembedwe mubbuku lya-Mulao kuti, Bantu aba nzoobaambila amyaambo imbi amilomo imbi, nekubaboobo tabakoozoondiswiilila pe. Mbuboobo mbwaamba Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.21",
            "verseOrgIds": [
              "1CO.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aboobo, eyi myaambo imbi tiili citondezyo kulibaabo bazumina pe, pele kulibaabo batazumini. Anukuti businsimi tabweensi bwabaabo batazumini pe, mbubwabaabo bazumina, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.22",
            "verseOrgIds": [
              "1CO.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.2.13"
              },
              "items": [
                {
                  "text": "Inc 2:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino kuti imbungano yanu yoonse yabungana antoomwe, nkabela boonse buyo balaamba myaambo imbi, elyo kulanjila bamwi bataiyide nanka bamwi batazumini, sa tabakonzyi kwaamba kuti mwasondoka na? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.23",
            "verseOrgIds": [
              "1CO.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.4.13"
              },
              "items": [
                {
                  "text": "Inc 4:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele kuti boonse balasinsima, elyo kulanjila umwi uutaiyide nanka umwi uutazumini, ncobeni oyo muntu ulayaswa mumoyo kuliboonse, ulalingulwa kuliboonse. ",
