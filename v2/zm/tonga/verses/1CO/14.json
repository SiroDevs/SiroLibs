        },
        {
          "text": "Banakazi baumune mumbungano, nkaambo balo tabazumizigwi kwaamba, Balibombye buyo, mbuli mbuwaamba Mulao. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.34",
