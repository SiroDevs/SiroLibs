          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuti balayanda kwiiya makani, babuzye baalumi babo beni kuŋanda, nkaambo masampu kuti banakazi baamba mumbungano.",
          "type": "text",
