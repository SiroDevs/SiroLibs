          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwanooli baambya myaambo imbi, abo baamba babe bobile nanka kutainda batatu, alimwi baambe omwe omwe, nkabela akube umwi uupandulula, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.27",
            "verseOrgIds": [
