            "verseId": "1CO.14.1",
            "verseOrgIds": [
              "1CO.14.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.12.10"
              },
              "items": [
                {
                  "text": "1 Kor 12:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.12.31"
              },
              "items": [
                {
                  "text": "31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amutobele luyandisyo, alimwi amupangike myoyo yanu kuzipego zya-Muuya, pele kwiinda zyoonse kubusinsimi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.1",
            "verseOrgIds": [
              "1CO.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo sikwaamba myaambo, teensi bantu mbaambila pe, ulaambila Leza luzutu, nkaambo taakwe muntu uumvwa, ulaamba makani aasisidwe aa-Muuya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.2",
            "verseOrgIds": [
              "1CO.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele oyo uusinsima ulaambila bantu majwi aayaka aakusenengezya akusoozya, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.3",
            "verseOrgIds": [
              "1CO.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo uuamba myaambo ulaliyaka mwini buyo, pele oyo uusinsima ulayaka basimbunganonyina, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.4",
            "verseOrgIds": [
              "1CO.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.11.29"
              },
              "items": [
                {
                  "text": "My 11:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino ndayanda kuti nyoonse buyo mwaambye myaambo, pele cintu ncinjanda cakwiinda ncakuti musinsime. Nkaambo oyo uusinsima ulainda sikwaamba myaambo, cita apandulule, kuti babe abuyake abalo basimbungano.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.5",
            "verseOrgIds": [
              "1CO.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.5",
            "verseOrgIds": [
              "1CO.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino kuciindi ecino, nubakwesu, kuti ndeza kulindinywe kuza bwaamba myaambo, nkamugwasye buti, cita ndamwaambila ciyubunuzyo nanka luzibo nanka lusinsimo nanka lwiiyo? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.6",
            "verseOrgIds": [
              "1CO.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azyalo zintu zilila, mbuli nyeele nanka kantimbwa, kuti tazipambukanyi kabotu indilo zyazyo, ino kulazibwa buti kuti ncinzi eco cisibwa nanka cuumwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.7",
            "verseOrgIds": [
              "1CO.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mweembo wanoolila cakutamvwisigwa nguni uunga ulalibambila inkondo? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.8",
            "verseOrgIds": [
              "1CO.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbukubede kulindinywe anywebo. Indimi zyanu zyatanooamba majwi aaswiililika, ino kulazibwa buti kuti makaninzi aambwa? Mulaba anga mwaambila muuwo buyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.9",
            "verseOrgIds": [
              "1CO.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbubonya obo nkwiili myaambo yamisyobo misyobo ansi ano, nkabela taakwe uutaswiililiki, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.10",
            "verseOrgIds": [
              "1CO.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "pele kuti nsimvwisyi mwaambo mbuubede, elyo mumeso aasikwaamba ndaba mbuli ubwelebweza buyo, alakwe sikwaamba ulaba ubwelebweza buyo kulindime, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.11",
            "verseOrgIds": [
              "1CO.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino anywebo, mbuli mbumusungwaala kunjilwa myuuya, amupangike myoyo yanu kuti mukainde kuya kana abasimbunganonyokwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.12",
            "verseOrgIds": [
              "1CO.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aboobo, oyo uuamba myaambo myaambo uleelede­ kukomba kuti apegwe bupanduluzi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.13",
            "verseOrgIds": [
              "1CO.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.13",
            "verseOrgIds": [
              "1CO.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kuti ndakomba mumwaambo umbi, lino muuya wangu ulakomba ncobeni, pele miyeeyo yangu tiigwasigwi pe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.14",
            "verseOrgIds": [
              "1CO.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.19"
              },
              "items": [
                {
                  "text": "Ef 5:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino nkutyeni? Nookomba kumuuya, pele nookomba kumiyeeyo yangu ayalo. Nooimba kumuuya, pele nooimba kumiyeeyo yangu ayalo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.15",
            "verseOrgIds": [
              "1CO.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwataba boobo, kuti kolumba Leza kumuuya, ino oyo uutaiyide ulakonzya buti kuzuminina kulumba kwako kuti Ameni? Nkaambo tezi mboamba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.16",
            "verseOrgIds": [
              "1CO.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Webo ulalumba kabotu, nekubaboobo walo tayakwi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.17",
            "verseOrgIds": [
              "1CO.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalumba Leza kuti ndamwiinda nyoonse kukwaamba myaambo, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.18",
            "verseOrgIds": [
              "1CO.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "pele mumbungano cilandibotela kuti nkaambe majwi naba osanwe amiyeeyo yangu, kuti nkaiisye beenzuma, kwiinda kwaamba majwi aali zyuulu zili ikumi mumwaambo umbi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.19",
            "verseOrgIds": [
              "1CO.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
