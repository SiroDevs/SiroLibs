              "items": [
                {
                  "text": "Inc 17:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abalo basinsimi baambe bobile na botatwe, nkabela bamwi babuzyanye makani aambwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.29",
            "verseOrgIds": [
              "1CO.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CO 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwi uukede aakuyubunwidwa makani, elyo oyo uuli mukwaamba aumune. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.30",
            "verseOrgIds": [
              "1CO.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CO 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo mulakonzya kusinsima nyoonse omwe omwe, kuti boonse baiye akuyumizigwa mumoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.31",
            "verseOrgIds": [
              "1CO.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CO 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myuuya yabasinsimi ilakonzya kweendelezegwa kubasinsimi beni, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.32",
            "verseOrgIds": [
              "1CO.14.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CO 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "ikuti Leza tali Leza walupilingano pe, ngwaluumuno. Mbukubede mumbungano zyoonse zyabasalali.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.33",
            "verseOrgIds": [
