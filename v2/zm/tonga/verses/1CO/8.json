                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino ngaaya makani aanyama iipaizigwa mituni, Tulizi kuti toonse tuli aluzibo, Luzibo lulatukumusya, pele luyandano lulayaka. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.1",
            "verseOrgIds": [
              "1CO.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.6.3"
              },
              "items": [
                {
                  "text": "Gal 6:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Muntu anooyeeya kuti ndezi makani, oyo muntu tana kuziba cintu niciba comwe mbweelede, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.2",
            "verseOrgIds": [
              "1CO.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.4.9"
              },
              "items": [
                {
                  "text": "Gal 4:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele muntu aakuyanda Leza, oyu muntu ulazibwa nguwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.3",
            "verseOrgIds": [
              "1CO.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.10.19"
              },
              "items": [
                {
                  "text": "1 Kor 10:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.6.4"
              },
              "items": [
                {
                  "text": "Dt 6:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbubo, atubone mbwaabede aya makani aazilyo zipaizigwa mituni, Tulizi kuti taakwe mutuni naba omwe munyika yoonse, alimwi kuti taakwe Leza pele omwe buyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.4",
            "verseOrgIds": [
              "1CO.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.82.6"
              },
              "items": [
                {
                  "text": "Int 82:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.10.34"
              },
              "items": [
                {
                  "text": "Joh 10:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo nikuba kuti nkubali baambwa baleza, nikuba kujulu naaba ansi, ee, mbanji-banji baleza abami, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.5",
            "verseOrgIds": [
              "1CO.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.2.10"
              },
              "items": [
                {
                  "text": "Mal 2:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.1.16"
              },
              "items": [
                {
                  "text": "Kol 1:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.12.5"
              },
              "items": [
                {
                  "text": "1 Kor 12:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.12.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nekubaboobo kulindiswe kuli Leza omwe buyo, Taateesu, nguzyazwida zintu zyoonse, ngutuponena aswebo, Alimwi kuli Mwami omwe Jesu Kristo, nguzyakalengesegwa zintu zyoonse, aswebo twakalengesegwa mulinguwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.6",
            "verseOrgIds": [
              "1CO.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.10.27"
              },
              "items": [
                {
                  "text": "1 Kor 10:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele teensi boonse bajisi luzibo olu. Bamwi, mbubakazibila mituni kusikila sunu, bacilya zilyo ezyo cakuyeeya kuti ncakusinizya nzizyakapaizigwa mituni, nkabela manjezeezya aabo, mbwaakompeme, alasofwaazigwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.7",
            "verseOrgIds": [
              "1CO.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.14.17"
              },
              "items": [
                {
                  "text": "Rom 14:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele teensi zilyo zitusisya kwa-Leza, Na tatulyi tatusweekelwi cintu, na twalya tatugwasigwi cintu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.8",
            "verseOrgIds": [
              "1CO.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.5.13"
              },
              "items": [
                {
                  "text": "Gal 5:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nekubaboobo amucenjele kuti obu bwami bwanu butabi cifumpuzyo kubakompeme. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.9",
            "verseOrgIds": [
              "1CO.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kuti muntu akubona, webo ojisi luzibo, ulikede mukulya muŋanda yamituni, sa manjezeezya aakwe taakooyooyumizigwa kukulya zipaizigwa mituni? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.10",
            "verseOrgIds": [
              "1CO.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.14.15"
              },
              "items": [
                {
                  "text": "Rom 14:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aboobo, kuluzibo lwako ulanyonyausigwa oyo sibunyina uukompeme ngwaakafwida Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.11",
            "verseOrgIds": [
              "1CO.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino ciindi ncimubisizya boobo babunyina, akuuma-uma manjezeezya aabo aakompeme, muli mukubisizya Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.12",
            "verseOrgIds": [
              "1CO.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.14.21"
              },
              "items": [
                {
                  "text": "Rom 14:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kaako, kuti zilyo zilalebya mukwesu, nsikooyoolya limbi eyo nyama lyoonse, kuti entakalebyi mukwesu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.13",
            "verseOrgIds": [
              "1CO.8.13"
            ]
          }
        }
      ]
