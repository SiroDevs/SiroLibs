            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zintu zyoonse zilazuminika kulindime, nekubaboobo teensi zyoonse zigwasya. Zintu zyoonse zilazuminika, nekubaboobo nsiyandi kutolwa kubuzike bwacintu niciba cimwi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.12",
            "verseOrgIds": [
              "1CO.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 6:13"
          },
          "items": [
            {
