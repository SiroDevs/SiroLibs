                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele oyo uujatana a-Mwami waba omwe anguwe ku-Muuya, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.17",
            "verseOrgIds": [
