          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.4.3+1TH.4.4+1TH.4.5"
              },
              "items": [
                {
                  "text": "1 Tes 4:3-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Zilyo nzyada, alyalo ida ndyazilyo, pele Leza uyoozilobya zyoonse zyobile. Lino mubili tuuli wabwaamu pe, ngwa-Mwami, alakwe Mwami ngwamubili. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.13",
            "verseOrgIds": [
              "1CO.6.13"
            ]
          }
        },
        {
