                {
                  "text": "Rom 8:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Leza, iwakabusya Mwami, uyootubusya aswebo kunguzu zyakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.14",
            "verseOrgIds": [
              "1CO.6.14"
            ]
