          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.3.3+TIT.3.4+TIT.3.5+TIT.3.6+TIT.3.7"
              },
              "items": [
                {
                  "text": "Tit 3:3-7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino mbuboobo mbubakabede kale bamwi akati kandinywe, pele sunu mulisanzizidwe, mulisalazizidwe, mulilulamikidwe muzina lya-Mwami Jesu Kristo aku-Muuya wa-Leza wesu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.11",
            "verseOrgIds": [
              "1CO.6.11"
            ]
          }
        }
