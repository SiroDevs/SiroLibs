              },
              "items": [
                {
                  "text": "1 Kor 12:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sa tamuzi kuti mibili yanu nzezizo zya-Kristo Lino sa ndakonzya kunyanzya zizo zya-Kristo, zibe zizo zyasibwaamu? Ne! Kutabi boobo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.15",
            "verseOrgIds": [
              "1CO.6.15"
            ]
          }
        },
        {
          "name": "verse",
