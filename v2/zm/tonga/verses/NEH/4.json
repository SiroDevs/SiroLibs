            "number": "6",
            "style": "v",
            "sid": "NEH 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo twakayaka bulambo. Nkabela bulambo boonse bwakamana mane kusikila akatikati, nkaambo bantu bakapangika myoyo yabo kumilimo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.6",
            "verseOrgIds": [
              "NEH.4.6"
            ]
          }
        }
