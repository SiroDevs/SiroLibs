        {
          "text": "Utavumbi milandu yabo, azyalo zibi zyabo zitazizyanisigwi kumeso aako. Nkaambo bakukalazya kumeso aabasikuyaka, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.5",
            "verseOrgIds": [
