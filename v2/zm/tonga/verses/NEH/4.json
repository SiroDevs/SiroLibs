        },
        {
          "text": "Lino Sanibalati naakamvwa kuti tuli mukuyaka bulambo, wakakalala, wanyema loko, wasampaula ba-Juda, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.1",
