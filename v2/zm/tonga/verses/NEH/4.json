        },
        {
          "text": "Nkabela bakavwiya boonse antoomwe kuza kuzoolwisya Jerusalemu akulesya milimo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.8",
            "verseOrgIds": [
