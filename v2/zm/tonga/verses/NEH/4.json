              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele Sanibalati a-Tobiya aba-Arabu aba-Amoni aba-Asidodi, nibakamvwa kuti malambo aa-Jerusalemu ali mukuyakwa, alimwi atalika kumamikwa nkwaakamwayidwe, bakanyema loko. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.7",
            "verseOrgIds": [
              "NEH.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
