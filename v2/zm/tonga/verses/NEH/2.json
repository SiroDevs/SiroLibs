            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.15.13"
              },
              "items": [
                {
                  "text": "Tus 15:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino mwami wakandibuzya kuti, Ino nkaambonzi busyu bwako buli abuusu? Tociswi. Aya makani azwa mubuusu bwamoyo buyo. Mpawo ndakayoowa loko, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.2",
            "verseOrgIds": [
              "NEH.2.2"
            ]
          }
        },
