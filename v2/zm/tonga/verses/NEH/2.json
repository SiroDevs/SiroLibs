              "items": [
                {
                  "text": "Neh 3:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi ndakaya kunembo kusikila kumulyango wakasensa akukaziba kamwami, pele katakwe busena munyama ngundakatantide nkwaakakonzya kwiinda. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.14",
            "verseOrgIds": [
              "NEH.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
