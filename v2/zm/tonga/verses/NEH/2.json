            "number": "12",
            "style": "v",
            "sid": "NEH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino ndakanyampuka masiku, mebo abantu bace mbundakali abo. Teendakalwiida muntu naba omwe makani Leza wangu ngaakabikide mumoyo wangu, milimo njendakayanda kubeleka ku-Jerusalemu. Alimwi teendakajisi munyama naba omwe cita munyama ngundakatantide alinguwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.12",
            "verseOrgIds": [
              "NEH.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 2:13"
          },
          "items": [
