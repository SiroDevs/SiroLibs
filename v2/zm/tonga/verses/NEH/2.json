        },
        {
          "text": "Mumwezi wa-Nisani mumwaka wamakumi obile wamwami Aritasasta, waini wakali kunywigwa kulinguwe, pawo ndakabweza waini, ndapa mwami, Nkabela ciindi cakamana teendakazibilide kuusa kubusyu bwamwami. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.1",
            "verseOrgIds": [
              "NEH.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 2:2"
          },
          "items": [
