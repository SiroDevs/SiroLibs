          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino ndakasika kubeendelezi bakutala lyamulonga, ndabapa magwalo aazwa kumwami. Nkabela mwami wakalitumide basilutwe bampi abasimabbiza, kuti njeende abo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.9",
            "verseOrgIds": [
              "NEH.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Sanibalati mu-Horoni a-Tobiya muzike mu-Amoni nibakamvwa, bakabijilwa loko kuswiilila kuti kwasika muntu uuyanda kugwasya bana ba-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.10",
            "verseOrgIds": [
              "NEH.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.8.32"
              },
              "items": [
                {
                  "text": "Ezr 8:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela nindakasika ku-Jerusalemu­, ndakakala nkuko mazuba otatwe.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.11",
            "verseOrgIds": [
              "NEH.2.11"
            ]
          }
        }
      ]
