              "items": [
                {
                  "text": "Joh 18:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo ndakainda kukalonga ciindi camasiku, ndaakulingula bulambo, mane lumwi ndakapiluka, ndanjila kumulyango wakuti, ndaboola. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.15",
            "verseOrgIds": [
              "NEH.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele beendelezi teebakaziba nkundakaya na ncindakacita. Abalo ba-Juda abapaizi abasilutwe abeendelezi abamwi ibakali kucita milimo, taakwe naba omwe ngundakalwiida makani kuciindi eco.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.16",
            "verseOrgIds": [
              "NEH.2.16"
            ]
