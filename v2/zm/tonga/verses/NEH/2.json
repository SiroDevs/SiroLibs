              "type": "tag",
              "attrs": {
                "loc": "JER.5.10"
              },
              "items": [
                {
                  "text": "Jer 5:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela ndakazwa masiku kumulyango wakuti kunembo lyamukalo wabasikazwa, ndasika kumulyango wabufumba. Ndakalingula malambo aa-Jerusalemu aamwayidwe, amilyango yawo iipiide mulilo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.13",
            "verseOrgIds": [
              "NEH.2.13"
            ]
          }
        },
        {
