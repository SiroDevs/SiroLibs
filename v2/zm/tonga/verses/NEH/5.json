        },
        {
          "text": "Bamwi bakati, Iswe, bana besu balombe abana besu basimbi mbanji. Tulababwezela maila, kuti tulye akupona, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.2",
            "verseOrgIds": [
              "NEH.5.2"
            ]
