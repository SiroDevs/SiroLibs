            "number": "3",
            "style": "v",
            "sid": "NEH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abamwi bakati, Myuunda yesu amyuunda yesu yamisaansa amaanda esu, zyoonse twazyaaba kuti tujane maila nkaambo kanzala, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.3",
            "verseOrgIds": [
              "NEH.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abamwi bakati, Twapa myuunda yesu amyuunda yesu yamasaansa, ibe zikoloto zyakuliya mutelo wamwami.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.4",
            "verseOrgIds": [
              "NEH.5.4"
            ]
          }
        }
