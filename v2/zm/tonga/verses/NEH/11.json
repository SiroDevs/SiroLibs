        },
        {
          "text": "Lino basilutwe babantu bakakala mu-Jerusalemu, Nkabela bantu bamwi bakawaala zisolo zyakusala muntu umwi aumwi akati kakumi kuti azookale mu-Jerusalemu munzi uusalala, bamwi bali musanu abane bakale muminzi Imwi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.1",
            "verseOrgIds": [
              "NEH.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 11:2"
          },
          "items": [
