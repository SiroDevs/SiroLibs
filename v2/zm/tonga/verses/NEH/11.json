        },
        {
          "text": "Lino mbaaba basilutwe bacisi ibakakala mu-Jerusalemu. Pele muminzi ya-Juda umwi aumwi wakalikede mucaabilo cakwe muminzi yabo, ba-Israyeli, bapaizi, ba-Levi, ba-Netinimu, abana babazike ba-Solomoni. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.3",
            "verseOrgIds": [
              "NEH.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.9.3"
              },
              "items": [
                {
                  "text": "1 Mak 9:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.38.29"
              },
              "items": [
                {
                  "text": "Matl 38:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amu-Jerusalemu mwakakala bamwi babana ba-Juda abana ba-Benjamini, Bana ba-Juda mbaaba: Ataya mwana waUziya mwana wa-Zekariya mwana wa-Amariya mwana wa-Sefatiya mwana wa-Mahalaleli, umwi wabana ba-Perezi, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.4",
            "verseOrgIds": [
              "NEH.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "a-Maaseya mwana wa-Baruki mwana wa-Koli-hoze mwana wa-Hazaya mwana wa-Adaya mwana waJoyaribu mwana wa-Zekariya mwana wamuntu waku-Siloni. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.5",
            "verseOrgIds": [
              "NEH.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boonse bana ba-Perezi ibakakede mu-Jerusalemu bakali myanda yone amakumi aali musanu alimwi amusanu abatatu, basilumamba. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.6",
            "verseOrgIds": [
              "NEH.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana ba-Benjamini mbaaba. Salu mwana wa-Mesulamu mwana wa-Joedi mwana wa-Pedaya mwana wa-Kolaya mwana wa-Maaseya mwana wa-Itiyeli mwana wa-Jesaya, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.7",
            "verseOrgIds": [
              "NEH.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "abakwabo Gabai a-Salai, Boonse bana ba-Benjamini bakali myanda iili musanu aine amakumi obile amusanu abatatu, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.8",
            "verseOrgIds": [
              "NEH.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joeli mwana wa-Zikiri kali silutwe wabo, a-Juda mwana wa-Hasenuwa kali silutwe wabili wamunzi, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.9",
            "verseOrgIds": [
              "NEH.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.9.10"
              },
              "items": [
                {
                  "text": "1 Mak 9:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abapaizi mbaaba: Jedaya mwana wa-Joyaribu, Jakini, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.10",
            "verseOrgIds": [
              "NEH.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seraya mwana wa-Hilikiya mwana wa-Mesulamu mwana wa-Zadoki mwana wa-Merayoti mwana wa-Ahitubu silutwe waŋanda ya-Leza, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.11",
            "verseOrgIds": [
              "NEH.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "abanyina ibakabeleka milimo yaŋanda, bantu bali myanda iili musanu aitatu amakumi obile ababili; a-Adaya mwana wa-Jerohamu mwana wa-Pelaliya mwana wa-Amzi mwana wa-Zekariya mwana wa-Pasuri mwana wa-Malikiya, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.12",
            "verseOrgIds": [
              "NEH.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "abanyina, basilutwe banzubo, bantu bali myanda yobile amakumi one ababili; a-Amasisai mwana wa-Azareli mwana wa-Ahizai mwana wa-Mesilemoti mwana wa-Imeri, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.13",
            "verseOrgIds": [
              "NEH.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "abakwabo, basilumamba basinguzu, bantu bali mwanda amakumi obile amusanu abatatu. Silutwe wabo kali Zabidiyeli mwana wa-Hagedolimu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.14",
            "verseOrgIds": [
              "NEH.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba-Levi mbaaba: Semaya mwana wa-Hasubu mwana wa-Azirikamu mwana wa-Hasabiya mwana wa-Buni, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.15",
            "verseOrgIds": [
              "NEH.11.15"
            ]
          }
        },
