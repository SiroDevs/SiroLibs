                "loc": "JDG.5.9"
              },
              "items": [
                {
                  "text": "Bab 5:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela bantu bakalumba boonse ibakazumina amyoyo yabo beni kukala mu-Jerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.2",
            "verseOrgIds": [
              "NEH.11.2"
            ]
          }
        },
