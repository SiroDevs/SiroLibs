        },
        {
          "text": "Mpawo Ezara wakalumba Jehova Leza mupati, nkabela bantu boonse bakavuwa kuti, Ameni, Ameni, cakunyamuna maanza aabo. Lino bakakotamina Jehova akumukomba cakuvundama ansi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.6",
            "verseOrgIds": [
              "NEH.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
