              "items": [
                {
                  "text": "Lev 10:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abalo ba-Jeshua a-Bani a-Serebiya a-Jamini a-Akubu a-Sabetai a-Hodiya a-Maaseya a-Kelita a-Azariya a-Jozabadi a-Hanani a-Pelaya aba-Levi mbobakapandulwida bantu mulao, nkabela bantu bakaima amwi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.7",
            "verseOrgIds": [
              "NEH.8.7"
            ]
          }
        },
