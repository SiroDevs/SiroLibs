            }
          ]
        },
        {
          "text": "Elyo wakabaambila kuti, Kamuya, mukalye zilyo zili amafuta akunywa bunono akutuma zipo kumuntu kufumbwa uutana kubambilwa, nkaambo buzuba obuno mbuzuba busalalisya bwa-Mwami wesu. Mutausi pe, nkaambo lukondo lwa-Jehova ndolumupa inguzu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.10",
            "verseOrgIds": [
              "NEH.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuboobo ba-Levi mbubakaumuzya bantu boonse. Bakati, Amuumune, nkaambo buzuba obuno mbuzuba busalalisya. Mutausi pe, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.11",
            "verseOrgIds": [
              "NEH.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo bantu boonse bakainka kukulya akukunywa akukupana zipo akukusekelela loko, nkaambo bakalimvwide majwi aamulao ngebakalwiidwa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.12",
            "verseOrgIds": [
              "NEH.8.12"
            ]
          }
        }
      ]
    },
