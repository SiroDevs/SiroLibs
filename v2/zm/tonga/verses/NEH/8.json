        },
        {
          "text": "Lino Ezara wakavununa ibbuku mumeso aabantu boonse, (nkaambo kali ajulu lyabantu boonse), nkabela naakalivununa, bantu boonse bakanyampuka. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.5",
            "verseOrgIds": [
