        },
        {
          "text": "Pele mulyango wanswi, bana ba-Hasenaya mbobakauyaka. Bakabika zisamu zyawo akwiimika zitendele zyawo azijaluzyo zyawo aminkulu yawo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.3",
            "verseOrgIds": [
              "NEH.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubbazu lyabo Meremoti mwana wa-Uriya mwana wa-Kozi wakamamika. Kubbazu lyabo Mesulamu mwana wa-Berekiya mwana wa-Mesezabele wakamamika, Kubbazu lyabo Zadoki mwana wa-Banna wakamamika. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.4",
            "verseOrgIds": [
              "NEH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 3:5"
          },
          "items": [
