            }
          ]
        },
        {
          "text": "Kubbazu lyabo Melatiya mu-Gibeoni wakamamika, a-Jadoni mu-Meronoti, abantu ba-Gibeoni aba-Mizipa, mane kusikila kucuuno cabwami bwamweendelezi wakookuno kutala lyamulonga. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.7",
            "verseOrgIds": [
              "NEH.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
