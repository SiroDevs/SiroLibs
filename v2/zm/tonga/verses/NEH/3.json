              },
              "items": [
                {
                  "text": "Bab 5:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kubbazu lyabo ba-Tekowa bakamamika. Pele bapati babo teebakabika moyo woonse kumilimo ya-Mwami wabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.5",
            "verseOrgIds": [
              "NEH.3.5"
            ]
          }
        },
        {
