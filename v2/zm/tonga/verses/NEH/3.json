                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Acaabilo cabili, Malikiya mwana wa-Harimu a-Hasubu mwana wa-Pahati-Moabu mbobakacimamika, aŋanda indamfu yaziko. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.11",
