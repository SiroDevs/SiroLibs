              "items": [
                {
                  "text": "Neh 12:38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kubbazu lyakwe Uzieli mwana wa-Harehaya, umwi wabafuzi bangolida wakamamika, Kubbazu lyakwe Hananiya mwana waumwi wabaŋanga wakamamika, Bakayakulula Jerusalemu mane kusikila kumulyango uukwazeme. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.8",
            "verseOrgIds": [
              "NEH.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubbazu lyabo Refaya mwana wa-Huri, mweendelezi wacipanzi cimwi ca-Jerusalemu, wakamamika. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.9",
            "verseOrgIds": [
