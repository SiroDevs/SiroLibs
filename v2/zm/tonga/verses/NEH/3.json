        },
        {
          "text": "Kubbazu lyakwe bantu ba-Jeriko bakayaka. Kubbazu lyabo Zakuri mwana wa-lmiri wakayaka. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.2",
