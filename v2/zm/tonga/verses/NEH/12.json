              },
              "items": [
                {
                  "text": "Lk 1:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ido, Ginetoni, Abija, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.4",
            "verseOrgIds": [
              "NEH.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
