                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbaaba bapaizi aba-Levi ibakeza a-Zerubabeli mwana wa-Sealitiyeli a-Jeshua: Seraya, Jeremiya, Ezara, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.1",
