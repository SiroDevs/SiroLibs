                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.3.1"
              },
              "items": [
                {
                  "text": "Zek 3:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Salu, Amoki, Hilikiya, Jedaya. Mbaabo basilutwe babapaizi abakwabo mumazuba aa-Jeshua, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.7",
            "verseOrgIds": [
              "NEH.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.16.8"
              },
              "items": [
                {
                  "text": "1 Mak 16:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.16.41"
              },
              "items": [
                {
                  "text": "41",
