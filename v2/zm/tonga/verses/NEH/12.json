            "number": "5",
            "style": "v",
            "sid": "NEH 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miyamini, Maadiya, Biliga, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.5",
            "verseOrgIds": [
              "NEH.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Semaya, Joyaribu, Jedaya, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.6",
            "verseOrgIds": [
              "NEH.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAG.1.1"
              },
              "items": [
                {
                  "text": "Hag 1:1",
