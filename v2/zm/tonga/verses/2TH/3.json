                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Taakwe nitwakali kulya buyo insima zya bantu, pele twakali kubeleka akoonda milimo lyoonse, isikati amasiku, kuti tutalemeni muntu naba omwe akati kanu, ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.8",
            "verseOrgIds": [
              "2TH.3.8"
            ]
          }
        },
        {
