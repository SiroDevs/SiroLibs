                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo notwakacili akati kanu twakamupa mulazyo oyu wakuti, Na kuli uukaka kubeleka, atabi nalya. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.10",
            "verseOrgIds": [
              "2TH.3.10"
