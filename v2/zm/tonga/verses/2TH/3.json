                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anukuti tulaswiilila kuti nkubali bamwi akati kanu beenda cakupilingana. Tabamani milimo, pe, pele mbasyandyaabantu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.11",
            "verseOrgIds": [
