              },
              "items": [
                {
                  "text": "1:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo nywebo nobeni mulizi mbomweelede kututobela, ikuti nitwakakede kulindinywe ziyanza zyesu teezyakapilingene pe. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.7",
