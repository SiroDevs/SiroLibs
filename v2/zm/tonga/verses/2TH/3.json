                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Takweensi kwaamba kuti tatujisi bwami bwakucitilwa obo, pele nkokuti tulicite ceelesyo canu, kuti mukatutobele. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.9",
            "verseOrgIds": [
              "2TH.3.9"
            ]
          }
        },
