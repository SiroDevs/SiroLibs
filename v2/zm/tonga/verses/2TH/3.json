                  "text": "1 Tes 4:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino bantu bali boobo twabalailila akubakombelezya mu-Mwami Jesu Kristo, kuti babeleke milimo yabo caluumuno, balye insima zyabo beni,",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.12",
