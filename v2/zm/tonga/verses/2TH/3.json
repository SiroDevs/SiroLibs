                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na mpali muntu uutaswiilili makani ngotwalemba mulugwalo oluno, amumusale, mutavwelani awe, kuti ause bweeme, ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.14",
