              },
              "items": [
                {
                  "text": "1 Tes 5:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwami nguusyomeka, nkabela nguwe nguuti muyumye akumukwabilila kumubi. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.3",
            "verseOrgIds": [
              "2TH.3.3"
            ]
