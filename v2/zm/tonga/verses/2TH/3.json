              },
              "items": [
                {
                  "text": "2 Kor 7:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi tulasyoma ndinywe mu-Mwami, tulasyoma kuti mulacita akunooya bucita nzotwamulailila. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.4",
            "verseOrgIds": [
              "2TH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Mwami aenzye myoyo yanu, injile muluyando lwa-Leza amulukakatilo lwa-Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.5",
            "verseOrgIds": [
              "2TH.3.5"
            ]
          }
        }
