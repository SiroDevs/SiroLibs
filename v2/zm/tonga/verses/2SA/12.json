          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo joabu wakatuma batumwa kuli-Davida, wakati, Ndalwana a-Raba, alimwi ndausaala munzi wamaanzi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.27",
            "verseOrgIds": [
              "2SA.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino webo kobunganya boonse bantu basyeede, uze kuzoozyunguluka munzi akuuzunda, kuti utazundwi kumaanza aangu akubandwa izina lyangu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.28",
            "verseOrgIds": [
              "2SA.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo Davida wakabunganya bantu boonse, wakainka ku-Raba, wakalwana amunzi akuuzunda. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.29",
            "verseOrgIds": [
              "2SA.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
