            "number": "8",
            "style": "v",
            "sid": "2SA 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela ndakakupa iŋanda yasimalelaako, abalo banakazi basimalelaako ndakabakumbatanya ayebo. Ndakakupa luzubo lwa-Israyeli alwa-Juda, alimwi eci coonse nicakakuceela, nindakakupa azimwi zintu zili boobo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.8",
            "verseOrgIds": [
              "2SA.12.8"
            ]
          }
        },
