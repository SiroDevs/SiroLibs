                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Natani wakaambila Davida kuti, Nduwe omwini. Mbuboobu mbwaamba Jehova Leza wa-Israyeli, Ndakakunanika kuti ube mwami wa-Israyeli akukuvuna kuzwa kumaanza aa-Saulo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.7",
            "verseOrgIds": [
              "2SA.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
