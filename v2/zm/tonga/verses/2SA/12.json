                  "text": "2 Sam 11:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kako ipanga talikonzyi kuleka kukataazya mukowa wako mazuba oonse, nkaambo wandisampaula akutola muka-Uriya mu-Hiti abe mukako. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.10",
            "verseOrgIds": [
              "2SA.12.10"
            ]
          }
        },
