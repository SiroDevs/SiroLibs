        },
        {
          "text": "Mbuboobu mbwaamba Jehova. Langa! Ndakubusizya bubi buzwa muŋanda yako omwini. Njookunyanzya banakazi bako kumeso aako akubaabila mweenzinyoko, elyo uyoolalika banakazi bako izuba kalibala. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.11",
            "verseOrgIds": [
              "2SA.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cintu nciwakacita webo cakalisisidwe, pele eci cintu ncinti cite mebo ciyoocitwa kumeso aaba-Israyeli boonse azuba kalibala. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.12",
            "verseOrgIds": [
              "2SA.12.12"
            ]
          }
