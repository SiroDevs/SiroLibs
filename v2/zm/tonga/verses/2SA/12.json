                "loc": "1CH.20.2"
              },
              "items": [
                {
                  "text": "1 Mak 20:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela wakagwisya munsini wamwami kumutwe wakwe. Bulemu bwamunsini oyo kabuli mbuli italenta lyangolida, alimwi wakali amabwe mayandisi, elyo wakabikwa amutwe wa-Davida. Nkabela oko kumunzi bakanyanzya cisaalo cipati loko. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.30",
            "verseOrgIds": [
              "2SA.12.30"
            ]
          }
        },
        {
