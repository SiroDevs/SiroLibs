        },
        {
          "text": "Lino nkaambonzi nowasampaula ijwi lya-Jehova akucita bubi kumeso aangu? Uriya mu-Hiti wamujazya ipanga, amukakwe wamutola kulinduwe. Wamujazya ipanga lyabana-Amoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.9",
            "verseOrgIds": [
              "2SA.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
