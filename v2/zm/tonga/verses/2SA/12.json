              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakatuma kujanza lya-Natani musinsimi, akumuulika izina lya-Muyandwi-wa-Jehova, nkaambo ka-Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.25",
