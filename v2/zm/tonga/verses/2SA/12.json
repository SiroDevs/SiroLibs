                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Joabu wakalwana a-Raba mumi waba-Amoni, nkabela wakasaala munzi wamwami. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.26",
            "verseOrgIds": [
              "2SA.12.26"
            ]
          }
        },
        {
