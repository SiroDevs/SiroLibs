        },
        {
          "text": "Alimwi wakasaala ba-Moabu, nkabela wakabeeleka antambo, wakabalazika ansi, Wakeeleka milongo yobile kuti ijayigwe amulongo omwe kuti kaupona. Aboobo ba-Moabu bakaba bazike ba-Davida akuleta mutelo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.2",
            "verseOrgIds": [
              "2SA.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
