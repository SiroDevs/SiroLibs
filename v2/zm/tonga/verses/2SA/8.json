                "loc": "GEN.15.18"
              },
              "items": [
                {
                  "text": "Matl 15:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi Davida wakazunda Hadadezeri mwana wa-Rehobu, mwami wa-Zoba, naakali kuya kuyooboozya nyika yakwe yakulwizi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.3",
            "verseOrgIds": [
              "2SA.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Davida wakajata kulinguwe basimbizi bali cuulu amyaanda iili musanu aibili, abasikweenda amaulu bali zyuulu zili makumi obile, elyo Davida wakatyola mazwi aambizi, pele wakaleka imbizi zyanola zili mwaanda. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.4",
            "verseOrgIds": [
              "2SA.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo ba-Aramu baku-Damasko bakeza kuzoogwasya Hadadezeri mwami wa-Zoba, pele Davida wakajaya akati kaba-Aramu bantu bali zyuulu zili makumi obile azibili. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.5",
            "verseOrgIds": [
              "2SA.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Davida wakabika basilumamba mucisi ca-Aramu cakuDamasko, aboobo ba-Aramu bakaba bazike ba-Davida akumuliya mutelo. Nkabela Jehova wakazundya Davida koonse nkwaakaya. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.6",
            "verseOrgIds": [
              "2SA.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Davida wakabweza intobo zyangolida nzibakajisi balanda ba-Hadadezeri, wakazileta ku-Jerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.7",
            "verseOrgIds": [
              "2SA.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwalo ku-Beta aku-Berotai, minzi ya-Hadadezeri, Davida wakabweza mukuba munji loko.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.8",
            "verseOrgIds": [
              "2SA.8.8"
            ]
          }
        }
      ]
    },
