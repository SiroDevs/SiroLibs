            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Toi mwami wa-Hamati, naakamvwa Davida mbwaakakoma impi yoonse ya-Hadadezeri, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.9",
            "verseOrgIds": [
              "2SA.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakatuma mwanaakwe Joramu kumwami Davida, kuti akamujuzye akumusangalazya nkaambo kamakani aya aakulwana a-Hadadezeri akumuzunda, nkaambo kakuti Toi kajisi inkondo zinji nzyaakalwana a-Hadadezeri. Nkabela Joramu wakaletelezya zintu zyangolida azyansiliva azyamukuba, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.10",
            "verseOrgIds": [
              "2SA.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
