                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Davida wakalijanina impuwo naakaboola kuzwa kukukoma ba-Aramu mumumpata wa-Munyo naakajaya bantu bali zyuulu zili ikumi amusanu azitatu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.13",
            "verseOrgIds": [
              "2SA.8.13"
            ]
          }
        },
