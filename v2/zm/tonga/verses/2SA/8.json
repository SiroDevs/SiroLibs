                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "elyo zintu ezi azyalo mwami Davida wakazisalazizya Jehova, antoomwe angolida ansiliva nzyaakasalazya kuzisi zyoonse nzyaakakoma, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.11",
            "verseOrgIds": [
              "2SA.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ku-Aramu, aku-Moabu, akubana ba-Amoni, akubaFilisti akuba-Amaleki, azisaalo nzibakasaala kuli-Hadadezeri mwana, waRehobu mwami wa-Zoba. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.12",
            "verseOrgIds": [
              "2SA.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 8:13"
          },
          "items": [
