            }
          ]
        },
        {
          "text": "Nkabela Joabu mwana wa-Zeruya kali musololi wampi, a-Josafati mwana wa-Ahiludi nguwakali kulemba makani, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.16",
