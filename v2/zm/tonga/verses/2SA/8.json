              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuboobo Davida mbwaakaba abwami bwaba-Israyeli boonse, nkabela Davida wakali kubeteka bantu bakwe boonse cakululama. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.15",
            "verseOrgIds": [
