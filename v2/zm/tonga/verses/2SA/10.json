        },
        {
          "text": "Mpawo Hanuni wakabweza balanda ba-Davida akubanyoola cisela comwe cacilezu, alimwi wakabakosweda zikobela zyabo muzibunu, elyo wakabatanda, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.4",
            "verseOrgIds": [
              "2SA.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Davida naakaambilwa aya makani, wakatuma kuyoobacinga, nkaambo bantu bakafwa bweeme loko. Elyo mwami wakati, Kamulindila ku-Jeriko mane zilezu zyanu zikamene, elyo mulaboola,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.5",
            "verseOrgIds": [
              "2SA.10.5"
            ]
          }
        }
