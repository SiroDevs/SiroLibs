        },
        {
          "text": "Koliyumya, kuti tube abukozu bwakugwasya bantu besu aminzi ya-Leza wesu, Jehova acite kufumbwa cintu ncayanda. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.12",
            "verseOrgIds": [
              "2SA.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo Joabu abantu mbaakali abo bakaswena afwiifwi kuyoolwana aba-Aramu, nkabela ba-Aramu bakamucija. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.13",
            "verseOrgIds": [
              "2SA.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino ba-Amoni nibakabona kuti baAramu bacija, bakacija abalo kumunyina Abisai, bakanjila mumunzi. Elyo Joabu wakabweeda kuzwa kukulwana aba-Amoni, waakusika ku-Jerusalemu,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.14",
            "verseOrgIds": [
              "2SA.10.14"
            ]
          }
        }
      ]
    },
