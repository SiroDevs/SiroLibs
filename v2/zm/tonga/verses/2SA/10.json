        },
        {
          "text": "Lino nicakaba ciindi wakafwa mwami waba-Amoni, elyo Hanuni mwana wakwe wakalya izina lyakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.1",
            "verseOrgIds": [
              "2SA.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo Davida wakati, Hanuni mwana wa-Nahasi njoomucitila cabuuya, mbubonya mbuli wisi mbwaakandicitila cabuuya ambebo, Aboobo Davida wakatuma balanda bakwe kuyooumuzya moyo wakwe nkaambo kawisi. Lino balanda baDavida bakasika kucisi caba-Amoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.2",
            "verseOrgIds": [
              "2SA.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele bapati baba-Amoni bakaambila Hanuni mwami wabo kuti, Sa ulayeeya kuti nkaambo kakulemeka bauso Davida ncaakutumina basikukuumuzya? Sa Davida tabatumide aba balanda bakwe kuti bazoolange-lange munzi akubona mbuubede, kuti bausaale? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.3",
            "verseOrgIds": [
              "2SA.10.3"
            ]
          }
        },
        {
          "name": "verse",
