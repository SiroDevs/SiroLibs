              },
              "items": [
                {
                  "text": "2 Sam 19:26-27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo mwami wakabuzya kuti, Ino uli kuli mwana wasimalelaako? Nkabela Ziba wakaambila mwami kuti, Ncobeni ulikede mu-Jerusalemu, nkaambo wati, Sunu luzubo lwa-Israyeli lulandiboozezya bwami bwataata. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.3",
            "verseOrgIds": [
              "2SA.16.3"
            ]
          }
        },
