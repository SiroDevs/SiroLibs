              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Husai mu-Ariki mweenzinyina Davida, naakasika kuli-Abisalomu, wakamwaambila kuti, Apone mwami! Apone mwami! ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.16",
            "verseOrgIds": [
