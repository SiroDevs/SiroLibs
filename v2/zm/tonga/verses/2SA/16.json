                }
              ]
            }
          ]
        },
        {
          "text": "Ambweni Jehova ulabona mafwabi aangu akundiboozezya coolwe mubusena bwamatusi aakwe ngaandituka sunu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.12",
            "verseOrgIds": [
              "2SA.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Davida abantu bakwe kabaceenda munzila, nkabela Simeyi keenda mbubonya kumunkuni wacilundu, kaya butuka akufusa mabwe akuliyila lusuko. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.13",
            "verseOrgIds": [
              "2SA.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mwami abantu boonse mbaakali abo bakasika cakukataala ku­-Jordano, bakalyokezya nkuko.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.14",
            "verseOrgIds": [
              "2SA.16.14"
            ]
          }
        }
