          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela wakafusa Davida mabwe, abalanda bakwe boonse abantu boonse abasilumamba mbaakali abo kululyo akulumwensi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.6",
            "verseOrgIds": [
              "2SA.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuboobo mbwaakaamba Simeyi mukutuka kwakwe, Wakati, Zwa! Zwa! Uwe ootila bulowa! Uwe omwana wa-Saatani. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.7",
            "verseOrgIds": [
              "2SA.16.7"
            ]
          }
