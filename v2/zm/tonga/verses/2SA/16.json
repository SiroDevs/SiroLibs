        },
        {
          "text": "Lino Abisalomu abantu boonse ba-Israyeli bakasika ku-Jerusalemu, alakwe Ahitofeli kaliko. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.15",
