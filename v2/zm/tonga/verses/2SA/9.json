                  "text": "2 Sam 17:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo mwami wakabuzya kuti, Uli kuli? Lino Ziba wakavwiila mwami kuti, Nkwali kuŋanda ya-Makiri mwana wa-Amiyeli mumunzi wa-Lodebara. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.4",
            "verseOrgIds": [
              "2SA.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndilyonya mwami Davida wakatuma kuyoomuleta kuzwa kuŋanda ya-Makiri mwana wa-Amiyeli mumunzi wa-Lodebara. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.5",
            "verseOrgIds": [
              "2SA.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aboobo Mefibosete mwana wa-Jonatani mwana wa-Saulo wakasika kuli-Davida, nkabela wakavundama ansi akukambilila.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.6",
            "verseOrgIds": [
              "2SA.9.6"
            ]
          }
        }
