                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Mefibosete kali amwana muniini, izina lyakwe kali Mika. Nkabela boonse basiŋanda ba-Ziba bakaba balanda ba-Mefibosete. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.12",
