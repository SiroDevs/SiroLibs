            }
          ]
        },
        {
          "text": "Elyo mwami wakaita Ziba mulanda wa-Saulo, wakamwaambila kuti, Zintu zyoonse Saulo nzyaakajisi, azintu zyoonse izyakali zyabasiluzubo bakwe, ndazipa oyu mwana wasimalelaako. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.9",
            "verseOrgIds": [
              "2SA.9.9"
            ]
          }
        },
