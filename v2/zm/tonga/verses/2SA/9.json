              "items": [
                {
                  "text": "2 Sam 19:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino uleelede kulima nyika, webo abana bako abalanda bako, akutebula micelo, kuti mwami wako abe acilyo cakulya, Pele Mefibosete mwana wamwami wako uyoolya insima lyoonse kulindime.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.10",
            "verseOrgIds": [
              "2SA.9.10"
            ]
          }
        }
