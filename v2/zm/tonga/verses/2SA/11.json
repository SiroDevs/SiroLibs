                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo Davida wakaambila Uriya kuti, Koya kuŋanda yako, ukasambe kumaulu, Mpawo Uriya wakazwa muŋanda yamwami, nkabela kwakamutobela nyama yacilumbyo iizwa kumwami. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.8",
            "verseOrgIds": [
              "2SA.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 11:9"
