              },
              "items": [
                {
                  "text": "2 Sam 23:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Davida wakatuma kuyoobuzya makani aamwanakazi oyo, nkabela wakaambilwa kuti, Sa teenguwe Bateseba mukaUriya mu-Hiti? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.3",
            "verseOrgIds": [
              "2SA.11.3"
            ]
          }
        },
