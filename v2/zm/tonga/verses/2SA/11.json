              "items": [
                {
                  "text": "Job 31:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ngwani wakajaya Abimeleki mwana wa-Jerubeseti? Sa tamuzi kuti umwi mwanakazi nguwakamujaya ku-Tabezi naakamuwaala mwanankango kuzwa kubulambo? Nkaambonzi nomwakaswena afwiifwi abulambo? Elyo uleelede kwaamba kuti, Mulanda wako Uriya mu-Hiti alakwe wafwa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.21",
            "verseOrgIds": [
              "2SA.11.21"
            ]
          }
        }
