                "loc": "2SA.12.9"
              },
              "items": [
                {
                  "text": "2 Sam 12:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela mulugwalo olo wakalemba kuti, Amubike Uriya mumundando mutaanzi wamunkondo inkali, elyo amumusie nkukonya, kuti ayaswe akufwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.15",
            "verseOrgIds": [
              "2SA.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Joabu naakali kulanga munzi, wakabika Uriya nkukonya oko nkwaakezi kuti nkukuli baalumi basinguzu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.16",
            "verseOrgIds": [
              "2SA.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo bantu bamumunzi bakazwa kuzoolwana a-Joabu, nkabela bamwi balanda baDavida bakajayigwa, alakwe Uriya mu-Hiti wakafwa,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.17",
            "verseOrgIds": [
              "2SA.11.17"
            ]
          }
        }
      ]
