              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino oyo mutumwa wakainka, wakaakwaambila Davida aya makani oonse ngaakamutuminwa kuli-Joabu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.22",
            "verseOrgIds": [
              "2SA.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutumwa wakaambila Davida kuti, Bantu bakali anguzu kwiinda ndiswe, aboobo bakasika nkukonya nkutwakabede kusokwe, nkabela twakabatanda mane kusikila kumanjililo aamulyango. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.23",
            "verseOrgIds": [
              "2SA.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo basibuta bakatufusa mivwi iswe tubalanda bako kuzwa kubulambo, aboobo bamwi babalanda bamwami bafwa, alakwe mulanda wako Uriya mu-Hiti wafwa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.24",
            "verseOrgIds": [
              "2SA.11.24"
            ]
          }
        }
      ]
    },
