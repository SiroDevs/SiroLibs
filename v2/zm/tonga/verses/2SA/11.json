        {
          "text": "Lino ciindi camangolezya, Davida naakabuka kuzwa abulo bwakwe, wakali kuya bweendeenda atala alululi lwaŋanda yamwami, Nkabela naakali alululi wakabona mwanakazi ulasamba, Oyu mwanakazi kali aciimo cibotu loko. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.2",
            "verseOrgIds": [
              "2SA.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
