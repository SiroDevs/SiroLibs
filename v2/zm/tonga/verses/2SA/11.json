                  "text": "Job 5:12-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele Uriya wakoona kumulyango waŋanda yamwami antoomwe abalanda boonse basimalelaakwe, teewakainka kuŋanda yakwe pe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.9",
