          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Joabu wakatuma kuyooambila Davida makani oonse aankondo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.18",
            "verseOrgIds": [
              "2SA.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela wakalailila mutumwa kuti, Wamana buyo kwaambila mwami makani oonse aankondo, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.19",
            "verseOrgIds": [
              "2SA.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ambweni bukali bwamwami bulabuka, Ambweni uyookubuzya kuti, Ino nkaambonzi nomwakaswena afwiifwi amunzi ciindi cakulwa? Sa teemwazi kuti bayoofusa mivwi kuzwa kubulambo? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.20",
            "verseOrgIds": [
              "2SA.11.20"
            ]
          }
        },
