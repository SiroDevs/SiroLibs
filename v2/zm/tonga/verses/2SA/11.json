            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nicakaba ciindi mwanakazi wakaminta, elyo wakatuma kuyooambila Davida kuti, Ndaba ada. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.5",
            "verseOrgIds": [
              "2SA.11.5"
            ]
          }
