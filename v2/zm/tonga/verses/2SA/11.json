          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Davida wakaambila mutumwa kuti, Mbuboobu mboelede kwaambila Joabu. Amba kuti, Aya makani atakubijili, pe, nkaambo taakwe muntu naba omwe uutajayiki kupanga. Amulwane alimwi canguzu kumunzi, kuti muunyonyoone. Koyumya moyo wakwe obo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.25",
            "verseOrgIds": [
              "2SA.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo mukaUriya naakamvwa kuti Uriya mulumaakwe wafwa, wakalila mulumaakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.26",
            "verseOrgIds": [
              "2SA.11.26"
            ]
          }
