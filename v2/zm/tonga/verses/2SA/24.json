          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "elyo bakasika kumampangala aaTuro akuminzi yoonse yaba-Hivi ayaba-Kanani, aboobo bakasika kubupunu bwacisi ca-Juda, ku-Beereseba. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.7",
            "verseOrgIds": [
              "2SA.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino nibakamana kwiinda kunyika yoonse, bakaboola ku-Jerusalemu nikwakamana myezi iili musanu aine amazuba aali makumi obile. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.8",
            "verseOrgIds": [
              "2SA.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.21.5"
              },
              "items": [
                {
                  "text": "1 Mak 21:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Joabu wakalwiida mwami mweelwe wabantu babalidwe. Baalumi basintaze basimapanga bamu-Israyeli kabali zyuulu zili myaanda iili musanu aitatu, abantu ba-Juda kabali zyuulu zili yosanwe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.9",
            "verseOrgIds": [
              "2SA.24.9"
            ]
          }
        }
