              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo Davida wakaya mbubonya mbwaakaamba Gadi, mbwaakamulailila Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.19",
            "verseOrgIds": [
