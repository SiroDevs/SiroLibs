                  "text": "9:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Davida naakabuka cifumo, ijwi lya-Jehova lyakasika kuli-Gadi musinsimi, musondi wa-Davida, lyakati, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.11",
            "verseOrgIds": [
              "2SA.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koya ukaambile Davida kuti, Mbuboobo mbwaamba Jehova, Nzeezi zintu zyotatwe. Kolisalila comwe canzizyo, kuti nkakucitile ncico. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.12",
            "verseOrgIds": [
              "2SA.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.21.12"
              },
              "items": [
                {
                  "text": "1 Mak 21:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Gadi wakeza kuzooambila Davida. Wakamwaambila kuti, Sa ulayanda kusikilwa myaaka iili musanu aibili yanzala okuno kucisi cako? Na sa ulayanda kuba amyezi yotatwe yakucija kuzwa kubasinkondonyoko baku tanda? Na sa ulayanda kuti kube mazuba otatwe aabulwazi kucisi cako? Koyeeya, ukazibe na cintu cibotu ncicili, nkabweedezye makani kuliyooyo iwakandituma. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.13",
            "verseOrgIds": [
              "2SA.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
