              "items": [
                {
                  "text": "Inc 5:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nekubaboobo ijwi lyamwami ndilyakazunda Joabu abasilutwe bampi, aboobo Joabu abasilutwe bampi bakazwa kubusyu bwamwami kuyoobala bantu ba-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.4",
            "verseOrgIds": [
              "2SA.24.4"
            ]
          }
        },
        {
