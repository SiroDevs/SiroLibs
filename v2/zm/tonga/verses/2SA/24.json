        },
        {
          "text": "alimwi bakasika kuGileadi, akunyika ya-Tatimuhodesi, alimwi bakasika ku-Dani-Jaana, akuzwa oko bakazyunguluka kuya ku-Zidoni, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.6",
            "verseOrgIds": [
              "2SA.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
