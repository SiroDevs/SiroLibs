          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Arauna naakatambya meso aakwe, wakabona mwami abalanda bakwe baleza nkwaabede, elyo Arauna wakainka kuyookotamina mwami wakuvundama ansi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.20",
