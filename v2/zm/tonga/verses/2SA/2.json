                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Abineri abantu bakwe bakeenda masiku ayo oonse munyika ya-Araba, bakazubuka mulonga wa-Jordano, bakainda moonse mu-Bitroni mane bakasika ku-Mahanaimu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.29",
