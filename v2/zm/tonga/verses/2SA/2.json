        },
        {
          "text": "Lino aya makani naakamana, Davida wakabuzya kuli-Jehova kuti, Sa njiinke kumunzi umwi wa-Juda? Nkabela Jehova wakamwaambila kuti, Koya, Elyo Davida wakati, Njiinke kuli uli? Wakati, Koya kuHebroni. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.1",
            "verseOrgIds": [
              "2SA.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.25.42+1SA.25.43"
              },
              "items": [
                {
                  "text": "1 Sam 25:42-43",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Davida wakaya nkukonya, abalo banakazi bakwe bobile, Ahinoamu mu-Jezreeli a-Abigayeli muka-Nabala mu-Karameli. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.2",
            "verseOrgIds": [
              "2SA.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.27.2"
              },
              "items": [
                {
                  "text": "1 Sam 27:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abalo bantu bakwe mbaakali abo Davida wakabaleta boonse, umwi aumwi aciinga cakwe, elyo bakakala muminzi ya-Hebroni. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.3",
            "verseOrgIds": [
              "2SA.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.31.11+1SA.31.12+1SA.31.13"
              },
              "items": [
                {
                  "text": "1 Sam 31:11-13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.5.5"
              },
              "items": [
                {
                  "text": "2 Sam 5:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo bantu ba-Juda bakasika, bakananika Davida nkukonya oko, kuti abe mwami wamusyobo wa-Juda.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.4",
            "verseOrgIds": [
              "2SA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
