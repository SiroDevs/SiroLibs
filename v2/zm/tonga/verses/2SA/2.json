          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo bana ba-Benjamini bakayoboloka kuli-Abineri, bakaba impi yomwe, bakaimikila atala acilundu cimwi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.25",
            "verseOrgIds": [
