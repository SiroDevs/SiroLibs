                "loc": "ISA.28.21"
              },
              "items": [
                {
                  "text": "Is 28:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Abineri mwana wa-Neri abalanda ba-Isibosete mwana wa-Saulo bakazwa ku-Mahanaimu, basika ku-Gibeoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.12",
            "verseOrgIds": [
              "2SA.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.41.12"
              },
              "items": [
                {
                  "text": "Jer 41:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abalo Joabu mwana waZeruya abalanda ba-Davida bakazwa kuyoobacinga kuziba lya-Gibeoni, nkabela bakakala nkukonya, bamwi kubbazu limwi lyaziba, abamwi kubbazu limwi lyaziba. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.13",
            "verseOrgIds": [
              "2SA.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.10.23"
              },
              "items": [
                {
                  "text": "Tus 10:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.13.10"
              },
              "items": [
                {
                  "text": "13:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Abineri wakaambila joabu kuti, Balombe banyamuke, batusobanine. Joabu wakati, Mbubo, banyamuke. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.14",
            "verseOrgIds": [
              "2SA.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo bakanyamuka, nkabela kwakasalwa akati kaba-Benjamini bantu bali ikumi ababili kuti babe ba-Isibosete mwana wa-Saulo, abalanda ba-Davida bali ikumi ababili. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.15",
            "verseOrgIds": [
              "2SA.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo bakajatana boonse umwi aumwi kumutwe wamweenzinyina, akuyasana umwi mukateku kamweenzinyina, akuwa boonse antoomwe. Nciceeco obo busena ncibwakaulikwa izina lya-Helkati-Hatsurimu (nkukuti Muunda wamapanga.) Buli mucisi ca-Gibeoni.",
          "type": "text",
          "attrs": {
