                  "text": "32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Joabu wakati, Jehova mbali muumi, niwatakaamba, elyo cifumofumo bantu nibaleka kutanda bakwabo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.27",
