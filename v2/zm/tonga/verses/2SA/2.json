          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alakwe Joabu wakapiluka kuzwa kukutobela Abineri, nkabela naakabunganya bantu boonse, kwakajanwa kuti kakutawo balanda ba-Davida bali ikumi amusanu abane a-Asaheli. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.30",
            "verseOrgIds": [
              "2SA.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele balanda ba-Davida bakalijayide akati kaba-Benjamini abantu ba-Abineri bantu bali myaanda yotatwe amakumi aali musanu alimwi, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.31",
            "verseOrgIds": [
              "2SA.2.31"
            ]
          }
        },
