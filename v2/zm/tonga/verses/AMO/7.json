              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuboobu Mwami Jehova mbwaakandibonya. Ndakabona kuti uli mukucita cisozi ciindi nciwakatalika kusyuuka mweemvu wabili, nkokuti mweemvu wabili nikwakamana kumwidwa kwamwami. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.1",
            "verseOrgIds": [
              "AMO.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela nicakamana kulya zintu zyoonse zimena zyamunyika, ndakati, O Mwami Jehova, kolekelela. Jakobo ulabuka buti? Nkaambo muniini buyo. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.2",
            "verseOrgIds": [
              "AMO.7.2"
            ]
          }
        },
        {
