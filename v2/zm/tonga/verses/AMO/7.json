            "sid": "AMO 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuboobu mbwaakandibonya. Ndakabona kuti Mwami uliimvwi abulambo bupimidwe, acipimyo kacili mujanza lyakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.7",
            "verseOrgIds": [
              "AMO.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.21.13"
              },
              "items": [
                {
                  "text": "2 Bam 21:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.28.17"
              },
              "items": [
                {
                  "text": "Is 28:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.7.18"
              },
              "items": [
                {
                  "text": "Mik 7:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Jehova wakandibuzya kuti, Ncinzi ncobona, Amosi? Ndakati, Ncipimyo. Elyo Mwami wakaamba kuti, Bona! Ndabika cipimyo akati kabantu bangu ba-Israyeli, nkabela nsikooyooboola limbi kubalekelela. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.8",
            "verseOrgIds": [
              "AMO.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.26.23"
              },
              "items": [
                {
                  "text": "Matl 26:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.15.10"
              },
              "items": [
                {
                  "text": "2 Bam 15:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele zilundu zya-Izaka ziyoomwaikilwa bantu, aalo makuta aa-Israyeli ayoosaalwa, nkabela njoobuka apanga lyakulwisya mukowa wa-Jeroboamu,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.9",
            "verseOrgIds": [
              "AMO.7.9"
            ]
          }
        }
      ]
    },
