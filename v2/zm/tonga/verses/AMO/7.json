            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuboobu Mwami Jehova mbwaakandibonya. Ndakabona kuti Mwami Jehova uli mukwiita mulilo wakubetesya, nkabela wakalya bulondo bupati bwamaanzi, wakaamba kulya nyika ayalo. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.4",
            "verseOrgIds": [
              "AMO.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo ndakaamba kuti, o Mwami Jehova, koleka. Jakobo ulabuka buti? Nkaambo muniini buyo. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.5",
            "verseOrgIds": [
              "AMO.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.102.17"
              },
              "items": [
                {
                  "text": "Int 102:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Jehova wakeempwa kumakani aya. Aya aalo taakooyooba obo, pe, mbwaamba Mwami Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.6",
            "verseOrgIds": [
              "AMO.7.6"
            ]
          }
        }
