              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.12.32"
              },
              "items": [
                {
                  "text": "1 Bam 12:32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.14.23"
              },
              "items": [
                {
                  "text": "2 Bam 14:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Amaziya mupaizi waku-Beteli wakatuma kuli-Jeroboamu mwami wa-Israyeli, wakati, Amosi wakuvwiya mukati kamukowa wa-Israyeli, Nyika yaata kumajwi aakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.10",
            "verseOrgIds": [
              "AMO.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "AMO 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo mbuboobu mbwaamba Amosi. Wati, Jeroboamu uyoojayigwa apanga, abalo ba-Israyeli bayootolwa mubuzike kuzwa kucisi cabo.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.11",
            "verseOrgIds": [
              "AMO.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "AMO 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.11",
            "verseOrgIds": [
              "AMO.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "AMO 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi Amaziya wakaambila Amosi kuti, Uwe sicilengano, koya ukacije kucisi ca-Juda, ukalye insima akusinsima nkuko. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.12",
            "verseOrgIds": [
              "AMO.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "AMO 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.2.12"
              },
              "items": [
                {
                  "text": "Am 2:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele utabooli limbi kusinsima ku-Beteli, nkaambo ndikuta lyamwami, alimwi mbukalilo bwabwami, ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.13",
            "verseOrgIds": [
              "AMO.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "AMO 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.2.5"
              },
              "items": [
                {
                  "text": "2 Bam 2:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.13.5"
              },
              "items": [
                {
                  "text": "Zek 13:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Amosi wakavwiila Amaziya kuti, Ime teendakali musinsimi nanka mwana wamusinsimi, pe, ndakali mweembeli asikucela inkuyu. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.14",
            "verseOrgIds": [
              "AMO.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "AMO 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Jehova wakandilesya kweembela imbelele, Jehova wakandaambila kuti, Koya ukasinsimine bantu bangu ba-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.15",
            "verseOrgIds": [
              "AMO.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "AMO 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.30.10"
              },
              "items": [
                {
                  "text": "Is 30:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.2.6"
              },
              "items": [
                {
                  "text": "Mik 2:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino swiilila ijwi lya-Jehova. Uwe ulaamba kuti, Utasinsimi cakutapatila mukowa wa-Israyeli, utaambi majwi aakubijila luzubo lwa-Izaka. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.16",
            "verseOrgIds": [
              "AMO.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "AMO 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.28.12"
              },
              "items": [
                {
                  "text": "Jer 28:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.29.21"
              },
              "items": [
                {
                  "text": "29:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LAM.5.11"
              },
              "items": [
                {
                  "text": "Malo 5:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kako Jehova wati, Mukaako uyoovuula mumonya mumunzi, abana bako balombe abasimbi boonse bayoojayigwa apanga, anyika yako iyooabwa antambo yakweelesya, ayebo uyoofwa munyika iisofweede, abalo ba-Israyeli bayootolwa mubuzike kuzwa kucisi cabo.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.17",
            "verseOrgIds": [
              "AMO.7.17"
            ]
          }
        }
      ]
    }
