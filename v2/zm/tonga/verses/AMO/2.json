          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ncobeni ndimanikizidwe munsi andinywe mbuli mbiimanikizidwe iŋola iizwide zifunte zyamaila. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.13",
            "verseOrgIds": [
              "AMO.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "AMO 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino siluno ulamaninwa lucijo, alakwe singuzu takooyoosikilwa buyumu, alakwe mwaalumi sintaze takooyoolivuna. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.14",
            "verseOrgIds": [
              "AMO.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
