          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayooyo uuzi kufusa buta takooyooima nji, amuuba maulu takooyoovunwa, alakwe sikutanta imbizi takooyoolivuna. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.15",
            "verseOrgIds": [
              "AMO.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "AMO 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela mukozumoyo akati kabaalumi basintaze uyoocija acintanda mubuzuba obo, mbwaamba Jehova.",
          "type": "text",
          "attrs": {
