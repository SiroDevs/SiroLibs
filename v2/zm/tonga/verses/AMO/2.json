            }
          ]
        },
        {
          "text": "Pele njootuma mulilo ku-Moabu, ulye maanda aabwami aaku-Kerioti, nkabela Moabu uyoofwa alupyopyongano aloongololo ajwi lyamweembo. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.2",
            "verseOrgIds": [
