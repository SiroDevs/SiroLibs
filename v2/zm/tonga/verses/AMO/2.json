            }
          ]
        },
        {
          "text": "Pele ba-Naziri mwakabanywisya waini, abalo basinsimi mwakabalailila kuti, Mutasinsimi pe, ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.12",
            "verseOrgIds": [
              "AMO.2.12"
            ]
          }
        },
        {
          "name": "verse",
