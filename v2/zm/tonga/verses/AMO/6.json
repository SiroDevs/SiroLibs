                "loc": "2KI.14.25"
              },
              "items": [
                {
                  "text": "2 Bam 14:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amwiinde ku-Kaline, mubone; kuzwa oko kamuya kuHamati mupati; alimwi kamuseluka kuya ku-Gati waba-Filisti. Sa muli kabotu kwiinda zisi ezi? Sa nyika yanu nimpati kwiinda nyika yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.2",
            "verseOrgIds": [
              "AMO.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
