              "type": "text"
            }
          ]
        },
        {
          "text": "Maawe kulibaabo bakede cakutapenga mu-Zioni, abaabo batajisi cakubayoosya mucilundu ca-Samariya, bapati bataanzi bazisi, basikilwa bana ba-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.1",
            "verseOrgIds": [
              "AMO.6.1"
            ]
          }
        },
        {
