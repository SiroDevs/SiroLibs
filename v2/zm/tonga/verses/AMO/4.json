              "items": [
                {
                  "text": "Dt 28:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi ndakamuletela ndyomba akwiibuka. Mwakavuzya myuunda yanu amyuunda yamasaansa amakuyu aanu amaolifa aanu, pele cisozi cakazilya, Nekubaboobo tamuna kuboola kulindime, mbwaamba Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.9",
            "verseOrgIds": [
              "AMO.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakamutumina bulwazi mbuli bwaku-Egepita, ndakajazya ipanga bakubusi banu, ambizi zyanu ndakazitola, akwalo kununka kwamalabba aanu ndakakunjizya mumpemu zyanu. Nekubaboobo tamuna kuboola kulindime, mbwaamba Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.10",
            "verseOrgIds": [
              "AMO.4.10"
            ]
          }
        },
