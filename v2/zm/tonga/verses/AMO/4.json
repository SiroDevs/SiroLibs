                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ambebo ndamusalazizya meno muminzi yanu yoonse, akumubuzya cilyo mumasena aanu oonse, nekubaboobo tamuna kuboola kulindime, mbwaamba Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.6",
            "verseOrgIds": [
              "AMO.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi ndime ndamukasizya imvula nikwacisyeede myezi yotatwe kusikila kukutebula. Ndakawisizya munzi umwi imvula, pele munzi umwi nsina kuuwisizya pe. Muunda umwi wawidwa imvula, pele muundanyina uutana kuwidwa imvula wapusama. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.7",
            "verseOrgIds": [
              "AMO.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo minzi yobile nanka yotatwe keeli kweendeenda kumunzi omwe kuya kunywa maanzi akutagondwa. Nekubaboobo tamuna kuboola kulindime, mbwaamba Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.8",
            "verseOrgIds": [
              "AMO.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
