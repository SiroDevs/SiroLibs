              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi amutente cilyo cijisi bumena, cibe cituuzyo cakulumba, akwiitila zituuzyo zyamoyo akuzimvwisya, nkaambo mbuboobo mbumuyanda kucita, nubana ba-Israyeli, mbwaamba Mwami Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.5",
            "verseOrgIds": [
              "AMO.4.5"
            ]
          }
        },
