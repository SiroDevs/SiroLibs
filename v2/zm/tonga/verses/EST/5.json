                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mubuzuba bwatatu, Esita kasamide zyakusama zyakwe zyabwami, wakaima mukabuwa kamukati kaŋanda yamwami, kalangana aŋanda yakwe, Mwami wakalikede acuuno cakwe ca bwami muŋanda yamwami kalangana amulyango, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.1",
            "verseOrgIds": [
              "EST.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
