                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nekubaboobo wakalijata akuya kumunzi, Wakatuma kuti baboole bazwalani bakwe amukaakwe Zeresi, ",
          "type": "text",
          "attrs": {
