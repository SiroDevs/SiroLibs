                  "text": "9:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nobakacikede kuwaini mwami wakati kuli-Esita, Lukumbilo lwako niinzi? uyakupegwa. Ukumbilaanzi? kuti nociba cisela cacisi cangu, uyakucitilwa ncico, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.6",
            "verseOrgIds": [
              "EST.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esita wakavuwa kuti, Lukumbilo lwangu? lulombo lwangu? ",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.7",
            "verseOrgIds": [
              "EST.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ino kuti ndajana luse kumwami, mwami kuti kabotelwa kuti kukumbila kwangu kupegwe, akulomba kwangu kuzumizigwe, ababoole mwami a-Hamani kupobwe ndinjakubabambila, elyo cifumo njakupasula mbuli mbwaamba mwami.",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.8",
            "verseOrgIds": [
              "EST.5.8"
            ]
          }
        }
      ]
