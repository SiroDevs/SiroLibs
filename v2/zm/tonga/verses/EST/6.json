            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.14.11"
              },
              "items": [
                {
                  "text": "Lk 14:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo mwami wakati kuli-Hamani, Fwambaana, jana cikobela abbiza mbubonya mboambide, umucitile zyoonse ezi Moodekai mu-Juda uukala a-Mulyango wamwami; utaleki cintu comwe cazeezyo nzoambide.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.10",
            "verseOrgIds": [
              "EST.6.10"
            ]
          }
        }
      ]
    },
