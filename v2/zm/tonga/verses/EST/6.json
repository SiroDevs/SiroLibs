                "loc": "1KI.1.33"
              },
              "items": [
                {
                  "text": "1 Bam 1:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kabaleta cakusama cabwami ncaakasamide mwami, alimwi abbiza ndyaakatantide mwami amunsini wabwami kumutwe walye; ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.8",
            "verseOrgIds": [
              "EST.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.41.43"
              },
              "items": [
                {
                  "text": "Matl 41:43",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "cakusama abbiza kazibikwa mujanza lyasilutwe mupati wamwami kuti asinizye kuti muntu ngwayanda mwami kulemya asamikwe akutanta kasololelwa mumugwagwa wamunzi, kaompolwedwa kuti, Obo mbwacitilwa muntu mwami ngwayanda kulemya. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.9",
            "verseOrgIds": [
              "EST.6.9"
            ]
          }
        },
        {
          "name": "verse",
