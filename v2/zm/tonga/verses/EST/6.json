              "items": [
                {
                  "text": "2 Sam 15:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Moodekai wakajokela ku-Mulyango wamwami, pele Hamani wakaya luno kumunzi katyompekeledwe, abusyu buvumbidwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.12",
            "verseOrgIds": [
              "EST.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Hamani naakabaambila Zeresi mukaakwe abazwalani bakwe boonse, balayi bakwe a-Zeresi mukaakwe bakati kulinguwe, Moodekai, kunembo lyakwe ngotalikide kuwa, kuti kali simukowa wa-Juda tokazwidilili kulinguwe; uyakuzundwa akuwa kunembo lyakwe.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.13",
            "verseOrgIds": [
              "EST.6.13"
            ]
          }
        }
      ]
