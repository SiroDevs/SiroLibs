              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Moodekai wakazwida kumwami kasamide zikobela zya bwami zisiyasiya azituba, amunsini wangolida acibaakani camalembo aaluleme alimwi aasalala; munzi wa-Susa wakasekelela. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.15",
