                  "text": "22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aboobo balembi bamwami bakaitwa mubuzuba bwamakumi obile mwaatatu bwamwezi watatu uutegwa Siva; lugwalo lwakabambwa mbwaakalailila Moodekai, kuba-Juda, abeendelezi, abaleli, abasimutwe bazisi kuzwa ku-India kusikila ku-Etiopiya, zisi zili mwaanda amakumi obile azisanu muzibili, kalulembwa mubulembo bwacisi amululimi lwamukowa woonse, alimwi kuba-Juda mubulembo alulimi lwabo, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.9",
            "verseOrgIds": [
              "EST.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
