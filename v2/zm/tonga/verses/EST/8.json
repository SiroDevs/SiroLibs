                  "text": "10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "mubuzuba bwaambwa muzisi zyoonse zyamwami Ahasuera, nkokwaamba kuti buzuba bwakumi mwaatatu bwamwezi wakumi mwiibili, uutegwa Ada. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.12",
            "verseOrgIds": [
              "EST.8.12"
            ]
          }
        },
        {
