            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.10.6"
              },
              "items": [
                {
                  "text": "Is 10:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "mwakazumizigwa amwami mulingawo kuti ba-Juda bali muminzi yoonse babungane akulivuna, kunyonyoona, kujaya akufwidilizya boonse basilumamba bamukowa acisi coonse cababasoka, kujaya bana abakaintu babo, akusaala lubono lwabo, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.11",
            "verseOrgIds": [
              "EST.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
