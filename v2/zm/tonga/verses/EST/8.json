                "loc": "LUK.15.22"
              },
              "items": [
                {
                  "text": "Lk 15:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "mwami wakagwisya nwenwe njaakabwezede kuli-Hamani, akumupa Moodekai; alimwi Esita wakabika Moodekai ajulu lyalubono lwa-Hamani.",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.2",
            "verseOrgIds": [
              "EST.8.2"
            ]
          }
        }
