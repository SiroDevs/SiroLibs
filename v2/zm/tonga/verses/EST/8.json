              },
              "items": [
                {
                  "text": "1 Bam 21:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Moodekai wakalemba muzina lyamwami akusimba lugwalo acisimbyo camwami. Wakatuma magwalo abasimposo kabatantide mabbiza aakalijisi luno, mabbiza aakazyedwe mucimpati camwami, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.10",
            "verseOrgIds": [
              "EST.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
