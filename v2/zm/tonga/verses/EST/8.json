                "loc": "EST.3.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Majwi aamucilaililo aeelede kuya kuzisi zyoonse akutuminwa maleya kumikowa yoonse; ba-Juda bakeelede kulibambila kuti bajokezezye basinkondonyina.",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.13",
            "verseOrgIds": [
              "EST.8.13"
            ]
          }
        }
