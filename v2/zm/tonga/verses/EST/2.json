              "items": [
                {
                  "text": "2 Tim 4:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bulizi bwa-Esita, mwana a-Abihila simizyaabo Moodekai (wakamutolede mbuli mwanaakwe), nebwakasika kuti anjile kumwami, takwakakumbila cintu kutaamba zeezyo nzyaakalailila Hege siŋanda wamwami. Esita wakeza kumyoyo yabo boonse bakamubona. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.15",
            "verseOrgIds": [
              "EST.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
