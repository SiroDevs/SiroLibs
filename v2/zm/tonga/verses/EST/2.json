              "type": "text"
            }
          ]
        },
        {
          "text": "Lino, mu-Susa munzi wamwami kamuli mu-Juda uutegwa Moodekai, mwana a-Jai, mwana a-Simei mwana a-Kisi, sikamukowa wa-Benjamini; ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.5",
            "verseOrgIds": [
              "EST.2.5"
            ]
          }
        },
