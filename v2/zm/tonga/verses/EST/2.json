                {
                  "text": "1 Bam 1:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "balindilizi bakwe bakaamba kuti, Kabayandawida mwami basimbi beebeka; ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.2",
            "verseOrgIds": [
              "EST.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwami kabika batumwa muzisi zyoonse zyabwami bwakwe kuti bakabunganye boonse basimbi beebeka mu-Susa munzi wamwami, muŋanda yabakaintu, kababikwa mumaanza aa-Hege siŋanda wamwami, mulangi wabakaintu; kabapegwa mwiimpula azinunkilizyo nzebayanda, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.3",
            "verseOrgIds": [
              "EST.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "elyo musimbi uukondesya mwami abe namalelo mubusena bwa-Vasiti. Muyeeyo oyu wakabotezya mwami, elyo wakacita obo.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.4",
            "verseOrgIds": [
              "EST.2.4"
            ]
          }
        }
      ]
    },
