            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.65"
              },
              "items": [
                {
                  "text": "Dt 28:65",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Esita takwakaamba mukowa neluba luzubo lwakwe nkaambo Moodekai wakamulayide kuti atazyaambi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.10",
            "verseOrgIds": [
              "EST.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazuba oonse Moodekai wakeendeenda kunsi kwalubuwa lwamaanda aabakaintu kuti abuzye Esita mbwaakapona ambwaakacitilwa.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.11",
            "verseOrgIds": [
              "EST.2.11"
            ]
          }
        }
      ]
