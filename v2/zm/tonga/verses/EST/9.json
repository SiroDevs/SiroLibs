              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "aaimika ma-Puri aciindi ncaakeelede kubambwa, mbuli mbwaakaambide Moodekai, ambuli ba-Juda mbobakalisungwide kulimbabo beni alimwi abana babo mumakani aakuliimya akulila. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.31",
            "verseOrgIds": [
              "EST.9.31"
            ]
          }
