        },
        {
          "text": "ba-Juda bakazuminina kuti balo lwabo abana babo, alimwi abaabo boonse bakaswanaana ambabo, bakacite cilengwa citakasandulwi cakubamba mazuba aya obile mbuli mbwaakalembede Moodekai, kuciindi cakaambwa myaka yoonse, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.27",
            "verseOrgIds": [
