              "type": "text"
            }
          ]
        },
        {
          "text": "magwalo akatumwa anguwe kuliboonse ba-Juda bamuzisi zili mwaanda amakumi obile azisanu muzibili zyaAhasuera kaajisi majwi aaluumuno alusyomeko, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.30",
