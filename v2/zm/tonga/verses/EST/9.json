        },
        {
          "text": "Kubuzuba bwakumi mwaatatu bwamwezi wakumi mwiibili uutegwa Ada, ijwi acilaililo camwami nocakeelede kucitwa, buzuba mbubonya basinkondonyina baba-Juda nebakali kulangila kubazundilila cakati sandamuke; ba-Juda bakakomenena basinkondonyina. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.1",
            "verseOrgIds": [
              "EST.9.1"
            ]
          }
        },
