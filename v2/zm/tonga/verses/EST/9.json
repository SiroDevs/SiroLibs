        },
        {
          "text": "Ba-Juda bakabungana muminzi yabo muzisi zyoonse zyamwami Ahasuera, kuti bajaye babo bakaliyungide kunyonyoona kwabo; taakwe muntu wakakonzya kubaimina, nkaambo kubayoowa kwakalinjilide mikowa yoonse, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.2",
            "verseOrgIds": [
              "EST.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
