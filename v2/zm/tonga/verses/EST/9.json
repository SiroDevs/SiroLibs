                }
              ]
            }
          ]
        },
        {
          "text": "bana basankwa ba-Hamani mwana a-Hamedata, asinkondonyina waba-Juda; pele teebakabika munwe kulubono lwabo.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.10",
            "verseOrgIds": [
              "EST.9.10"
