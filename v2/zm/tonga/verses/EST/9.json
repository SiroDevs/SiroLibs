                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ncobeni, boonse basilutwe bazisi abeendelezi abaleli abaabo bakalijisi mulimo wamwami bakabagwasya ba-Juda; kumuyoowa Moodekai kwakalinjilide mbabo, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.3",
            "verseOrgIds": [
              "EST.9.3"
            ]
          }
        },
        {
