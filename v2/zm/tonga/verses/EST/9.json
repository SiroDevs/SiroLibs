            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.5.22"
              },
              "items": [
                {
                  "text": "1 Tes 5:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ba-Juda bamwi bakali muzisi zyamwami abalo bakabungene kuti balivune buumi bwabo bapilukilide basinkondonyina akujaya zyuulu zyakali makumi osanwe mwaabili amusanu wabo; pele teebakabika munwe kulubono, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.16",
            "verseOrgIds": [
              "EST.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EST 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eci cakali mubuzuba bwakumi mwaatatu bwamwezi uutegwa Ada, amubuzuba bwakumi mwaane bakalyokezya kabacita buzuba obo kuba bwakupobola akukondwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.17",
            "verseOrgIds": [
              "EST.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EST 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba-Juda bakali mu-Susa bakabungana mulibwakumi mwaatatu amulibwakumi aane, akulyokezya mulibwakumi mwaasanu kabacita obo buzuba bwakupobola akukondwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.18",
            "verseOrgIds": [
              "EST.9.18"
            ]
          }
        },
