              },
              "items": [
                {
                  "text": "1 Sam 13:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela ba-Filisti bakazundwa, teebakacili kuboola alimwi kusika kucisi caba-Israyeli, nkabela ijanza lya-Jehova lyakali kukoma baFilisti mazuba oonse aa-Samuele. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.13",
            "verseOrgIds": [
              "1SA.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino myunzi yoonse njibakanyanzizye ba-Filisti kuzwa kuba-Israyeli yakaboola kuba-Israyeli kuzwa ku-Ekroni kusikila ku-Gati, alimwi cisi ceengelede njiyo acalo ba-Israyeli bakacivuna kuzwa kumaanza aaba-Filisti. Nkabela kwakaba luumuno akati kabaIsrayeli aba-Amori. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.14",
            "verseOrgIds": [
              "1SA.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
