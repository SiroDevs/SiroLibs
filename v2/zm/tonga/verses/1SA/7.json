          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo bana ba-Israyeli bakagwisya ba-Baala abaAstoreti, akumanina Jehova luzutu milimo,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.4",
            "verseOrgIds": [
              "1SA.7.4"
            ]
