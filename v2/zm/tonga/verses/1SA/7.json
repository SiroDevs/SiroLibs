                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Samuele wakali kubeteka ba-Israyeli mazuba oonse aabuumi bwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.15",
            "verseOrgIds": [
              "1SA.7.15"
            ]
          }
