                  "text": "Is 37:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela bana ba-Israyeli bakaambila Samuele bati, Utaleki pe kutukumbilila kuli-Jehova Leza wesu, kuti atuvune kuzwa kumaanza aabaFilisti. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.8",
            "verseOrgIds": [
              "1SA.7.8"
            ]
          }
