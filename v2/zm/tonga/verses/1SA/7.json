              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myaaka yoonse wakali kuya buzyunguluka ku-Beteli aku-Giligala aku-Mizipa, akubeteka ba-Israyeli mumasena aya oonse. ",
          "type": "text",
          "attrs": {
