              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo ba-Filisti nibakamvwa kuti ba-Israyeli bakalibungene ku-Mizipa, bami baba-Filisti bakaya kuyoolwana aba-Israyeli, Lino bana ba-Israyeli nibakamvwa bakayoowa nkaambo kabaEilisti. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.7",
            "verseOrgIds": [
              "1SA.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
