                  "text": "Tus 27:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sa teensi oyu Davida, ngubakali kwiimba mukuzyana kwabo kuti,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.5",
            "verseOrgIds": [
