        },
        {
          "text": "Lino ba-Filisti bakabunganya basinkondo babo boonse ku-Afeki, abalo ba-Israyeli bakalibungene mumalabba kukasensa ku-Jezreeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.1",
            "verseOrgIds": [
              "1SA.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
