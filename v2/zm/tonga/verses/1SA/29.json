                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela bami ba-Filisti bakali kuya bweenda mumyaanda yabo amuzyuulu zyabo, alakwe Davida abantu bakwe bakali kuza musule antoomwe a-Akisi, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.2",
            "verseOrgIds": [
              "1SA.29.2"
            ]
          }
        },
        {
          "name": "verse",
