              "type": "tag",
              "attrs": {
                "loc": "1PE.3.16"
              },
              "items": [
                {
                  "text": "1 Pet 3:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo bami baba-Filisti bakati, Ino aba ba-Hebrayo bacitanzi? Lino Akisi wakaambila bami baba-Filisti kuti, Teensi oyu Davida mulanda waSaulo mwami wa-Israyeli? Sa takwe naakakede kulindime ciindi cilamfulamfu? Alimwi taakwe nindakamujanina mulandu kuzwa kubuzuba obo mbwaakeza kulindime nikuba kusikila sunu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.3",
            "verseOrgIds": [
              "1SA.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.12.19"
              },
              "items": [
                {
                  "text": "1 Mak 12:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.14.21"
              },
              "items": [
                {
                  "text": "1 Sam 14:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele bami baba-Filisti bakamusulwidilwa. Bami baba-Filisti bakamwaambila kuti, Mupilusye oyu muntu, kuti abweede kubusena bwakwe mbookamupa. Atainki aswebo kunkondo, pe, kuti atatubedi sinkondoma munkondo. Oyu muntu abotezye buti mwami wakwe? Sa teensi kukukosola mitwe yabantu aba? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.4",
            "verseOrgIds": [
              "1SA.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 29:5"
