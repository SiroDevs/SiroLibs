                "loc": "1SA.24.20"
              },
              "items": [
                {
                  "text": "1 Sam 24:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakamwaambila kuti, Utayoowi, nkaambo tokoonjizigwa mumaanza aa-Saulo taata, pe. Uyooba mwami wa-Israyeli, nkabela mebo nzooba wabili kulinduwe. Alakwe Saulo taata ulizi obo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.17",
            "verseOrgIds": [
              "1SA.23.17"
            ]
          }
        },
        {
