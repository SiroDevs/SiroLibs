                "loc": "1SA.30.7"
              },
              "items": [
                {
                  "text": "1 Sam 30:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Davida naakaziba kuti Saulo uli mukumukanza bubi, wakaambila Abiyatare mupaizi kuti, Leta okuno cikobela cabupaizi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.9",
            "verseOrgIds": [
              "1SA.23.9"
            ]
          }
        },
