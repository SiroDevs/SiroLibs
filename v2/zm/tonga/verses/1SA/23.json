        },
        {
          "text": "Nkabela Abiyatare mwana wa-Ahimeleki naakacija kuli-Davida kuzwa ku-Kcila wakeza acikobela cabupaizi mujanza lyakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.6",
