        },
        {
          "text": "Lino Saulo wakaambilwa kuti, Davida wasika ku-Kcila. Mpawo Saulo wakati, Leza wamwaaba mumaanza aangu, nkaambo uliialilidwe mbwaaniilila mumunzi uuli amakoma ambaya. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.7",
            "verseOrgIds": [
              "1SA.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Saulo wakabunganya bantu boonse kuya kunkondo ku-Kcila kuyoomusinkilizya Davida abantu bakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.8",
            "verseOrgIds": [
              "1SA.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 23:9"
          },
          "items": [
