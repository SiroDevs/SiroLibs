            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.25.13"
              },
              "items": [
                {
                  "text": "25:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Davida wakanyamuka abantu bakwe bali mbuli myaanda iili musanu aumwi, wakazwa ku-Kcila, wakali kuya bweendeenda kufumbwa nkwaaya, Nkabela Saulo naakaambilwa kuti, Davida waloboka ku-Kcila, wakasaya.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.13",
            "verseOrgIds": [
              "1SA.23.13"
            ]
          }
        }
