              "items": [
                {
                  "text": "1 Sam 25:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo bakanyamuka, bamuzulwida Saulo kuya ku-Zifi, Nkabela Davida abantu bakwe bakali munkanda ya-Maoni mucimpayuma cili kululyo lyagundu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.24",
            "verseOrgIds": [
              "1SA.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Saulo abantu bakwe bakaya kuyoomuyandaula, nkabela Davida naakaambilwa obo wakaya kumwaala, wakaakukala munkanda ya-Maoni. Nkabela Saulo naakamvwa wakamutobela Davida munkanda ya-Maoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.25",
            "verseOrgIds": [
              "1SA.23.25"
            ]
          }
        },
