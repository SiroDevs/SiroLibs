        {
          "text": "Elyo kwakasika mutumwa kuli-Saulo, wakati, Fwambaana kuboola, nkaambo baFilisti beza kuzoosaala nyika. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.27",
            "verseOrgIds": [
              "1SA.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo Saulo wakapiluka kuzwa kukutobela Davida, wakaya kuyoolwana aba-Filisti. Nciceeco oyo mweenya nciwakaulikwa kuti, Mwaalawacilobokelo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.28",
            "verseOrgIds": [
              "1SA.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
