                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo abo bobile bakatangana cizuminano kubusyu bwa-Jehova, nkabela Davida wakasyaala mucisaka, Jonatani wakabweeda kulinguwe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.18",
            "verseOrgIds": [
              "1SA.23.18"
            ]
          }
        }
