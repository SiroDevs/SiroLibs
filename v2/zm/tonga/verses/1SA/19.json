        {
          "text": "Lino Saulo wakaambila mwanaakwe Jonatani abalanda bakwe boonse kuti bajaye Davida. Pele Jonatani mwana wa-Saulo wakali kuyandi­ sya loko Davida. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.1",
            "verseOrgIds": [
              "1SA.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
