                "loc": "2SA.2.22"
              },
              "items": [
                {
                  "text": "2 Sam 2:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Saulo wakaambila Mikala wati, Nkaambonzi nowandeena obo? Nkaambonzi nowamucijisya sinkondoma akumuvuna? Lino Mikala wakavwiila Saulo kuti, Nguwakandaambila kuti, Ndicijisya kumbi. Watandicijisya ndakujaya.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.17",
            "verseOrgIds": [
              "1SA.19.17"
            ]
          }
        }
