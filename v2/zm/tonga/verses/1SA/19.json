                "loc": "ACT.23.16"
              },
              "items": [
                {
                  "text": "Inc 23:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo Jonatani wakalwiida Davida kuti, Saulo taata uli mukukuyandaula kuti akujaye. Lino ucenjele cifumo, ukakale kusitilide, ukayube. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.2",
            "verseOrgIds": [
              "1SA.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela mebo ndaboola kuzooima kumbali ataata oko kusokwe nkobede, nzooambaula ataata aanduwe, elyo na nkabone cintu nzookulwiida.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.3",
            "verseOrgIds": [
              "1SA.19.3"
            ]
          }
        }
