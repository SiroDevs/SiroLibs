        },
        {
          "text": "Mpawo Mikala wakabweza cikozyano, wacilazika abulo, wabika amusego waboya bwampongo kumutwe waco, akucivumba ingubo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.13",
            "verseOrgIds": [
              "1SA.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Saulo naakatuma batumwa kuyooleta Davida, wakati, Waciswa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.14",
            "verseOrgIds": [
              "1SA.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino alimwi Saulo wakatuma batumwa kuyoomubona Davida. Wakati, Mukamutembe abulo, mumulete okuno kulindime, nzoomujaye. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.15",
            "verseOrgIds": [
              "1SA.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino abo batumwa nibakasika bakabona kuti abulo ali cikozyano, amusego waboya bwampongo kumutwe waco. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.16",
            "verseOrgIds": [
              "1SA.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
