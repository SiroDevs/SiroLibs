              "type": "text"
            }
          ]
        },
        {
          "text": "Lino nibakalwiida Saulo, wakatuma abambi batumwa, pele abalo aba bakasinsima. Alimwi Saulo wakatuma batumwa bambi lwatatu, abaaba abalo bakasinsima mbubonya. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.21",
            "verseOrgIds": [
              "1SA.19.21"
            ]
          }
        },
