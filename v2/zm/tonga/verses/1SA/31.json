              "items": [
                {
                  "text": "2 Sam 1:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Saulo wakaambila sikuyumuna zii wisyo zyakwe kuti, Somona ipanga lyako, undiyase kuti aba batapalwidwe batasiki kuzoondiyasa akundicapa. Pele sikuyumuna zilwisyo zyakwe takakazumina, pe, nkaambo wakayoowa loko, Elyo Saulo wakabweza ipanga, wawida alindilyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.4",
            "verseOrgIds": [
              "1SA.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino sikuyumuna zilwisyo zyakwe naakabona kuti Saulo wafwa, alakwe wakawida asumo lyakwe, wakafwa awe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.5",
            "verseOrgIds": [
              "1SA.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
