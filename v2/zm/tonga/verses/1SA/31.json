            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.8.33"
              },
              "items": [
                {
                  "text": "1 Mak 8:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo ba­ Filisti bakali kuya bubatobela Saulo abana bakwe, nkabela ba-Filisti bakajaya Jonatani a-Abinadabu a-Malikisua bana ba-Saulo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.2",
            "verseOrgIds": [
              "1SA.31.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
