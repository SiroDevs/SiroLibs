              "items": [
                {
                  "text": "Rom 6:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aboobo Saulo abana bakwe botatwe asikuyumuna zilwisyo zyakwe abantu bakwe boonse bakafwa mubuzuba obo mbubonya. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.6",
            "verseOrgIds": [
              "1SA.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo bantu ba-Israyeli bakutala lyamumpata, abaabo bakutala lya-Jordano, nibakabona kuti bantu ba-Israyeli baliciside, alimwi Saulo abana bakwe balifwide, bakasia minzi, bacija, elyo ba-Filisti bakeza kuzookala mulinjiyo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.7",
            "verseOrgIds": [
              "1SA.31.7"
            ]
          }
        }
      ]
