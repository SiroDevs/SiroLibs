                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo bakamukosola mutwe akugwisya zilwisyo zyakwe, bakazituma kucisi caba-Filisti kuyootola makani kumituni yabo akubantu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.9",
            "verseOrgIds": [
              "1SA.31.9"
            ]
          }
