                "loc": "2SA.1.6"
              },
              "items": [
                {
                  "text": "2 Sam 1:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino inkondo yakamulemenena Saulo, nkabela basimata bakamweenzya, wakalifwabide loko nkaambo kabasimata. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.3",
            "verseOrgIds": [
              "1SA.31.3"
            ]
          }
        },
        {
