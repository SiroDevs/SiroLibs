        },
        {
          "text": "Lino nibwakaca ba-Filisti bakasika kuzoosaala zintu zyabaabo bajayidwe. Nkabela bakajana Saulo abana bakwe botatwe balifwide mucilundu caGiliboa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.8",
            "verseOrgIds": [
              "1SA.31.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
