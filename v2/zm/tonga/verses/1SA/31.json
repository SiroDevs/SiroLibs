        {
          "text": "Lino ba-Filisti bakali kulwana aba-Israyeli, nkabela bantu ba-Israyeli bakacija kuba-Filisti, bakawizuka mucilundu ca-Giliboa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.1",
            "verseOrgIds": [
              "1SA.31.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
