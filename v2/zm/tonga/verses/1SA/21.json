                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo balanda ba-Akisi bakamwaambila kuti, Sa oyu teensi Davida mwami wacisi? Sa teensi nguwe ngubakali kwaamba nibakali kuzyana akuvwiilana kuti,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.11",
            "verseOrgIds": [
