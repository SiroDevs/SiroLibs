        },
        {
          "text": "Mpawo wakasandula ziyanza zyakwe kumeso aabo, wakalisondosya-sondosya, wakagwala-gwala kuzitendele zyamilyango, akumbwembwelesya mate kucilezu cakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.13",
            "verseOrgIds": [
              "1SA.21.13"
            ]
          }
        },
