        {
          "text": "Mpawo Davida wakaambila Ahimeleki mupaizi kuti, Mwami wakandilailila makani, alimwi wakandaambila kuti, Kutabi muntu uuziba abuniini makani aya ngindakutumina, ngindakulailila. Aboobo ndibikilide balombe kuli banyomfwi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.2",
            "verseOrgIds": [
              "1SA.21.2"
            ]
          }
        },
        {
          "name": "verse",
