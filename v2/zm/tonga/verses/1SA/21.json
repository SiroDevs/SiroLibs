            }
          ]
        },
        {
          "text": "Mbuboobo Davida mbwaakanyamuka mubuzuba obo akucija kuzwa kuli-Saulo, Nkabela wakasika kuli-Akisi mwami wa-Gati. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.10",
            "verseOrgIds": [
              "1SA.21.10"
            ]
          }
        },
        {
