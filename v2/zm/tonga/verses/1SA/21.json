            "sid": "1SA 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino ujisinzi okuno? Undipe zinkwa zyosanwe nanka kufumbwa cintu ncojisi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.3",
            "verseOrgIds": [
              "1SA.21.3"
            ]
