                {
                  "text": "1 Sam 17:51",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.31.10"
              },
              "items": [
                {
                  "text": "31:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela mupaizi wakati, Mpolili ipanga lya-Goliati muFilisti, nguwe ngowakajaya mumumpata wa-Ela. Lilizambaidwe mucisani okuno kusule lyacikobela cabupaizi. Na ulayanda kulitola, litole, nkaambo taakwe limbi okuno. Mpawo Davida wakati, Taakwe limbi lili mbuli leeli, amundipe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.9",
            "verseOrgIds": [
              "1SA.21.9"
            ]
          }
        }
      ]
