            "number": "5",
            "style": "v",
            "sid": "1SA 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo Saulo wakazwa musokwe, wakali kuza bubinga iŋombe, nkabela Saulo wakabuzya wati, Ino ncinzi ncibalilila bantu? Mpawo bakamulwiida makani aabantu ba-Jabezi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.5",
            "verseOrgIds": [
              "1SA.11.5"
            ]
          }
        },
