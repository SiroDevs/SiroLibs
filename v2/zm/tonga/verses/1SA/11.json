        },
        {
          "text": "Lino wakababala mu-Bezeki nkabela bana ba-Israyeli kabali zyuulu zili myaanda yotatwe abana ba-Juda kabali zyuulu zili makumi otawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.8",
            "verseOrgIds": [
              "1SA.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela bakaambila batumwa abo ibakasika kuti, Mbuboobu mbumweelede kwaambila bantu ba-Jabezi-Gileadi, kuti, Junza lyazoobala izuba muzooba alufutuko. Lino batumwa bakaboola, bakaambila bantu ba-Jabezi aya makani, elyo bakakondwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.9",
            "verseOrgIds": [
              "1SA.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino bantu ba-Jabezi bakaamba bati, Junza tuleza nkumubede, kuti muzootucitile zyoonse nzimuyanda mumyoyo yanu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.10",
            "verseOrgIds": [
              "1SA.11.10"
            ]
          }
        }
      ]
