          "text": "Lino Samuele wakanyampuka, wakatanta kuzwa ku-Giligala kuya kuGibeya wa-Benjamini, nkabela Saulo wakabala bantu mbaakali abo, kabali mbuli myaanda iili musanu aumwi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.15",
            "verseOrgIds": [
              "1SA.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
