            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino wakalindila mazuba aali musanu aabili mbuli ciindi ncaakamubambila Samuele, pele Samuele teewakasika ku-Giligala, nkabela bantu bakamumwaika. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.8",
