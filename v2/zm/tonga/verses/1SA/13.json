          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Saulo a-Jonatani mwanaakwe abantu mbibakali abo kabakede ku-Geba wa-Benjamini, aba-Filisti kababambide malabba aabo ku-Mikimasi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.16",
            "verseOrgIds": [
              "1SA.13.16"
            ]
          }
        },
        {
