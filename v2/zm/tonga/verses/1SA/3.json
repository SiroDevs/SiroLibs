            }
          ]
        },
        {
          "text": "Lino Samuele wakalala kusikila kukuca, wakajula milyango yaŋanda ya-Jehova, Nkabela Samuele wakali kuyoowa kwaambila Eli cilengano. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.15",
            "verseOrgIds": [
              "1SA.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Limo Eli wakaita Samuele, wakaamba wati, Mwanaangu Samuele. Nkabela wakaamba wati, Mpendi! ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.16",
            "verseOrgIds": [
              "1SA.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 3:17"
          },
          "items": [
