              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.26.63"
              },
              "items": [
                {
                  "text": "Mt 26:63",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino wakabuzya wati, Makaninzi ngowaambilwa? Utasisi kulindime pe. Leza akucitile mbubonya obo akwiinda kuti wandisisa cintu niciba comwe akati kamakani oonse ngaakwaambila. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.17",
            "verseOrgIds": [
              "1SA.3.17"
            ]
          }
        },
