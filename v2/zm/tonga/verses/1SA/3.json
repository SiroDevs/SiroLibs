              "items": [
                {
                  "text": "Am 8:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino mwana Samuele wakali kumanina Jehova milimo kumeso aa-Eli, nkabela ijwi lya-Jehova lyakali kuyandika kuciindi eco, kakutakwe bulu­ nguluzi ubwakaide impuwo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.1",
            "verseOrgIds": [
              "1SA.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino buzuba bumwi Eli wakalilede kulinguwe nkabela meso aakwe akaamba kuofwaala, katakonzyi kubonesya. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.2",
            "verseOrgIds": [
              "1SA.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 3:3"
          },
