                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.24.3"
              },
              "items": [
                {
                  "text": "Lev 24:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela ilampi lya-Leza kalitana kuzima, Samuele kalede muntempele lya-Jehova nkulyakabede ibbokesi lya-Leza. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.3",
            "verseOrgIds": [
              "1SA.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Jehova wakaita Samuele, nkabela wakavuwa wati, Mpendi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.4",
            "verseOrgIds": [
              "1SA.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino wakazuzaanina kuli-Eli, wakaamba wati, Mpendi, nkaambo wandiita, Wakaamba wati, Nsiitide pe! Bweeda, ukalale. Lino wakaya, wakalala. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.5",
            "verseOrgIds": [
              "1SA.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Jehova wakaboola kabili kuongolola, wati, Samuele! Lino Samuele wakanyampuka, wakaya kuli-Eli, waamba wati, Mpendi, nkaambo wandiita! Waamba wati, Nsiitide mwanaangu. Bweeda, ukalale. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.6",
            "verseOrgIds": [
              "1SA.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.9.24"
              },
              "items": [
                {
                  "text": "Jer 9:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.19.2"
              },
              "items": [
                {
                  "text": "Inc 19:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Samuele katana kumuziba Jehova, alyalo ijwi lya-Jehova kalitana kumubonekela. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.7",
            "verseOrgIds": [
              "1SA.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo Jehova wakaboola kuongolola Samuele alwatatu, nkabela wakanyampuka, wakaya kuli-Eli, wakaamba wati, Mpendi, nkaambo wandiita! Lino Eli wakabona kuti Jehova nguuita mwana. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.8",
            "verseOrgIds": [
              "1SA.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo EH wakaambila Samuele wati, Koya, ukalale, lino akwiita uvuwe kuti, Koamba, Jehova, nkaambo mulanda wako ulaswiilila. Nkabela Samuele wakaya wakalala kulinguwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.9",
            "verseOrgIds": [
              "1SA.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.85.8"
              },
              "items": [
                {
                  "text": "Int 85:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.9.6"
              },
              "items": [
                {
                  "text": "Inc 9:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Jehova wakaboola, wakiima, woongolola mbuli ziindi zyoonse, wati, Samuele, Samuele. Mpawo Samuele wakavuwa, wati, Koamba, ikuti mulanda wako ulaswiilila.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.10",
            "verseOrgIds": [
              "1SA.3.10"
            ]
          }
        }
      ]
