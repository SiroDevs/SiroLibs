            }
          ]
        },
        {
          "text": "Nkaambo kako ndakonkezya kuluzubo lwa-Eli kuti milandu valuzubo lwa-Eli tiikonzyi kumanizigwa kucipaizyo nikuba kucituuzyo mane kukabe kutamani,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.14",
            "verseOrgIds": [
              "1SA.3.14"
            ]
          }
        }
