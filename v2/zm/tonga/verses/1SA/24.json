          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino kondikonkezezya kuli-Jehova kuti, ndaakufwa utakandimaninizizyi inyungu zyangu nikuba kundinyonyoonina izina lyangu mumukowa wataata. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.21",
            "verseOrgIds": [
              "1SA.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
