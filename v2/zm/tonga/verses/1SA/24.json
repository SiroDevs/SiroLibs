              "items": [
                {
                  "text": "Mik 7:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Jehova nguuti be mubetesi wesu, nguuti tubeteke yebo ambebo. Ulalanga ulavuninina makani aangu akundifutula kumaanza aako,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.15",
            "verseOrgIds": [
