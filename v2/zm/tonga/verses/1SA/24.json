              "items": [
                {
                  "text": "Mt 5:44",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela wakaambila Davida kuti, Webo uliluleme kwiinda ndime, nkaambo wandibweedezezya bubotu, pele mebo ndakakucitila bubi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.17",
            "verseOrgIds": [
              "1SA.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wandilwiida sunu bubotu mbuwandicitila, nkaambo Jehova walindaabide mumaanza aako, pele tokokandijaya pe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.18",
            "verseOrgIds": [
              "1SA.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na muntu wajana sinkondonyina, sa ulamuleka kuti ainke caluumuno? Jehova ulakubweedezezya bubotu nkaambo kaceeci ncondicitila sunu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.19",
            "verseOrgIds": [
              "1SA.24.19"
            ]
          }
        },
