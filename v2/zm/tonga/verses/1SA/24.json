              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Davida naakamana kwaambila Saulo aya majwi, Saulo wakati, Sa teensi ijwi lya-Davida mwanaangu? Mpawo Saulo wakatalika kulila. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.16",
            "verseOrgIds": [
              "1SA.24.16"
