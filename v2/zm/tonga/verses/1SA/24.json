          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Davida wakamukonkezezya obo, Mpawo Saulo waka ya kulimbabo, alakwe Davida abantu bakwe bakabweeda kumampangala.",
          "type": "text",
          "attrs": {
