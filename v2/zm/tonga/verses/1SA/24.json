                "loc": "2SA.9.8"
              },
              "items": [
                {
                  "text": "2 Sam 9:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino nguni ngwaza butobela mwami wa-Israyeli? Nguni ngoza butanda? Ulatobela mubwa uufwide. Ulatobela injina buyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.14",
            "verseOrgIds": [
              "1SA.24.14"
            ]
          }
        },
        {
