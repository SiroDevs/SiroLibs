                }
              ]
            }
          ]
        },
        {
          "text": "Lino ndizi kuti ncobeni nduwe ooyooba mwami. Bwami bwa-Israyeli buyooima nji mumaanza aako. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.20",
            "verseOrgIds": [
              "1SA.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
