              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo misyobo minji anzubo ziyumu ziyooboola kukuyandaula Jehova wamakamu muJerusalemu akukutontozya busyu bwa-Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.22",
