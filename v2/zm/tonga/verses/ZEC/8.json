              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu bamunzi umwi bayootamba beenzinyina bakumunzi umbi kuti, Katuya tukatontozye busyu bwa-Jehova, akuyandaula Jehova wamakamu. Atweende anywe toonse. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.21",
            "verseOrgIds": [
              "ZEC.8.21"
            ]
          }
        },
