              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuboobu mbwaamba Jehova wamakamu. Kuyoosika misyobo misyobo abantu baminzi minji. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.20",
