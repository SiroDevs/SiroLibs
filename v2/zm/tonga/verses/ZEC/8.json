              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino nsikooyoocitila bantu aba basyeede mbuli mbundakacita mumazuba aakamana pe, mbwaamba Jehova wamakamu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.11",
            "verseOrgIds": [
