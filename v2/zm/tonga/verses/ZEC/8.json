              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuboobu mbwaamba Jehova wamakamu. Nzoofutula bantu bangu bamunyika yakujwe abamunyika yakumbo. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.7",
