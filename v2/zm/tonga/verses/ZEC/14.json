                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela mubuzuba obo kuyookunka maanzi maumi kuzwa ku-Jerusalemu. Cisela cimwi cao ciyooya kulwizi lwakujwe, acisela cimwi ciyooya kulwizi lwakumbo. Taakooyooyuminina pe, mainza acilimo.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.8",
            "verseOrgIds": [
              "ZEC.14.8"
            ]
