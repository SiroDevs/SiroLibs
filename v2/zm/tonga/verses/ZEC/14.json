                "loc": "EZK.11.23"
              },
              "items": [
                {
                  "text": "Ezk 11:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.1.11"
              },
              "items": [
                {
                  "text": "Inc 1:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.1.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.3.12"
              },
              "items": [
                {
                  "text": "Joel 3:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela mubuzuba obo zituta zyakwe ziyoolyatilila acilundu ca-Elaioni cili kujwe lya-Jerusalemu. Lino cilundu ca-Elaioni ciyooandulwa akati, kuzwa kujwe akumbo kukabe mumpata mupati loko, nkabela cisela cimwi cacilundu ciyooswena kunyika, acisela cimwi ciyooswena kumusanza. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.4",
            "verseOrgIds": [
              "ZEC.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.1.1"
              },
              "items": [
                {
                  "text": "Am 1:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.24.30"
              },
              "items": [
                {
                  "text": "Mt 24:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.3.11"
              },
              "items": [
                {
                  "text": "Joel 3:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mumpata wazilundu zyangu uyoosinkwa, nkaambo mumpata wazilundu uyootana kumabazu aawo ku-Azeli. Nkabela muyoocija mbubonya mbumwakacija muzuzumo wanyika mumazuba aa-Uziya mwami wa-Juda. Mpawo Jehova Leza wangu uyoosika, abasalali boonse bayooba awe.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.5",
            "verseOrgIds": [
              "ZEC.14.5"
            ]
          }
        }
      ]
    },
    {
