        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.31.40"
              },
              "items": [
                {
                  "text": "Jer 31:40",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.3"
              },
              "items": [
                {
                  "text": "Ciy 22:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela kuyooba bantu bakede mumonya. Takukooyooba limbi lutuko pe. Jerusalemu uyookala cakuliiba.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.11",
            "verseOrgIds": [
              "ZEC.14.11"
            ]
