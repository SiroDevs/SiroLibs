            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mubuzuba obo takukooyooba impeyo niciba caanda. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.6",
            "verseOrgIds": [
              "ZEC.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.21.23"
              },
              "items": [
                {
                  "text": "Ciy 21:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi kuyooba isikati luzutu (Jehova ulizi obo), takukooyooba isikati amasiku pe, nkaambo ciindi cagogo kuyooba mumuni.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.7",
            "verseOrgIds": [
              "ZEC.14.7"
            ]
          }
        }
      ]
