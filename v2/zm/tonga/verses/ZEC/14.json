              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amubone! Buzuba bwa-Jehova buyoosika, zisaalo zyanu niziyooabwa akati kanu, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.1",
            "verseOrgIds": [
              "ZEC.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.3.2"
              },
              "items": [
                {
                  "text": "Joel 3:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Njoobunganya bamasi boonse kuzoolwisya jerusa­ lemu, nkabela munzi uyoozundwa, amaanda ayoomwayigwa, abanakazi bayootizigwa. Cisela camunzi ciyootolwa mubuzike, pele bamwi bantu basyaala tabakooyoogwisigwa mumunzi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.2",
            "verseOrgIds": [
              "ZEC.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Jehova uyoonyamuka kuyoolwisya masi ayo mbubonya mbwalwana mubuzuba bwalumamba. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.3",
            "verseOrgIds": [
              "ZEC.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
