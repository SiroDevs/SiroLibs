                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela kufumbwa musyobo wabantu baansi uubula kusika ku-Jerusalemu kukukomba Mwami Jehova wamakamu, bantu abo bayooimwa imvula. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.17",
