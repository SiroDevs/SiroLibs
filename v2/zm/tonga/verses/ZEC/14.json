                  "text": "6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Jehova uyooba mwami wanyika yoonse mubuzuba obo. Jehova uyooba omwe alike, azina lyakwe liyooba lyomwe.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.9",
