              "type": "text"
            }
          ]
        },
        {
          "text": "Alwalo luzubo lwaba-Egepita, na babula kusika kuzoolibonya, bayoopenzegwa luumo olo Jehova ndwayooumya misyobo yoonse iitasika kukulya ipobwe lyazilan. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.18",
            "verseOrgIds": [
              "ZEC.14.18"
            ]
          }
        },
        {
          "name": "verse",
