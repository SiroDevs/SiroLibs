              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuboobo mbubayoopegwa mulandu, ba-Egepita abantu bamasi oonse batasiki kukulya ipobwe lyazilao.",
          "type": "text",
          "attrs": {
