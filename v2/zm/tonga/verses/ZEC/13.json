              },
              "items": [
                {
                  "text": "Mk 14:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Buka, ipanga, ukalwisye mweembeli wangu ayooyo ngutubambene awe, mbwaamba Jehova wamakamu. Uma mweembeli, kuti imbelele zimwaike, atwana njootuumya ijanza lyangu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.7",
            "verseOrgIds": [
              "ZEC.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.11.5"
              },
              "items": [
                {
                  "text": "Rom 11:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino moonse munyika, mbwaamba Jehova, akati kabatatu bobile bayooloba awatatu uyoosyaala. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.8",
            "verseOrgIds": [
              "ZEC.13.8"
            ]
          }
        },
