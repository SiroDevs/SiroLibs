                "loc": "2PE.2.1"
              },
              "items": [
                {
                  "text": "2 Pet 2:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela mubuzuba obo, mbwaamba Jehova wamakamu njoolobya mazina aamituni yamunyika, kuti atakayeeyegwi limbi. Abalo basinsimi amuuya uusofweede boonse njoobagwisya munyika. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.2",
            "verseOrgIds": [
              "ZEC.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.13.6"
              },
              "items": [
                {
                  "text": "Dt 13:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino na kukaboneke limbi muntu uusinsima-sinsima, wisi abanyina ibakamuzyala bayoomwaambila kuti, Tokooyoopona pe, nkaambo waamba zyakubeja muzina lyaJehova. Nkabela wisi abanyina ibakamuzyala bayoomuyasa mukusinsima kwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.3",
            "verseOrgIds": [
              "ZEC.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubuzuba obo basinsimi boonse bayoofwa bweeme, umwi aumwi nkaambo kacilengano cakwe mukusinsima kwakwe. Takooyoosama cikobela caboya cakweena bantu pe. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.4",
            "verseOrgIds": [
              "ZEC.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyooamba kuti, Mebo nsili musinsimi pe, ndi mulimi wanyika nkaambo nyika ncecaabilo cangu kuzwa kubucece bwangu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.5",
            "verseOrgIds": [
              "ZEC.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi na wabuzigwa kuti, Ani ezi zyuuno zili mumaanza aako nzinzi? uyoovuwa kuti, Nzenzizyo zyuumo nzindakaumwa muŋanda yabeenzuma.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.6",
            "verseOrgIds": [
              "ZEC.13.6"
            ]
          }
        }
      ]
