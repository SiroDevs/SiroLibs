            }
          ]
        },
        {
          "text": "Mubuzuba obo luzubo lwa-Juda abantu bakede mu-Jerusalemu bayoojalwidwa kasensa kakusalazya zibi abusofwaazi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.1",
