            }
          ]
        },
        {
          "text": "Elyo angelo wakaambila abo mbaakaimvwi abo kuti, Amumusamunune zikobela ezi zyamatombe. Mpawo wakaambila Joshua kuti, Bona! ndakugwisizya milandu yako. Njookusamika zyakusama zibotu zyeebesi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.4",
            "verseOrgIds": [
              "ZEC.3.4"
            ]
          }
        },
        {
