                  "text": "Muk 2:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndakaamba mumoyo wangu kuti, Ncobeni ndajana busongo kwiinda boonse ibakanditaangunina kweendelezya mu-Jerusalemu, amoyo wangu ulibwene maanu manji aluzibo lunji ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.16",
            "verseOrgIds": [
              "ECC.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.2.3"
              },
              "items": [
                {
                  "text": "Muk 2:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.5.21"
              },
              "items": [
                {
                  "text": "1 Tes 5:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndakabika moyo wangu kuti mbe aluzibo abusongo, akuziba bufubafuba mbububede, pele ndajana kuti eci acalo tacikutyi moyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.17",
            "verseOrgIds": [
              "ECC.1.17"
            ]
          }
        },
