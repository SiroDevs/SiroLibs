              },
              "items": [
                {
                  "text": "Rom 8:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nzyabuyobuyo! mbwaamba Mukambausi, Nzyabuyobuyo! Zyoonse nzyabuyo, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.2",
            "verseOrgIds": [
              "ECC.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.3.9"
              },
              "items": [
                {
                  "text": "Muk 3:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Muntu ulajana impindunzi kumilimo yakwe yoonse njaabeleka ansi? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.3",
            "verseOrgIds": [
              "ECC.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.104.5"
              },
              "items": [
                {
                  "text": "Int 104:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.3.10"
              },
              "items": [
                {
                  "text": "2 Pet 3:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Musela umwi ulamana, kulasika umbi, pele nyika inookede lyoonse. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.4",
            "verseOrgIds": [
              "ECC.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.19.5"
              },
              "items": [
                {
                  "text": "Int 19:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Izuba lilazwa, izuba lilabbila, lilafwambaana kupiluka oko nkulyazwida. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.5",
            "verseOrgIds": [
              "ECC.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.8"
              },
              "items": [
                {
                  "text": "Joh 3:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Muuwo ulaunga kumusanza, alimwi ulapiluka akuunga kunyika; muuwo ulazyunguluka mukweendeenda kwawo, ulapiluka nkowakatalikila. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.6",
            "verseOrgIds": [
              "ECC.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.38.10"
              },
              "items": [
                {
                  "text": "Job 38:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.104.8"
              },
              "items": [
                {
                  "text": "Int 104:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Milonga yoonse ilatola kulwizi lupati, nekubaboobo lwizi taluzuli: milonga ilapiluka nkukonya oko nkuyakatalikila. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.7",
            "verseOrgIds": [
              "ECC.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.3.1"
              },
              "items": [
                {
                  "text": "Muk 3:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.27.20"
              },
              "items": [
                {
                  "text": "Tus 27:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Zintu zyoonse zyakataala, citaambiki. Liso talikonzyi kulamwa kukubona kwalyo, akwalo kutwi takukonzyi kukuta kukuswiilila. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.8",
            "verseOrgIds": [
              "ECC.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.8.22"
              },
              "items": [
                {
                  "text": "Matl 8:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.3.15"
              },
              "items": [
                {
                  "text": "Muk 3:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Icakaba kale nceciyooba, icakacitika kale nceciyoocitwa. Taakwe cintu niciba comwe cipya ansi ano. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.9",
            "verseOrgIds": [
              "ECC.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sa nkucili cintu caambwa kuti, Bona, eci ncipya? Ncobeni cakaba kale muziindi zyakamana. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.10",
            "verseOrgIds": [
              "ECC.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu baciindi tabaciyeeyegwi, abaabo baciboola tabakooyooyeeyegwa kulibaabo beza kusule lyabo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.11",
            "verseOrgIds": [
              "ECC.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
