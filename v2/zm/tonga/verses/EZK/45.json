        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.44.15"
              },
              "items": [
                {
                  "text": "Ezk 44:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uyooba caabilo canyika cisalala; uyooba wabapaizi basimilimo bamuŋanda ya-Jehova baswena kuliJehova kukumukutaukila; uyoobabeda mwenya wakuyaka maanda abusena busalala bwacikombelo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.4",
            "verseOrgIds": [
              "EZK.45.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
