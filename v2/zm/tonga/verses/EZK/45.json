              "items": [
                {
                  "text": "40:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Acaabilo cimwi, cili abulamfu bwatukokola tuli zyuulu zili makumi obile amusanu abwaamba bwatukokola tuli ikumi, ciyooba caba-Levi babeleka milimo yaŋanda, bacivube akuyaka minzi yakukala mumo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.5",
            "verseOrgIds": [
              "EZK.45.5"
            ]
          }
        }
