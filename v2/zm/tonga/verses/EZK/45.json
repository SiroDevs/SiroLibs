        {
          "text": "Lino nceeci cipaizyo ncimweelede kutuula: cipanzi camusanu acimwi cacisuwo cigwisigwa muhomeri limwi alimwi lyabulotwe, acipanzi camusanu acimwi cacisuwo cigwisigwa muhomeri limwi alimwi lyabbaale. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.13",
            "verseOrgIds": [
              "EZK.45.13"
            ]
          }
        },
        {
          "name": "verse",
