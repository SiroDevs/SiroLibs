          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akumbali kubambene amugaano wa-Simeoni, kuzwa kujwe kusikila kumbo, ba-Isakara bayoopegwa caabilo comwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.25",
            "verseOrgIds": [
