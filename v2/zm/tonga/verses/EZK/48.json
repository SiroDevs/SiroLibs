                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "amilyango yamunzi iyooambwa mbubonya mbuli mazina aamisyobo yabana ba-Israyeli. Kulubazu lwakunyika kuyooba milyango yotatwe: mulyango wa-Rubeni, mulyango wa-Juda amulyango wa-Levi, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.31",
            "verseOrgIds": [
              "EZK.48.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
