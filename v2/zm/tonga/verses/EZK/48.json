            }
          ]
        },
        {
          "text": "Amisyobo imwi iisyeede njeeyi. Kuzwa kujwe kusikila kumbo, baBenjamini bayoopegwa caabilo comwe, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.23",
            "verseOrgIds": [
