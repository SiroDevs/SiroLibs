              "items": [
                {
                  "text": "Lev 27:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tabeelede kuulisya nekuba kucincana cipanzi neciba ciniini mukati kaco; tabeelede kuswekelwa nyika niiba imwi mulincico, nkaambo cilasalala mumeso aa-Jehova,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.14",
            "verseOrgIds": [
              "EZK.48.14"
            ]
          }
        }
