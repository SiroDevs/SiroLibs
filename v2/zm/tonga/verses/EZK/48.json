          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akumbali kubambene amugaano wa-Zebuloni, kuzwa kujwe kusikila kumbo, ba-Gadi bayoopegwa caabilo comwe. ",
          "type": "text",
          "attrs": {
