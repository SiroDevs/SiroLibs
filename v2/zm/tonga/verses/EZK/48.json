          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumbali kubambene amugaano wa-Isakara, kuzwa kujwe kusikila kumboyba-Zebuloni bayoopegwa caabilo comwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.26",
