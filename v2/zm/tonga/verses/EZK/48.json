                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ngaaya mazina aamisyobo. Kumagolelo aakunyika, kuzwa ku-Lwizi akwiinda ku-Hatiloni kusikila kumanjililo aa-Hamati akusikila ku-Hazari-enoni (uuli kumugaano wakunyika wa-Damasko, uulangene a-Hamati), koonse koonse kujwe akumbo ba-Dani bayoopegwa caabilo comwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.1",
            "verseOrgIds": [
              "EZK.48.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 48:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino kumbali kubambene amugaano wa-Dani, kuzwa kujwe kusikila kumbo, ba-Aseri bayoopegwa caabilo comwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.2",
            "verseOrgIds": [
              "EZK.48.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 48:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akumbali kubambene amugaano wa-Aseri, kuzwa kujwe kusikila kumbo, ba-Nafitali bayoopegwa caabilo comwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.3",
            "verseOrgIds": [
              "EZK.48.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 48:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akumbali kubambene amugaano wa-Nafitali, kuzwa kujwe kusikila kumbo, ba-Manase bayoopegwa caabilo comwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.4",
            "verseOrgIds": [
              "EZK.48.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 48:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akumbali kubambene amugaano wa-Manase, kuzwa kujwe kusikila kumbo, ba-Efraimu bayoopegwa caabilo comwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.5",
            "verseOrgIds": [
              "EZK.48.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 48:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akumbali kubambene amugaano wa-Efraimu, kuzwa kujwe kusikila kumbo, ba-Rubeni bayoopegwa caabilo comwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.6",
            "verseOrgIds": [
              "EZK.48.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akumbali kubambene amugaano wa-Rubeni, kuzwa kujwe kusikila kumbo, ba-Juda bayoopegwa caabilo comwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.7",
            "verseOrgIds": [
              "EZK.48.7"
            ]
          }
        }
      ]
    },
