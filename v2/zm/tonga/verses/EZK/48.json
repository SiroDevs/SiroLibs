          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyika yamunzi iyooba akatikati kanyika yasilutwe. Nyika yasilutwe iyooba akatikati kacaabilo ca-Juda acaabilo ca-Benjamini,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.22",
