          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino kumbali kubambene amugaano wa-Benjamini, kuzwa kujwe kusikila kumbo, ba-Simeoni bayoopegwa caabilo comwe, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.24",
            "verseOrgIds": [
              "EZK.48.24"
            ]
          }
        },
        {
          "name": "verse",
