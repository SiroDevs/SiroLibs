                  "text": "8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eci ciyooba cabapaizi basalala, bana ba-Zadoki, ibakabamba imbeta zyangu kuciindi eco bana ba-Israyeli nebakaleya, abalo ba-Levi nebakaleya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.11",
            "verseOrgIds": [
              "EZK.48.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 48:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ciyoobabeda caabilo mukati kacaabilo cisalalisya canyika cibambene amugaano waba-Levi, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.12",
            "verseOrgIds": [
              "EZK.48.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 48:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino kuntu kubambene amugaano wabapaizi, ba-Levi bayoopegwa caabilo; bulamfu bwaco buyooba tukokola tuli zyuulu zili makumi obile amusanu, abwaamba bwaco buyooba tukokola tuli zyuulu zili ikumi. Aboobo bulamfu boonse buyooba zyuulu zili makumi obile amusanu, abwaamba buyooba zyuulu zili makumi obile. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.13",
            "verseOrgIds": [
              "EZK.48.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
