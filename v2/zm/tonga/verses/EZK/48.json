          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwalo kulubazu lwakujwe, bulamfu buyooba tukokola tuli zyuulu zyone amyanda yosanwe, amilyango iyooba itatu: mulyango wa-Josefa, mulyango wa-Benjamini, amulyango wa-Dani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.32",
            "verseOrgIds": [
              "EZK.48.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
