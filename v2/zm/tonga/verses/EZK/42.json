        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.9",
            "verseOrgIds": [
              "EZK.42.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 42:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi kulubazu lwakumusanza, kunembo lyalubuwa, kunembo lyamayake, akooko kakuli twaanda, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.10",
            "verseOrgIds": [
              "EZK.42.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 42:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "anzila kunembo lyato; twakali mbubonya mbuli twaanda twakunyika; bulamfu bwato abwaamba bwato, manjililo aato abube bwato amilyango yato, muzintu zyoonse katukozyene atumwi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.11",
            "verseOrgIds": [
              "EZK.42.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 42:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akunsi lyatwaanda twakumusanza kakuli manjililo kulubazu lwakujwe, nkukonya oko mwenya wakwiinda nkuunjililwa, akulubazu lulangene kakuli lubaya lwakwaandaanya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.12",
            "verseOrgIds": [
              "EZK.42.12"
            ]
          }
        }
      ]
    },
