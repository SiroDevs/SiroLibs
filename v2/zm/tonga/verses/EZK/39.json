                "loc": "REV.19.17+REV.19.18"
              },
              "items": [
                {
                  "text": "Ciy 19:17-18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino yebo O mwana amuntu, mbuboobu mbwaamba Mwami Jehova. Ambila bayuni bamisyobo yoonse abanyama boonse bamusokwe. Amba kuti, Amubungane, muboole, Amuyoboloke kuzwa kumabazu oonse kucipaizyo ncendi mukumubambila. Ncipaizyo cipati loko atala lyazilundu zya-Israyeli. Muyoolya nyama akunywa bulowa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.17",
            "verseOrgIds": [
              "EZK.39.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 39:18"
          },
