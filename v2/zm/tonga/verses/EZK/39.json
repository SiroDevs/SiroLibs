            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.19.17+REV.19.18+REV.19.19+REV.19.20+REV.19.21"
              },
              "items": [
                {
                  "text": "Ciy 19:17-21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Atala lyazilundu zya-Israyeli mpoti wide, yebo amakamu aako oonse abantu boonse mboli abo. Njookwaaba mumilomo yabayuni bamisyobo misyobo ayabanyama bamusokwe, kuti bakumanisye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.4",
            "verseOrgIds": [
              "EZK.39.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 39:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyoowida musokwe antangalala buyo, nkaambo mbuboobo mbundaamba, mbwaamba Mwami Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.5",
            "verseOrgIds": [
              "EZK.39.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 39:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.1.4"
              },
              "items": [
                {
                  "text": "Am 1:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.72.10"
              },
              "items": [
                {
                  "text": "Int 72:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi njootuma mulilo kuliMagogi akulibaabo bakede cakuliiba muzisi zyakunkomwe yalwizi, elyo bayooziba kuti ndime Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.6",
            "verseOrgIds": [
              "EZK.39.6"
            ]
          }
        }
      ]
