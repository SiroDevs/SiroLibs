              },
              "items": [
                {
                  "text": "Ezk 38:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino yebo, O mwana amuntu, sinsima aa-Gogo. Amba kuti, Mbuboobu mbwaamba Mwami Jehova. Bona! Ndi sinkondonyoko, O Gogo, silutwe mupati wa-Meseki a-Tubali. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.1",
            "verseOrgIds": [
              "EZK.39.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 39:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njookupilusya, njookweenzya njookuleta kuzwa kumagolelo aakunyika, njookusisya kuzilundu zya-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.2",
            "verseOrgIds": [
              "EZK.39.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 39:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino njookuumina buta bwako mujanza lyako lyalumwensi, akuwisya mivwi mujanza lyako lyalulyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.3",
            "verseOrgIds": [
              "EZK.39.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 39:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.34.2+ISA.34.3+ISA.34.4+ISA.34.5+ISA.34.6+ISA.34.7+ISA.34.8"
              },
              "items": [
                {
                  "text": "Is 34:2-8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
