              "attrs": {
                "loc": "EZK.38.16"
              },
              "items": [
                {
                  "text": "Ezk 38:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Izina lyangu lisalala njoocita kuti libe ampuwo akati kabantu ba-Israyeli. Nsikooyoozumizya izina lyangu lisalala kusampaulwa limbi, nkabela bamasi bayooziba kuti ndime Jehova, Uusalala wa-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.7",
            "verseOrgIds": [
              "EZK.39.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.7.3+EZK.7.4+EZK.7.5+EZK.7.6+EZK.7.7+EZK.7.8"
              },
              "items": [
                {
                  "text": "Ezk 7:3-8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.38.17"
              },
              "items": [
                {
                  "text": "38:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ncobeni makani aleza, alaba mbubonya obo, mbwaamba Mwami Jehova. Mbubuzuba obo mbondakaamba,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.8",
            "verseOrgIds": [
              "EZK.39.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.8",
            "verseOrgIds": [
              "EZK.39.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 39:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino bantu bakede muminzi ya-Israyeli bayooinka kuyoolundika zilwisyo mumililo akuzitenta. Zitabilizyo antobo, mata amivwi, tuleba amyuumba, bayoozitenta zyoonse buyo. Ziyooba inkuni zyabo myaka iili musanu aibili. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.9",
            "verseOrgIds": [
              "EZK.39.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 39:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.14.2"
              },
              "items": [
                {
                  "text": "Is 14:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tabakooyootebba inkuni musokwe nekuba kugonka muzisaka pe, nkaambo zilwisyo nzeziyooba inkuni zyabo. Bayoosaala basikubasaala akunyanzya basikubanyanzya, mbwaamba Mwami Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.10",
            "verseOrgIds": [
              "EZK.39.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 39:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.10",
            "verseOrgIds": [
              "EZK.39.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 39:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubuzuba obo njoopa Gogo busena bwamavwiko mucisi ca-Israyeli, Ikuti lya-Basilweendo kujwe lyakulwizi, nkabela buyoosinkila beenda inzila, nkaambo nkukonya oko nkubayoozika Gogo amakamu aakwe oonse. Bayoobuulika kuti ndikuti lya-Makamu aa-Gogo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.11",
            "verseOrgIds": [
              "EZK.39.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 39:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.21.23"
              },
              "items": [
                {
                  "text": "Dt 21:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Myezi iili musanu aibili luzubo lwa-Israyeli lunoobavwika, kuti basalazye nyika. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.12",
            "verseOrgIds": [
              "EZK.39.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 39:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.126.2"
              },
              "items": [
                {
                  "text": "Int 126:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bantu boonse buyo banyika bayoobavwika, nkabela aya makani ayoobabeda impuwo mubuzuba bwakulemekwa kwangu, mbwaamba Mwami Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.13",
            "verseOrgIds": [
              "EZK.39.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 39:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayoobika bantu batajisi milimo imwi cita kuya bweendeenda moonse munyika akuvwika abo bacisyeede atala anyika, kuti baisalazye. Yamana myezi iili musanu aibili, bayoolingula nyika; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.14",
            "verseOrgIds": [
              "EZK.39.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 39:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "basikweenda banooya bweenda munyika, nkabela kufumbwa muntu uubona cifuwa camuntu uyoobika citondezyo kumbali lyaco mane basikuvwika bakamane kucivwika mukuti lya-Makamu aa-Gogo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.15",
            "verseOrgIds": [
              "EZK.39.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 39:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awalo munzi wakooko uyootegwa Hamona. Mbuboobo mbubayoosalazya nyika.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.16",
            "verseOrgIds": [
              "EZK.39.16"
            ]
          }
        }
      ]
    },
