        },
        {
          "text": "Lino ijwi lya-Jehova lyakandisikila, liti, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.1",
            "verseOrgIds": [
              "EZK.15.1"
            ]
          }
        },
