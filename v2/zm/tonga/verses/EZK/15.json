                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.10.1"
              },
              "items": [
                {
                  "text": "Hos 10:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "O mwana amuntu, Musamu wamusaansa ulainda buti misamu yoonse? Uli amilimonzi mutabi wamusaansa uucelwa akati kamisamu yalusaka? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.2",
            "verseOrgIds": [
              "EZK.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sa zisamu zyawo zilabelesegwa mumilimo? Sa kulinzizyo kula temwa inembe yakwaanzikila zintu? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.3",
            "verseOrgIds": [
              "EZK.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.6"
              },
              "items": [
                {
                  "text": "Joh 15:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ncobeni ziladukuzigwa mulilo. Lino mulilo ulote buyo impela zyazyo, alimwi akatikati kazyo apya, sa zicijisi mulimo? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.4",
            "verseOrgIds": [
              "EZK.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "We! Nizyakacilungene kazitajisi milimo, lino mulilo umane kuzilotya, kusyaale itwe buyo, zilainda loko kusampuka. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.5",
            "verseOrgIds": [
              "EZK.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kako mbuboobu mbwaamba Mwami Jehova. Mbubonya mbuli musamu wamusaansa akati kamisamu yamulusaka, ngundadukuzya mulilo, ndacitila bantu bakede mu-Jerusalemu mbubonya obo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.6",
            "verseOrgIds": [
              "EZK.15.6"
            ]
          }
        },
