                  "text": "7:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Njoobalanga cankayikayi. Nekuba kuti bacija mulilo, mulilo uyoobajata. Lino kuciindi eco ninjoobalanga cankayikayi, muyooziba kuti ndime Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.7",
            "verseOrgIds": [
              "EZK.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njoocita kuti nyika ibe matongo nkaambo kakukataazya kwabo, mbwaamba Mwami Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.8",
            "verseOrgIds": [
              "EZK.15.8"
            ]
          }
        }
