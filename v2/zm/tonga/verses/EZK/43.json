              "items": [
                {
                  "text": "Kul 29:35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mazuba aali musanu aabili uleelede kubamba impongo yacipaizyo cazibi buzuba bumwi abumwi, alimwi baleleede kubamba mupoho waŋombe amugutu wambelele, boonse batakwe kampenda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.25",
            "verseOrgIds": [
              "EZK.43.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
