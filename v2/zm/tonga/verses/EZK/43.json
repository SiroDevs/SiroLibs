          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino uleelede kubweza bulowa bwakwe akulamba-lamba ameja one aacipaililo akuzyooko zyone zyacaanzikilo akumoombe koonse koonse. Mbuboobo mbomweelede kucisalazya akucitontozya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.20",
            "verseOrgIds": [
              "EZK.43.20"
            ]
          }
        },
        {
          "name": "verse",
