          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazuba aali musanu aabili baleelede kutontozya cipaililo akucisalazya akucibamba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.26",
