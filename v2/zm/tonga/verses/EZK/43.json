                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aba uleelede­ kubatuula kubusyu bwa-Jehova, nkabela bapaizi baleelede kubalunga munyo akubatuula babe cipaizyo kuli-Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.24",
            "verseOrgIds": [
              "EZK.43.24"
            ]
          }
        },
        {
