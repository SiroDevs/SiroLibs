            "number": "6",
            "style": "v",
            "sid": "EZK 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbelele zyangu zyakamwaika, zyakali kuya butuntulika azilundu zyoonse amalundu oonse malamfu. Imbelele zyangu zyakamwaisigwa munyika yoonse buyo, nkabela katakwe muntu iwakali kuziyandaula na kuzilangaula.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.6",
            "verseOrgIds": [
              "EZK.34.6"
            ]
          }
        }
