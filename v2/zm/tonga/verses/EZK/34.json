            "number": "8",
            "style": "v",
            "sid": "EZK 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ncobeni mbundi muumi, mbwaamba Mwami Jehova, ndibwene kuti imbelele zyangu zyaba zisaalo, imbelele zyangu zyaba zilyo zyabanyama boonse bamusokwe, nkaambo kakubula mweembeli, nkaambo beembeli bangu tabana kuyandaula imbelele, alimwi beembeli balisanina beni, tabasanini imbelele. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.8",
            "verseOrgIds": [
              "EZK.34.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kako amuswiilile ijwi lya-Jehova, nobeembeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.9",
            "verseOrgIds": [
