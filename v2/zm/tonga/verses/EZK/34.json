              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kako njoofutula imbelele zyangu, kuti zitabi limbi cisaalo, nkabela njoobeteka makani aambelele ambelelenyina. ",
          "type": "text",
          "attrs": {
