          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulaya butonta amakuko aanu amabazu aanu, mulatanda zilebulukide ameja aanu mane lumwi mwazimwaisya anze. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.21",
