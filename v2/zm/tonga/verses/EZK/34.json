        {
          "text": "Zyakamwaika nkaambo kakubula mweembeli, nkabela zyakaba zilyo zyabanyama boonse bamusokwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.5",
            "verseOrgIds": [
