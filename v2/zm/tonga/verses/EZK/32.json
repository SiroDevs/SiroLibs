          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njoopenzya myoyo yabantu banji nenjookutola mubuzike akati kabamasi, munyika zimbi nzotezi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.9",
            "verseOrgIds": [
              "EZK.32.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
