              },
              "items": [
                {
                  "text": "29:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Makamu aabantu bako, njoobawisya boonse kuma panga aabasintaze, bantu bayoosya akati kabamasi. Bayoomanisya kulisumpula kwacisi ca-Egepita akunyonyoona makamu makamu aabantu baco. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.12",
            "verseOrgIds": [
              "EZK.32.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 32:13"
          },
          "items": [
