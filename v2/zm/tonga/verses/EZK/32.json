              "items": [
                {
                  "text": "2 Mak 35:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.26.17"
              },
              "items": [
                {
                  "text": "Ezk 26:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndoolo lwiimbo lwakulizya. Bana basimbi babamasi bayoolwiimbya. Bayoolwiimbya cakulila cisi ca-Egepita amakamu makamu aabantu baco, mbwaamba Mwami Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.16",
            "verseOrgIds": [
              "EZK.32.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 32:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.16",
            "verseOrgIds": [
              "EZK.32.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 32:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mumwaka wakumi aibili, mumwezi mutaanzi, mubuzuba bwakumi amusanu bwamumwezi, ijwi lya-Jehova lyakandisikila, liti, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.17",
            "verseOrgIds": [
              "EZK.32.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 32:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.1.10"
              },
              "items": [
                {
                  "text": "Jer 1:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.26.20"
              },
              "items": [
                {
                  "text": "Ezk 26:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "O mwana amuntu, kolila makamu aabantu bacisi ca-Egepita. Kociselusya, calo abana basimbi babamasi balemu, munyika yakwacimvumwe, antoomwe abaabo baselukila mucilindi: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.18",
            "verseOrgIds": [
              "EZK.32.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 32:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.31.2"
              },
              "items": [
                {
                  "text": "Ezk 31:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.28.10"
              },
              "items": [
                {
                  "text": "28:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sa nkwali naba omwe ngoinda mububotu bwaciwa cako? Seluka, ukalale abatapalwidwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.19",
            "verseOrgIds": [
              "EZK.32.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 32:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayoowa akati kabajayidwe apanga. Makamu makamu aabantu bakwe, boonse buyo bayoolala awe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.20",
            "verseOrgIds": [
              "EZK.32.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 32:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bapati babasinguzu bayoomwaambila, walo abasikumugwasya, kuzwa mucikalilo cabafu mobabede. Baseluka, balilede, aba batapalwidwe, balijayidwe apanga.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.21",
            "verseOrgIds": [
              "EZK.32.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 32:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.21",
            "verseOrgIds": [
              "EZK.32.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 32:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asuri nkwali, Uli ambungano yakwe yoonse. Tubanda twabo tulizyungulukide. Boonse buyo balijayidwe. Ipanga ndelyakabawisya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.22",
            "verseOrgIds": [
              "EZK.32.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 32:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tubanda twabo tulibikidwe kumagolelo aacilindi. Imbungano yabantu bakwe, boonse balizyungulukide kabanda kakwe. Boonse balijayidwe. Ipanga ndelyakabawisya, aba boonse ibakali kuyoosya munyika yabaumi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.23",
            "verseOrgIds": [
              "EZK.32.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 32:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.23",
            "verseOrgIds": [
              "EZK.32.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 32:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elamu nkwali. Uli ambungano yakwe yoonse. Balizyungulukide kabanda kakwe, Boonse buyo balijayidwe, Ipanga ndelyakabawisya. Baselukila munyika yakwacimvumwe kabatapalwidwe, aba ibakali kuyoosya munyika yabaumi. Batolelela insoni zyabo antoomwe abaabo baselukila mucilindi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.24",
            "verseOrgIds": [
              "EZK.32.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 32:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamuyalila bulo akati kabajayidwe. Makamu makamu aabantu bakwe, tubanda twabo tulimuzyungulukide. Boonse balijayidwe apanga, kabatapalwidwe. Nkaambo mbombabo bakali kuyoosya munyika yabaumi, aboobo batolelela insoni zyabo antoomwe abaabo baselukila mucilindi. Balilazikidwe akati kabajayidwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.25",
            "verseOrgIds": [
              "EZK.32.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 32:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.25",
            "verseOrgIds": [
              "EZK.32.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 32:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meseki a-Tubala nkubali, ankamu zyabo zyoonse. Tubanda twabotulizyungulukide. Boonse balijayidwe apanga, kabatapalwidwe, nkaambo mbombabo bakali kuyoosya munyika yabaumi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.26",
            "verseOrgIds": [
              "EZK.32.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 32:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tabakoolala abaalumi basintaze bakalekale ibakajayidwe, ibakaselukila mucikalilo cabafu azilwisyo zyabo zyankondo, ibakabikilwa mapanga aabo kumitwe, antobo zyabo zyakabikwa atala azifuwa zyabo. Nkaambo baalumi basintaze bakali kuyoosya munyika yabaumi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.27",
            "verseOrgIds": [
              "EZK.32.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 32:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayebo uyootyolwa akulila akati kabatapalwidwe, abaabo bajayidwe apanga.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.28",
            "verseOrgIds": [
              "EZK.32.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 32:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.28",
            "verseOrgIds": [
              "EZK.32.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 32:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Edomu nkwali, abami bakwe abasilutwe bakwe boonse. Bakali basinguzu, nekuboobo abalo balilazikidwe abaabo bajayidwe apanga. Balilede antoomwe abatapalwidwe abaabo baselukila mucilindi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.29",
            "verseOrgIds": [
              "EZK.32.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 32:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.29",
            "verseOrgIds": [
              "EZK.32.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 32:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bapati bacisi cakunyika nkobali boonse, aba-Sidoni boonse. Bakali kuyoosya bantu kunguzu zyabo, nekubaboobo abalo baseluka cansoni abajayidwe. Balilede kabatapalwidwe antoomwe abaabo bajayidwe apanga, batolelela insoni zyabo abaabo baselukila mucilindi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.30",
            "verseOrgIds": [
              "EZK.32.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 32:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.30",
            "verseOrgIds": [
              "EZK.32.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao ababone buyo, uyoolyuumuzya nkaambo kamakamu aabantu bakwe ibakajayidwe apanga, Farao ampi yakwe yoonse, mbwaamba Mwami Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.31",
            "verseOrgIds": [
              "EZK.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo wakali kuyoosya bantu munyika yabaumi, aboobo uyoolazikwa akati kabatapalwidwe abaabo bajayidwe apanga, nkokuti Farao amakamu oonse aabantu bakwe, mbwaamba Mwami Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.32",
            "verseOrgIds": [
              "EZK.32.32"
            ]
          }
        }
      ]
    }
