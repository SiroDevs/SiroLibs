              },
              "items": [
                {
                  "text": "Ezk 29:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Njoonyonyoona iŋombe zyabo zyoonse zili kumbali lyamaanzi manji. Zituta zyabantu tazikooyooavundaanya limbi, azyalo insumba zyaŋombe tazikooyooavundaanya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.13",
            "verseOrgIds": [
              "EZK.32.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 32:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aboobo njoonjolomya maanzi aabo, amilonga yabo njoocita kuti ikunke mbuli mafuta, mbwaamba Mwami Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.14",
            "verseOrgIds": [
              "EZK.32.14"
            ]
          }
        },
