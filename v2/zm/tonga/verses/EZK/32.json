        },
        {
          "text": "Lino njookuwaala ansi, njookusowela antangalala, njoocita kuti bayuni boonse bakujulu bakale alinduwe, abalo banyama boonse baansi bayookuta kukukulya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.4",
            "verseOrgIds": [
              "EZK.32.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
