              },
              "items": [
                {
                  "text": "Ezk 31:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Njoobika nyama yako atala lyazilundu, amakuti njooazuzya mutunta wako. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.5",
            "verseOrgIds": [
              "EZK.32.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 32:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyika yoonse akusikila kuzilundu, njooinywisya bulowa bwako, atulonga tuyoozula nduwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.6",
            "verseOrgIds": [
              "EZK.32.6"
            ]
          }
        },
