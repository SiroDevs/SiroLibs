                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbuboobu mbwaamba Mwami Jehova. Njookuvumbya buzamba bwangu, antoomwe amakamu makamu aabantu, nkabela bayookuzuba mukoombe kangu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.3",
            "verseOrgIds": [
              "EZK.32.3"
            ]
          }
        },
