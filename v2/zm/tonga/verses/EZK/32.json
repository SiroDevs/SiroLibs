            }
          ]
        },
        {
          "text": "Nenjookuzimya, njoovumba ijulu akusizya inyenyeezi zyalyo, Njoovumba izuba amayoba, awalo mwezi tuukooyoomunika. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.7",
            "verseOrgIds": [
              "EZK.32.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mimuni yoonse iimweka mujulu, njooisizya amutwe wako, akukubika mumudima munyika yako, mbwaamba Mwami Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.8",
            "verseOrgIds": [
              "EZK.32.8"
            ]
