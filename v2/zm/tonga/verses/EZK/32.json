              },
              "items": [
                {
                  "text": "26:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Njoocita kuti misyobo minji yabantu igambe nkaambo kako, abami babo bayookankama kukukubona nenzoovuumya ipanga lyangu kumeso aabo. Bayookankama cakutaleka, nkaambo balayoowa kuswekelwa maumi aabo, mubuzuba bwabuwe bwako. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.10",
            "verseOrgIds": [
              "EZK.32.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 32:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.46.26"
              },
              "items": [
                {
                  "text": "Jer 46:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo mbuboobu mbwaamba Mwami Jehova. Ipanga lyamwami wa-Babuloni liyookusikila. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.11",
            "verseOrgIds": [
              "EZK.32.11"
            ]
          }
        },
        {
