            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.9.16"
              },
              "items": [
                {
                  "text": "Int 9:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Muyoowa kupanga. Njoomubeteka kumugaano wa-Israyeli, nkabela muyooziba kuti ndime Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.10",
            "verseOrgIds": [
              "EZK.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.39.6"
              },
              "items": [
                {
                  "text": "Jer 39:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Munzi uno tuukooyooba kanabwao kanu, anywebo tamukooyooba nyama mukati kawo. Njoomubeteka kumugaano wa-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.11",
            "verseOrgIds": [
              "EZK.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 11:12"
          },
          "items": [
            {
