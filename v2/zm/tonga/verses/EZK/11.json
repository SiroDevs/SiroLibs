                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Muuya wakandisumpula, wandisisya kumulyango wakujwe waŋanda ya-Jehova, uulangide kubuzwezuba, nkabela oko kumanjililo aamulyango ndakabona bantu bali makumi obile amusanu, alimwi akati kabo ndakabona Jazaniya mwana wa-Azuri a-Pelatiya mwana wa-Benaya, basilutwe babantu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.1",
            "verseOrgIds": [
              "EZK.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela wakandaambila kuti, O mwana amuntu, mbaaba bantu bayeeya bubi akupa lulayo lubi mumunzi uno. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.2",
            "verseOrgIds": [
              "EZK.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.1.13"
              },
              "items": [
                {
                  "text": "Jer 1:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Balaamba kuti, Ciindi cakuyaka maanda tacina kusika. Munzi nkanabwao, aswebo tuli nyama. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.3",
            "verseOrgIds": [
              "EZK.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kako uleelede kubasinsimina. Sinsima, O mwana amuntu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.4",
            "verseOrgIds": [
              "EZK.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
