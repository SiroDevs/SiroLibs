          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.12.30"
              },
              "items": [
                {
                  "text": "Dt 12:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.8.10"
              },
              "items": [
                {
                  "text": "Ezk 8:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino muyooziba kuti ndime Jehova, nkaambo tamweendi mumilao yangu nikuba kubamba imbeta zyangu. Mwacita mbubonya mbuli ziyanza zyazisi zimweengelede.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.12",
            "verseOrgIds": [
              "EZK.11.12"
            ]
          }
        }
      ]
