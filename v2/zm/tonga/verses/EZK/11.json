              "items": [
                {
                  "text": "Ezk 9:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino nindakali kusinsima, Pelatiya mwana wa-Benaya wakafwa. Mpawo ndakawa cakuvundama, ndakwiila ajwi ipati, ndati, Akaka Mwami Jehova! Sa ulamanisya ba-Israyeli boonse bacisyeede?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.13",
            "verseOrgIds": [
              "EZK.11.13"
            ]
