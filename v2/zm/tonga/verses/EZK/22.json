              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana amuntu, koiambila kuti, Nduwe nyika iitana kusalazigwa nikuba kuwidwa imvula mubuzuba bwabukali, ",
          "type": "text",
          "attrs": {
