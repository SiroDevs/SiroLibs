                  "text": "Mik 6:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uleelede kwaamba kuti, Mbuboobu mbwaamba Mwami Jehova. Akaka, O munzi ootila bulowa mukati kako, kuti ciindi calubeta lwako cisike, oocita zikozyano zyakulisofwaazya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.3",
            "verseOrgIds": [
              "EZK.22.3"
            ]
          }
        },
