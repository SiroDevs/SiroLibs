                  "text": "26:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Zintu zyangu zisalalisya mwazisampaula, aalo masabata aangu mwaasofwaazya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.8",
            "verseOrgIds": [
