        },
        {
          "text": "Lino ijwi lya-Jehova lyakandisikila, liti, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.1",
            "verseOrgIds": [
              "EZK.22.1"
            ]
          }
