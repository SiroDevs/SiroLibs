                "loc": "EZK.13.10"
              },
              "items": [
                {
                  "text": "Ezk 13:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basinsimi bayo balabalambila mulambo, balababonena zilengano zyabuyo akubasondela zyakubeja. Balaamba kuti, Mbuboobu mbwaamba Mwami Jehova, anukuti Jehova tana kwaamba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.28",
            "verseOrgIds": [
