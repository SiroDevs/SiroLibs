                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bantu banyika balapenzya cakubba, balanyanzya imbono. Balapenzya bacete abatengwana, abalo beenzu balabapenzya muciyanza citeelede. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.29",
