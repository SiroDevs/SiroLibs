          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulinduwe muli bantu balengelela beenzinyina twaambo kuti batizye bulowa, abamwi balya zipaizyo atala amalundu, abamwi bacita malweza. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.9",
            "verseOrgIds": [
