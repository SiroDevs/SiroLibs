            }
          ]
        },
        {
          "text": "Mulinduwe muli bavumbula zinswe zyabamawisi, abamwi boona abanakazi kuciindi cabo cakutondwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.10",
