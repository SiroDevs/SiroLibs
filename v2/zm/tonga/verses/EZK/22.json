              "items": [
                {
                  "text": "Lev 10:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bapaizi bayo babisizya mulao wangu, basofwaazya zintu zyangu zisalala. Tabana kwaandaanya zintu zisalalisya azintu zyabuyo nekuba kuzibya bantu zintu zisalala azintu zisofweede mbuzibede. Aalo masabata aangu tabaalemeki pe, aboobo ndasampaulwa akati kabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.26",
            "verseOrgIds": [
              "EZK.22.26"
            ]
