                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndakayandaula muntu akati kabo iwakakonzya kumamika bulambo, aime kubusyu bwangu akubusinka nkubukolomokede, kuti ntanyonyooni nyika, pele taakwe naba omwe iwakajanika pe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.30",
            "verseOrgIds": [
