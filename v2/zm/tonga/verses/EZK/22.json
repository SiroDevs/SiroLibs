        {
          "text": "Bulowa mbotilide mbobukupa mulandu, azikozyano nzocitide nzezikusofwaazya, Wafwanzya buzuba bwalubeta lwako; ciindi camyaka yako casika. Nkaambo kako ndakubika kuti ube cisampuko muneso aabamasi asikucapwa munyika zyoonse. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.4",
            "verseOrgIds": [
              "EZK.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balakucapa boonse, nibaba bali afwiifwi nibaba bali kule, uwe simpuwo imbi oozwide lupyopyongano.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.5",
            "verseOrgIds": [
              "EZK.22.5"
            ]
          }
        }
