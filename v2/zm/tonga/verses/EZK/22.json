                  "text": "Is 1:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basilutwe bayo mukati kayo bali mbuli baumpe bakwamauna nyama yabo. Balatila bulowa akunyonyoona bantu kuti balijanine impindu yakubba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.27",
            "verseOrgIds": [
