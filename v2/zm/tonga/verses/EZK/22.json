        {
          "text": "Mulinduwe bantu mobasampaula bamawisi abamanyina. Mulinduwe beenzu mobabbidwa, Mulinduwe bamucaala abamukabafu mobabisizigwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.7",
