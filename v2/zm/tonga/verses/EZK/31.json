                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kako mbuboobu mbwaamba Mwami Jehova. Nkaambo kakuti bwiime bwawo bwakalampisya, alimwi wasisya impela yawo amumayoba, alimwi moyo wawo wakalisumpula nkaambo kabulamfu bwawo, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.10",
            "verseOrgIds": [
              "EZK.31.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "njoouaba mumaanza aasinguzu wabamasi, nkabela uyoouletela bulumbu bweelede bwabubi bwawo. Ndausowa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.11",
            "verseOrgIds": [
              "EZK.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
