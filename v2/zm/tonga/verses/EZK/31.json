                "loc": "EZK.32.5"
              },
              "items": [
                {
                  "text": "32:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bazwakule bantu bayoosya babamasi, bayoougonka akuusia. Mitabi yawo iyoowida ansi atala amalundu amumakuti oonse, amateu aawo ayootyokauka mumagombela oonse aanyika. Misyobo yoonse yabantu iyoozwa muceenzule cawo akuusia. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.12",
            "verseOrgIds": [
              "EZK.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.18.6"
              },
              "items": [
                {
                  "text": "Is 18:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bayuni boonse bakujulu bayookala amatongo aawo, abalo banyama boonse bamusokwe bayooba amateu aawo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.13",
            "verseOrgIds": [
              "EZK.31.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
