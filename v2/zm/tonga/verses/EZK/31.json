            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.4.22+DAN.4.23+DAN.4.24"
              },
              "items": [
                {
                  "text": "Dan 4:22-24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndime ndakaubotya amitabi yawo minji, aboobo misamu yoonse yamu-Edeni iyakali mumuunda wa-Leza yakaufwida munyono.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.9",
            "verseOrgIds": [
              "EZK.31.9"
            ]
          }
        }
