              "attrs": {
                "loc": "EZK.32.18"
              },
              "items": [
                {
                  "text": "Ezk 32:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kuyooba obo kuti misamu imwi iili amaanzi italampi mubwiime bwayo nikuba kusisya mitwe yawo mumayoba, amisamu iinywa maanzi iteelani ayo mubwiime, nkaambo yoonse buyo yaabwa munguzu zyalufu azyanyika yakwacimvumwe akati kabana ba-Adamu baselukila mucilindi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.14",
            "verseOrgIds": [
              "EZK.31.14"
            ]
          }
        }
      ]
