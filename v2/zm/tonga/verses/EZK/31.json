              "items": [
                {
                  "text": "Dan 4:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.10.7+ISA.10.8+ISA.10.9+ISA.10.10+ISA.10.11"
              },
              "items": [
