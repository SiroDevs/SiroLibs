              "items": [
                {
                  "text": "Is 1:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.4.27"
              },
              "items": [
                {
                  "text": "Jer 4:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.6.8"
              },
              "items": [
                {
                  "text": "Ezk 6:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele njooleka bantu bace akati kabo kuti baloboke kupanga akunzala akumalwazi, kuti bayubulule zisesemyo zyabo oko akati kabamasi nkubasikide, lino bayooziba kuti ndime Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.16",
            "verseOrgIds": [
              "EZK.12.16"
            ]
          }
        }
      ]
    },
