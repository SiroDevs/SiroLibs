              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibwakaca, ijwi lya-Jehova lyakandisikila, liti, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.8",
            "verseOrgIds": [
