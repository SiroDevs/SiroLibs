              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.26.9"
              },
              "items": [
                {
                  "text": "Is 26:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino bayooziba kuti, ndime Jehova ciindi eco nenooyoobamwaisizye akati kabamasi akubapalanganya munyika zyoonse. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.15",
            "verseOrgIds": [
              "EZK.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
