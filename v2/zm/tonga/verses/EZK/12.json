                "loc": "EZK.5.10"
              },
              "items": [
                {
                  "text": "Ezk 5:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino boonse mbaali abo, basikumugwasya ampi zyakwe, njoobamwaisya kumabazu oonse, alimwi njoosomona ipanga lyakubatandya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.14",
            "verseOrgIds": [
              "EZK.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
