              },
              "items": [
                {
                  "text": "Malo 5:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "O mwana amuntu, kolya insima yako cakukankama, akunywa maanzi aako cakuyoowa acabucenjenzu, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.18",
