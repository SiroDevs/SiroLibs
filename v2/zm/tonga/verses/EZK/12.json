              "attrs": {
                "loc": "JER.52.9"
              },
              "items": [
                {
                  "text": "Jer 52:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.52.11"
              },
              "items": [
                {
                  "text": "11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Njoomuvumbya buzamba bwangu, nkabela uyoocegwa mukakole kangu, aboobo njoomusisya ku-Babuloni munyika yaba-Kasidi. Nyika eyi takooyooibona pe, nekubaboobo nkuko nkwayoofwida. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.13",
            "verseOrgIds": [
              "EZK.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
