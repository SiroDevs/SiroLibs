        {
          "text": "Lino wakandiboozya kumulyango waŋanda, nkabela ndakabona maanzi alazwa kunsi lyacikunguzyo caŋanda kulubazu lwakujwe, nkaambo iŋanda keelangide kujwe; alimwi maanzi akali kukunka kuzwa ansi lyalubazu lwaŋanda lwalulyo kumusanza wacipaililo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.1",
            "verseOrgIds": [
              "EZK.47.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 47:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo wakanditola anze, wandiinzya kumulyango wakunyika, wandizyungulusya anze kusikila kumulyango waanze uulangide kujwe, nkabela ndakabona maanzi alamiminya kulubazu lwakululyo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.2",
            "verseOrgIds": [
              "EZK.47.2"
            ]
          }
        }
      ]
