        },
        {
          "text": "Lino muntu uuli antambo yakweelesya mujanza lyakwe, naakaya kujwe, wakeeleka tukokola tuli cuulu, elyo wakandiinzya akati kamaanzi, nkabela maanzi akali kutanwa mungo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.3",
            "verseOrgIds": [
              "EZK.47.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 47:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuzwa oko wakeeleka alimwi tukokola tuli cuulu, wandiinzya akati kamaanzi, nkabela maanzi akali kutanwa mumazwi. Alimwi wakeeleka tukokola tuli cuulu, wandiinzya, nkabela maanzi akali kutanwa kucikungu, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.4",
            "verseOrgIds": [
              "EZK.47.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 47:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi wakeeleka tukokola tuli cuulu, nkabela ndakajana mulongo uutaindiki, nkaambo maanzi akalifutide, aba maanzi aakuyamba, mulonga uutazubukiki, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.5",
            "verseOrgIds": [
              "EZK.47.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 47:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino wakandibuzya kuti, Sa wabona eci, O mwana amuntu?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.6",
            "verseOrgIds": [
              "EZK.47.6"
            ]
          }
        }
