        },
        {
          "text": "O mwana amuntu, langa cankayikayi bana ba-Amoni akusinsima aambabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.2",
            "verseOrgIds": [
              "EZK.25.2"
            ]
          }
