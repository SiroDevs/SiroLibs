        },
        {
          "text": "Mbuboobu mbwaamba Mwami Jehova. Nkaambo kamajwi aa-Moabu aakwaamba kuti, Ncobeni luzubo lwa-Juda luli mbubonya mbuli misyobo yoonse yabantu, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.8",
            "verseOrgIds": [
              "EZK.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ncobeni njookwamauna makuko aanyika ya-Moabu koonse koonse kuzwa kuminzi yakumugaano wayo, njenjiyo bulemu bwacisi, Beti-Jesimoti a-Baalameoni a-Kiriyataimu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.9",
            "verseOrgIds": [
              "EZK.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njooaba cisi antoomwe acisi caba-Amoni mumaanza aabana bakujwe, kuti bacivube, aboobo tacikooyooyeeyegwa limbi akati kabamasi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.10",
            "verseOrgIds": [
              "EZK.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njoobeteka ba-Moabu, elyo bayooziba kuti ndime Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.11",
            "verseOrgIds": [
              "EZK.25.11"
            ]
          }
        }
