              },
              "items": [
                {
                  "text": "Tus 17:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ambila bana ba­ Amoni kuti, Amuswiilile ijwi lya-Mwami Jehova. Mbuboobu mbwaamba Mwami Jehova. Nkaambo kajwi lyako lyakuweela busena bwangu busalalisya nibwakasofwaazigwa anyika ya-Israyeli niyakasaalwa aluzubo lwa-Israyeli nibakatolwa mubuzike, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.3",
            "verseOrgIds": [
              "EZK.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
