              "items": [
                {
                  "text": "Zef 2:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Njoocita kuti Raba ube macelelo aankamele, anyika yabana ba-Amoni ibe mabutelo aambeleleo Elyo muyooziba kuti ndime Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.5",
            "verseOrgIds": [
              "EZK.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo mbuboobu mbwaamba Mwami jehovu. Nkaambo kakuti wakamba amaanza aako akulyatalyata amaulu aako akusekelela camoyo wako woonse nkaambo kamapenzi aanyika ya-Israyeli, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.6",
            "verseOrgIds": [
              "EZK.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "njootandabika ijanza lyangu kukulwisya akukwaaba mumaanza aabamasi kuti bakusaale. Njookulobya akati kamisyobo yabantu akukumanisya akati kazisi. Njookunyonyoona, elyo uyooziba kuti ndime Jehova,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.7",
            "verseOrgIds": [
              "EZK.25.7"
            ]
          }
        }
      ]
