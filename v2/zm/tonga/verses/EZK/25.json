              },
              "items": [
                {
                  "text": "Matl 45:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ndakwaaba mumaanza aabana bakujwe kuti bakuvube. Bayooyaka zilao zyabo mukati kako akubika zikalilo zyabo munyika yako. Bayoolya micelo yako akunywa malili aako. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.4",
            "verseOrgIds": [
              "EZK.25.4"
            ]
          }
        },
