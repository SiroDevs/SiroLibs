                "loc": "DEU.8.7"
              },
              "items": [
                {
                  "text": "Dt 8:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Banyoko bakali mbuli isaansa mumuunda lizikilidwe kumbali lyamaanzi, isaansa lyobene lizyalisya micelo nkaambo kamaanzi manji. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.10",
            "verseOrgIds": [
              "EZK.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.4.11"
              },
              "items": [
                {
                  "text": "Dan 4:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Cisiko calyo ciyumu cakaba musako wasikweendelezya. Cakalampisya loko akati kamapanda mapanda. Cakaboneka abulamfu bwaco amitabi yaco minji. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.11",
            "verseOrgIds": [
              "EZK.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.13.15"
              },
              "items": [
                {
                  "text": "Hos 13:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele isaansa lyakanonkolwa cabukali, lyakawaalwa ansi. Muwo wakujwe wakaliyuminizya, amicelo yalyo yakacelwa. Cisiko calyo cakayuminina; mulilo wakacisyukutya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.12",
            "verseOrgIds": [
              "EZK.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.48"
              },
              "items": [
                {
                  "text": "Dt 28:48",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino sunu lilizikilidwe munkanda, munyika injumu iibula maanzi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.13",
            "verseOrgIds": [
              "EZK.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.9.15"
              },
              "items": [
                {
                  "text": "Bab 9:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mucisiko calyo mwazwa mulilo, watenta mitabi yalyo amicelo yalyo yoonse. Lino tamucijanwi mulindilyo cisiko ciyumu cikonzya kuba musako wasikweendelezya, Nceeco cilizyo, ncakulizya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.14",
            "verseOrgIds": [
              "EZK.19.14"
            ]
          }
