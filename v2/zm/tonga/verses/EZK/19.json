                "loc": "EZK.26.17"
              },
              "items": [
                {
                  "text": "Ezk 26:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino uwe, imba cilizyo cakulila basilutwe ba-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.1",
            "verseOrgIds": [
              "EZK.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amba kuti, Ma! Banyoko bakali mulavu! Bakali kubwantamana akati kabuta­ mbonyina. Bakali kunyonsya bana babo akati kabasyuumbwanyina. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.2",
            "verseOrgIds": [
              "EZK.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.23.31"
              },
              "items": [
                {
                  "text": "2 Bam 23:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bakalela umwi wabana babo, waba mulavu, waiya kuvwima zilyo, wali kulya bantu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.3",
            "verseOrgIds": [
              "EZK.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.23.33"
              },
              "items": [
                {
                  "text": "2 Bam 23:33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.4"
              },
              "items": [
                {
                  "text": "2 Mak 36:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.22.11"
              },
              "items": [
                {
                  "text": "Jer 22:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino bamasi nibakamvwa impuwo yakwe, wakacegwa mukakole kabo, nkabela bakamuleta atulobyo, bamusisya kunyika ya-Egepita. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.4",
            "verseOrgIds": [
              "EZK.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.23.34"
              },
              "items": [
                {
                  "text": "2 Bam 23:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpoonya awo, banyina nibakabona kuti bazundwa, amakani taanakuba mbubakali kulangila, bakabweza aumwi wabana babo, bacita kuti abe mulavu muvwimi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.5",
            "verseOrgIds": [
              "EZK.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.22.13"
              },
              "items": [
                {
                  "text": "Jer 22:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakali kuya bweendeenda akati kabasyuumbwa, waba mulavu, waiya kuvwima zilyo, wali kulya bantu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.6",
            "verseOrgIds": [
              "EZK.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakali kubisizya maanda aabo aabwami akusaala minzi yabo. Nyika yoonse abaabo bamulinjiyo bakayoowa ijwi lyakuvuluma kwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.7",
            "verseOrgIds": [
              "EZK.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.24.2"
              },
              "items": [
                {
                  "text": "2 Bam 24:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino bamasi bakuzisi zyoonse zyeengelede bakamubukila, bamucekelezya lusabwe lwabo, nkabela wakacegwa mumulindi wabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.8",
            "verseOrgIds": [
              "EZK.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.6"
              },
              "items": [
                {
                  "text": "2 Mak 36:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.6.2"
              },
              "items": [
                {
                  "text": "Ezk 6:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bakamukwezya indobyo zyabo, bamubika mucizangala, bamutola kumwami wa-Babuloni. Bakamunjizya mukaliba, kuti ijwi lyakwe litamvwigwi limbi atala amalundu aa-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.9",
            "verseOrgIds": [
              "EZK.19.9"
            ]
          }
        }
      ]
    },
