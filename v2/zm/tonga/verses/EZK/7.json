              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuboobu mbwaamba Mwami Jehova. Mapenzi alasika atala lyamapenzinyina! Ncobeni asika! ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.5",
            "verseOrgIds": [
              "EZK.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mamanino asika! Mamanino asika! Amubukila! Ncobeni asika! ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.6",
            "verseOrgIds": [
              "EZK.7.6"
