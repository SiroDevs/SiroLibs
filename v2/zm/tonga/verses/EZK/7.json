                "loc": "EZK.12.23+EZK.12.24+EZK.12.25"
              },
              "items": [
                {
                  "text": "Ezk 12:23-25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Asika malweza, uwe nokede munyika! Ciindi casika, Buzuba buli afwiifwi. Mbuzuba bwalupyopyongano, tabuli buzuba bwacikwala cakukondwa atala azilundu pe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.7",
            "verseOrgIds": [
              "EZK.7.7"
            ]
          }
        },
        {
