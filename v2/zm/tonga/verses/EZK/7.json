                }
              ]
            }
          ]
        },
        {
          "text": "Njooleta babi babamasi kuti bakavube maanda aabo. Njoomanisya kulisumpula kwabayumu, amasena aabo aasalalisya ayoosofwaazigwa. ",
          "type": "text",
          "attrs": {
