              "items": [
                {
                  "text": "Mt 24:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uwe O mwana amuntu, mbuboobu Mwami Jehova mbwaambila nyika ya-Israyeli. Asika mama­ nino! Asika mamanino kumabazu aanyika oonse one. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.2",
            "verseOrgIds": [
              "EZK.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mamanino amusikila, lino ndaamba kumutumina bukali bwangu. Njoomubeteka mbubonya mbuli inzila zyanu akumubweedezya bulumbu bweelede milimo yanu iisesemya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.3",
            "verseOrgIds": [
              "EZK.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.5.11"
              },
              "items": [
                {
                  "text": "Ezk 5:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.6.7"
              },
              "items": [
                {
                  "text": "6:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Meso aangu taakooyoomufwida luse, alimwi nsikooyoomufwida luzyalo pe, Njoomubweedezya bulumbu bwanzila zyanu, milimo yanu iisesemya niicili akati kanu. Lino muyooziba kuti ndime Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.4",
            "verseOrgIds": [
              "EZK.7.4"
            ]
          }
        }
      ]
    },
