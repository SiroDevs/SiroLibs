                "loc": "ISA.13.7"
              },
              "items": [
                {
                  "text": "Is 13:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maanza oonse akompaama, mazwi oonse ateta buyo mbuli maanzi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.17",
            "verseOrgIds": [
              "EZK.7.17"
            ]
          }
        },
