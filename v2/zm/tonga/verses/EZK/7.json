            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.25"
              },
              "items": [
                {
                  "text": "Dt 32:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ipanga lyaboneka anze, malwazi anzala zyaboneka mukati. Oyo uuli musokwe ulajazigwa ipanga, ayooyo uuli mumunzi inzala abulwazi nzeziyoomujaya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.15",
            "verseOrgIds": [
              "EZK.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.6.8"
              },
              "items": [
                {
                  "text": "Ezk 6:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na nkubali bamwi akati kabo baloboka, bayooba atala amalundu, bayooba mbuli inziba zyamukuti, balaya buvuluvuta, umwi aumwi nkaambo kamilandu yakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.16",
            "verseOrgIds": [
              "EZK.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
