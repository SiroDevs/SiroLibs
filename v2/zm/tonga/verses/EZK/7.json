          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.30"
              },
              "items": [
                {
                  "text": "Jer 7:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bakali kulikankaizizya bweebesi bwazyo, bakali kuzicitya zikozyano zibi zisesemya, aboobo ndacita kuti zibabede cintu cisofweede. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.20",
            "verseOrgIds": [
              "EZK.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njoozyaaba mumaanza aabazwakule kuti bazisaale, abalo basizibi banyika bayoozitola, nkabela bayoozisofwaazya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.21",
            "verseOrgIds": [
              "EZK.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njoofutatika busyu bwangu kuzwa kulimbabo, nkabela bayoosofwaazya ciyobwedo cangu. Bafumpi bayoonjila mulincico, bayoocisofwaazya, akucimwaya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.22",
            "verseOrgIds": [
              "EZK.7.22"
            ]
          }
        }
