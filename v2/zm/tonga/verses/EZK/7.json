          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balizya mweembo, babamba zintu zyoonse, nekubaboobo taakwe uuinka kuyoolwisya, nkaambo bukali bwangu bwasikila makamu aabo oonse buyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.14",
            "verseOrgIds": [
