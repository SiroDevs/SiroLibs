            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.4.19+MAT.4.20+MAT.4.21"
              },
              "items": [
                {
                  "text": "Mt 4:19-21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uyooba ciyanikilo camazamba akati kalwizi, nkaambo mbuboobo mbundaamba, mbwaamba Mwami Jehova. Uyooba cisaalo cabamasi, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.5",
            "verseOrgIds": [
              "EZK.26.5"
            ]
