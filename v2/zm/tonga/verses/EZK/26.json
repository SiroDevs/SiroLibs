                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Njoolesya kuyobeka kwanyimbo zyako, ajwi lyatuntimbwa twako talikooyoomvwigwa limbi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.13",
            "verseOrgIds": [
              "EZK.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njoocita kuti ube igale buyo antangalala. Uyooba ciyanikilo camazamba. Tokooyooyakululwa limbi pe, nkaambo ndime nde-Jehova ndaamba obo, mbwaamba Mwami Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.14",
            "verseOrgIds": [
