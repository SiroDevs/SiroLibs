        {
          "text": "Omwana amuntu, Turo waamba aa-Jerusalemu kuti, Ehe! Citendele cabantu camwayigwa, ndajalwidwa, lino njoovuba, nkaambo wasaalwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.2",
            "verseOrgIds": [
              "EZK.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kako mbuboobu mbwaamba Mwami Jehova. Bona! Ndi sinkondonyoko, O Turo. Njookubusizya misyobo minji yabantu mbubonya mbuli lwizi mbulubusya mayuwe aalo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.3",
            "verseOrgIds": [
              "EZK.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayoonyonyoona malambo aa-Turo akumwaya maanda aawo malamfu, Njooupalila bulongo bwawo, ube igale buyo antangalala. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.4",
            "verseOrgIds": [
              "EZK.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
