              "type": "text"
            }
          ]
        },
        {
          "text": "Pele njoomusyaazizya bamwi baloboka kuzwa kupanga lyabamasi ciindi eco nimuyoomwaikila akati kazisi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.8",
