              "attrs": {
                "loc": "EZK.5.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Zipaililo zyanu ziyoonyonyoonwa, zikozyano zyanu ziyoopwayaulwa, abantu banu bayoowida ansi balijayidwe kubusyu bwamizimu yanu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.4",
            "verseOrgIds": [
              "EZK.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njoolazika mitunta yabana ba-Israyeli kubusyu bwamizimu yanu, azifuwa zyanu njoozimwaya cakuzyunguluka zipaililo zyanu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.5",
            "verseOrgIds": [
              "EZK.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koonse koonse nkumukede, minzi yanu iyooba matongo azipaililo zyanu zyakuzilundu ziyoobula bantu, kuti zipaililo zyanu zibe matongo akubula bantu, zikozyano zyanu zipwayauIwe akuloba, tukombelo twanu tumwayigwe, amilimo yanu iziminganisigwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.6",
            "verseOrgIds": [
              "EZK.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu bayoowa ansi baliyasidwe akati kanu, aboobo muyooziba kuti ndime Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.7",
            "verseOrgIds": [
              "EZK.6.7"
            ]
          }
        }
      ]
    },
