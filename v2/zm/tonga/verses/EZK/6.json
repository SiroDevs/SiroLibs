                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbuboobu mbwaamba Mwami Jehova. Kamba amaanza aako, lyata acituta cako, akwaamba kuti, Maawe! nkaambo kazisesemyo zibi zyoonse zyaluzubo lwa-Israyeli; nkaambo bayoojazigwa ipanga apamba amalwazi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.11",
            "verseOrgIds": [
              "EZK.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo uuli kule uyoofwa bulwazi, ayooyo uuli kufwaafwi uyoojazigwa ipanga, ayooyo uusyeede uuvunidwe uyoofwa inzala. Aboobo njoozuzikizya bukali bwangu kulimbabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.12",
            "verseOrgIds": [
              "EZK.6.12"
            ]
          }
        },
