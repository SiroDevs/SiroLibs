                  "text": "Job 42:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino abo balobokede bayooibalukwa ndime akati kazisi nkubatoledwe mubuzike, nkaambo njootyola myoyo yabo yabwaamu iindisiide ameso aabo aabwamu aalanga zikozyano zyabo, lino bayooba cisesemyo mumeso aabo beni nkaambo kabubi bwabo mbubacita akaambo kazisesemyo zyabo zyoonse. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.9",
            "verseOrgIds": [
              "EZK.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela bayooziba kuti ndime Jehova, alimwi mapenzi aya oonse ngendaamba kubaletela teensi aabuyo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.10",
            "verseOrgIds": [
              "EZK.6.10"
            ]
          }
        }
