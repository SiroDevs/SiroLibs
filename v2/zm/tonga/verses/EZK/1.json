          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kufumbwa muuya nkuuwakayanda kuya, bakaya nkukonya, aale mavwili akasumpulwa kumbali lyabo, nkaambo mumavili momwakali muuya wabanyama. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.20",
