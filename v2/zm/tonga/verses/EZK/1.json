              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.15"
              },
              "items": [
                {
                  "text": "Ciy 1:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maulu aabo akaliluleme, azituta zyabo zyakali mbuli zituta zyabanamani. Nkabela bakali kubekabeka mbubonya mbuli mundalila uusyobwedwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.7",
            "verseOrgIds": [
              "EZK.1.7"
            ]
          }
        },
