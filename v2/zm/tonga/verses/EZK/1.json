                  "text": "Ciy 4:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kabajisi maanza aabuntu kunsi amababa aabo kumabazu aabo one. Mbuboobu mbwaakabede masyu aabo amababa aabo boonse bone: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.8",
            "verseOrgIds": [
              "EZK.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "mababa aabo akaliswaneene limwi alimwi abbabanyina. Amukweenda kwabo teebakali kuleyauka pe, boonse kabalulama buyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.9",
            "verseOrgIds": [
              "EZK.1.9"
            ]
