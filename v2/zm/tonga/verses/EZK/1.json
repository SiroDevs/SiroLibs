              "items": [
                {
                  "text": "Ciy 4:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi mukati kawo mwakazwa mbuli banyama bone. Mbuboobu mbubakabede: bakali mbuli muntu, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.5",
            "verseOrgIds": [
              "EZK.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "pele umwi aumwi kajisi masyu one, alimwi umwi aumwi kajisi mababa one. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.6",
            "verseOrgIds": [
              "EZK.1.6"
            ]
          }
        },
