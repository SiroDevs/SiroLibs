              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ciindi cakweenda, kaenda kufumbwa mabazu aao one nkwaakalangide, kaataleyi-leyi pe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.17",
