        {
          "text": "ijwi lya-Jebova lyakasika kuli-Ezekieli mupaizi mwana wa-Buzi munyika yaba-Kasidi kumulonga wa-Kebara, nkabela ijanza lya-Jehova lyakali alinguwe nkukonya oko.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.3",
            "verseOrgIds": [
              "EZK.1.3"
            ]
