                  "text": "Hos 9:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Jehova wakaamba kuti, Mbuboobo bana baIsrayeli mbubayoolya zilyo zyabo zisofweede akati kabamasi nkumbatandilide. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.13",
