          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino uwe, bweza bulotwe abbaale, nyangu anyemu, mabele amaila, uzibike mucilongo comwe, ukalijikile zilyo, ukalye nzizyo mazuba oonse ngonoolede abbambo lyako, nkokuti mazuba aali myanda yotatwe amakumi aali musanu aane. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.9",
            "verseOrgIds": [
              "EZK.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azilyo nzonoolya zileelede kupimwa; masyekeli aali makumi obile mbobulemu bwacaabilo cabuzuba bumwi abumwi, alimwi uleelede kulya komwe buyo mubuzuba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.10",
            "verseOrgIds": [
              "EZK.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aalo maanzi ngonoonywa aleelede kupimwa; inkomeki zyobile ncecaabilo cako cabuzuba bumwi abumwi, alimwi uleelede kunywa komwe buyo mubuzuba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.11",
            "verseOrgIds": [
              "EZK.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uleelede kulya zilyo zyako mbuli zinkwa zyabbaale akujika uleelede kuzijika mumeso aabo amazyu aabantu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.12",
            "verseOrgIds": [
              "EZK.4.12"
            ]
          }
        },
