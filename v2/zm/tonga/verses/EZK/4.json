                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino bweza imbali yabutale, uibike mbuli bulambo bwabutale, akatikati kako amunzi, alimwi lanzya busyu bwako kulinjiyo, kuti munzi usinkinizigwe. Mbuboobo mboelede kusinkinizya munzi, aceeci ciyooba citondezyo kuluzubo lwa-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.3",
            "verseOrgIds": [
              "EZK.4.3"
            ]
          }
        }
