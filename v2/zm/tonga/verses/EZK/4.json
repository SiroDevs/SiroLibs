            }
          ]
        },
        {
          "text": "Lino webo, O mwana amuntu, bweza bbimbili, ulibike kubusyu bwako, akutala alindilyo cifwanisyo camunzi, nkokuti Jerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.1",
            "verseOrgIds": [
              "EZK.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bika zibelesyo zyakuusinkinizya, yaka bulambo bwakusinkinizya, lundika citantaala cakuulwisya, alimwi bika basilumamba bakuulwisya amincini yakupwayauzya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.2",
            "verseOrgIds": [
              "EZK.4.2"
            ]
          }
        },
