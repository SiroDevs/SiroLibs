          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo wakeeleka bulamfu bwamayake aalangide lubuwa ilwakali kusule, anzila zyao kumabazu oonse obile, tukokola tuli mwanda. Nkabela intempele acikombelo camukati ankonkono zyalubuwa lwaanze, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.15",
            "verseOrgIds": [
              "EZK.41.15"
            ]
          }
        },
