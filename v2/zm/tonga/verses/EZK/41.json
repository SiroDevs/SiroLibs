                  "text": "17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino wakeeleka bulamfu bwaŋanda, tukokola tuli makumi obile, abwalo bwaamba bwayo, tukokola tuli makumi obile, kunembo lyantempele, nkabela wakandaambila kuti, Mbuboobu busena busalalisya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.4",
            "verseOrgIds": [
              "EZK.41.4"
            ]
          }
        }
