        },
        {
          "text": "Nkabela intempele acikombelo cisalalisya kazijisi milyango yobile. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.23",
            "verseOrgIds": [
              "EZK.41.23"
            ]
          }
