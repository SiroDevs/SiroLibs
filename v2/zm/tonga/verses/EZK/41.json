          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulyango umwi aumwi kaujisi makoma obile, makoma aaliyumba, makoma obile kumulyango umwi aumwi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.24",
            "verseOrgIds": [
              "EZK.41.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 41:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakoma aantempele akalibezedwe bakerebimu atukunka mbubonya mbuli ezyo izyakali amalambo, alimwi kunembo lyalukenkono lwaanze kakuli kaluli kazisamu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.25",
            "verseOrgIds": [
              "EZK.41.25"
            ]
          }
        },
        {
