              "type": "text"
            }
          ]
        },
        {
          "text": "busyu bwamuntu bulangide kukakunka kamwi, abusyu bwamulavu bulangide kukakunka kakulubazu lumwi. Mbuzyakabede moonse moonse muŋanda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.19",
            "verseOrgIds": [
              "EZK.41.19"
            ]
          }
        },
        {
          "name": "verse",
