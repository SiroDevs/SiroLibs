                "loc": "1CO.13.12"
              },
              "items": [
                {
                  "text": "1 Kor 13:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "zyoonse zyakalinamatikilidwe zisamu. Zyoonse zyotatwe kazijisi zipulo zisyanikide kumabazu oonse, alimwi moonse moonse mukati kamunamatikidwe azisamu, kuzwa ansi kusikila kuzipulo, (azyalo zipulo kazivumbidwe), ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.16",
            "verseOrgIds": [
              "EZK.41.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 41:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "akusikila ajulu lyamulyango, kuŋanda yamukati aanze oonse. Alimwi amalambo, muŋanda yamukati aanze, akali zikozyano zibezedwe kumabazu conse, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.17",
