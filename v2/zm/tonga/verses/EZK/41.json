          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuzwa ansi kusikila ajulu lyamulyango, koonse koonse kakubezedwe bakerebimu atukunka abulambo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.20",
            "verseOrgIds": [
