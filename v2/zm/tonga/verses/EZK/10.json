          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakerebimu bakaliimvwi kululyo lwaŋanda, muntu oyo naakanjila, nkabela ijoba lyakazuzya lubanza lwamukati. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.3",
            "verseOrgIds": [
              "EZK.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.28"
              },
              "items": [
                {
                  "text": "Ezk 1:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.43.5"
              },
              "items": [
                {
                  "text": "43:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.40.35"
              },
              "items": [
                {
                  "text": "Kul 40:35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo bulemu bwa-Jehova bwakatanta kuzwa kubakerebimu, bwaakwiima atala lyacikunguzyo caŋanda, nkabela iŋanda yakazuzigwa ijoba, alwalo lubanza lwakazula mumuni wabulemu bwa-Jehova, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.4",
            "verseOrgIds": [
              "EZK.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.24"
              },
              "items": [
                {
                  "text": "Ezk 1:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.29.3"
              },
              "items": [
                {
                  "text": "Int 29:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino muzumo wamababa aabaangelo bakerebimu wakamvwigwa koonse koonse akusikila kulubanza lwaanze, wakali mbuli ijwi lya-Leza Cilenga naamba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.5",
            "verseOrgIds": [
              "EZK.10.5"
            ]
          }
        }
