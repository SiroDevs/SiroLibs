            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.10"
              },
              "items": [
                {
                  "text": "Ezk 1:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.7"
              },
              "items": [
                {
                  "text": "Ciy 4:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela umwi aumwi kajisi masyu one: busyu butaanzi kabuli busyu bwakerubu, busyu bwabili kabuli busyu bwamuntu, busyu bwatatu kabuli bwamulavu, abwane kabuli busyu bwansika.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.14",
            "verseOrgIds": [
              "EZK.10.14"
            ]
          }
        }
      ]
    },
