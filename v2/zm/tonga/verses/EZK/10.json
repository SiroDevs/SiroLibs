        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino naakalailila oyo muntu iwakasamide masani aatuba kuti, Bweza mulilo kuzwa akati kamavili akati kabakerebimu, oyo muntu wakanjila, waakwiima kumbali lyavili. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.6",
            "verseOrgIds": [
              "EZK.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo kerebimu wakatandabika ijanza lyakwe kuzwa akati kabakerebimu, walinjizya mumulilo iwakali akati kabakerebimu, wabweza mulilo, wabika mumaanza aayooyo iwakasamide masani aatuba. Autambule buyo, wakazwida anze. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.7",
            "verseOrgIds": [
              "EZK.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.8"
              },
              "items": [
                {
                  "text": "Ezk 1:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino ndakabona kuti baangelo bakerebimu kabajisi cili mbuli ijanza lyamuntu kunsi amababa aabe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.8",
            "verseOrgIds": [
              "EZK.10.8"
            ]
          }
        }
      ]
