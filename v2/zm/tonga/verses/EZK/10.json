            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino bakerebimu bakatanta kujulu. Mbembabo banyama mbendakabona kumulonga wa-Kebara. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.15",
            "verseOrgIds": [
              "EZK.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.19"
              },
              "items": [
                {
                  "text": "Ezk 1:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela bakerebimu nibakaya, aalo mavwili akeenda kumbali lyabo, alimwi bakerebimu nibakatandabika mababa aabo kuti bauluke kujulu kuzwa ansi, aalo mavwili taakwaakaleka kweenda kumbali lyabo. ",
