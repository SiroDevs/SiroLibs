                "loc": "REV.8.5"
              },
              "items": [
                {
                  "text": "Ciy 8:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela wakaambila oyo muntu iwakasamide masani aatuba kuti, Njila akati kamavili, kunsi lyabaangelo bakerebimu, ukazuzye inkankamaanza malasa aayaka kuzwa akati kabakerebimu, ukaamwaye atala lyamunzi. Lino wakanjila mumeso aangu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.2",
            "verseOrgIds": [
              "EZK.10.2"
            ]
          }
        }
      ]
    },
    {
