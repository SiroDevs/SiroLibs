              },
              "items": [
                {
                  "text": "Ezk 4:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Cipanzi cimwi catatu uleelede kucitenta mumulilo mukati kamunzi, mazuba aakusinkinizya naazoozulila. Acipanzi cimwi catatu, uleelede kucibweza akucuumya ipanga cakuzyunguluka munzi. Acimwi catatu cisyeede uleelede kucipupulula amuuwo, nkabela njoosomona ipanga kusule lyaco. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.5.2",
            "verseOrgIds": [
              "EZK.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.40.6"
              },
              "items": [
                {
                  "text": "Jer 40:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi uleelede kubweza tususu tuce akutwaanga mumoombe wacikobela cako. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.5.3",
            "verseOrgIds": [
              "EZK.5.3"
            ]
          }
        },
        {
