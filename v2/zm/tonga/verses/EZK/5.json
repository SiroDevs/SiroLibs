              "items": [
                {
                  "text": "Jud 1:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele wapapila imbeta zyangu, wacita bubi kwiinda bamasi, amilazyo yangu wait yola kwiinda nyika zyuuengelede. Imbeta zyangu bazisampaula, amilazyo yangu tabeendi mulinjiyo pe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.5.6",
            "verseOrgIds": [
              "EZK.5.6"
            ]
          }
        },
        {
