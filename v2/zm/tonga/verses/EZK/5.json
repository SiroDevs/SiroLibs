        },
        {
          "text": "Mbuboobu mbwaamba Mwami Jehova, Ngooyu Jerusalemu. Ndaubika akati kabamasi, azisi nkuzili zyeengelede. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.5.5",
            "verseOrgIds": [
