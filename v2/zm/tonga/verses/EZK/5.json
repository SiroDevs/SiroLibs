                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kako mbuboobu mbwaamba Mwami Jehova. Mbuli mbumwalipilinganya kwiinda bamasi bamweengelede, alimwi tamweendi mumbeta zyangu nikuba kucita milazyo yangu, alimwi tamuciti mbuli imbeta zyabamasi bamweengelede, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.5.7",
            "verseOrgIds": [
              "EZK.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkaambo kako mbuboobu mbwaamba Mwami Jehova. Bona! Mebo ndakulwisya! Njoocita imbeta mukati kako kumeso aabamasi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.5.8",
