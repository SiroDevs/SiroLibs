                  "text": "2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi tumwi akati kantuto, uleelede kutubweza akutusowela mumulilo, ukatutente mumulilo; kuzwa nkuko kuyoozwa mulilo kuluzubo loonse lwaIsrayeli,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.5.4",
            "verseOrgIds": [
              "EZK.5.4"
            ]
          }
