        },
        {
          "text": "Amuboole, tupiluke kuli-Jehova, nkaambo nguwe wakakwamauna, alimwi ngonguwe uuyootuponya. Nguwe wakatuuma, alimwi ngo­ nguwe uyootwaangila zicisa zyesu. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.1",
            "verseOrgIds": [
              "HOS.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amana mazuba obile, uyootuponya, amubuzuba bwatatu uyootubusya, tupone kubusyu bwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.2",
            "verseOrgIds": [
              "HOS.6.2"
            ]
          }
        },
        {
          "name": "verse",
