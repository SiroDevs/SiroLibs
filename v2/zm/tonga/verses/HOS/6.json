              "items": [
                {
                  "text": "Job 29:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo tuyoomuziba, tunooya butobela luzibo lwa-Jehova. Kupola kwakwe nkwakusinizya mbuli nebuca, alimwi uyootusikila mbuli imvula, mbuli imvula yakutanga ayamusule yoonse ansi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.3",
            "verseOrgIds": [
              "HOS.6.3"
            ]
          }
        }
      ]
    },
