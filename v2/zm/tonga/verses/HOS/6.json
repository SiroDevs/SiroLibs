                  "text": "12:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ncinjanda nduzyalo, tacili cipaizyo pe. Kuziba Leza kulayandwa kwiinda zituuzyo. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.6",
            "verseOrgIds": [
              "HOS.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele balo bali mbuli Adamu. Cizuminano bacisotoka, Mwabona oko nkubandeena. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.7",
            "verseOrgIds": [
              "HOS.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gileadi ngumunzi wabasikucita zibi. Walambaana bulowa. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.8",
            "verseOrgIds": [
              "HOS.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuli bafumpi mbubalindilila bantu, inkamu yabapaizi ilajaya bantu mbubonya munzila yaku-Sekemu. Balacita zisapi. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.9",
            "verseOrgIds": [
              "HOS.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumukowa wa-Israyeli ndibwene cintu ciyoosya. Buvuule mpobuli akati ka-Efraimu, Israyeli wasofwaazigwa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.10",
            "verseOrgIds": [
              "HOS.6.10"
            ]
          }
        }
      ]
    },
