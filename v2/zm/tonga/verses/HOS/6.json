              "type": "text"
            }
          ]
        },
        {
          "text": "Ma! Nkakucitilenzi, Efraimu? Nkakucitilenzi, O Juda? Luzyalo lwanu luli mbuli mayoba aacifumofumo, ambuli mume uufwambaana kuumbuka, ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.4",
            "verseOrgIds": [
              "HOS.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.1.10"
              },
              "items": [
                {
                  "text": "Jer 1:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.4.12"
              },
              "items": [
                {
                  "text": "Heb 4:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kako ndabaanduzya basinsimi akubajazya majwi aamulomo wangu. Kubeteka kwangu kulalibonya mbuli mumuni. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.5",
            "verseOrgIds": [
              "HOS.6.5"
            ]
          }
        },
