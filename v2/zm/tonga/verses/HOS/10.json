            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.8.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bantu baku-Samariya balayoowa nkaambo kamoombe waku-Betaveni, bantu bakwe balamulilila, abalo bapaizi ibakali kumukondelelwa balalila, ikuti bulemu bwakwe bwamusia, bwaya mubuzike, ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.5",
            "verseOrgIds": [
              "HOS.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.5.13"
              },
              "items": [
                {
                  "text": "Hos 5:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uyootolwa ku-Asuri, cibe cilumbyo camwami Jarebu. Aboobo baEfraimu bayoofwisigwa bweeme, ba-Israyeli bayoofwa insoni acisondyo cabo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.6",
            "verseOrgIds": [
              "HOS.10.6"
            ]
          }
        }
      ]
    },
    {
