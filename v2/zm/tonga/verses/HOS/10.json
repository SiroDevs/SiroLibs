              "attrs": {
                "loc": "JER.4.3"
              },
              "items": [
                {
                  "text": "Jer 4:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amulibyalile bululami, kuti mulitebwide luzyalo. Amulipandile cipande canu, nkaambo casika ciindi cakuyandaula Jehova, aboole kuzoomulosezya bululami. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.12",
            "verseOrgIds": [
              "HOS.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HOS 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.4.8"
              },
              "items": [
                {
                  "text": "Job 4:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.22.8"
              },
              "items": [
                {
                  "text": "Tus 22:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.8.7"
              },
              "items": [
                {
                  "text": "Hos 8:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwakalilimina zibi, aboobo mwakatebula bubi, mwakalya micelo yabubeji. Mwakasyoma inkalaki zyanu abaalumi bako banji. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.13",
            "verseOrgIds": [
              "HOS.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HOS 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.18.34"
              },
              "items": [
                {
                  "text": "2 Bam 18:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino kuyoobuka lupyopyongano akati kabantu banu, azicijilo zyanu ziyumu zyoonse zilanyonyoonwa mbubonya mbuli Salimani mbwaakanyonyoona Betaribeli ciindi cankondo, bamanyina nibakatyolaulwa abana babo. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.14",
            "verseOrgIds": [
              "HOS.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HOS 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbubonya obo mbumuti citilwe anywebo ku-Betele, nkaambo kakubisya kwanu nkumwakabisya. Bwaca buyo, mwami wa-Israyeli uyoomaninina kufwa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.15",
            "verseOrgIds": [
              "HOS.10.15"
            ]
          }
        }
