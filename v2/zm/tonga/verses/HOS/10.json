            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.6.16"
              },
              "items": [
                {
                  "text": "Ciy 6:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Zilundu zyakukombela mizimu zilavwinyaunwa, nzenzizyo zibi zya-Israyeli. Myuunga azyobamfwe zilamena azipaililo zyabo. Lino balaambila malundu kuti, Amutuvumbe, atulundulundu kuti, Amutuwide.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.8",
            "verseOrgIds": [
              "HOS.10.8"
            ]
          }
        }
      ]
    },
