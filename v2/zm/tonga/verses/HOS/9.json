                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.11.5"
              },
              "items": [
                {
                  "text": "Hos 11:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.4.13"
              },
              "items": [
                {
                  "text": "Ezk 4:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tabakookala munyika ya-Jehova pe. Efraimu uyoopiluka ku-Egepita, amucisi ca-Asuri bayoolya zitonda, ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.3",
            "verseOrgIds": [
              "HOS.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.26.14"
              },
              "items": [
                {
                  "text": "Dt 26:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tabakooyootila waini wakupaizya Jehova, azipaizyo zyabo tazikooyoomubotela pe. Zilyo zyabo ziyooba mbuli zilyo zyabasidilwe, ziyoosofwaazya boonse bazilya. Zilyo zyabo ziyooba zyakulya buyo, tazikooyookonzya kunjila muŋanda ya-Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.4",
            "verseOrgIds": [
              "HOS.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ino muyoocita buti mubuzuba bwakusekelela, amubuzuba bwapobwe lya-Jehova? ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.5",
            "verseOrgIds": [
              "HOS.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banooya ku-Asuri, cisi caEgepita ciyoobamena, amunzi wa-Mofi uyoobazika. Ziyandisi zyabo zyansiliva impese ilazivuba, amumaanda aabo muyooba mamvwa. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.6",
            "verseOrgIds": [
              "HOS.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.21.22"
              },
              "items": [
                {
                  "text": "Lk 21:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mazuba aakulumbulwa ayoosika, mazuba aakubweedezegwa bubi ayoosika. Israyeli ulaabona. Bati, Musinsimi mufubafuba, muntu uunjidwe Moya ulisondokede. We! Mulandu wanu mupati! Businkondo bwanu bwakomena! ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.7",
            "verseOrgIds": [
              "HOS.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musinsimi ngumulangi ngwaakabika Leza kuti alange Efraimu, nekubaboobo inzila zyakwe zyoonse ziliteedwe, amuŋanda ya-Leza ulajana businkondo. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.8",
            "verseOrgIds": [
              "HOS.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.19.1+JDG.19.2+JDG.19.3+JDG.19.4+JDG.19.5+JDG.19.6+JDG.19.7+JDG.19.8+JDG.19.9+JDG.19.10+JDG.19.11+JDG.19.12+JDG.19.13+JDG.19.14+JDG.19.15+JDG.19.16+JDG.19.17+JDG.19.18+JDG.19.19+JDG.19.20+JDG.19.21+JDG.19.22+JDG.19.23+JDG.19.24+JDG.19.25+JDG.19.26+JDG.19.27+JDG.19.28+JDG.19.29+JDG.19.30"
              },
              "items": [
                {
                  "text": "Bab 19:1-30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Balabisya loko mbubonya mbuli kubisya kwamazuba aaGibeya. Leza takooyooluba kubisya kwabo, uyoobapa mulandu kuzibi zyabo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.9",
            "verseOrgIds": [
              "HOS.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
