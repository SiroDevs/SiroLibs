                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo bana ba-Israyeli bayookala mazuba manjimanji kabatakwe mwami nanka mweendelezi, kabatakwe zipaizyo nanka ciimikilo, kabatakwe zikobela zyabupaizi nanka mituni, ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.4",
            "verseOrgIds": [
              "HOS.3.4"
            ]
          }
