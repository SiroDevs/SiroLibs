              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Jehova wakandaambila kuti, Koya alimwi, ukayande oyu mwanakazi sibuvuule uuyandwa kusimamambe wakwe, Mbuboobu Jehova mbwayanda bana ba-Israyeli, nekuba kuti bali mukutobela mizimu imbi akuyanda mitunge yamasaansa, ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.1",
            "verseOrgIds": [
              "HOS.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo ndakamuula mali aansiliva aali ikumi amusanu acisuwo comwe cizwide acisela cabbaale. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.2",
            "verseOrgIds": [
              "HOS.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 3:3"
          },
          "items": [
