              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.21.13"
              },
              "items": [
                {
                  "text": "Dt 21:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela nda-kamwaambila kuti, Uleelede kusyaala kulindime mazuba manji. Utayi buvuula pe, utabi wamwaalumi umbi. Ambebo njoocita mbubonya kulinduwe. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.3",
            "verseOrgIds": [
              "HOS.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
