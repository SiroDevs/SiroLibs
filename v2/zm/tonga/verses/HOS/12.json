            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.29.1+GEN.29.2+GEN.29.3+GEN.29.4+GEN.29.5+GEN.29.6+GEN.29.7+GEN.29.8+GEN.29.9+GEN.29.10+GEN.29.11+GEN.29.12+GEN.29.13+GEN.29.14+GEN.29.15+GEN.29.16+GEN.29.17+GEN.29.18+GEN.29.19+GEN.29.20"
              },
              "items": [
                {
                  "text": "Matl 29:1-20",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakobo wakacijila musokwe lyaku-Aramu, Israyeli wakabelekela mwanakazi, kulijanina mwanakazi ncaakeembelela. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.12",
            "verseOrgIds": [
              "HOS.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HOS 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.50+EXO.12.51"
              },
              "items": [
                {
                  "text": "Kul 12:50-51",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kujanza lyamusinsimi Jehova wakapozya ba-Israyeli kuzwa ku-Egepita, ajanza lyamusinsimi ndyaakababambya. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.13",
            "verseOrgIds": [
              "HOS.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HOS 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.37"
              },
              "items": [
                {
                  "text": "Dt 28:37",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.11.18"
              },
              "items": [
                {
                  "text": "Dan 11:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Efraimu wandikalazya loko, lino mulandu wabulowa mbwaakatila uyoomucaalila, akusampaula kwakwe mwami wakwe uyookubweedezya kulinguwe.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.14",
            "verseOrgIds": [
              "HOS.12.14"
            ]
          }
        }
      ]
