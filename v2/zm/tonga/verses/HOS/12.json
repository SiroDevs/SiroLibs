                "loc": "ISA.30.6"
              },
              "items": [
                {
                  "text": "Is 30:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Efraimu uleembela luuwo, ulavwima kambizi, Ciindi coonse ulavuzya bubeji alweeno. Balatangana cizuminano a-Asuri, balatola zilumbyo zyamafuta ku-Egepita, ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.1",
            "verseOrgIds": [
              "HOS.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova ulijisi makani a-Juda, Ulapa Jakobo mulandu mbubonya mbuli inzila zyakwe, ulamubweedezya bubi bwamilimo yakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.2",
            "verseOrgIds": [
              "HOS.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.25.26"
              },
              "items": [
                {
                  "text": "Matl 25:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.32.24+GEN.32.25+GEN.32.26"
              },
              "items": [
                {
                  "text": "Matl 32:24-26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naakacili mwida wakalebya munyina. Naakakomena, wakalwana a-Leza, ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.3",
            "verseOrgIds": [
              "HOS.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.28.10+GEN.28.11+GEN.28.12+GEN.28.13+GEN.28.14+GEN.28.15+GEN.28.16+GEN.28.17+GEN.28.18+GEN.28.19+GEN.28.20+GEN.28.21+GEN.28.22"
              },
              "items": [
                {
                  "text": "Matl 28:10-22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "eya, wakalwana aangelo, alimwi wakazunda. Wakalila, wakamufwida luzyalo, Ku-Beteli nkwaakamuswana, nkwaakaambaula aswe. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.4",
            "verseOrgIds": [
              "HOS.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova ngu-Leza wamakamu, Jehova ndizina lyakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.5",
            "verseOrgIds": [
              "HOS.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino kopiluka kuli-Jehova, kocita luzyalo abululami, alimwi kosyoma Leza wako mazuba conse.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.6",
            "verseOrgIds": [
              "HOS.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.6",
            "verseOrgIds": [
              "HOS.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngusimakwebo I Zyeelesyo zyakweena zili mumaanza aakwe. Ulayanda kunyanzya bantu. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.7",
            "verseOrgIds": [
              "HOS.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efraimu wati, Ndaba muvubi, ndaliianina lubono. Pele buvubi bwakwe boonse tabukooyoozulila kumanya mulandu wakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.8",
            "verseOrgIds": [
              "HOS.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.23.42+LEV.23.43"
              },
              "items": [
                {
                  "text": "Lev 23:42-43",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndime Jehova Leza wako mane kuzwa ku-Egepita, Nzookukazika muzilao mbubonya mbuli kuciindi capobwe. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.9",
            "verseOrgIds": [
              "HOS.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakaamba kumilomo yabasinsimi, ndakavuzya zilengano. Ndime ndakali kwaamba zikozyano kumaanza aabasinsimi. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.10",
            "verseOrgIds": [
              "HOS.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.4.4"
              },
              "items": [
                {
                  "text": "Am 4:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mu-Gileadi balabisya, balacita zyabuyo zilike. Ncobeni mu-Giligala mubapaizya iŋombe, zipaililo zyabo ziyooba mbuli malwi aamabwe akati kamilongo yamumuunda.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.11",
            "verseOrgIds": [
              "HOS.12.11"
            ]
          }
        }
      ]
    },
