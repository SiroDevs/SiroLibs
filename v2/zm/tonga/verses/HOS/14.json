        },
        {
          "text": "O Israyeli, kopiluka kuli-Jehova Leza wako, nkaambo zibi zyako nzezyakulebya. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.1",
            "verseOrgIds": [
              "HOS.14.1"
            ]
          }
        },
