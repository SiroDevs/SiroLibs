              "items": [
                {
                  "text": "Heb 13:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amubweze majwi, mupiluke kuli-Jehova, mu­ mwaambile kuti, Kotulekelela milandu yesu yoonse, kotutambula caluzyalo, elyo tuyookuletela micelo yamilomo yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.2",
            "verseOrgIds": [
              "HOS.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asuri takooyootuvuna. Tatukooyootanta ambizi, alimwi tatukooyooamba limbi zibumbwa zyamaanza esu kuti mbaleza besu, nkaambo mulinduwe bamucaala mobajana luzyalo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.3",
            "verseOrgIds": [
              "HOS.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.3",
            "verseOrgIds": [
              "HOS.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njooponya kuluba kwabo, njoobayandisya buyo, nkaambo bukali bwangu bwabaleka. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.4",
            "verseOrgIds": [
              "HOS.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njooba mbuli mume kuli-Israyeli, Uyoosonsa mbuli impana, uyoosimpa miyanda mbuli zisamuzyaku-Lebano, ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.5",
            "verseOrgIds": [
              "HOS.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mitabi yakwe iyooyandalala; bweebesi bwakwe buyooba mbuli bweebesi bwaolifa, abweema bwakwe mbuli bweema bwaku-Lebano. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.6",
            "verseOrgIds": [
              "HOS.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayooboola kukala muceenzule cakwe, bayoobuka mbuli maila akusonsa mbuli musaansa, alimwi bweema bwabo buyooba mbuli waini waku-Lebano.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.7",
            "verseOrgIds": [
              "HOS.14.7"
            ]
          }
        }
      ]
    },
