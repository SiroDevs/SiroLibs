                "loc": "2KI.17.16"
              },
              "items": [
                {
                  "text": "2 Bam 17:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Efraimu naakaamba, bantu kabakankama, nkaambo kali mwami muIsrayeli. Pele wakajana mulandu mumakani aa-Baala, aboobo waka­ fwa. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.1",
            "verseOrgIds": [
              "HOS.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino sunu bacibisya akubisya, balalicitila zikozyano zyansiliva, zileza-leza nzibayeeya beni, bafuzi nzibacita zyoonse. Nzenzizyo nzibaamba kuti Leza. Balazipaila, balamyonta boombe babezedwe. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.2",
            "verseOrgIds": [
              "HOS.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kako bayooba mbuli mayoba aacifumofumo, mbuli lume lufwambaana kumwaika, mbuli buungu bupepuka mucipolelo, ambuli busi buzwida acipulo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.3",
            "verseOrgIds": [
              "HOS.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.3",
            "verseOrgIds": [
              "HOS.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele ndime Jehova Leza wako iwakakupozya kuzwa kucisi ca-Egepita, Taakwe muzimu mweenzu ngozi, taakwe muvuni umbi kumbali lyangu pe. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.4",
            "verseOrgIds": [
              "HOS.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.8.11+DEU.8.12+DEU.8.13+DEU.8.14+DEU.8.15+DEU.8.16+DEU.8.17"
              },
              "items": [
                {
                  "text": "Dt 8:11-17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndakalikuzi munkanda, munyika iitakwe imvula. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.5",
            "verseOrgIds": [
              "HOS.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele bakajana zilyo akukuta, elyo mukukuta kwabo myoyo yabo yakalisumpula, aboobo bakandiluba, ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.6",
            "verseOrgIds": [
              "HOS.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino ndakababeda mbuli mulavu, ndabalangila munzila mbuli siluwe. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.7",
            "verseOrgIds": [
              "HOS.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njoobaswana mbuli cinyama cabbidwa bana baco, njoodeluula lulyananga lwamoyo wabo, njoobalidilila mbuli syuumbwa, amunyama wamusokwe uyoobakwamauna.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.8",
            "verseOrgIds": [
              "HOS.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
