              "items": [
                {
                  "text": "1 Kor 15:55",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sa nkabavune kujanza lyacuumbwe? Sa nkabanunune kulufu? Ne! Leta mapenzi aako, O cuumbwe? Koza alumoola lwako O lufu? Nsikonzyi kweempwa pe.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.14",
            "verseOrgIds": [
              "HOS.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
