        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.14",
            "verseOrgIds": [
              "HOS.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HOS 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nekuba kuti Efraimu acite micelo akati kabakwabo, kuyoosika muuwo wakujwe, iguwo lya-Jehova lizwa munkanda, liyoomanizya kasensa kakwe akuyuminizya cikala cakwe. Uyoosaalilwa ziyandisi zyakwe ambono zyakwe zyoonse zibotezya. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.15",
            "verseOrgIds": [
              "HOS.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HOS 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.18.12"
              },
              "items": [
                {
                  "text": "2 Bam 18:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Samariya uyoopegwa mulandu, nkaambo kakuti wakasampaula Leza wakwe. Bayoojazigwa apanga, atwana twabo tuyoopwayigwa, abalo banakazi babo bamitide bayooandulwa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.16",
            "verseOrgIds": [
              "HOS.13.16"
            ]
          }
        }
      ]
