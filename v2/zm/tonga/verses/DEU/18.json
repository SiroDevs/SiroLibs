            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.31.4"
              },
              "items": [
                {
                  "text": "2 Mak 31:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.12.44"
              },
              "items": [
                {
                  "text": "Neh 12:44",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Babe azyaabilo zyeelene zyakulya, kutaamba ezyo nzyaakaulisya.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.8",
            "verseOrgIds": [
              "DEU.18.8"
            ]
