                "loc": "DEU.12.29"
              },
              "items": [
                {
                  "text": "Dt 12:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwasika buyo kunyika eyo Jehova Leza wanu njamupa, mutaiyi kucita zisesemyo zyabamasi bakooko. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.9",
            "verseOrgIds": [
              "DEU.18.9"
            ]
          }
        },
