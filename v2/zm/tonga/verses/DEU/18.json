        {
          "text": "Jehova Leza wanu ulamubusizya musinsimi, akati kabanabakwanu, uuli mbuli ndime. Amuswiilile nguwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.15",
            "verseOrgIds": [
