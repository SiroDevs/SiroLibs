              },
              "items": [
                {
                  "text": "Lev 19:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "naba simabibo, naba sibusangu, naba sibamooba, naba muntu uubuzya makani kubafu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.11",
            "verseOrgIds": [
              "DEU.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
