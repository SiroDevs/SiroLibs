                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kutajanwi akati kanu muntu uutenta mwanaakwe mulombe na musimbi mumulilo, nanka muntu uusonda, naba munanga, naba mulozi, naba mucape, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.10",
            "verseOrgIds": [
              "DEU.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
