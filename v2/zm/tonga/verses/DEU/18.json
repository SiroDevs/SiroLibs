                "loc": "1CO.9.13"
              },
              "items": [
                {
                  "text": "1 Kor 9:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bapaizi ba-Levi, nkokuti musyobo woonse wa-Levi, tabakooyooba acaabilo neluba lukono akati kaba-Israyeli, Zipaizyo zitentelwa Jehova azyeelelo zyakwe zimwi ziyooba zilyo zyabo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.1",
            "verseOrgIds": [
              "DEU.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.20"
              },
              "items": [
                {
                  "text": "My 18:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tabakooyooba alukono akati kababunyina pe; Jehova ndolukono lwabo mbubonya mbwaakabaambila. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.2",
            "verseOrgIds": [
              "DEU.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.7.30"
              },
              "items": [
                {
                  "text": "Lev 7:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino nceeci caabilo ceelede bapaizi, cizwa kubantu, nkokuti bantu boonse batuula cipaizyo, naba musune niiba imbelele, Bapaizi bapegwe mweendo wacamba, amaseya obile, afu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.3",
            "verseOrgIds": [
              "DEU.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.22.29"
              },
              "items": [
                {
                  "text": "Kul 22:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.12"
              },
              "items": [
                {
                  "text": "My 18:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akalo kabalwebalwe kamaila aanu akamasaansa aanu akamafuta aanu, akabalwebalwe kaboya bwakugelwa kwambelele zyanu, zyoonse nzizyabo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.4",
            "verseOrgIds": [
              "DEU.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.10.8"
              },
              "items": [
                {
                  "text": "Dt 10:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo mbembabo Jehova Leza wanu mbaakasala akati kamisyobo yanu yoonse, kuti bacite milimo yabupaizi muzina lya-Jehova, balo abana babo mazuba oonse.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.5",
            "verseOrgIds": [
              "DEU.18.5"
            ]
          }
        }
      ]
