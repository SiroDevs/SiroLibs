                "loc": "MAT.5.48"
              },
              "items": [
                {
                  "text": "Mt 5:48",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.17.1"
              },
              "items": [
                {
                  "text": "Matl 17:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amululame kumeso aa-Jehova Leza wanu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.13",
            "verseOrgIds": [
              "DEU.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.21.6"
              },
              "items": [
                {
                  "text": "2 Bam 21:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo misyobo eyi njemuti tande balabika myoyo yabo kubananga akubasondi, pele nywebo, Jehova Leza wanu tamuzumizyi kucita obo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.14",
            "verseOrgIds": [
              "DEU.18.14"
            ]
          }
        }
