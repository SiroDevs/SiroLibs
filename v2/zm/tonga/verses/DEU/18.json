              "attrs": {
                "loc": "LEV.18.24"
              },
              "items": [
                {
                  "text": "Lev 18:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kufumbwa muntu uucita ezi ncisesemyo kuli-Jehova, Nkaambo kazisesemyo ezi Jehova ncabatandila kubusyu bwanu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.12",
            "verseOrgIds": [
              "DEU.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
