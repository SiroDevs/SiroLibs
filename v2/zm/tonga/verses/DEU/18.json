        },
        {
          "text": "Na mu-Levi walonga kuzwa muminzi yanu yamucisi ca-Israyeli, kufumbwa nkwakalakala, nkaambo moyo wakwe ulisukeme kuya kubusena mbwasala Jehova, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.6",
            "verseOrgIds": [
              "DEU.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "acite milimo yabupaizi muzina lya-Jehova Leza wakwe mbubonya mbuli ba-Levinyina boonse bacita milimo yabupaizi kubusyu bwa-Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.7",
            "verseOrgIds": [
              "DEU.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 18:8"
          },
          "items": [
            {
              "text": "8",
