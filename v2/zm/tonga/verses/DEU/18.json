            "sid": "DEU 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbubonya mbumwakakumbila kuli-Jehova Leza wanu ku-Horebu kubuzuba bwambungano, cakuti, Tutamvwi limbi ijwi lya-Jehova Leza wesu, nekuba kubona limbi oyu mulilo mupati, kuti tutafwi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.16",
            "verseOrgIds": [
              "DEU.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
