                  "text": "Int 119:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amucenjele loko kuti mubambe milazyo ya-Jehova Leza wanu, amilao yakwe, ambeta zyakwe nzyaakalailila. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.17",
            "verseOrgIds": [
