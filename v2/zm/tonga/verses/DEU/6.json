              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amuswiilile makani, noba-Israyeli, mucenjele kuzicita, kuti mukale kabotu akuzyalisya, mbubonya mbuli Jehova Leza wabamauso mbwaakasyomezya, munyika eyo iikunka malili abuci.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.3",
            "verseOrgIds": [
              "DEU.6.3"
            ]
          }
        }
