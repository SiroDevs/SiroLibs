          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amucite ziluleme azibotu kumeso aa-Jehova, kuti mukale kabotu, munjile akuvuba nyika imbotu Jehova njaakasyomezya bamauso, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.18",
            "verseOrgIds": [
              "DEU.6.18"
            ]
          }
        },
