        },
        {
          "text": "Lino mumazuba aaboola, bana banu nibayoomubuzya kuti, Nkutyeni milao amilazyo ambeta Jehova Leza wesu nzyaakatulailila? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.20",
            "verseOrgIds": [
              "DEU.6.20"
            ]
          }
        },
        {
          "name": "verse",
