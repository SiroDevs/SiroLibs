              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "mutande basinkondonyoko boonse kubusyu bwanu, mbubonya mbuli Jehova mbwaakaamba.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.19",
            "verseOrgIds": [
              "DEU.6.19"
