          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo wakatupozya nkukonya oko, kuti atunjizye akutupa nyika njaakasyomezya bamatateesu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.23",
            "verseOrgIds": [
