              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afuswe mabwe, afwe, nkaambo wakali kusoleka kumuleesya kuli-Jehova Leza wanu iwakamupozya munyika ya-Egepita amuŋanda yabuzike. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.10",
