        {
          "text": "nekuba kuti citondezyo na maleele ngaamba aba ncobeni, naamba kuti, Katuya tuka to bele baleza bambi (baleza mbotezi) akubamanina milimo, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.2",
            "verseOrgIds": [
              "DEU.13.2"
            ]
