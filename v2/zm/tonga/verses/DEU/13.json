              "items": [
                {
                  "text": "Dt 19:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ba-Israyeli boonse bamvwe, bayoowe, bataciti limbi bubi buli boobo akati kanu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.11",
