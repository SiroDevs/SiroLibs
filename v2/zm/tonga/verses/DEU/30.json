            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.11.19"
              },
              "items": [
                {
                  "text": "Ezk 11:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jehova Leza wanu uyoopalula myoyo yanu amyoyo yalunyungu lwanu, kuti muyandisye Jehova Leza wanu camoyo woonse acamuuya woonse, kuti mube abuumi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.6",
            "verseOrgIds": [
              "DEU.30.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Jebova Leza wanu uyookazika lutuko olu loonse kulibasinkondonyoko akulibaabo bamusulide ibakali kumupenzya. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.7",
            "verseOrgIds": [
              "DEU.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anywebo muyooboola alimwi kuswiilila ijwi lya-Jehova akubamba milazyo yakwe yoonse njendamulailila buzuba obuno. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.8",
            "verseOrgIds": [
              "DEU.30.8"
            ]
          }
        },
        {
