        {
          "text": "lino Jehova Leza wanu uyoolobya buzike bwanu, uyoomufwida luzyalo akumuyobolola alimwi kuzwa kumasi oonse Jehova Leza wanu nkwaakamutandilide. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.3",
            "verseOrgIds": [
              "DEU.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
