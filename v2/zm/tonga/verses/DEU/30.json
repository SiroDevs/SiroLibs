              },
              "items": [
                {
                  "text": "Joh 3:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tuuli kujulu; tamukonzyi kwaamba kuti, Ngwani uukonzya kuya kujulu kuyoouleta, kuti tuuswiilile akuucita? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.12",
            "verseOrgIds": [
              "DEU.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuuli mutala alwizi; tamukonzyi kwaamba kuti, Ngwani uukonzya kuzubuka lwizi kuyoouleta, kuti tuuswiilile akuucita? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.13",
            "verseOrgIds": [
              "DEU.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pe! Ijwi lili kufwaafwi loko, lili mukanwa lyanu amumyoyo yanu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.14",
            "verseOrgIds": [
