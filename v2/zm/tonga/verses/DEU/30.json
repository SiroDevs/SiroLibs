        {
          "text": "ndamuzibya buzuba obuno kuti ncobeni muyoonyonyooka; tamukooyoongola munyika eyo njemuyoovuba omo mutala lya-Jordano. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.18",
