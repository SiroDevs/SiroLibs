              },
              "items": [
                {
                  "text": "Neh 1:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nekuba kuti batandidwe banu bali kumagolelo aanyika, Jehova Leza wanu uyoomugwisya kuzwa oko akumuboozya. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.4",
            "verseOrgIds": [
              "DEU.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Leza wanu uyoomuboozya munyika njebakavuba bamauso, kuti mwiivube, nkabela uyoomupa coolwe akumuvuzya kwiinda bamausowanu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.5",
            "verseOrgIds": [
              "DEU.30.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.10.16"
              },
              "items": [
                {
                  "text": "Dt 10:16",
                  "type": "text"
                }
              ]
