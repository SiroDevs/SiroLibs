        {
          "text": "ancaakacitila Datani a-Abiramu bana ba-Eliabu mwana wa-Rubeni, nyika mbuyakaasama akubamena, antoomwe amaanda aabo azilao zyabo abaumi boonse mbebakajisi, akati kabana ba-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.6",
            "verseOrgIds": [
              "DEU.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nywebo meso aanu alibwene milimo yoonse mipati ya-Jehova njaakacita.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.7",
            "verseOrgIds": [
              "DEU.11.7"
            ]
