              "type": "text"
            }
          ]
        },
        {
          "text": "Lino amuyandisye Jehova Leza wanu, mubambe mulao wakwe amilazyo yakwe ambeta zyakwe amalailile aakwe mazuba conse. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.1",
            "verseOrgIds": [
              "DEU.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amuzibe buzuba obuno kuti teensi bana banu mbendaambila, batanaziba nanka kubona lutambisyo lwa-Jehova Leza wanu, bupati bwakwe ajanza lyakwe ijumu akuboko kwakwe kutandabikidwe, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.2",
            "verseOrgIds": [
              "DEU.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Kul 7:8–12:13",
              "type": "text"
            }
          ]
        },
        {
          "text": "azitondezyo zyakwe amilimo yakwe njaakacita akati kaba-Egepita kuli-Farao akunyika yakwe yoonse, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.3",
            "verseOrgIds": [
              "DEU.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
