              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo mulazubuka Jordano kuyoovuba nyika njamupa Jehova Leza wanu. Lino nemuyooivuba akukala mulinjiyo, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.31",
            "verseOrgIds": [
              "DEU.11.31"
            ]
          }
        },
