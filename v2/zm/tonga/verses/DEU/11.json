          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.14.28"
              },
              "items": [
                {
                  "text": "Kul 14:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ancaakacitila impi yaba-Egepita, imbizi zyabo ankalaki zyabo, mbwaakabatozya maanzi aa-Lwizi Lusalala ciindi eco nibakali kumutobela, a-Jehova mbwaakabanyonyoona kusikila asunu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.4",
            "verseOrgIds": [
              "DEU.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ancaakamucitila munkanda mane lumwi mwazoosika ano, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.5",
            "verseOrgIds": [
              "DEU.11.5"
            ]
          }
        },
