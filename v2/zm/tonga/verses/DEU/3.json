              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alakwe Joshua ndakamulailila kuciindi eco, ndati, Meso aako abona zintu zyoonse Jehova Leza wako nzyaakacitila bami aba bobile. Jehova ulacita mbubonya obo kuzisi zyoonse zyamutala nkosi ye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.21",
            "verseOrgIds": [
              "DEU.3.21"
            ]
          }
        },
