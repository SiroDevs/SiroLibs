                  "text": "Dt 4:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sa inga ndazubuka kuyoobona nyika imbotu iili mutala lya-Jordano, eco cisi cibotu cazilundulundu, a-Lebano? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.25",
            "verseOrgIds": [
              "DEU.3.25"
            ]
          }
        },
        {
