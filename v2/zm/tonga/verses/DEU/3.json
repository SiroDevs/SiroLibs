              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele banakazi banu abana banu aŋombe zyanu, (Ndizi kuti mulijisi iŋombe zinji), balasyaala muminzi yanu njindamupa, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.19",
            "verseOrgIds": [
