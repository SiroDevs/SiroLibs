                  "text": "Jos 22:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "mane Jehova akabape zilyokezezyo bana bakwanu, mbubonya mbwamupa kale, mane abalo bakavube nyika njabapa Jehova Leza wanu mutala lya-Jordano. Kwaba boobo, muyoopiluka umwi aumwi kulukono lwakwe ndondakamupa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.20",
            "verseOrgIds": [
              "DEU.3.20"
            ]
          }
        },
        {
          "name": "verse",
