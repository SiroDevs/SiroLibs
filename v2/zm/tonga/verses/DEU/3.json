                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela twakabanyonyoona mbubonya mbutwakacitila Sihoni mwami wa-Hesiboni. Minzi yoonse buyo, baalumi abanakazi abana, twakabanyonyoona boonse. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.6",
            "verseOrgIds": [
              "DEU.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele iŋombe, ambono zyoonse zyamuminzi, twakazisaala kuti zibe zyesu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.7",
            "verseOrgIds": [
              "DEU.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuboobo mbutwakanyanzya nyika kuciindi eco kuzwa kumaanza aabami bobile babaAmori ibakali mutala lya-Jordano, kuzwa kukalonga ka-Arinoni kusikila kucilundu ca-Herimoni, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.8",
            "verseOrgIds": [
              "DEU.3.8"
            ]
          }
        },
