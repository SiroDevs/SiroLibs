        },
        {
          "text": "Lino nindakamvwa aya makani, ndakadeluula zyakusama zyangu acikobela cangu, ndanonkola masusu aangu acilezu cangu, ndakala cakugamba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.9.3",
            "verseOrgIds": [
              "EZR.9.3"
            ]
          }
        },
