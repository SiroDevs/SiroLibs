                  "text": "Tus 13:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino bana banu basimbi, mutabapi kukukwatwa kubana babo balombe, abalo bana banu balombe mutabakwatyi bana babo basimbi. Mutayandauli abuniini kubaletela luumuno acoolwe, kuti mujate inguzu, mulye micelo mibotu yanyika akuvubya njiyo bana banu mazuba oonse. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.9.12",
            "verseOrgIds": [
              "EZR.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
