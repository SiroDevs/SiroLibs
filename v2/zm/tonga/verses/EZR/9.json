                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nkaambo balikwete bana babo basimbi, balo beni abana babo, aboobo basiluzubo lusalala balivwelene abantu bamasi; nkabela bapati abasilutwe mbobainda kubisya mumakani aya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.9.2",
