              "items": [
                {
                  "text": "Neh 9:36",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.136.23"
              },
              "items": [
                {
                  "text": "Int 136:23",
