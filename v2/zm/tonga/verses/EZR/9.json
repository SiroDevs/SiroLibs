            "sid": "EZR 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino kusule lyamakani aya oonse aatusikila nkaambo kamilimo yesu mibi amilandu yesu mipati, mbuli uwe O Leza wesu mbowatubweedezya milandu yesu buniini buyo kwiinda mbukweelede, alimwi mbotupa lufutuko luli boobu, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.9.13",
            "verseOrgIds": [
              "EZR.9.13"
            ]
          }
        },
