              "items": [
                {
                  "text": "Matl 15:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi mu-Jerusalemu mwakali bami basinguzu, ibakeendelezya zisi zyoonse zyakutala lyamulonga. Bakapegwa mutelo amusonko. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.20",
            "verseOrgIds": [
              "EZR.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZR 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino amulailile bantu aba kuti baleke. Oyu munzi tuuelede kuyakwa mane kuzwe ijwi kulindime. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.21",
            "verseOrgIds": [
              "EZR.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZR 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amucenjele, mutalubi kucita obo. Sa ncibotu kuti bubi buvule kukubisizya bami?",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.22",
            "verseOrgIds": [
              "EZR.4.22"
            ]
          }
        }
