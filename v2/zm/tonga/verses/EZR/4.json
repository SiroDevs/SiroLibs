              "type": "tag",
              "attrs": {
                "loc": "ACT.24.5"
              },
              "items": [
                {
                  "text": "Inc 24:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kuzibwe kumwami kuti ba-Juda ibakazwa kulinduwe kuza okuno kulindiswe basika ku-Jerusalemu, lino balayaka munzi mubi uupapila, Baliyakide malambo, azyalo intalisyo baliziside. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.12",
            "verseOrgIds": [
              "EZR.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.7.24"
              },
              "items": [
                {
                  "text": "Ezr 7:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.9.9"
              },
              "items": [
                {
                  "text": "Mt 9:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino kuzibwe kumwami kuti, na oyu munzi wayakwa, amalambo aawo na aimikwa, tabakooyoopa mutelo na musonko, aboobo uyoobisizya ziyobwedo zyamwami. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.13",
            "verseOrgIds": [
              "EZR.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mbutujisi malelo aazwa kuŋanda yamwami, alimwi takweelede kuti tubone kusampaulwa kwamwami, nciceeco ncitwatumina kukulwiida mwami, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.14",
            "verseOrgIds": [
              "EZR.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.3.8"
              },
              "items": [
                {
                  "text": "Es 3:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.17.6"
              },
              "items": [
                {
                  "text": "Inc 17:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
