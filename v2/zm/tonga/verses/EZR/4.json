                "loc": "ACT.17.7"
              },
              "items": [
                {
                  "text": "7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kuti makani alingulwe mubbuku lyamakani aaciindi aabamauso. Omo mubbuku uyoojana makani, uyooziba kuti oyu munzi ngumunzi uupapila, uubisizya bami azisi. Kalekale bakabusya inkondo mumunzi oyu. Nciceeco munzi nciwakamwayilwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.15",
            "verseOrgIds": [
              "EZR.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iswe tulazibya mwami kuti, na oyu munzi wayakwa, alimwi na malambo aawo aimikwa, nkukwaamba kuti tokooyooba acaabilo niciba comwe muzisi zyakookuno kutala lyamulonga.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.16",
            "verseOrgIds": [
              "EZR.4.16"
            ]
          }
        }
      ]
    },
