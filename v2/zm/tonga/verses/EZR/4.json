              "attrs": {
                "loc": "2KI.17.31"
              },
              "items": [
                {
                  "text": "31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bakalemba Rehumu simutelo a-Simisai mulembi abamwi beenzinyina, ba-Dinai aba-Afarisatikai aba-Tarapeli aba-Afarisai aba-Arekavai aba-Babuloni aba-Susanekai aba-Dehavi aba-Elami, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.9",
            "verseOrgIds": [
              "EZR.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.7.12"
              },
              "items": [
                {
                  "text": "Ezr 7:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "abamwi bamasi mwami mupati mulemu Asinapara mbaakatola mubuzike akubabika muminzi yaSamariya, abamwi ibakali okuno kutala lyamulonga, kuciindi caambwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.10",
            "verseOrgIds": [
              "EZR.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuboobu mbulwakaamba lugwalo ndubakamutumina, nkukuti ndubakatumina mwami Aritasasta.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.11",
            "verseOrgIds": [
              "EZR.4.11"
            ]
          }
        }
      ]
    },
    {
