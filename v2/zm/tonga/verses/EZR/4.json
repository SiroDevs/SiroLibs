          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumazuba aa-Aritasasta, Bisilamu, a-Miteridati a-Tabeeli abamwi beenzinyina bakalembela Aritasasta mwami wa-Persia lugwalo. Olo lugwalo lwakalembwa muci-Aramu akupandululwa muci-Aramu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.7",
            "verseOrgIds": [
              "EZR.4.7"
            ]
          }
        },
        {
          "name": "verse",
