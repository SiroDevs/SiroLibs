                "loc": "ROM.8.28"
              },
              "items": [
                {
                  "text": "Rom 8:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Rehumu simutelo a-Simisai mulembi mbobakalembela mwami Aritasasta lugwalo lwakubikila Jerusalemu kaambo. Mbuboobu mbubakalemba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.8",
            "verseOrgIds": [
              "EZR.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 4:9"
          },
          "items": [
