                  "text": "Jer 38:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo bantu bacisi bakatalika kulesya maanza aabantu ba-Juda milimo, akubakataazya mukuyaka. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.4",
            "verseOrgIds": [
              "EZR.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela bakalyuulila basikubagwasya kukujaya makanze aabo. Bakali kucita obo mazuba oonse Koresi mwami wa-Persia naakapona, mane lumwi Dariyo wakaba mwami wa-Persia, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.5",
            "verseOrgIds": [
              "EZR.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo mubwami bwa-Ahasuera, kumatalikilo aabwami bwakwe, bakalemba lugwalo lwakubikila bantu ba-Juda abakuJerusalemu kaambo.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.6",
            "verseOrgIds": [
              "EZR.4.6"
            ]
          }
        }
