                "loc": "EZR.5.3"
              },
              "items": [
                {
                  "text": "Ezr 5:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino uwe Tatinai, mweendelezi wakutala lyamulonga, a-Setara-bozenai, abeenzinyoko ba-Afarisikai bakutala lyamulonga, amuzwe oko kule. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.6",
            "verseOrgIds": [
              "EZR.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amuleke kukasya milimo yayeeyi iŋanda ya-Leza. Mweendelezi waba-Juda abapati baba-Juda bayake iŋanda eyi ya-Leza mubusena bwayo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.7",
            "verseOrgIds": [
              "EZR.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi ndamulailila mbumweelede kucitila bapati baba-Juda aba kukubagwasya kuyaka iŋanda ya-Leza. Muleelede kugwisya mali kumbono zyamwami, nkukuti mutelo wakutala lyamulonga, aakuliya bantu aba, kuti batakataazigwi mumilimo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.8",
            "verseOrgIds": [
              "EZR.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azintu nzibayanda, nkukuti boombe abagutu atubelele kukupaizizya Leza wakujulu, bulotwe, munyo, waini, amafuta, mbubaamba bapaizi baku-Jerusalemu, bapegwe buzuba bumwi abumwi cakutaleka, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.9",
            "verseOrgIds": [
              "EZR.6.9"
            ]
          }
        },
        {
