              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo mwami Dariyo wakalailila, nkabela makani akalingulwa muŋanda yamagwalo, zintu ziyandisi nkuzyakayobwedwe ku-Babuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.1",
            "verseOrgIds": [
              "EZR.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo ku-Akimeta, muŋanda yabwami yakucisi caba-Medi, kwakajanwa lugwalo lulembedwe obu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.2",
            "verseOrgIds": [
              "EZR.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwakati, Mumwaka mutaanzi wabwami bwa-Koresi, oyo mwami Koresi wakalailila aaŋanda ya-Leza yaku-Jerusalemu, wati, Iŋanda iyakwe, abwalo busena nkubakali kutuula zipaizyo. Intalisyo zyayo zibikwe kabotu. Bulamfu bwayo bube tukokola tuli makumi aali musanu akamwi, abwalo bwaamba bwayo bube tukokola tuli makumi aali musanu alimwi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.3",
            "verseOrgIds": [
              "EZR.6.3"
            ]
          }
        },
        {
          "name": "verse",
