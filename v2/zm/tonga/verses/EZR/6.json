        },
        {
          "text": "kuti bapaizizye Leza wakujulu zipaizyo zinunkilila kabotu, akukombela buumi bwamwami abwabana bakwe, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.10",
