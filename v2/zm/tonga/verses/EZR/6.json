        },
        {
          "text": "Azyalo zibelesyo zyangolida azyansiliva zyaŋanda ya-Leza, Nebukadinezara nzyaakagwisya muntempele yaku-Jerusalemu, nzyaakasisya ku-Babuloni, zibweedezegwe, zipiluke alimwi kuntempele yaku-Jerusalemu, cimwi acimwi kubusena bwaco, zibikwe muŋanda ya-Leza. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.5",
            "verseOrgIds": [
              "EZR.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
