        },
        {
          "text": "Alimwi ibe amindando yotatwe yamabwe mapati amundando wazisamu zipya. Amali aakuula zintu apegwe kuzwa kuŋanda yamwami. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.4",
            "verseOrgIds": [
