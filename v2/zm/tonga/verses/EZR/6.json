          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino iŋanda yakamana kuyakwa mubuzuba bwatatu bwamwezi Ada, mumwaka wamusanu aumwi wabwami bwamwami Dariyo.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.15",
            "verseOrgIds": [
              "EZR.6.15"
            ]
