              "items": [
                {
                  "text": "2 Tim 2:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "mubuzuba obo mbwazoobeteka Leza makani aasisidwe aabantu muli-Jesu Kristo, mbuli Makani Mabotu nginkambauka mebo.",
          "type": "text",
          "attrs": {
