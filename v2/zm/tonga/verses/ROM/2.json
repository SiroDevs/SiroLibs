            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.3.9"
              },
              "items": [
                {
                  "text": "3:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kulaba mapenzi amafwabi kuliboonse bantu bacita bubi, nibaba ba-Juda kukusaanguna nibaba ba-Helene, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.9",
            "verseOrgIds": [
              "ROM.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "pele bulemu akulemekwa aluumuno kuliboonse bacita bubotu, nibaba ba-Juda kukusaanguna nibaba ba-Helene, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.10",
            "verseOrgIds": [
              "ROM.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
