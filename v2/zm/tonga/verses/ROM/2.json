                  "text": "Inc 10:35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo bamasi batakwe Mulao nibacita camumoyo makani aamu-Mulao, elyo aba batakwe Mulao balibeda Mulao beni, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.14",
