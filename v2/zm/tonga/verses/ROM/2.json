                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo abo baswiilila Mulao teensi mbabo baluleme kumeso aa-Leza, pele abo bacita Mulao mbimbabo bazoolulamikwa, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.13",
