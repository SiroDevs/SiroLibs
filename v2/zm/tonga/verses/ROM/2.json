              "items": [
                {
                  "text": "1 Pet 1:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kwa-Leza takulangililwi ciwa pe, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.11",
            "verseOrgIds": [
              "ROM.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo boonse babisya mukubula Mulao balafwidilila mukubula Mulao, nkabela boonse babisya mu-Mulao balabetekwa nkukonya ku-Mulao. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.12",
            "verseOrgIds": [
              "ROM.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
