                "loc": "2CO.5.10"
              },
              "items": [
                {
                  "text": "2 Kor 5:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo uzooabila boonse mbuli milimo yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.6",
            "verseOrgIds": [
              "ROM.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo ibacita kabotu cabusungu akuyandaula mbubonya bulemu akulemekwa akutafwa, ulabaabila buumi butamani. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.7",
            "verseOrgIds": [
              "ROM.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.1.8"
              },
              "items": [
                {
                  "text": "2 Tes 1:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele abo ibakazyanya akutaswiilila lusinizyo, anukuti baswiilila kutalulama, ulabaabila lunyemo abukali. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.8",
            "verseOrgIds": [
              "ROM.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
