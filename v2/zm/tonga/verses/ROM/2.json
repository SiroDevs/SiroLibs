                "loc": "ROM.1.32"
              },
              "items": [
                {
                  "text": "Rom 1:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aba balatondezya mulimo wa-Mulao uulembedwe mumyoyo yabo, nkabela kuciindi nciconya manjezeezya aabo aalo alazumina, amiyeeyo yabo ilabapa milandu nanka kubalubusya ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.15",
            "verseOrgIds": [
              "ROM.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
