                  "text": "Joh 8:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kaako tojisi buliinsyo, omuntu kufumbwa noli buti obeteka, ikuti mumakani ayo ngobeteka mweenzinyoko ulalipa mulandu omwini nkaambo ulacita mbubonya, ayebo obeteka. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.1",
            "verseOrgIds": [
              "ROM.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tulizi kuti lubeteko lwaLeza lwakusinizya lulawida alimbabo bacita milimo iili boobo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.2",
            "verseOrgIds": [
              "ROM.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele ulayeeya buti, muntu obeteka bamwi bacita milimo iili boobo anukuti ulaicita mbubonya ayebo omwini? Sa uyooyokoka kulubeteko lwa-Leza? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.3",
            "verseOrgIds": [
              "ROM.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.3.15"
              },
              "items": [
                {
                  "text": "2 Pet 3:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi sa ulasampaula bunji bwaluzyalo lwakwe abusicamba bwakwe abukaliki bwamoyo wakwe, kukutaziba kuti luzyalo lwa-Leza ndolukweenzya kukweempwa? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.4",
            "verseOrgIds": [
              "ROM.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele mbuli buyumu bwako amoyo wako uuteempwi ulaliyobweda bukali mubuzuba bwabukali mbuluzooyubununwa lubeteko lululeme lwa-Leza. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.5",
            "verseOrgIds": [
              "ROM.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
