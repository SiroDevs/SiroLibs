          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.16",
            "verseOrgIds": [
              "ROM.10.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.43.1"
              },
              "items": [
                {
                  "text": "Is 43:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele teensi boonse bazuminina Makani Mabotu. Isaya ulaamba kuti, Mwami, nguni uuzuminina inkombe yesu? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.16",
            "verseOrgIds": [
              "ROM.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.17.20"
              },
              "items": [
                {
                  "text": "Joh 17:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino lusyomo lulazwa kunkombe, alimwi inkombe ilazwa kujwi lya-Leza. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.17",
            "verseOrgIds": [
              "ROM.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.19.4"
              },
              "items": [
                {
                  "text": "Int 19:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele ndabuzya kuti, Sa tabana kumvwa? Balimvwide.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.18",
            "verseOrgIds": [
              "ROM.10.18"
            ]
          }
        }
      ]
