                }
              ]
            }
          ]
        },
        {
          "text": "Pele sunu kulayubununwa bululami bwa-Leza butali bwa-Mulao, bulatondezegwa ku-Mulao akubasinsimi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.21",
