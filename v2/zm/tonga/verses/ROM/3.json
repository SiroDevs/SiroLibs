                  "text": "Rom 7:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kakuti kumilimo ya-Mulao taakwe muntu naba omwe uukonzya kululamikwa kumeso aakwe. Nkaambo ku-Mulao nkucizibika cibi.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.20",
