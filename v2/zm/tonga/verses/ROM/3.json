                  "text": "1 Pet 4:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Loko muziimbo zyoonse. Kukusaanguna, bakasyomenwa makani aa-Leza, ",
          "type": "text",
