                "loc": "2TI.2.13"
              },
              "items": [
                {
                  "text": "2 Tim 2:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkutyeni bamwi kuti, kabatasyomeki, sa kutasyomeka kwabo kulakonzya kubisizya lusyomo lwa-Leza? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.3",
            "verseOrgIds": [
              "ROM.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.51.4"
              },
              "items": [
                {
                  "text": "Int 51:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.116.11"
              },
              "items": [
                {
                  "text": "116:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ne! Leza abe musyomesi, nikuba kuti bantu boonse mbabeji, mbubonya mbukulembedwe kuti,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.4",
            "verseOrgIds": [
              "ROM.3.4"
            ]
          }
        }
      ]
    },
    {
