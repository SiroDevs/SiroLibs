            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.6.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sa tatukonzyi kucita bubi kuti kusike bubotu? (Mbubonya obo mbutulengelelwa kwaamba kubantu bamwi, Makani aabaaba alazulika cakululama).",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.8",
            "verseOrgIds": [
              "ROM.3.8"
            ]
          }
        }
