                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Obu bululami bwa-Leza mbubwakusyoma Jesu Kristo, mbubwabo boonse buyo basyoma, taakwe bwaanka. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.22",
