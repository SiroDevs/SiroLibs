                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino twaambe buti? Sa tucikonzya kukala muzibi kuti luzyalo lukainde kuvula? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.1",
            "verseOrgIds": [
              "ROM.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.4.1"
              },
              "items": [
                {
                  "text": "1 Pet 4:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ne! swebo tufwidide zibi tukonzya buti kucikala mulinzizyo? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.2",
            "verseOrgIds": [
              "ROM.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.3.27"
              },
              "items": [
                {
                  "text": "Gal 3:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sa tamuzi kuti toonse nitwakabapatizigwa muli-Jesu Kristo twakabapatizigwa mulufu lwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.3",
            "verseOrgIds": [
              "ROM.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.2.12"
              },
              "items": [
                {
                  "text": "Kol 2:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.3.21"
              },
              "items": [
                {
                  "text": "1 Pet 3:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aboobo twakazikwa awe mukubapatizigwa kwamulufu, kuti mbuli Kristo mbwaakabusigwa kuzwa kubafu kubulemu bwabawisi, mbubonya obo aswebo tukeende mubuumi bupya, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.4",
            "verseOrgIds": [
              "ROM.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.3.10"
              },
              "items": [
                {
                  "text": "Flp 3:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.3.11"
              },
              "items": [
                {
                  "text": "11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kuti twaba bagumene awe mucikozyano calufu lwakwe, elyo tuzooba awe mububuke bwakwe abwalo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.5",
            "verseOrgIds": [
              "ROM.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.5.24"
              },
              "items": [
                {
                  "text": "Gal 5:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo tulizi kuti muntu wesu mukulukulu wakabambulwa awe aciingano, kuti mubili wazibi ukalobesegwe, tutacibi mubuzike bwazibi, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.6",
            "verseOrgIds": [
              "ROM.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.4.1"
              },
              "items": [
                {
                  "text": "1 Pet 4:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ikuti mufu waangunwidwa mulandu wazibi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.7",
            "verseOrgIds": [
              "ROM.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele kuti twakafwa antoomwe a-Kristo, elyo tulasyoma kuti kupona akwalo tulapona awe, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.8",
            "verseOrgIds": [
              "ROM.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkaambo tulizi kuti Kristo mbuli mbwabukide kuzwa kubafu tacifwi limbi pe. Lufu talucili abwami bwanguwe pe, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.9",
            "verseOrgIds": [
              "ROM.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.26+HEB.9.27+HEB.9.28"
              },
              "items": [
                {
                  "text": "Heb 9:26-28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.2.19"
              },
              "items": [
                {
                  "text": "Gal 2:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.3.18"
              },
              "items": [
                {
                  "text": "1 Pet 3:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kufwa wakafwida zibi, ncalumwi luzutu, pele kupona ulaponena Leza. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.10",
            "verseOrgIds": [
              "ROM.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.5.15"
              },
              "items": [
                {
                  "text": "2 Kor 5:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.24"
              },
              "items": [
                {
                  "text": "1 Pet 2:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbubonya obo anywebo amuliyeeye mbuli bafwididwe zibi, pele baumi kuli-Leza muli-Kristo Jesu Mwami wesu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.11",
            "verseOrgIds": [
              "ROM.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.4.7"
              },
              "items": [
                {
                  "text": "Matl 4:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kaako mutazuminini zibi kuti zibe abwami mumibili yanu yanyama bwakumucitya kuti muzuminine zisusi zyayo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.12",
            "verseOrgIds": [
              "ROM.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.1"
              },
              "items": [
                {
                  "text": "Rom 12:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.5"
              },
              "items": [
                {
                  "text": "Ef 2:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.14"
              },
              "items": [
                {
                  "text": "5:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi mutaabili zibi zizo zyanu mbuli zicityo zyakutalulama, pele amulyaabile Leza mbuli bapononona bazwa kubafu, azizo zyanu amuzyaabile Leza mbuli zicityo zyabululami. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.13",
            "verseOrgIds": [
              "ROM.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.3.6"
              },
              "items": [
                {
                  "text": "1 Joh 3:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo zibi tazikooba abwami bwandinywe, ikuti tamuli kumi ku-Mulao, muli kumi kuluzyalo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.14",
            "verseOrgIds": [
              "ROM.6.14"
            ]
          }
        }
      ]
