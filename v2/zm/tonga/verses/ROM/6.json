                {
                  "text": "21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino nkutyeni? Sa tucite zibi, nkaambo kakuti tatuli kunsi ku-Mulao anukuti tuli kunsi kuluzyalo? Ne! ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.15",
            "verseOrgIds": [
              "ROM.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.8.34"
              },
              "items": [
                {
                  "text": "Joh 8:34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.2.19"
              },
              "items": [
                {
                  "text": "2 Pet 2:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sa tamuzi kuti umwi aumwi ngumulyaabila kukuswiilila, muli bazike bayooyo ngumuswiilila, nikuba zibi zileta lufu, nikuba luswiililo luleta bululami. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.16",
            "verseOrgIds": [
              "ROM.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele Leza alumbwe kuti mwakali bazike bazibi pele mwaswiilila camyoyo olo lwiiyo ndumwaabilwa, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.17",
            "verseOrgIds": [
              "ROM.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.8.32"
              },
              "items": [
                {
                  "text": "Joh 8:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nkabela lino mulilubulwidwe kuzibi, mwaba bazike babululami. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.18",
            "verseOrgIds": [
              "ROM.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Ndaamba cabuntu nkaambo kabulelu bwanyama bwanu), Lino mbuli mbumwakaabila busofwi akasampusampu zizo zyanu mbuli bazike bakasampusampu, mbubonya obo sunu amwaabile bululami zizo zyanu, mbuli bazike babusalazi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.19",
            "verseOrgIds": [
              "ROM.6.19"
