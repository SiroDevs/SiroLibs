          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.51.5"
              },
              "items": [
                {
                  "text": "Int 51:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.6"
              },
              "items": [
                {
                  "text": "Joh 3:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo tulizi kuti Mulao nguwamuuya, pele mebo ndi wanyama buyo, ndi muzike wazibi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.14",
            "verseOrgIds": [
              "ROM.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.5.17"
              },
              "items": [
                {
                  "text": "Gal 5:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eco ncincita nsicizi, nkaambo eco ncinjanda kucita teensi ncico ncincita pe, eco ncinsula ncencita. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.15",
            "verseOrgIds": [
              "ROM.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino kuti cintu ncintayandi ncencita, nkukuti ndazuminina Mulao kuti mubotu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.16",
            "verseOrgIds": [
              "ROM.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino teensi ndime uucicicita pe, nzizibi zindikalilide mukati. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.17",
            "verseOrgIds": [
              "ROM.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.6.5"
              },
              "items": [
                {
                  "text": "Matl 6:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.8.21"
              },
              "items": [
                {
                  "text": "8:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo ndizi kuti mulindime (nkukuti munyama yangu) tamukali cintu niciba cimwi cibotu. Ikuti kuzumina kwalo nkukuli, pele kucita cintu cibotu nsikujene pe, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.18",
            "verseOrgIds": [
              "ROM.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo cibotu ncinjanda nsiciciti pe, pele cibi ncintayandi ncico ncincita. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.19",
            "verseOrgIds": [
              "ROM.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino kuti cintu ncintayandi ncencita, nkukuti teensi ndime uucicicita pe, nzizibi zindikalilide mukati. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.20",
            "verseOrgIds": [
