                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.18"
              },
              "items": [
                {
                  "text": "Dt 5:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.21"
              },
              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino twaambe buti? Sa Mulao nzezibi? Ne! nikwatali Mulao, nindataakuzi zibi. Ikuti Mulao niwatakaamba kuti, Utabi sibbivwe nindataakuzi ibbivwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.7",
            "verseOrgIds": [
              "ROM.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.5.13"
              },
              "items": [
                {
                  "text": "Rom 5:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino zibi nizyakaba aciindi ceelede, zyakabelesya oyo mulazyo akucita mulindime mabbivwe oonse. Ikuti na taakwe Mulao, zibi zilifwide. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.8",
            "verseOrgIds": [
              "ROM.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mebo ciindi cimwi cakutaba a-Mulao ndakali muumi, pele mulazyo niwakasika, zibi zyakapononona elyo mebo ndakafwa, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.9",
            "verseOrgIds": [
              "ROM.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.1.15"
              },
              "items": [
                {
                  "text": "Jak 1:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.5"
              },
              "items": [
                {
                  "text": "Lev 18:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbuboobo mulazyo wakuleta buumi ndakaujana nguwenya kuti ngwalufu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.10",
            "verseOrgIds": [
              "ROM.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.3.13"
              },
              "items": [
                {
                  "text": "Matl 3:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo zibi nizyakajana ciindi ceelede, zyakabelesya mulazyo kuti zindeene, nkabela nguwenya nguzyakandijazya. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.11",
            "verseOrgIds": [
              "ROM.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.1.8"
              },
              "items": [
                {
                  "text": "1 Tim 1:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ncobeni Mulao ulasalala, awalo mulazyo ulasalala, uliluleme akubota. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.12",
            "verseOrgIds": [
              "ROM.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.5.20"
              },
              "items": [
                {
                  "text": "Rom 5:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino sa cintu cibotu ncicakandibeda lufu? Ne! nzizibi, nkaambo zibi nzizyakabelesya cintu cibotu cakundetela lufu, kuti zibi ziboneke mbuzibede, nkukuti zibi zibije loko nkaambo kamulazyo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.13",
            "verseOrgIds": [
              "ROM.7.13"
            ]
          }
        }
      ]
    },
