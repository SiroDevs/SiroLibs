              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mbuboobo mbunjana ku-Mulao, ciindi ncinjanda kucita kabotu, nceciindi nciconya ncetuli aco cibi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.21",
            "verseOrgIds": [
