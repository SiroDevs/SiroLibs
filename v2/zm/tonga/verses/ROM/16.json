                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.16"
              },
              "items": [
                {
                  "text": "Mt 10:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.14.20"
              },
              "items": [
                {
                  "text": "1 Kor 14:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele nywebo, buswiilizi bwanu buliide impuwo kubantu boonse. Nciceeco ncindamukondelwa. Lino ndayanda kuti mube basongo kumakani aabubotu, pele mube bafubafuba kumakani aabubi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.19",
            "verseOrgIds": [
              "ROM.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.15.33"
              },
              "items": [
                {
                  "text": "Rom 15:33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.3.15"
              },
              "items": [
                {
                  "text": "Matl 3:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino kaba kaindi buyo, Leza siluumuno ulamulyataulila Saatani kunsi lyamaulu aanu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.20",
            "verseOrgIds": [
              "ROM.16.20"
            ]
          }
        }
      ]
    },
    {
