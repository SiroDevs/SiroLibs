          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndamunaanizizya mucizi wesu Febe. Ngusimilimo wambungano yaku-Kenekreya, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.1",
            "verseOrgIds": [
              "ROM.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amumusamausye mu-Mwami mbuli mbubeelede kusamausyanya basalali, alimwi amumugwasye mumakani oonse aali buti ngaabula kulindinywe, nkaambo alakwe mwini kali mugwasyi wandime awabantu banji.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.2",
            "verseOrgIds": [
              "ROM.16.2"
            ]
          }
        }
      ]
    },
    {
