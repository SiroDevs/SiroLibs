              },
              "items": [
                {
                  "text": "Tit 3:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino ndamukumbila, nubakwesu, kuti mubalange abo babusya akati kanu inkazyanyo azilebyo zitali mbuli lwiiyo ndumwakaiya. Amubafutatile. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.17",
