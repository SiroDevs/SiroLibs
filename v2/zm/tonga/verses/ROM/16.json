          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luzyalo lwa-Mwami wesu Jesu Kristo lube anywe, Ameni.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.20",
            "verseOrgIds": [
              "ROM.16.20"
            ]
          }
        }
