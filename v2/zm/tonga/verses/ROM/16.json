                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.2.3"
              },
              "items": [
                {
                  "text": "2 Pet 2:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo bantu bali boobu tababelekeli Kristo Mwami wesu milimo, pe, balabelekela ida buyo lyabo beni, alimwi kumajwi aabo mabombe aamanya milomo baleena buyo myoyo yabantu babotu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.18",
            "verseOrgIds": [
              "ROM.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 16:19"
          },
          "items": [
