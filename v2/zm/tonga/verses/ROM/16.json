                "loc": "ACT.18.26"
              },
              "items": [
                {
                  "text": "26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amujuzye Priska a-Akula basimilimoma muli-Kristo Jesu, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.3",
            "verseOrgIds": [
              "ROM.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba bakatulila buumi bwangu insingo zyabo beni. Nkabela teensi ndime endike ndabalumba, pele imbungano zyoonse zyabamasi, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.4",
            "verseOrgIds": [
              "ROM.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.16.19"
              },
              "items": [
                {
                  "text": "1 Kor 16:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi amujuzye imbungano iibungana muŋanda yabo, Amujuzye Epeneto muyandwi wangu, nguwe kabalwebalwe ka-Asiya kwa-Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.5",
            "verseOrgIds": [
              "ROM.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amujuzye Maliya, oyo iwakamubelekela loko cabusungu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.6",
            "verseOrgIds": [
              "ROM.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.8.23"
              },
              "items": [
                {
                  "text": "2 Kor 8:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amujuzye Androniko a-Juniya basiluzuboma abaangema, Aba bali ampuwo akati kabaapostolo, alimwi bakataangunina ndime muli-Kristo, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.7",
            "verseOrgIds": [
              "ROM.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amujuzye Ampliato muyandwi wangu wamu-Mwami. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.8",
            "verseOrgIds": [
              "ROM.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amujuzye Urbano similimoma wamuli-Kristo, alakwe Staku muyandwi wangu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.9",
            "verseOrgIds": [
              "ROM.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amujuzye Apele muna-Kristo musunke. Amujuzye baciinga bakwe Aristobulo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.10",
            "verseOrgIds": [
              "ROM.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amujuzye Herodiona siluzuboma, Amubajuzye baciinga bakwe Narkiso bali mu-Mwami. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.11",
            "verseOrgIds": [
              "ROM.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amujuzye Trufena a-Trufosa basimilimo basungu ba-Mwami. Amujuzye Persida muyandwi, oyo iwakabeleka loko cabusungu mu-Mwami. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.12",
            "verseOrgIds": [
              "ROM.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.15.21"
              },
              "items": [
                {
                  "text": "Mk 15:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amujuzye Rufo musali wamu-Mwami, abanyina, mbabonya bama ambebo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.13",
            "verseOrgIds": [
              "ROM.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amujuzye ba-Asunikrito, a-Felego, a-Herme, a-Patroba, a-Herma abakwesu mbubali abo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.14",
            "verseOrgIds": [
              "ROM.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amujuzye Filologo a-Julia, a-Nerea amucizi wakwe, a-Olumpa aboonse basalali mbobakala abo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.15",
            "verseOrgIds": [
              "ROM.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.16.20"
              },
              "items": [
                {
                  "text": "1 Kor 16:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.5.14"
              },
              "items": [
                {
                  "text": "1 Pet 5:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amujuzyanye alumyonto lusalala. Imbungano zyoonse zya-Kristo zilamujuzya.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.16",
            "verseOrgIds": [
              "ROM.16.16"
            ]
          }
        }
      ]
    },
