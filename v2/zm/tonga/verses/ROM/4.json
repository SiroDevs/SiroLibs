                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo teensi ku-Mulao nkucakazwa cisyomezyo ncaakapegwa Abrahamu anyungu zyakwe cakuti uzookona nyika, cakazwa kubululami bwalusyomo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.13",
