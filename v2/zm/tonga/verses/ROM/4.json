              },
              "items": [
                {
                  "text": "Int 32:1-2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wati,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.7",
            "verseOrgIds": [
              "ROM.4.7"
            ]
