              "items": [
                {
                  "text": "Gal 3:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kaako ncalusyomo, kuti cibe caluzyalo, kuti cisyomezyo cibe calusinizyo kunyungu zyoonse; tacili cabasimulao luzutu pe, ncaboonse basilusyomo mbuli lwa-Abrahamu, nguwenya taateesu toonse, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.16",
            "verseOrgIds": [
