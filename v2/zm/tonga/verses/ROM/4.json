                  "text": "10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ikuti Mulao ulaleta bukali, pele kutakwe Mulao nkukonya kutakwe mulandu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.15",
            "verseOrgIds": [
              "ROM.4.15"
            ]
