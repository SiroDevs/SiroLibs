                  "text": "Gal 3:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo bana ba-Mulao kuti mbabo mbibaswaana, elyo lusyomo lwasampuka, acalo cisyomezyo caba cabuyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.14",
            "verseOrgIds": [
