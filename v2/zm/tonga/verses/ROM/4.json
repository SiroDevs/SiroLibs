              "items": [
                {
                  "text": "Mt 3:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.21"
              },
              "items": [
                {
                  "text": "1 Pet 2:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.12.18"
              },
              "items": [
                {
                  "text": "2 Kor 12:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "alimwi abe wisaabo, abo batali basibupalule buyo pele beenda munzila zyalusyomo olo ndwaakajisi taateesu Abrahamu naakacili alulomo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.12",
