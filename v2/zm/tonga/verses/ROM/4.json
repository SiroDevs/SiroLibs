            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino twaambe buti aa-Abrahamu taateesu waku nyama? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.1",
            "verseOrgIds": [
              "ROM.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo Abrahamu kuti wakalulamikwa kumilimo, ulijisi cintu cakulikankaizi­ zya, anukuti kumeso aa-Leza taakwe pe. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.2",
            "verseOrgIds": [
              "ROM.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.15.6"
              },
              "items": [
                {
                  "text": "Matl 15:6",
