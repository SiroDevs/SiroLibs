          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uli acoolwe oyo muntu ngwateelezezyi Jehova zibi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.8",
            "verseOrgIds": [
              "ROM.4.8"
