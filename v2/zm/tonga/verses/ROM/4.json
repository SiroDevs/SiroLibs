            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.2.23"
              },
              "items": [
                {
                  "text": "Jak 2:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo malembe alaamba buti? Ati, Abrahamu wakasyoma Leza, nkabela lusyomo lwakwe lwakeclezegwa mbuli bululami. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.3",
            "verseOrgIds": [
              "ROM.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.11.6"
              },
              "items": [
                {
                  "text": "Rom 11:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.20.7"
              },
              "items": [
                {
                  "text": "Mt 20:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.20.14"
              },
              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino ciliyo casimilimo tacaambwi mbuli cigwasyo buyo pe, cilaambwa mbuli mulandu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.4",
            "verseOrgIds": [
              "ROM.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele oyo uutabeleki, pele ulasyoma sikululamika basizibi, kuliyooyo lusyomo lwakwe lulaambwa mbuli bululami. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.5",
            "verseOrgIds": [
              "ROM.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.32.1"
              },
              "items": [
                {
                  "text": "Int 32:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.32.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbubonya obo alakwe Davida mbwaamba coolwe camuntu ngwaelezya Leza bululami cakutaamba milimo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.6",
            "verseOrgIds": [
              "ROM.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
