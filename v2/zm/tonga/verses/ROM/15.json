        },
        {
          "text": "Nkaambo bakazumina bana-Makedoniya abana-Akaya kupa imwi milumbo yakugwasya basalali bacete baku-Jerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.26",
