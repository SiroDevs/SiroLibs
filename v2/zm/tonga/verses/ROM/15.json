          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.15.24"
              },
              "items": [
                {
                  "text": "Mt 15:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.3.25"
              },
              "items": [
                {
                  "text": "Inc 3:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndaamba kuti Kristo wakaba mulanda wabasibupalule nkaambo kalusinizyo lwa-Leza, kuti azuzye insyomezyo Ine nzibakapegwa bamataata, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.8",
            "verseOrgIds": [
              "ROM.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
