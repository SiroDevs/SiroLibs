            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.11.30"
              },
              "items": [
                {
                  "text": "Rom 11:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "akuti bamasi balemeke Leza nkaambo kalweetelelo lwakwe, mbuli mbukulembedwe kuti,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.9",
            "verseOrgIds": [
              "ROM.15.9"
            ]
