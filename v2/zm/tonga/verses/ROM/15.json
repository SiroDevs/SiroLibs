          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti nkavunwe kulibasicinguni baku-Judaya akuti milimo yangu yaku-Jerusalemu ikatambulike kubasalali, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.31",
            "verseOrgIds": [
              "ROM.15.31"
            ]
          }
        },
        {
