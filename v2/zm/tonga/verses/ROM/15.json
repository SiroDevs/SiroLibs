              "attrs": {
                "loc": "PSA.69.9"
              },
              "items": [
                {
                  "text": "Int 69:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo Kristo alakwe teewakalikondezya mwini, pele mbuli mbukulembedwe kuti, Insyolauko zyabaabo bakasyolauka nduwe zyakandiwida mebo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.3",
            "verseOrgIds": [
              "ROM.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 15:4"
          },
          "items": [
