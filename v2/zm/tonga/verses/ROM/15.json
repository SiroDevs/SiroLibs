                "loc": "2CO.10.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele ndipangide moyo kukukambauka Makani Mabotu nkwatazibidwe izina lya-Kristo, kuti ntakayaki antalisyo yamuntu umbi, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.20",
            "verseOrgIds": [
              "ROM.15.20"
            ]
          }
        },
        {
