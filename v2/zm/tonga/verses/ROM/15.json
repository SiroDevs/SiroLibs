              "items": [
                {
                  "text": "Rom 1:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela ndizi kuti ciindi ncinti sike kulindinywe, nzooza acoolwe cizwide ca-Kristo,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.29",
            "verseOrgIds": [
              "ROM.15.29"
            ]
