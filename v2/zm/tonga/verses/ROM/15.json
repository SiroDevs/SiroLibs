        },
        {
          "text": "Lino swebo tubayumu tuleelede kuyumuna matenda aabaabo batali bayumu, tatweelede kulikondezya tubeni pe. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.1",
            "verseOrgIds": [
