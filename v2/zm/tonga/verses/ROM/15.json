            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.10.11"
              },
              "items": [
                {
                  "text": "1 Kor 10:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo makani aali boobo aakalembwa kalekale, nkukwiiya kwesu nkwaakalembelwa, kuti kubukakatilo akubukombelezyo bwamalembe tujane bulangizi bwaku-tontozya moyo, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.4",
            "verseOrgIds": [
              "ROM.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.3.16"
              },
              "items": [
                {
                  "text": "Flp 3:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Leza wabukakatilo abukombelezyo amupe bujatano bwacinkaminwe mbuli Kristo Jesu, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.5",
            "verseOrgIds": [
              "ROM.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti camoyo omwe acamulomo omwe mulemeke Leza wisi Mwami wesu Jesu Kristo,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.6",
            "verseOrgIds": [
              "ROM.15.6"
            ]
          }
        }
      ]
    },
    {
