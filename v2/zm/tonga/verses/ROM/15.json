          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo kuti kayanda Leza ndakonzya kuza kulindinywe cakukondwa, akulyokezya antoomwe andinywe, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.32",
            "verseOrgIds": [
              "ROM.15.32"
            ]
          }
        },
        {
