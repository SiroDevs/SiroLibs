              "ROM.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino ime ndalamwa aandinywe, nubakwesu, kuti inywe nubeni mulizwide bubotu, mulilondokede muluzibo loonse, akukonzya kwiisyanya. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.14",
            "verseOrgIds": [
              "ROM.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.1.5"
              },
              "items": [
                {
                  "text": "Rom 1:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.3"
              },
              "items": [
                {
                  "text": "12:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nekubaboobo ndalitakata kumulembela, nubakweesu kumwi kuti nkamwiibalusye, nkaambo kaluzyalo ndundapegwa kwa-Leza, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.15",
            "verseOrgIds": [
              "ROM.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.11.13"
