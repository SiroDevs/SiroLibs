                  "text": "Rom 9:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bakazumina kucita obo, pele ncobeni balijisi mulandu abatengwana kulimbabo. Nkaambo bamasi, mbuli mbubakatambula caabilo cazintu zyamuuya zyabaabo, baleelede kubapa caabilo cazintu zyabo zyanyama. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.27",
            "verseOrgIds": [
              "ROM.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ROM 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino ndamana milimo eyi, akusinizya kuti eyi milumbo ili mumaanza aabo, nzooinda kulindinywe kukuya ku-Spanya. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.28",
            "verseOrgIds": [
              "ROM.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ROM 15:29"
          },
          "items": [
