          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.11.20"
              },
              "items": [
                {
                  "text": "2 Mak 11:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakeendelezya myaka yotatwe mu-Jerusalemu, Izina lyabanyina kali Mikaya mwana musimbi wa-Urieli waku-Gibeya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.2",
            "verseOrgIds": [
              "2CH.13.2"
            ]
          }
        }
      ]
    },
    {
