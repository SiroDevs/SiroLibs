        },
        {
          "text": "Mumwaka wakumi amusanu aitatu wabwami bwa-Jeroboamu, Abija wakaba mwami wacisi ca-Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.1",
            "verseOrgIds": [
