            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Abija a-Jeroboamu bakali kulwana. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.2",
            "verseOrgIds": [
              "2CH.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Abija wakaya kunkondo, kali abasilumamba basinguzu basalidwe bali zyuulu zili myanda yone. Alakwe Jeroboamu wakabamba mindando yakumulwisya, kali abasilumamba basinguzu basalidwe bali zyuulu zili myanda iili musanu aitatu, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.3",
            "verseOrgIds": [
              "2CH.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
