          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.18.22"
              },
              "items": [
                {
                  "text": "Jos 18:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Abija wakanyampuka acilundu ca-Zemaraimu, cili mutulundulundu twa-Efraimu, wakati, Amundiswiilile, O Jeroboamu anyoonse nuba-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.4",
            "verseOrgIds": [
              "2CH.13.4"
            ]
          }
        },
