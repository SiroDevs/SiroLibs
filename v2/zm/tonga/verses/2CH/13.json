          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abija abantu bakwe bakabauma aluumo lupati, nkabela kwakajayigwa akati kaba-Israyeli bantu basalidwe bali zyuulu zili myanda yosanwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.17",
