                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo bantu ba-Juda bakoonzomoka, nkabela ba-Juda nibakoonzomoka, Leza wakauma Jeroboamu aba-Israyeli boonse kubusyu bwa-Abija aba-Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.15",
            "verseOrgIds": [
