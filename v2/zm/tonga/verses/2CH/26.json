        },
        {
          "text": "Nkabela Uziya wakayaka zisanza mu-Jerusalemu ku-Mulyango wacooko aku-Mulyango wakuti aku-Cooko, waziyumya, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.9",
            "verseOrgIds": [
