                  "text": "10:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakabika moyo wakwe kukuyandaula Leza mumazuba aa-Zekariya iwakali kumwiisya mubuyoofu bwa-Leza, Nkabela mazuba oonse naakali kubika moyo wakwe kuli-Jehova, Leza wakamupa coolwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.5",
            "verseOrgIds": [
              "2CH.26.5"
            ]
          }
        }
