                  "text": "2 Mak 21:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi wakayaka zisanza kunkanda akusya mikalo minji, nkaambo kajisi iŋombe zinji, kutulundulundu akumabanda, alimwi kajisi basikulima abasikubamba masaansa mumalundu amunyika yamicelo, nkaambo wakali kuyanda nyika.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.10",
            "verseOrgIds": [
              "2CH.26.10"
            ]
          }
        }
