                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo bantu boonse ba-Juda bakabweza Uziya, iwakajisi myaka iili ikumi amusanu aumwi, bamupa bwami mucimanga cawisi Amaziya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.1",
            "verseOrgIds": [
              "2CH.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngonguwe iwakayakulula Elati akuuboozya mumaanza aaba-Juda kusule lyalufu lwamwami. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.2",
            "verseOrgIds": [
              "2CH.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uziya kajisi myaka iili ikumi amusanu aumwi naakaba mwami, nkabela wakeendelezya mu-Jerusalemu myaka iili makumi osanwe aibili. Izina lyabanyina kabali Jekoliya waku-Jerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.3",
            "verseOrgIds": [
              "2CH.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela wakacita ziluleme mumeso aa-Jehova, mbubonya mbwaakacita wisi Amaziya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.4",
            "verseOrgIds": [
              "2CH.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 26:5"
          },
          "items": [
