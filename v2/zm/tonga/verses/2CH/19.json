                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi mu-Jerusalemu Josafati wakabika bamwi ba-Levi abapaizi abapati banzubo zya-Israyeli kuti babe babetesi ba-Jehova akukosola makani, Bakakala ku-Jerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.8",
            "verseOrgIds": [
              "2CH.19.8"
            ]
          }
        },
