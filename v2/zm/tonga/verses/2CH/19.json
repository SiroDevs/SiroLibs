                  "text": "2 Sam 23:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela wakabalailila kuti, Mbuboobu mbumweelede kucita, Amubeteke cakuyoowa Jehova acakusyomeka acamoyo uululeme. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.9",
            "verseOrgIds": [
