                }
              ]
            }
          ]
        },
        {
          "text": "Mpoonya awo Jehova wakauma ba-Kusi kunembo lya-Asa alyaba-Juda, nkabela ba-Kusi bakacija. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.12",
            "verseOrgIds": [
              "2CH.14.12"
            ]
          }
