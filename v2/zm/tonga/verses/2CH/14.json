                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.11.7"
              },
              "items": [
                {
                  "text": "1 Bam 11:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakagwisya zipaililo zyeenzu azipaililo zyakuzilundu, alimwi wakamwaya zilende akugonka zifwanikisyo zyamituni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.3",
            "verseOrgIds": [
              "2CH.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakaambila ba-Juda kuti bayandaule Jehova Leza wabamawisi akubamba mulao amilazyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.4",
            "verseOrgIds": [
              "2CH.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muminzi yoonse ya-Juda wakagwisya zipaililo zyakuzilundu azipaililo zyazuba, Nkabela cisi cakalikede aluumuno kubusyu bwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.5",
            "verseOrgIds": [
              "2CH.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi wakayaka minzi iili alubaya mucisi ca-Juda, nkaambo nyika yakalikede aluumuno. Katajisi inkondo mumyaka eyo, nkaambo Jehova wakamupa luumuno. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.6",
            "verseOrgIds": [
              "2CH.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino wakaambila ba-Juda kuti, Atuyake minzi eyi akwiizyungulusya malambo amaanda malamfu, zitendele aminkulu. Nyika icili yesu, nkaambo twayandaula Jehova Leza wesu, Twamuyandaula, lino watupa luumuno kumabazu oonse. Elyo bakayaka akujana coolwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.7",
            "verseOrgIds": [
              "2CH.14.7"
            ]
          }
        }
      ]
    },
