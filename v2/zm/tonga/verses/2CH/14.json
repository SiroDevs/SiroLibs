            }
          ]
        },
        {
          "text": "Lino Zera muKusi wakeza kuzoobalwisya, kali abasilumamba bali zyuulu zili cuulu ankalaki zili myanda yotatwe. Nkabela wakasika ku-Maresa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.9",
            "verseOrgIds": [
              "2CH.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Asa wakainka kuyoobalwisya, wabamba basilumamba mumindando mukuti lya­-Zefata ku-Maresa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.10",
            "verseOrgIds": [
              "2CH.14.10"
            ]
