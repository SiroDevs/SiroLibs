        {
          "text": "Nkabela ciindi Solomoni ncaakeendelezya mu-Jerusalemu kuba-Israyeli boonse cakaba myaka iili makumi one. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.30",
