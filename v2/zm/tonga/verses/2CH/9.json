              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino bulemu bwangolida iyakasika kuli-Solomoni mumwaka omwe bwakali matalenta aangolida aali myanda iili musanu aumwi amakumi aali musanu alimwi amusanu alimwi, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.13",
            "verseOrgIds": [
              "2CH.9.13"
            ]
          }
        },
