        },
        {
          "text": "Alimwi balanda ba-Huramu abalanda ba-Solomoni, ibakaleta ingolida kuzwa ku-Ofiri, bakeza azisamu zyaalgumi amabwe mayandisi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.10",
            "verseOrgIds": [
              "2CH.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela zisamu zyaalgumi mwami wakazibezya matantilo aamuŋanda ya-Jehova amuŋanda yamwami, atuntimbwa anyeele zyabasikwiimba. Teekwakaboneka limbi zili boobo mucisi ca-Juda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.11",
            "verseOrgIds": [
              "2CH.9.11"
            ]
          }
        }
      ]
