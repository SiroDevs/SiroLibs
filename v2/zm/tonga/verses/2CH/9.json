            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.72.19"
              },
              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alumbwe Jehova Leza wako, nkaambo wakabotelwa nduwe, aboobo wakakubika acuuno cabwami bwakwe, kuti ube mwami kuliJehova Leza wako, Leza wako kayandisya ba-Israyeli, Nciceeco ncaakababambila kabotu akukubika kuti ubeendelezye, ube mwami, ucite lubeta abululami. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.8",
            "verseOrgIds": [
              "2CH.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela wakapa mwami matalenta aangolida aali mwanda amakumi obile, amisamu mibotu amabwe mayandisi manji loko, Katakwe misamu iyakaboneka iyakeelene ayeeyo mwami mwanakazi waku-Seba njaakapa mwami Solomoni.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.9",
            "verseOrgIds": [
              "2CH.9.9"
            ]
          }
        }
      ]
