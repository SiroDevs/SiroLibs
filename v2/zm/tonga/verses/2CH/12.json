          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.16.8"
              },
              "items": [
                {
                  "text": "2 Mak 16:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakeza ankalaki zili cuulu amyanda yobile abasimbizi bali zyuulu zili makumi aali musanu alimwi. Abantu mbaakeza abo kuzwa ku-Egepita teebakabalika pe, ba-Lubi aba-Suki aba-Kusi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.3",
            "verseOrgIds": [
              "2CH.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela wakazunda minzi miyumu yamucisi ca-Juda, aboobo wakasika ku-Jerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.4",
            "verseOrgIds": [
              "2CH.12.4"
            ]
          }
        },
