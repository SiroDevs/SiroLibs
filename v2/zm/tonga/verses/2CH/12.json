                "loc": "1KI.14.25"
              },
              "items": [
                {
                  "text": "25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino mumwaka wasanu wabwami bwa-Roboamu, wakasika Sisaki mwami waEgepita kuzoolwisya Jerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.2",
            "verseOrgIds": [
              "2CH.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
