              },
              "items": [
                {
                  "text": "14:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela mwami wakabaambila cabukali. Mwami Roboamu wakaleka lulayo lwabapati, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.13",
            "verseOrgIds": [
              "2CH.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "akubaambila mbubonya mbubakamulaya banikenyina. Wakati, Taata wakamulemezya ijoko, lino mebo njooyungizizya ijoko lyanu bulemu. Taata wakamuumya mitatula, mebo njoomuumya tubanze. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.14",
            "verseOrgIds": [
              "2CH.10.14"
            ]
          }
        },
