                  "text": "Tus 15:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bakavuwa kuti, Na wafwida bantu aba luse, akubabotezya, akubaambila majwi mabotu, elyo bayooba bazike bako mazuba oonse. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.7",
            "verseOrgIds": [
              "2CH.10.7"
            ]
          }
        },
        {
