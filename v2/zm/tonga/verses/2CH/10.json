              },
              "items": [
                {
                  "text": "1 Bam 11:40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Jeroboamu mwana wa-Nebati naakamvwa, oko ku-Egepita nkwaakabede, nkwaakacijide kuzwa kumwami Solomoni, Jeroboamu wakapiluka kuzwa ku-Egepita. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.2",
            "verseOrgIds": [
              "2CH.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela bakatuma kuyoomwiita, elyo Jeroboamu ambungano yoonse yabaIsrayeli bakeza kuzooambila Roboamu kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.3",
            "verseOrgIds": [
              "2CH.10.3"
            ]
          }
        },
