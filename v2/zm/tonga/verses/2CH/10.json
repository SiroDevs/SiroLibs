                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uso wakatulemezya mukuli. Lino webo, kotuubulwida cibbalo ciyumu causo amukuli wakwe mulemu ngwaakatulemezya, elyo tuyookubelekela milimo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.4",
            "verseOrgIds": [
              "2CH.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo wakabaambila kuti, Amwaanzaane mazuba otatwe, mukaboole alimwi, Lino bantu bakaanzaana.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.5",
            "verseOrgIds": [
              "2CH.10.5"
            ]
          }
        }
