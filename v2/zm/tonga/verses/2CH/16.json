        },
        {
          "text": "Lino kuciindi eco Hanani sicilengano wakasika kuli-Asa mwami waJuda, wamwaambila kuti, Mbubonya mbuwakasyoma mwami wa-Aramu akutasyoma Jehova Leza wako, nciceeco impi zyamwami wa-Aramu ncizilobokela kumaanza aako. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.7",
            "verseOrgIds": [
              "2CH.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
