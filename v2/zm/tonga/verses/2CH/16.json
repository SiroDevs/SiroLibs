          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Asa wakabikwa mukabanda antoomwe abamawisi. Wakafwa mumwaka wamakumi one aumwi wabwami bwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.13",
            "verseOrgIds": [
              "2CH.16.13"
            ]
          }
        },
