            }
          ]
        },
        {
          "text": "Lino makani oonse aa-Asa, mataanzi amasyaalizi, alilembedwe mubbuku lyabami ba-Juda aba-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.11",
