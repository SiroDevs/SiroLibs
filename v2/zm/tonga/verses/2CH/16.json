              "type": "tag",
              "attrs": {
                "loc": "JER.17.5"
              },
              "items": [
                {
                  "text": "Jer 17:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo mumwaka wamakumi otatwe amusanu aine wabwami bwakwe Asa wakaciswa kumaulu. Wakaciswa loko, nekubaboobo mukuciswa kwakwe takwakabika moyo wakwe kuli-Jehova, pe, wakaubika kubananga. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.12",
            "verseOrgIds": [
              "2CH.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
