                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Asa wakanyemena oyo sicilengano, wamubika muŋanda yaziliba muntolongo, nkaambo wakamukalalila nkaambo kamakani aya. Nkabela Asa wakapenzya abamwi bantu kuciindi eco nciconya,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.10",
            "verseOrgIds": [
              "2CH.16.10"
            ]
