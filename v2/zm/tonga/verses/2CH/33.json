                  "text": "Int 132:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela wakabika cikozyano cibezedwe ncaakapanga muŋanda ya-Leza, njenjiyo iŋanda Leza njaakaambila Davida a-Solomoni mwana wakwe kuti, Muŋanda eyi amuJerusalemu ngundisalide akati kamisyobo yoonse ya-Israyeli njoobika izina lyangu lyoonse. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.7",
            "verseOrgIds": [
              "2CH.33.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 33:8"
