        },
        {
          "text": "Nsikooyoogwisya limbi maulu aaba-Israyeli munyika njindakabambila bamauso, na bapangika myoyo yabo kukucita zyoonse nzindabalailila, mbuli mulao woonse amilazyo yoonse ambeta zyoonse nzindakabapa kumulomo wa-Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.8",
            "verseOrgIds": [
              "2CH.33.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele Manase wakaleesya ba-Juda abantu baku-Jerusalemu, mane lumwi bakacita bubi kwiinda bamasi Jehova mbaakatandide kubusyu bwaba-Israyeli,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.9",
            "verseOrgIds": [
              "2CH.33.9"
            ]
          }
        }
