              },
              "items": [
                {
                  "text": "1 Bam 8:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakayaka zipaililo muŋanda ya-Jehova njaakaamba Jehova kuti, Mu-Jerusalemu moliyooba izina lyangu lyoonse. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.4",
            "verseOrgIds": [
              "2CH.33.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 33:5"
          },
          "items": [
