                "loc": "2CH.4.9"
              },
              "items": [
                {
                  "text": "2 Mak 4:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakayakila makamu oonse aakujulu zipaililo mumabanza obile aaŋanda ya-Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.5",
