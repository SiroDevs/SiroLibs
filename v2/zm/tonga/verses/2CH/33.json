        },
        {
          "text": "Wakainzya bana bakwe mumulilo mukuti lyamwana waHinomu. Wakali kusonda akulowa, alimwi wakali kubelesya balozi abasondi. Wakacita bubi bunji mumeso aa-Jehova akumukalazya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.6",
            "verseOrgIds": [
              "2CH.33.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
