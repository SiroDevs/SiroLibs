          ]
        },
        {
          "text": "Amabbiza aa-Solomoni akaletwa kuzwa ku-Egepita aku-Kue. Basambazi bamwami bakaaula ku-Kue amali. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.16",
