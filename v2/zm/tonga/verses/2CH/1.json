        },
        {
          "text": "Nkabela Solomoni ambungano yoonse yabantu bakainka kucipaililo cakuGibeoni, nkaambo nkonkuko nkulyakabede itente lyakubunganina lya-Leza ndyaakacita Musa mulanda wa-Jehova naakali munkanda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.3",
            "verseOrgIds": [
              "2CH.1.3"
            ]
          }
        },
