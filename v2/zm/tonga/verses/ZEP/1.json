          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amuumune kubusyu bwa-Mwami Jehova, nkaambo buzuba bwaJehova buli kufwaafwi. Jehova ulibambide cipaizyo cakwe akusalazya batambe bakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.7",
            "verseOrgIds": [
              "ZEP.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEP 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela mubuzuba bwacipaizyo ca-Jehova njoouma bapati abana bamwami aboonse basamide zyakusama zyeenzu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.8",
            "verseOrgIds": [
              "ZEP.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEP 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi mubuzuba obo njoouma boonse basotokela kumanjililo akuzuzya maanda aabasimalelo babo lunya abubeji.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.9",
            "verseOrgIds": [
              "ZEP.1.9"
            ]
          }
        }
      ]
    },
