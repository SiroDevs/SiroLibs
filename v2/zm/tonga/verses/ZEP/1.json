                  "text": "2 Pet 1:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": "2 Bam 22:1–23:30; 2 Mak 34:1–35:27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaaya majwi aa-Jehova aakasikila Zefaniya mwana wa-Kusi, mwana wa-Gedaliya, mwana wa-Amariya, mwana wa-Hezekiya, mumazuba aa-Josiya mwana wa-Amoni mwami wa-Juda.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.1",
            "verseOrgIds": [
              "ZEP.1.1"
            ]
          }
        }
