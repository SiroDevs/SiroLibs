            "sid": "ZEP 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzoomaninizya zintu zyoonse zyaansi, mbwaamba Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.2",
            "verseOrgIds": [
              "ZEP.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEP 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzoomaninizya bantu abanyama, nzoomaninizya bayuni bakujulu answi zyamulwizi, azilebyo zyabasizibi, nkabela nzoonyonyoona bantu boonse bakede anyika, mbwaamba Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.3",
            "verseOrgIds": [
              "ZEP.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEP 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.10.5"
              },
              "items": [
                {
                  "text": "Hos 10:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi nzootandabika maanza aangu cakupenzya Juda abantu boonse bakede mu-Jerusalemu, elyo nzoonyonyoona mubusena obuno boonse ba-Baala basyeede azina lyaba-Kemari abapaizi, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.4",
            "verseOrgIds": [
              "ZEP.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEP 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.11.33"
              },
              "items": [
                {
                  "text": "1 Bam 11:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "abaabo bakomba makamu makamu aakujulu atala amaanda, abaabo bakomba cakukonkezya Jehova akukonkezya mwami wabo, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.5",
            "verseOrgIds": [
              "ZEP.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEP 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "abaabo baleka kutobela Jehova, abaabo batana kuyandaula Jehova nanka kumulangaula.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.6",
            "verseOrgIds": [
              "ZEP.1.6"
            ]
          }
        }
      ]
