                }
              ]
            }
          ]
        },
        {
          "text": "Amuwuule nyoonse nomukede mu-Maketesi, nkaambo bantu boonse basambazi banyonyooka, boonse balemedwe mali balikoswedwe.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.11",
