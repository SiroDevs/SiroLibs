                "loc": "1CO.9.24"
              },
              "items": [
                {
                  "text": "1 Kor 9:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eno buya swebo mbotuzingulikidwe makamu makamu aya aabakamboni­, atuzisowe zyoonse zitucelezya azibi zyoonse zitulamatila, tugame kusiana nkotwabikilwa kunembo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.1",
            "verseOrgIds": [
              "HEB.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.2.10"
              },
              "items": [
                {
                  "text": "Heb 2:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.110.1"
              },
              "items": [
                {
                  "text": "Int 110:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Katuduneme kuli-Jesu musolozi uulomya lusyomo lwesu, ikuti walo, nkaambo kalukondo ndwaakabikilwa kunembo, wakazyandamana kuciingano, wakaubaula buusu, eno sunu ulikede kululyo lwacuuno ca-Leza. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.2",
            "verseOrgIds": [
              "HEB.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.2.34"
              },
              "items": [
                {
                  "text": "Lk 2:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kamwiilizya nguwe uwakazyandamana mukukazyanya kuli bobuya kwabantu abamubisizya, kuti mutabombibombi nokuba kulengaala mumyoyo yanu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.3",
            "verseOrgIds": [
              "HEB.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anu tamuna kulwana kukutikaisya bulowa, mucigamine kulwana azibi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.4",
            "verseOrgIds": [
              "HEB.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.5.17"
              },
              "items": [
                {
                  "text": "Job 5:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.3.11+PRO.3.12"
              },
              "items": [
                {
                  "text": "Tus 3:11-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eno sena mwaluba aya majwi aakugwasya myoyo ngomwaambilwa mbuli bana bakulizyalila? Aati,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.5",
            "verseOrgIds": [
              "HEB.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.6",
            "verseOrgIds": [
              "HEB.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno nkaambo kakwiisya myoyo ncomukomenwa boobo. Leza ulamucita mbuli bana bakwe, nkaambo ino mwananzi walo oyo uutakwe nakomwa kuliwisi? ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.7",
            "verseOrgIds": [
              "HEB.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.73.14"
              },
              "items": [
                {
                  "text": "Int 73:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.73.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kukomwa nkokwabantu boonse, Kuti nomwatali kukomwa, nomwatali bana bakulizyalila, pe, nomuli bana bamusokwe. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.8",
            "verseOrgIds": [
              "HEB.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.16.22"
              },
              "items": [
                {
                  "text": "My 16:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkobeni twakali kubalemeka bamatata abakatuzyala nobatukoma. Ino kai obo, sena tatukooyooinda kubombela yooyo uuzyala myuuya, kuti tupone? ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.9",
            "verseOrgIds": [
              "HEB.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo abo bakali kutukoma kukuyanda kwabo kwamazuba mace buyo, anu walo utukomena kuti tululame, tukaabilwe busalali bwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.10",
            "verseOrgIds": [
              "HEB.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.4.17"
              },
              "items": [
                {
                  "text": "2 Kor 4:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.4.18"
              },
              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.3.17"
              },
              "items": [
                {
                  "text": "Jak 3:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eno kuciindi ncocuumwa-umwa tacitangazyi pe, cilausya, pele munsi, kukomwa oko kulatujanya micelo yakulikalila kabotu akululama.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.11",
            "verseOrgIds": [
              "HEB.12.11"
            ]
          }
        }
      ]
    },
