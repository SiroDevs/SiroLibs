                "loc": "ISA.35.3"
              },
              "items": [
                {
                  "text": "Is 35:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kaako amwaayumye maboko aanu amazwi aanu aali abukonkomwa, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.12",
            "verseOrgIds": [
              "HEB.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.4.26"
              },
              "items": [
                {
                  "text": "Tus 4:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "alimwi maulu aanu amwaepele inzila ziluzi, kuti boonse abasunkuta bataleyi munzila, pele bapone. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.13",
            "verseOrgIds": [
              "HEB.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
