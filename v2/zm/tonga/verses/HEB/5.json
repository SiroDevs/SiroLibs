            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.9.7"
              },
              "items": [
                {
                  "text": "Lev 9:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.16.6"
              },
              "items": [
                {
                  "text": "16:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "aboobo nceelede kuti apaile cipaizyo cabantu ukuvwela acakwe mwini. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.3",
            "verseOrgIds": [
              "HEB.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
