          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno tulijisi makani manjimanji aakwaamba aanguwe, alimwi nciyumu kwaapandulula mbomuli akazilukwa, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.11",
            "verseOrgIds": [
              "HEB.5.11"
            ]
          }
        },
