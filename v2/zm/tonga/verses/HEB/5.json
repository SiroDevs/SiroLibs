        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.28.1"
              },
              "items": [
                {
                  "text": "Kul 28:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi, takukwe muntu uulipa mwini mulimo oyu mulemu, pele oyo uwaitwa Leza kulinguwo mbubonya mbwaakaitwa Arone, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.4",
            "verseOrgIds": [
              "HEB.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
