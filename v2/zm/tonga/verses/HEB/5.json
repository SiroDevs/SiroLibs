              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo woonse mupaizi mupati uusalwa kubantu, usalilwa kubelekela bantu mumakani aayeeme kuli-Leza, kuti ape zituuzyo azipaizyo nkaambo kazibi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.1",
            "verseOrgIds": [
              "HEB.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.4.15"
              },
              "items": [
                {
                  "text": "Heb 4:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi kakonzya kweetelela bantu abaleede nkaambo kakutaziba kwabo, nkaambo awalo mwini ulizwide kulengauka, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.2",
            "verseOrgIds": [
              "HEB.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
