              },
              "items": [
                {
                  "text": "Lk 22:39-46",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Walo Jesu kuciindi cabuumi bwakwe ansi ano, mukulila kupati akubiiza, wakaalaala akukumbila kulooyo uukonzya kumufutula kulufu, nkabela wakamvwigwa nkaambo wakali kuyoowa Leza. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.7",
            "verseOrgIds": [
              "HEB.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.2.8"
              },
              "items": [
                {
                  "text": "Flp 2:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Walo nekuba kuti wali Mwana a-Leza, pele wakaiya kumvwa mumapenzi aakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.8",
            "verseOrgIds": [
              "HEB.5.8"
            ]
          }
