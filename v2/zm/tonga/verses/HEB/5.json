              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.13.33"
              },
              "items": [
                {
                  "text": "Inc 13:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbubonya obo, awalo Kristo takalipede bulemu ubwakuba Mupaizi Mupati pe, pele wakasalwa kulinguwo ayooyo uwakamwaambila kuti,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.5",
            "verseOrgIds": [
              "HEB.5.5"
            ]
          }
        }
      ]
