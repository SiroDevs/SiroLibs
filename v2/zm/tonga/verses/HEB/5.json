              "items": [
                {
                  "text": "Matl 2:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anu zilyo ziyumu nzyabantu bakakomena, nkokuti nzyabaabo abali amiyeeyo iyakaiisigwa kusala cibotu ecibi.",
          "type": "text",
          "attrs": {
