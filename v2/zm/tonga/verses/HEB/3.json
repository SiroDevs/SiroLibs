                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kakuti twaba beenzinyina Kristo, kuti kusyoma kwesu nkotwakali kujisi kumatalikilo katujatisya mane do kumagolelo, ",
          "type": "text",
          "attrs": {
