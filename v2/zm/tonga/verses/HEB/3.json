              "items": [
                {
                  "text": "Kol 1:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "anu walo Kristo ulisyomekede mbuli Mwana muzyale muŋanda ya-Leza. Ndiswe ŋanda eyo ya-Leza kuti twajatisya, akuya kumamanino, kulitakata kwesu akulindila kwesu nkotulumbaizya.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.6",
            "verseOrgIds": [
              "HEB.3.6"
