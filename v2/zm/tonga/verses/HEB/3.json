              "type": "text"
            }
          ]
        },
        {
          "text": "Musa ncobeni wakalisyomekede muŋanda yoonse ya-Leza, mbubonya mbuli mulanda, kukulungululwa kwamakani aakayubululwa munsi, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.5",
            "verseOrgIds": [
