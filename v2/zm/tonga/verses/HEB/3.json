              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kaako, nobakwesu basalala, nomusalilwa bukalilo kujulu, kamuyeeya Jesu Apostolo a-Mupaizi Mupati waluzumino lwesu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.1",
            "verseOrgIds": [
              "HEB.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.12.7"
              },
              "items": [
                {
                  "text": "My 12:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Walo wakali kusyomekede kulooyo uwakamusala, mbubonya awalo Musa mbwaakali kusyomekede muŋanda ya-Leza yoonse. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.2",
            "verseOrgIds": [
              "HEB.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walo Jesu uleelede bulemu kwiinda Musa, mbubonya mbwajana bulemu muntu uwakayaka ŋanda kwiinda ŋanda njaakayaka, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.3",
            "verseOrgIds": [
              "HEB.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anu maanda oonse alijisi bakaayaka, pele Leza walo ngowakayaka zintu zyoonse.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.4",
            "verseOrgIds": [
              "HEB.3.4"
            ]
          }
        }
      ]
    },
