                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.12.24"
              },
              "items": [
                {
                  "text": "12:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aboobo Mulongo ngwatutangila Jesu nguuinda kubota. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.22",
            "verseOrgIds": [
              "HEB.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HEB 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi abo bakaba bapaizi banjibanji kukubalwa, nkaambo kakuti lufu lwakali kubakasya kuti kabacicita mulimo wabo, ",
          "type": "text",
          "attrs": {
