          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno Mulao wakusaanguna waloba nkaambo kakulengauka kwawo abuliwo bwawo, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.18",
            "verseOrgIds": [
              "HEB.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.9"
              },
              "items": [
                {
                  "text": "Heb 9:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "(nkaambo Mulao tuukwe cintu ncowakalondola), alimwi twalerelwa bumwi bulangizi bubotu ubutuswenya afwaafwi kuli-Leza. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.19",
            "verseOrgIds": [
              "HEB.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HEB 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno eci cakacitilwa akukonka, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.20",
            "verseOrgIds": [
              "HEB.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HEB 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.110.4"
              },
              "items": [
                {
                  "text": "Int 110:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "(Nkaambo bapaizi abo abakasaanguna tabakwe nobakakonkwa, bakacitwa buyo bapaizi, pele walo wakacitwa Mupaizi akukonka ukuzwa kulooyo uwakamwaambila kuti,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.21",
            "verseOrgIds": [
              "HEB.7.21"
            ]
          }
        }
      ]
    },
