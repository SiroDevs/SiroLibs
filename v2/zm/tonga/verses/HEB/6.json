            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.22.16"
              },
              "items": [
                {
                  "text": "Matl 22:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
