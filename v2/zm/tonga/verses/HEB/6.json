                "loc": "GEN.22.17"
              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo Leza naakasyomezya Abrahamu, mbokwatakali umbi mupati uuinda ngwaakakonzya kukonka, wakalikonka mwini, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.13",
            "verseOrgIds": [
              "HEB.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.22.16+GEN.22.17"
              },
              "items": [
                {
                  "text": "Matl 22:16-17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "wakuti, Ncobeni kulongezya ndilakulongezya, akuvuzya ndilakuvuzya. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.14",
            "verseOrgIds": [
              "HEB.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno Abrahamu wakaciiana ncaakasyomezegwa nkaambo kakubosya moyo mukulindila kwakwe, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.15",
            "verseOrgIds": [
              "HEB.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.22.10"
              },
              "items": [
                {
                  "text": "Kul 22:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo bantu balakonka mupati wabo uubainda, nkabela lyoonse nobazumanikana makani ukukonka oko nkokukosola makani. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.16",
            "verseOrgIds": [
              "HEB.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kaako, Leza mbwaakakanza kutondezya cakusinizya kulibaabo basikujana cisyomezyo, kuti ncaakasyomezya kale tacisanduki, wakali kusinizizye kukukonka, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.17",
            "verseOrgIds": [
              "HEB.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.23.19"
              },
              "items": [
                {
                  "text": "My 23:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.15.29"
              },
              "items": [
                {
                  "text": "1 Sam 15:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kuti kumakani aya obile aatasanduki ngatakonzya kubeja Leza, tukabe aluumbulizyo luyumu, swebo notutijila kuti tujatisye bulangizi bubikidwe kumeso esu, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.18",
            "verseOrgIds": [
              "HEB.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.16.2"
              },
              "items": [
                {
                  "text": "Lev 16:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.16.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Obu bulangizi tulibujisi ukubaanga musemu wamuuya, umuyumu ma, uutazungaani, uuinda mukati kacisitilizyo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.19",
            "verseOrgIds": [
              "HEB.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
