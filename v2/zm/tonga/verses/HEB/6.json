        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.14"
              },
              "items": [
                {
                  "text": "Heb 9:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aboobo atuleke kwaamba makani aakusaanguna aa-Kristo, atuye kumbele kumakani aabupati, tutabiki limbi antalisyo, nkokuti makani aakweempa kumilimo iyakafwa kale, amakani aakusyoma Leza, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.1",
            "verseOrgIds": [
              "HEB.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "naaba aakwiisya aakubapatizigwa aakubikwa maanza, naaba aakubuka kubafu, na aakubetekwa kutamani, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.2",
            "verseOrgIds": [
              "HEB.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inga tulacicita eci, na Leza wazumina. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.3",
            "verseOrgIds": [
              "HEB.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.26"
              },
              "items": [
                {
                  "text": "Heb 10:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.27"
              },
              "items": [
                {
                  "text": "27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.31"
              },
              "items": [
                {
                  "text": "Mt 12:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.5.16"
              },
              "items": [
                {
                  "text": "1 Joh 5:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele nkuyumu kulibaabo abakamunikilwa kale, abakalabila cipego cakujulu, abakali kusanganyizidwe kale ku-Muuya Uusalala, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.4",
            "verseOrgIds": [
              "HEB.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.3"
              },
              "items": [
                {
                  "text": "1 Pet 2:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "abakalabila kale kubota kwejwi lya-Leza, enguzu zyaciindi ciciza, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.5",
            "verseOrgIds": [
              "HEB.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "elyo kuti baleya, nkuyumu kubajokolweda kukweempa, nkaambo alimwi bacibambula Mwana a-Leza aciingano, akumuubaula, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.6",
            "verseOrgIds": [
              "HEB.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.1.11"
              },
              "items": [
                {
                  "text": "Matl 1:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.1.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo insi eyo iinywa maanzi aawida mpawo, yazyala micelo kuti bakondwe abo abaliminwa, insi eyo yajana coolwe kuli-Leza. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.7",
            "verseOrgIds": [
              "HEB.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.3.17+GEN.3.18"
              },
              "items": [
                {
                  "text": "Matl 3:17-18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele kuti insi eyo kiizyala maamvwa aciyasabavwimi, ilatakatwa, ili kufwaafwi kusinganizigwa, elyo kukumana ilatentwa buyo mulilo.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.8",
            "verseOrgIds": [
              "HEB.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
