              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino kumakani aamalaililo aasikukonenwa, kuleelede kuba lufu lwasikulailila, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.16",
            "verseOrgIds": [
              "HEB.9.16"
            ]
