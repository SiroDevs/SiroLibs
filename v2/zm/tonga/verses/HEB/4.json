              "items": [
                {
                  "text": "Heb 2:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo oyo wesu tali Mupaizi Mupati uutakonzya kutweetelela mukulengauka kwesu, pele ngonguwe oyo uwakasunkwa mbubonya mbuli ndiswe, nekuboobo taakwe naakacita cibi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.15",
            "verseOrgIds": [
              "HEB.4.15"
            ]
          }
        },
