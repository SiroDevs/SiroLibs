              "type": "text"
            }
          ]
        },
        {
          "text": "Mbubonya obo aswebo atuyoowe, notucili acisyomezyo eci cakunjila mukulyokezya kwakwe, mbokunga umwi wanu ulakakilwa kukujana. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.1",
            "verseOrgIds": [
              "HEB.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo ncobeni swebo twakaambilwa Makani Mabotu mbubonya mbuli mbabo, anu abalo ijwi ndyobakamvwa lyakakakilwa kubajanya cintu, nkaambo tabakaswaanganide mukusyoma kwabo abaabo abakamvwisya. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.2",
            "verseOrgIds": [
              "HEB.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.95.11"
              },
              "items": [
                {
                  "text": "Int 95:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele swebo notwazumina tuyootambulwa mukulyokezya oku, mbubonya mbwaakaamba kuti,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.3",
            "verseOrgIds": [
              "HEB.4.3"
            ]
          }
        }
      ]
    },
