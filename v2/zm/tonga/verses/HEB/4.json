                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kakuti Joshua naakabapa kulyokezya, Leza naatakaamba abuzuba bumbi, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.8",
            "verseOrgIds": [
              "HEB.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkokuti kucizida bantu ba-Leza kulyokezya kwa-Sabata. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.9",
            "verseOrgIds": [
              "HEB.4.9"
            ]
          }
        },
