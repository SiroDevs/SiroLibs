              "attrs": {
                "loc": "REV.14.13"
              },
              "items": [
                {
                  "text": "Ciy 14:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo woonse uutambulwa mukulyokezya kwakwe, walyokezya kumilimo yakwe, mbubonya mbwaakalyokezya Leza kumilimo yakwe.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.10",
            "verseOrgIds": [
              "HEB.4.10"
