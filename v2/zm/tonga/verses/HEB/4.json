                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eno buya mbotujisi Mupaizi Mupati, nkokuti Jesu Mwana a-Leza uwakainda kujulu kwini, atujatisye luzumino lwesu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.14",
            "verseOrgIds": [
              "HEB.4.14"
            ]
          }
        },
        {
