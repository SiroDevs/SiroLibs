              "MRK.7.31"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.15.29+MAT.15.30+MAT.15.31"
              },
              "items": [
                {
                  "text": "Mt 15:29-31",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azwe buyo kumunyinza wacisi caku-Turo, wakainda kucisi ca-Sidoni, elyo waandulula mucisi caku-Dekapole, akuya kulwizi lwaku-Galilaya. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.31",
            "verseOrgIds": [
              "MRK.7.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.5.23"
              },
              "items": [
                {
                  "text": "Mk 5:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela bamuletela umwi musinkematwi sikubebesya, bamukumbila kuti amubike ijanza. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.32",
            "verseOrgIds": [
              "MRK.7.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.8.23"
              },
              "items": [
                {
                  "text": "Mk 8:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino wakamugwisya mumakamu aabantu, wamutola kumbali, elyo wakamutunga minwe yakwe mumatwi, alimwi wakaswida mate akumulamba ngao amulaka wakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.33",
            "verseOrgIds": [
              "MRK.7.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.41"
              },
              "items": [
                {
                  "text": "Mk 6:41",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.11.41"
              },
              "items": [
                {
                  "text": "Joh 11:41",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpoonya wakaululala kujulu, wali-sinsimukila, wamwaambila kuti, Effatha, nkukuti, Sinkuka. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.34",
            "verseOrgIds": [
              "MRK.7.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpoonya mpoonya akasinkuka matwi aakwe, aceeco cakaangide mulaka wakwe caka-pasuka, watalika kwaamba kabotu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.35",
            "verseOrgIds": [
              "MRK.7.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.1.43+MRK.1.44+MRK.1.45"
              },
              "items": [
                {
                  "text": "Mk 1:43-45",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino wakabalailila kuti bataambili muntu, anu naakabalailila obo bakainda kuduumya impuwo kumakani ayo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.36",
            "verseOrgIds": [
              "MRK.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.35.5"
              },
              "items": [
                {
                  "text": "Is 35:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela bakainda kukankamana loko, bakati, Wabosya kucita zyoonse. Basinkematwi ulabasinkula, abalo basyataambi ulabaambya.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.37",
            "verseOrgIds": [
              "MRK.7.37"
            ]
          }
        }
      ]
