                "loc": "MAT.15.1+MAT.15.2+MAT.15.3+MAT.15.4+MAT.15.5+MAT.15.6+MAT.15.7+MAT.15.8+MAT.15.9+MAT.15.10+MAT.15.11+MAT.15.12+MAT.15.13+MAT.15.14+MAT.15.15+MAT.15.16+MAT.15.17+MAT.15.18+MAT.15.19+MAT.15.20"
              },
              "items": [
                {
                  "text": "Mt 15:1-20",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino kwakamubunganina ba-Farisi abamwi balembi bazwa ku-Jerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.1",
            "verseOrgIds": [
              "MRK.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.11.38"
              },
              "items": [
                {
                  "text": "Lk 11:38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela bakabona kuti bamwi basikwiiya bakwe bakali kulya insima amaanza aatondwa, nkukuti aatacovwekede. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.2",
            "verseOrgIds": [
              "MRK.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo ba-Farisi aba-Juda boonse, kuti tabacovweki lubbe maanza aabo, tabalyi, ikuti balajatisya tunsiyansiya twabasikale. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.3",
            "verseOrgIds": [
              "MRK.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi kufumbwa nibazwa kucisambalilo, tabalyi mane anzina balisansaile, alimwi nkuzili ziyanza zinji nzibajisi akuzibamba, mbuli kunika inkomeki azilongo azibiya zyamukuba. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.4",
            "verseOrgIds": [
              "MRK.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino ba-Farisi abalembi bakamubuzya kuti, Nkaambonzi basikwiiya bako ncobatayoboli tunsiyansiya twabasikale, anukuti balalya insima amaanza aatondwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.5",
            "verseOrgIds": [
              "MRK.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.29.13"
              },
              "items": [
                {
                  "text": "Is 29:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wabaambila kuti, Ncobeni Isaya wakasinsima anywebo nubasikuupaupa ameso, mbubonya mbukulembedwe kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.6",
            "verseOrgIds": [
              "MRK.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
