              "attrs": {
                "loc": "1SA.21.1+1SA.21.2+1SA.21.3+1SA.21.4+1SA.21.5+1SA.21.6"
              },
              "items": [
                {
                  "text": "1 Sam 21:1-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wabaambila wati, Sa tamuna kubala, mbwaakacita Davida naakapenga akufwa inzala, walo abaabo mbaakali abo? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.25",
            "verseOrgIds": [
              "MRK.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
