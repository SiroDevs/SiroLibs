                  "text": "Dt 5:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino wakabaambila kuti, Sabata wakaanzilwa muntu, muntu taanzilwi Sabata pe. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.27",
            "verseOrgIds": [
