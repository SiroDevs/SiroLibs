              "type": "text"
            }
          ]
        },
        {
          "text": "Mubuzuba bumwi bwa-Sabata wakaandulula akati kamyuunda, elyo basikwiiya bakwe bakatalika kuya bupulaula maila kumakunka. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.23",
            "verseOrgIds": [
              "MRK.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino ba-Farisi bakamwaambila kuti, Langa, nkaambonzi balacita citondwa mubuzuba bwa-Sabata? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.24",
            "verseOrgIds": [
              "MRK.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 2:25"
          },
          "items": [
