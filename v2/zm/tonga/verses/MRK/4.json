                "loc": "LUK.6.38"
              },
              "items": [
                {
                  "text": "Lk 6:38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi wakabaambila kuti, Amucenjele nzyomumvwa. Ceelesyo ncimweelesya anywebo muyooelesegwa nciconya, alimwi muyootambula kwiindilila. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.24",
            "verseOrgIds": [
