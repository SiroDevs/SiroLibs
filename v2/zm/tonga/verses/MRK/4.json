              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli mbuli inseke yamusitada yasyangwa ansi niniini kwiinda inseke zyoonse zyaansi, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.31",
