              "items": [
                {
                  "text": "Jak 5:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Walo uloona akubuka lyoonse masiku asikati nkabela imbuto zilamena akukomena, pele walo tazi naazikomena buti. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.27",
            "verseOrgIds": [
              "MRK.4.27"
            ]
          }
        },
        {
