              "type": "tag",
              "attrs": {
                "loc": "JOL.3.13"
              },
              "items": [
                {
                  "text": "Joel 3:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino maila naabizwa, mpoonya mpoonya ulatuma cigonsyo, nkaambo casika ciindi cakutebula.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.29",
            "verseOrgIds": [
