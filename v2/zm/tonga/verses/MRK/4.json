                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo oyo uujisi uyoopegwa, pele oyo uutajisi uyoonyanzigwa niciba ncajisi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.25",
