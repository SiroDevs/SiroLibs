          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzikozyano zinji zili boobo nzyaakali kubaambizya makani, mbuli mbubakakonzya kumvwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.33",
            "verseOrgIds": [
              "MRK.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Takakali kubaambila buyo cita muzikozyano, pele kulibasikwiiya bakwe mwini wakali kubapandulwida makani oonse kumbali.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.34",
            "verseOrgIds": [
              "MRK.4.34"
            ]
          }
        }
      ]
