          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Insi ilazyala micelo ini, kutaanguna busonga, nkokuya makunka, nkokuya maila aatuba mumakunka­. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.28",
            "verseOrgIds": [
              "MRK.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 4:29"
          },
          "items": [
