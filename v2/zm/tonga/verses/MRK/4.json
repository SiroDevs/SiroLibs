              "items": [
                {
                  "text": "Lk 12:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo taakwe cintu cisisidwe citakooyooyubununwa, alimwi taakwe cintu civumbidwe icitakooyoovumbululwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.22",
            "verseOrgIds": [
              "MRK.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anooli kuli muntu uujisi matwi aakumvwa, amvwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.23",
            "verseOrgIds": [
              "MRK.4.23"
            ]
          }
        },
