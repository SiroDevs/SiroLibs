              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino wakati, Bwami bwa-Leza buli mbuli muntu uuminza imbuto ansi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.26",
            "verseOrgIds": [
              "MRK.4.26"
            ]
