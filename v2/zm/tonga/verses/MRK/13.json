          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino amulibambe, ndamwaambila caali nezitana kuba.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.23",
