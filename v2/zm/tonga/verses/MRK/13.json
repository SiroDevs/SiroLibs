                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino mwaakubona cisesemyo cabusaale ciliimvwi mpociteelede kwiima (oyo uubala amvwisye), elyo abo bali mu-Judaya bakacijile muzilundu, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.14",
            "verseOrgIds": [
              "MRK.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
