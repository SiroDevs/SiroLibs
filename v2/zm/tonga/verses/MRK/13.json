                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo nobati kabone Mwana a-Muntu uleza mumakumbi anguzu abulemu bupati. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.26",
