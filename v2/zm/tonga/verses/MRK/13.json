                "loc": "DEU.13.1"
              },
              "items": [
                {
                  "text": "Dt 13:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kuyooba bakristo babeji abasinsimi babeji, bayoocita zitondezyo amalele, kwaakukonzeka mane do bakalengawide abaabo basalidwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.22",
            "verseOrgIds": [
              "MRK.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
