        },
        {
          "text": "Lino mwami Solomoni kali mwami wacisi coonse ca-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.1",
            "verseOrgIds": [
              "1KI.4.1"
            ]
          }
        },
