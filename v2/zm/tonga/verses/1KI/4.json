            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.3.4"
              },
              "items": [
                {
                  "text": "Dt 3:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Beni-geberi ku-Ramoti-Gileadi (nguwe iwakajisi minzi ya-Jairi mwana wa-Manase iili mu-Gileadi, alimwi kajisi cisi ca-Arigobi cili mu-Basani, minzi mipati iili makumi aali musanu alimwi iyakayakilidwe malambo aminkulu yalubulo), ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.13",
            "verseOrgIds": [
              "1KI.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahinadabu mwana wa-Ido ku-Mahanaimu, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.14",
            "verseOrgIds": [
              "1KI.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahimaazi ku-Nafitali (ngonguwe iwakakwata Basemati mwana wa-Solomoni), ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.15",
            "verseOrgIds": [
              "1KI.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baana mwana wa-Husai ku-Aseri akuAloti, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.16",
            "verseOrgIds": [
              "1KI.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "jehosafati mwana wa-Paruwa ku-Isakara, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.17",
            "verseOrgIds": [
              "1KI.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simeyi mwana waEla ku-Benjamini, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.18",
            "verseOrgIds": [
              "1KI.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 4:19"
          },
          "items": [
            {
              "text": "19",
