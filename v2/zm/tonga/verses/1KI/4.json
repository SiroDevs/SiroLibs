                "loc": "1KI.2.27"
              },
              "items": [
                {
                  "text": "2:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Benaya mwana wa-Jehoyada kali silutwe wampi, Zadoki a-Abiyatare kabali bapaizi, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.4",
            "verseOrgIds": [
              "1KI.4.4"
            ]
          }
        },
