              },
              "items": [
                {
                  "text": "1 Mak 27:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azariya mwana wa-Natani kali mupati wabanduna, Zaba di mwana wa-Natani mupaizi kali mweenzinyina mwami, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.5",
            "verseOrgIds": [
              "1KI.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.5.14"
              },
              "items": [
                {
                  "text": "1 Bam 5:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ahisara wakali similimo waŋanda yamwami, a-Adoniramu mwana wa-Abida kali mulangi wacibalo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.6",
