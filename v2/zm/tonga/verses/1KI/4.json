              "1KI.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi Solomoni kajisi bami bali ikumi ababili bazisi zyaba-Israyeli, mbombabo ibakali kubambila mwami abasiŋanda bakwe zilyo. Umwi aumwi kabamba zilyo zyamwezi umwi wamwaka. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.7",
            "verseOrgIds": [
              "1KI.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaaya mazina aabo: Benhuri mucisi catulundulundu twa-Efraimu, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.8",
            "verseOrgIds": [
              "1KI.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bendekeri ku-Makazi akuSaalibimu aku-Betisemesi aku-Elonibetanani, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.9",
            "verseOrgIds": [
              "1KI.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benhesedi ku-Aruboti aku-Soko anyika yoonse ya-Heferi, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.10",
            "verseOrgIds": [
              "1KI.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benabinadabu kucisi coonse caNafati-dori (ngonguwe iwakakwata Tafati mwana wa-Solomoni), ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.11",
            "verseOrgIds": [
              "1KI.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baana mwana wa-Ahiludi ku-Tanaki aku-Megido aku-Betseani koonse kubambene aku-Zaretani kumunkuni wa-Jezreeli kuzwa ku-Betseani kusikila ku-Abelimehola mane kwiinda ku-Jokimeamu, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.12",
            "verseOrgIds": [
              "1KI.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
