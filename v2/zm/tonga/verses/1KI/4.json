              "items": [
                {
                  "text": "Dt 3:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Geberi mwana wa-Uri mucisi ca-Gileadi, nyika ya-Sihoni mwami waba-Amori a-Ogi mwami wa-Basana. Nkabela kakuli umwi silutwe mucisi ca-Juda,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.19",
            "verseOrgIds": [
