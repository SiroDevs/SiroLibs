          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aangelo wabili alakwe kajisi bulamfu bwatukokola tuli ikumi. Bakerebimu boonse bobile bakeelene mubulamfu bwabo amuziimo zyabo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.25",
            "verseOrgIds": [
              "1KI.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
