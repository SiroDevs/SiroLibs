          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibbaba limwi lyakeribu lyakali tukokola tosanwe mubulamfu, abbaba limwi lyakali tukokola tosanwe mubulamfu, nkukuti bulamfu boonse kuzwa kumagolelo aabbaba limwi kusikila kumagolelo aabbaba alimwi bwakali tukokola tuli ikumi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.24",
            "verseOrgIds": [
              "1KI.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
