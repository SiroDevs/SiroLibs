          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwiime bwakerebimu umwi bwakali tukokola tuli ikumi, abwiime bwakerebimunyina abwalo bwakali tukokola tuli ikumi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.26",
            "verseOrgIds": [
