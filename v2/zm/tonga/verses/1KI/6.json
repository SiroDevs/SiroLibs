              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Intalisyo yaŋanda ya-Jehova yakabikwa mumwaka wane, mumwezi wa-Zivi, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.37",
            "verseOrgIds": [
