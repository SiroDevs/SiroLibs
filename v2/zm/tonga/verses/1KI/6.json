          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zyoonse wakazibezela zikozyano zyabakerebimu azyamikunka azyamalubaluba aasyuuka, alimwi wakaziziluluzya ingolida iyakayalidwe cakweelana oonse abubeze. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.35",
            "verseOrgIds": [
              "1KI.6.35"
            ]
          }
        },
        {
