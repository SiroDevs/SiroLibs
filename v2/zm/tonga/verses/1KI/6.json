              "type": "text"
            }
          ]
        },
        {
          "text": "Aboobo Solomoni wakayaka iŋanda lumwi waimana. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.14",
            "verseOrgIds": [
              "1KI.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela malambo aaŋanda aamukati wakaayasya zisamu zyakedari. Kuzwa ansi akusikila kumaseketi aalululi, moonse mukati wakamuvumbya zisamu, alimwi ansi wakaavumbya zisamu zyamulombe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.15",
            "verseOrgIds": [
              "1KI.6.15"
            ]
          }
        },
