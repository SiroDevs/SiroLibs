        },
        {
          "text": "Kumulyango wacikombelo cisalalisya camukati wakapanga makoma aazisamu zyaolifa. Zikunguzyo zyoonse zyakoma zyakali mumabazu osanwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.31",
            "verseOrgIds": [
