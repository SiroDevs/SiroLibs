          ]
        },
        {
          "text": "Acikombelo cisalalisya wakacibamba mukati kaŋanda, kuti abike mulincico ibbokesi lyacizuminano ca-Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.19",
            "verseOrgIds": [
              "1KI.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela cikombelo camukati cakalijisi bulamfu bwatukokola tuli makumi obile abwaamba bwatukokela tuli makumi obile abwiime bwatukokola tuli makumi obile, alimwi wakaciziluluzya ingolida loko, akucita cipaililo cazisamu zyakedari. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.20",
            "verseOrgIds": [
              "1KI.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amoonse mukati kaŋanda Solomoni wakamuziluluzya ingolida loko, alimwi wakabika inkeetani zyangolida kunembo lyacikombelo cisalalisya, acikombelo eco acalo wakaciziluluzya ingolida. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.21",
            "verseOrgIds": [
              "1KI.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
