                  "text": "Ezk 41:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "amakoma obile aazisamu zyamulombe. Zipanzi zyobile zyakoma limwi zyakali kuswanaana, azipanzi zyobile zyakoma limwi zyakali kuswanaana. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.34",
