              "items": [
                {
                  "text": "Kul 30:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Iŋanda yoonse wakaiziluluzya ingolida lumwi wakamana iŋanda yoonse, acalo cipaililo camucikombelo camukati wakaciziluluzya ingolida.",
          "type": "text",
          "attrs": {
