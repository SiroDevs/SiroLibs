          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alubaya lwamukati wakaluyasya mindando yotatwe yamabwe aabezedwe amundando omwe wazisamu zyakedari.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.36",
