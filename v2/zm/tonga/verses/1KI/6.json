      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mumwaka wamyanda yone amakumi aali musanu aatatu, bana ba-Israyeli nibakamana kulonga kuzwa ku-Egepita, mumwaka wane wabwami bwa-Solomoni bwaku-Israyeli, mumwezi wa-Zivi (nkukuti mwezi wabili), wakatalika kuyaka iŋanda ya-Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.1",
            "verseOrgIds": [
              "1KI.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.41.1"
              },
              "items": [
                {
                  "text": "Ezk 41:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela iŋanda mwami Solomoni njaakayakila Jehova, bulamfu bwayo kabuli tukokola tuli makumi aali musanu alimwi, abwaamba bwayo kabuli tukokola tuli makumi obile, abwiime bwayo kabuli tukokola tuli makumi otatwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.2",
            "verseOrgIds": [
              "1KI.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alukonkono lwakunembo lyantempele impati, bulamfu bwalo kabuli tukokola tuli makumi obile mbubonya mbuli bwaamba bwaŋanda, abwaamba bwalo kabuli tukokola tuli ikumi kunembo lyaŋanda. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.3",
            "verseOrgIds": [
              "1KI.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.40.16"
              },
              "items": [
                {
                  "text": "Ezk 40:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi wakacitila iŋanda zipulo zili azikunguzyo zijisi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.4",
            "verseOrgIds": [
              "1KI.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela wakayaka lubaya kumbali lyamalambo aaŋanda, lwakuzyungulusya malambo aaŋanda, intempele acikombelo camukati coonse, alimwi wakayaka twaanda kumabazu oonse. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.5",
            "verseOrgIds": [
              "1KI.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twaanda twaansi twakalijisi bwaamba bwatukokola tosanwe, twaanda twaakati twakalijisi bwaamba bwatukokola tuli musanu akamwi, atwaanda twaanze twakalijisi bwaamba bwatukokola tuli musanu atubili, nkaambo anze lyabulambo wakayaka minsende kuti maseketi atagumi mubulambo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.6",
            "verseOrgIds": [
              "1KI.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
