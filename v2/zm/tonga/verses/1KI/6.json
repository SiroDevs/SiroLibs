        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.6",
            "verseOrgIds": [
              "1KI.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lion iŋanda niyakali mukuyakwa, yakayasigwa mabwe aakabambidwe kale nkukonya nkwaasigwa, aboobo katakwe insando nikaba kaleba niciba cibelesyo cimwi calubulo icakamvwigwa muŋanda mukuyakwa kwayo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.7",
            "verseOrgIds": [
              "1KI.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
