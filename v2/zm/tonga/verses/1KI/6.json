          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.7",
            "verseOrgIds": [
              "1KI.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela mulyango watwaanda twaansi wakali kubbazu lyalulyo lwananda, alimwi kakuli matantilo aaya kutwaanda twaakati, akuzwa oko kuya kutwaanda twakujulu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.8",
            "verseOrgIds": [
              "1KI.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aboobo wakayaka iŋanda akwiimanisya, alululi lwayo wakaluyasya maseketi amapulanga aakedari. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.9",
            "verseOrgIds": [
              "1KI.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alwalo lubaya lwakuzyunguluka iŋanda yoonse wakaluyaka, lwakalijisi bulamfu bwatukokola tosanwe, alimwi lwakaswaanizigwa aŋanda aziyako zyakedari.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.10",
            "verseOrgIds": [
              "1KI.6.10"
            ]
          }
        }
      ]
    },
    {
