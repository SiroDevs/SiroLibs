          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo ijwi lya-Jehova lyakasikila Solomoni, lyakati, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.11",
            "verseOrgIds": [
              "1KI.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Swiilila makani aaŋanda eyi njoli mukuyaka. Na uende munzila zyangu akubamba imbeta zyangu akulemeka milazyo yangu akweenda mulinjiyo, lino njookuzuzikizya cisyomezyo cangu ncindakasyomezya Davida uso. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.12",
            "verseOrgIds": [
              "1KI.6.12"
            ]
          }
        },
