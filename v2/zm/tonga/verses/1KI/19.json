        },
        {
          "text": "Lino wakalala, woona mpawo ansi lyakasamu. Nkabela kwakasika angelo, wakamwaampa, wamwaambila kuti, Buka, ulye. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.5",
            "verseOrgIds": [
