          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela angelo wa-Jehova wakaboola alwabili, wamwaampa, wati, Buka, ulye, nkaambo lweendo lwakukacila. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.7",
            "verseOrgIds": [
