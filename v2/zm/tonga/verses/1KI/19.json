              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo naakalanga, wakabona kuti kufwaafwi kumutwe wakwe kakuli cibunge acinkuli camaanzi, Mpawo wakalya, wanywa, walala, woona. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.6",
            "verseOrgIds": [
              "1KI.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
