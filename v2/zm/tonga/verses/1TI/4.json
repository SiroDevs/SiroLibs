            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.8.17"
              },
              "items": [
                {
                  "text": "8:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Utaleki kubelesya eco caabilo caluzyalo cikukalide mukati, ncowakapegwa kumajwi aabasinsimi, nowakabikwa maanza kubaalu bambungano. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.14",
            "verseOrgIds": [
              "1TI.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TI 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sungwaala kuzintu ezi, ulitakate kulinzizyo amoyo wako woonse, kuti bantu boonse babone mboya bukomena mumilimo yako. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.15",
            "verseOrgIds": [
              "1TI.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TI 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.11.14"
              },
              "items": [
                {
                  "text": "Rom 11:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi kolibonena omwini akufundisya kwako, Koujisi azintu ezi, utaleki pe, nkaambo wanoocita bobuya, inga ulalifutula omwini, abalo bakumvwa ulabafutula.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.16",
            "verseOrgIds": [
              "1TI.4.16"
            ]
          }
        }
