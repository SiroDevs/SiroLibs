              "items": [
                {
                  "text": "3:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Konga kokaka makani aatali mabotu, aali mbuli bufubafuba bwamacembele. Kogamine kunyanyaala kukukomba, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.7",
            "verseOrgIds": [
              "1TI.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TI 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.6.6"
              },
              "items": [
                {
                  "text": "1 Tim 6:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nkaambo kunyanyaala kwamubili kulagwasya buniini, anu kwala kukomba kulagwasya muziyanza zyoonse, nkaambo kulijisi cisyomezyo casunu acaciindi ciciza. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.8",
            "verseOrgIds": [
              "1TI.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TI 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.1.15"
              },
              "items": [
                {
                  "text": "1 Tim 1:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ijwi linilini litambulika loko ndeeli lyakuti, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.9",
            "verseOrgIds": [
              "1TI.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TI 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.2.3"
              },
              "items": [
                {
                  "text": "1 Tim 2:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.2.4"
              },
              "items": [
                {
                  "text": "4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eno ncencico eci ncotoondela­ mulimo akulwanina, nkaambo myoyo yesu ilalangila Leza Muumi, Mufutuli wabantu boonse, kwiindilila ngwabaabo bazumina.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.10",
            "verseOrgIds": [
              "1TI.4.10"
            ]
          }
        }
      ]
    },
    {
