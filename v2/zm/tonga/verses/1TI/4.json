                  "text": "31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "bakasya bantunyina kukwatana, akulesya kulya zilyo, nzyaakaanza Leza kuti kazinga kaziligwa buyo cakulumba kulibaabo basyoma akuziba bwini. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.3",
            "verseOrgIds": [
              "1TI.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TI 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.1.31"
              },
              "items": [
                {
                  "text": "Matl 1:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.10.15"
              },
              "items": [
                {
                  "text": "Inc 10:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo zyoonse nzyaakaanza Leza nzibotu, takukwe ceelede kukakwa, anooli catambulwa akulumba, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.4",
            "verseOrgIds": [
              "1TI.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TI 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkaambo inga casalazigwa kujwi lya-Leza akukukomba,",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.5",
            "verseOrgIds": [
              "1TI.4.5"
            ]
          }
        }
      ]
    },
