                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eno Muuya waamba ncobeni kuti kuciindi ciciza bamwi bayookuzwa kulusyomo, bakagame kumvwa myuuya yakwe ena amafundisyo aabadaimona, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.1",
