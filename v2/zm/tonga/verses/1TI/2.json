                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "luleelede kuba lwakusama milimo mibotu, mbubonya mbobeelede bakaintu bana-Leza, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.10",
            "verseOrgIds": [
              "1TI.2.10"
            ]
