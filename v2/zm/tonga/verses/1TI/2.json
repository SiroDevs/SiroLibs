        },
        {
          "text": "Nkabela Adamu taakwe naakeenwa, pe, mukaintu nguwakeenwa, elyo aenwe boobo, wakaba mucitazibi. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.14",
