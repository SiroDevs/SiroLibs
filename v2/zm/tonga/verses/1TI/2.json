                  "text": "1 Pet 3:3-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbubonya obo abalo bakaintu kabanga kabasama cakulibombya mbubonya mbokweelede, babe aciwa cibotu. Lusakatilo ndobalisakatizya talweelede kuba lwakupesa masusu akusama ingolida neziba ingale naaba malogwe aaulwa mali manjimanji, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.9",
            "verseOrgIds": [
              "1TI.2.9"
            ]
          }
        },
