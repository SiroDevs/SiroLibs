                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo Jehova wakavuwa, wakati, Lemba eci cilengano, cimvwike kabotu acilembelo, kuti umwi aumwi acibale cakucijaana. ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.2",
            "verseOrgIds": [
              "HAB.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HAB 2:3"
          },
          "items": [
            {
