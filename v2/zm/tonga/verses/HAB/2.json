                "loc": "HEB.10.38"
              },
              "items": [
                {
                  "text": "Heb 10:38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Moyo wakwe wazimba, toluleme mukati kakwe. Pele mululami, lusyomo lwakwe ndoluyoomuponya.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.4",
            "verseOrgIds": [
              "HAB.2.4"
            ]
          }
        }
      ]
    },
