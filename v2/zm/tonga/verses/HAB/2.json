            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.10.14"
              },
              "items": [
                {
                  "text": "Dan 10:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.37"
              },
              "items": [
                {
                  "text": "Heb 10:37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo cilengano cilijisi ciindi caco cibikidwe. Cileza bukunkulika, nkabela kumamanino tacikooyoobeja pe. Na camuka, kocilindila, nkaambo ncobeni cilaza, tacikooyoocedelelwa pe. ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.3",
            "verseOrgIds": [
              "HAB.2.3"
            ]
          }
        },
        {
