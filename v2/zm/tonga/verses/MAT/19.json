                  "text": "Lev 19:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lemya uso abanyoko, nkabela, Yanda mweenzinyoko mbuli mboliyanda omwini. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.19",
            "verseOrgIds": [
              "MAT.19.19"
