                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakamwaambila wati, Ino nkaambonzi wandibuzya acibotu? nkwali omwe mubotu. Pele kuti koyanda kunjila mubuumi, tobela milazyo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.17",
