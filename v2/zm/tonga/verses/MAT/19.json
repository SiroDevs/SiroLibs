                  "text": "26:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Jesu naakamana kwaamba obo, wakazwa ku-Galilaya, waya kucisi ceengelede caku-Judaya mutala lya-Jordano. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.1",
            "verseOrgIds": [
              "MAT.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela kwakamutobela makamu makamu aabantu, lino wakabaponya nkukonya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.2",
            "verseOrgIds": [
              "MAT.19.2"
            ]
          }
        }
      ]
    },
