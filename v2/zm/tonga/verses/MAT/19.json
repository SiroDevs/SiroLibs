              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino oyo mukubusi wamwaambila wati, Eyi yoonse ndaijatisya. Ino ncinzi ncincibula? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.20",
