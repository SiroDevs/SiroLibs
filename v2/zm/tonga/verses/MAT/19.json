                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo kwakamusikila ba-Farisi, bamusunka, baamba bati, Sa kuliluleme kuti muntu aleke mukakwe nkaambo kamakani oonse? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.3",
            "verseOrgIds": [
              "MAT.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.1.27"
              },
              "items": [
                {
                  "text": "Matl 1:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.5.2"
              },
              "items": [
                {
                  "text": "5:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela wakavuwa, wakati, Sa tamubalide kuti oyo iwakabalenga kuzwa kumatalikilo wakabacita baalumi abanakazi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.4",
            "verseOrgIds": [
              "MAT.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.2.24"
              },
              "items": [
                {
                  "text": "Matl 2:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.31"
              },
              "items": [
                {
                  "text": "Ef 5:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi wakaamba kuti, Nkaambo kaako mwaalumi asie wisi abanyina, akakatile mukakwe, kuti aba bobile babe nyama yomwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.5",
            "verseOrgIds": [
              "MAT.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.7.10"
              },
              "items": [
                {
                  "text": "1 Kor 7:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.7.11"
              },
              "items": [
                {
                  "text": "11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino tabacili bobile pe, baba nyama yomwe. Nkaambo kaako, abo mbaakakakatizya Leza muntu atabapambukanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.6",
            "verseOrgIds": [
              "MAT.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.24.1+DEU.24.2+DEU.24.3+DEU.24.4"
              },
              "items": [
                {
                  "text": "Dt 24:1-4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.31"
              },
              "items": [
                {
                  "text": "Mt 5:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bamwaambila bati, Pele nkaambonzi Musa wakalailila kuti amupe lugwalo lwacilekanino, elyo amuleke? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.7",
            "verseOrgIds": [
              "MAT.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabaambila wati, Nkaambo kabuyumu bwamyoyo yanu ncaakamuzuminina Musa kuleka banakazi banu. Nekubaboobo kuzwa kumatalikilo teekwakali boobo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.8",
            "verseOrgIds": [
              "MAT.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.32"
              },
              "items": [
                {
                  "text": "Mt 5:32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.7.10+1CO.7.11"
              },
              "items": [
                {
                  "text": "1 Kor 7:10-11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.16.18"
              },
              "items": [
                {
                  "text": "Lk 16:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndamwaambila kuti umwi aumwi uuleka mukakwe akukwata umbi, nkutaamba nkaambo kakuvuula luzutu, waba sibwaamu. Nkabela oyo uukwata mwanakazi uwakalekwa waba sibwaamu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.9",
            "verseOrgIds": [
              "MAT.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basikwiiya bamwaambila bati, Kuti makani aamwaalumi amukakwe ali boobo tacili cibotu kukwata. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.10",
            "verseOrgIds": [
              "MAT.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.7.7"
              },
              "items": [
                {
                  "text": "1 Kor 7:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.7.17"
              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela wakabaambila wati, Teensi bantu boonse bakonzya kutambula inkani eyi, pele abo bapedwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.11",
            "verseOrgIds": [
              "MAT.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo nkubali bazibe bamwi ibakazyedwe obo kuzwa mwida lyamanyina, alimwi nkubali bazibe bamwi ibakacitwa obo kubantu, alimwi nkubali bazibe bamwi ibakalicita obo beni nkaambo ka-Bwami bwakujulu. Oyo uukonzya kutambula atambule.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.12",
            "verseOrgIds": [
              "MAT.19.12"
            ]
          }
        }
      ]
    },
