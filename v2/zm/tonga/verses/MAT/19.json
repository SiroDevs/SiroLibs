        },
        {
          "text": "Lino Jesu wakaambila basikwiiya bakwe wati, Ncobeni ndamwaambila kuti kumuvubi nkuyumu kunjila mu-Bwami bwakujulu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.23",
            "verseOrgIds": [
              "MAT.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
