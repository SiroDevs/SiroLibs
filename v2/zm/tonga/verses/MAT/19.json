                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Jesu wakabacebuka, wabaambila wati, Kubantu tacikonzeki, nekubaboobo zintu zyoonse zilakonzeka kuli-Leza. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.26",
