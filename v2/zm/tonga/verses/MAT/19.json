                  "text": "Lk 12:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jesu wakamwaambila wati, Kuti koyanda kulondoka, koya ukauzye imbono zyako, ukaabile bacete, nkabela uzoojana buvubi kujulu, lino uboole kuzootobela ndime. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.21",
            "verseOrgIds": [
              "MAT.19.21"
            ]
          }
        },
        {
