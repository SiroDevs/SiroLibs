          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela basikwiiya nibakaswiililila obo bakagamba loko, bakati, Ma! ino nguni uukonzya kufutuka. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.25",
            "verseOrgIds": [
              "MAT.19.25"
            ]
