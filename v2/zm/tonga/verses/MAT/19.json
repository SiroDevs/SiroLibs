          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi ndamwaambila kuti, Nkutete kunkamele kuti iinde muliso lyansunda kwiinda kuti muvubi anjile mu-Bwami bwa-Leza. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.24",
            "verseOrgIds": [
              "MAT.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
