              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo bakasia bwaato awisaabo, bakamutobela.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.22",
            "verseOrgIds": [
              "MAT.4.22"
            ]
