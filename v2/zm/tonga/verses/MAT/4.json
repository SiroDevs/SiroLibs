                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Jesu wakeenzegwa a-Muuya munkanda kuti akasunkwe Diabolosi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.1",
            "verseOrgIds": [
              "MAT.4.1"
            ]
          }
