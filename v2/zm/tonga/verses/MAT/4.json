              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino kuzwa oko wakaya kunembo, wakabona bamwi babunyina bobile, Jakobo mwanaakwe Zebedayo, a-Johane mwanike wakwe, kabali mubwaato awisaabo Zebedayo, bakali mukusuma insabwe zyabo, elyo wakabaita. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.21",
            "verseOrgIds": [
              "MAT.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
