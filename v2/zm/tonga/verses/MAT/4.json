                "loc": "EXO.34.28"
              },
              "items": [
                {
                  "text": "Kul 34:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.19.8"
              },
              "items": [
                {
                  "text": "1 Bam 19:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela wakaliimya kulya mazuba aali makumi one, masiku asikati, lino wakafwa inzala, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.2",
            "verseOrgIds": [
              "MAT.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
