              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Jesu wakamwaambila kuti, Alimwi kulilembedwe kuti, Utasunki Jehova Leza wako. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.7",
            "verseOrgIds": [
