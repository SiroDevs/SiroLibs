                  "text": "Int 91:11-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "wakamwaambila wati, Kuti koli Mwana a-Leza, uliwaale ansi, nkaambo kulilembedwe kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.6",
