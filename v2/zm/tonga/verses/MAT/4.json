                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo bakasia insabwe zyabo, bakamutobela. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.20",
            "verseOrgIds": [
              "MAT.4.20"
