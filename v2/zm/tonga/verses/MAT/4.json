              "items": [
                {
                  "text": "Dt 6:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Jesu wakamwaambila kuti, Koya, uwe Saatani, nkaambo kulilembedwe kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.10",
