              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "alakwe Azoro wakazyala Sadoki, alakwe Sadoki wakazyala Akimu, alakwe Akimu wakazyala Eliyudi, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.14",
            "verseOrgIds": [
              "MAT.1.14"
            ]
          }
        },
        {
