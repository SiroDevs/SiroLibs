              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "alakwe Hezekiya wakazyala Manasi, alakwe Manasi wakazyala Amosi, alakwe Amosi wakazyala Josiya, ",
          "type": "text",
          "attrs": {
