          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Josefa mulumaakwe mbaakali muntu uululeme, takwakayanda kumuusya insoni, wakayeeya kuti nkamuleke kumbali. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.19",
