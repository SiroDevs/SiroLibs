          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "alakwe Uziya wakazyala Jotama, alakwe Jotama wakazyala Ahaze; alakwe Ahaze wakazyala Hezekiya, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.9",
            "verseOrgIds": [
