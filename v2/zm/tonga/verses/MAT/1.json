              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "alakwe Zerobabele wakazyala Abiyudi, alakwe Abiyudi wakazyala Eliyakimu, alakwe Eliyakimu wakazyala Azoro, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.13",
            "verseOrgIds": [
              "MAT.1.13"
            ]
          }
        },
        {
