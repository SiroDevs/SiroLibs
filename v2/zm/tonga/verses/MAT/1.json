          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "alakwe Asa wakazyala Josafata, alakwe Josafata wakazyala Joramu, alakwe Joramu wakazyala Uziya, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.8",
            "verseOrgIds": [
              "MAT.1.8"
            ]
          }
