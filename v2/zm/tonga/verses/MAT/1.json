                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "alakwe Solomoni wakazyala Roboamu, alakwe Roboamu wakazyala Abiya, alakwe Abiya wakazyala Asa, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.7",
