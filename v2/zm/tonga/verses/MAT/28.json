                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.14"
              },
              "items": [
                {
                  "text": "Dan 7:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Jesu wakeza, wabaambila wati, Ndapegwa bwami boonse nibuba bwakujulu nibuba bwaansi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.18",
            "verseOrgIds": [
              "MAT.28.18"
            ]
          }
        },
        {
