              },
              "items": [
                {
                  "text": "Inc 1:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.16.15"
              },
              "items": [
                {
                  "text": "Mk 16:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.16.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kaako kamuya mukabaiisye bantu bamisyobo yoonse, akubabapatizya muzina lya-Taata alya-Mwana alya-Muuya Uusalala, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.19",
            "verseOrgIds": [
              "MAT.28.19"
            ]
          }
