              "items": [
                {
                  "text": "2 Pet 1:17-18",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino naakainda mazuba aali musanu abumwi, Jesu wakabweza Petro a-Jakobo a-Johane munyina, wabatola abalike atala acilundu cilamfu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.1",
            "verseOrgIds": [
              "MAT.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.1.16+2PE.1.17+2PE.1.18"
              },
              "items": [
                {
                  "text": "2 Pet 1:16-18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela wakasanduka kubusyu bwabo. Busyu bwakwe bwakabala mbuli izuba, azyakusama zyakwe zyakatuba buu mbuli mumuni. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.2",
            "verseOrgIds": [
              "MAT.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo kwakababonekela Musa a-Eliya, balabandika awe. Lino Petro wakavuwa, waambila Jesu wati, Mwami, ncibotu kulindiswe kuba ano. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.3",
            "verseOrgIds": [
              "MAT.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuti koyanda, ndayaka zilao zyotatwe, cimwi cibe cako, cimwi cibe ca-Musa, acimwi cibe ca-Eliya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.4",
            "verseOrgIds": [
              "MAT.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
