              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele oyu musyobo taakwe bumbi mbuutandwa pele kukukomba akukuliimya kulya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.21",
