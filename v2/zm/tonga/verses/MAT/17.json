                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino nibakasika ku-Kapernauma, kwakasika kuli-Petro basikutelesya mali aantempele, baamba bati, Sa mufundisi wanu tateli mali aantempele? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.24",
            "verseOrgIds": [
              "MAT.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
