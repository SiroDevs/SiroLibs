          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.14.31"
              },
              "items": [
                {
                  "text": "Mt 14:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.16.8"
              },
              "items": [
                {
                  "text": "16:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela wakabaambila kuti, Ino nkaambonzi mwaba abukandu, nubasilusyomo-luniini? Mpawo wakabuka, wakalailila myuuwo amaanzi, nkabela kwakaba lubatamo lupati. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.26",
            "verseOrgIds": [
              "MAT.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino abo bantu bakagamba, bakati, Ino muntu oyu uli buti? Nkaambo ayalo myuuwo amaanzi zilamuswiilila.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.27",
            "verseOrgIds": [
              "MAT.8.27"
            ]
          }
        }
