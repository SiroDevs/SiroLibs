              "items": [
                {
                  "text": "Lk 17:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Jesu wakamwaambila kuti, Swiilila! Utaambili muntu naba omwe makani, pele koya ulitondezye kumupaizi, ukatuule cipo ncaakalailila Musa, kuti cibe citondezyo kulimbabo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.4",
            "verseOrgIds": [
              "MAT.8.4"
            ]
          }
        }
