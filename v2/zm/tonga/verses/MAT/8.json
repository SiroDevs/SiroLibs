          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkabela wakabaampa ijanza lyabo, elyo intuntumaanzi yakabaleka, nkabela bakabuka akumukutaukila. ",
          "type": "text",
          "attrs": {
