        },
        {
          "text": "Lino naakanjila mu-Kapenaumu kwakasika kulinguwe umwi silutwe wabasinkondo, wakamukumbila, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.5",
            "verseOrgIds": [
              "MAT.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakati, Mwami, mwanaangu ulilede muŋanda, uliyuminide mubili, ulaciswa loko. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.6",
            "verseOrgIds": [
              "MAT.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakamwaambila kuti. Ndeza nzoomuponye. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.7",
            "verseOrgIds": [
              "MAT.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela silutwe wakavuwa kuti, Mwami, nsyeelede kuti unjile muŋanda yangu, amba kujwi buyo, elyo uzooponesegwa mwanaangu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.8",
            "verseOrgIds": [
              "MAT.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo ambebo ndi muntu mulailile, ndijisi bwami abasinkondo, ndaambila umwi, Koya, nkabela ulaya, aumwi, Koza, nkabela uleza, amuzike wangu, Cita obo, nkabela ulacita.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.9",
            "verseOrgIds": [
              "MAT.8.9"
            ]
          }
        }
