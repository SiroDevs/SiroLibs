                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela naakaseluka kuzwa kucilundu makamu makamu aabantu akamutobela. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.1",
            "verseOrgIds": [
