              "items": [
                {
                  "text": "1 Bam 19:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aumwi akati kabasikwiiya wakamwaambila kuti, Mwami, undizumizye kuti nkasaangune kubweda, nkazike Taata. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.21",
