        },
        {
          "text": "Lino Jesu naakanjila muŋanda ya-Petro wakabona banyinazyala balilede, baciswa intuntumaanzi, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.14",
            "verseOrgIds": [
              "MAT.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
