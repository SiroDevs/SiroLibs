              "type": "text"
            }
          ]
        },
        {
          "text": "Lino naakanjila mubwaato basikwiiya bakwe bakamutobela. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.23",
            "verseOrgIds": [
              "MAT.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
