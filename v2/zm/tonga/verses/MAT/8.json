              "attrs": {
                "loc": "LUK.8.26+LUK.8.27+LUK.8.28+LUK.8.29+LUK.8.30+LUK.8.31+LUK.8.32+LUK.8.33+LUK.8.34+LUK.8.35+LUK.8.36+LUK.8.37"
              },
              "items": [
                {
                  "text": "Lk 8:26-37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino naakasika mutala mucisi caba-Gadara kwakamuswaangana basibadaimona bobile bazwa kutubanda, kabali bakali loko, katakwe muntu iwakali kukonzya kwiinda munzila eyo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.28",
            "verseOrgIds": [
              "MAT.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
