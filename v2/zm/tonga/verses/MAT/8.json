            "number": "2",
            "style": "v",
            "sid": "MAT 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo kwakasika sicinsenda, wakamukomba, wakati, Mwami, kuti koyanda, ulakonzya kundisalazya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.2",
            "verseOrgIds": [
              "MAT.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino wakatambika ijanza lyakwe, wakamwaampa, wakati, Ndazumina, salazigwa. Mpawo cinsenda cakwe cakasalazigwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.3",
            "verseOrgIds": [
              "MAT.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
