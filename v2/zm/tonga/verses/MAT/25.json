              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulikozyene amuntu iwakaamba kuya kucisi cimwi, elyo wakaita bazike bakwe, wakabaabila imbono zyakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.14",
            "verseOrgIds": [
              "MAT.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.6"
              },
              "items": [
                {
                  "text": "Rom 12:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Umwi wakamupa matalenta osanwe, umwi obile, aumwi lyomwe. Umwi aumwi wakapegwa mbuli inguzu zyakwe. Mpawo wakainka. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.15",
            "verseOrgIds": [
              "MAT.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino oyo iwakatambwide matalenta osanwe wakaabelesya, wapindauka matalenta amwi osanwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.16",
            "verseOrgIds": [
              "MAT.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbubonya obo ayooyo iwakatambwide obile wakapindauka amwi obile. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.17",
            "verseOrgIds": [
              "MAT.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele oyo iwakatambwide lyomwe wakainka, wasya ansi, wasisa mali aamwami wakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.18",
            "verseOrgIds": [
              "MAT.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino nicakaba ciindi cilamfu mwami wabazike abo wakasika, wabalingula. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.19",
            "verseOrgIds": [
              "MAT.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo oyo iwakatambwide matalenta osanwe wakaleta matalenta amwi osanwe, wakati, Mwami, wakandipa matalenta osanwe. Langa! ndijene ambi matalenta osanwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.20",
            "verseOrgIds": [
              "MAT.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.25.23"
              },
              "items": [
                {
                  "text": "Mt 25:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.24.45+MAT.24.46+MAT.24.47"
              },
              "items": [
                {
                  "text": "Mt 24:45-47",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.16.10"
              },
              "items": [
                {
                  "text": "Lk 16:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwami wakwe wakamwaambila wati, Wabotya, nomuzike mubotu musyomesi. Wakasyomeka kuzintu zice, ndakukazika kuti ube azintu zinji, njila mubusekelezi bwamwami wako. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.21",
            "verseOrgIds": [
              "MAT.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi oyo iwakatambwide matalenta obile wakasika, wakati, Mwami, wakandipa matalenta obile, Langa! ndijene ambi matalenta obile. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.22",
            "verseOrgIds": [
              "MAT.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.25.21"
              },
              "items": [
                {
                  "text": "Mt 25:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwami wakwe wakamwaambila wati, Wabotya, nomuzike mubotu musyomesi. Wakasyomeka kuzintu zice, ndakukazika kuti ube azintu zinji, njila mubusekelezi bwamwami wako. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.23",
            "verseOrgIds": [
              "MAT.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino oyo iwakatambwide italenta lyomwe wakasika, wakati, Mwami, ndakuziba kuti uli muntu muyumu, ulatebula nkotabyala akubunganya nkotaminza, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.24",
            "verseOrgIds": [
              "MAT.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkabela ndakayoowa, ndakaya kuyoosisa munyika italenta lyako. Langa, ndeeli lyako! ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.25",
            "verseOrgIds": [
              "MAT.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
