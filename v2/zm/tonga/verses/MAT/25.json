          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo ndakafwa inzala, teemwakandipa kulya; ndakafwa inyota, teemwakandinywisya; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.42",
            "verseOrgIds": [
              "MAT.25.42"
            ]
          }
