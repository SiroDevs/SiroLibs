                }
              ]
            }
          ]
        },
        {
          "text": "Lino imbelele uzoozibika kululyo lwakwe, impongo uzoozibika kucimwensi cakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.33",
