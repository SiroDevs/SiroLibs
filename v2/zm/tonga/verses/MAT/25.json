              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndakali cintanda, mwakandisamika; ndakali mulwazi, mwakandiswaya; ndakali muntolongo, mwakandizida. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.36",
