          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndakali mweenzu, teemwakandikondezya; ndakali cintanda, teemwakandisamika; ndakali mulwazi amuntolongo, teemwakandiswaya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.43",
            "verseOrgIds": [
              "MAT.25.43"
            ]
          }
