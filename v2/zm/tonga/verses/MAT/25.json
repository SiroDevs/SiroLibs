            }
          ]
        },
        {
          "text": "Ino uzooambila abo bali kucimwensi cakwe kuti, Amuzwe kulindime inywe numutukidwe, munjile mumulilo uutamani ngwabambilidwe Diabolosi abaangelo bakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.41",
            "verseOrgIds": [
              "MAT.25.41"
            ]
          }
