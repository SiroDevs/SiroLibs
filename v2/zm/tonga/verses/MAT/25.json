                  "text": "Mt 6:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino balulami bazoomuvwiila kuti, Mwami, ndilili nditwakakubona koli sinzala, twakusanina; nanka sinyota, twakunywisya? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.37",
            "verseOrgIds": [
              "MAT.25.37"
            ]
          }
        },
        {
