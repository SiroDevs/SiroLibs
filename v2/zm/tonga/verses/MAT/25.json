          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo uzoobavwiila kuti, Ncobeni ndamwaambila kuti, mbuli mbumwakatacitila obo umwi naba muniini akati kabaaba mbubonya teemwakacitila ndime. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.45",
