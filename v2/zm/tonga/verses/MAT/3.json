          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino kwakalundumuka nkwaakabede bamu-Jerusalemu abamuJudaya boonse abamucisi ceengelede caku-Jordano boonse, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.5",
            "verseOrgIds": [
              "MAT.3.5"
            ]
          }
        },
        {
          "name": "verse",
