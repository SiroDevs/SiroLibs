                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Jesu wakazwa ku-Galilaya, wakasika ku-Jordano kuli-Johane kuti abapatizigwe anguwe, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.13",
            "verseOrgIds": [
              "MAT.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
