            "number": "14",
            "style": "v",
            "sid": "MAT 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele Johane wakasi mukasye, wakati, Ndime enjeelede kubapatizigwa kulinduwe, anukuti yebo weza kulindime? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.14",
            "verseOrgIds": [
              "MAT.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Jesu wakavuwa kuti, Akube boobo, nkaambo kakuti mbuboobo mbutweelede kuzulizya ziluleme zyoonse. Mpawo wakamuzuminina ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.15",
            "verseOrgIds": [
              "MAT.3.15"
            ]
          }
        },
        {
