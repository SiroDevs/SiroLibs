        },
        {
          "text": "Ime ndamubapatizya mumaanzi, kuti mweempwe, pele oyo uuza musule lyangu uli anguzu kwiinda ndime, nkabela mebo nsyeelede nikuba kuyumuna indyasyo zyakwe. Oyu uzoomubapatizya mu-Muuya Uusalala amumulilo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.11",
            "verseOrgIds": [
              "MAT.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
