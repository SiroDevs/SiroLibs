                "loc": "MAT.13.30"
              },
              "items": [
                {
                  "text": "Mt 13:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Cipupuluzyo cakwe cili mujanza lyakwe, nkabela uzoosalazya lubuwa lwakwe, uzoobunganya maila aakwe mubutala, pele buungu uzoobutentela mumulilo uutazimiki.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.12",
            "verseOrgIds": [
              "MAT.3.12"
            ]
          }
        }
