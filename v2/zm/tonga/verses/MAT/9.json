              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.5.27+LUK.5.28+LUK.5.29+LUK.5.30+LUK.5.31+LUK.5.32"
              },
              "items": [
                {
                  "text": "Lk 5:27-32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Jesu naakazwa oko wakabona muntu ulikede kucitelelo, izina lyakwe ngu-Matayo, nkabela wakamwaambila kuti, Unditobele. Lino wakabuka, wakamutobela.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.9",
            "verseOrgIds": [
              "MAT.9.9"
            ]
          }
        }
      ]
    },
