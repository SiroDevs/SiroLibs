                "loc": "LUK.18.12"
              },
              "items": [
                {
                  "text": "Lk 18:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino kwakasika kulinguwe basikwiiya ba-Johane, bakati, Ino nkaambonzi tulaliimya kulya kanjikanji, iswe aba-Farisi, pele basikwiiya bako tabaliimyi kulya? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.14",
            "verseOrgIds": [
              "MAT.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.29"
              },
              "items": [
                {
                  "text": "Joh 3:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Jesu wakabaambila kuti, Sa beenzinyina simusa balakonzya kulila, simusa naacili abo? Azoosika mazuba nibazoonyangwa simusa, elyo bazooliimya kulya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.15",
            "verseOrgIds": [
              "MAT.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.17"
              },
              "items": [
                {
                  "text": "Joh 1:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Taakwe muntu uumamya cimamo cacisani cipya acikobela cikulukulu, nkaambo cisinsyo caco cilazakazya cikobela, nkabela cilakomena cimanga. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.16",
            "verseOrgIds": [
              "MAT.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi tabatuntili waini mupya munkomo inkulukulu, nkaambo inkomo zilabbosoka, elyo waini ulanyonyauka, azyalo inkomo zilafwa. Balatuntila waini mupya munkomo impya, lino zyoonse zilalondolwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.17",
            "verseOrgIds": [
              "MAT.9.17"
            ]
          }
        }
      ]
    },
    {
