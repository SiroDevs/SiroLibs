                "loc": "MAT.8.13"
              },
              "items": [
                {
                  "text": "Mt 8:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino wakaampa meso aabo, wati, Akube kulindinywe mbubonya mbuli lusyomo lwanu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.29",
            "verseOrgIds": [
              "MAT.9.29"
            ]
          }
        },
        {
