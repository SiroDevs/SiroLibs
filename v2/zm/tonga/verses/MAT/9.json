                  "text": "Mt 8:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela meso aabo akanamuna. Lino Jesu wakabanyetukila, wakati, Amubone, kutazi muntu naba omwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.30",
            "verseOrgIds": [
              "MAT.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
