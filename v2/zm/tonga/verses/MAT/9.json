                "loc": "LUK.8.41+LUK.8.42+LUK.8.43+LUK.8.44+LUK.8.45+LUK.8.46+LUK.8.47+LUK.8.48+LUK.8.49+LUK.8.50+LUK.8.51+LUK.8.52+LUK.8.53+LUK.8.54+LUK.8.55+LUK.8.56"
              },
              "items": [
                {
                  "text": "Lk 8:41-56",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino naakacili kubaambila obo, kwakasika mwami umwi, wakamufugamina, wakati, Mwanaangu musimbi wafwa lino lino, nekubaboobo uboole, ukamwaampe ajanza lyako, elyo ulapona. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.18",
            "verseOrgIds": [
              "MAT.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Jesu wakanyampuka, wakamutobela, abasikwiiya bakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.19",
            "verseOrgIds": [
              "MAT.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela umwi mwanakazi iwakali kuciswa bulwazi bwakuzwa bulowa myaaka iili ikumi aibili wakeza musule lyakwe, wakaampa bwaya bwacikobela cakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.20",
            "verseOrgIds": [
              "MAT.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.14.36"
              },
              "items": [
                {
                  "text": "Mt 14:36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo wakaamba mumoyo wakwe kuti, Ndaampa buyo cikobela cakwe, ndapona. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.21",
            "verseOrgIds": [
              "MAT.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Jesu wakacebuka, wakamubona, wakaamba kuti, Mwanaangu, sekaseka, lusyomo lwako lwakufutula. Nkabela mwanakazi wakafutuka kuzwa kuciindi eco nciconya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.22",
            "verseOrgIds": [
              "MAT.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Jesu naakasika kuŋanda yamwami, wakabona basinyeele ankamu iiyoba, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.23",
            "verseOrgIds": [
              "MAT.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 9:24"
          },
          "items": [
