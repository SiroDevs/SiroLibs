        },
        {
          "text": "Lino Jesu naakazwa oko, kwakamutobela boofu bobile, bakoongolola bati, Utufwide luzyalo, mwanaakwe Davida. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.27",
