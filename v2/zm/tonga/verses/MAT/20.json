            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.18.31+LUK.18.32+LUK.18.33"
              },
              "items": [
                {
                  "text": "Lk 18:31-33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Jesu naakali kuya ku-Jerusalemu, wakatola basikwiiya bali ikumi ababili kumbali, lino wakabaambila munzila wati, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.17",
            "verseOrgIds": [
              "MAT.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.16.21"
              },
              "items": [
                {
                  "text": "Mt 16:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.17.22"
              },
              "items": [
                {
                  "text": "17:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.17.23"
              },
              "items": [
                {
                  "text": "23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amulange! tulaya ku-Jerusalemu, nkabela Mwana a-Muntu uyooabwa kubapaizi bapati abalembi. Lino bayoomupa mulandu kuti ajayigwe, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.18",
            "verseOrgIds": [
              "MAT.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkabela bayoomwaabila bamasi kuti bamunonge akumukwipaula akumubambula aciingano, lino mubuzuba bwatatu uyoobuka.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.19",
            "verseOrgIds": [
              "MAT.20.19"
            ]
          }
        }
      ]
    },
