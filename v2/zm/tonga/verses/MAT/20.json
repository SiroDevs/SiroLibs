                {
                  "text": "Mt 15:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela kakuli boofu bobile ibakakede kumbali anzila. Bamvwe kuti Jesu uli mukwiinda, bakoongolola bati, Mwami, mwana a-Davida, tufwide luzyalo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.30",
            "verseOrgIds": [
              "MAT.20.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
