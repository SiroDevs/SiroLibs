                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino bali ikumi nibakamvwa, bakakalalila abo babunyina bobile. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.24",
            "verseOrgIds": [
