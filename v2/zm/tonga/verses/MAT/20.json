        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.1",
            "verseOrgIds": [
              "MAT.20.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.21.33"
              },
              "items": [
                {
                  "text": "Mt 21:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo Bwami bwakujulu bulikozyene amuntu mwiniŋanda iwakazwa cifumofumo kuyoonjizya basimilimo mumuunda wakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.1",
            "verseOrgIds": [
              "MAT.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino wakazuminana abasimilimo kuti bavoole isheleni lyomwe abuzuba, elyo wakabatuma mumuunda wakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.2",
            "verseOrgIds": [
              "MAT.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela wakazwa acikasaalizi, wakabona bamwi baliimvwi buyo mucisambalilo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.3",
            "verseOrgIds": [
              "MAT.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo wakabaambila kuti, Kamunjila mumuunda anywebo, ndamuvozya mbumweelede. Lino bakaya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.4",
            "verseOrgIds": [
              "MAT.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi wakazwa isikati, wakacita obo, akuciindi nilyaungaunga. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.5",
            "verseOrgIds": [
              "MAT.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi kumazuba wakazwa, wajana bamwi baliimvwi buyo, wabaambila wati, Ino nkaambonzi muliimvwi buyo ano buzuba boonse? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.6",
            "verseOrgIds": [
              "MAT.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamwaambila bati, Nkaambo kakuti taakwe muntu iwakatunjizya mumilimo. Wabaambila wati, Kamunjila mumuunda anywebo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.7",
            "verseOrgIds": [
              "MAT.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.13"
              },
              "items": [
                {
                  "text": "Lev 19:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.24.15"
              },
              "items": [
                {
                  "text": "Dt 24:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino nilyakaba igoko mwinimuunda wakaambila mubanzi wakwe wati, Ita basimilimo, ubape bulumbu bwabo, utaangune kubasyaalizi, umanine kubataanzi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.8",
            "verseOrgIds": [
              "MAT.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo abo ibakasika kumazuba bakaboola, batambula umwi aumwi isheleni. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.9",
            "verseOrgIds": [
              "MAT.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela bataanzi nibakaboola, bakali kuyeeya kuti, Tulatambula kwiinda. Nekubaboobo abalo bakatambula umwi aumwi isheleni. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.10",
            "verseOrgIds": [
              "MAT.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino nibakalitambula bakatongaukila mwiniŋanda, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.11",
            "verseOrgIds": [
              "MAT.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "bati, Aba basyaalizi babeleka kaindi kaniini buyo, nekubaboobo wabapa mbubonya mbuwatupa aswebo, nitwalemenwa ciminya cabuzuba boonse akubalwa izuba. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.12",
            "verseOrgIds": [
              "MAT.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino wakavuwa, waambila umwi akati kabo kuti, Mweenzuma, nsikubisisizye pe. Sa teetwazuminana ayebo kusheleni? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.13",
            "verseOrgIds": [
              "MAT.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bweza lyako, uinke! Oyu musyaalizi alakwe ndayanda kumupa mbubonya mbundapa nduwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.14",
            "verseOrgIds": [
              "MAT.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.16"
              },
              "items": [
                {
                  "text": "Rom 9:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.21"
              },
              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.23"
              },
              "items": [
                {
                  "text": "Mt 6:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sa takululeme kuti mbelesye zintu zyangu mbuli mbunjanda? Sa wandifwida mulibu nkaambo ndi mwaabi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.15",
            "verseOrgIds": [
              "MAT.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.19.30"
              },
              "items": [
                {
                  "text": "Mt 19:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.10.31"
              },
              "items": [
                {
                  "text": "Mk 10:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.13.30"
              },
              "items": [
                {
                  "text": "Lk 13:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbubonya obo nkubali bamusule bazooba bataanzi, alimwi nkubali bataanzi bazooba bamusule.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.16",
            "verseOrgIds": [
              "MAT.20.16"
            ]
          }
        }
      ]
    },
