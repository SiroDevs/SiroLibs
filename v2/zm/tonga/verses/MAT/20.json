          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabaambila wati, Mulanywida mukanywido kangu ncobeni, pele kukala kululyo lwangu akucimwensi cangu, teensi ndime uukonzya kupa pe, nkukwabo abo bakabambilwa kwa-Taata. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.23",
            "verseOrgIds": [
              "MAT.20.23"
            ]
          }
        },
        {
