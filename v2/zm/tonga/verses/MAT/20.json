                "loc": "MAT.10.2"
              },
              "items": [
                {
                  "text": "Mt 10:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo kwakamusikila banyina bana ba-Zebedayo abana bakwe, baza bumukomba akukumbila cintu kulinguwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.20",
            "verseOrgIds": [
              "MAT.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.19.28"
              },
              "items": [
                {
                  "text": "Mt 19:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino wakabaambila wati, Ino ncinzi ncomuyanda? Balo bakamwaambila bati, Lailila kuti bana bangu aba bobile bakale, umwi kululyo lwako, umwi kucimwensi cako, mu-Bwami bwako. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.21",
            "verseOrgIds": [
              "MAT.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
