                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele kulindinywe takuli boobo pe. Umwi aumwi uuyanda kuba mupati akati kanu uzooba mulanda wanu, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.26",
