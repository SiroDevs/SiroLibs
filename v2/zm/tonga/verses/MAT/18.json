          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.28.20"
              },
              "items": [
                {
                  "text": "Mt 28:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.14.23"
              },
              "items": [
                {
                  "text": "Joh 14:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo nkubabede bantu bobile nanka botatwe babungene muzina lyangu, nkukonya oko nkumbede ambebo akati kabo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.20",
            "verseOrgIds": [
              "MAT.18.20"
            ]
          }
        }
      ]
