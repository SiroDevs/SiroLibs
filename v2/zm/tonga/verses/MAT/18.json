              "items": [
                {
                  "text": "Mk 11:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi ndamwaambila kuti bantu bobile akati kanu nimukala ansi nibazuminana antoomwe kukukumbila makani aali buti, banoopegwa kwa-Taata uuli kujulu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.19",
            "verseOrgIds": [
              "MAT.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
