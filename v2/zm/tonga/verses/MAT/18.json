                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kuciindi eco nciconya basikwiiya bakaswena kuli-Jesu, bakati, Ino nguni mupati mu-Bwami bwakujulu? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.1",
            "verseOrgIds": [
              "MAT.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo wakaita kana, wakakaimikizya akati kabo, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.2",
            "verseOrgIds": [
              "MAT.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.10.15"
              },
              "items": [
                {
                  "text": "Mk 10:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.18.17"
              },
              "items": [
                {
                  "text": "Lk 18:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.19.14"
              },
              "items": [
                {
                  "text": "Mt 19:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.3+JHN.3.4+JHN.3.5"
              },
              "items": [
                {
                  "text": "Joh 3:3-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "wakati, Ncobeni ndamwaambila kuti, Mwataakusanduka akuba mbuli twana, tamukooyoonjila pe mu-Bwami bwakujulu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.3",
            "verseOrgIds": [
              "MAT.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kaako umwi aumwi uulibombya mbuli kana aka nguwenya uuzooba mupati mu-Bwami bwakujulu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.4",
            "verseOrgIds": [
              "MAT.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.40"
              },
              "items": [
                {
                  "text": "Mt 10:40",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.13.20"
              },
              "items": [
                {
                  "text": "Joh 13:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi umwi aumwi uutambula kana nikaba komwe kali boobu muzina lyangu watambula ndime. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.5",
            "verseOrgIds": [
              "MAT.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.1"
              },
              "items": [
                {
                  "text": "Lk 17:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele umwi aumwi uulebya naba omwe akati kabaniini aba basyoma ndime, kulabota kulinguwe kuti aangwe iziyo ipati kunsingo yakwe akubbizigwa mumaanzi malamfu aamulwizi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.6",
            "verseOrgIds": [
              "MAT.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maawe bantu baansi nkaambo kazilebyo. Zilebyo zileelede kuba ncobeni, pele maawe muntu oyo uuleta cilebyo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.7",
            "verseOrgIds": [
              "MAT.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.29"
              },
              "items": [
                {
                  "text": "Mt 5:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.30"
              },
              "items": [
                {
                  "text": "30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kuti ijanza lyako nanka cituta cako kacikulebya, cikosole ucisowe, nkaambo kulakubotela kuti unjile mubuumi, nikuba kuti koli cilema nanka kotyokede, kwiinda kuwaalwa mumulilo uutazimi nekubaboobo ucili amaanza obile amaulu obile. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.8",
            "verseOrgIds": [
              "MAT.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.29"
              },
              "items": [
                {
                  "text": "Mt 5:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "­Alimwi liso lyako kuti kalikulebya, lidadule, ulisowe, nkaambo kulakubotela kuti unjile mubuumi nikuba kuti koli sicimbolyo kwiinda kuwaalwa mumulilo wamu-Gehena nocili ameso obile. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.9",
            "verseOrgIds": [
              "MAT.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.1.14"
              },
              "items": [
                {
                  "text": "Heb 1:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amucenjele, Mutasampauli umwi akati kabaniini aba, nkaambo ndamwaambila kuti kujulu baangelo babo baleebela lyoonse busyu bwa-Taata uuli kujulu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.10",
            "verseOrgIds": [
              "MAT.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.19.10"
              },
              "items": [
                {
                  "text": "Lk 19:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo Mwana a-Muntu wakaboola kukufutula abasweekede. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.11",
            "verseOrgIds": [
              "MAT.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.15.4+LUK.15.5+LUK.15.6+LUK.15.7"
              },
              "items": [
                {
                  "text": "Lk 15:4-7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Muyeeyanzi? muntu kajisi imbelele zili mwaanda, nkabela imwi akati kazyo yapambuka, sa tasii zili makumi aali musanu aane aali amusanu azine kuti aye azilundu, ayandaule eyo iipambukide. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.12",
            "verseOrgIds": [
              "MAT.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela aijana, ndamwaambila ncobeni kuti ulakondelwa njiyo kwiinda ezyo zili makumi aali musanu aane aali amusanu azine izyatakapambuka. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.13",
            "verseOrgIds": [
              "MAT.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuboobo Usowanu uuli kujulu tayandi kuti afwidilile naba umwi akati kabaniini aba.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.14",
            "verseOrgIds": [
              "MAT.18.14"
            ]
          }
        }
      ]
    },
