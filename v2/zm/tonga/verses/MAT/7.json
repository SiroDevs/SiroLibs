              "items": [
                {
                  "text": "Inc 14:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mulyango uumanikide anzila iipatide njiitola kubuumi, nkabela abo biijana mbace.",
