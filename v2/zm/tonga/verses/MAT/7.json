            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.4.24"
              },
              "items": [
                {
                  "text": "Mk 4:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nkaambo kakuti lubeta ndumubetesya bamwi anywebo mulabetesegwa ndulonya olo, aceelesyo ncimweelesya bamwi anywebo muleelesegwa nciconya eco, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.2",
            "verseOrgIds": [
              "MAT.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi, nkaambonzi ulalangilila kapapu kali muliso lyamunyoko, nekubaboobo toyeeyi itanda lili muliso lyako numwini? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.3",
            "verseOrgIds": [
              "MAT.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ino ulaambila buti munyoko kuti, Nkufule kapapu kali muliso lyako, anukuti mulili itanda muliso lyako numwini? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.4",
            "verseOrgIds": [
              "MAT.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nusikuupaupa ameso, usaangune kulifula itanda lili muliso lyako, lino ulabonesya kuti ufule munyoko kapapu kali muliso lyakwe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.5",
            "verseOrgIds": [
              "MAT.7.5"
            ]
          }
        }
      ]
    },
