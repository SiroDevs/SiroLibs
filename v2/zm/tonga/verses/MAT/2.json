          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Heroda naakafwa, angelo wa-Jehova wakabonekela Josefa muciloto mu-Egepita, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.19",
            "verseOrgIds": [
              "MAT.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.4.19"
              },
              "items": [
                {
                  "text": "Kul 4:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "wakati, Buka, tola mwana abanyina, uinke kucisi caba-Israyeli, nkaambo balifwide bakayandaula buumi bwamwana. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.20",
            "verseOrgIds": [
              "MAT.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino wakabuka, wakatola mwana abanyina, wakainka kucisi caba-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.21",
            "verseOrgIds": [
              "MAT.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele naakamvwa kuti ngu-Arkelao uuendelezya Judaya mucuuno cawisi Heroda, wakayoowa kwiinka oko. Lino mbuli mbwaakalaizigwa muciloto wakainka kucisi ceengelede ca-Galilaya, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.22",
            "verseOrgIds": [
              "MAT.2.22"
            ]
          }
        },
        {
