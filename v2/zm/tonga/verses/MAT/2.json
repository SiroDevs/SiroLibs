              "MAT.2.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.2.15"
              },
              "items": [
                {
                  "text": "Kul 2:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino nibakainka angelo wa-Jehova wakabonekela Josefa muciloto, wakati, Buka, tola mwana abanyina, uloboke uye ku-Egepita, ukakale nkuko mane nkakwaambile, nkaambo kakuti Heroda ulayandaula mwana kuti amujaye. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.13",
            "verseOrgIds": [
              "MAT.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo wakabuka, watola mwana abanyina masiku, wainka ku-Egepita, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.14",
            "verseOrgIds": [
              "MAT.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.11.1"
              },
              "items": [
                {
                  "text": "Hos 11:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "wakaakukala oko mane kusikila kulufu lwa-Heroda, kuti acitwe ngaakaamba Jehova kumusinsimi kuti, Kuzwa ku-Egepita nkundakaita mwanaangu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.15",
            "verseOrgIds": [
              "MAT.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Heroda naakabona kuti weenwa kubasongo wakakalala kapati, nkabela wakatuma kuti akajaye bana boonse baku-Betelehemu abeengelede mucisi basimyaaka yobile abali munsi, mbubonya mbuli ciindi ncaakabuzisisya basongo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.16",
            "verseOrgIds": [
              "MAT.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.31.15"
              },
              "items": [
                {
                  "text": "Jer 31:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino akacitwa aakaambwa kuli-Jeremiya musinsimi kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.17",
            "verseOrgIds": [
              "MAT.2.17"
            ]
          }
        }
      ]
    },
    {
