                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Jesu naakazyalwa mu-Betelehemu waku-Judaya muciindi camwami Heroda, kwakasika ku-Jerusalemu basongo bazwa kujwe, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.1",
            "verseOrgIds": [
              "MAT.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.24.17"
              },
              "items": [
                {
                  "text": "My 24:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "bakaamba bati, Uli kuli uuzyedwe mwami waba-Juda? nkaambo twakabona inyenyeezi yakwe kujwe, tweza kumukomba. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.2",
            "verseOrgIds": [
              "MAT.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mwami Heroda naakamvwa boobo wakazingwa, aba-Jerusalemu boonse abalo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.3",
            "verseOrgIds": [
              "MAT.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino wakabunganya bapaizi basimutwe abalembi boonse babantu, wababuzya wati, Ino nkukuli nkwayoozyalilwa Kristo? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.4",
            "verseOrgIds": [
              "MAT.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.5.2"
              },
              "items": [
                {
                  "text": "Mik 5:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.7.42"
              },
              "items": [
                {
                  "text": "Joh 7:42",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bakaamba bati, Mu-Betelehemu waku-Judaya, nkaambo mbuboobo mbukulembedwe kumusinsimi kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.5",
            "verseOrgIds": [
              "MAT.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.6",
            "verseOrgIds": [
              "MAT.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mwami Heroda wakabaita basongo kumbali, wababuzisisya ciindi nciyakaboneka inyenyeezi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.7",
            "verseOrgIds": [
              "MAT.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo wakabatuma ku-Betelehemu, wakati, Kamuya mukayandaule kabotu mwana, nkabela mwaakumujana muzoondaambile, kuti nze ambebo kukumukomba. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.8",
            "verseOrgIds": [
              "MAT.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino balo nibakamvwa mwami bakainka, nkabela inyenyeezi njibakabwene kujwe yakaya kunembo lyabo mane do yakasika, yaima ajulu mpaakabede mwana. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.9",
            "verseOrgIds": [
              "MAT.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibakabona inyenyeezi bakakondwa kukondwa kupati loko. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.10",
            "verseOrgIds": [
              "MAT.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.72.10"
              },
              "items": [
                {
                  "text": "Int 72:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.72.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.60.6"
              },
              "items": [
                {
                  "text": "Is 60:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino basike kuŋanda, bakabona mwana a-Mariya banyina, mpawo bakavundama akumukomba. Nkabela bakavununa zilondwedo zyabo, bamupa inkambilizyo zyangolida atununkilizyo tutegwa libano amura. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.11",
            "verseOrgIds": [
              "MAT.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino bakalaizigwa kuli-Leza muciloto kuti batabweedi kuli-Heroda, nkaambo kaako bakabweeda kulimbabo anzila imbi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.12",
            "verseOrgIds": [
              "MAT.2.12"
            ]
          }
        }
      ]
    },
