              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi bika tununkilizyo tusalala twalibano amulongo umwi aumwi, kuti tube antoomwe azinkwa, tube cipaizyo cakwiibalusya cakutentela Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.7",
            "verseOrgIds": [
