                  "text": "37:17-24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abambe malampi lyoonse aciimikilo cisalala kubusyu bwa-Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.4",
            "verseOrgIds": [
