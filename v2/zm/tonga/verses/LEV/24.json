        },
        {
          "text": "Lailila bana ba-Israyeli kuti bamu letele mafuta aasalala aamaolifa aaengedwe aakumunisya ilampi, kuti ilampi kaliyaka lyoonse. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.2",
            "verseOrgIds": [
              "LEV.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anze lyacisitilizyo camulao mutente lyakubunganina, Aroni mpaelede kulibamba lyoonse, kumazuba acifumofumo, kubusyu bwa-Jehova, Ngumulao walyoonse mumazyalani aanu oonse. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.3",
            "verseOrgIds": [
              "LEV.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
