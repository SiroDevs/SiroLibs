          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.31.8"
              },
              "items": [
                {
                  "text": "Kul 31:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.37.17+EXO.37.18+EXO.37.19+EXO.37.20+EXO.37.21+EXO.37.22+EXO.37.23+EXO.37.24"
