        },
        {
          "text": "Mpawo Musa wakaita Misayeli a-Elizafana, bana ba-Uzieli simizyaabo Aroni, wabaambila kuti, Amuboole, mubweze bana bakwanu, mubagwisye kunembo lyabusena busalalisya akubatola anze lyamalabba. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.4",
            "verseOrgIds": [
              "LEV.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela bakaswena afwaafwi akubabweza azibaki zyabo, babatola anze lyamalabba, mbubonya mbuli Musa mbwaakalailila. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.5",
            "verseOrgIds": [
              "LEV.10.5"
            ]
          }
        },
        {
