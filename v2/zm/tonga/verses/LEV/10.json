              "items": [
                {
                  "text": "2 Sam 24:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Musa wakaambila Aroni abana bakwe Eleazara a-Itamara kuti, Mutatebezyi masusu aanu nekuba kudeluula zyakusama zyanu, kuti mutafwi, kuti bukali butasikili imbungano yoonse yabantu, Pele bana bakwanu, luzubo loonse lwa-Israyeli, balile nkaambo kakutenta Jehova nkwacita. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.6",
            "verseOrgIds": [
              "LEV.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
