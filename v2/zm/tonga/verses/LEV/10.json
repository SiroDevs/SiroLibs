              "attrs": {
                "loc": "NUM.16.35"
              },
              "items": [
                {
                  "text": "My 16:35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.6.7"
              },
              "items": [
                {
                  "text": "2 Sam 6:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo kwakazwa mulilo kubusyu bwa-Jehova akubatenta, nkabela bakafwa nkukonya oko kubusyu bwaJehova. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.2",
            "verseOrgIds": [
              "LEV.10.2"
            ]
