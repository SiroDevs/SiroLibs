            }
          ]
        },
        {
          "text": "Lino bana ba-Aroni bazitente acipaililo atala lyacituuzyo cakutenta atala lyankuni zili amulilo. Ncipaizyo citentwa cili abweema bubotu bwakubotezya Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.5",
            "verseOrgIds": [
              "LEV.3.5"
            ]
