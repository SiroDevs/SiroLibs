          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino agwisye mulinjiyo cituuzyo cakutentela Jehova: lufuko amafuta oonse aamumala, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.14",
            "verseOrgIds": [
