              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abike ijanza lyakwe amutwe waya aijaye kunembo lyatente lyambunganino. Lino bana ba-Aroni basansaile bulowa bwayo koonse koonse cakuzyunguluka cipaililo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.13",
            "verseOrgIds": [
