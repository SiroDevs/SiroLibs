              "items": [
                {
                  "text": "Rom 12:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino mupaizi agwisye mucituuzyo kapanzi kaciibalusyo, acitente acipaililo, cibe cipaizyo citentwa cili abweema bubotu bwakubotezya Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.9",
            "verseOrgIds": [
              "LEV.2.9"
            ]
