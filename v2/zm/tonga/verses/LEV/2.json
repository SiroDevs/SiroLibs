        },
        {
          "text": "Lino eco cisyeede ciyooba ca-Aroni acabana bakwe: ncecipanzi cisalalisya cazipaizyo zitentelwa Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.3",
