            "number": "12",
            "style": "v",
            "sid": "LEV 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amulilo wacipaililo uleelede kuyaka lyoonse; utazimwi pe. Mupaizi atente inkuni alincico cifumo cimwi acimwi, abambe cipaizyo cakutenta mpoonya awo, akutenta alincico mafuta aazituuzyo zyakutontozya. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.12",
            "verseOrgIds": [
