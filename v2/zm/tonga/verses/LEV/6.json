          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lailila Aroni abana bakwe kuti, Ngooyu mulao wazipaizyo zitentwa, Cipaizyo cisyaale acitentelo cacipaililo busiku boonse mane bukace, awalo mulilo wacipaililo unooyaka alincico. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.9",
            "verseOrgIds": [
              "LEV.6.9"
            ]
          }
        },
