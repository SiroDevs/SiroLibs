              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "lino mupaizi amanye mulandu wakwe kubusyu bwa-Jehova, kuti alekelelwe cibi neciba cimwi ncaakabisya akati kazintu ezi, kufumbwa cibi cakamupesya mulandu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.7",
