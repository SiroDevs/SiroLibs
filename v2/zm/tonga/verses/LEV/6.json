                  "text": "Ezk 44:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino mupaizi asame cikobela cakwe cituba akabbudula katuba mucibuno, agwisye itwe lyacipaizyo citentedwe mumulilo waacipaililo, alibike kumbali lyacipaililo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.10",
            "verseOrgIds": [
              "LEV.6.10"
            ]
          }
        },
        {
