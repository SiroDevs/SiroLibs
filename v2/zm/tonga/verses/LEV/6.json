              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amana obo, asamunune zyakusama zyakwe akusama zyakusama zimbi, atole itwe anze lyamalabba kubusena busalala. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.11",
            "verseOrgIds": [
              "LEV.6.11"
            ]
          }
        },
        {
          "name": "verse",
