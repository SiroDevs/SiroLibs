              "items": [
                {
                  "text": "8:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anyama atobo, wakazitenta mumulilo anze lyamalabba.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.11",
            "verseOrgIds": [
              "LEV.9.11"
