          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi bakamuletela cipaizyo cakutenta, cituli cimwi acimwi amutwe, elyo wakacitenta acipaililo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.13",
            "verseOrgIds": [
              "LEV.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino wakasanzya twamukati amyeendo, akuzitenta acipaililo antoomwe acipaizyo citentwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.14",
            "verseOrgIds": [
              "LEV.9.14"
            ]
          }
        }
      ]
