        },
        {
          "text": "Lino wakajaya cipaizyo cakutenta, nkabela bana ba-Aroni bakamuletela bulowa kuti asansaile acipaililo koonse koonse cakuzyunguluka. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.12",
            "verseOrgIds": [
              "LEV.9.12"
            ]
          }
        },
        {
          "name": "verse",
