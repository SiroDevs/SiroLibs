                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele mafuta ansa alulyaŋanga lwamuni, wakazigwisya mucipaizyo cazibi akuzitenta acipaililo, mbubonya mbuli Jehova mbwaakalailila Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.10",
            "verseOrgIds": [
              "LEV.9.10"
            ]
          }
        },
