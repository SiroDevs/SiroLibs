          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkabela bakabika mafuta atala lyakatiti, elyo wakatenta mafuta acipaililo; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.20",
            "verseOrgIds": [
