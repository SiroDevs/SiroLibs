        },
        {
          "text": "Mpawo bakaleta zintu ezyo Musa nzyaakalailila kunembo lyatente lyambunganino, nkabela imbungano yoonse yabantu yakaswena afwiifwi akwiima kubusyu bwa-Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.5",
            "verseOrgIds": [
              "LEV.9.5"
            ]
          }
        },
