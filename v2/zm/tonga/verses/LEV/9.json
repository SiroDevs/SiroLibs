              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi mumusune amulisijembwe wakagwisya mafuta, amucila, alufuko, ansa, alulyaŋanga lwamuni, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.19",
