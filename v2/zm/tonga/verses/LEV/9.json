                  "text": "4:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela bana ba-Aroni bakamuletela bulowa, elyo wakatompa munwe wakwe mubulowa, wabulamba ameja aacipaililo, abulowa ibwakasyeede wakabutila boonse kutako lyacipaililo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.9",
            "verseOrgIds": [
              "LEV.9.9"
            ]
          }
        },
        {
