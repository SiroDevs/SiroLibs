        },
        {
          "text": "Muntu uujisi mulandu muzintu zyoonse zili boobu, alyaambe cibi ncaakabisya, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.5",
            "verseOrgIds": [
