              "items": [
                {
                  "text": "Lev 1:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ayalo yabili aipaizye mbubonya mbuli zipaizyo zyakutenta mbuzipaizigwa, aboobo: nupaizi ulamumanina mulandu wa cibi ncaakabisya, alekelelwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.10",
            "verseOrgIds": [
              "LEV.5.10"
            ]
          }
        }
