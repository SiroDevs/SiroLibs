          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "aletele Jehova cipaizyo cakwe cakupaizizya cibi ncaakabisya, kabelele nanka kapongo kapwizi, kabe cipaizyo cazibi, kuti mupaizi amanye mulandu wakwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.6",
