              "type": "text"
            }
          ]
        },
        {
          "text": "Pele na muntu wacetaala loko, aboobo takonzyi kujana inziba zyobile na twana twankwilimba tobile, cipaizyo cakwe ncaletela cibi ncaakabisya cibe cipanzi cakumi cacisuwo cabusu bunante, cibe cipaizyo cazibi. Atabiki mafuta nanka musamu walibano, pe, nkaambo ncipaizyo cazibi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.11",
            "verseOrgIds": [
              "LEV.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 5:12"
          },
          "items": [
