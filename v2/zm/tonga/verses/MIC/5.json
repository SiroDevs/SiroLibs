            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino inkamu iisyeede ya-Jakobo iyooba akati kamisyobo minji yabantu mbuli lume luzwa kuli-Jehova, ambuli lunywanywa lutalindili muntu nikuba kwiimina bantu baansi. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.7",
            "verseOrgIds": [
              "MIC.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MIC 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkamu iisyeede ya-Jakobo iyooba akati kabamasi, akati kamisyobo minji yabantu, mbuli mulavu akati kabanyama bamusokwe, ambuli syuumbwa akati kamatanga aambelele. Naainda cakulyata acakukwamuna taakwe uukonzya kuvuna. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.8",
            "verseOrgIds": [
              "MIC.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijanza lyako lisumpulwe cakulwisya basimulandunyoko, abasinkondonyoko boonse banyonyooke.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.9",
            "verseOrgIds": [
              "MIC.5.9"
            ]
          }
        }
      ]
    },
