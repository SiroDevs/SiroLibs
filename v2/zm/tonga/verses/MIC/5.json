                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.10.8+GEN.10.9+GEN.10.10+GEN.10.11"
              },
              "items": [
                {
                  "text": "Matl 10:8-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bayooendelezya cisi ca-Asuri kunguzu zyapanga, acisi caNimrodi apanga lisomwedwe. Nkabela uyootuvuna mumaanza aaba-Asuri nibayoonjila mucisi cesu anibayooendenda munyika yesu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.6",
            "verseOrgIds": [
              "MIC.5.6"
            ]
          }
        }
