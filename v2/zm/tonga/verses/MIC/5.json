              "items": [
                {
                  "text": "Zek 9:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mubuzuba obo, mbwaamba Jehova, njoomanisya imbizi zyako akati kanu, akunyonyoona inkalaki zyako. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.10",
            "verseOrgIds": [
              "MIC.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MIC 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njoomanisya minzi yamucisi cako akumwaya zitabilizyo zyako. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.11",
            "verseOrgIds": [
              "MIC.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MIC 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njoomanisya malozi aamumaanza aako, nkabela takooyooba abasondi. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.12",
            "verseOrgIds": [
              "MIC.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MIC 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.13.2"
              },
              "items": [
                {
                  "text": "Zek 13:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.2.8"
              },
              "items": [
                {
                  "text": "Is 2:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi njoomanisya zikozyano zyako zibezedwe amatantilo aako akati kanu, kuti utakombi limbi zibumbwa zyamaanza aako omwini. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.13",
            "verseOrgIds": [
              "MIC.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MIC 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azyaanda zyako zyoonse njoozinonkola akati kanu, aminzi yako njooinyonyoona. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.14",
            "verseOrgIds": [
              "MIC.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MIC 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela bamasi batana kuswiilila njoobatemena milandu cabukali acakunyemesya.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.15",
            "verseOrgIds": [
              "MIC.5.15"
            ]
          }
        }
      ]
