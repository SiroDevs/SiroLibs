              "items": [
                {
                  "text": "Lk 1:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uyooima akweembela munguzu zya-Jehova, mubulemu bwazina lya-Jehova Leza wakwe. Nkabela bayookalilila, nkaambo uyooba mupati koonse koonse akusikila kumagolelo aanyika. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.4",
            "verseOrgIds": [
              "MIC.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
