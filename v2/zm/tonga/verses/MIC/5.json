                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ngonguwe uyooba luumuno lwesu, baAsuri nibayoosika munyika yesu akulyataula mumaanda esu aabwami, elyo tuyoobusya beembezi bali musanu ababili abeendelezi bali musanu abatatu bakubalwisya. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.5",
            "verseOrgIds": [
              "MIC.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
