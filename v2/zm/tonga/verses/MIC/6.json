                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.6.28"
              },
              "items": [
                {
                  "text": "Joh 6:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaletelezyenzi kubusyu bwa-Jehova? Nkotame buti kunembo lyaLeza wakujulu? Sa mboole kubusyu bwakwe azipaizyo? Sa nkalete boombe bamwaka omwe? ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.6",
            "verseOrgIds": [
              "MIC.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MIC 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.50.9"
              },
              "items": [
                {
                  "text": "Int 50:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.1.11"
              },
              "items": [
                {
                  "text": "Is 1:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.16.3"
              },
              "items": [
                {
                  "text": "2 Bam 16:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sa Jehova ulabotelwa zyuulu zyabagutu bambelele, na zyuulu zyuulu zyamilonga yamafuta? Sa nkaabe mwanaangu mutaanzi nkaambo kamilandu yangu, micelo yamubili wangu nkaambo kazibi zyamoyo wangu? ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.7",
            "verseOrgIds": [
              "MIC.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MIC 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakutondezya, O muntu, cintu cibotu mbucibede. Taakwe cintu cimbi Jehova ncayanda kulinduwe, pele kucita bululami akuyanda luzyalo akweenda cakulibombya a-Leza wako.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.8",
            "verseOrgIds": [
              "MIC.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MIC 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.8",
            "verseOrgIds": [
              "MIC.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijwi lya-Jehova lilaongolola kumunzi. (Kulemeka izina lyako nkokuleta coolwe.) Amuswiilile nomusyobo ambungano yamunzi. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.9",
            "verseOrgIds": [
              "MIC.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MIC 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sa bubi mubucili muŋanda yababi? Sa ceelesyo cice cakweenya nkucili? ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.10",
            "verseOrgIds": [
              "MIC.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MIC 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.12.7"
              },
              "items": [
                {
                  "text": "Hos 12:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.3.10"
              },
              "items": [
                {
                  "text": "Am 3:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sa ndakonzya kumululamika uuli azipimyo zitaluleme, ayooyo uuli ankomo yamabwe aakweelesya aakweenya? ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.11",
            "verseOrgIds": [
              "MIC.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MIC 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo bavubi bamunzi balizwide buvupi; bantu bawo balaamba zyakubeja, andimi zyabo zili alweeno mukanwa lyabo. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.12",
            "verseOrgIds": [
              "MIC.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MIC 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mebo ndakuuma acuumyo cijaya, ndakusaala nkaambo kazibi zyako. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.13",
            "verseOrgIds": [
              "MIC.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MIC 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyoolya pele tokooyookuta pe. Buusu bwako bulalibonya mukati kako. Uyoosoleka kulonzya pele tokooyoosisya kabotu pe, aceeco ncosisya njoocaabila ipanga. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.14",
            "verseOrgIds": [
              "MIC.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MIC 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyoobyala pele tokooyootebula. Uyooenga mafuta aamaolifa pele tokooyooanana. Amasaansa uyooalyata, pele tokooyoonywa waini pe. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.15",
            "verseOrgIds": [
              "MIC.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MIC 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.16.23+1KI.16.24+1KI.16.25+1KI.16.26+1KI.16.27+1KI.16.28+1KI.16.29+1KI.16.30+1KI.16.31+1KI.16.32+1KI.16.33+1KI.16.34"
              },
              "items": [
                {
                  "text": "1 Bam 16:23-34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.21.25+1KI.21.26"
              },
              "items": [
                {
                  "text": "21:25-26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo mulatobela ziyanza zya-Omri amilimo yaluzubo lwa-Ahabu, amunjiyo zyabo momweendela. Aboobo njoomwaabila lusaalo, abantu bamumunzi bayooba basikusyolaukwa. Mulasampaulwa kulibamasi.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.16",
            "verseOrgIds": [
              "MIC.6.16"
            ]
          }
        }
      ]
    }
