                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.5.11"
              },
              "items": [
                {
                  "text": "Bab 5:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": "My 22:2–24:25; Jos 3:1–4:19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubantu bangu, mutalubi Balaki mwami wa-Moabu mbwaakakanza kumubisizya, a-Balamu mwana wa-Beori mbwaakamuvwiila. Mutalubi zyoonse izyakacitwa kuzwa ku-Sitimu mane kusikila ku-Giligala, kuti muzibisye milimo iiluleme ya-Jehova mbwiibede.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.5",
            "verseOrgIds": [
              "MIC.6.5"
            ]
          }
        }
      ]
    },
