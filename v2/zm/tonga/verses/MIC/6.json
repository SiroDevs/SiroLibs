              "attrs": {
                "loc": "EXO.4.10+EXO.4.11+EXO.4.12+EXO.4.13+EXO.4.14+EXO.4.15+EXO.4.16"
              },
              "items": [
                {
                  "text": "Kul 4:10-16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.50+EXO.12.51"
              },
              "items": [
                {
                  "text": "12:50-51",
