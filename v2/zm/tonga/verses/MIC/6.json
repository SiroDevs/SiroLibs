                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.15.20"
              },
              "items": [
                {
                  "text": "15:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo ndime ndakamugwisya munyika ya-Egepita. Ndime ndakamunununa muŋanda yabuzike. Ndime ndakamupa Musa a-Aroni a-Miriamu kuti bamusololele. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.4",
            "verseOrgIds": [
              "MIC.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MIC 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.2.14"
              },
              "items": [
                {
                  "text": "Ciy 2:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.25.1"
              },
              "items": [
                {
                  "text": "My 25:1",
