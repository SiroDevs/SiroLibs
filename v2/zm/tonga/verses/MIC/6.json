              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino amuswiilile ncaamba Jehova. Wati, Buka, ukakazyanye azilundu, atwalo tulundulundu tuswiilile ijwi lyako. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.1",
            "verseOrgIds": [
              "MIC.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MIC 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.12.2"
              },
              "items": [
                {
                  "text": "Hos 12:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amuswiilile, nuzilundu, lukazyanyo lwa-Jehova, anywebo numatalikilo aateeli aanyika, nkaambo Jehova uli amakani aakukazyanya abantu bakwe, ulazumanana aba-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.2",
            "verseOrgIds": [
              "MIC.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
