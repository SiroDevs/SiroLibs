                "loc": "AMO.8.11"
              },
              "items": [
                {
                  "text": "Am 8:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basizilengano bayoofwa bweeme, abasondi bayoopilinganisigwa, Boonse bayoofumba milimo yabo, nkaambo takukooyooba lutyabo lwa-Leza. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.7",
            "verseOrgIds": [
              "MIC.3.7"
            ]
          }
