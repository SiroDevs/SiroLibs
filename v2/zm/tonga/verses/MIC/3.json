              "type": "text"
            }
          ]
        },
        {
          "text": "Amuswiilile nubapati baluzubo lwa-Jakobo abasilutwe baluzubo lwaIsrayeli, inywe numusampaula lubeta akupilinganya bululami boonse, ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.9",
            "verseOrgIds": [
              "MIC.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MIC 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "numuyaka Zioni abulowa, a-Jerusalemu mulauyaka abubi. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.10",
            "verseOrgIds": [
              "MIC.3.10"
            ]
          }
