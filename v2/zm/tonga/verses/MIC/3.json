                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele mebo ncobeni ndizwide inguzu nkaambo ka-Muuya wa-Jehova, Ndizwide lubeteko abukozu bwakwaambila Jakobo milandu yakwe akutapatila Israyeli aazibi zyakwe.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.8",
            "verseOrgIds": [
              "MIC.3.8"
            ]
          }
        }
      ]
