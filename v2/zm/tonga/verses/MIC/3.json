                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndakati, Amuswiilile nubasilutwe ba-Jakobo abeendelezi baluzubo lwaIsrayeli. Sa teensi ndinywe numweelede kuziba kubeteka? ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.1",
            "verseOrgIds": [
              "MIC.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MIC 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anukuti ndinywe numusula bubotu akuyandisya bubi. Ndinywe numufunda bantu akukwamuna nyama yakuzifuwa zyabo. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.2",
            "verseOrgIds": [
              "MIC.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.14.4"
              },
              "items": [
                {
                  "text": "Int 14:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mulalya nyama yabantu bangu, azikanda mulazibbabula kumibili yabo. Mulatyolaula zifuwa zyabo, mulazisabaula mbubonya mbuli zyakujika mucilongo, mbuli nyama iibikidwe mucinabwao. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.3",
            "verseOrgIds": [
              "MIC.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MIC 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.1.28"
              },
              "items": [
                {
                  "text": "Tus 1:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Caba ciindi bayoolilila Jehova, pele takooyoobavwiila pe, Uyoosisa busyu bwakwe kulimbabo ciindi eco, nkaambo kakubija kwancito zyabo. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.4",
            "verseOrgIds": [
              "MIC.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MIC 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.56.10"
              },
              "items": [
                {
                  "text": "Is 56:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.7.15"
              },
              "items": [
                {
                  "text": "Mt 7:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbuboobu mbwaamba Jehova aabasinsimi babeji baleesya bantu bangu, balumya meno aabo ciindi cakulila kuti, Luumuno. Kufumbwa muntu uutabiki mumilomo yabo, balalibamba kumulwisya. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.5",
            "verseOrgIds": [
              "MIC.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MIC 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.13.23"
              },
              "items": [
                {
                  "text": "Ezk 13:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kako mulasikilwa masiku, mutabi acilengano, akujana mudima, kuti mutasondi. Izuba liyoobbilila basinsimi banu, abuzuba buyoobasiila mbi. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.6",
            "verseOrgIds": [
              "MIC.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MIC 3:7"
          },
          "items": [
