        },
        {
          "text": "Basilutwe bawo balabeteka cakupegwa makulo, bapaizi bawo balaiisya cakuvola buyo abasinsimi balasondela mali buyo, nekubaboobo balalangila Jehova, balati, Sa Jehova tali akati kesu, Tatukooyoosikilwa bubi. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.11",
            "verseOrgIds": [
              "MIC.3.11"
            ]
          }
        },
