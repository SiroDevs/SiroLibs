              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.11.15"
              },
              "items": [
                {
                  "text": "Ciy 11:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sikwiima-ima njoomucita kuti abe inkamu iitamwaikide, ayooyo uutandidwe uyooba cisi cili anguzu, nkabela Jehova nguuyoobeendelezya mucilundu ca-Zioni kuzwa sunu akutamani.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.7",
            "verseOrgIds": [
              "MIC.4.7"
            ]
          }
        }
      ]
