        },
        {
          "text": "Mubuzuba obo, mbwaamba Jehova, njoobunganya sikwiima-ima, ayooyo uutandidwe njoomuboozya, ayooyo ngundakabisizya, ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.6",
            "verseOrgIds": [
