                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.24.17"
              },
              "items": [
                {
                  "text": "Tus 24:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LAM.4.21"
              },
              "items": [
                {
                  "text": "Malo 4:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Utandisekeleli nosinkondoma, nkaambo nekuba kuti nkawe, njoobuka lubo. Nekuba kuti nkale mumudima, Jehova ngumumuni wangu. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.8",
            "verseOrgIds": [
              "MIC.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalibombya kubukali bwa-Jehova, nkaambo ndamubisizya, mane akandikoswede makani akundicitila ciluleme. Uyoondinjizya mumumuni, nkabone bululami bwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.9",
            "verseOrgIds": [
              "MIC.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MIC 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo sinkondoma uyoocibona, abweeme buyoomuvumba. Oyo iwakali kundibuzya kuti, Uli kuli Jehova Leza wako? meso aangu ayoomubona, nkabela lino uyoolyataulwa mbuli itombe lyamumigwagwa.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.10",
            "verseOrgIds": [
              "MIC.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MIC 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.10",
            "verseOrgIds": [
              "MIC.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MIC 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyooba buzuba bwakuyaka malambo aako. Mubuzuba obo mulao uyootolwa kule. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.11",
            "verseOrgIds": [
              "MIC.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MIC 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubuzuba obo bayooza kulinduwe kuzwa ku-Aseri akuzwa kuminzi ya-Egepita, kuzwa ku-Egepita mane kusikila kumulonga, kuzwa kulwizi akusikila kulwizinyina, akuzwa kucilundu kusikila kucilundunyina. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.12",
            "verseOrgIds": [
              "MIC.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MIC 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele nyika iyooba matongo nkaambo kabantu bayo; njemicelo yancito zyabo.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.13",
            "verseOrgIds": [
              "MIC.7.13"
            ]
          }
        }
      ]
    },
