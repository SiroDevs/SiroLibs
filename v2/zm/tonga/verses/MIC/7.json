              "items": [
                {
                  "text": "Hos 9:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maawe! Ndaba mbuli ciindi nibamana kubweza micelo, mbuli tucelocelo tusyaala kumasaansa naacelwa. Taakwe cikungo cakulya. Taakwe inkuyu zisolosya moyo wangu nzyuuyanda. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.1",
            "verseOrgIds": [
              "MIC.7.1"
            ]
          }
        },
        {
