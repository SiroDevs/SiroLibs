              },
              "items": [
                {
                  "text": "Hab 1:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Muntu siluzyalo ulimaninide ansi. Taakwe uululeme akati kabantu, Boonse balalindila bulowa bwabantu. Boonse balavwima umwi aumwi mweenzinyina atukole. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.2",
            "verseOrgIds": [
              "MIC.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.4.18"
              },
              "items": [
                {
                  "text": "Hos 4:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.1.23"
              },
              "items": [
                {
                  "text": "Is 1:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Babamba maanza aabo kuti bacite bubi. Mwami sikubeteka ulakumbila cilumbyo, elyo muvubi ulamwaambila moyo wakwe neuyanda, nkabela balacicita antoomwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.3",
            "verseOrgIds": [
              "MIC.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MIC 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nekuba mubotu akati kabo uli mbuli ciyasabavwimi, ayooyo uululeme kwiinda beenzinyina uli mbuli lubaya lwamamvwa. Buzuba bwabalindi bako nibati umwe bulasika, Lino balajana mafwabi. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.4",
            "verseOrgIds": [
              "MIC.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MIC 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utasyomi mweenzinyoko, utabiki moyo wako kumuzwalani wako. Ayooyo ngokumbatana awe utamujalwidi mulomo wako. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.5",
            "verseOrgIds": [
              "MIC.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MIC 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.9.22+GEN.9.23+GEN.9.24"
              },
              "items": [
                {
                  "text": "Matl 9:22-24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.35+MAT.10.36"
              },
              "items": [
                {
                  "text": "Mt 10:35-36",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.53"
              },
              "items": [
                {
                  "text": "Lk 12:53",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo mwana mulombe ulasampaula wisi, amwana musimbi ulabukila cakulwisya banyina, amukamwana ulakazyanya abanyinazyala. Basiluzubo bamuntu mwini mbibayooba basinkondonyina.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.6",
            "verseOrgIds": [
              "MIC.7.6"
            ]
          }
        }
      ]
