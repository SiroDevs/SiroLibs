              },
              "items": [
                {
                  "text": "1 Kor 1:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela kuti Makani Mabotu ngitukambauka alivumbidwe, kumeso aabaabo bali mukusweeka nkwaavumbidwe, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.3",
            "verseOrgIds": [
              "2CO.4.3"
            ]
