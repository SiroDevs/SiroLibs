              "attrs": {
                "loc": "ISA.9.1"
              },
              "items": [
                {
                  "text": "Is 9:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Leza wakaamba kuti, Mumuni ulamunikila mudima, nkabela nguwenya Leza wakamunika mumyoyo yesu kukumunikila bantu akubazibya mbububede bulemu bwa-Leza buboneka mubusyu bwa-Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.6",
            "verseOrgIds": [
              "2CO.4.6"
            ]
          }
        }
