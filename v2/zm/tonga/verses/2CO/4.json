        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.6.14"
              },
              "items": [
                {
                  "text": "1 Kor 6:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tulizi kuti oyo iwakabusya Mwami Jesu ulatubusya aswebo antoomwe a-Jesu, alimwi ulatusitikizya antoomwe anywebo kubusyu bwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.14",
            "verseOrgIds": [
              "2CO.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 4:15"
          },
          "items": [
