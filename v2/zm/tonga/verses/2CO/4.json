              "type": "text"
            }
          ]
        },
        {
          "text": "Lino tulijisi mumyoyo yesu olo lusyomo ndulonya mbuli mbukulembedwe kuti, Ndakasyoma, nciceeci ncindakaambila, Aswebo tulasyoma, nkabela nciceeci ncitwaambila. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.13",
            "verseOrgIds": [
              "2CO.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 4:14"
          },
          "items": [
