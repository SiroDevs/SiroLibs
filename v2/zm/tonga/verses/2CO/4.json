              "items": [
                {
                  "text": "1 Kor 7:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kaako, mbuli mbutujisi eyi milimo niitwapegwa nkaambo kalweetelelo lwa-Leza, tatulengaani mumyoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.1",
            "verseOrgIds": [
              "2CO.4.1"
            ]
          }
        },
        {
