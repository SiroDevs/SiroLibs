          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.2.17"
              },
              "items": [
                {
                  "text": "2 Kor 2:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.2.5"
              },
              "items": [
                {
                  "text": "1 Tes 2:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tulisowede makani, aasisidwe aausya bweeme. Tatweendi cabupyungi pe, nikuba kubisizya lusinizyo lwamakani aa-Leza, anukuti tulaamba lusinizyo antangalala, aboobo tulalilubulula kumanjezeezya aabantu boonse kubusyu bwa-Leza. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.2",
            "verseOrgIds": [
              "2CO.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
