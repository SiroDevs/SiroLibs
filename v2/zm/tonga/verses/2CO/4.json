              },
              "items": [
                {
                  "text": "Kol 1:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nkaambo kulimbabo muzimu waansi ano waofwaazya meso aabaabo batazumina, kuti batapaswidwi mumuni wa-Makani Mabotu aabulemu bwa-Kristo, nguwe cinkozya caLeza. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.4",
            "verseOrgIds": [
              "2CO.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.1.24"
              },
              "items": [
                {
                  "text": "2 Kor 1:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo teensi makani aandiswe tubeni ngitukambauka, pe, tulakambauka kuti Jesu ngu-Mwami, alimwi swebo tuli bazike banu nkaambo ka-Jesu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.5",
            "verseOrgIds": [
              "2CO.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
