                  "text": "Inc 9:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino cintu eci ciyandisi tulicijisi munongo zyabulongo, kukutondezya kuti ezi inguzu zigambya zilazwa kuli-Leza, tazizwi kulindiswe tubeni pe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.7",
            "verseOrgIds": [
              "2CO.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 4:8"
          },
          "items": [
