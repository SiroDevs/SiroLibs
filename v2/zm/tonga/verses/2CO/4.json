              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.1.8"
              },
              "items": [
                {
                  "text": "2 Kor 1:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.7.5"
              },
              "items": [
                {
                  "text": "7:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lyoonse buyo tulilemedwe, nekubaboobo tatuna kumanikililwa. Tulizingidwe nekubaboobo tatuna kuzingisigwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.8",
            "verseOrgIds": [
              "2CO.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tulipenzedwe, nekubaboobo tatusiilidwe. Tuliwisizidwe ansi, nekubaboobo tatuna kulobelela. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.9",
            "verseOrgIds": [
              "2CO.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.15.31"
              },
              "items": [
                {
                  "text": "1 Kor 15:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lyoonse buyo tulatolelezya mumibili yesu kujayigwa kwa-Jesu, kuti buumi bwa-Jesu abwalo buboneke mumibili yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.10",
            "verseOrgIds": [
              "2CO.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.8.36"
              },
              "items": [
                {
                  "text": "Rom 8:36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo mazuba oonse nitucilanga tulaabwa kulufu nkaambo ka-Jesu, kuti buumi bwa-Jesu abwalo buboneke mumibili yesu iifwika. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.11",
            "verseOrgIds": [
              "2CO.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aboobo mulindiswe mulabeleka lufu, anukuti mulindinywe mulabeleka buumi.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.12",
            "verseOrgIds": [
              "2CO.4.12"
            ]
          }
        }
      ]
