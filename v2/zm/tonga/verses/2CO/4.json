              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.1.3+2CO.1.4+2CO.1.5+2CO.1.6"
              },
              "items": [
                {
                  "text": "2 Kor 1:3-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo makani oonse aba nkaambo kandinywe kuti mbuli mbuluvuzigwa luzyalo kubantu banji, kulumba akwalo kuvule mbubonya akuletela Leza bulemu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.15",
