          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luzyalo lwa-Mwami Jesu Kristo aluyando lwa-Leza aluswaanano lwa-Muuya Uusalala zibe anywe nyoonse.",
          "type": "text",
