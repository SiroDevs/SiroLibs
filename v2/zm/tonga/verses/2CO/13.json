            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.15.33"
              },
              "items": [
                {
                  "text": "Rom 15:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino bakwesu, ndamana. Kamusyaala kabotu. Amubambe kabotu buumi bwanu. Amupangike myoyo yanu kumajwi aangu. Amube amoyo omwe mukale caluumuno, nkabela Leza siluyando siluumuno ulakala anywe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.11",
            "verseOrgIds": [
              "2CO.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
