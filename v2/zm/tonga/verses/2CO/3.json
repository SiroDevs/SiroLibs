            "style": "v",
            "sid": "2CO 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele kusikila sunu kufumbwa ciindi ncibabala ibbuku lya-Musa, cilisitilizyo cilikede kumyoyo yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.15",
            "verseOrgIds": [
