          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo nicakaba abulemu eco cakati indilile, elyo cilainda kuba abulemu eci cibedelela.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.11",
