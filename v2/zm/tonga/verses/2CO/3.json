                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Myoyo yabo yakaliyumide, nkaambo nikuba kusikila sunu eco cilisitilizyo nciconya mpocicili kuciindi ncibabala ibbuku lya-Mulongo wakalekale, Tabayubunwidwi kuti cakaloba muli-Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.14",
            "verseOrgIds": [
              "2CO.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
