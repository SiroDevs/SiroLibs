                  "text": "Kul 34:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino eco icakajisi bulemu ciindi tacicijisi sunu, nkaambo kabulemu obu buinda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.10",
            "verseOrgIds": [
              "2CO.3.10"
            ]
          }
        },
