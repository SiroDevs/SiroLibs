        },
        {
          "text": "Nkaambo niyakaba abulemu milimo yakulimba bantu milandu, ncobeni milimo yakubalulamya ilainda loko kuba abulemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.9",
            "verseOrgIds": [
