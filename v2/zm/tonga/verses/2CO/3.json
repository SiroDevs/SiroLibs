                  "text": "35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tatuli mbuli Musa iwakabika cilisitilizyo kubusyu bwakwe, kuti bana ba-Israyeli batadunamine eco cakati indilile. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.13",
