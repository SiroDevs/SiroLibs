              },
              "items": [
                {
                  "text": "8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela wakabafwida boonse kuti abo bapona bataciliponene beni pele baponene oyo iwakabafwida akubuka.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.15",
            "verseOrgIds": [
              "2CO.5.15"
            ]
          }
        }
