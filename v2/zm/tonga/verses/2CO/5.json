                "loc": "2CO.3.1"
              },
              "items": [
                {
                  "text": "2 Kor 3:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tatuli mukuboola kulikankaizya kulindinywe, pe, tulamupa kaambo kakutulumbaizya, kuti muvwiizye abo balilumbaizya kumakani aaboneka kumeso buyo, aatali aamoyo, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.12",
            "verseOrgIds": [
              "2CO.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo na tulisondokede, nkikaambo kamakani aa-Leza, nanka tulyeenzene, nkikaambo kandinywe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.13",
            "verseOrgIds": [
              "2CO.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kuyanda Kristo nkokutusinikizya, ikuti tulabeteka obo, kuti omwe wakafwida boonse, aboobo boonse bakafwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.14",
            "verseOrgIds": [
              "2CO.5.14"
            ]
          }
        },
        {
