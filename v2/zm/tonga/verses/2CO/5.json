              },
              "items": [
                {
                  "text": "Int 39:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nciceeco ncitupangika moyo kuti tumukonde lyoonse, nanka nitucili mumubili nanka nitutamo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.9",
