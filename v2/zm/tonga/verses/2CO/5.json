                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela oyo uutubambila cintu eco ngu-Leza, nguwenya uutupa Muuya mbuli citondezyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.5",
            "verseOrgIds": [
