                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kaako tulasyoma lyoonse mumoyo, Tulizi kuti ciindi ncitucili mumubili tatuko ku-Mwami, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.6",
            "verseOrgIds": [
