        },
        {
          "text": "Lino tulizi mbukweelede kulemeka Mwami, aboobo tulakombelezya bantu. Kumeso aa-Leza tulabonwa kabotu mbutubede, nkabela ndasyoma kuti kumanjezeezya aanu aalo tulabonwa mbubonya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.11",
            "verseOrgIds": [
              "2CO.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
