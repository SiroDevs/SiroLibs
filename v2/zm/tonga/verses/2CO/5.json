                  "text": "Flp 1:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aboobo moyo wesu tuupengede, pele tulayandisya kupola kumubili akukala kuMwami, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.8",
