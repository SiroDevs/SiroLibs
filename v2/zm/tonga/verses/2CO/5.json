                "loc": "1CO.15.53"
              },
              "items": [
                {
                  "text": "1 Kor 15:53",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo swebo nitucili omuno mucilao cesu tulalisinsimukila cakulemenwa. Teensi kwaamba kuti tulayanda kusamununwa, pe, pele tulayanda kusamikwa ajulu, kuti cifwisi cimenenenwe kubuumi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.4",
            "verseOrgIds": [
              "2CO.5.4"
            ]
          }
        },
        {
