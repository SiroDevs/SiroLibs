                  "text": "1 Kor 13:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo nkulusyomo nkutweenda, takweensi kukubona pe, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.7",
            "verseOrgIds": [
