        },
        {
          "text": "Nkaambo tulizi kuti, caakumwaika cilao cesu ncitukala ansi ano, tulijisi buyaki buzwa kwa-Leza, ŋanda iitacitwi amaanza aabantu, iitamani, iili kujulu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.1",
            "verseOrgIds": [
              "2CO.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
