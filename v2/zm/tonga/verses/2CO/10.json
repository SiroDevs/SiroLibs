              "attrs": {
                "loc": "GAL.5.2"
              },
              "items": [
                {
                  "text": "Gal 5:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino ndamukumbila mebo ndemwini kululyeetezyo akulitontozyo lwa-Kristo. Ndime Paulo, oyo uubombede kubusyu bwanu ciindi ncendiwo pele ndaamba kaanzambwene ciindi ncentawo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.1",
            "verseOrgIds": [
              "2CO.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.4.21"
              },
              "items": [
                {
                  "text": "1 Kor 4:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndakumbila kuti nindasika kulindinywe nsikooyoosika cakwaamba kaanzambwene acabukali obo mbundasyoma kubakalalila bamwi bantu. Aba bantu mbibayeeya kuti ziyanza zyesu nzitweenda azyo nzyaansi buyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.2",
            "verseOrgIds": [
              "2CO.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele nikuba kuti tweenda ansi, kulwa kwesu takweensi kwaansi pe, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.3",
            "verseOrgIds": [
              "2CO.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.6.13+EPH.6.14+EPH.6.15+EPH.6.16+EPH.6.17"
              },
              "items": [
                {
                  "text": "Ef 6:13-17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nkaambo zintu zyesu zyakulwisya tazyeensi zyabantu buyo, nzyanguzu zya-Leza zyakumwaisya mampangala mayumu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.4",
            "verseOrgIds": [
              "2CO.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tulamwaisya miyeeyo yoonse azintu zyoonse zili buti zilisumpula cakulwisya luzibo lwa-Leza, alimwi tulaanga makanze oonse kuti aswiilile Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.5",
            "verseOrgIds": [
              "2CO.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.2.9"
              },
              "items": [
                {
                  "text": "2 Kor 2:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Twalibamba kukubeteka muntu umwi aumwi uutaswiilili ciindi ncikuyoolondoka kuswiilila kwanu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.6",
            "verseOrgIds": [
              "2CO.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.6",
            "verseOrgIds": [
              "2CO.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino amulange aya makani aaboneka kumeso aanu. Na muntu ulayeeya kuti, Mebo ndi muntu wa-Kristo, oyo muntu aibaluke makani aya aalo, aakuti mbuli mbwali muntu wa-Kristo walo, tuli bantu ba-Kristo aswebo mbubonya, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.7",
            "verseOrgIds": [
              "2CO.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.12.6"
              },
              "items": [
                {
                  "text": "2 Kor 12:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.5.4"
              },
              "items": [
                {
                  "text": "1 Kor 5:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.5.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nikuba kuti tulainda kulikankaizizya bwami bwesu mbutwapegwa ku-Mwami (obu bwami mbwakuyaka, takweensi bwakumwaya pe), nsikooyoofwa bweeme pe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.8",
            "verseOrgIds": [
              "2CO.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele nsiyandi kuba mbuli sikumutizizya magwalo pe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.9",
            "verseOrgIds": [
              "2CO.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaamba kuti, Magwalo aakwe alijisi bulemu anguzu, pele naaboneka kumeso, ulikompeme buyo, alimwi kwaamba kwakwe nkusampusi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.10",
            "verseOrgIds": [
              "2CO.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.13.2"
              },
              "items": [
                {
                  "text": "2 Kor 13:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.13.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele muntu uuamba boobo azibe eci, kuti mbuli mbutubede kumajwi aamumagwalo esu ciindi ncetutawo, mbubonya obo mbutuzooba kumilimo yesu ciindi ncetuliwo.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.11",
            "verseOrgIds": [
              "2CO.10.11"
            ]
          }
        }
      ]
    },
