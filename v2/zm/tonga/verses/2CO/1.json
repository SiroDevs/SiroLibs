                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndime Paulo, nendakasungulwa abukanze bwa-Leza kuba apostolo waJesu Kristo, tuli a-Timoteo mukwesu. Ndamujuzya nywebo nombungano­ ya-Leza iili mu-Korinto antoomwe abasalali boonse bali mucisi coonse caku-Akaya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.1",
            "verseOrgIds": [
              "2CO.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
