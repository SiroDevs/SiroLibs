            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.1.7"
              },
              "items": [
                {
                  "text": "Rom 1:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amube aluzyalo aluumuno kuzwa kwa-Leza Taateesu aku-Mwami Jesu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.2",
            "verseOrgIds": [
              "2CO.1.2"
            ]
          }
        }
