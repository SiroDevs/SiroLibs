              },
              "items": [
                {
                  "text": "1 Pet 1:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alumbwe Leza Wisi wa-Mwami wesu Jesu Kristo, Taateesu siluzyalo, Leza siluumbulizyo loonse. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.3",
            "verseOrgIds": [
              "2CO.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nguwe uutuumbulizya mumapenzi esu oonse, kuti tukakonzye kuumbulizya boonse bapengede kuluumbulizyo olo ndulonya ndutuumbulizizigwa tubeni kuli-Leza, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.4",
            "verseOrgIds": [
              "2CO.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.34.19"
              },
              "items": [
                {
                  "text": "Int 34:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.94.19"
              },
              "items": [
                {
                  "text": "94:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo mbuli maciswe­ aa-Kristo mbwaatuvulila, alwalo luumbulizyo lwesu lulavula muliKristo mbubonya, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.5",
            "verseOrgIds": [
              "2CO.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.4.15"
              },
              "items": [
                {
                  "text": "2 Kor 4:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.4.17"
              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela na tulipengede, nkikaambo kaluumbulizyo lwanu alufutuko lwanu, nanka tuliumbulizizidwe, nkikaambo kaluumbulizyo lwanu lumupa camba cakukakatila mukati kamapenzi ayo ngaonya ngitupengela aswebo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.6",
            "verseOrgIds": [
              "2CO.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aboobo, lusyomo lwangu lwakulindinywe lulijisi, nkaambo ndizi kuti mbuli mbumwaabilana ambebo maciswe, tulaabilana luumbulizyo alwalo mbubonya.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.7",
            "verseOrgIds": [
              "2CO.1.7"
            ]
          }
        }
      ]
    },
