                  "text": "Inc 19:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo nsiyandi kuti mutazibi, bakwesu, aamapenzi esu ngitwakajana mu-Asiya, Twakalemenwa loko, inguzu zyesu zyakati gole, nkabela twakaliswawide nibuba buumi bwesu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.8",
            "verseOrgIds": [
              "2CO.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ncobeni mumyoyo yesu twakali kuyeeya kuti ncikosolo calufu. Pele akaba boobo, kuti tutalisyomi tubeni, tusyome Leza sikubusya bafu, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.9",
            "verseOrgIds": [
              "2CO.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.4.18"
              },
              "items": [
                {
                  "text": "2 Tim 4:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Walo wakatuvuna kulufu lupati luli boobo, alimwi ucituvuna sunu, nkabela lusyomo lwesu luli kulinguwe kuti uciyootuvuna. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.10",
            "verseOrgIds": [
              "2CO.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anywebo muleelede kutugwasya ankombyo zyanu, kuti bantu banji batulumbile Leza nkaambo kacaabilo caluzyalo ncitwakaabilwa nkaambo kabantu banji.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.11",
            "verseOrgIds": [
              "2CO.1.11"
            ]
          }
        }
      ]
