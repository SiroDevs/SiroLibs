                  "text": "Kol 1:26-27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nkabela ncobeni nimubala mulakonzya kubona luzibo ndunjisi lwakumvwisya makani aasisidwe aa-Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.4",
            "verseOrgIds": [
