                "loc": "MAT.5.11"
              },
              "items": [
                {
                  "text": "Mt 5:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.24.9"
              },
              "items": [
                {
                  "text": "24:9",
