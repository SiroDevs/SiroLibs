              "items": [
                {
                  "text": "Joh 13:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.6.39"
              },
              "items": [
                {
                  "text": "6:39",
