            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.5.18"
              },
              "items": [
                {
                  "text": "1 Joh 5:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.13"
              },
              "items": [
                {
                  "text": "Mt 6:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.22.32"
              },
              "items": [
                {
                  "text": "Lk 22:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nsikumbili kuti ubagwisye munyika, pele kuti ubavune kulooyo mubi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.15",
            "verseOrgIds": [
              "JHN.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tabali banyika mbuli mbwentali wenyika amebo, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.16",
            "verseOrgIds": [
              "JHN.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.6.63"
              },
              "items": [
                {
                  "text": "Joh 6:63",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ubasalazye abwini bwako, ijwi lyako mbobwini, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.17",
            "verseOrgIds": [
              "JHN.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.20.21"
              },
              "items": [
                {
                  "text": "Joh 20:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbuli mbookandituma munyika, amebo ndakabatuma munyika mbubonya. ",
          "type": "text",
