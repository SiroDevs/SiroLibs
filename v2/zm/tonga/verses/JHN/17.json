              },
              "items": [
                {
                  "text": "Flp 2:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eno Taata, kondilemya antoomwe ayebo abulemu obo mbwendakali kujisi nkencili ayebo, inyika kiitanaanzwa, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.5",
            "verseOrgIds": [
              "JHN.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.17.9"
              },
              "items": [
                {
                  "text": "Joh 17:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.9"
              },
              "items": [
                {
                  "text": "Mt 6:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndakazibya zina lyako kubantu mbookandipa abali ansi, Bakali bako, nkabela wabapa ndime, abalo babamba ijwi lyako. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.6",
            "verseOrgIds": [
              "JHN.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno balizi kuti zyoonse nzookandipa zizwa kulinduwe, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.7",
            "verseOrgIds": [
              "JHN.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.16.30"
              },
              "items": [
                {
                  "text": "Joh 16:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nkaambo majwi ngookandipa ndakaapa mbabo. Bakaatambula, bakazibisya kuti nkasimpe ndakazwa kulinduwe, bakasyoma kuti nduwe owakandituma, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.8",
            "verseOrgIds": [
              "JHN.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.6.37"
              },
              "items": [
                {
                  "text": "Joh 6:37",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.6.44"
              },
              "items": [
                {
                  "text": "44",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndabakombela, nsikombeli nyika pele balo mbookandipa, nkaambo mbabako. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.9",
            "verseOrgIds": [
              "JHN.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.16.15"
              },
              "items": [
                {
                  "text": "Joh 16:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.15.31"
              },
              "items": [
                {
                  "text": "Lk 15:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Zyoonse zyangu nzizyako, ezyako nzizyangu amebo ndalemezegwa mulimbabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.10",
            "verseOrgIds": [
              "JHN.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.10.30"
              },
              "items": [
                {
                  "text": "Joh 10:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.13"
              },
              "items": [
                {
                  "text": "Mt 6:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nsicinoolimo limbi munyika, pele aba bacili munyika, mebo ndiza kulinduwe. Taata Oosalala, babambe muzina lyako abo mboondipede, kuti babe bamwi, mbuli mbotubede aswebo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.11",
            "verseOrgIds": [
              "JHN.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 17:12"
          },
          "items": [
