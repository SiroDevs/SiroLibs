                "loc": "2TH.2.3"
              },
              "items": [
                {
                  "text": "2 Tes 2:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nendacili ambabo, ndali kubabamba muzina lyako ndookandipa, Ndali kubatabilila, eno taakwe omwe wabo uusweekede pele mwana uuingaila walo, kuti Magwalo azyulile, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.12",
            "verseOrgIds": [
              "JHN.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.11"
              },
              "items": [
                {
                  "text": "Joh 15:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele eno ndiza kulinduwe, alimwi makani aya ndaamba ansi, kuti babe akukondwa kwangu ukuzyulide mulimbabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.13",
            "verseOrgIds": [
              "JHN.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.19"
              },
              "items": [
                {
                  "text": "Joh 15:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndakabapa ijwi lyako, pele inyika yakabasula, nkaambo tabali banyika, mbuli mbwentali wenyika amebo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.14",
            "verseOrgIds": [
              "JHN.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 17:15"
          },
          "items": [
