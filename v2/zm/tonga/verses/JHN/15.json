        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.15.13"
              },
              "items": [
                {
                  "text": "Mt 15:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mitabi yoonse yangu iitazyali micelo wiitema, ayalo mitabi yoonse iizyala micelo wiikokweda kuti izyalisye micelo, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.2",
            "verseOrgIds": [
              "JHN.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno nywebo mulikokwedwe kale nkaambo kejwi ndendamwaambila. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.3",
            "verseOrgIds": [
              "JHN.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amukalilile mulindime, amebo mulindinywe. Mbubonya mutabi mbuutakonzya kuzyala micelo wini watanooli kucisiko, anywebo mbubonya tamukonzya, mwatakalilila mulindime. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.4",
            "verseOrgIds": [
              "JHN.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.12.12"
              },
              "items": [
                {
                  "text": "1 Kor 12:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.12.27"
              },
              "items": [
                {
                  "text": "27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.3.5"
              },
              "items": [
                {
                  "text": "2 Kor 3:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndime cisiko, nywebo muli mitabi. Uukalilila mulindime, amebo mulinguwe, walo ulazyala micelo minjiminji, nkaambo mwaanzaana amebo tamukonzya kucita cintu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.5",
            "verseOrgIds": [
              "JHN.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.3.10"
              },
              "items": [
                {
                  "text": "Mt 3:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.13.40"
              },
              "items": [
                {
                  "text": "13:40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na muntu takalilili mulindime, wasoogwa mbuli mutabi, wayuminina. Eno bantu biitebba, akwiisowela mumulilo, nkabela yatentwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.6",
            "verseOrgIds": [
              "JHN.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.11.24"
              },
              "items": [
                {
                  "text": "Mk 11:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwanookalilila mulindime, aalo majwi aangu anookalilila mulindinywe, mwaakukumbila kufumbwa cintu ncomuyanda, ciyooba mpawo, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.7",
            "verseOrgIds": [
              "JHN.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.16"
              },
              "items": [
                {
                  "text": "Mt 5:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Taata ulalemezegwa, mwazyala micelo minjiminji, ncomunooli basikwiiya bangu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.8",
            "verseOrgIds": [
              "JHN.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbubonya Taata mbwandiyanda, anywebo ndamuyanda mbubonya, kamukalilila muluyando lwangu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.9",
            "verseOrgIds": [
              "JHN.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.8.29"
              },
              "items": [
                {
                  "text": "Joh 8:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.14.15"
              },
              "items": [
                {
                  "text": "14:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.2.4"
              },
              "items": [
                {
                  "text": "1 Joh 2:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.2.8"
              },
              "items": [
                {
                  "text": "8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwanoobamba milao yangu, munookalilila muluyando lwangu, mbubonya mbwembamba milao ya-Taata, akukalilila muluyando lwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.10",
            "verseOrgIds": [
              "JHN.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.17.13"
              },
              "items": [
                {
                  "text": "Joh 17:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndamwaambila makani aya, kuti kubotelwa kwangu kube kulindinywe, akwalo kuti kubotelwa kwanu kukazyulile, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.11",
            "verseOrgIds": [
              "JHN.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.13.34"
              },
              "items": [
                {
                  "text": "Joh 13:34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.17"
              },
              "items": [
                {
                  "text": "15:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.3.11"
