                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndime cisiko cini camusaansa, Taata ngomukamwini muunda, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.1",
            "verseOrgIds": [
              "JHN.15.1"
            ]
