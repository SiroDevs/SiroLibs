          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "TEKELE cipimo, ekutila namupimwa no kusangwa uwapepuka. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.27",
            "verseOrgIds": [
              "DAN.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
