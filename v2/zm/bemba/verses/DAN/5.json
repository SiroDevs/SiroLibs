          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "PARISINI ciputulwa, ekutila ubufumu bwenu nabwakanika nabupeelwa ku bena Media na bena Pesia.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.28",
            "verseOrgIds": [
