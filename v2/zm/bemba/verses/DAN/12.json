                "loc": "REV.12.7"
              },
              "items": [
                {
                  "text": "12:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“We Daniele, pali iyo nshita akafika kateeka mukalamba uwitwa Mikaeli uulinda abantu bobe. Kukaba inshita yabulanda ubwabipisha ubushabala abumoneka ukufumafye apo imishobo ya bantu yatendekele ukubapo. Ni muli iyi nshita emo abantu bobe bonse abo amashina yabo yalembwa mu citabo cakwa Lesa bakapusuka. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.1",
            "verseOrgIds": [
              "DAN.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.26.19"
              },
              "items": [
                {
                  "text": "Esaya 26:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.25.46"
              },
              "items": [
                {
                  "text": "Mateo 25:46",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.5.29"
              },
              "items": [
                {
                  "text": "Yoani 5:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Cinkupiti wa bantu pali balya abalala utwamfwa bakashukuka. Bamo ku mweo wamuyayaya, bambi ni kukuba ne nsoni pamo no kusekwa umuyayaya. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.2",
            "verseOrgIds": [
              "DAN.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo abamano bakalabengeshima ngo lubuuto lwa mu mulu, na balya abafundile abantu ukucita ifyabulungami bakalabeka nge ntanda. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.3",
            "verseOrgIds": [
              "DAN.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.10"
              },
              "items": [
                {
                  "text": "Ubuso 22:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nomba we Daniele isala no kukakatika icitabo icipombwa ukufika ku nshita ilintu ifintu fikapwilapo. Abantu abengi bakasabanta uku noku, na mano yakafulilako.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.4",
            "verseOrgIds": [
              "DAN.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.4",
            "verseOrgIds": [
              "DAN.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo ne Daniele namwene abantu babili nabeminina umo ku bushilya bwa mumana na umbi ku bushilya bubiye. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.5",
            "verseOrgIds": [
              "DAN.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo umuntu uwaiminine akatalamukila abilikisha uwafwele insalu ishatelela uwali ku mulu wa mumana ati, “Bushe ni nshita nshi ikapitapo pakuti ifi fintu ifyakupapa fikafikilishiwe?”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.6",
            "verseOrgIds": [
              "DAN.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
