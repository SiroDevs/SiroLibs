              },
              "items": [
                {
                  "text": "Mako 13:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Ukufuma pa nshita amalambo yakaleshiwa ukupeelwa ilyo icabunani icilenga ubonaushi cikemikwa, pakapita inshiku ikana limo ne myanda ibili na makumi pabula (1,290). ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.11",
            "verseOrgIds": [
              "DAN.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balishuka abantu abakashipikisha inshiku ikana limo ne myanda itatu na makumi yatatu na shisano (1,335). ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.12",
            "verseOrgIds": [
              "DAN.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo iwe Daniele kabiye. Ukafwa, lelo ukashukuka pakuti ukapoke cilambu cobe ilintu ikafika inshita iyo ifintu fikapwilapo.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.13",
            "verseOrgIds": [
              "DAN.12.13"
            ]
          }
        }
      ]
