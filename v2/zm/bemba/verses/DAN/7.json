          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Pa mulandu wa cinama cabune atile, ‘Caimininako ubufumu bwabune ubukamoneka pesonde, bukapusana ku bufumu bumbi bonse, bukonaula isonde lyonse ukupitila mukulinyantaula pamo no kulishonaula. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.23",
            "verseOrgIds": [
              "DAN.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.17.12"
              },
              "items": [
                {
                  "text": "Ubuso 17:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Insengo ikumi limo shaimininako imfumu ikumi limo ishikema muli ubu bufumu, panuma yaisho akalusengo akanono kaleimininako imfumu imbi iikapusanako kuli ishi ishantashi. Yena ikacimfyapo imfumu shitatu, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.24",
            "verseOrgIds": [
              "DAN.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.12.7"
              },
              "items": [
                {
                  "text": "Dan 12:7",
