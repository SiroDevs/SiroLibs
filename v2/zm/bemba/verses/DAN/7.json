            }
          ]
        },
        {
          "text": "Abamushilo bakwa Lesa uwapulamo ebakapeelwa ubufumu kabili ebakalateeka pe na pe.’",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.18",
            "verseOrgIds": [
              "DAN.7.18"
            ]
          }
        }
      ]
    },
    {
