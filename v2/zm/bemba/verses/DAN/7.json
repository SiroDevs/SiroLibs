              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.20.4"
              },
              "items": [
                {
                  "text": "Ubuso 20:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.5"
              },
              "items": [
                {
                  "text": "22:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo ubuteeko, amaka pamo no bucindami pano isonde fikapeelwa ku bamushilo, abantu ba Wapulamo. Ubufumu bwakwe bukaba ubwamuyayaya, kabili bakateeka bonse bakamupepa no kumunakila.’",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.27",
            "verseOrgIds": [
              "DAN.7.27"
            ]
          }
        }
      ]
