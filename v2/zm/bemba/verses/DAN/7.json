                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.5+REV.13.6"
              },
              "items": [
                {
                  "text": "13:5-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "no kupontela Uwapulamo pamo no kucusha abamushilo bakwe pakuti ikapilibule inshita ishaimikwa. Ikanyantaula abamushilo pa mwaka umo, ne myaka ibili na umbi pakati.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.25",
            "verseOrgIds": [
              "DAN.7.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "7:25",
              "type": "text"
            },
            {
              "text": "Umwaka:",
              "type": "text"
            },
            {
              "text": "Ba Baibele bamo batila, “inshita imo, inshita shibili na citika wa nshita.”",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.25",
            "verseOrgIds": [
              "DAN.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo ilintu icilye cikekala, kukaba ukupoka iyi mfumu amaka, efyo ikonaulwa umupwilapo. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.26",
            "verseOrgIds": [
              "DAN.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 7:27"
          },
          "items": [
