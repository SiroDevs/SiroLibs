                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.1"
              },
              "items": [
                {
                  "text": "13:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Panuma ya ifi, mu cimonwa candi namwene icinama icabune, cali icakusungusha no kutiinya, kabili cali icamaka nganshi. Cakwete ameno ya cela ayakulu ayo caleshetelako no kushonaula ifilyo, na ku makasa yaciko calenyantaula ifyashala. Cali icapusana ku finama ifi fitatu, kabili cakwete insengo ikumi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.7",
            "verseOrgIds": [
              "DAN.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.5+REV.13.6"
              },
              "items": [
                {
                  "text": "Ubuso 13:5-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ilintu ncili ndelolesha no kutontonkanya pa nsengo, kwamoneka akalusengo na kambi akanono katutumuka pakati ka nsengo ikumi. Panukulwa insengo shitatu apamenene akalusengo akanono. Aka kalusengo kali na menso ayapalana na menso ya muntu kabili kalikwete akanwa akalelanda ifyamataki.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.8",
            "verseOrgIds": [
              "DAN.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.10",
            "verseOrgIds": [
              "DAN.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ilintu natwalilile ukulolesha, mona ninshi aka kalusengo kacili kalelanda ifyamataki. Ici cinama calipaiwe, no mubili waciko waposelwe mu mulilo uwaleaka. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.11",
            "verseOrgIds": [
              "DAN.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifinama fimbi fyalipokelwe amaka no kusuminishiwa ukuba no mweo pa nshita iyalinga.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.12",
            "verseOrgIds": [
              "DAN.7.12"
            ]
          }
        }
      ]
    },
