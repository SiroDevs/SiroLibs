              "items": [
                {
                  "text": "Mako 4:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.8.16"
              },
              "items": [
                {
                  "text": "Luka 8:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Tapaba nangu umo uusanika icisaniko, kabili acibika ukwafisama, nangu acikupikila mu nongo. Lelo bacibika apasansama, pakuti abantu baleingila umwabuuta. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.33",
            "verseOrgIds": [
              "LUK.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icisaniko ca mubili obe, linso. Amenso yobe nga yatuntulu, ninshi umubili obe onse uli mu lubuuto. Lelo amenso yobe nga yalwele, ninshi umubili obe onse uli mu mfifi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.34",
            "verseOrgIds": [
              "LUK.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi ulemona ukuti ulubuuto lobe lwiyaluka imfifi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.35",
            "verseOrgIds": [
              "LUK.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi umubili obe onse nga uli mu lubuuto, tamuli mfifi nelyo panono. Awe ninshi lyena uli mu lubuuto lweka lweka, kwati ni filya ulubuuto lwa cisaniko nga lwakusanikila.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.36",
            "verseOrgIds": [
              "LUK.11.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.36",
            "verseOrgIds": [
              "LUK.11.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cilya Yesu alekafye ukulanda, Umufalise umo amwitile ukuti aye lya kumwakwe. Awe Yesu aingila, aikala, balalya no kulya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.37",
            "verseOrgIds": [
              "LUK.11.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 11:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.7.3+MRK.7.4"
              },
              "items": [
                {
                  "text": "Mako 7:3-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Umufalise asunguka pakumona ukuti, Yesu alalya ukwabula ukuti abalilepo ukusamba iminwe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.38",
            "verseOrgIds": [
              "LUK.11.38"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "11:38",
              "type": "text"
            },
            {
              "text": "Ukulingana nefyo Abafalise basumine mu mafunde yakwa Mose, umuntu uwamushilo ali nokusamba ku minwe mu musango uwasuminishiwa lintu talatendeka ukulya. Ici tacali pa mulandu wabusaka, lelo ni pa mulandu wakusunga intambi.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.38",
            "verseOrgIds": [
              "LUK.11.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomba Imfumu yamweba aiti, “Imwe, mwe Bafalise, muwamya inkombo ne mbale kunse, lelo mu mitima yenu mwaisula ubulili no bukakashi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.39",
            "verseOrgIds": [
              "LUK.11.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwe fipumbu mwe, bushe uwabumbile kunse tewabumbile na mukati mwine? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.40",
            "verseOrgIds": [
              "LUK.11.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 11:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala mulekumbusukako abalanda pafyo mwakwata, lyena na fyonse fyakulaba ifyakaele.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.41",
            "verseOrgIds": [
              "LUK.11.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
