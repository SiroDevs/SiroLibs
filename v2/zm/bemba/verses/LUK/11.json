            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.9.1+2CH.9.2+2CH.9.3+2CH.9.4+2CH.9.5+2CH.9.6+2CH.9.7+2CH.9.8+2CH.9.9+2CH.9.10+2CH.9.11+2CH.9.12"
              },
              "items": [
                {
                  "text": "2 Imila 9:1-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pa bushiku bwabupingushi, namfumu wa ku Sheba akemina abantu ba ino nkulo no kubapeela umulandu. Pantu wena afumine ku mpela ya calo, kukwisa umfwa amano yakwa Solomoni. Nomba pano palipo uwacila Solomoni! ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.31",
            "verseOrgIds": [
              "LUK.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa bushiku bwabupingushi, abena Ninife bakemina abantu ba ino nkulo no kubapeela umulandu. Pantu bena balilapile no kupilibuka ilyo Yona abilile imbila kumwabo. Nomba pano palipo uwacila Yona!",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.32",
            "verseOrgIds": [
              "LUK.11.32"
            ]
          }
        }
      ]
