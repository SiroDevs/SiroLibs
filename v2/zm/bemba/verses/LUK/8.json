              "type": "text"
            }
          ]
        },
        {
          "text": "Awe no bumi bwabwela, aima apopene. Yesu epakubeba ukuti bamupeeleko icakulya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.55",
