              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo ilyo umwana wenu uyu abwela, panuma yakonaula ifyuma fyenu kuli bacilende, wena mwamwipaila iciponti ca ŋombe icaina.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.30",
            "verseOrgIds": [
              "LUK.15.30"
            ]
          }
        },
        {
          "name": "verse",
