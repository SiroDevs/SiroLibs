          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.21",
            "verseOrgIds": [
              "1SA.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo Samwele ayaswike ati,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.22",
            "verseOrgIds": [
              "1SA.15.22"
            ]
          }
        }
