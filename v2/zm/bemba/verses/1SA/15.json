          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.31",
            "verseOrgIds": [
              "1SA.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1SA 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Samwele atile, “Muleteni kuno Agagi imfumu ya bena Amaleki.” Agagi aile kuli ena alesubila ukuti nalimo ubutanshi bwa mfwa bwalipita. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.32",
            "verseOrgIds": [
              "1SA.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1SA 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo Samwele atile, “Ifyo ulupanga lobe lwalenga abanakashi ukube iŋumba, efyo na noko ali nokuba iŋumba pakati ka banakashi.” Kabili Samwele aipeye Agagi pa cinso cakwa Yawe ku Giligali.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.33",
            "verseOrgIds": [
              "1SA.15.33"
            ]
          }
        }
      ]
    },
