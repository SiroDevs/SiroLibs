        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.33",
            "verseOrgIds": [
              "1SA.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1SA 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Samwele aile ku Rama, lelo Saulo ena aya ku ŋanda yakwe ku Gibea umshi wakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.34",
            "verseOrgIds": [
              "1SA.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1SA 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukufikafye na pa bushiku Samwele afwililepo, tatalile amonanapo na Saulo, lelo Samwele aiketwe no bulanda ubukalamba pali Saulo. Nomba Yawe alilangulwike pakubika Saulo pa bufumu bwa bena Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.35",
