          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishina lya mukashi wakwa Saulo lyali ni Ainoamu umwana mwanakashi wakwa Aimasi. Ishina lya mukalamba wa fita fyakwe lyali ni Abune umwana mwaume wakwa Neri, uwali nalume wakwa Saulo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.50",
            "verseOrgIds": [
              "1SA.14.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
