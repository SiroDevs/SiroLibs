                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.12.16"
              },
              "items": [
                {
                  "text": "Amaf 12:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.12.23"
              },
              "items": [
                {
                  "text": "23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.15.23"
              },
              "items": [
                {
                  "text": "15:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo baebele Saulo abati, “Mona abantu balebifya kuli Yawe pakulya inama iyili no mulopa.” Abaswike ati, “Namulufya icisumino. Kunkulusheni icilibwe pano nombaline.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.33",
            "verseOrgIds": [
              "1SA.14.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1SA 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo epakubeba ati, “Salanganeni mu bantu no kubeba amuti, ‘Cila umo alete iŋombe nangu impaanga yakwe no kwisa yipaila pano pene epo alile, pakuti mwibifya kuli Yawe mukulalya inama iyicilimo no mulopa mukati kaiko.’” Kanshi ifita epakuleta iŋombe ishilima mu cungulo cine cilya no kushipaila kulya kwine. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.34",
            "verseOrgIds": [
              "1SA.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1SA 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Saulo akuulile ubulambo bwakwa Yawe. E bulambo bwantanshi ubo akuulile Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.35",
            "verseOrgIds": [
              "1SA.14.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1SA 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.35",
            "verseOrgIds": [
              "1SA.14.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1SA 14:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo atile, “Natuleya tutentemuke tukonke Abafilisiti mu nshita ya bushiku no kubatapa mpaka ulucelo, kabili peshala nelyo umo umumi.” Nabo batile, “Citeni conse icilemoneka icisuma mu menso yenu.” Lelo shimapepo atile, “Natubale twipushe Lesa kuno kwine.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.36",
            "verseOrgIds": [
              "1SA.14.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1SA 14:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi Saulo aipwishe Lesa ati, “Bushe kuti natentemuka nakonka Abafilisiti? Bushe mulebapeela mu minwe yakwa Israeli?” Lelo Lesa tamwaswike pali bulya bushiku iyoo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.37",
            "verseOrgIds": [
              "1SA.14.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1SA 14:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo epakulanda ati, “Iseni kuno bonse imwe mwe ntungulushi sha fita pakuti tufwailishe ububifi tucitile mu bushiku bwa lelo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.38",
            "verseOrgIds": [
              "1SA.14.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1SA 14:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu cishinkafye cakwa Yawe uwamweo uupususha imyeo ya bena Israeli, nangufye cileba ukuti umwana wandi umwaume Yonatani, afwile ukufwa.” Lelo tapali umuntu nangu umo uwasoselepo ishiwi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.39",
            "verseOrgIds": [
              "1SA.14.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1SA 14:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo elyo aebele bonse abena Israeli ati, “Imwe, mwalaiminina ulubali lumo, elyo ine na Yonatani umwana wandi umwaume twalaiminina ulubali lumbi.” Elyo abantu bamwasuka ati, “Citeni conse icilemoneka icisuma mu menso yenu.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.40",
            "verseOrgIds": [
              "1SA.14.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1SA 14:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Saulo apepele kuli Yawe Lesa wakwa Israeli ati, “Mpeeleni ubwasuko ubusuma.” Kabili Yonatani na Saulo babacitile ulubuko, lelo abantu bali abakaele. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.41",
            "verseOrgIds": [
              "1SA.14.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1SA 14:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo atile, “Penduleni pakati ka ine elyo no mwana wandi umwaume Yonatani.” Awe cawilile Yonatani. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.42",
            "verseOrgIds": [
              "1SA.14.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1SA 14:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Saulo atile kuli Yonatani, “Njebako ico ucitile.” Elyo Yonatani amwebele ati, “Nacisondakofye utubuci tunono ku mpela ya nkonto yandi, eico kanshi nomba mfwilefye ukufwa.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.43",
            "verseOrgIds": [
              "1SA.14.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1SA 14:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo atile, “Lesa nankandefye ine wine no kulundapo nga cakuti iwe Yonatani taufwile.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.44",
            "verseOrgIds": [
              "1SA.14.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1SA 14:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.44",
            "verseOrgIds": [
              "1SA.14.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1SA 14:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo abantu batile kuli Saulo, “Bushe Yonatani kuti afwa, uulengele Israeli ukucimfya apakalamba ifi? Awe, ifyo tefyo! Mu cishinkafye cakwa Yawe uwamweo, takuli mushishi wa ku mutwe wakwe uuleponena panshi, pantu abombele uyu mulimo ilelo mukwafwiwa na Lesa.” Kanshi abantu bapuswishe Yonatani kabili tabamwipeye iyoo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.45",
            "verseOrgIds": [
              "1SA.14.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1SA 14:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Saulo alekele no ukusupila Abafilisiti, kabili Abafilisiti balekele ubulwi no kubwelelamo ku calo cabo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.46",
            "verseOrgIds": [
              "1SA.14.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1SA 14:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.46",
            "verseOrgIds": [
              "1SA.14.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1SA 14:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panuma lintu Saulo ayambile ukuteeka Israeli, alwishishe abalwani bakwe mu mbali shonse, abena Moabu, abena Amoni abena Edomu, ishamfumu sha ku Soba elyo na Bafilisiti. Konsefye uko ayalukile alecimfya. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.47",
            "verseOrgIds": [
              "1SA.14.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1SA 14:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alwishishe no bulamba no kucimfya abena Amaleki, elyo afumishe abena Israeli mu minwe ya abo abalebatapa ifyuma.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.48",
            "verseOrgIds": [
              "1SA.14.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1SA 14:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.48",
            "verseOrgIds": [
              "1SA.14.48"
            ]
          }
        },
        {
