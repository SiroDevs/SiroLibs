            "sid": "1SA 14:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wishi wakwa Saulo ali ni Kishi. Elyo wishi wakwa Abune ni Neri uwali umwana mwaume wakwa Abieli.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.51",
