              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana abaume abakwa Saulo bali ni Yonatani, Ishifi elyo na Malikishua. Ishina lya mwana wakwe umwanakashi umukalamba lyali ni Merabu ne shina lya mwaice lyali ni Mikali. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.49",
            "verseOrgIds": [
              "1SA.14.49"
            ]
          }
        },
        {
          "name": "verse",
