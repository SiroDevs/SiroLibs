  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "1SA 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Samwele akalipila Saulo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo ali ne myaka amakumi yatatu (30) ilyo bamusontele pa bufumu, kabili ateekele abena Israeli pa myaka amakumi yane na ibili (42).",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.1",
            "verseOrgIds": [
              "1SA.13.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "13:1",
              "type": "text"
            },
            {
              "text": "imyaka:",
              "type": "text"
            },
            {
              "text": "Ba Baibele bamo tabalembamo impendwa ya myaka yakwa Saulo ilyo atendeke ukuteeka ne myaka ateekele pa bufumu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.1",
            "verseOrgIds": [
              "1SA.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo asalile abaume amakana yatatu (3,000) ukufuma mu Israeli. Amakana yabili (2,000) yali nankwe ku Mikimashi na mu calo ca mpili sha Betele, elyo ikana limo (1,000) lyali na Yonatani ku Gibea wa mu Benjamini. Abantu bonse abashelepo ababweseshamo ku ncende sha kumwabo uko bafumine.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.2",
            "verseOrgIds": [
              "1SA.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.2",
            "verseOrgIds": [
              "1SA.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonatani acimfishe impuka ya Bafilisiti abali pa nkambi ya ku Geba, na Bafilisiti bonse baumfwako icacitike. Elyo Saulo alishishe ipenga mu calo conse nokutila, “Lekeni Abahibulu bomfwe!” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.3",
            "verseOrgIds": [
              "1SA.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi bonse abena Israeli balyumfwile amashiwi yonse ayakuti Saulo nasansa inkambi ya Bafilisiti elyo nomba Israeli asangwike umulwani wa Bafilisiti. Kabili abantu balongene mukuba pamo na Saulo ku Giligali.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.4",
            "verseOrgIds": [
              "1SA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.4",
            "verseOrgIds": [
              "1SA.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abafilisiti nabo balongana pamo pakulwisha abena Israeli, bali na maceleta amakana amakumi yatatu (30,000) ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.5",
            "verseOrgIds": [
              "1SA.13.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "13:5",
              "type": "text"
            },
            {
              "text": "(30,000):",
              "type": "text"
            },
            {
              "text": "Muli ba Baibele bamo balemba amakana yatatu (3,000).",
              "type": "text"
            }
          ]
        },
        {
          "text": " na aba pali bakabalwe amakana mutanda (6,000) elyo ne fita ifingi kwati munsensenga wa kuli bemba. Baile no kuya cita inkambi ku Mikimashi, ku kabanga ka Beti Afeni. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.5",
            "verseOrgIds": [
              "1SA.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo abaume abena Israeli bamwene ukuti bakwata ubwafya ubushaibipila, kabili nokuti ifita fyabo fyacilikilwa, bafisama mu ncengo na mu filindi, mu mateshi, mu mabwe elyo na mu mendo ya mabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.6",
            "verseOrgIds": [
              "1SA.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamo Abahibulu balyabwike umumana wa Yordani ukuya mu calo ca Gadi na Gileadi. Saulo ashele ku Giligali ne mpuka shonse isha fita isho ali nasho shilekankafye ku mwenso. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.7",
            "verseOrgIds": [
              "1SA.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apembele pa nshiku cine lubali, ukulingana ne nshita Samwele apimine. Lelo Samwele taishileko ku Giligali! Abantu bakwa Saulo batampile no kusalangana. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.8",
            "verseOrgIds": [
              "1SA.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eico Saulo atile, “Leteni kuli ine ilambo lyakoca elyo ne mituulo yakwampana.” Elyo Saulo atuulile ilambo lyakoca. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.9",
            "verseOrgIds": [
              "1SA.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi cilya apwafye ukupeela ilambo lyakoca, na Samwele afika, kabili Saulo aile mukumusengela no kumuposha. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.10",
            "verseOrgIds": [
              "1SA.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samwele aipusha ati, “Bushe cinshi wacita?” Saulo ayasuka ati, “Ilyo nacimona ukuti abantu balasalangana kabili nokuti tawishile pa nshita wapimine, elyo Abafilisiti nabo balelongana ku Mikimashi, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.11",
            "verseOrgIds": [
              "1SA.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "eco nasosele nati, ‘Nomba Abafilisiti balanjishilila ine wine ku Giligali, kabili nshilalomba nokuti Yawe ansekelele. Kanshi epakuipatikisha mukutuula ilambo lyakoca.’” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.12",
            "verseOrgIds": [
              "1SA.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samwele epakweba Saulo ati, “Ucitilefye nge mbulwamano. Taubakile ifunde Yawe Lesa obe akupeela. Aucita ifyo akukonkomesha, nga nakosha ubufumu bobe pali Israeli ukuba ubwa pe na pe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.13",
            "verseOrgIds": [
              "1SA.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.13.22"
              },
              "items": [
                {
                  "text": "Imili 13:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lelo nomba ubufumu bobe tabwatwalilile. Yawe nafwaya umuntu uwa mibeele iyisansamusha umutima wakwe, kabili eo asontele ukuba intungulushi ya bantu bakwe, pantu iwe taubakile ifunde lyakwa Yawe.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.14",
            "verseOrgIds": [
              "1SA.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.14",
            "verseOrgIds": [
              "1SA.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Samwele afumine ku Giligali no kuya ku Gibea wa muli Benjamini. Elyo Saulo apendele abaume abashele nankwe asanga ati bali nalimo imyanda mutanda (600).",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.15",
            "verseOrgIds": [
              "1SA.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.15",
            "verseOrgIds": [
              "1SA.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo no mwana wakwe umwaume Yonatani na baume bali nabo baikele mu Geba",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.16",
            "verseOrgIds": [
              "1SA.13.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "13:16",
              "type": "text"
            },
            {
              "text": "Mu Babaibele bamo batila, “Gibea.”",
              "type": "text"
            }
          ]
        },
        {
          "text": " wakwa Benjamini, ninshi Abafilisiti nabo bacitile inkambi ku Mikimashi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.16",
            "verseOrgIds": [
              "1SA.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo ibumba lya bantu abonaushi lyafumine ku nkambi ya Bafilisiti mu mpuka shitatu. Impuka imo yalungeme ku Ofira mu calo cakwa Shuali, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.17",
            "verseOrgIds": [
              "1SA.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "imbi yalungeme ku Beti Horoni elyo iyacitatu nayo yalolele ku mpanga ya mupaka walungatana ne shika lya Seboyimu ukulolenkana ku matololo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.18",
            "verseOrgIds": [
              "1SA.13.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.18",
            "verseOrgIds": [
              "1SA.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomba takwali uwakufula ifyela mu calo conse ica Israeli, pantu Abafilisiti batile, “Epali Abahibulu bayamba ukufula impanga nangu amafumo!” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.19",
            "verseOrgIds": [
              "1SA.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi bonse abena Israeli baleya ku Bafilisiti mukunonesha inkasu sha ŋombe, bapiki, amasembe, elyo ne fikwakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.20",
            "verseOrgIds": [
              "1SA.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umutengo wakunonesha inkasu sha ŋombe na bapiki wali ukucila citika wa shekeli umo,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.21",
            "verseOrgIds": [
              "1SA.13.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "13:21",
              "type": "text"
            },
            {
              "text": "ukucila citika wa shekeli umo:",
              "type": "text"
            },
            {
              "text": "Akantu akafina amagramu cine konse konse (0.008kg).",
              "type": "text"
            }
          ]
        },
        {
          "text": " elyo pakunona amasembe elyo na pa kolola kwa misumbo kwine wali mupepi na citika wa shekeli.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.21",
            "verseOrgIds": [
              "1SA.13.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "13:21",
              "type": "text"
            },
            {
              "text": "mupepi na citika wa shekeli:",
              "type": "text"
            },
            {
              "text": "Akantu akafina amagramu yane (0.004kg).",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.21",
            "verseOrgIds": [
              "1SA.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
