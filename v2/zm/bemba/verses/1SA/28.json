              "1SA.28.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.20.27"
              },
              "items": [
                {
                  "text": "Levi 20:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.18.10+DEU.18.11"
              },
              "items": [
                {
                  "text": "Amaf 18:10-11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.25.1"
              },
              "items": [
                {
                  "text": "1 Sam 25:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nomba Samwele alifwile, na bena Israeli bonse balimulooseshe, bamushiika na mu mushi wakwe ku Rama. Saulo ninshi natamfya bakabuka elyo na babomba ne mipashi bonse ukufuma mu calo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.3",
            "verseOrgIds": [
              "1SA.28.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.3",
            "verseOrgIds": [
              "1SA.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abafilisiti balongene pamo mukucita inkambi ku Shunemu, ninshi Saulo nao nalonganya abena Israeli bonse no kucita inkambi ku Giliboa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.4",
            "verseOrgIds": [
              "1SA.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo Saulo amona impuka ya Bafilisiti, atiina. Umwenso waikete umutima wakwe, alatutuma nganshi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.5",
            "verseOrgIds": [
              "1SA.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.27.21"
              },
              "items": [
                {
                  "text": "Imp 27:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Saulo epakwipusha Yawe, lelo Yawe akaana ukumwasuka mu filoto nangu muli Urimu",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.6",
            "verseOrgIds": [
              "1SA.28.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "28:6",
              "type": "text"
            },
            {
              "text": "Urimu na Tumimu:",
              "type": "text"
            },
            {
              "text": "Tumabwe nangu utumiti uto shimapepo alebomfya pakupendula pakwishiba ifyo Lesa alefwaya (Ukuf 28:30; Levi 8:8; Imp 27:21).",
              "type": "text"
            }
          ]
        },
        {
          "text": " nangu muli bakasesema. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.6",
            "verseOrgIds": [
              "1SA.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Saulo atile ku babomfi bakwe, “Mfwaileniko umwanakashi umo uwaishiba ukubuka pakuti eko nje mukwipusha.” Elyo batila, “Moneni, eko aba umo umwanakashi ku Eni Dori uubuka.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.7",
            "verseOrgIds": [
              "1SA.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.7",
            "verseOrgIds": [
              "1SA.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi Saulo epakuifulunganya afwala insalu shimbi. Elyo ubushiku, wena na bantu babili baima baya na ku mwanakashi. Saulo amweba ati, “Njipushishako ku mipashi, elyo undetelepo umuntu uo nalakweba ishina.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.8",
            "verseOrgIds": [
              "1SA.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo umwanakashi atile kuli ena, “Icine cine walishibafye bwino ifyo Saulo acita. Uyu muntu alitamfya bonse bakabuka na babomba ne mipashi mu calo cakwe. Nga cinshi uletele iciteyo pa bumi bwandi icingandetela imfwa?” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.9",
            "verseOrgIds": [
              "1SA.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo epakulapa kuli ena muli Yawe ati, “Mu cishinkafye cakwa Yawe uwamweo, iwe tawakapeelelwepo umulandu pali ici cintu.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.10",
            "verseOrgIds": [
              "1SA.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo umwanakashi aipusha ati, “Bushe ni nani uo ndekwimisha ku bafwa?” Nao atile “Ndefwaya Samwele.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.11",
            "verseOrgIds": [
              "1SA.28.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.11",
            "verseOrgIds": [
              "1SA.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo umwanakashi amwene Samwele, alilile umusowa uukalamba nokutila kuli Saulo, “Bushe cinshi umbepele? Ilyo niwe Saulo!” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.12",
            "verseOrgIds": [
              "1SA.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo imfumu yatile ku mwanakashi, “Witiina. Bushe cinshi wamona?” Umwanakashi ati, “Namona umulungu ulefuma mu mushili.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.13",
            "verseOrgIds": [
              "1SA.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asosa ku mwanakashi ati, “Bushe ulemoneka shani?” Nao atile, “Ulemoneka kwati mwaume umukote uufwele umwingila alefumina pamulu.” Nomba Saulo elyo aishiba ukuti ni Samwele, elyo akontamina panshi amupakata. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.14",
            "verseOrgIds": [
              "1SA.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samwele epakutila kuli Saulo, “Bushe mulandu nshi wamfulunganishisha ukutuusha pakumbusha?” Saulo atile, “Ine ndi ne sakamika ilikalamba. Abafilisiti bali pa bulwi na ine, kabili Lesa nao naleka ukunjasuka nangu kupitila muli bakasesema nangu ni mu filoto. E mulandu wine njishile kuli iwe pakuti unjebeko ifyo ningacita.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.15",
            "verseOrgIds": [
              "1SA.28.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.15",
            "verseOrgIds": [
              "1SA.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samwele nao atile, “Nomba mulandu nshi uleipushisha ine, ilyo Yawe nakufutatila nasanguka no mulwani obe? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.16",
            "verseOrgIds": [
              "1SA.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.15.28"
              },
              "items": [
                {
                  "text": "1 Sam 15:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yawe ena nabomba ifyo asobele ukupitila muli ine. Yawe napokolola ubufumu mu maboko yobe no kubupeela kuli umo umwina mupalamano obe, kuli Davidi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.17",
            "verseOrgIds": [
              "1SA.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.15.3+1SA.15.4+1SA.15.5+1SA.15.6+1SA.15.7+1SA.15.8+1SA.15.9"
              },
              "items": [
                {
                  "text": "1 Sam 15:3-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pa mulandu wakukanabeela ifyo Yawe akwebele, elyo wakaana nokucita icifukushi cabukali bwakwe pali Amaleki, Yawe nacita ici kuli iwe mu bushiku bwa lelo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.18",
            "verseOrgIds": [
              "1SA.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe ali nokupeela bonse abena Israeli pamo na iwe mu maboko ya Bafilisiti. Kabili mailo iwe pamo na bana bobe muli nokuba pamo na ine. Yawe kabili ali nokupeela ifita fya bena Israeli ku Bafilisiti.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.19",
            "verseOrgIds": [
              "1SA.28.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.19",
            "verseOrgIds": [
              "1SA.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awe bwangu bwangu Saulo awa panshi atambalala ku mwenso ukalamba, pa mulandu wa mashiwi Samwele amwebele. Amaka yapwa kuli Saulo, pantu akasuba konse talile elyo no bushiku bwine.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.20",
            "verseOrgIds": [
              "1SA.28.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.20",
            "verseOrgIds": [
              "1SA.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo umwanakashi aishile kuli Saulo no kumona ifyo ali uwacushiwa nganshi, amweba ati, “Mona, umubomfi obe umwanakashi nakubeela. Nshacisakamana kufwa iyoo, nati awe kancitefye ifyo unjebele. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.21",
            "verseOrgIds": [
              "1SA.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomba napapata umfwa ku mubomfi obe no kuleka nkupeelekofye utwakulya tumo, pakuti ulye no kukwata amaka uko uleya mu nshila yobe.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.22",
            "verseOrgIds": [
              "1SA.28.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao alikene ati, “Nshalye.” Lelo ababomfi bakwe no mwanakashi bamupatikisha, elyo asumina ifyo balemweba. Awe aima panshi no kwikala pa busanshi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.23",
            "verseOrgIds": [
              "1SA.28.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.23",
            "verseOrgIds": [
              "1SA.28.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwanakashi ali ne ciponti icaina pa ŋanda pamwakwe, aya bwangu bwangu acipaya. Asenda no bunga ubwakandawilwa no kupangako umukate uushitutumuka. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.24",
            "verseOrgIds": [
              "1SA.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo apalamika kuli Saulo pamo na babomfi bakwe, nabo balya. Bulya bwine bushiku baima no kuya.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.25",
            "verseOrgIds": [
              "1SA.28.25"
            ]
          }
