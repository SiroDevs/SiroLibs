            "sid": "1SA 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.24",
            "verseOrgIds": [
              "1SA.26.24"
            ]
          }
        },
        {
