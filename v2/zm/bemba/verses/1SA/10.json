          "type": "text",
          "attrs": {
            "verseId": "1SA.10.24",
            "verseOrgIds": [
              "1SA.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
