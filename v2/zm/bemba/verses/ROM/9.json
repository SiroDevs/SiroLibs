                  "text": "2:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kabili efyo Lesa asosa mu citabo cakwa kasesema Hosea ati,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.25",
            "verseOrgIds": [
              "ROM.9.25"
