              "type": "text"
            },
            {
              "text": "silifa:",
              "type": "text"
            },
            {
              "text": "Efyafinine amakilo mupepi na makana yatatu (3,000 kg).",
              "type": "text"
            }
          ]
        },
        {
          "text": ", kabili ne fyakufwala ifya bashimapepo nafyo umwanda umo (100). ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.69",
