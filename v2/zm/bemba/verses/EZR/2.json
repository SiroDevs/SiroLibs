            "style": "v",
            "sid": "EZR 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba ebaishile na Serubabeli, Yeshua, Nehemia, Seraya, Reelaya, Modekai, Bilishani, Misipari, Bigifai, Reumu na Baanaya.",
          "type": "text",
          "attrs": {
