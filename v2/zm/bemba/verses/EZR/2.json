          },
          "items": [
            {
              "text": "68",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo abali mu busha ku Babiloni bafika ku ŋanda yakwa Lesa iyali mu Yerusalemu, abakalamba ba ndupwa bamo batuula ifyabupe ifyakuitemenwa ifyakwafwilishako ukukuula iŋanda yakwa Lesa apo yakuulilwe kale. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.68",
            "verseOrgIds": [
              "EZR.2.68"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "69",
            "style": "v",
            "sid": "EZR 2:69"
          },
          "items": [
            {
              "text": "69",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukulingana na maka bakwete, bapeele indalama drakimasi amakana amakumi mutanda ne ikana limo (61,000) isha golide",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.69",
            "verseOrgIds": [
              "EZR.2.69"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2:69",
              "type": "text"
            },
            {
              "text": "golide:",
              "type": "text"
            },
            {
              "text": "Efyafinine amakilo imyanda isano (500kg).",
              "type": "text"
            }
          ]
        },
        {
          "text": " ne ndalama minasi amakana yasano (5,000) isha silifa",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.69",
            "verseOrgIds": [
              "EZR.2.69"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
