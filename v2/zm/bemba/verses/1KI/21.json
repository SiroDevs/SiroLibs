            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Elyo pa mulandu wakwa Yesebele, Yawe asosa ati, ‘Imbwa shili nokulya Yesebele mukati ke linga lya ku Yesireli.’",
          "type": "text",
          "attrs": {
