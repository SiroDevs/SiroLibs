          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.4.26"
              },
              "items": [
                {
                  "text": "1 Isham 4:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni alonganika amaceleta na bakabalwe. Akwete amaceleta ikana limo ne myanda ine (1,400) elyo na bakabalwe amakana ikumi limo na yabili (12,000) afibika mu misumba ya maceleta elyo fimbi aba nafyo mu Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.26",
            "verseOrgIds": [
              "1KI.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imfumu yalenga silifa ukufula mu Yerusalemu nga mabwe, ne fimuti ifyalepesha ifya keda ubwingi kwati mikunyu ya mwisamba lya mpili. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.27",
            "verseOrgIds": [
              "1KI.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.16"
              },
              "items": [
                {
                  "text": "Amaf 17:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bakabalwe bakwa Solomoni babashitile mu calo ca ku Egupto na ku Kuwe",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.28",
            "verseOrgIds": [
              "1KI.10.28"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "10:28",
              "type": "text"
            },
            {
              "text": "Kuwe:",
              "type": "text"
            },
            {
              "text": "Ekutila ku Kilikia.",
              "type": "text"
            }
          ]
        },
        {
          "text": ". Bashimakwebo ba mfumu ebaleshita ukufuma ku Kuwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.28",
            "verseOrgIds": [
              "1KI.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bashitile iceleta ukufuma ku Egupto pa ndalama imyanda mutanda (600) isha mashekeli ya silifa",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.29",
            "verseOrgIds": [
              "1KI.10.29"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "10:29",
              "type": "text"
            },
            {
              "text": "Amashekeli 600:",
              "type": "text"
            },
            {
              "text": "Ekufina amakilo cine lubali.",
              "type": "text"
            }
          ]
        },
        {
          "text": " elyo kabalwe umo pa ndalama amashekeli umwanda umo na makumi yasano (150).",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.29",
            "verseOrgIds": [
              "1KI.10.29"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "10:29",
              "type": "text"
            },
            {
              "text": "Amashekeli 150:",
              "type": "text"
            },
            {
              "text": "Ekufina mupepi na makilo yabili.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bashimakwebo bakwa Solomoni nabo baleshitisha ku shamfumu shonse isha bena Hiti na bena Aramu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.29",
            "verseOrgIds": [
              "1KI.10.29"
            ]
          }
        }
      ]
