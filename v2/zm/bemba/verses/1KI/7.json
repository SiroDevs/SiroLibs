              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifi fipe fyonse ifyo Hiramu apangile imfumu Solomoni ifyakubika mu ŋanda yakwa Yawe fyapangilwe ku mukuba uwawamishiwa bwino. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.45",
            "verseOrgIds": [
              "1KI.7.45"
            ]
          }
