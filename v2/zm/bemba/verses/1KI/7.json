          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni ashile ifi fipe ukwabula ukuti afipime pa mulandu wa bwingi bwafiko. Eico no kufina kwa mukuba takwaishibikwe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.47",
