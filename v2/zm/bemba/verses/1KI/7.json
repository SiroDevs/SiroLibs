          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifi fyonse imfumu yafyengulwile kwibumba lya mwiwanga lya Yordani pakati ka Sukoti na Saretani. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.46",
