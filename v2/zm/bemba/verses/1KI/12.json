              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.27",
            "verseOrgIds": [
              "1KI.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.28",
            "verseOrgIds": [
              "1KI.12.28"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.32.4"
              },
              "items": [
                {
                  "text": "Ukuf 32:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panuma ilyo atontonkanyapo, imfumu yapangile ifiponti fibili ifya golide. Yaeba na bantu aiti, “Mulimo uukalamba nganshi uwakuti lyonse muleyafye ku Yerusalemu. Iyi e milungu yenu mwe bena Israeli iyamufumishe mu calo ca ku Egupto.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.28",
            "verseOrgIds": [
              "1KI.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umulungu umo aubika mu Betele elyo na ubiye mu Dani. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.29",
            "verseOrgIds": [
              "1KI.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili ici acitile caba icabubifi. Abantu balayafye ukufika na ku Dani mukupepa umulungu uwaliko. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.30",
            "verseOrgIds": [
              "1KI.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroboamu akuula amayanda yakupepelamo apasansama, asontelamo na bashimapepo ukufuma mu bantu abalekana lekana, abo abashali na bena Lefi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.31",
            "verseOrgIds": [
              "1KI.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.23.33+LEV.23.34"
              },
              "items": [
                {
                  "text": "Levi 23:33-34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abika inshikunkulu pa bushiku bwalenga ikumi limo na shisano (15) mu mweshi walenga cine konse konse ukulingana ne nshikunkulu yaleba ku Yuda elyo atuula na malambo ya pa bulambo. Acite ifi mu Betele, ukutuula ku mulungu uo apangile. Kabili pa Betele asontelapo bashimapepo pa mayanda ya mapepo akuulile. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.32",
            "verseOrgIds": [
              "1KI.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa bushiku bwalenga ikumi limo na shisano (15) mu mweshi walenga cine konse konse, umweshi uo umwine aisalilefye, atuulile amalambo pa bulambo akuulile pa Betele. Efyo abikile inshikunkulu ya bena Israeli kabili anina na ku bulambo mukuya tuula imituulo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.33",
            "verseOrgIds": [
              "1KI.12.33"
            ]
          }
        }
      ]
    }
