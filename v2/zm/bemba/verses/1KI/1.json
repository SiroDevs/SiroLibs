              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo Adoniya pa mulandu wakutiina Solomoni, aima ayakonena ku nsengo sha ku bulambo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.50",
            "verseOrgIds": [
