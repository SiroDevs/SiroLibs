            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.17.27+2SA.17.28+2SA.17.29"
              },
              "items": [
                {
                  "text": "2 Sam 17:27-29",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Lelo ukalange uluse kuli bamwana Basilai uwa ku Gileadi, no kubalenga ukuti bakalelyafye nobe petebulo lyobe. Bena balingafwile pali ilya nshita nafulumwike kuli munonko Abusalomu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.7",
            "verseOrgIds": [
              "1KI.2.7"
            ]
          }
        }
      ]
    },
    {
