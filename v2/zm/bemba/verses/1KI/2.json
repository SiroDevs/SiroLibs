                "loc": "2SA.20.10"
              },
              "items": [
                {
                  "text": "20:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Nomba iwe walishiba bwino ifintu ifyo Yoabu mwana Seruiya acitile kuli ine ilyo aipeye abakalamba ba fita fya nkondo ifya bena Israeli babili, Abune mwana Neri na Amasa mwana Yete. Alibepeye no kusumya umulopa wabo pa nshita ya mutende kwati ni nshita ya nkondo. Abuulile no mulopa wabo ashinga ku mushipi uo afwele mu musana elyo na ku ndyato shali ku makasa yakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.5",
            "verseOrgIds": [
              "1KI.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eico ukamucitile umwabela amano yobe, icikulufye wikaleka akaifwile imfwa yamutende.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.6",
            "verseOrgIds": [
              "1KI.2.6"
            ]
          }
        }
      ]
    },
