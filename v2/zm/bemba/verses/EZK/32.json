        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 32:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Intungulushi shonse isha ku kapinda ka ku kuso nasho shili kulya kwine, pamo na bena Sidoni bonse. Kale ebaletiinya abantu ba mishobo ku mulandu wa bulamba bwabo, lelo pali nomba baliya ne nsoni kulya ku calo ca bafwa, no kulala eko balala ukwabula ukusembululwa pamo na bafwile ku lupanga.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.30",
            "verseOrgIds": [
              "EZK.32.30"
            ]
          }
        }
      ]
