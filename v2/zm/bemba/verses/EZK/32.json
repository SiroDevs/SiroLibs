              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne nindi shabo shibikwa pa ncende iyashika iya ku calo ca bafwa. Abashilika bakwe bonse bafwilile mu nkondo, ne nindi shabo shaposa inindi yakwe pakati. E aba bene bashilika bateekele icalo ca bomi ku kalili.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.23",
            "verseOrgIds": [
              "EZK.32.23"
            ]
          }
        }
