            "number": "28",
            "style": "v",
            "sid": "EZK 32:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Eico na iwe wine Farao, uli nokonaika no kuya lala pamo na bashasembululwa, balya abaipaiwe ku lupanga.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.28",
            "verseOrgIds": [
              "EZK.32.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
