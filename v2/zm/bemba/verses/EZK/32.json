              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.25",
            "verseOrgIds": [
              "EZK.32.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 32:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mesheki Tubali nao ali palya pakati ka nindi sha bashilika bakwe. Balya bonse bantu abashasembululwa, kabili ni balya bantu bafwile mu nkondo ku lupanga pantu ebalya bantu balecita impasase mu calo ca bomi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.26",
            "verseOrgIds": [
              "EZK.32.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 32:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bushe bena tabalala apalala ababulwi abashasembululwa, abo bashiikile pamo ne fyanso fya nkondo, ne mitwe yabo yasaile pa mpanga shabo? No kukandwa kwa pa bubifi bwabo kwaba pa mafupa yabo nangu impasase shacitile aba ababulwi shali mu calo ca bomi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.27",
            "verseOrgIds": [
              "EZK.32.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
