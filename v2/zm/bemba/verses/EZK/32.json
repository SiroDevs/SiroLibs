            "verseOrgIds": [
              "EZK.32.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 32:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Edomu nao ali kulya pamo ne shamfumu shakwe na bacilolo bakwe bonse. Bali abashilika abapambana, nomba pali ino nshita balilala kulya ku calo cabafwa, pamo na bantu abashasembululwa abafwilile mu nkondo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.29",
            "verseOrgIds": [
              "EZK.32.29"
            ]
          }
        }
      ]
