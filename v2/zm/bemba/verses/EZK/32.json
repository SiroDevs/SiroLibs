        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ifi efyasosa Imfumu Yawe. Ilyo Farao imfumu ya Egupto akabamona bonse, awe imfwa yakwe ikamutalalika umutima, pamo pene ne mfwa ine iya fita fyakwe fyonse ifyafwilile mu nkondo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.31",
            "verseOrgIds": [
              "EZK.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nangu ena namubomfeshe mukusalanganya umwenso mu calo ca bamweo lelo Farao ne fita fyakwe fyonse bali nokuya lala pamo na bashasembulwa abafwile ku nkondo.” Efyasosa Imfumu Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.32",
            "verseOrgIds": [
              "EZK.32.32"
            ]
          }
        }
      ]
