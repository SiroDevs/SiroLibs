      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.23",
            "verseOrgIds": [
              "EZK.28.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Pa mishobo yonse iyashinguluka aba ŋanda yakwa Israeli, kabili iyabasuula, awe tapakabe nomba nelyo umo uukalabacusha nangufye ukubekatamo. Elyo bakashininkisha ukuti kanshi ine nine Imfumu Yawe.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.24",
            "verseOrgIds": [
              "EZK.28.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.24",
            "verseOrgIds": [
              "EZK.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ifi efyasosa Imfumu Yawe ati, ‘Ine nkafumya aba ŋanda yakwa Israeli mu mishobo umo basalanganina, nkababwesesha na kumyabo, elyo ne mishobo yonse ikashininkisha ukuti kanshi ine ndi wamushilo. Aba ŋanda yakwa Israeli bakekala mu calo cabo ico napeele umubomfi wandi Yakobo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.25",
            "verseOrgIds": [
              "EZK.28.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakalaikalamo ukwabula ukutiina nelyo cimo. Bakalakuulamo amayanda, no kulalimamo imyangashi. Nkakanda abena mupalamano babo bonse ababasuulile, lyena abena Israeli bakalaikalila na ku matwi tondolo. Elyo bakeshiba ukuti kanshi ine nine Yawe Lesa wabo.’”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.26",
            "verseOrgIds": [
              "EZK.28.26"
            ]
          }
        }
      ]
    }
