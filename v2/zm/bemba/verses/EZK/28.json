                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kabili ishiwi lyakwa Yawe lyaishile kuli ine aliti, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.20",
            "verseOrgIds": [
              "EZK.28.20"
