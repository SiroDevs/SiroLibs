        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.22",
            "verseOrgIds": [
              "EZK.11.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.43.2+EZK.43.3+EZK.43.4+EZK.43.5"
              },
              "items": [
                {
                  "text": "Esek 43:2-5",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo bakerubi balitampile ukupupuka, ne mipeto ine yabakonka. Ubucindami bwakwa Lesa wakwa Israeli bwali pa mulu wabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.22",
