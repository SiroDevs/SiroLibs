            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.10",
            "verseOrgIds": [
              "EZK.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili ishiwi lyakwa Yawe lyaishile kuli ine aliti, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.11",
            "verseOrgIds": [
              "EZK.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.24.15+2KI.24.16+2KI.24.17+2KI.24.18+2KI.24.19+2KI.24.20"
              },
              "items": [
                {
                  "text": "2 Isham 24:15-20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.10+2CH.36.11+2CH.36.12+2CH.36.13"
              },
              "items": [
                {
                  "text": "2 Imila 36:10-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Ipusha abo basangu nga cakuti nabeluka umo ifi fintu filolele. Ubebe ukuti imfumu ya ku Babiloni yaishile ku Yerusalemu, yaisa senda imfumu ya mu Yerusalemu pamo na bacilolo baiko, yabatwala na ku musumba waiko ku Babiloni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.12",
            "verseOrgIds": [
              "EZK.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yabuulapo no muntu umo uwa mu lupwa lwa mfumu, eo yapangana nankwe icipangano, yalapa nokuti tayakaconaule. Ilyo ninshi imfumu ya ku Babiloni yalisenda ne ntungulushi isha mu calo, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.13",
            "verseOrgIds": [
              "EZK.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "epakuti ubufumu bwabo bucepelwe amaka, bukafilwe no kwimina imfumu ya Babiloni, elyo ne cipangano cilesungwa bwino nga bekale mu cibote. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.14",
            "verseOrgIds": [
              "EZK.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo imfumu ya ku Yerusalemu yatuma inkombe ku Egupto pakuti baye lombako bakabalwe ne fita ifingi. Bushe umuntu wa uyu musango kuti ashuka? Bushe nga acita ifyo teti bamucitepo cimo? Bushe kuti aonaula icipangano ukwabula ukuti bamulimwinepo?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.15",
            "verseOrgIds": [
              "EZK.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.15",
            "verseOrgIds": [
              "EZK.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Napalifye ine ne Mumi, ne Mfumu Yawe ndeti, iyo mfumu ikafwila ku Babiloni, pantu yasuula umulapo, kabili yaonaula ne cipangano ico yapangene ne mfumu ya ku Babiloni, iyamutekele pa cipuna cabufumu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.16",
            "verseOrgIds": [
              "EZK.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nangu Farao akwate ifita ifyamaka shani, awe nao wine kuti afilwa ukutuulako imfumu ilyo inkondo yabuka, nangu abena Yuda bengatuntumanika ifibumbili, no kwimba icilindi icashika pakubatebelela icakuti pafwila na bantu abengi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.17",
            "verseOrgIds": [
              "EZK.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pantu iyo mfumu yasuula umulapo, kabili yaonaula ne cipangano. Ala teti ipusuke pa mulandu wakucita ifi fintu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.18",
            "verseOrgIds": [
              "EZK.17.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.18",
            "verseOrgIds": [
              "EZK.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kanshi ifi efyasosa Imfumu Yawe ati, mu cine cine napalifye ine ne Mumi, iyo mfumu ine nkailimuna pa mulandu wakonaula icipangano, ico yalaile no mulapo ukuti ikalacisunga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.19",
            "verseOrgIds": [
              "EZK.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo mfumu ine nkaiteya isumbu, no kwikatwa ikekatwamo. Nkaisenda no kuitwala ku Babiloni, no kuilimuna eko nkailimwina pa mulandu wakuntalamina. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.20",
            "verseOrgIds": [
              "EZK.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifita fyaiko fyonse ifyacenjelesha fikafwa ku nkondo, ne fikapusukako nkafisalanganishisha monse monse. Elyo mukashininkisha ukuti kanshi nine ne Yawe ndemweba.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.21",
            "verseOrgIds": [
              "EZK.17.21"
            ]
          }
        }
      ]
    },
