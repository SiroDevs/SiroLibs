            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishiwi lyakwa Yawe lyaishile kuli ine aliti, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.1",
            "verseOrgIds": [
              "EZK.12.1"
            ]
          }
        },
        {
