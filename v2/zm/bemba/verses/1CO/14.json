  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "1CO 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulefwaisha ukuba ne citemwiko. Mulefwaisha ubupe bonse Mupashi apeela, no kucila mulefwaya ubupe bwakusesema amashiwi yakwa Lesa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.1",
            "verseOrgIds": [
              "1CO.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu uulandila mu ndimi ishalekana lekana, te ku bantu alandila, lelo alanda kuli Lesa. Pantu abantu tabaleumfwa ifyo alelanda. Ni ku maka yakwa Mupashi alandila ifya nkaama yakwa Lesa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.2",
            "verseOrgIds": [
              "1CO.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo uusesema amashiwi yakwa Lesa, wena alanda ku bantu, pakuti abafwilisheko, abakoseleshe, kabili abatalalike imitima. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.3",
            "verseOrgIds": [
              "1CO.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu uulanda indimi ishalekana lekana, ubu bupe bwakumuwaminafye umwine. Lelo umuntu uusesema amashiwi yakwa Lesa, ubu bupe bwena bwakuwamina ulukuta.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.4",
            "verseOrgIds": [
              "1CO.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.4",
            "verseOrgIds": [
              "1CO.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine kwena kuti natemwa ukuti bonse mulelanda indimi ishalekana lekana, lelo kuti natemwishapo ukuti bonse mulesesema amashiwi yakwa Lesa. Pantu uusesema amashiwi yakwa Lesa, acila pali uyo uulanda mu ndimi ishalekana lekana, kano ninshi aleilula ifyo alesosa, pakuti ifyo alesosa fimone ukuwamina ulukuta. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.5",
            "verseOrgIds": [
              "1CO.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eico kanshi bamunyinane nga naisa kuli imwe ndelanda indimi ishalekana lekana, bushe kuti camuwamina shani? Awe iyoo, kano ninshi namuletela ifyo Lesa alemusokolwela, nangu ifyo alefwaya ukuti mwishibe, nangu ukusesema amashiwi yakwa Lesa nangu ifyakumufunda.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.6",
            "verseOrgIds": [
              "1CO.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.6",
            "verseOrgIds": [
              "1CO.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontonkanyeni pa filimba, ifili nga mutolilo nangu isese, ifintu ifishaba na bumi. Uulelisha nga talelisha bwino, nga nani engeshiba ulwimbo alelisha? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.7",
            "verseOrgIds": [
              "1CO.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili umuntu uulelisha ipenga, nomba talishishe bwino, nga kuti abantu baipekanya shani ku bulwi? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.8",
            "verseOrgIds": [
              "1CO.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eifyo fine na imwe mwe balanda indimi ishalekana lekana, ngo muntu kuti aishiba shani ifyo mulelanda, ngefyo mulelanda tafili fyatunguluka? Bushe ninshi tamuleicushafye ukulanda! ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.9",
            "verseOrgIds": [
              "1CO.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pano isonde nelyo paba indimi ishalekana lekana, lelo abashishiba balomfwa umo shilolele. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.10",
            "verseOrgIds": [
              "1CO.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomba ine nga nshileumfwa ululimi alelanda umo lulolele, ninshi uyu muntu alelanda aba mwinafyalo kuli ine. Elyo na ine wine ninshi ndi mwinafyalo kuli uyu muntu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.11",
            "verseOrgIds": [
              "1CO.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cimo cine na kuli imwe bene, apo mulefwaisha ukukwata ubupe bwakwa Mupashi, sakamanisheni ukukwata ubupe ubwakuwamina ulukuta.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.12",
            "verseOrgIds": [
              "1CO.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.12",
            "verseOrgIds": [
              "1CO.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eico kanshi uulelanda indimi ishalekana lekana, ali nokulomba Lesa ukuti amupeele na maka yakwishiba umwakwilwila ifyo alelanda. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.13",
            "verseOrgIds": [
              "1CO.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga ndepepa mu ndimi ishalekana lekana, umupashi wandi wena wapepafye bwino, lelo amano yandi yena tayamwenenemo nelyo cimo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.14",
            "verseOrgIds": [
              "1CO.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga kanshi ndi nokucita shani? Ndi nokupepa mu mupashi wandi, kabili ndi nokupepa na mu mano yandi mwine. Ndi nokwimbila Lesa mu mupashi wandi kabili ndi nokumwimbila na mu mano yandi mwine. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.15",
            "verseOrgIds": [
              "1CO.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pantu nga uletasha Lesa mu mupashi obefye, nga uushafundwa uo mulongene nao kukupepa, kuti ayasuka shani “Ameni” kwipepo lyobe ilyakutasha nga teshibe ifyo ulesosa? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.16",
            "verseOrgIds": [
              "1CO.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukuba kwena ipepo lyobe ilyakutasha Lesa lilifye bwino, lelo umunobe wena talilemuwamina nakalya.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.17",
            "verseOrgIds": [
              "1CO.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.17",
            "verseOrgIds": [
              "1CO.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndetasha Lesa pali ico nalimucila bonse ukulanda indimi ishalekana lekana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.18",
            "verseOrgIds": [
              "1CO.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo ilyo tulongene kukupepa, lyena kuti natemwa ukulandafye amashiwi yasano pakuti bomfwe ifyo ndefunda, ukucila ukulanda amashiwi amakana na makana mu ndimi shimbi ishalekana lekana.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.19",
            "verseOrgIds": [
              "1CO.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.19",
            "verseOrgIds": [
              "1CO.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwe bamunyinane, mukutontonkanya mwena mwilaba nga baice. Mulepala ngo tunya mukukanabifya. Lelo mukutontonkanya mwena mube abakalamba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.20",
            "verseOrgIds": [
              "1CO.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.28.11+ISA.28.12"
              },
              "items": [
                {
                  "text": "Esaya 28:11-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Calilembwa mu Mafunde yakwa Mose ukuti,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.21",
            "verseOrgIds": [
              "1CO.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.22",
            "verseOrgIds": [
              "1CO.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi ilyo ulukuta lonse lwalongana kukupepa, nga bonse mwatampa ukulalanda mu ndimi ishalekana lekana, bushe abantu abashafundwa nangu abashasumina nga baisamo, bushe tekuti batile aba bantu nabapena? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.23",
            "verseOrgIds": [
              "1CO.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomba nga cakuti bonse balesesema amashiwi yakwa Lesa elyo umuntu uushasumina nangu uushafundwa nga aisamo, kuti aumfwa amashiwi bonse balelanda yamushinina. Elyo kuti amashiwi yalenga ashininkishe no bubi bwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.24",
            "verseOrgIds": [
              "1CO.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuti asanga no bubi ubwafisama mu mutima wakwe bwasokoloka. Elyo afukama panshi alapepa Lesa ati, “Cine cine Lesa ali muno pakati kenu!”",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.25",
            "verseOrgIds": [
              "1CO.14.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.25",
            "verseOrgIds": [
              "1CO.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga kanshi kuti twacita shani, mwe bamunyinane? Ilyo mwalongana kukupepa, umuntu umo alesamuna ulwimbo, umbi eo afunde, umbi nao ashimike amashiwi ayo Lesa amusokolwelele, umbi nao alande mu ndimi ishalekana lekana, elyo pabe no wakwilula ifyalandwa. Nomba fyonse ifi fibe ifyakuwamina ulukuta. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.26",
            "verseOrgIds": [
              "1CO.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CO 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga cakuti kwaba abakulanda mu ndimi ishalekana lekana, muleke babili nangu batatu ebo balande, lelo balelekanina pakulanda. Kabili kube umo uwakwilula ifyo balanda. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.27",
            "verseOrgIds": [
              "1CO.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CO 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomba nga tapali nelyo umo uwakwilula ifyo alelanda, ninshi ekalefye tondolo, alandefye umwine mu mutima na Lesa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.28",
            "verseOrgIds": [
              "1CO.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CO 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakusesema amashiwi yakwa Lesa babe babili nangu batatu, lelo kwena pabe bambi abakupingula pafyo balanda. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.29",
            "verseOrgIds": [
              "1CO.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CO 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa bekele mukupepa, nga umo Lesa amusokolwela amashiwi, ninshi uwacilalanda ekale tondolo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.30",
            "verseOrgIds": [
              "1CO.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CO 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulelekanina bonse pakusesema amashiwi yakwa Lesa. Lyena bonse kuti mwasambililako, elyo nefyo balanda kuti fyamukoselesha. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.31",
            "verseOrgIds": [
              "1CO.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CO 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakasesema baliba na maka yakwishiba ilyakusesema amashiwi yakwa Lesa nelyo bashingasesema. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.32",
            "verseOrgIds": [
              "1CO.14.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CO 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pantu Lesa tafwaya cimfulunganya kano icibote. Kanshi ngefyo caba konse mu nkuta sha bamushilo, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.33",
            "verseOrgIds": [
              "1CO.14.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CO 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "abanakashi bena bali nokwikalafye tondolo mu nkuta. Pantu bena tacasuminishiwa ukulandapo. Efyo na Mafunde yakwa Mose yatila, umwanakashi ali nokupetamina wiba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.34",
            "verseOrgIds": [
              "1CO.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CO 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga balefwaya ukwipushapo cimo, ninshi kuti baya ipusha abalume babo ku ŋanda kumwabo. Pantu cansoni nganshi umwanakashi ukulanda mu lukuta.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.35",
            "verseOrgIds": [
              "1CO.14.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CO 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.35",
            "verseOrgIds": [
              "1CO.14.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CO 14:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bushe ni kuli imwe amashiwi yakwa Lesa yatula? Nangu bushe nimwefye mweka yaishila? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.36",
            "verseOrgIds": [
              "1CO.14.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CO 14:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi uyo onse uuletontonkanya ukuti ni kasesema, nangu aliba no bupe bumbi ubo Mupashi amupeela, ashininkishe ukuti ifyo namulembela efyo Imfumu yakonkomesha. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.37",
            "verseOrgIds": [
              "1CO.14.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CO 14:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga tasakamene ifi, ninshi na imwe mwilamusakamana.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.38",
            "verseOrgIds": [
              "1CO.14.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CO 14:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.38",
            "verseOrgIds": [
              "1CO.14.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CO 14:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eico kanshi bamunyinane, sakamaneni ukusesema amashiwi yakwa Lesa. Kabili mwilalesha abalelanda mu ndimi ishalekana lekana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.39",
            "verseOrgIds": [
              "1CO.14.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CO 14:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo fyonse filecitika bwino bwino kabili ukwabula icimfulunganya.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.40",
            "verseOrgIds": [
              "1CO.14.40"
            ]
          }
        }
      ]
    }
