          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Yerusalemu, we Yerusalemu, we wipaya bakasesema no kwipaya ku mabwe inkombe Lesa akutumina! Yangu imiku ubwingi iyo nalefwaya ukulonganya bamwano, nga filya nankoko afukatila tumwane mu mapindo, nomba tawalefwaya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.37",
            "verseOrgIds": [
              "MAT.23.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 23:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mona, iŋanda yobe ikakushalila icipompa! ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.38",
            "verseOrgIds": [
              "MAT.23.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 23:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.118.26"
              },
              "items": [
                {
                  "text": "Amalu 118:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lelo ndekweba nati, ine tawakamone nakabili, mpaka ilyo ukasosa auti, ‘Napaalwe uyu waisa uo Imfumu yatuma.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.39",
            "verseOrgIds": [
              "MAT.23.39"
            ]
