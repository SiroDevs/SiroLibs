            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.23",
            "verseOrgIds": [
              "MAT.23.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.27.30"
              },
              "items": [
                {
                  "text": "Levi 27:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mukacimona, mwe bakafundisha bamafunde, na imwe, mwe Bafalise, mwe mfundabuteshi! Mwe batuula Lesa cimo pekumi lyonse, na pa misalufye iyakuwamya ifyakulya. Lelo mwalisuula ukukonka amafunde ayakalamba mu Mafunde yakwa Mose, ayali ngo mulinganya, uluse ne cishinka. Aya e mafunde mwaba nokukonka, elyo na yambi yene tamuli nakuyasuulako. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.23",
            "verseOrgIds": [
              "MAT.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwe ntungulushi shapofula mwe! Mufwisa akashishi, lelo mucibula ingamila!",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.24",
            "verseOrgIds": [
              "MAT.23.24"
            ]
          }
        }
      ]
    },
    {
