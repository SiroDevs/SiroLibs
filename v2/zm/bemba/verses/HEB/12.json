              },
              "items": [
                {
                  "text": "21:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kanshi kosheni amaboko yenu ayanakuka na makufi yenu ayaletutuma. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.12",
            "verseOrgIds": [
              "HEB.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.4.26"
              },
              "items": [
                {
                  "text": "Amap 4:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mulinganye inshila umwakupita amakasa yenu, epakuti ayalemana yeicena, lelo pakuti yamone ukupola.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.13",
            "verseOrgIds": [
              "HEB.12.13"
            ]
          }
        }
      ]
    },
    {
