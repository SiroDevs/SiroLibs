          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.13",
            "verseOrgIds": [
              "HEB.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lyonse mulefwaya ukwikala no muntu onse mu mutende no kuba abamushilo, pantu ukwabula ukuba uwamushilo, umuntu nelyo umo takamone Imfumu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.14",
            "verseOrgIds": [
              "HEB.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.29.18"
              },
              "items": [
                {
                  "text": "Amaf 29:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mulecenjela pakuti umuntu nelyo umo elafutatila cikuuku cakwa Lesa. Mwileka nelyo umo aluke umushila uwalula, uwakuti cilya wakula walacusha abantu no kubakowesha. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.15",
            "verseOrgIds": [
              "HEB.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.25.29+GEN.25.30+GEN.25.31+GEN.25.32+GEN.25.33+GEN.25.34"
              },
              "items": [
                {
                  "text": "Icite 25:29-34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwileka nelyo umo abe cilende nangu uushisakamana Lesa nga Esau, uwashitishe insambu shakwe ishakuba ibeli pakulya icakulya umukufye umo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.16",
            "verseOrgIds": [
              "HEB.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.27.30+GEN.27.31+GEN.27.32+GEN.27.33+GEN.27.34+GEN.27.35+GEN.27.36+GEN.27.37+GEN.27.38+GEN.27.39+GEN.27.40"
              },
              "items": [
                {
                  "text": "Icite 27:30-40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwalishiba ukuti panuma alefwaya ukupoka ipaalo ilyabubeli kuli wishi, lelo alimukeenye. Pantu nangu alefwaisha ipaalo uku alelila ne filamba, alifililwe ukusanga inshila yakwalula ico acitile.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.17",
            "verseOrgIds": [
              "HEB.12.17"
            ]
          }
        }
      ]
    },
