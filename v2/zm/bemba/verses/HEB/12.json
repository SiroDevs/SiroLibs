              },
              "items": [
                {
                  "text": "Amap 3:11-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bushe mwalilaba amashiwi yacikoseleshi ayo Lesa alanda kuli imwe bamwane ayakuti,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.5",
            "verseOrgIds": [
              "HEB.12.5"
            ]
