                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi Mupashi Wamushilo asosa ati,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.7",
            "verseOrgIds": [
              "HEB.3.7"
            ]
          }
        }
