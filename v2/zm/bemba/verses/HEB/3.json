            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.18",
            "verseOrgIds": [
              "HEB.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi twamona ukuti, ico abo bantu bafililwe ukwingila, nico bashasumine.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.19",
            "verseOrgIds": [
              "HEB.3.19"
            ]
          }
        }
      ]
    }
