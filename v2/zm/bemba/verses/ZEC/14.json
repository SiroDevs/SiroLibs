          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.23.39+LEV.23.40+LEV.23.41+LEV.23.42+LEV.23.43"
              },
              "items": [
                {
                  "text": "Levi 23:39-43",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo abalwani bakacimba, elyo aba mishobo bonse abakashalapo bakalaya imyaka yonse ku Yerusalemu, kukupepa Imfumu Yawe umwine wa fita, na kukusefya inshikunkulu ya Nsakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.16",
            "verseOrgIds": [
              "ZEC.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ZEC 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umushobo wa bantu umo pano isonde uukalakaana ukuya ku Yerusalemu kukupepa Imfumu Yawe umwine wa fita, awe wena ninshi mu calo cauko tamwakaleloka imfula nakalya. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.17",
            "verseOrgIds": [
              "ZEC.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ZEC 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abena Egupto nga balakaana ukulaisako no kubuulamo ulubali ninshi nabo bene bakaponenwa ne cikuko, ico Yawe akalaletela abantu ba mishobo yonse umo umo, abakalakaana ukulaya kukucindika inshikunkulu ya Nsakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.18",
            "verseOrgIds": [
              "ZEC.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ZEC 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efyo abena Egupto bakalalimunwa pamo na bantu ba mishobo imbi yonse abakalakaana ukulaya kukusefya inshikunkulu ya Nsakwe.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.19",
            "verseOrgIds": [
              "ZEC.14.19"
            ]
          }
        }
      ]
    },
