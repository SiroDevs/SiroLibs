              "ZEC.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ZEC 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifi efyo Yawe umwine wa fita asosa ati, “Muli shilya nshiku abenafyalo ikumi limo ukufuma ku mishobo ya ndimi ishalekana lekana shonse, bakalaisa ku Muyuda umo ninshi nabekata ku cakufwala cakwe no kulamweba abati, ‘Tulefwaya tuye nobe, pantu ifwe twalyumfwa ukuti Lesa aba na imwe.’”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.23",
            "verseOrgIds": [
              "ZEC.8.23"
            ]
          }
        }
      ]
