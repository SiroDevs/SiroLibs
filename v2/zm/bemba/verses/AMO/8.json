            "sid": "AMO 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Yawe anjipusha ati, “Amosi, bushe finshi ulemona?”",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.2",
            "verseOrgIds": [
              "AMO.8.2"
            ]
          }
        }
      ]
    },
