        {
          "text": "Kabili Imfumu Yawe alinangile ine icintu cimbi mu cimonwa. Namwenemo umuseke uwa fitwalo ifyapya mu lusuba. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.1",
            "verseOrgIds": [
              "AMO.8.1"
            ]
          }
        },
        {
