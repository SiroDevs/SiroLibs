          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mawanga ya Moabu mu lulamba lwa Yordani, ukulungatana no musumba wa Yeriko, Yawe aebele Mose ati, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.50",
            "verseOrgIds": [
              "NUM.33.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "NUM 33:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Landa ku bena Israeli utile kuli bena, ‘Nga mwayabuka umumana wa Yordani, mwaya mu Kenani, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.51",
            "verseOrgIds": [
              "NUM.33.51"
            ]
          }
        },
