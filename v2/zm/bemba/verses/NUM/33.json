            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo bafuma ku Salimona, bacita inkambi ku Punoni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.42",
            "verseOrgIds": [
              "NUM.33.42"
