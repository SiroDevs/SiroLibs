              "items": [
                {
                  "text": "12:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "mufwile ukufulumunamo bonse abekalamo ku cinso cenu. Kabili monaule utulubi utwabaswa no twabumbwa, elyo mubongolole ne ncende shonse shakupepelamo isho bacindika. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.52",
            "verseOrgIds": [
              "NUM.33.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "NUM 33:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pokeni icalo, muleikalamo pantu nimupeela icalo ukuba cenu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.53",
            "verseOrgIds": [
              "NUM.33.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "NUM 33:54"
          },
          "items": [
