              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.26.54+NUM.26.55+NUM.26.56"
              },
              "items": [
                {
                  "text": "Imp 26:54-56",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pakwakana icalo mukalependula ukulingana ne nko shenu. Uluko ulukalamba mukalupeele impanga iyikalamba, no luko ulunono mukalupeele impanga inono. Conse icasuminishiwa pakupendula cikaba e cipande ca mpanga yabo. Yakaneni ukulingana ne nko sha fikolwe fyenu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.54",
            "verseOrgIds": [
              "NUM.33.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "NUM 33:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo nga mwafilwa ukufulumunamo bonse abekalamo mu calo, abo mukashamo bakaba fyakumusonkola mu menso yenu, kabili nge myunga mu mbafu shenu. Bakalamucusha mu calo umo mukekala. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.55",
            "verseOrgIds": [
              "NUM.33.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "NUM 33:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo nomba na ine nkamucitila ifyo napanga ukubacitila.’”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.56",
            "verseOrgIds": [
              "NUM.33.56"
            ]
          }
        }
      ]
