          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo bafuma ku Oboti, bacita inkambi ku Iye Habarimu mu mupaka wa Moabu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.44",
            "verseOrgIds": [
