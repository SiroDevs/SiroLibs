          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo bafuma ku Refidimu, bacita inkambi mu matololo ya Sinai. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.15",
            "verseOrgIds": [
              "NUM.33.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo bafuma ku matololo ya Sinai, baya cita inkambi ku Kibroti Hatafa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.16",
            "verseOrgIds": [
              "NUM.33.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo bafuma ku Kibroti Hatafa, baya cita inkambi ku Haseloti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.17",
            "verseOrgIds": [
              "NUM.33.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo bafuma ku Haseloti, baya cita inkambi ku Ritima. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.18",
            "verseOrgIds": [
              "NUM.33.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 33:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo bafuma ku Ritima, baya cita inkambi ku Rimoni Peresi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.19",
            "verseOrgIds": [
              "NUM.33.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo bafuma ku Rimoni Peresi, baya cita inkambi ku Libina. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.20",
            "verseOrgIds": [
              "NUM.33.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 33:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo bafuma ku Libina, baya cita inkambi ku Risa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.21",
            "verseOrgIds": [
              "NUM.33.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 33:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo bafuma ku Risa, baya cita inkambi ku Keelata. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.22",
            "verseOrgIds": [
              "NUM.33.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 33:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo bafuma ku Keelata, bacita inkambi ku lupili lwa Shefa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.23",
            "verseOrgIds": [
              "NUM.33.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 33:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo bafuma ku lupili lwa Shefa, baya cita inkambi ku Harada. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.24",
            "verseOrgIds": [
              "NUM.33.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 33:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo bafuma ku Harada, baya cita inkambi ku Makeloti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.25",
            "verseOrgIds": [
              "NUM.33.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 33:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo bafuma ku Makeloti, baya cita inkambi ku Tahati. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.26",
            "verseOrgIds": [
              "NUM.33.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 33:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo bafuma ku Tahati, baya cita inkambi ku Tera. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.27",
            "verseOrgIds": [
              "NUM.33.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 33:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo bafuma ku Tera, baya cita inkambi ku Mitika. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.28",
            "verseOrgIds": [
              "NUM.33.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 33:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo bafuma ku Mitika, baya cita inkambi ku Hashimona. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.29",
            "verseOrgIds": [
              "NUM.33.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 33:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo bafuma ku Hashimona, baya cita inkambi ku Moseroti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.30",
            "verseOrgIds": [
              "NUM.33.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 33:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo bafuma ku Moseroti, baya cita inkambi ku bena Yaakani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.31",
            "verseOrgIds": [
              "NUM.33.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 33:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo bafuma ku bena Yaakani, bacita inkambi ku Hagidigadi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.32",
            "verseOrgIds": [
              "NUM.33.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 33:33"
          },
          "items": [
            {
              "text": "33",
