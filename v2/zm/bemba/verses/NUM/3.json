        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifi efyali ulupwa lwakwa Aroni na Mose pa nshita Yawe alandile na Mose pa lupili lwa Sinai. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.1",
            "verseOrgIds": [
              "NUM.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.26.60"
              },
              "items": [
                {
                  "text": "Imp 26:60",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bamwana Aroni abaume bali Nadabu, e beli, Abihu, Eleasa na Itama. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.2",
            "verseOrgIds": [
              "NUM.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya e mashina ya bamwana Aroni, ebasubilwe amafuta no kupeelwa bushimapepo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.3",
            "verseOrgIds": [
              "NUM.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.10.1+LEV.10.2"
              },
              "items": [
                {
                  "text": "Levi 10:1-2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.26.61"
              },
              "items": [
                {
                  "text": "Imp 26:61",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lelo Nadabu na Abihu bafwilile pa cinso cakwa Yawe mu matololo ya Sinai, ilyo batuulile Yawe umulilo ushasuminishiwe. Tabakwete abana baume, kanshi Eleasa na Itama ebalebomba umulimo wa bushimapepo ilyo shibo Aroni ali talafwa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.4",
            "verseOrgIds": [
              "NUM.3.4"
            ]
          }
        }
      ]
    },
