            "number": "27",
            "style": "v",
            "sid": "NUM 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu lupwa lwakwa Koati emwatuntuka abena Amuramu, abena Isirahiya, abena Hebuloni na bena Usieli. Ishi e ndupwa shakwa Koati. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.27",
            "verseOrgIds": [
              "NUM.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Impendwa yonse pamo iya baume abena Koati abalebomba umulimo wakusunga icifulo camushilo, abapendelwe ukutampila pa bali no mweshi umo no kucilapo, yali amakana cine konse konse ne myanda mutanda (8,600). ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.28",
            "verseOrgIds": [
              "NUM.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indupwa shakwa Koati shali nokwikala ku kapinda ka ku kulyo ake Tenti lyakwa Lesa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.29",
            "verseOrgIds": [
              "NUM.3.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Intungulushi ya bena Koati ni Elisafani, mwana Usieli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.30",
            "verseOrgIds": [
              "NUM.3.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imilimo abena Koati balebomba, kusunga Imbokoshi ya Cipangano, itebulo, icakutekapo ifisaniko, ifibumbili fya malambo, ifipe bashimapepo balebomfya mu cifulo camushilo, icisalu na fyonse ifyakumine ku milimo balebomba.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.31",
            "verseOrgIds": [
              "NUM.3.31"
            ]
          }
        }
      ]
    },
    {
