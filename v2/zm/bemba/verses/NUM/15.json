              "items": [
                {
                  "text": "Levi 23:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yawe aebele Mose ati, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.17",
            "verseOrgIds": [
              "NUM.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Landa ku bena Israeli no kubeba auti, nga mwaingila mu calo ico ndi nokumutwalamo, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.18",
            "verseOrgIds": [
              "NUM.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kabili nga mwalalya icakulya ca muli ici calo, mukalefumyapo fimo ifyamutuulo kuli Yawe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.19",
            "verseOrgIds": [
              "NUM.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku bunga bwenu ubwantanshi mukalepangako umukate no kuutuula nga filya fine mutuula umutuulo wa pa kupwa kwa kusokola iŋanu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.20",
            "verseOrgIds": [
              "NUM.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu nkulo shenu shonse ishikakonkapo, mukaletuula umutuulo kuli Yawe ku mukate mukabalilapo ukupanga.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.21",
            "verseOrgIds": [
              "NUM.15.21"
            ]
          }
        }
      ]
    },
