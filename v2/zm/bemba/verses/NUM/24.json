            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Balamu alanda ubusesemo bwakwe ati,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.15",
            "verseOrgIds": [
              "NUM.24.15"
            ]
