          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.13",
            "verseOrgIds": [
              "NUM.34.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.14.1+JOS.14.2+JOS.14.3+JOS.14.4+JOS.14.5"
              },
              "items": [
                {
                  "text": "Yosh 14:1-5",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose akonkomeshe abena Israeli ati, “Penduleni pakwakana ici calo nge ca cishilano. Yawe nalanda ukucipeela ku nko pabula na citika, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.13",
            "verseOrgIds": [
              "NUM.34.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "pantu indupwa sha luko lwakwa Rubeni no luko lwakwa Gadi no luko citika ulwakwa Manase, nabapoka ica cishilano cabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.14",
            "verseOrgIds": [
              "NUM.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishi nko shibili na citika nashipoka ica cishilano cabo lwa ku kabanga ukutulila akasuba ku Yordani na Yeriko.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.15",
            "verseOrgIds": [
              "NUM.34.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.15",
            "verseOrgIds": [
              "NUM.34.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe aebele Mose ati, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.16",
            "verseOrgIds": [
              "NUM.34.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aya e mashina ya baume bali nokwakanya icalo nge ca cishilano, Eleasa shimapepo na Yoshua umwana mwaume wakwa Nuni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.17",
            "verseOrgIds": [
              "NUM.34.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo sontapo intungulushi imo muli cila luko iyakwafwilisha ukwakanya icalo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.18",
            "verseOrgIds": [
              "NUM.34.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 34:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya e mashina yabo, Kalebu umwana mwaume wakwa Yefune, uwa mu luko lwakwa Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.19",
            "verseOrgIds": [
              "NUM.34.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 34:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shemueli umwana mwaume wakwa Amiudi, intungulushi ukufuma mu luko lwakwa Simeoni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.20",
            "verseOrgIds": [
              "NUM.34.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elidadi umwana mwaume wakwa Kisiloni, intungulushi ukufuma mu luko lwakwa Benjamini. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.21",
            "verseOrgIds": [
              "NUM.34.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 34:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buki umwana mwaume wakwa Yogili, intungulushi ukufuma mu luko lwakwa Dani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.22",
            "verseOrgIds": [
              "NUM.34.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 34:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanieli Amieli umwana mwaume wakwa Efodi, intungulushi ukufuma mu luko lwakwa Manase umwana mwaume wakwa Yosefu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.23",
            "verseOrgIds": [
              "NUM.34.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kemueli umwana mwaume wakwa Shipitani, intungulushi ukufuma mu luko lwakwa Efulemu umwana mwaume wakwa Yosefu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.24",
            "verseOrgIds": [
              "NUM.34.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 34:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisafani umwana mwaume wakwa Panaki, intungulushi ukufuma mu luko lwakwa Sebuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.25",
            "verseOrgIds": [
              "NUM.34.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Palitieli umwana mwaume wakwa Asani, intungulushi ukufuma mu luko lwakwa Isaka. ",
