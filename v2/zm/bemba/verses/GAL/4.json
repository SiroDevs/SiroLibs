              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomba imwe bamunyinane, pamo nga Isaki imwe muli bana ba cilayo cakwa Lesa. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.28",
            "verseOrgIds": [
              "GAL.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GAL 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa nshita ilya, umwana ulya wafyelwe nga filya fifyalwa abantu bonse, alecusha umwana uwafyelwe ku maka yakwa Mupashi wakwa Lesa. Kanshi ifyo fine efilecitika na nomba. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.29",
            "verseOrgIds": [
              "GAL.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
