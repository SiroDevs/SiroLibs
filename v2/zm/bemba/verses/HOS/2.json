              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.17",
            "verseOrgIds": [
              "HOS.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HOS 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Muli bulya bushiku, ine nkabapangila icipangano ne nama sha mpanga, ne fyuni fya mu lwelele, ne fikulika panshi. Nkafumya mu calo ifyanso fyonse ifili nge mpanga na mata, elyo ne nkondo ine, epakuti abantu bandi bakaleikala umutelelwe.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.18",
            "verseOrgIds": [
              "HOS.2.18"
            ]
          }
        }
      ]
    }
