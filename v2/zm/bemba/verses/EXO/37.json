          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abashileko ne fimuti fyakupingilako ku cimuti ca akasia, alambatikeko na golide. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.28",
