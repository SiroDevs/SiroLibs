                "loc": "ACT.7.40"
              },
              "items": [
                {
                  "text": "Imili 7:40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.41"
              },
              "items": [
                {
                  "text": "41",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ilyo abantu bamwene ukuti Mose akokola nganshi pa lupili ukwabula ukubwela, baile longana kuli Aroni balamweba abati, “Ale tupangile imilungu",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.1",
            "verseOrgIds": [
              "EXO.32.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "32:1",
              "type": "text"
            },
            {
              "text": "Muli ba Baibele bambi makamaka abashili bakale nganshi.",
              "type": "text"
            }
          ]
        },
        {
          "text": " yakuti iletutangilila, pantu tatwishibe icaponena ulya Mose uwatufumishe mu Egupto.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.1",
            "verseOrgIds": [
              "EXO.32.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 32:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.1",
            "verseOrgIds": [
              "EXO.32.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni abaswike ati, “Fuuleni amasikiyo aya golide ku bakashi benu, ku bana benu abaume na banakashi, mulete kuli ine.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.2",
            "verseOrgIds": [
              "EXO.32.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 32:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awe abantu bonse epakufuula ku matwi amasikiyo aya golide, batwala na kuli Aroni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.3",
            "verseOrgIds": [
              "EXO.32.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.12.28"
              },
              "items": [
                {
                  "text": "1 Isham 12:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.41"
              },
              "items": [
                {
                  "text": "Imili 7:41",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aroni nao afibuula afyengulula, apangamo icapala iciponti ca ŋombe. Elyo abantu basosa ati, “Iyi e milungu yobe we Israeli iyakufumishe mu Egupto!”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.4",
            "verseOrgIds": [
              "EXO.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.4",
            "verseOrgIds": [
              "EXO.32.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo Aroni amwene ifi, akuulile no bulambo pa ntanshi ya ciponti ca ŋombe ica golide, abila ne mbila ati, “Mailo kukabe inshikunkulu yakucindika Yawe.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.5",
            "verseOrgIds": [
              "EXO.32.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 32:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.10.7"
              },
              "items": [
                {
                  "text": "1 Kol 10:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ubushiku bwakonkelepo abantu baimine ulucelocelo, balaleka amalambo yakoca, batuula ne mitulo yakwampana. Kabili baikele panshi balalya no kunwa elyo baima balayangala bubi bubi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.6",
            "verseOrgIds": [
              "EXO.32.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 32:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Yawe aebele Mose ati, “Tentemukila ku bantu bobe wafumishe mu calo ca Egupto pantu nabalubana. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.7",
            "verseOrgIds": [
              "EXO.32.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabaluka bwangu bwangu ukufuma kufyo nabakonkomeshe, nabaipangila akalubi mu cipasho ca ciponti ca ŋombe. Balekafukamina no kukocela amalambo baleti nokuti, ‘Iyi e milungu yobe we Israeli iyakufumishe mu Egupto.’” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.8",
            "verseOrgIds": [
              "EXO.32.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 32:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe kabili aebele Mose ati, “Nimona, aba bantu ni bankosa mitwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.9",
            "verseOrgIds": [
              "EXO.32.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi nomba ndekafye, nimbafulilwa nganshi ndebalofya. Elyo iwe nkakucita umushobo ukalamba.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.10",
            "verseOrgIds": [
              "EXO.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.10",
            "verseOrgIds": [
              "EXO.32.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 32:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.11",
            "verseOrgIds": [
              "EXO.32.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.13+NUM.14.14+NUM.14.15+NUM.14.16+NUM.14.17+NUM.14.18+NUM.14.19"
              },
              "items": [
                {
                  "text": "Imp 14:13-19",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo Mose apapete Yawe, Lesa wakwe, ati, “Bushe cinshi we Yawe wafulilwa nganshi abantu bobe abo wafumishe mu calo ca Egupto ku bulamba bobe no kuboko kobe ukwamaka? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.11",
            "verseOrgIds": [
              "EXO.32.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 32:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bushe abena Egupto teti batile, akwete amapange yabi eco abafumishe mu Egupto, pakuti akaye bepaila ku mpili no kubalofya mpanga yonse pano isonde lyonse? Ala bwesha umutima, wileta ne cinkunka ico upangile ukucita abantu bobe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.12",
            "verseOrgIds": [
              "EXO.32.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 32:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.22.16+GEN.22.17"
              },
              "items": [
                {
                  "text": "Icite 22:16-17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.17.8"
              },
              "items": [
                {
                  "text": "17:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ibukisha ababomfi bobe Abrahamu, Isaki na Israeli abo walaile no mulapo we mwine auti, ‘Nkalenga aba mu lupwa lobe ukufula nganshi nge ntanda sha mu mulu. Nkapeela na bana benu icalo conse cilya nabalaile, kabili cikaba e calo ca cishilano cabo pe.’” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.13",
            "verseOrgIds": [
              "EXO.32.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 32:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awe Yawe abweseshe umutima, kabili akaana no konaula abantu bakwe ngefyo apangile ukucita.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.14",
            "verseOrgIds": [
              "EXO.32.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 32:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.14",
            "verseOrgIds": [
              "EXO.32.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 32:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose apilibwike alatentemuka no lupili ninshi nasenda mu minwe yakwe amabwe yabili ayapapatala aya cipangano, apalembelwe amafunde ku mbali shonse shibili, kunuma elyo na kuntanshi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.15",
            "verseOrgIds": [
              "EXO.32.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 32:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni Lesa ewabashile amabwe ayapapatala, ne filembo ni Lesa ewafilembelepo, afifukwile pa mabwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.16",
            "verseOrgIds": [
              "EXO.32.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 32:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.16",
            "verseOrgIds": [
              "EXO.32.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 32:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo Yoshua aumfwa uko abantu balecita icongo, aeba Mose ati, “Ndeumfwa icongo ca lubuli mu nkambi.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.17",
            "verseOrgIds": [
              "EXO.32.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 32:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.17",
            "verseOrgIds": [
              "EXO.32.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 32:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose ayasuka ati,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.18",
            "verseOrgIds": [
              "EXO.32.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 32:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.18",
            "verseOrgIds": [
              "EXO.32.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 32:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomba ilyo Mose apaleme ku nkambi no kumona iciponti ca ŋombe na balecinda, afulwa nganshi. Awe aposa na mabwe asendele mu minwe, ayatobaula no kutobaula lwa mwisamba lya lupili. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.19",
            "verseOrgIds": [
              "EXO.32.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 32:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili abuula iciponti ca ŋombe ico bapangile, acoca mu mulilo. Elyo acipela caba ngo lukungu, anyunya pa menshi, anwesha na bena Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.20",
            "verseOrgIds": [
              "EXO.32.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 32:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo aipusha Aroni ati, “Bushe cinshi ico abantu bakucitile epakuti uleke bacite ububifi ubwakula ifi?”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.21",
            "verseOrgIds": [
              "EXO.32.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 32:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.21",
            "verseOrgIds": [
              "EXO.32.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 32:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni nao ayaswike ati, “Ala we mfumu yandi wifulwa. Iwe walishiba ifyo aba bantu baobelwa kukubifya. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.22",
            "verseOrgIds": [
              "EXO.32.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 32:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banjebele abati, ‘Tatwishibe icaponena ulya Mose atufumishe mu Egupto. Kanshi tupangile imilungu iyakuti iletutangilila.’ ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.23",
            "verseOrgIds": [
              "EXO.32.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 32:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eco kanshi nabebele nati, ‘Onse uukwete ifisamo ifyakuiyemfya ifya golide afuule. Awe nabo bampeela, na ine nafiposa mu mulilo elyo mwafuma neci ciponti ca ŋombe.’”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.24",
            "verseOrgIds": [
              "EXO.32.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 32:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.24",
            "verseOrgIds": [
              "EXO.32.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 32:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose amwene ukuti abantu nabafulungana, no walekele ukuti bafulungane ni Aroni, kabili na balwani babo balebaseka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.25",
            "verseOrgIds": [
              "EXO.32.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 32:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose epakuya iminina pa mpongolo ya nkambi, asosa ati, “Bonse abo abali ku lubali lwakwa Yawe nabese kuli ine.” Awe na bena Levi bonse balongana uko ali. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.26",
            "verseOrgIds": [
              "EXO.32.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 32:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao abeba ati, “Yawe, Lesa wakwa Israeli, nasosa ati, ‘Umwaume onse apikile ulupanga, elyo mucilinganye inkambi ukufuma ku lutwe lumo muye fika ku lubiye no kubweluluka cila umo epaye munyina, icibusa cakwe elyo no mwina mupalamano wakwe.’” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.27",
            "verseOrgIds": [
              "EXO.32.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 32:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awe abena Levi nabo bacitile ngefyo Mose abakonkomeshe, na mu bushiku bulya mwafwile abantu ni cikanga amakana yatatu (3,000). ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.28",
            "verseOrgIds": [
              "EXO.32.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 32:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Mose asosa ati, “Imwe mu bushiku bwa lelo mwapatwilwa kuli Yawe, pantu namwipaya abana benu abaume na bamunyinenwe abaume kanshi eco Yawe amupaalila ubushiku bwa lelo.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.29",
            "verseOrgIds": [
              "EXO.32.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 32:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.29",
            "verseOrgIds": [
              "EXO.32.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 32:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubushiku bwakonkelepo Mose aebele abantu ati, “Namubifya apakalamba nganshi. Nomba ine nalaya nina ulupili kuli Yawe, nalimo kuti naya mufutilako pa kubifya kwenu.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.30",
            "verseOrgIds": [
              "EXO.32.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi Mose epakubwelela kuli Yawe amweba ati, “Iyee, aba bantu nababifya apakalamba nganshi. Nabaipangila abene imilungu ya golide. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.31",
            "verseOrgIds": [
              "EXO.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.69.28"
              },
              "items": [
                {
                  "text": "Amalu 69:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.3.5"
              },
              "items": [
                {
                  "text": "Ubuso 3:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lelo nomba napapata, babeleleniko uluse pa bubifi bwabo. Lelo nga teifyo, ninshi ufuute ishina lyandi mu citabo walilemba.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.32",
            "verseOrgIds": [
              "EXO.32.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 32:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe nao ayasuka Mose ati, “Awe, uo ndefuuta mu citabo candi ni uyo onse uumbifishe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.33",
            "verseOrgIds": [
              "EXO.32.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 32:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ale nomba kabiye katungulule abantu ku ncende nakwebele, na malaika wandi alekutungulula. Lelo ilyo inshita yakuti ine nkabakande ikafika, nkabakandilapo pali ubu bubifi bwabo.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.34",
            "verseOrgIds": [
              "EXO.32.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 32:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.34",
            "verseOrgIds": [
              "EXO.32.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 32:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Yawe aponeshe icikuko pa bantu pa mulandu wa fintu bacitile ku ciponti ca ŋombe cintu Aroni apangile.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.35",
            "verseOrgIds": [
              "EXO.32.35"
            ]
          }
        }
      ]
