          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Mose ashimikilako Aroni ifintu fyonse ifyo Yawe amutumine kukubeba, ne fisungusho fyonse ifintu amukonkomeshe ukuya cita. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.28",
            "verseOrgIds": [
              "EXO.4.28"
            ]
          }
        },
        {
          "name": "verse",
