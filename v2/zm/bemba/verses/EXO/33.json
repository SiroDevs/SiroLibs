          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo ubucindami bwandi bwalaisa mukupita, ine ndeisa kubika mu lucengo lwa cilibwe, ndeisa kufimba no lupi lwandi mpaka mpitepo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.22",
            "verseOrgIds": [
              "EXO.33.22"
            ]
          }
        },
        {
          "name": "verse",
