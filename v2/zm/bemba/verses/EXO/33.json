          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo ndeisa fumyapo ulupi lwandi, pakuti wise umonekofye inuma yandi. Lelo icinso candi cena tacifwile ukumonwa.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.23",
