              "EXO.33.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 33:19"
          },
          "items": [
            {
              "text": "19",
