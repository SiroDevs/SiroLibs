              "EXO.33.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.15"
              },
              "items": [
                {
                  "text": "Roma 9:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili Yawe amwasuka ati, “Nalaleka ubusuma bwandi bonse bupite pa cinso cobe, kabili ndebila ne shina lyandi pa cinso cobe ukuti nine Yawe. Ine mbelela uluse uo ndefwaya ukubelela uluse, nangulukila uo ndefwaya ukulangulukila.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.19",
            "verseOrgIds": [
              "EXO.33.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo Yawe amweba ati, “Teti iwe umone icinso candi, pantu takuli uwingamona ine no kuba umumi.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.20",
            "verseOrgIds": [
              "EXO.33.20"
            ]
          }
        }
      ]
    },
