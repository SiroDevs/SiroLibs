              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili Yawe atila, “Mona, pano ine ndi pali incende mupepi apo wingeminina pa cilibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.21",
            "verseOrgIds": [
              "EXO.33.21"
            ]
          }
        },
        {
          "name": "verse",
