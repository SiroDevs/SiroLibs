          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili muli bulya bwine bushiku Yawe afumishe abena Israeli bonse mu calo ca Egupto mu mpuka mu mpuka shabo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.51",
