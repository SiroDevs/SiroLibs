                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.23.6+LEV.23.7+LEV.23.8"
              },
              "items": [
                {
                  "text": "Levi 23:6-8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.28.17+NUM.28.18+NUM.28.19+NUM.28.20+NUM.28.21+NUM.28.22+NUM.28.23+NUM.28.24+NUM.28.25"
              },
              "items": [
                {
                  "text": "Imp 28:17-25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.3+DEU.16.4+DEU.16.5+DEU.16.6+DEU.16.7+DEU.16.8"
              },
              "items": [
                {
                  "text": "Amaf 16:3-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Mukaleibukisha ubu bushiku mu nkulo shenu shonse. Mukalebusefya nge nshikunkulu yakwa Yawe. Ili lifunde lyakubelelela. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.14",
            "verseOrgIds": [
              "EXO.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa nshiku cine lubali mukalelya imikate iyabulamo intutumushi. Pa bushiku bwakubalilapo mukafumye intutumushi yonse mu mayanda yenu. Nga cakuti umo alya icilimo intutumushi mu nshiku ishi cine lubali, wakutamfyafye mu bena Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.15",
            "verseOrgIds": [
              "EXO.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukakwata ukulongana kwamushilo pa bushiku bwakubalilapo elyo na pa bwalenga cine lubali. Mwikalabombamo umulimo nelyo umo muli ishi nshiku, kanofye ukupekanya icakulya ca muntu onse. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.16",
            "verseOrgIds": [
              "EXO.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muli nokulasefya inshikunkulu ya Mikate Ishatutumuka pantu ni pali ubu bushiku nafumishe impuka shenu shonse mu calo ca Egupto. Mukalasefya ubu bushiku mu nkulo shenu shonse, ili lifunde lyakubelelela. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.17",
            "verseOrgIds": [
              "EXO.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mweshi wakubalilapo, ukufuma icungulo ca bushiku ubwalenga ikumi limo na shine (14) ukufika pa cungulo ca bushiku bwalenga amakumi yabili na bumo (21) cungulo, mukalelya umukate ushabamo intutumushi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.18",
            "verseOrgIds": [
              "EXO.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muli ishi nshiku cine lubali, intutumushi taili nakusangwa mu mayanda yenu. Noyo onse uukalya icintu umuli intutumushi, wakutamfyafye mu lukuta lwa bena Israeli, nangu abe umweni nangu mwana calo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.19",
            "verseOrgIds": [
              "EXO.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwikalya cintu nangu cimo umuli intutumushi. Konse uko muli, mukalelya umukate umwabula intutumushi.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.20",
            "verseOrgIds": [
              "EXO.12.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.20",
            "verseOrgIds": [
              "EXO.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Mose aitile abakalamba bonse aba mu bena Israeli abeba ati, “Kabiyeni nombaline, muye salila indupwa shenu inama, mwipaye umwana wa mpaanga wa pe Pasaka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.21",
            "verseOrgIds": [
              "EXO.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubuule utumisambo twa hisopo ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.22",
            "verseOrgIds": [
              "EXO.12.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "12:22",
              "type": "text"
            },
            {
              "text": "Hisopo:",
              "type": "text"
            },
            {
              "text": "Kampusa akapala lwena.",
              "type": "text"
            }
          ]
        },
        {
          "text": " mutumpike mu mulopa uuli mu lunweno, mushinge pamulu elyo na mumbali ya filu fya pa mwinshi wa ŋanda. Kwikaba nelyo umo uwakufumina panse mpaka ulucelo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.22",
            "verseOrgIds": [
              "EXO.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.28"
              },
              "items": [
                {
                  "text": "Bahi 11:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ilyo Yawe akalapita mu calo conse ica Egupto kukwipaya abena Egupto, akalacilila nga amona umulopa ku filu fya pa mwinshi na pa mulu wa ciibi. Yawe akalesha malaika wa mfwa ukwingila mu ŋanda yenu no kumwipaya. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.23",
            "verseOrgIds": [
              "EXO.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukalebaka ifi fyonse mwebele nge funde lyakubelelela kuli imwe ne ndupwa shenu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.24",
            "verseOrgIds": [
              "EXO.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga mwafika mu calo Yawe alaya ukumupeela, mukalebaka ifi fyonse mwebele. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.25",
            "verseOrgIds": [
              "EXO.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo abana benu bakamwipusha abati, ‘Ngefi fyonse filolele mwi?’ ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.26",
            "verseOrgIds": [
              "EXO.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukalebeba mwati, ‘Lilambo lye Pasaka lyakwa Yawe uwacilile amayanda ya bena Israeli mu calo ca Egupto no kupususha abana besu, lelo aipeye abena Egupto.’” Awe abantu bafukama balapepa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.27",
            "verseOrgIds": [
              "EXO.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abena Israeli baya cita ifyo Yawe akonkomeshe Mose na Aroni.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.28",
            "verseOrgIds": [
              "EXO.12.28"
            ]
          }
        }
      ]
    },
    {
