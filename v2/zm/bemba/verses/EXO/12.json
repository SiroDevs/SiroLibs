              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulukuta lwa bena Israeli lonse lukalesefya inshikunkulu ye Pasaka, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.47",
            "verseOrgIds": [
              "EXO.12.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "EXO 12:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwinafyalo onse uwaikala na imwe nga alefwaya ukulyako Ipasaka lyakucindika Yawe, afwile ukusembulula abaume bonse aba mu ŋanda yakwe. Lyena kuti alalyako nga bakaya mu calo. Lelo umwaume onse uushasembululwa wena tali nakulyako. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.48",
            "verseOrgIds": [
              "EXO.12.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "EXO 12:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwana calo no mweni mwikala nao bonse bali nokusunga ifunde limo line.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.49",
            "verseOrgIds": [
              "EXO.12.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "EXO 12:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abena Israeli bonse bacitile fyonse ifyo Yawe akonkomeshe Mose na Aroni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.50",
            "verseOrgIds": [
              "EXO.12.50"
            ]
          }
        },
        {
