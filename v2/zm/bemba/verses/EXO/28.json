              "items": [
                {
                  "text": "Esra 2:63",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.7.65"
              },
              "items": [
                {
                  "text": "Nehem 7:65",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Muli tumba wa pa cifuba uwakwishibilako pakupingula ukabikemo Urimu na Tumimu,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.30",
            "verseOrgIds": [
              "EXO.28.30"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "28:30",
              "type": "text"
            },
            {
              "text": "Urimu na Tumimu:",
              "type": "text"
            },
            {
              "text": "Tumabwe nangu utumiti uto shimapepo alebomfya pakupendula pakwishiba ifyo Lesa alefwaya.",
              "type": "text"
            }
          ]
        },
        {
          "text": " pakuti fikaleba lwa pa mutima wakwa Aroni ilyo lyonse akalaisa pa cinso cakwa Yawe. Kanshi, Aroni akalasenda lyonse pa mutima wakwe ifibombelo ifyakubomfya pakupingula abena Israeli pa cinso cakwa Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.30",
            "verseOrgIds": [
              "EXO.28.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 28:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.30",
            "verseOrgIds": [
              "EXO.28.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 28:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ukabile umwingila wakufwala mukati ka efodi ku nsalu yacifufyafye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.31",
            "verseOrgIds": [
              "EXO.28.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 28:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwingila ukashemo icipunda icakupishamo umutwe. Pa cipunda apakupisha umutwe ukapikulepo ukushinguluka pakulesha umwingila ukulepuka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.32",
            "verseOrgIds": [
              "EXO.28.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 28:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku mufukilo wa mwingila ukapikwilemo ifitwalo ifyapala amateke ku bushishi bwacifufya no bwakashikila elyo no bwakashika cee. Pakati ka fitwalo ifyapala mateke ukekashepo utunyenjele twa golide. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.33",
            "verseOrgIds": [
              "EXO.28.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 28:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukafikonkanye ukushinguluka umufukilo wa mwingila onse utunyenjele twa golide ne teke ifyo fine.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.34",
            "verseOrgIds": [
              "EXO.28.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 28:34"
          },
          "items": [
