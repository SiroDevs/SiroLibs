            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.35+EXO.12.36"
              },
              "items": [
                {
                  "text": "Ukuf 12:35-36",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kabili nkalenga ukuti mukatemwikwe ku bena Egupto, epakuti ilyo mukalaya mwikaya iminwe nkutwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.21",
            "verseOrgIds": [
              "EXO.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
