                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.23.3"
              },
              "items": [
                {
                  "text": "Levi 23:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.12+DEU.5.13+DEU.5.14"
              },
              "items": [
                {
                  "text": "Amaf 5:12-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mukalebomba imilimo mu nshiku mutanda, lelo ubwalenga cine lubali bwena bushiku bwe Sabata ubwakutuushamofye ubwamushilo kuli Yawe. Uyo onse uukabombapo umulimo uuli onse pe Sabata akepaiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.15",
            "verseOrgIds": [
              "EXO.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abena Israeli bakalebaka ubushiku bwe Sabata, bakalebusefya mu nkulo shabo shonse ishikakonkapo nge cipangano ca pe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.16",
            "verseOrgIds": [
              "EXO.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubushiku bwe Sabata bukaba e cishibilo ca pe kuli ine na ku bena Israeli. Pantu mu nshiku mutanda emo Yawe acitile umulu ne sonde, elyo pa bushiku ubwalenga cine lubali epo alekele ukubomba atuusha.’”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.17",
            "verseOrgIds": [
              "EXO.31.17"
            ]
          }
        }
      ]
    },
