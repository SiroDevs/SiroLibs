              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.11",
            "verseOrgIds": [
              "EXO.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili Yawe aebele Mose ati, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.12",
            "verseOrgIds": [
              "EXO.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ukebe abena Israeli auti, ‘Muli nokubaka Amasabata yandi pantu ici e cishibilo kuli ine na kuli imwe ne nkulo shenu shonse ukuti nine Yawe uumulenga kuti mube abamushilo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.13",
            "verseOrgIds": [
              "EXO.31.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulebaka ubushiku bwe Sabata pantu bushiku bwamushilo kuli imwe. Uyo onse uushilicindika, akepaiwe. Uyo onse uukabomba umulimo uuli onse pali ubu bushiku, wakutamfyafye mu bantu bandi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.14",
            "verseOrgIds": [
              "EXO.31.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
