          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo Lesa apwile ukulanda na Mose pa lupili lwa Sinai, amupeele amabwe yabili ayapapatala aya cipangano, ayo Lesa alembelepo ku munwe wakwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.18",
            "verseOrgIds": [
              "EXO.31.18"
            ]
          }
