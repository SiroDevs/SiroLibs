              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.69",
            "verseOrgIds": [
              "NEH.7.69"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "70",
            "style": "v",
            "sid": "NEH 7:70"
          },
          "items": [
            {
              "text": "70",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo abakalamba bamo aba ndupwa batuulile ne fyabupe ifyakwafwilisha muli uyu mulimo. Umulashi wa calo ici, apeele ku mulimo wa cipao, indalama drakimasi ikana limo (1,000) isha golide",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.70",
            "verseOrgIds": [
              "NEH.7.70"
            ]
          }
        },
