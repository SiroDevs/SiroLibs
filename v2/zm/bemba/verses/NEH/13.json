          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulenjibukisha we Lesa wandi pali ici, wileka ifyo mombele mu bufumacumi palwa ŋanda yakwa Lesa wandi ne mipepele yakwe fyonaike.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.14",
            "verseOrgIds": [
              "NEH.13.14"
            ]
          }
        }
      ]
    },
    {
