              "NEH.13.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.12.19"
              },
              "items": [
                {
                  "text": "Amaf 12:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili nalimwene nokuti icipande capekumi bali nokulapeela abena Levi, tabalebapeela, elyo nokuti abena Levi na bakemba abali no mulimo wakutumika mu ŋanda yakwa Lesa balileka ukubomba, babwelela na mukubomba mu mabala yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.10",
            "verseOrgIds": [
              "NEH.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi nakalipila intungulushi no kubepusha ukuti, “Cinshi iŋanda yakwa Lesa yabela iyalekeleshiwa?” Elyo nabalonganike pamo no kubabwekesha mu fifulo balipo nakale. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.11",
            "verseOrgIds": [
              "NEH.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.3.10"
              },
              "items": [
                {
                  "text": "Mala 3:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abena Yuda bonse epakuleta umutuulo wa cekumi uwabunga, umwangashi upya na mafuta mu miputule. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.12",
            "verseOrgIds": [
              "NEH.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Napeele Shelemiya shimapepo, Sadoki kalemba no mwina Levi uo baleita Pedaya umulimo uwakusunga imiputule yakusungilamo ifintu. Elyo Hanani umwana mwaume uwakwa Sakuri, umwishikulu wakwa Matania, namucita kafwa wabo, pantu aba bantu bali abacishinka. Elyo kabili wali mulimo wabo ukwakanya ifintu kuli bamunyina.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.13",
            "verseOrgIds": [
              "NEH.13.13"
            ]
          }
        }
      ]
    },
    {
