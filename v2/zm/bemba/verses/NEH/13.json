            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umo pa bana bakwa Yehoiyada, umwishikulu wakwa Eliashibu shimapepo mukalamba, ali ni shifyala wakwa Sanibalati umwina Holo, nalimutamfishe ukufuma kuli ine.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.28",
