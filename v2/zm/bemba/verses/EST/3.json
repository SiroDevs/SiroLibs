          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.14",
            "verseOrgIds": [
              "EST.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakapaso bwangu bwangu bakonka icipope ca mfumu, neci cebo caishibikwa mu musumba wa Susa. Elyo imfumu na Hamani bena baikele panshi balanwa no kunwa, lelo mu musumba wa Susa mwaba icimfulunganya.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.15",
            "verseOrgIds": [
              "EST.3.15"
            ]
          }
        }
      ]
    }
