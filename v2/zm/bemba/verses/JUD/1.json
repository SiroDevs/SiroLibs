              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.2",
            "verseOrgIds": [
              "JUD.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JUD 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwe batemwikwa bandi! Ala nalefwaisha nganshi ukumulembelako pepusukilo twashukila bonse. Nasangile ukuti cilefwaikwa ukumukoselesha pakuti mulelwila icisumino ico Lesa apeela umupwilapo ku bantu bamushilo. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.3",
            "verseOrgIds": [
              "JUD.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JUD 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pantu abantu bamo abashapetamina Lesa baisa pakati kesu mu bumfisolo. Aba bantu bafulunganya amashiwi aya pa cikuuku cakwa Lesa no kuyalosha ku bulalelale. Elyo basuula na Yesu Kristu Imfumu yesu kabili Shikulwifwe uwabafye umo. Aba bantu ebo ukupingulwa kwabo kwalembelwepo na kalefye.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.4",
            "verseOrgIds": [
              "JUD.1.4"
            ]
          }
        }
      ]
    },
