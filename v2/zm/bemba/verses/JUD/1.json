          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo imwe mwe bacibusa bandi muleibukisha ifyo abasole ba Mfumu yesu Yesu Kristu bamwebele kale. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.17",
            "verseOrgIds": [
              "JUD.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JUD 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.3.3"
              },
              "items": [
                {
                  "text": "2 Pet 3:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bamwebele ukuti, “Mu nshiku shakupelekeshako, kukaba abantu abakalamupumya, abantu abakalakonkelelafye ulunkumbwa lwabo.” ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.18",
            "verseOrgIds": [
              "JUD.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JUD 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu ba uyu musango abaleta ukupatulukana, bakonkelelafye ifyabuntunse, tababa na Mupashi wakwa Lesa. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.19",
            "verseOrgIds": [
              "JUD.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JUD 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo imwe, mwe bacibusa bandi muleshangila no kulakoselako mu cisumino cenu icamushilo, mulepepa mukwampana na Mupashi Wamushilo. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.20",
            "verseOrgIds": [
              "JUD.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JUD 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muleikala mu citemwiko cakwa Lesa, ilyo mulelolela ne nsansa ukuti Imfumu yesu Yesu Kristu ku luse lwakwe akamupeele umweo wape.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.21",
            "verseOrgIds": [
              "JUD.1.21"
            ]
          }
        }
      ]
