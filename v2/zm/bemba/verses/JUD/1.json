          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulelangulukila abo abacili baletwishika. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.22",
            "verseOrgIds": [
              "JUD.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JUD 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulepusushako bamo mukubasompola ukufuma mu mulilo. Bambi bena mulebakwatila uluse no mwensopo. Lelo muletaluka ku fyakufwala fyabo ifyakowela ku bubifi bwabo ubwa lunkumbwa lubi.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.23",
            "verseOrgIds": [
              "JUD.1.23"
            ]
          }
        }
      ]
