                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.24.2"
              },
              "items": [
                {
                  "text": "Esek 24:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kanshi mu mwaka walenga pabula uwa pa bufumu bwakwa Sedekia, pa bushiku bwalenga ikumi mu mweshi walenga ikumi, Nebukadinesa imfumu ya ku Babiloni yaima mukuya lwisha Yerusalemu ne fita fyakwe fyonse. Akuula inkambi kunse ya musumba elyo ashingulusha imina ya maloba na fimbi fyakubomfya pakwikata umusumba. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.1",
            "verseOrgIds": [
              "2KI.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifita fyashingulwike umusumba ukufika pa mwaka we kumi limo na umo (11) uwa pa bufumu bwakwa Sedekia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.2",
            "verseOrgIds": [
              "2KI.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa bushiku bwalenga pabula mu mweshi walenga bune, insala mu musumba yakulisha icakuti abantu balafilwa no kumona icakulya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.3",
            "verseOrgIds": [
              "2KI.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.33.21"
              },
              "items": [
                {
                  "text": "Esek 33:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amalinga ya ku musumba epakulabongololwa. Pakumona ifi, imfumu Sedekia na bashilika bonse aba mu musumba bena bafulumuka ubushiku, ninshi na bena Kaludea",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.4",
            "verseOrgIds": [
              "2KI.25.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "25:4",
              "type": "text"
            },
            {
              "text": "Abena Kaludea:",
              "type": "text"
            },
            {
              "text": "Mutundu wa bantu abaikele ku calo ca ku kulyo lubali lwa ku musumba wa Babiloni. E mutundu wa ba lupwa lwakwa Nebukadinesa uwaishile teeka ku Babiloni.",
              "type": "text"
            }
          ]
        },
        {
          "text": " nabashinguluka umusumba. Bakonka inshila iyalola kwibala lya mfumu, bapitila pa mpongolo iyaba pakati ka fibumba fibili, balola na ku Araba. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.4",
            "verseOrgIds": [
              "2KI.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomba ifita fya bena Kaludea fyakunkunika imfumu Sedekia, mpaka fyamwikatila mu mawanga ya Yeriko, na bashilika bakwe bonse ninshi baya basalangana ukufuma kuli ena. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.5",
            "verseOrgIds": [
              "2KI.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fyati fikate imfumu, awe fyaitwala na kuli Nebukadinesa imfumu ya ku Babiloni ilyo ninshi wena ali ku mushi wa Ribula, uko kwine eko na Nebukadinesa aputwila Sedekia umulandu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.6",
            "verseOrgIds": [
              "2KI.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.12.13"
              },
              "items": [
                {
                  "text": "Esek 12:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Baipaya abana abaume bakwa Sedekia pa cinso cakwe. Elyo ena bamutonkola amenso, bamukaka mu minyololo ya mukuba elyo bamusenda ku Babiloni.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.7",
            "verseOrgIds": [
              "2KI.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.7",
            "verseOrgIds": [
              "2KI.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa bushiku bwalenga cine lubali mu mweshi walenga isano, mu mwaka walenga ikumi limo na pabula (19) apo Nebukadinesa atampile ukuteeka ubufumu mu Babiloni, elintu Nebusaradani aingile mu musumba wa Yerusalemu. Uyu Nebusaradani ali ni shicilye wa mfumu, kabili ewali mushika mukalamba uwa bakalinda ba mfumu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.8",
            "verseOrgIds": [
              "2KI.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi Nebusaradani epakoca iŋanda yakwa Yawe, aoca na mayanda ya kwisano, aocela kumo na mayanda yonse ayacindami ya mu Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.9",
            "verseOrgIds": [
              "2KI.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifita fyonse ifya bena Kaludea ifyali no mukalamba wa bakalinda ba mfumu batobaula na malinga ayashingulwike umusumba wa Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.10",
            "verseOrgIds": [
              "2KI.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebusaradani umukalamba wa bakalinda wa mfumu asenda muli bunkole abantu bonse abashele mu musumba, pamo pene na bantu abafyukile ku mfumu ya ku Babiloni. Asendela kumo na bantu abacenjela ku fyakutukuta tukuta. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.11",
            "verseOrgIds": [
              "2KI.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo uyu mukalamba wa bakalinda ashako abekalacalo bamo abalanda nganshi abakuti balesunga imyangashi elyo no kulalima amabala.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.12",
            "verseOrgIds": [
              "2KI.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
