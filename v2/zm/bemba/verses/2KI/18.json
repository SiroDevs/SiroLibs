          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 18:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.36",
            "verseOrgIds": [
              "2KI.18.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 18:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Eliakimu mwana Hilikiya uwali mushika wa kwisano, Shebina kalemba mukalamba wa kwisano na Yoa mwana Asafu kalemba wa fyalecitika mu calo, baya kuli Hesekia nabalepula insalu shabo, no kumulondolwela ifyo uyu Rabushake aciba alelanda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.37",
            "verseOrgIds": [
              "2KI.18.37"
            ]
          }
        }
