          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hasaeli imfumu ya bena Aramu yaikalilafye ukucusha abena Israeli pa nshita ya bufumu bwakwa Yehoahasi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.22",
            "verseOrgIds": [
              "2KI.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo ukusenamina kwakwa Yawe kwali pali bena kabili alibakwatile uluse no kulanga ukubasakamana nganshi pa mulandu wa cipangano cakwa Abrahamu, Isaki na Yakobo. Ukushinta na pa bushiku bwalelo tafwaya ukubonaula nangu ukubafumya ku cinso cakwe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.23",
            "verseOrgIds": [
              "2KI.13.23"
            ]
          }
        }
      ]
    },
