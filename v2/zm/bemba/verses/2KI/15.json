          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo palwa fintu fimbi ifya pa bufumu bwakwa Peka, nefyo acitile, bushe tafyalembwa mu citabo ca milandu ya shamfumu sha bena Israeli?",
          "type": "text",
