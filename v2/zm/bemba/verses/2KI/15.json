          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pekaya acitile ifyabipa pa cinso cakwa Yawe. Tapilibwike ukufuma ku fyabubifi fyakwa Yeroboamu mwana Nebati ifyo aletelele na bena Israeli ukubifyako.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.24",
            "verseOrgIds": [
              "2KI.15.24"
            ]
          }
