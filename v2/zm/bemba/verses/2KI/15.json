          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Menahemu ilyo afwile, aile lala ukwalala ifikolwe fyakwe. Elyo Pekaya umwana wakwe umwaume amupyana pa bufumu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.22",
