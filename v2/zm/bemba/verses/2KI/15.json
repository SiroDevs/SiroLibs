          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Hoshea umwana mwaume wakwa Elaya apangila Peka mwana Remaliya. Amusansa no kumwipaya. Elyo amupyana pa bufumu mu mwaka walenga amakumi yabili (20) uwakwa Yotamu mwana Usia.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.30",
            "verseOrgIds": [
              "2KI.15.30"
            ]
          }
        }
      ]
