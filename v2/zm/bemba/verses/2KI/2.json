              "2KI.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Impuka ya bakasesema ba ku Betele baishile ukwali Elisha bamwipusha ati, “Bushe nawishiba ukuti Yawe ilelo alesenda sokulu ukufuma kuli iwe?”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.3",
            "verseOrgIds": [
              "2KI.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
