          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao ayasuka ati, “Mu cishinkafye cakwa Yawe uwamweo, ngefyo na iwe wine uli uwamweo, nshakushe iyoo.” Kanshi bonse babili bakonkanyapo ukuya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.6",
            "verseOrgIds": [
              "2KI.2.6"
            ]
          }
        }
