        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo inshita yafikile mupepi iyakuti Yawe asende Eliya ku mulu muli kankungwe, Eliya na Elisha bali pa lwendo lwakufuma ku Giligali. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.1",
            "verseOrgIds": [
              "2KI.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Eliya aeba Elisha ati, “Ikala pano pantu Yawe nantuma ku Betele.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.2",
            "verseOrgIds": [
              "2KI.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo Elisha ayasuka ati, “Mu cishinkafye cakwa Yawe uwamweo, ngefyo na iwe wine uli uwamweo, nshakushe iyoo.” Kanshi epakuya bonse ku Betele.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.2",
            "verseOrgIds": [
              "2KI.2.2"
            ]
          }
        }
      ]
    },
    {
