          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisha abasuka ati, “Iyoo, mwibatuma.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.16",
            "verseOrgIds": [
              "2KI.2.16"
            ]
          }
        }
      ]
    },
    {
