              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.22",
            "verseOrgIds": [
              "2KI.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukufuma kulya Elisha aile ku Betele. Lilya acili mukuya mu musebo, abana bacilumendo baisa ukufuma mu musumba bayamba ukumuwela abati, “Kabiye ube cilipala, kabiye ube cilipala.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.23",
            "verseOrgIds": [
              "2KI.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo apilibuka abalolesha no kulanda icitipu pali bena mwishina lyakwa Yawe. Elyo ifiswango fibili fibea fyafuma mu mpanga no kwipayapo abana amakumi yane na babili (42). ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.24",
            "verseOrgIds": [
              "2KI.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili aima aya ku lupili lwa Kameli elyo ukufuma kulya abwelela na ku Samaria.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.25",
            "verseOrgIds": [
              "2KI.2.25"
            ]
          }
        }
      ]
