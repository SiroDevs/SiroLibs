            "number": "7",
            "style": "v",
            "sid": "2KI 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Impuka ya bakasesema amakumi yasano (50) bakonka baya iminina akatalamukila ukulolesha ku ncende ukwaiminine Eliya na Elisha pa lulamba lwa mumana wa Yordani. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.7",
            "verseOrgIds": [
              "2KI.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliya epakubuula umwingila wakwe aupomba elyo auma pa menshi. Amenshi yayakanika pakati yatulumana uku noku elyo bonse babili bayabuka pa mushili uwauma.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.8",
            "verseOrgIds": [
              "2KI.2.8"
            ]
          }
        }
      ]
    },
