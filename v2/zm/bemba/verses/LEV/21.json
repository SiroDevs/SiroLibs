            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.44.25"
              },
              "items": [
                {
                  "text": "Esek 44:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe atile kuli Mose, “Eba bashimapepo, abana baume bakwa Aroni, no kutila kuli bena, ‘Shimapepo tafwile ukuikowesha umwine eka pakupalama ku citumbi ca muntu wakwe uwafwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.1",
            "verseOrgIds": [
              "LEV.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanofye nga wa mu lupwa, pamo nga nyina, wishi, umwana wakwe umwaume nangu umwanakashi, ndumenankwe ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.2",
            "verseOrgIds": [
              "LEV.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nangu nkashi yakwe uo bafyalwa nankwe kabili uushatala opwapo uo asunga, kuli aba wena kuti aikowesha. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.3",
            "verseOrgIds": [
              "LEV.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tafwile ukuikowesha umwine pakuya ku cililo ca ba mu lupwa lwa uko aupila pantu kuti aba uwakowela.’",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.4",
            "verseOrgIds": [
              "LEV.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
