                "loc": "LEV.19.27+LEV.19.28"
              },
              "items": [
                {
                  "text": "Levi 19:27-28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.14.1"
              },
              "items": [
                {
                  "text": "Amaf 14:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Bashimapepo bonse tabafwile kubeya imishishi ya mu mitwe yabo, nelyo ukubeya umwefu ukushinguluka akanwa, nelyo ukuitetaula umubili onse",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.5",
            "verseOrgIds": [
              "LEV.21.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "21:5",
              "type": "text"
            },
            {
              "text": "ukuitetaula umubili onse:",
              "type": "text"
            },
            {
              "text": "Cali cilangililo cakuti bali ne cililo ca muntu wabo.",
              "type": "text"
            }
          ]
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.5",
            "verseOrgIds": [
              "LEV.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bafwile ukuba abamushilo kuli Lesa wabo kabili tabafwile kusebanya ishina lyakwa Lesa wabo iyoo. Pantu batuula umutuulo wacakoca kuli Yawe, icakulya cakwa Lesa wabo, eico bafwile baba abamushilo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.6",
            "verseOrgIds": [
              "LEV.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.6",
            "verseOrgIds": [
              "LEV.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bashimapepo tabalingile ukuupa abanakashi abakoweshiwa muli bucilende nangu abanakashi abo balekapo, pantu bashimapepo bamushilo kuli Lesa wabo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.7",
            "verseOrgIds": [
              "LEV.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamoneni ukuti bamushilo, pantu ebatuula icakulya cakwa Lesa wenu. Eico bamoneni abamushilo pantu nine Yawe ne umulenga ukuba abamushilo pantu ndi wamushilo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.8",
            "verseOrgIds": [
              "LEV.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.8",
            "verseOrgIds": [
              "LEV.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwana shimapepo umwanakashi nga cakuti ailenga ukukanaba uwamushilo mukuba cilende, ninshi asebanya wishi. Uyu mwana wena, afwilefye ukocewa mu mulilo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.9",
            "verseOrgIds": [
              "LEV.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.9",
            "verseOrgIds": [
              "LEV.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Shimapepo mukalamba umo pali bamunyina, uwasubwa pakwitilwa amafuta pa mutwe, kabili uwatambalikilwapo amaboko pakuti alefwala ifyakufwala fya bushimapepo, tafwile kuleka umushishi mu mutwe wakwe ukwabula ukusakula, nangufye ukulepaula ifyakufwala fyakwe pakulanga ukuti ali ne cililo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.10",
            "verseOrgIds": [
              "LEV.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tafwile ukufika apali umuntu wafwa. Tafwile ukuikowesha umwine iyoo, nangu cibefye ni wishi nangu nyina ebafwile. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.11",
            "verseOrgIds": [
              "LEV.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili tafwile nakufuma mu cifulo camushilo cakwa Lesa wakwe nangu ukucikowesha, pantu uyu shimapepo untu watuulwa ku mulimo wakwa Lesa wakwe mukusubwa amafuta. Nine Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.12",
            "verseOrgIds": [
              "LEV.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.12",
            "verseOrgIds": [
              "LEV.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Shimapepo mukalamba afwile ukuupa umwanakashi uushatala asendamapo no mwaume. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.13",
            "verseOrgIds": [
              "LEV.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili tafwile kuupa mukamfwilwa, nangu uwalekwapo ku mwaume umbi, nangufye umwanakashi uwaikowesha muli bucilende, lelo ali nokubafye uushakuma ku mwaume, uwa mu bantu bakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.14",
            "verseOrgIds": [
              "LEV.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lyena takakoweshe abana bakwe mu bantu bakwe. Nine Yawe, ne ulenga ukuti abe uwamushilo.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.15",
            "verseOrgIds": [
              "LEV.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.15",
            "verseOrgIds": [
              "LEV.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili Yawe atile kuli Mose, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.16",
            "verseOrgIds": [
              "LEV.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Eba Aroni no kutila, ‘Umukonkanina inkulo, tapali umuntu nelyo umo nga cakuti aba na kalema uwakupalama mukutuula icakulya cakwa Lesa wakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.17",
            "verseOrgIds": [
              "LEV.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tapali nelyo umo uwakwisa mupepi uwakwata akalema: Impofu, icilema, uwaonaika pa menso nangu uwalemana mu nshila iyili yonse, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.18",
            "verseOrgIds": [
              "LEV.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "uwalemana ulukasa nangu ukuboko, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.19",
            "verseOrgIds": [
              "LEV.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "uwaŋongo nangu intuse, uwalemana ilinso, uwafilonda fifuma amenshi nangu mutungwi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.20",
            "verseOrgIds": [
              "LEV.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tapali uwa mu lupwa lwakwa Aroni uuli na kalema uwakupalama no kutuula umutuulo wa cakoca kuli ine ne Yawe. Ali na kalema, eico tafwile ukupalama kuli Lesa wakwe no kupeela umutuulo wa cakulya cakwa Lesa wakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.21",
            "verseOrgIds": [
              "LEV.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo kuti alya icakulya icamushilo nganshi icakwa Lesa wakwe pamo pene ne camushilofye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.22",
            "verseOrgIds": [
              "LEV.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa mulandu wakuti wena muntu wakalema, tafwile ukupalama ku cisalu icacingako nangu ku bulambo pantu kuti asaalula icifulo camushilo. Nine Yawe ne ulenga ukuti babe abamushilo.’”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.23",
            "verseOrgIds": [
              "LEV.21.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
