              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe aebele Mose ati, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.26",
            "verseOrgIds": [
              "LEV.23.26"
            ]
