            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.12+DEU.5.13+DEU.5.14"
              },
              "items": [
                {
                  "text": "Amaf 5:12-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Kwabafye inshiku mutanda isho mwingabombamo imilimo, lelo ubushiku bwalenga cine lubali bwena bushiku bwe Sabata ubwakutuusha, ubushiku bwa kulongana kwamushilo. Tamufwile kubombamo umulimo nelyo umo. Konsefye uko mwaikala, bushiku bwe Sabata kuli Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.3",
            "verseOrgIds": [
              "LEV.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
