            "number": "2",
            "style": "v",
            "sid": "LEV 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Eba abena Israeli nokutila kuli bena, ‘Ishi ni nshikunkulu shakwa Yawe ishasontwa mukulongana kwamushilo.’ Neshi nshiku shaba ifi:",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.2",
