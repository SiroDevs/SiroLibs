              "LEV.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe aebelele Mose ati, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.9",
            "verseOrgIds": [
              "LEV.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Eba abena Israeli nokutila kuli bena, ‘Ilyo mukengila mu calo ico ine ndi nokumupeela, no kwamba ukulobolola iŋanu, mukalete kuli shimapepo umwanshi wa ŋanu mukabalilapo ukulobolola. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.10",
            "verseOrgIds": [
              "LEV.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimapepo ali nokutambika uyu mwanshi kuli Yawe pakuti upokelelwe mukumwimininako. Shimapepo ali nokuutambika pa bushiku ilyo Isabata lyapita. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.11",
            "verseOrgIds": [
              "LEV.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa bushiku bwakutuula umwanshi, mufwile ukutuula nge lambo lyakoca kuli Yawe umwana wa mpaanga uwa mwaka umo uwabula akalema. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.12",
            "verseOrgIds": [
              "LEV.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mufwile ukuutuula pamo pene no mutuulo wa cabunga bwa ŋanu ubwapeleka bwino ubwa twapekumi tubili twa ku cipimo ca efa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.13",
            "verseOrgIds": [
              "LEV.23.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "23:13,17",
              "type": "text"
            },
            {
              "text": "Efa:",
              "type": "text"
            },
            {
              "text": "Cipimo ca fintu ifishili fya menshi ifyafina amakilo ikumi limo.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", kabili ubwasanshiwamo na mafuta ya miolifa, umutuulo we lambo lya cakoca ica cena cisuma icakusekesha Yawe. Kabili umutuulo wa cakunwa ufwile ukuba icipimo ca pakati ka citika wa hini",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.13",
            "verseOrgIds": [
              "LEV.23.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "23:13",
              "type": "text"
            },
            {
              "text": "Hini:",
              "type": "text"
            },
            {
              "text": "Cipimo ca fya menshi menshi ifyalingana na balita bane.",
              "type": "text"
            }
          ]
        },
        {
          "text": " wa mwangashi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.13",
            "verseOrgIds": [
              "LEV.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tecakwesha ukulya umukate uuli onse, nangufye iŋanu ishasalulwa nangu ishipya, mpaka pali bulya bwine bushiku mukaleta uyu mutuulo kuli Lesa wenu. Ili lifunde lyamuyayaya ilili nokukonkwa umukakonkanina inkulo, uko konse mukekala.’”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.14",
            "verseOrgIds": [
              "LEV.23.14"
            ]
          }
        }
      ]
    },
    {
