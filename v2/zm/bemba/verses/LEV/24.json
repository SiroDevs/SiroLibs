                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.2.26"
              },
              "items": [
                {
                  "text": "Mako 2:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.6.4"
              },
              "items": [
                {
                  "text": "Luka 6:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yawe aebele Mose ati, “Buula ubunga bwa ŋanu ubwapeleka bwino no kupangako imikate ikumi limo na ibili. Cila mukate ulebomfya utwapekumi tubili ku cipimo ca efa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.5",
            "verseOrgIds": [
              "LEV.24.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "24:5",
              "type": "text"
            },
            {
              "text": "Efa:",
              "type": "text"
            },
            {
              "text": "Cipimo ca fintu ifishili fya menshi ifyafina amakilo ikumi limo.",
              "type": "text"
            }
          ]
        },
        {
          "text": " utwa bunga. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.5",
            "verseOrgIds": [
              "LEV.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyi mikate mukalebika mu mitande ibili pamulu we tebulo ilyapangilwa na golide wine wine pa cinso cakwa Yawe. Cila mutande muleba imikate mutanda. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.6",
            "verseOrgIds": [
              "LEV.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa mutande onse ulebikapo icinyamuti",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.7",
            "verseOrgIds": [
              "LEV.24.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "24:7",
              "type": "text"
            },
            {
              "text": "icinyamuti:",
              "type": "text"
            },
            {
              "text": "Ku ncende shimbi batila “ubutomfu.”",
              "type": "text"
            }
          ]
        },
        {
          "text": " ca fulankinisenshi icisuma icine cine, nge ciputulwa ca cibukisho cakwimininako umukate, kabili kukuba umutuulo wakutuula kuli Yawe uwa cakoca. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.7",
            "verseOrgIds": [
              "LEV.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyu mukate Aroni ali nokuubika pa cinso cakwa Yawe lyonsefye cila bushiku bwe Sabata, mukwimininako abena Israeli nge cipangano camuyayaya. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.8",
            "verseOrgIds": [
              "LEV.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.4"
              },
              "items": [
                {
                  "text": "Mateo 12:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.2.26"
              },
              "items": [
                {
                  "text": "Mako 2:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.6.4"
              },
              "items": [
                {
                  "text": "Luka 6:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ifi fyonse fili nokuba ifyakwa Aroni na bana bakwe abaume lyonsefye, kabili bali nokufilila mu ncende iyamushilo. Cili nokuba ifi pantu fyamushilo nganshi pa fyakaniko fyonse ifyo bapeelwa pa mituulo iyituulwa kuli Yawe iya fyakoca.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.9",
            "verseOrgIds": [
              "LEV.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.9",
            "verseOrgIds": [
              "LEV.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomba kwali umwaume, nyina ali umwina Israeli, wishi nao ali umwina Egupto. Afumine mu ŋanda yakwe pakati ka bana ba Israeli no kuya mukulwa no mwina Israeli mukati ka nkambi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.10",
            "verseOrgIds": [
              "LEV.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo uyu mwana wa mwanakashi umwina Israeli asaalwile Yawe icine cine ilyo atukile ishina lyakwe. Awe abantu bamutwele kuli Mose. Ishina lyakwa nyina ni Shelomiti, umwana mwanakashi wakwa Dibili uwa mu luko lwakwa Dani. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.11",
            "verseOrgIds": [
              "LEV.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo bamubikile mukulindwa mpaka bakomfwe ifyo Yawe akabeba ukucita.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.12",
            "verseOrgIds": [
              "LEV.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.12",
            "verseOrgIds": [
              "LEV.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe aeba Mose ati, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.13",
            "verseOrgIds": [
              "LEV.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Fumyeni uyo muntu wamusaalula kunse ya nkambi. Kabili lekeni onse uumfwileko ku musaalula atambike amaboko yakwe pa mutwe wakwe no kuleka nomba ulukuta lonse lumutobe amabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.14",
            "verseOrgIds": [
              "LEV.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo webe na bena Israeli utile, ‘Umuntu onse uwatuka Lesa wakwe, alifye nokupeelwa umulandu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.15",
            "verseOrgIds": [
              "LEV.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu onse uwasaalula ishina lyakwa Yawe afwilefye ukwipaiwa. Ulukuta lonse luli nokumulasa amabwe. Nelyo abefye umweni nangufye umwina Israeli, ali nokufwa nga cakuti asaalula ishina lyakwa Yawe.’",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.16",
            "verseOrgIds": [
              "LEV.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.16",
            "verseOrgIds": [
              "LEV.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Umuntu uuli onse nga cakuti aipaya umuntu munankwe, nao wine bafwile ukumwipaya. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.17",
            "verseOrgIds": [
              "LEV.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyo onse uwaipaya icitekwa ca munankwe, afwile ukupyanikishapo cimbi. Umweo pa mweo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.18",
            "verseOrgIds": [
              "LEV.24.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.18",
            "verseOrgIds": [
              "LEV.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Umuntu uuli onse nga cakuti acena umunankwe, ifyo fine acita ku munankwe efyo nao afwile bamucitila. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.19",
            "verseOrgIds": [
              "LEV.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.21.23+EXO.21.24+EXO.21.25"
              },
              "items": [
                {
                  "text": "Ukuf 21:23-25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.19.21"
              },
              "items": [
                {
                  "text": "Amaf 19:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.38"
              },
              "items": [
                {
                  "text": "Mateo 5:38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nga akontwele umunankwe ifupa, nao wine bali nokumukontola ifupa, nga linso nao wine ninshi linso line, nga lino nao wine ninshi lino line. Ifyo fine umusango acenenamo umunankwe, efyo nao wine bali nokumucena. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.20",
            "verseOrgIds": [
              "LEV.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
