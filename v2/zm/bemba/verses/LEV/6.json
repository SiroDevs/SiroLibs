                "loc": "NUM.5.5+NUM.5.6+NUM.5.7+NUM.5.8"
              },
              "items": [
                {
                  "text": "Imp 5:5-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kabili Yawe asosele kuli Mose ati, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.1",
            "verseOrgIds": [
              "LEV.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Umuntu nga abifya mukukanaba uwacishinka kuli Yawe kufyo acenjesha umunankwe pa fintu asekesheko nangu ukumusungilako nangu ukumwibila, nangu amubepa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.2",
            "verseOrgIds": [
              "LEV.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nangu ngo muntu umo atola icintu icilubile nomba akaana ati teutolele, nangu alapa umulapo wabufi, nangu acita ifyabubifi ifyo abantu bengacita, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.3",
            "verseOrgIds": [
              "LEV.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nangu abifya muli uyu musango uwa bucenjeshi, alingile ukubwesha ifi fintu aibile nangu asendele mu bucenjeshi nangufye ni filya fine umunankwe asekesheko, na filya fine atolele, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.4",
            "verseOrgIds": [
              "LEV.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "elyo na conse ico alapilepo umulapo wabufi. Fyonse ifyo asendele alingile ukubwesha no kulundapo cimo pali cila fisano no kubwesesha ku mwine pa bushiku bumo bwine ali nokutuula umutuulo wakufuta pa fyabubifi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.5",
            "verseOrgIds": [
              "LEV.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nge cifuta mulandu alete kuli shimapepo, emukutila kuli Yawe, umutuulo wakufuta pa bubifi, ukufuma pa mukuni wakwe, sukusuku uwabula akalema, uwa mutengo uwalinga. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.6",
            "verseOrgIds": [
              "LEV.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na muli iyi nshila, shimapepo ali nokufutilako uyu muntu kuli Yawe ninshi lyena akabelelwa uluse pa fintu fyonse acita ifyalenga abe no mulandu.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.7",
            "verseOrgIds": [
              "LEV.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.7",
            "verseOrgIds": [
              "LEV.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili Yawe asosele kuli Mose ati, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.8",
            "verseOrgIds": [
              "LEV.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Eba Aroni na bana bakwe abaume ifyebo ifi, pakuti efyo balekonka ilyo lyonse baleka ilambo lyakoca. Ilambo lyakoca lili nokubafye pa bulambo ubushiku bonse pa cininkwa ca mulilo mpaka bwaca. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.9",
            "verseOrgIds": [
              "LEV.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Shimapepo ali nokufwala umwingila wa nsalu iyatelela elyo na kaputula wa nsalu iyatelela mukati ka mwingila no kukusa imito ye lambo lyakoca ilipiile ku bulambo no kuibika mu mbali ya bulambo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.10",
            "verseOrgIds": [
              "LEV.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo ali nokufuula ifi fyakufwala no kufwala fimbi pakutwala imito kunse ya nkambi ku ncende iyasangululwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.11",
            "verseOrgIds": [
              "LEV.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umulilo wa pa bulambo uli nokulaaka lyonse, taufwile kushima iyoo. Ulucelo lyonse shimapepo ali nokubikapo inkuni no kupekanya ilambo lyakoca pa mulilo no kocapo amafuta ya mutuulo wakwampana. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.12",
            "verseOrgIds": [
              "LEV.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umulilo wena ufwile ukulayaka lyonse pa bulambo, taufwile kushima iyoo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.13",
            "verseOrgIds": [
              "LEV.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.13",
            "verseOrgIds": [
              "LEV.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aya nayo e mafunde yakukonka pakutuula umutuulo wa cabunga. Bamwana Aroni abaume, ebakulaleta uyu mutuulo ku cinso cakwa Yawe kuntanshi ya bulambo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.14",
            "verseOrgIds": [
              "LEV.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Shimapepo ali nokubuulapo ulupi lwa bunga bwa ŋanu ubwapeleka bwino na mafutamo, pamo pene ne cinyamuti",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.15",
            "verseOrgIds": [
              "LEV.6.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "6:15",
              "type": "text"
            },
            {
              "text": "icinyamuti:",
              "type": "text"
            },
            {
              "text": "Ku ncende shimbi batila “ubutomfu.”",
              "type": "text"
            }
          ]
        },
        {
          "text": " ca fulankinisenshi icanunka ubusaka conse, pamo pene no kufyocela pamo pa bulambo nge cipande ca cibukisho ica cena cisuma icisekesha Yawe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.15",
            "verseOrgIds": [
              "LEV.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifyashalapo, Aroni na bana bakwe abaume bali nokulya, lelo bafwile ukulya umwabula intutumushi mu ncende yamushilo. Bafwile ukuliila mu lubansa lwe Tenti Lyakukumaninamo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.16",
            "verseOrgIds": [
              "LEV.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakupanga umukate tabafwile ukubikamo intutumushi. Nabapeela ifi ifya pa mituulo yandi iya cakoca cibe cabo. Ifi filyo, ala, fyamushilo nganshi pamo ngo mutuulo wakwelelwa pa bubifi elyo no mutuulo wakufuta pa fyabubifi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.17",
            "verseOrgIds": [
              "LEV.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwaume onse uwa mu lupwa lwakwa Aroni ali nokulyako. Ici e cipande cakwe pa mutuulo kuli Yawe uwa cakoca icili nokutwalilila ku nkulo shonse. Na conse icili nokukumyako, cili nokuba icamushilo.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.18",
            "verseOrgIds": [
              "LEV.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
