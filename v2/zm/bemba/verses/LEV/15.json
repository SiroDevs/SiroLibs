        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kanshi muli nokutalusha abena Israeli ku fintu ifingabalenga ukuba abakowela, epakuti tabafwilile mu kukowela kwabo pakukowesha Itenti lyandi ilyaba pakati kabo.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.31",
            "verseOrgIds": [
              "LEV.15.31"
            ]
          }
        }
      ]
    },
    {
