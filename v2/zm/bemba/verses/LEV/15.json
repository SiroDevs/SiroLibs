              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.31",
            "verseOrgIds": [
              "LEV.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya e mafunde yakukonka ku mwaume uo umubili wakwe ulepompa, onse uwakowela pakupemena panshi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.32",
            "verseOrgIds": [
              "LEV.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "ku mwanakashi uuli kumpepo, umwaume nangu umwanakashi uo umubili wakwe ulepompa na ku mwaume uwasendama no mwanakashi uwakowela.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.33",
            "verseOrgIds": [
              "LEV.15.33"
            ]
          }
        }
