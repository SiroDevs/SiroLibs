              "items": [
                {
                  "text": "Efe 5:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.3.19"
              },
              "items": [
                {
                  "text": "Kolo 3:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E cimo cine na imwe mwe balume, mu mikalile yenu mube na mano yasuma pa bakashi benu. Nangu abanakashi bantu abashakosa, mulebacindika, pantu pamo pene na imwe, nabo bene bapokelelako ubupe bwakwa Lesa ubwamweo wape. Ifi efyo mulecita, pakuti kwilaba nelyo cimo icakufulunganya amapepo yenu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.7",
            "verseOrgIds": [
              "1PE.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
