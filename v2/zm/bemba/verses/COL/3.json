          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muleibukisha ukuti Imfumu ikamupeela icilambu yalaya abantu baiko. Pantu Kristu e Shikulwinwe wine wine uo mubombela. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.24",
            "verseOrgIds": [
              "COL.3.24"
            ]
          }
        },
        {
