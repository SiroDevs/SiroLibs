        },
        {
          "text": "Mwe basha mulenakila bashikulwinwe ba pano calo muli fyonse. Telyo balipofye iyoo, pakuti bamutashe, lelo nelyo bashilipo. Mulebomba bwino no mutima onse, pa mulandu wakucindika Imfumu. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.22",
            "verseOrgIds": [
              "COL.3.22"
            ]
          }
        },
        {
          "name": "verse",
