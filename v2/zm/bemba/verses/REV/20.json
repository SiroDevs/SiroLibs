            "number": "1",
            "style": "v",
            "sid": "REV 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo namona malaika aleika ukufuma ku mulu, mu minwe yakwe ekete ulufungulo lwa pa muyenge no munyololo ukalamba. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.1",
            "verseOrgIds": [
              "REV.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.3.1"
              },
              "items": [
                {
                  "text": "Icite 3:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Awe aikata icisoka, acikaka pa myaka ikana limo. Ici e cisoka cakale na kale, e Ciwa wine nangu Satana. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.2",
            "verseOrgIds": [
              "REV.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aciposa na mu muyenge aisalapo, akomenenapo ne namba. Acitile ifyo pakuti cikalabepaika imishobo nakabili, mpaka imyaka ikana limo ikapite. Iyo myaka nga yapita, elyo akacikakula pa kashita akanono.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.3",
            "verseOrgIds": [
              "REV.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 20:3"
          },
          "items": [
            {
