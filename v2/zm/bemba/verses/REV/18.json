                }
              ]
            }
          ]
        },
        {
          "text": "Elyo naumfwa ishiwi na limbi ukufuma ku mulu lileti,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.4",
            "verseOrgIds": [
