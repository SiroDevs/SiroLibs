        {
          "text": "Ilyo ifi fyapita, elyo namona malaika umbi aleika ku mulu. Uyu malaika ali uwamaka nganshi no kubengeshima kwakwe kwaleta ulubuuto pa calo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.1",
            "verseOrgIds": [
              "REV.18.1"
            ]
          }
        },
