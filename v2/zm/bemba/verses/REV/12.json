              "items": [
                {
                  "text": "12:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JUD.1.9"
              },
              "items": [
                {
                  "text": "Yuda 9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo mu mulu namo mwabuuka inkondo. Mikaeli na bamalaika bakwe balalwisha icisoka. Icisoka naco na bamalaika baciko abasangu balabalwisha. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.7",
            "verseOrgIds": [
              "REV.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icisoka na bamalaika baciko abasangu tabakwete amaka, babatamfya, te bakumona icifulo mu mulu nakalya. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.8",
            "verseOrgIds": [
              "REV.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.3.1"
              },
              "items": [
                {
                  "text": "Icite 3:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.10.18"
              },
              "items": [
                {
                  "text": "Luka 10:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Icisoka icikulu nganshi bacifwintila panshi. E cisoka cakale na kale ico beta Ciwa nangu Satana, ecibepaika abantu icalo conse. Bacifwinta panshi pano calo pamo pene na bamalaika baciko abasangu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.9",
            "verseOrgIds": [
              "REV.12.9"
            ]
          }
        }
      ]
    },
