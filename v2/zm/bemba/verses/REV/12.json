              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.1.9+JOB.1.10+JOB.1.11"
              },
              "items": [
                {
                  "text": "Yobo 1:9-11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.3.1"
              },
              "items": [
                {
                  "text": "Saka 3:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo naumfwa ishiwi ilikalamba mu mulu lyasosa aliti,",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.10",
            "verseOrgIds": [
              "REV.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.12",
            "verseOrgIds": [
              "REV.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo icisoka casanga ukuti nabaciposa pa calo, calakonkafye umwanakashi ulya wapapile umwana umwaume. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.13",
            "verseOrgIds": [
              "REV.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.25"
              },
              "items": [
                {
                  "text": "Dan 7:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.12.7"
              },
              "items": [
                {
                  "text": "12:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uyu mwanakashi epakumupeela amapindo yabili aya cikapumpe icikalamba ayakuti apupukileko pakuya ku ncende yakwe mu matololo. Kuli iyi ncende eko akasungwa pa mwaka umo, imyaka ibili na umbi pakati",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.14",
            "verseOrgIds": [
              "REV.12.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "12:14",
              "type": "text"
            },
            {
              "text": "Umwaka:",
              "type": "text"
            },
            {
              "text": "Ba Baibele bamo batila, “inshita imo, inshita shibili na citika wa nshita.”",
              "type": "text"
            }
          ]
        },
        {
          "text": " pakumupususha ku cisoka. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.14",
            "verseOrgIds": [
              "REV.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo ku kanwa ka cisoka kwapongoloka amenshi kwati mumana, ukulola ukuli umwanakashi pakuti asendwe no mukuku wa menshi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.15",
            "verseOrgIds": [
              "REV.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo umushili wayafwilishako umwanakashi. Wayasama wamina umumana walepongoloka ku kanwa ka cisoka. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.16",
            "verseOrgIds": [
              "REV.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icisoka epakufulilwa umwanakashi. Caima caya na mukulalwisha abana ba mwanakashi bambi bonse. Aba bantu e abo abasunga amafunde yakwa Lesa, kabili ababa bakambone aba pa mashiwi yakwa Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.17",
            "verseOrgIds": [
              "REV.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo icisoka caiminina pa lulamba lwa bemba.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.18",
            "verseOrgIds": [
              "REV.12.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "12:18",
              "type": "text"
            },
            {
              "text": "Muli Ba Baibele bamo icikomo 18 catila, “Elyo naiminine pa lulamba lwa bemba.”",
              "type": "text"
            }
          ]
        }
      ]
    }
