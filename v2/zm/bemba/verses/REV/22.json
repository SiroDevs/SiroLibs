              "items": [
                {
                  "text": "Yere 17:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yesu aleti, “Mona! Nalaisafye bwangu! Ndeleta ifilambu fyandi ifyakupeela cila muntu ukulingana nefyo acita. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.12",
            "verseOrgIds": [
              "REV.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.44.6"
              },
              "items": [
                {
                  "text": "Esaya 44:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.48.12"
              },
              "items": [
                {
                  "text": "48:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nine Alfa kabili nine Omega, nine Wayambilako kabili nine Wakupelekeshako, nine Citendekelo kabili nine Kapeleko.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.13",
            "verseOrgIds": [
              "REV.22.13"
            ]
          }
        }
      ]
