            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.3.22"
              },
              "items": [
                {
                  "text": "3:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Balishuka abasamba imingila yabo, pakuti bakwate insambu shakulyako ifitwalo fya muti wamweo no kwingila mu musumba pa mpongolo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.14",
            "verseOrgIds": [
              "REV.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo abashala kunse ya musumba bantu abolungana nge mbwa, abacita amalele, abacita ubulalelale, aba misoka abapepa utulubi, nabo bonse ababufi mukulanda na mu micitile yabo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.15",
            "verseOrgIds": [
              "REV.22.15"
            ]
          }
        }
      ]
    },
