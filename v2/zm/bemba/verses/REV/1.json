                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.19.34"
              },
              "items": [
                {
                  "text": "Yoani 19:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.19.37"
              },
              "items": [
                {
                  "text": "37",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.4.17"
              },
              "items": [
                {
                  "text": "1 Tesa 4:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Moneni, eulya aleisa mu makumbi! Bonse bakamumona, na bamulashile nabo bene bakamumona. Abantu bonse aba pano isonde bakamuloosha. Kanshi ifyo efyo cikaba! Ameni.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.7",
            "verseOrgIds": [
              "REV.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.7",
            "verseOrgIds": [
              "REV.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nine Alfa kabili nine Omega,” efyasosa Imfumu Lesa wa maka yonse, uwabako, uwaliko, kabili uukesa bako.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.8",
            "verseOrgIds": [
              "REV.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.8",
            "verseOrgIds": [
              "REV.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine, nine Yoani munyinenwe, apo naampana na Yesu, tucula pamo na imwe amacushi yamo yene no kushipikisha mu macushi ayo ayesa pa baba mu Bufumu bwakwa Kristu. Bambikile pa cishi ca Patimosi pa mulandu wakufunda amashiwi yakwa Lesa na pali bukambone bwandi pali Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.9",
            "verseOrgIds": [
              "REV.1.9"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.9",
            "verseOrgIds": [
              "REV.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa bushiku bwa Mfumu,",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.10",
            "verseOrgIds": [
              "REV.1.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:10",
              "type": "text"
            },
            {
              "text": "Ubushiku bwa Mfumu:",
              "type": "text"
            },
            {
              "text": "Emukutila pa nshiku ya mulungu, pa Sondo.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mupashi Wamushilo alinjikete, ansenda. Elyo naumfwile ishiwi ilikalamba ilyaleumfwika kwati ciunda ce penga, lilelanda kunuma yandi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.10",
            "verseOrgIds": [
              "REV.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishiwi lyaleti, “Lemba mu citabo, conse ico wamona elyo utume icitabo ku nkuta cine lubali isha ku Efeso, Simina, Pegamo, Tiyatila, Sadisi, Filadelfia na ku Laodikea.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.11",
            "verseOrgIds": [
              "REV.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.11",
            "verseOrgIds": [
              "REV.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awe nacebukila kunuma pakuti mone uulensosha. Ilyo nacebukilako, namona ifyakutekapo ifisaniko cine lubali ifyapangwa na golide. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.12",
            "verseOrgIds": [
              "REV.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakati ka fyakutekapo ifisaniko pali uwapala umwana wa muntu, afwele umwingila uwalepa ukufika na pa makasa, elyo ukushinguluka icifuba afwele umushipi uwa golide. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.13",
            "verseOrgIds": [
              "REV.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umushishi wakwe ku mutwe uli uwabuuta tuutu kwati butonge, nangu kwati bunga bwa mfula",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.14",
            "verseOrgIds": [
              "REV.1.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:14",
              "type": "text"
            },
            {
              "text": "Ubunga bwa mfula:",
              "type": "text"
            },
            {
              "text": "E mfula iyabuuta iyiloka ngo bunga pantu amenshi ya mfula yatalala nganshi, yakambatana, kabili yamoneka ayabuuta tuutu.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", na menso yakwe kwati lubingu lwa mulilo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.14",
            "verseOrgIds": [
              "REV.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakasa yakwe yena yalebengeshima kwati mukuba filya ubengeshima ilyo wafuma mukupya mwilungu lya mulilo. Elyo ne shiwi lyakwe lileumfwika kwati cipooma ca menshi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.15",
            "verseOrgIds": [
              "REV.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu cisansa cakwe ica ku kulyo emo ekete intanda cine lubali. Mu kanwa kakwe mwena mwafuma ulupanga ulwatwa kubili. Impumi yakwe ilebengeshima kwati kasuba akabalikisha. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.16",
            "verseOrgIds": [
              "REV.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cilya namumona nawila pantanshi yakwe kwati muntu uwafwa. Elyo nao abika ukuboko kwakwe ukwa ku kulyo pali ine, ati nokuti, “Witiina! Nine Citendekelo kabili nine Wakupelekeshako. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.17",
            "verseOrgIds": [
              "REV.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nine mwine wamweo. Nalifwile, nomba ndi uwamweo uwakubelelela pe. Nalikwata amaka pa mfwa na pa calo ca bafwa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.18",
            "verseOrgIds": [
              "REV.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi lemba ifintu wamona, ifilecitika nomba, elyo ne fikacitika kuntanshi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.19",
            "verseOrgIds": [
              "REV.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "REV 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi intanda cine lubali isho wacimona mu cisansa candi ica ku kulyo ne fyakutekapo ifisaniko cine lubali, fili nomo filolele. Intanda cine lubali, ni bamalaika",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.20",
            "verseOrgIds": [
              "REV.1.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:20",
              "type": "text"
            },
            {
              "text": "Bamalaika:",
              "type": "text"
            },
            {
              "text": "Apa ili shiwi kuti lyalola mukutila (1) Intungulushi, (2) Inkombe shakwa Lesa, (3) Bamalaika abalelinda inkuta sha bena Kristu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " abamona pa nkuta cine lubali, elyo ifyakutekapo ifisaniko cine lubali e nkuta cine lubali.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.20",
            "verseOrgIds": [
              "REV.1.20"
            ]
          }
        }
