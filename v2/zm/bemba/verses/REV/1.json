                "loc": "EXO.3.14"
              },
              "items": [
                {
                  "text": "Ukuf 3:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.5"
              },
              "items": [
                {
                  "text": "Ubuso 4:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ine Yoani, namulembela imwe mwe nkuta cine lubali isha mu calo ca Asia.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.4",
            "verseOrgIds": [
              "REV.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icikuuku no mutende fibe na imwe ukufuma kuli Lesa uwabako, uwaliko, kabili uukesa bako, no kufuma ku mipashi cine lubali iyaba pantanshi ya cipuna cakwe icabufumu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.4",
            "verseOrgIds": [
              "REV.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.55.4"
              },
              "items": [
                {
                  "text": "Esaya 55:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Icikuuku no mutende fibe na imwe ukufuma na kuli Yesu Kristu, kambone wacishinka, uo Lesa abalilapo ukubusha ku bafwa, kabili e Kateeka wa shamfumu sha pano isonde. Yesu Kristu alitutemwa, kabili ku mulopa wakwe ewatulubula ku fyabubifi fyesu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.5",
            "verseOrgIds": [
              "REV.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.19.6"
              },
              "items": [
                {
                  "text": "Ukuf 19:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kabili alitwalula ukuba ababufumu kabili bashimapepo abakutumika Lesa wakwe kabili Wishi. Kuli Yesu Kristu kube amalumbo na maka yakubelelela pe! Ameni.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.6",
            "verseOrgIds": [
              "REV.1.6"
            ]
          }
        }
      ]
    },
