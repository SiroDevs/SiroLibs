          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili nati ndoleshe, naumfwa ishiwi ilyakwa kapumpe alepupuka mu mulu. Lilepunda lileti, “Owe, owe! We shamo we kuli bonse abo abekala pa calo, pa ciunda ca mapenga ayo bamalaika abo batatu balaswa balishe!”",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.13",
            "verseOrgIds": [
              "REV.8.13"
            ]
