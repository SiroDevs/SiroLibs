        {
          "text": "Elyo bamailaka cine lubali abali na mapenga cine lubali balaipekanya ukuyalisha.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.6",
            "verseOrgIds": [
              "REV.8.6"
