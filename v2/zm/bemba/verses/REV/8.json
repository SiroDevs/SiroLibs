              "items": [
                {
                  "text": "Amosi 9:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Awe paisa malaika umbi ali ne cakubikamo ububani ica golide, aisa iminina mupepi no bulambo. Bamupeela ububani ubwingi ubo ali nokutuula pamo na mapepo ya bantu bamushilo pa bulambo ubwa golide ubwaba pantanshi ya cipuna ca Mfumu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.3",
            "verseOrgIds": [
              "REV.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo icushi ca bubani pamo na mapepo ya bantu bamushilo fyanina ukuya pa cinso cakwa Lesa ukufuma ku minwe yakwa malaika. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.4",
            "verseOrgIds": [
              "REV.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
