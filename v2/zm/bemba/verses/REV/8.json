              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo Umwana wa Mpanga akakatulapo inamba yalenga cine lubali iyo icitabo cafungilweko, awe pa nsa imo pakati mu mulu mwatalalafye tondolo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.1",
            "verseOrgIds": [
              "REV.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo namona bamalaika cine lubali beminine pa cinso cakwa Lesa, balepeelwa amapenga cine lubali.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.2",
            "verseOrgIds": [
              "REV.8.2"
            ]
          }
        }
      ]
    },
