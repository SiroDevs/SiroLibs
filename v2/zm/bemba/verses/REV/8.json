              "items": [
                {
                  "text": "Esaya 14:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo malaika wabutatu nao alisha ipenga lyakwe. Ku mulu kwapona ulutanda ulukalamba, lulebilima kwati cisaniko, lwaponena pa ciputulwa cimo ica mimana iya pa fiputulwa fitatu ifya mimana na pa tumfukumfuku twa menshi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.10",
            "verseOrgIds": [
              "REV.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.9.15"
              },
              "items": [
                {
                  "text": "Yere 9:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ishina lya ulo lutanda ni “Kulula.” Ne cipande cimo ica menshi pa fipande fitatu ifya menshi cayaluka amenshi ayalula. Awe na bantu abengi bafwa ico banwene ayo menshi, pantu yayalwike ayalula.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.11",
            "verseOrgIds": [
              "REV.8.11"
            ]
          }
        }
      ]
