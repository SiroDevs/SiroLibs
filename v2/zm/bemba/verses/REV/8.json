                  "text": "16:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo malaika abula icakubikamo ububani acisushamo umulilo ukufuma pa bulambo, elyo aciposa na pa calo. Elyo kwaba ukubulukuta, ukupanta kwa mfula, imyele ya nkuba yalabyata, kwaba ne cinkukuma.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.5",
            "verseOrgIds": [
              "REV.8.5"
            ]
          }
        }
