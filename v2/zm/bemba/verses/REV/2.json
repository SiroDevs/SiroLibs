            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.2.9"
              },
              "items": [
                {
                  "text": "Icite 2:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Uuli na matwi, kanshi nakutike kufyo Mupashi alesosa ku nkuta! Kuli uyo uwacimfya, nkamupeela insambu shakulyako ifitwalo fya muti upeela umweo uwaba mu Cifulo Cansansa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.7",
            "verseOrgIds": [
              "REV.2.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2:7",
              "type": "text"
            },
            {
              "text": "Cifulo Cansansa:",
              "type": "text"
            },
            {
              "text": "Emukuti, “Paradise” (Luka 23:43; 2 Kol 12:3).",
              "type": "text"
            }
          ]
        }
      ]
    },
