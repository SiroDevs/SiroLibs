                "loc": "ISA.48.12"
              },
              "items": [
                {
                  "text": "48:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Lembela malaika wa lukuta lwa mu Simina ukuti,",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.8",
            "verseOrgIds": [
              "REV.2.8"
            ]
          }
        }
