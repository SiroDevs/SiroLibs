            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.115.4+PSA.115.5+PSA.115.6+PSA.115.7"
              },
              "items": [
                {
                  "text": "Amalu 115:4-7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.135.15+PSA.135.16+PSA.135.17"
              },
              "items": [
                {
                  "text": "135:15-17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.5.23"
              },
              "items": [
                {
                  "text": "Dan 5:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lelo abantu abasheleko, abo bonse abashafwile kuli ifi finkunka, tabatalwike ku fintu ifyo bapanga ne minwe yabo. Tabalekele ukupepa imipashi yakowela, nangu utulubi utwapangwa na golide, na silifa, no mukuba, na mabwe, ne fimuti, kabili tatumona nangu ukumfwa nangu ukwenda. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.20",
            "verseOrgIds": [
              "REV.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "REV 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili tabalekele ukwipaya abantu, ubuloshi, ubulalelale nangu ukwiba.",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.21",
            "verseOrgIds": [
              "REV.9.21"
            ]
          }
        }
      ]
    }
