                "loc": "1CH.18.11"
              },
              "items": [
                {
                  "text": "1 Imila 18:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ilyo imilimo yonse iyo Solomoni abombele mu ŋanda yakwa Yawe yapwile, aletelamo ifintu fyonse ifyo wishi Davidi apekenye no kupatula. Aletelamo silifa, golide elyo na fyonse ifyakucindamika mukati. Aisa fibika na mu matala ya ŋanda yakwa Lesa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.1",
            "verseOrgIds": [
              "2CH.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.6.12+2SA.6.13+2SA.6.14+2SA.6.15"
              },
              "items": [
                {
                  "text": "2 Sam 6:12-15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.15.25+1CH.15.26+1CH.15.27+1CH.15.28"
              },
              "items": [
                {
                  "text": "1 Imila 15:25-28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo Solomoni aita abakalamba bonse aba mu Israeli, intungulushi sha nko shonse elyo na bakalamba ba ndupwa sha bena Israeli ukuya ku Yerusalemu pakuti balete Imbokoshi ya Cipangano cakwa Yawe ukufuma ku Sioni, umusumba wakwa Davidi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.2",
            "verseOrgIds": [
              "2CH.5.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "5:2",
              "type": "text"
            },
            {
              "text": "Sioni:",
              "type": "text"
            },
            {
              "text": "Sioni lishina lya lubali lwa lupili apakuulilwe umusumba wakwa Davidi uwakale, lelo pali ino nshita umusumba wa Yerusalemu walikula washinguluka no lupili lonse.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.2",
            "verseOrgIds": [
              "2CH.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili abaume bonse aba mu Israeli baisa longana pamo ku mfumu pa nshita ya nshikunkulu mu mweshi walenga cine lubali.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.3",
            "verseOrgIds": [
              "2CH.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.3",
            "verseOrgIds": [
              "2CH.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo abakalamba bonse aba mu Israeli bafika, abena Levi epakwimya Imbokoshi ya cipangano cakwa Yawe basenda, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.4",
            "verseOrgIds": [
              "2CH.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "elyo baleta Imbokoshi ya cipangano cakwa Yawe, Itenti lyakukumaninamo elyo ne fyamushilo fyonse ifyabamo. Bashimapepo abena Levi ebasenda fyonse. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.5",
            "verseOrgIds": [
              "2CH.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo imfumu Solomoni no lukuta lonse ulwa bena Israeli, abalongene kulya ali, batangila pa ntanshi ya Mbokoshi ya cipangano cakwa Yawe, batuula impaanga ne ŋombe ishingi ishakuti teti shishibikwe nangu ukushipenda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.6",
            "verseOrgIds": [
              "2CH.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo bashimapepo baleta Imbokoshi ya Cipangano cakwa Yawe pa cifulo caiko icamushilo mukati ka ŋanda yakwa Lesa mu Muputule wamushilo icine cine. Baiteka mwisamba lya mapindo ya bakerubi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.7",
            "verseOrgIds": [
              "2CH.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakerubi bayanshika amapindo pa mulu wa ncende apali Imbokoshi ya cipangano cakwa Yawe, yafimba ne mbokoshi ya cipangano cakwa Yawe pamo ne fimuti fyakupingilako. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.8",
            "verseOrgIds": [
              "2CH.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifi fimuti fyali ifitali icalengele nokuti impela yafiko ilemoneka ku bali mu Muputule wamushilo, kuntanshi ya muputule Wamushilo icine cine, lelo impela tashalemoneka ku bali kumbi iyoo. Kabili na lelo cilifye filya fine. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.9",
            "verseOrgIds": [
              "2CH.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.10.5"
              },
              "items": [
                {
                  "text": "Amaf 10:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mu Mbokoshi ya cipangano cakwa Yawe tamwali ifintu fimbi, kanofye amabwe ayapapatala yabili yalya Mose abikilemo ku Holebu, kulya Yawe apangile icipangano na bena Israeli ilyo bafumine ku Egupto.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.10",
            "verseOrgIds": [
              "2CH.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
