              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bacilolo bakwe epakumupangila mpaka bamwipaila mu ŋanda ye sano lyakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.24",
            "verseOrgIds": [
