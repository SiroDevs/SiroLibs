                "loc": "2KI.15.33+2KI.15.34+2KI.15.35"
              },
              "items": [
                {
                  "text": "2 Isham 15:33-35",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yotamu akwete imyaka amakumi yabili na isano (25) ilyo atendeke ukuteeka pa bufumu, elyo aikele pa bufumu mu musumba wa Yerusalemu pa myaka ikumi limo na mutanda (16). Nyina ishina lyakwe ali ni Yerusha umwana mwanakashi wakwa Sadoki. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.1",
            "verseOrgIds": [
              "2CH.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acitile ifyalungama pa cinso cakwa Yawe, ngefyo wishi Usia acitile, lelo ena tacitileko ifyacitile wishi ifyakuya ingila mwi Tempele lyakwa Yawe. Lelo abantu bena batwalililefye ukulacita ifyabubifi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.2",
            "verseOrgIds": [
              "2CH.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yotamu kabili akuula cipya cipya impongolo ya pamulu iya mu ŋanda yakwa Yawe, abomba ne milimo iyingi nganshi ku cibumba ca ku lupili lwa Ofeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.3",
            "verseOrgIds": [
              "2CH.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akuulamo imisumba mu mpili sha mu Yuda, amalinga elyo ne mpungu mu mpanga yonse.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.4",
            "verseOrgIds": [
              "2CH.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.4",
            "verseOrgIds": [
              "2CH.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yotamu abusha inkondo ne mfumu ya bena Amoni no kubacimfya. Muli uyu wine mwaka abena Amoni bapeele umusonko kuli Yotamu amatalanta umwanda umo (100) uwa silifa,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.5",
            "verseOrgIds": [
              "2CH.27.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "27:5",
              "type": "text"
            },
            {
              "text": "amatalanta 100:",
              "type": "text"
            },
            {
              "text": "Ekutila amakilo amakana yane ne myanda ine (3,400) aya silifa.",
              "type": "text"
            }
          ]
        },
        {
          "text": " amakilo umuntapendwa umo (1,000,000) aya ŋanu elyo na bale uwafina amakilo umuntapendwa umo (1,000,000). Abena Amoni batwalilile ukupeela uyu musonko mu mwaka wakonkelepo elyo na mu mwaka wabutatu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.5",
            "verseOrgIds": [
              "2CH.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.5",
            "verseOrgIds": [
              "2CH.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yotamu asuka akwatisha amaka pa mulandu wakuti aendele umuntu uwacishinka pa cinso cakwa Yawe, Lesa wakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.6",
            "verseOrgIds": [
              "2CH.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo ifintu fimbi ifyo Yotamu acitile pa bufumu, ukulundapofye ne nkondo shonse alwile elyo ne fintufye fimbi, fyonse ifi fyalilembwa mu citabo ca shamfumu sha bena Israeli na bena Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.7",
            "verseOrgIds": [
              "2CH.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali ne myaka amakumi yabili na isano (25) ilyo atendeke ukuteeka pa bufumu, kabili aikele pa bufumu mu Yerusalemu pa myaka ikumi limo na mutanda (16) ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.8",
            "verseOrgIds": [
              "2CH.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo Yotamu afwile no kuya lala ukwalala ifikolwe fyakwe, bamushiikile mu musumba wakwa Davidi. Elyo Ahasi umwana wakwe ewamupyene pa bufumu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.9",
            "verseOrgIds": [
              "2CH.27.9"
            ]
          }
        }
      ]
    }
  ],
