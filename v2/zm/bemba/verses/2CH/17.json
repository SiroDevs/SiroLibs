          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba e bashilika abalelinda imfumu, ukwabula ukupenda abo yatekele mu misumba ya malinga mu calo conse ica bena Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.19",
