              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.7.1+2SA.7.2+2SA.7.3+2SA.7.4+2SA.7.5+2SA.7.6+2SA.7.7+2SA.7.8+2SA.7.9+2SA.7.10+2SA.7.11+2SA.7.12+2SA.7.13"
              },
              "items": [
                {
                  "text": "2 Sam 7:1-13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.17.1+1CH.17.2+1CH.17.3+1CH.17.4+1CH.17.5+1CH.17.6+1CH.17.7+1CH.17.8+1CH.17.9+1CH.17.10+1CH.17.11+1CH.17.12"
              },
              "items": [
                {
                  "text": "1 Imila 17:1-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo yalanda aiti,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.4",
            "verseOrgIds": [
              "2CH.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.11",
            "verseOrgIds": [
              "2CH.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Solomoni aiminina ku ntanshi ya bulambo bwakwa Yawe pa cinso ca lukuta lwa bantu bonse abena Israeli elyo atambalika amaboko yakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.12",
            "verseOrgIds": [
              "2CH.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomba, Solomoni alipangile icibumbili ica mukuba icali amakubiti yasano mubutali, amakubiti yasano mubwipi elyo na makubiti yatatu ukuya pa mulu,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.13",
            "verseOrgIds": [
              "2CH.6.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "6:13",
              "type": "text"
            },
            {
              "text": "Ekutila, calepele ukucilako panono bamita babili (2.3m) mubutali, ukucilako panono bamita babili (2.3m) mubwipi, elyo ukucilako mita umo (1.3m) ukuya pa mulu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " elyo acibikile pakati ka lubansa lwakunse. Aiminina pa mulu wa cibumbili elyo afukama pantanshi ye bumba lya bena Israeli elyo asumbwila amaboko ku mulu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.13",
            "verseOrgIds": [
              "2CH.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alanda ukuti,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.14",
            "verseOrgIds": [
              "2CH.6.14"
            ]
          }
        }
      ]
    }
