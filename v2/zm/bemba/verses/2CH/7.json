              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.10",
            "verseOrgIds": [
              "2CH.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi Solomoni efyo apwile ukukuula iŋanda yakwa Yawe elyo ne sano lyakwe, kabili afikilishapo no kucita fyonse ifyo alefwaya ukubomba mu ŋanda yakwa Yawe elyo na kwisano lyakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.11",
            "verseOrgIds": [
              "2CH.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Yawe amonekela kuli ena mu nshita ya bushiku no kumweba ati,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.12",
            "verseOrgIds": [
              "2CH.7.12"
            ]
          }
        }
      ]
    }
