              "2CH.28.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.16.5"
              },
              "items": [
                {
                  "text": "2 Isham 16:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.7.1"
              },
              "items": [
                {
                  "text": "Esaya 7:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ifi alecita, efyalengele Yawe Lesa wakwe ukumulekako, amupeela na mu minwe ya mfumu ya ku Aramu. Abena Aramu bamulwisha bamucimfya basendako na bantu bakwe abengi ku Damasiko muli bunkole. Kabili Lesa amupeela mu minwe ya mfumu ya bena Israeli, nabo bamulwisha no kwipaya abantu abengi nganshi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.5",
            "verseOrgIds": [
              "2CH.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa mulandu wakuti balisuulile Yawe Lesa wa fikolwe fyabo, calengele nokuti Peka mwana Remaliya epaye abantu amakana umwanda umo na makumi yabili (120,000) aba mu Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.6",
            "verseOrgIds": [
              "2CH.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Sikiri umushilika wa bena Efulemu, aipaya Maaseya umwana wa mfumu, aipaya na Asirikani uwali cilolo mukalamba kwisano, elyo na Elikana uwakonkelepo imfumu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.7",
            "verseOrgIds": [
              "2CH.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili abena Israeli basendamo abanakashi, abana abaume na banakashi aba muli bamunyinabo amakana imyanda ibili (200,000), elyo ne fitapwa ifingi bafitwala ku Samaria.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.8",
            "verseOrgIds": [
              "2CH.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.8",
            "verseOrgIds": [
              "2CH.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomba mu Samaria mwali kasesema wakwa Yawe ishina lyakwe Odedi, ewaimine mukuya kumanya abashilika ilyo bacili mukubwelelamo ku Samaria. Elyo abeba ati, “Ni pa mulandu wakuti Yawe, Lesa wa bashinwe, alifulilwe abena Yuda eco abapeelele mu minwe yenu. Lelo imwe mwaya cishamo mwaya ipaya abantu ukwabula uluse icakuti na Lesa ku mulu afulwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.9",
            "verseOrgIds": [
              "2CH.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili mulefwaya nomba mubuule abaume na banakashi ba mu Yuda na mu Yerusalemu ukuba abasha benu. Bushe imwe emukuti tamwacitapo ifyabubifi kuli Yawe Lesa wenu? ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.10",
            "verseOrgIds": [
              "2CH.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eico nomba umfweni kuli ine. Bweseshenimo bamunyinenwe aba musendele bunkole, pantu pali ino nshita Yawe namufulilwa nganshi.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.11",
            "verseOrgIds": [
              "2CH.28.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.11",
            "verseOrgIds": [
              "2CH.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo intungulushi shimo isha bena Efulemu, Asariya mwana Yohanani, Berekiya mwana Meshilemoti, Yehisikiya mwana Shalumu elyo na Amasa mwana Hadilai baiminika bonse abalefuma ku bulwi no kubeba ati, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.12",
            "verseOrgIds": [
              "2CH.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Imwe, tamufwile ukuleta aba bantu musendele bunkole kuno, pantu mwalalenga ukuti tukwate umulandu kuli Yawe! Bushe mulefwaya ukulenga ukuti ububifi bwesu ne fibi fyesu filekulilakofye? Pantu ukufuma ku kale ifwe twaba ne milandu iyikalamba nganshi, elyo na Lesa acili uwafulilwa abena Israeli.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.13",
            "verseOrgIds": [
              "2CH.28.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.13",
            "verseOrgIds": [
              "2CH.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi abashilika epakulekako abantu bonse abo basendele bunkole pamo ne fitapwa fyonse ninshi na bacilolo elyo ne bumba lyonse lilemonako. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.14",
            "verseOrgIds": [
              "2CH.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Palipo abaume abalumbwilwe amashina, ebabuula abantu basendele bunkole no kubabweseshamo. Elyo babuulapo ifyakufwala pa fitapwa bafwika bonse abashafwele. Babapeela ifyakufwala ku mibili elyo ne ndyato sha ku makasa, ifyakulya, ifyakunwa elyo ne miti yakuposeshako amalwele. Babuula bonse abashakwete amaka babaninika pali bapunda. Kanshi epakubatwala ku Yeriko umusumba wa tuncindu ukwali bamunyinabo, eko bafumine pakubwelela ku Samaria.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.15",
            "verseOrgIds": [
              "2CH.28.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.15",
            "verseOrgIds": [
              "2CH.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cali pa nshita ine ilya elyo imfumu Ahasi yatumine amashiwi ku mfumu ya bena Asiria ayakulomba ubwafwilisho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.16",
            "verseOrgIds": [
              "2CH.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acitile ifi pantu abena Edomu balishile nakabili no kwisa lwisha abena Yuda, basendamo na bantu muli bunkole, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.17",
            "verseOrgIds": [
              "2CH.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ilyo pa nshita imo ine Abafilisiti baisa sansa imisumba iyali mwisamba lya mpili elyo na mu matololo ya Negebu ya mu Yuda. Elyo bapokolola no kwikalamo mu ncende sha Beti Shemeshi, Aiyaloni na Gederoti, pamo na Soko, Timuna na Gimuso kumo kwine no tumishi utwashingulwike mumbali. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.18",
            "verseOrgIds": [
              "2CH.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe alefwaya abena Yuda banakile pa mulandu wa fyacitile Ahasi imfumu ya bena Israeli, uwalekoselesha ukubifya mu Yuda, na pakuba uwabula icishinka kuli Yawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.19",
            "verseOrgIds": [
              "2CH.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo ilyo Tigilati Pilese imfumu ya bena Asiria aishile, atendeka ukucusha imfumu Ahasi mu cifulo cakuti amwafweko. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.20",
            "verseOrgIds": [
              "2CH.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Ahasi abuula ifintu ifingi nganshi ifyamutengo ukufuma mu ŋanda yakwa Yawe, fimbi ukufuma mu ŋanda ya kwisano elyo na fimbi ukufuma kuli bacilolo, no kufipeela ku mfumu ya ku Asiria, lelo ifi acitile tafyamwafwile nangu panono.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.21",
            "verseOrgIds": [
              "2CH.28.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.21",
            "verseOrgIds": [
              "2CH.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu nshita ine ilya imfumu Ahasi akwete amafya, emo nao aishile cishamo ukufilwa ukuba uwacishinka kuli Yawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.22",
            "verseOrgIds": [
              "2CH.28.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayambile ukutuula amalambo ku milungu ya ku Damasiko, kulya bamucimfishe ku nkondo, pantu ena atontonkenye ukuti, “Apofye imilungu ya bena Aramu naibafwa ati na ine eko nalatuula amalambo pakuti ingafweko.” Lelo ici acitile ecaishile muletelela no kuletelela Israeli yonse.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.23",
            "verseOrgIds": [
              "2CH.28.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
