            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.6.19+2SA.6.20"
              },
              "items": [
                {
                  "text": "2 Sam 6:19-20",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo abantu bonse basalangene, cila muntu alungama kumwakwe. Elyo Davidi abwelelamo kumwakwe mukuya paala ulupwa lwakwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.43",
            "verseOrgIds": [
              "1CH.16.43"
            ]
          }
        }
