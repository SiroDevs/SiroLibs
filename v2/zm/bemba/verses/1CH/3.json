          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.22",
            "verseOrgIds": [
              "1CH.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana bakwa Neariya bali ni Elioenai, Hisikiya elyo na Asirikamu. Bonse pamo bali batatu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.23",
            "verseOrgIds": [
              "1CH.3.23"
            ]
          }
        }
      ]
    },
