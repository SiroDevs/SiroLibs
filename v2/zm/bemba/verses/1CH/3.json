          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana bakwa Elioenai bali ni Hodafiya, Eliashibu, Pelaiya, Akuba, Yohanani, Delaiya elyo na Anani. Bonse pamo bali cine lubali.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.24",
            "verseOrgIds": [
              "1CH.3.24"
            ]
          }
