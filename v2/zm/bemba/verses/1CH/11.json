                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.1.21"
              },
              "items": [
                {
                  "text": "Abap 1:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Davidi na bena Israeli bonse baimine no kuya ku Yerusalemu, uko batila Yebusi. Abena Yebusi ebaleikala kulya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.4",
            "verseOrgIds": [
              "1CH.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abekashi ba mu Yebusi balanda kuli Davidi abati, “Tawaingilemo muno.” Lelo Davidi apokolola ilinga lya Sioni, nomba uwitwa umusumba wakwa Davidi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.5",
            "verseOrgIds": [
              "1CH.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi alandile ukuti, “Uyo onse uuletangila mukulwisha abena Yebusi euli nokuba umukalamba wa fita fya nkondo.” Yoabu mwana Seruiya uwabalilepo, efyo apeelwe no kuba umukalamba wa fita. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.6",
            "verseOrgIds": [
              "1CH.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awe Davidi epakuya ikala mukati ke linga, kabili ni pali ici lyainikilwe ishina umusumba wakwa Davidi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.7",
            "verseOrgIds": [
              "1CH.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili Davidi akuulamo umusumba ukushinguluka, ukufuma ku fibumbili fyakwikasha ifikulwa ukushinta ku cibumba cashingulwike. Elyo ninshi Yoabu alepwishishisha incende yashele iya musumba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.8",
            "verseOrgIds": [
              "1CH.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili amaka yakwa Davidi yaleya yalecililakofye, pantu Yawe umwine wa fita ali nankwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.9",
            "verseOrgIds": [
              "1CH.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
