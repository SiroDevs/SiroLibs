              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eleasa afyele Sismai elyo nao Sismai afyele Shalumu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.40",
            "verseOrgIds": [
              "1CH.2.40"
            ]
          }
