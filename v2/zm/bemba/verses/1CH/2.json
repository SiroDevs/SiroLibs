          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana bakwa Huri ibeli lyakwa Efulata ni Shabali wishi wakwa Kiriati Yarimu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.50",
            "verseOrgIds": [
              "1CH.2.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1CH 2:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salima wishi wakwa Betelehemu, elyo na Harefu wishi wakwa Beti Gada.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.51",
            "verseOrgIds": [
              "1CH.2.51"
            ]
          }
        }
      ]
    },
