              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulupwa lwakwa Kalebu, munyina wakwa Yerameli ni Mesha ibeli lyakwe, uwali wishi wakwa Sifu, elyo no mwana wakwe Maresha uwali wishi wakwa Hebuloni.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.42",
            "verseOrgIds": [
              "1CH.2.42"
            ]
          }
        }
