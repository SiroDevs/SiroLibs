          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efah, umukashi uushaupilwe mu bwinga uwakwa Kalebu, afyele Harani, Mosa elyo na Gasesi. Elyo Harani nao alikwete umwana uwe shina lya Gasesi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.46",
            "verseOrgIds": [
