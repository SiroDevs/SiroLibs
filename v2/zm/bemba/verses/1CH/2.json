          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.53",
            "verseOrgIds": [
              "1CH.2.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "1CH 2:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indupwa shakwa Salima shali ni Betelehemu, abena Netofati, abena Atoti Beti Yoabu, citika wa bena Manahati, abena Sorati. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.54",
            "verseOrgIds": [
              "1CH.2.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "1CH 2:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo ne mikowa ya bakalemba",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.55",
            "verseOrgIds": [
              "1CH.2.55"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2:55",
              "type": "text"
            },
            {
              "text": "Bakalemba:",
              "type": "text"
            },
            {
              "text": "Ba Baibele bamo batila abena Sofeli, pantu “Sofeli” lishiwi lya mu Cihibulu ilyalola mukutila “kalemba”.",
              "type": "text"
            }
          ]
        },
        {
          "text": " abaikele ku Yabesi bali ni aba: abena Tirati, abena Shimeati elyo na bena Sukati. Aba e bena Keni abafumine muli Hamati wishi wa ba ŋanda yakwa Rekabu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.55",
            "verseOrgIds": [
              "1CH.2.55"
            ]
          }
        }
