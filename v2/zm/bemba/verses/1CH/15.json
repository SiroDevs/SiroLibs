          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.28",
            "verseOrgIds": [
              "1CH.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cilya Imbokoshi ya Cipangano cakwa Yawe yaba pakwingila mu musumba wakwa Davidi, Mika umwana umwanakashi wakwa Saulo ninshi eminine pa nsolokoto epo aletambila. Ilyo amwene uko imfumu Davidi ilecinda no kusefya, ena amususha mu mutima wakwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.29",
            "verseOrgIds": [
              "1CH.15.29"
            ]
          }
        }
      ]
    }
  ],
