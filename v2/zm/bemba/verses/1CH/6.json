        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.16",
            "verseOrgIds": [
              "1CH.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
