              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.18",
            "verseOrgIds": [
              "1CH.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana bakwa Merari bali ni Mali na Mushi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.19",
            "verseOrgIds": [
              "1CH.6.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi ishi e ndupwa sha bena Levi ukulingana no mwakonkanina bashibo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.19",
            "verseOrgIds": [
              "1CH.6.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.19",
            "verseOrgIds": [
              "1CH.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geshoni afyele Libini, Libini nao afyele Yehati elyo Yehati nao afyala Sima. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.20",
            "verseOrgIds": [
              "1CH.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima nao afyala Yoa, Yoa nao afyala Ido, Ido nao afyala Sera, Sera nao afyala Yeateraiya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.21",
            "verseOrgIds": [
              "1CH.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.21",
            "verseOrgIds": [
              "1CH.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koati afyele Aminadabu, Aminadabu nao afyala Kora, Kora nao afyala Asiri, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.22",
            "verseOrgIds": [
              "1CH.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asiri afyala Elikana, Elikana nao afyala Ebiyasafu, nao afyala Asiri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.23",
            "verseOrgIds": [
              "1CH.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asiri afyala Tahati, Tahati nao afyala Urieli, Urieli nao afyala Usia, Usia nao afyala Shauli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.24",
            "verseOrgIds": [
              "1CH.6.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
