          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana bakwa Elikana ni Amasai na Ahimoti. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.25",
            "verseOrgIds": [
              "1CH.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahimoti afyala Elikana, Elikana nao afyala Sofai, Sofai nao afyala Nahati. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.26",
            "verseOrgIds": [
              "1CH.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nahati afyala Eliabu, Eliabu nao afyala Yerohamu, Yerohamu nao afyala Elikana elyo Elikana nao afyala Samwele. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.27",
            "verseOrgIds": [
              "1CH.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samwele afyele Yoeli, uwali ibeli lyakwe, na Abiya uwali uwacibili.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.28",
            "verseOrgIds": [
              "1CH.6.28"
            ]
          }
        }
      ]
