          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usa afyala Shimea, Shimea nao afyala Haggia, elyo nao afyala Asaya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.30",
            "verseOrgIds": [
              "1CH.6.30"
            ]
          }
        }
