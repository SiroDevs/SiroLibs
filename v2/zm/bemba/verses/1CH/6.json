          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana abaume bakwa Merari ni Maili, uwafyele Libini, Libini afyele Shimei, Shimei nao afyala Usa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.29",
            "verseOrgIds": [
              "1CH.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
