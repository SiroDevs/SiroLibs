            "sid": "1CH 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana bakwa Levi bali ni Geshoni, Koati elyo na Merari.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.1",
            "verseOrgIds": [
              "1CH.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.1",
            "verseOrgIds": [
              "1CH.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana bakwa Koati ni Amuramu, Isa, Hebuloni elyo na Usieli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.2",
            "verseOrgIds": [
              "1CH.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.2",
            "verseOrgIds": [
              "1CH.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana bakwa Amuramu ni Aroni, Mose elyo na Miriamu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.3",
            "verseOrgIds": [
              "1CH.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo abana bakwa Aroni ni Nadabu, Abihu, Eleasa elyo na Itama. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.3",
            "verseOrgIds": [
              "1CH.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eleasa afyele Fineasi, elyo Fineasi nao afyala Abishua. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.4",
            "verseOrgIds": [
              "1CH.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abishua afyele Buki, elyo Buki nao afyele Usi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.5",
            "verseOrgIds": [
              "1CH.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usi afyele Serahia, elyo Serahia nao afyala Meraioti, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.6",
            "verseOrgIds": [
              "1CH.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meraioti afyele Amaria, elyo Amaria nao afyala Ahitubi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.7",
            "verseOrgIds": [
              "1CH.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahitubi afyele Sadoki, elyo Sadoki afyala Aimasi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.8",
            "verseOrgIds": [
              "1CH.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aimasi afyele Asariya, elyo Asariya nao afyala Yohanani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.9",
            "verseOrgIds": [
              "1CH.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yohanani afyele Asariya uyu wine ewali shimapepo mwi Tempele Solomoni akuulile mu Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.10",
            "verseOrgIds": [
              "1CH.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asariya afyele Amaria, Amaria afyele Aitubi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.11",
            "verseOrgIds": [
              "1CH.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahitubi afyele Sadoki, elyo Sadoki nao afyala Shalumu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.12",
            "verseOrgIds": [
              "1CH.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shalumu afyele Hilikiya, elyo Hilikiya nao afyala Asariya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.13",
            "verseOrgIds": [
              "1CH.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asariya afyele Seraya, elyo Seraya nao afyala Yehosadaki. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.14",
            "verseOrgIds": [
              "1CH.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehosadaki nao asendelwe muli bunkole ilyo Yawe alekele abena Yuda na bena Yerusalemu basendwa muli bunkole ku kuboko kwakwa Nebukadinesa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.15",
            "verseOrgIds": [
              "1CH.6.15"
            ]
          }
        }
      ]
    },
