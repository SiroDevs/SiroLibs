          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya e mashina ya bana bakwa Geshoni: Libini na Shimei.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.17",
            "verseOrgIds": [
              "1CH.6.17"
            ]
          }
