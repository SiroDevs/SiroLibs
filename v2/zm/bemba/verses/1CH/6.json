          },
          "items": [
            {
              "text": "71",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana bakwa Geshoni bapeelwe Golani mu Bashani ukufuma mu lupwa citika wa luko lwakwa Manase elyo na Ashitaloti, pamo pene ne fitungu ifyaiko ifyakucemenamo ifitekwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.71",
            "verseOrgIds": [
              "1CH.6.71"
            ]
          }
        }
      ]
