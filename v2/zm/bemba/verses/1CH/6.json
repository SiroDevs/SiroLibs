            }
          ]
        },
        {
          "text": "Abana bakwa Levi bali ni Geshoni",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.16",
            "verseOrgIds": [
              "1CH.6.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "6:16",
              "type": "text"
            },
            {
              "text": "Ishina lya Geshoni mumbi balemba ati Geshomu.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", Koati na Merari.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.16",
            "verseOrgIds": [
              "1CH.6.16"
            ]
          }
        }
      ]
