              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukufuma ku bena Koati bali ni aba:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.33",
            "verseOrgIds": [
              "1CH.6.33"
