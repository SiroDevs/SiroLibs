          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba e baume Davidi asalile ukulatungulula inyimbo mu ŋanda yakwa Yawe, umo baletele imbokoshi ya Cipangano ukwisa tuushamo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.31",
            "verseOrgIds": [
              "1CH.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balebomba umulimo wakwimba inyimbo mu cifulo cakwikalamo ice Tenti lyakwa Lesa ilyakukumaninamo, mpaka Solomoni ilyo akuulile iŋanda yakwa Yawe mu Yerusalemu. Balebomba imilimo yabo ukulingana na mafunde yapeelwe kuli bena. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.32",
            "verseOrgIds": [
              "1CH.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba e baume babombele pamo na bana babo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.33",
            "verseOrgIds": [
              "1CH.6.33"
            ]
          }
        }
      ]
    },
    {
