        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "77",
            "style": "v",
            "sid": "1CH 6:77"
          },
          "items": [
            {
              "text": "77",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku basheleko abena Levi, bamwana Merari, bapeelelwe ukufuma ku citungu cakwa Sebuloni, Yokunimu na Kata",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.77",
            "verseOrgIds": [
              "1CH.6.77"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "6:77",
              "type": "text"
            },
            {
              "text": "Muli ba Baibele ba mu Cihibulu tamwaba amashina ya misumba ibili Yokunimu na Kata.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", Rimono na Tabo pamo pene ne fitungu ifyaiko ifyakucemenamo ifitekwa.",
          "type": "text",
