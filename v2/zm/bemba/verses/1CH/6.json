          },
          "items": [
            {
              "text": "64",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi abena Israeli efyo bapeele abena Levi imisumba pamo ne fitungu ifyashingulukako ifyakucemenamo ifitekwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.64",
