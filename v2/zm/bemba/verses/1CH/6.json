          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishi e ncende baleikalamo, ukulingana ne mipaka ya fifulo fyabo ifyapeelwe ku bana bakwa Aroni aba mu lupwa lwakwa Koati, pantu ebo icipendwilo cantanshi cawilile.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.54",
