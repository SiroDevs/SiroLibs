          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba e bana bakwa Aroni: Eleasa ewali umwana wakwe, Fineasi nao ewali umwana wakwa Eliese, Abishua nao ewali umwana wakwa Fineasi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.50",
            "verseOrgIds": [
              "1CH.6.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1CH 6:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buki nao ewali umwana wakwa Abishua, na Usi ewali umwana wakwa Buki. Serahiya ewali umwana wakwa Usi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.51",
            "verseOrgIds": [
              "1CH.6.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "1CH 6:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meraioti nao ewali umwana wakwa Serahiya, Amaria nao ewali umwana wakwa Meraioti, Ahitubi nao ewali umwana wakwa Amaria. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.52",
            "verseOrgIds": [
              "1CH.6.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "1CH 6:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sadoki nao ewali umwana wakwa Ahitubi elyo na Aimasi nao ewali umwana wakwa Sadoki.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.53",
            "verseOrgIds": [
              "1CH.6.53"
            ]
          }
        }
      ]
