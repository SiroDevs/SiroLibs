          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana bakwa Koati bali ni Amuramu, Isari, Hebuloni na Usieli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.18",
            "verseOrgIds": [
              "1CH.6.18"
            ]
          }
        }
      ]
