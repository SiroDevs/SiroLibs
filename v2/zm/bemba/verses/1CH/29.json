        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.1",
            "verseOrgIds": [
              "1CH.29.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.22.5"
              },
              "items": [
                {
                  "text": "1 Imila 22:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo imfumu Davidi yaebele ibumba lya bantu bonse aiti,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.1",
            "verseOrgIds": [
              "1CH.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.5",
            "verseOrgIds": [
              "1CH.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo intungulushi sha mayanda ya bashibo, abakalamba ba nko sha bena Israeli, abakalamba ba pa fita amakana (1,000), abakalamba ba pa fita imyanda (100), elyo na bacilolo abalemona pa milimo ya mfumu baliipeele mukuitemenwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.6",
            "verseOrgIds": [
              "1CH.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bapeele ku mulimo wa ŋanda yakwa Lesa amatalanta amakana yasano (5,000)",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.7",
            "verseOrgIds": [
              "1CH.29.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "29:7",
              "type": "text"
            },
            {
              "text": "amatalanta 5,000:",
              "type": "text"
            },
            {
              "text": "Ekutila amakilo amakana umwanda umo na makumi cine lubali (170,000).",
              "type": "text"
            }
          ]
        },
        {
          "text": " elyo na madariki amakana ikumi limo (10,000) aya golide,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.7",
            "verseOrgIds": [
              "1CH.29.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "29:7",
              "type": "text"
            },
            {
              "text": "amadariki 10,000:",
              "type": "text"
            },
            {
              "text": "Ekutila amakilo amakumi cine konse konse na yane (84) aya golide.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", amatalanta amakana ikumi limo (10,000) aya silifa",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.7",
            "verseOrgIds": [
              "1CH.29.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "29:7",
              "type": "text"
            },
            {
              "text": "amatalanta 10,000:",
              "type": "text"
            },
            {
              "text": "Ekutila amakilo amakana imyanda itatu na makumi yane na yasano (345,000) aya silifa.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", amatalanta amakana ikumi limo na cine konse konse (18,000) aya mukuba",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.7",
            "verseOrgIds": [
              "1CH.29.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "29:7",
              "type": "text"
            },
            {
              "text": "amatalanta 18,000:",
              "type": "text"
            },
            {
              "text": "Ekutila amakilo amakana imyanda mutanda ne kumi limo (610,000) aya mukuba.",
              "type": "text"
            }
          ]
        },
        {
          "text": " elyo na matalanta amakana umwanda umo (100,000) aya cela",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.7",
            "verseOrgIds": [
              "1CH.29.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "29:7",
              "type": "text"
            },
            {
              "text": "amatalanta 100,000:",
              "type": "text"
            },
            {
              "text": "Ekutila amakilo imintapendwa itatu na makana imyanda ine na makumi yasano (3,450,000) aya cela.",
              "type": "text"
            }
          ]
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.7",
            "verseOrgIds": [
              "1CH.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onse uwakwete utumabwe twamutengo apeela ku cipao ca ŋanda yakwa Yawe no kufisha mu minwe yakwa Yehieli umwina Geshoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.8",
            "verseOrgIds": [
              "1CH.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icintubwingi calisansamwike pa musango wa fintu intungulushi shabo shasekelele ukupeela kwakuitemenwa ne mitima yabo kuli Yawe. Kabili imfumu Davidi nayo yalisansamwike nganshi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.9",
            "verseOrgIds": [
              "1CH.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.9",
            "verseOrgIds": [
              "1CH.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi alumbanya Yawe pa cinso cabalongene bonse alanda ati,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.10",
            "verseOrgIds": [
              "1CH.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.19",
            "verseOrgIds": [
              "1CH.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Davidi aeba abantu bonse abalongene ati, “Nomba paaleni Yawe Lesa wenu na matotelo.” Kanshi bonse epakulapaala Yawe, Lesa wa bashibo, na matotelo. Bonse bakontamika imitwe yabo panshi no kupeela umucinshi kuli Yawe na ku mfumu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.20",
            "verseOrgIds": [
              "1CH.29.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.20",
            "verseOrgIds": [
              "1CH.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubushiku bwakonkelepo abena Israeli balekele Yawe amalambo na malambo yakoca. Balekele iŋombe ishilume ikana limo (1,000), basukusuku ikana limo (1,000), utwana twa mpaanga utwaume ikana limo (1,000), pamo ne mituulo ya fyakunwa, elyo na malambo ayengi ukulingana na bena Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.21",
            "verseOrgIds": [
              "1CH.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi pali bulya bushiku balya no kunwa ne nsansa ishingi pa cinso cakwa Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.22",
            "verseOrgIds": [
              "1CH.29.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo babuula Solomoni mwana Davidi bamubika pa bufumu umuku wacibili, no kumusuba ukuba imfumu pa cinso cakwa Yawe, elyo Sadoki nao ukuba shimapepo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.22",
            "verseOrgIds": [
              "1CH.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.2.12"
              },
              "items": [
                {
                  "text": "1 Isham 2:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo Solomoni aya ikala pa cipuna cabufumu ico Yawe amusontelepo kukuteeka pa malo yakwa wishi Davidi. Atendeka no kushuka mufyo alecita elyo na bena Israeli bonse balamubeela. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.23",
            "verseOrgIds": [
              "1CH.29.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bacilolo bonse, impalume shonse, pamo pene na bana baume bonse aba mfumu Davidi, baipeele ukulanakila imfumu Solomoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.24",
            "verseOrgIds": [
              "1CH.29.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi Yawe nao acindamika Solomoni apakalamba nganshi pa cinso ca bena Israeli bonse, amupeela no bufumu ubwalulumbi, ubushatalile abukwata imfumu nelyo imo mu Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.25",
            "verseOrgIds": [
              "1CH.29.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.25",
            "verseOrgIds": [
              "1CH.29.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi mwana Yese ateekele Israeli yonse ilyo ali pa bufumu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.26",
            "verseOrgIds": [
              "1CH.29.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.5.4+2SA.5.5"
              },
              "items": [
                {
                  "text": "2 Sam 5:4-5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.3.4"
              },
              "items": [
                {
                  "text": "1 Imila 3:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ateekele pa bufumu mu calo ca Israeli pa myaka amakumi yane (40). Imyaka cine lubali ateekele mu Hebuloni, elyo pa myaka amakumi yatatu na itatu (33) ateekele mu Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.27",
            "verseOrgIds": [
              "1CH.29.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afwile ninshi ali ne myaka isuma nganshi iyabukote bwe shuko, ubwa nshiku ishingi, ifyuma ifingi elyo no mucinshi uwingi. Solomoni umwana wakwe epakupyana pa cifulo cakwe icabufumu mukuteeka icalo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.28",
            "verseOrgIds": [
              "1CH.29.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.28",
            "verseOrgIds": [
              "1CH.29.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo palwa fintu fimbi ifya pa bufumu bwakwa Davidi, ukufuma ilyo atendeke ukuteeka ukufika na ku mpela, fyonse fyalilembwa mu citabo camilandu cakwa kamona Samwele, mu citabo camilandu cakwa Natani kasesema, elyo na mu citabo camilandu cakwa Gadi uwali kamona. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.29",
            "verseOrgIds": [
              "1CH.29.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu fitabo fine ifi emwaba ne fishinka fyonse ifya pa bufumu bwakwe, amaka akwete, ifintu fyonse ifyamucitikile, ifyacitikile Israeli lintu ali pa bufumu, elyo ne fyacitike ku shamfumu sha mu fyalo fimbi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.30",
            "verseOrgIds": [
              "1CH.29.30"
            ]
          }
        }
      ]
    }
  ],
  "next": {
