            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.8.15+2SA.8.16+2SA.8.17+2SA.8.18"
              },
              "items": [
                {
                  "text": "2 Sam 8:15-18",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi ateekele icalo ca bena Israeli conse mu mulinganya. Alecita ubupingushi ubwacishinka ku bantu bakwe bonse. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.14",
            "verseOrgIds": [
              "1CH.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoabu mwana Seruiya ewali umukalamba wa fita. Elyo Yehoshafati umwana wakwa Ailudi ali kalemba wa fyalecitika mu calo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.15",
            "verseOrgIds": [
              "1CH.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sadoki mwana Ahitubi na Aimeleki mwana Abiyata bali bashimapepo. Shafisha nao ali kalemba wa milandu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.16",
            "verseOrgIds": [
              "1CH.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benaya mwana Yehoiyada ewali intungulushi ya bena Kereti na bena Peleti. Elyo abana bakwa Davidi nabo ebali bacilolo ba mfumu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.17",
            "verseOrgIds": [
              "1CH.18.17"
            ]
          }
        }
      ]
    }
