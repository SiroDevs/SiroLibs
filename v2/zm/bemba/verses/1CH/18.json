            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.60"
              },
              "items": [
                {
                  "text": "Amalu 60",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abishai umwana wakwa Seruiya aipaya abena Edomu amakana ikumi limo na cine konse konse (18,000) mwi Shika Lyamucele. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.12",
            "verseOrgIds": [
              "1CH.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo abika no twamba twa bashilika mu calo ca bena Edomu, elyo na bonse abena Edomu bacimba kuli Davidi. Kabili Yawe alengele Davidi ukulacimfya konse uko aile.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.13",
            "verseOrgIds": [
              "1CH.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
