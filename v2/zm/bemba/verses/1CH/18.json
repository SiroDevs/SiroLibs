              "1CH.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo Tou",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.9",
            "verseOrgIds": [
              "1CH.18.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "18:9",
              "type": "text"
            },
            {
              "text": "Tou:",
              "type": "text"
            },
            {
              "text": "Ishina limbi ni “Toi” (2 Sam 8:9).",
              "type": "text"
            }
          ]
        },
        {
          "text": " imfumu ya ku Hamati aumfwile ukuti Davidi nacimfya ifita fya nkondo fyonse ifyakwa Hadadesa imfumu ya ku Soba, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.9",
            "verseOrgIds": [
              "1CH.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "atuma umwana wakwe Hadoramu ku mfumu Davidi kukuya muposha no kumutasha pakulwisha Hadadesa no kumucimfya. Pantu kunuma Hadadesa lyonse ewalelwa na Tou. Hadoramu aletele ifyabupe ifingi ifya golide, silifa ne fya mukuba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.10",
            "verseOrgIds": [
              "1CH.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imfumu Davidi yatuulile ifipe fyonse ifi kuli Yawe, ngefyo acitile kuli silifa na golide iyo apokolwele ukufuma ku mishobo iyi iya bena Edomu, abena Moabu, abena Amoni, Abafilisiti elyo na bena Amaleki.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.11",
            "verseOrgIds": [
              "1CH.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
