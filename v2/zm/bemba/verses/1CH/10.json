            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.28.7+1SA.28.8"
              },
              "items": [
                {
                  "text": "28:7-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Saulo afwile pa mulandu wakukanaba ne cishinka kuli Yawe. Alifililwe ukubaka ishiwi lyakwa Yawe elyo asukile afika na mukuya ipusha imipashi ukuti imutungulule. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.13",
            "verseOrgIds": [
              "1CH.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afililwe ukwipusha Yawe, kanshi Yawe nao epakumwipaya. Elyo asesesha no bufumu kuli Davidi mwana Yese.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.14",
            "verseOrgIds": [
              "1CH.10.14"
            ]
          }
        }
      ]
    }
  ],
