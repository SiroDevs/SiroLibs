              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyi eyali imipaka ya bana bakwa Aroni.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.1",
            "verseOrgIds": [
              "1CH.24.1"
            ]
          }
        }
