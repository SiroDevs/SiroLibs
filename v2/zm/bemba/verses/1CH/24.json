            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.30",
            "verseOrgIds": [
              "1CH.24.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 24:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba nabo bene bacitile ukupendula, filya fine bamunyinabo aba mu lupwa lwakwa Aroni bacitile pa cinso ca mfumu Davidi na Sadoki, Aimeleki elyo ne ntungulushi sha mayanda ya bashimapepo na bena Levi. Abana baume ba mukalamba bacitile cimo cine na bana bakwa munyina, umwaice wakwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.31",
            "verseOrgIds": [
              "1CH.24.31"
            ]
          }
        }
      ]
    }
