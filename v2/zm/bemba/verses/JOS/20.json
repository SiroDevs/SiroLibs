        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.6",
            "verseOrgIds": [
              "JOS.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi epakusonta umusumba wa Kedeshi mu Galile mu calo ca mpili cakwa Naftali, Shekemu mu calo ca mpili cakwa Efulemu, na Kiriati Ariba emukutila Hebuloni mu calo ca mpili cakwa Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.7",
            "verseOrgIds": [
              "JOS.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lubali lwa ku kabanga ka mumana wa Yordani apalungatana na Yeriko basonteleko umusumba wa Besa uwaba mu matololo mu calo cabatama uwa mu luko lwakwa Rubeni, Ramoti mu Gileadi mu luko lwakwa Gadi, na Golani mu Bashani mu luko lwakwa Manase. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.8",
            "verseOrgIds": [
              "JOS.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi umuntu onse umwina Israeli nangufye umwinafyalo uo baleikala pamo nabo, uwaipaya umuntu mukukanaishiba, afwile afulumukila kuli iyi ine misumba yasontwa pakuti bemwipaya ku bantu abalefwaya ukulandula pa muntu wabo uo aipeye, kabili akwate ne nshita yakwiminina kukupingulwa ne cintubwingi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.9",
            "verseOrgIds": [
              "JOS.20.9"
            ]
          }
        }
      ]
    }
