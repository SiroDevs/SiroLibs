                  "text": "19:1-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Eba abena Israeli ukuti basale imisumba yakufisamamo pamo ngefyo namukonkomeshe ukupitila muli Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.2",
            "verseOrgIds": [
              "JOS.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emukutila umuntu onse uwaipaya umuntu munankwe mukukanaishiba nangu mukupumbilafye, eko ali nokufulumukila kukupusuka ku bantu abalefwaya icilandushi ca mulopa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.3",
            "verseOrgIds": [
              "JOS.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo uyu muntu afulumukila kuli umo uwa muli iyi misumba, alingile aya iminina pa mpongolo ya musumba no kutuula umulandu onse kuli bacilolo ba musumba. Elyo lyena bali nokumusuminisha ukwingila mu musumba wabo no kumupeela icifulo apo ali nokulaikala nabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.4",
            "verseOrgIds": [
              "JOS.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo uwacilandushi ca mulopa nga amusupila nalyo line bacilolo tabafwile kumulekelamo, pantu aipeye umwina mupalamano wakwe mukukanaishiba, kabili tapali lupato pakati kabo iyoo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.5",
            "verseOrgIds": [
              "JOS.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyu muntu ali nokwikala mu musumba mpaka ilyo icintubwingi cikamupingula. Nga cakuti asangwa uwakaele, afwile ukwikalafye muli ulya musumba mpaka ukufika ku mfwa yakwa shimapepo mukalamba uukabapo pali ilya nshita. Panuma lyena uyu muntu uwaipaya umunankwe ali nokubwelelamo ku musumba wa kumwabo, uko afulumwike.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.6",
            "verseOrgIds": [
              "JOS.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
