              "JOS.11.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.6.4"
              },
              "items": [
                {
                  "text": "Icite 6:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.13.33"
              },
              "items": [
                {
                  "text": "Imp 13:33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.9.2"
              },
              "items": [
                {
                  "text": "Amaf 9:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kabili mu nshita ilya ine, Yoshua aile no kulofya abena Anakimu abaleikala mu calo ca mpili na ba mu Hebuloni, na ba mu Debi na mu Anabu, na bonse aba mu calo ca mpili conse ica bena Yuda, kabili no kufuma ku calo conse ica mpili sha bena Israeli. Yoshua apeele bonsefye kukonaulwa abantu pamo pene ne misumba yabo yonse. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.21",
            "verseOrgIds": [
              "JOS.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Takwali umwina Anakimu uwasheleko mu calo ca bena Israeli, kanofye mu Gasa na mu Gati elyo na mu Ashidodi emwashelefye bamo bamo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.22",
            "verseOrgIds": [
              "JOS.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi Yoshua epakupoka icalo conse, ukulingana nefyo Yawe aebele Mose ukucita. Elyo acipeela ku bena Israeli ukuba icuma cabo umwabela impuka shabo cila luko. Awe ne calo conse catuushishe ku bulwi, caikalafye tondolo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.23",
            "verseOrgIds": [
              "JOS.11.23"
            ]
          }
        }
      ]
    }
