        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.11",
            "verseOrgIds": [
              "JOS.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
