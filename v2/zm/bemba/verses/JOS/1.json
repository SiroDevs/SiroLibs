                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.22.1+JOS.22.2+JOS.22.3+JOS.22.4+JOS.22.5+JOS.22.6"
              },
              "items": [
                {
                  "text": "Yosh 22:1-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lelo ku bena Rubeni na bena Gadi kabili na citika wa luko lwa bena Manase, Yoshua atile, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.12",
            "verseOrgIds": [
              "JOS.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ibukisheni amashiwi ayo Mose umubomfi wakwa Yawe amukonkomeshe ayakuti, ‘Yawe Lesa wenu, nimwe akapeela iyi mpanga no kutuusha emo mukalatuusha.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.13",
            "verseOrgIds": [
              "JOS.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakashi benu, abana benu ne fitekwa fyonse fili nokushala mu mpanga iyo Mose apeele kuli imwe iya ku kapinda ka ku kuso ka mumana wa Yordani. Lelo kuli imwe bonse mwe babulwi abaume, mwe baipangasha ifyanso fyakulwilako, nimwe mufwile ukubalilapo ukwabuka umumana, ilyo bamunyinenwe tabalati babuke. Nimwe mufwile ukubafwilishako, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.14",
            "verseOrgIds": [
              "JOS.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpakafye nabo bene Yawe akabapeele ukutuusha, ngefyo acita kuli imwe. Nabo bene bakapoke icalo ico Yawe Lesa wenu ali nokubapeela. Elyo panuma ya ifyo, muli nokubwelelamo no kuya ikala mu calo cenu, ico Mose umubomfi wakwa Yawe amupeele lwa ku kabanga ka mumana wa Yordani, ukufumina akasuba.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.15",
            "verseOrgIds": [
              "JOS.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.15",
            "verseOrgIds": [
              "JOS.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo bayasuka Yoshua abati, “Conse ico watukonkomesha ukucita, twakulacita, kabili konse uko watutuma ukuya twakulaya. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.16",
            "verseOrgIds": [
              "JOS.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twakulakubeela pamo ngefyo twalebeela Mose. Cikulufye, Yawe Lesa obe aleba na iwe nga filya fine aleba na Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.17",
            "verseOrgIds": [
              "JOS.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili umuntu onse uwatalamina amashiwi yobe elyo nokukanabeela ifyo wakonkomesha, ali nokwipaiwa. Iwe, kosafye kabili ushipe!”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.18",
            "verseOrgIds": [
              "JOS.1.18"
            ]
          }
        }
      ]
    }
