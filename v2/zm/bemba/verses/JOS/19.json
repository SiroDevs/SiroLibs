        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.50",
            "verseOrgIds": [
              "JOS.19.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JOS 19:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi ifi e fyalo ifyo Eleasa shimapepo, Yoshua mwana Nuni ne ntungulushi sha ndupwa sha nko sha bena Israeli bayakenye ifitungu mu Shilo, panuma yakupendula pa cinso cakwa Yawe pa mwinshi we Tenti lyakukumaninamo. Kabili apa pene epapwilile ukwakanya icalo ici.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.51",
            "verseOrgIds": [
              "JOS.19.51"
            ]
          }
        }
