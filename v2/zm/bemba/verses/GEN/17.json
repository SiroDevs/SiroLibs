  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "GEN 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo Abramu afikile pa myaka amakumi pabula na pabula (99), Yawe alimumonekele, amweba ati, “Nine Lesa Umwine wa maka yonse.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.1",
            "verseOrgIds": [
              "GEN.17.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "17:1",
              "type": "text"
            },
            {
              "text": "Lesa Umwine wa maka yonse:",
              "type": "text"
            },
            {
              "text": "Mu Cihibulu mwaba ukutila, “El Shaddai.”",
              "type": "text"
            }
          ]
        },
        {
          "text": " Uleenda pa cinso candi nokuba uwabula icilubo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.1",
            "verseOrgIds": [
              "GEN.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkafikilisha icipangano candi pakati ka iwe na ine, kabili nkafusha ubufyashi bobe nganshi.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.2",
            "verseOrgIds": [
              "GEN.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abramu awa ubukupeme, elyo Lesa asosa ati, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.3",
            "verseOrgIds": [
              "GEN.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kanshi ici e cipangano candi na iwe, icakuti ukaba icikolwe ca mishobo iyingi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.4",
            "verseOrgIds": [
              "GEN.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.4.17"
              },
              "items": [
                {
                  "text": "Roma 4:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nomba tawakulaitwa Abramu,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.5",
            "verseOrgIds": [
              "GEN.17.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "17:5",
              "type": "text"
            },
            {
              "text": "Abramu:",
              "type": "text"
            },
            {
              "text": "Ishina ili lyalola mukutila “wishi uwalumbuka.”",
              "type": "text"
            }
          ]
        },
        {
          "text": " ishina lyobe nomba niwe Abrahamu",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.5",
            "verseOrgIds": [
              "GEN.17.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "17:5",
              "type": "text"
            },
            {
              "text": "Abrahamu:",
              "type": "text"
            },
            {
              "text": "Ishina ili lyalola mukutila “wishi wa mishobo iyingi”.",
              "type": "text"
            }
          ]
        },
        {
          "text": " pantu ninkucita icikolwe ca mishobo iyingi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.5",
            "verseOrgIds": [
              "GEN.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkakupeelesha ubufyashi. Kuli iwe kukafuma imishobo iyingi, kabili kuli iwe kukafuma na bashamfumu.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.6",
            "verseOrgIds": [
              "GEN.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.6",
            "verseOrgIds": [
              "GEN.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.7",
            "verseOrgIds": [
              "GEN.17.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.55"
              },
              "items": [
                {
                  "text": "Luka 1:55",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Icipangano nkapangana nobe na ba mu lupwa lobe abakakonkapo umukonkanina inkulo, cikaba cakubelelela. Nkaba Lesa obe kabili nkalaba Lesa wa ba mu lupwa lobe abakakonkapo pali iwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.7",
            "verseOrgIds": [
              "GEN.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.5"
              },
              "items": [
                {
                  "text": "Imili 7:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Icalo conse ica Kenani umo ucili umweni, nkacipeela kuli iwe na ku ba mu lupwa lobe abali nokukukonkapo, cikabe cenu pe. Elyo na ine nkaba Lesa wabo.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.8",
            "verseOrgIds": [
              "GEN.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.8",
            "verseOrgIds": [
              "GEN.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili Lesa aebele Abrahamu ati, “Elyo na imwe, mufwile ukusunga icipangano candi, iwe na ba mu lupwa lobe abakakonkapo umukonkanina inkulo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.9",
            "verseOrgIds": [
              "GEN.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.8"
              },
              "items": [
                {
                  "text": "Imili 7:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.4.11"
              },
              "items": [
                {
                  "text": "Roma 4:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ici e cipangano candi na iwe na ba mu lupwa lobe abakakonkapo. Icipangano mwakulasunga nici, umwaume onse uo muleikala nankwe ali nokusembululwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.10",
            "verseOrgIds": [
              "GEN.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukalesembulula inkanda ya ku mpela ya bwaume, ici cikaba e cishibilo ca cipangano pakati ka ine na imwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.11",
            "verseOrgIds": [
              "GEN.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi umukakonkanina inkulo shenu, umwaume onse uwikala pakati kenu, nga aba ne inshiku cine konse konse (8) apo afyalilwa, ali nokusembululwa. Cibe umwana obe umwaume nangu umubomfi onse umwaume uwafyalilwa mu ŋanda yobe nangu uwakuti wamushitafye ku benafyalo, te wa mu lupwa lobe, bonse bali nokusembululwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.12",
            "verseOrgIds": [
              "GEN.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umubomfi umwaume uwafyalwa mu ŋanda yobe nangu wakushitafye ne ndalama shobe, bonse bafwile ukusembululwa. Icipangano candi ku mibili yenu cili nokuba icipangano ca pe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.13",
            "verseOrgIds": [
              "GEN.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwaume onse uushasembululwa, uo bashasembulula inkanda ya ku mpela ya bwaume, wakutamfyafye afume ku bantu bandi. Pantu naonaula icipangano candi.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.14",
            "verseOrgIds": [
              "GEN.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.14",
            "verseOrgIds": [
              "GEN.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili Lesa aebele Abrahamu ati, “Palwakwa Sarai umukashi obe, nomba tawakulamwita Sarai,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.15",
            "verseOrgIds": [
              "GEN.17.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "17:15",
              "type": "text"
            },
            {
              "text": "Sarai:",
              "type": "text"
            },
            {
              "text": "Ishina ili lyalola mukutila, “Namfumu wandi, umwina mwandi.”",
              "type": "text"
            }
          ]
        },
        {
          "text": " ishina lyakwe lili nokuba ni Sara. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.15",
            "verseOrgIds": [
              "GEN.17.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "17:15",
              "type": "text"
            },
            {
              "text": "Sara:",
              "type": "text"
            },
            {
              "text": "Ishina ili lyalola mukutila, “Namfumu”.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.15",
            "verseOrgIds": [
              "GEN.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine nkapaala Sara, kabili nkalenga Sara akakufyalile umwana umwaume. Ine nkamupaala pakuti akabe nyina wa mishobo. Bashamfumu ba bantu bakafuma muli ena.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.16",
            "verseOrgIds": [
              "GEN.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abrahamu awa ubukupeme, alaseka, ayipusha ati, “Bushe umuntu kuti afyala umwana ilyo ali ne myaka umwanda umo (100)? Bushe Sara akafyala umwana ilyo ali ne myaka amakumi pabula (90)?” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.17",
            "verseOrgIds": [
              "GEN.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi Abrahamu epakweba Lesa ati, “Shi mwingalekafye Ishimaeli",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.18",
            "verseOrgIds": [
              "GEN.17.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "17:18",
              "type": "text"
            },
            {
              "text": "Ishimaeli:",
              "type": "text"
            },
            {
              "text": "E mwana Abrahamu afyele muli Haga umusha wakwa Sara 16:1-6.",
              "type": "text"
            }
          ]
        },
        {
          "text": " aleba uwapaalwa pa cinso cenu!” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.18",
            "verseOrgIds": [
              "GEN.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo Lesa amweba ati, “Awe iyoo, umukashi obe Sara akakufyalila umwana umwaume na iwe ukamwinika ishina lya Isaki.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.19",
            "verseOrgIds": [
              "GEN.17.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "17:19",
              "type": "text"
            },
            {
              "text": "Isaki:",
              "type": "text"
            },
            {
              "text": "Ili shina lyalola mukutila, “Ukuseka,” 17:17; 18:12.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kabili nkapangana nankwe icipangano icakubelelela na ba mu lupwa lwakwe abakamukonkapo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.19",
            "verseOrgIds": [
              "GEN.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niŋumfwa nefyo walanda pali Ishimaeli. Cine cine nkamupaala. Kabili nkamupeelesha ubufyashi, na ba mu lupwa lwakwe bakafula nganshi. Akaba wishi wa bakateeka ikumi limo na babili (12). Nkalenga no lupwa lwakwe ukuba umushobo uukalamba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.20",
            "verseOrgIds": [
              "GEN.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo nkapangana icipangano candi na Isaki uo Sara akakufyalila uyu mwaka uleisa pa nshita ino ine.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.21",
            "verseOrgIds": [
              "GEN.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo Lesa apwa ukulanda na Abrahamu, afumapo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.22",
            "verseOrgIds": [
              "GEN.17.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.22",
            "verseOrgIds": [
              "GEN.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pali bulya bwine bushiku, Abrahamu abuulile umwana wakwe Ishimaeli, umwaume onse uwa mu ŋanda yakwe, abasha bafyalilwe mumwakwe nangu abo ashitile ne ndalama, abasembulula inkanda ya ku mpela ya bwaume, ngefyo Lesa amwebele. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.23",
            "verseOrgIds": [
              "GEN.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abrahamu asembulwilwe ilyo ali ne myaka amakumi pabula na pabula (99). ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.24",
            "verseOrgIds": [
              "GEN.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo mwane Ishimaeli ena asembulwilwe ilyo ali ne myaka ikumi limo na itatu (13). ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.25",
            "verseOrgIds": [
              "GEN.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abrahamu no mwana wakwe Ishimaeli bonse babili basembulwilwefye ubushiku bumo bwine. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.26",
            "verseOrgIds": [
              "GEN.17.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaume bonse aba mu ŋanda yakwa Abrahamu, abasha abafyalilwe mumwakwe nabo bonse abo ashitile ku beni, basembulwilwe ubushiku bumo pamo na Abrahamu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.27",
            "verseOrgIds": [
              "GEN.17.27"
            ]
          }
        }
      ]
