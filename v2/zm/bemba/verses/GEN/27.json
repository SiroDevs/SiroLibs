        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.45",
            "verseOrgIds": [
              "GEN.27.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "GEN 27:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili Rebeka aebele Isaki ati, “Ine nintendwa ukuba umumi pa mulandu wa aba banakashi abena Hiti.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.46",
            "verseOrgIds": [
              "GEN.27.46"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "27:46",
              "type": "text"
            },
            {
              "text": "Banakashi abena Hiti:",
              "type": "text"
            },
            {
              "text": "Banakashi abo Esau aupile.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nga cakuti Yakobo nao aupa umwanakashi umo pa banakashi ba muli cino calo pali aba abena Hiti, ine ninshi no kufwa kwawama.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.46",
            "verseOrgIds": [
              "GEN.27.46"
            ]
          }
        }
      ]
