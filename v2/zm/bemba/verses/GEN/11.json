              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo Afakisadi ali ne myaka amakumi yatatu na isano (35), afyele Shela. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.12",
            "verseOrgIds": [
              "GEN.11.12"
            ]
