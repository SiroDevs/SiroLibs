          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubu e butantiko bwa lupwa lwakwa Shemu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.10",
            "verseOrgIds": [
              "GEN.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imyaka ibili panuma ye lyeshi, ilyo Shemu ali ne myaka yakufyalwa umwanda umo (100), afyele umwana umwaume ishina lyakwe ni Afakisadi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.10",
            "verseOrgIds": [
              "GEN.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili panuma yakufyala Afakisadi, Shemu aikele imyaka imyanda isano (500), alifyele abana na bambi abaume na banakashi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.11",
            "verseOrgIds": [
              "GEN.11.11"
            ]
          }
        }
      ]
    },
    {
