        {
          "text": "Tera ali ne myaka imyanda ibili na isano (205) ilyo afwilile mu musumba wa Harani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.32",
            "verseOrgIds": [
              "GEN.11.32"
