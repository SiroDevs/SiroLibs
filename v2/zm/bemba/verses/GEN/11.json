            "verseOrgIds": [
              "GEN.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tera abuulile umwana wakwe Abramu, umwishikukulu wakwe Loti mwana Harani na nafyala Sarai, muka Abramu umwana wakwe, elyo bonse pamo bafumine mu musumba wa Uri mu calo ca Kaludea baile na ku calo ca Kenani. Nomba ilyo bafikile ku musumba wa Harani uko eko bacitile icifulo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.31",
            "verseOrgIds": [
              "GEN.11.31"
            ]
          }
        }
      ]
    },
