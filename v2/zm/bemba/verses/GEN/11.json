              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo Naho ali ne myaka amakumi yabili na pabula (29), afyele Tera. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.24",
            "verseOrgIds": [
              "GEN.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili panuma yakufyala Tera, Naho aikele imyaka umwanda umo ikumi limo na pabula (119), alifyele abana na bambi abaume na banakashi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.25",
            "verseOrgIds": [
