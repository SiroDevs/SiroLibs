              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.28",
            "verseOrgIds": [
              "GEN.49.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 49:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Yakobo akonkomeshe bamwane ati, “Ine nomba nalaya ukwaba ifikolwe fyandi. Mukanshiike ukwalala ifikolwe fyandi mu lucengo ulwaba mwibala lyakwa Efuloni umwina Hiti. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.29",
            "verseOrgIds": [
              "GEN.49.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 49:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.23.3+GEN.23.4+GEN.23.5+GEN.23.6+GEN.23.7+GEN.23.8+GEN.23.9+GEN.23.10+GEN.23.11+GEN.23.12+GEN.23.13+GEN.23.14+GEN.23.15+GEN.23.16+GEN.23.17+GEN.23.18+GEN.23.19+GEN.23.20"
              },
              "items": [
                {
                  "text": "Icite 23:3-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ulu lucengo lwaba mwibala lya Makipela mupepi na ku Mamure, mu calo ca Kenani. Abrahamu ashitile ulu lucengo pamo ne bala line kuli Efuloni umwina Hiti, pakuti akwate incende ya nshinshi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.30",
            "verseOrgIds": [
              "GEN.49.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 49:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.25.9+GEN.25.10"
              },
              "items": [
                {
                  "text": "Icite 25:9-10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.35.29"
              },
              "items": [
                {
                  "text": "35:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eko bashiika Abrahamu no mukashi wakwe Sara, kabili ekwashiikwa Isaki no mukashi wakwe Rebeka. Elyo na ine kulya kwine eko nashiika Leya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.31",
            "verseOrgIds": [
              "GEN.49.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 49:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibala no lucengo lwabamo fyashitilwe ku bena Hiti.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.32",
            "verseOrgIds": [
              "GEN.49.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 49:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.15"
              },
              "items": [
                {
                  "text": "Imili 7:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Cilya Yakobo apwa ukukonkomesha bamwane, abwesesha amakasa yakwe pa busanshi, aleka no mweo, aya ukwalala ifikolwe fyakwe.",
          "type": "text",
