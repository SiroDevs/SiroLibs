        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.27",
            "verseOrgIds": [
              "GEN.49.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 49:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi aba bonse e fikolwe fya nko ikumi limo na shibili (12) isha bena Israeli. Kabili aya e mashiwi shibo Yakobo abebele ilyo alebapaala. Cila muntu apaalilwe ne paalo ilyamulingile.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.28",
            "verseOrgIds": [
              "GEN.49.28"
            ]
          }
        }
      ]
    },
    {
