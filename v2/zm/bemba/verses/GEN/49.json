            }
          ]
        },
        {
          "text": "Elyo Yakobo aitile bamwane abaume, abeba ati, “Palameni kuno pakuti mwebeko ifili nokumufikila mu nshiku ishileisa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.1",
            "verseOrgIds": [
