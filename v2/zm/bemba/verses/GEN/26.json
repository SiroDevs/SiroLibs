          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo Esau afikile pa myaka amakumi yane (40), aupile Yuditi mwana Beri umwina Hiti, elyo na Basemati mwana Eloni, nao umwina Hiti. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.34",
            "verseOrgIds": [
              "GEN.26.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
