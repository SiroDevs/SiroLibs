          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba banakashi baleleta isakamika kuli Isaki na Rebeka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.35",
            "verseOrgIds": [
              "GEN.26.35"
            ]
          }
