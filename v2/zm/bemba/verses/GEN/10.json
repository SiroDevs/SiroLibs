              "type": "text"
            }
          ]
        },
        {
          "text": "Ofiri, Hafila na Yobabu. Aba bonse bana abaume abakwa Yokitani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.29",
            "verseOrgIds": [
