          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba e bana baume bakwa Shemu mu mikowa na mu ndimi shabo, mu mipaka na mu mishobo yabo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.31",
