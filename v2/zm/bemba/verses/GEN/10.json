  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "GEN 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubu e butantiko bwa ndupwa sha bana baume bakwa Noa: Shemu, Hamu na Yafeti. Panuma ya lyeshi bamwana Noa nabo balifyele abana abaume.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.1",
            "verseOrgIds": [
              "GEN.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.1",
            "verseOrgIds": [
              "GEN.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamwana Yafeti abaume ni Gomeri, Magogi, Madai, Yafani, Tubali, Mesheki na Tirasi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.2",
            "verseOrgIds": [
              "GEN.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamwana Gomeri abaume ni Ashikenasi, Rifati na Togama. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.3",
            "verseOrgIds": [
              "GEN.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamwana Yafani abaume ni Elisha, Tashishi, abena Kitimu na bena Rodanimu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.4",
            "verseOrgIds": [
              "GEN.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukufuma muli aba bantu emwatuntunka abasalanganina mu lulamba lwa bemba mu mipaka yabo, mu mikowa yabo na mu mishobo yabo, bonse umwabela indimi shabo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.5",
            "verseOrgIds": [
              "GEN.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.5",
            "verseOrgIds": [
              "GEN.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamwana Hamu abaume ni Kushi, Misraimu, Puti na Kenani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.6",
            "verseOrgIds": [
              "GEN.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamwana Kushi abaume ni Seba, Hafila, Sabuta, Rama na Sabuteka. Bamwana Rama abaume ni Sheba na Dedani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.7",
            "verseOrgIds": [
              "GEN.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kushi ali e wishi wakwa Nimurodi. Nimurodi ewabalilepo ukuba icita icamaka pano isonde. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.8",
            "verseOrgIds": [
              "GEN.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimurodi ali ni fundi uwamaka pa cinso cakwa Yawe. Kanshi ekwatula ne nsonselo yakuti, “Nga Nimurodi, fundi uwamaka pa cinso cakwa Yawe!” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.9",
            "verseOrgIds": [
              "GEN.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.11.2"
              },
              "items": [
                {
                  "text": "Icite 11:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Imisumba iyo Nimurodi abalilepo ukuteeka ni Babiloni, Ereki, Akadi na Kaline. Iyi misumba yonse ya mu calo ca Shina",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.10",
            "verseOrgIds": [
              "GEN.10.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "10:10",
              "type": "text"
            },
            {
              "text": "Shina:",
              "type": "text"
            },
            {
              "text": "E cimo cine na Babilonia.",
              "type": "text"
            }
          ]
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.10",
            "verseOrgIds": [
              "GEN.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo afumine muli ici calo ca Shina, aile ku Asiria, uko aile kuula umusumba wa Ninife, Rehoboti Iri na Kala, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.11",
            "verseOrgIds": [
              "GEN.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "elyo na Reseni, uwabela pakati ka Ninife na Kala, e musumba ukalamba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.12",
            "verseOrgIds": [
              "GEN.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.12",
            "verseOrgIds": [
              "GEN.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Misraimu e cikolwe ca bena Ludi, abena Anamu, abena Lehabu, abena Nafutu, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.13",
            "verseOrgIds": [
              "GEN.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "abena Patulusi na bena Kaselu ukwatuntuka Abafilisiti elyo na bena Kafuto.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.14",
            "verseOrgIds": [
              "GEN.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.14",
            "verseOrgIds": [
              "GEN.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenani ewali wishi wakwa Sidoni, ibeli lyakwe, kabili ewali icikolwe ca bena Hiti, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.15",
            "verseOrgIds": [
              "GEN.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "abena Yebusi, abena Amoli, abena Girigashi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.16",
            "verseOrgIds": [
              "GEN.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "abena Hifi, abena Aki, abena Sini, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.17",
            "verseOrgIds": [
              "GEN.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "abena Afadi, abena Semari na bena Hamati.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.18",
            "verseOrgIds": [
              "GEN.10.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panuma imikowa ya bena Kenani yalisa salangana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.18",
            "verseOrgIds": [
              "GEN.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili imipaka ya bena Kenani yatampile ukufuma ku Sidoni ukulola ku Gela ukufika na ku Gasa. Elyo kabili ukulola ku Sodoma, Gomora, Adima na Seboimu, ukufikafye na ku Lasha. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.19",
            "verseOrgIds": [
              "GEN.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba e bana baume bakwa Hamu mu mikowa yabo na mu ndimi shabo, mu mipaka na mu mishobo yabo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.20",
            "verseOrgIds": [
              "GEN.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.20",
            "verseOrgIds": [
              "GEN.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shemu umukalamba wakwa Yafeti nao alifyele abana abaume. Kabili Shemu e cikolwe ca bana baume bakwa Eberi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.21",
            "verseOrgIds": [
              "GEN.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana abaume abakwa Shemu ni Elamu, Ashuri, Afakisadi, Ludi na Aramu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.22",
            "verseOrgIds": [
              "GEN.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana abaume abakwa Aramu ni Usi, Huli, Geteri na Mesheki. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.23",
            "verseOrgIds": [
              "GEN.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afakisadi ewafyele Shela, elyo Shela nao afyele Eberi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.24",
            "verseOrgIds": [
              "GEN.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eberi afyele abana abaume babili. Umo ishina lyakwe ni Pelegi,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.25",
            "verseOrgIds": [
              "GEN.10.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "10:25",
              "type": "text"
            },
            {
              "text": "Pelegi:",
              "type": "text"
            },
            {
              "text": "Ili lishina lya Cihibulu, lyalola mukuti “Ukwakana”.",
              "type": "text"
            }
          ]
        },
        {
          "text": " pantu ni mu nshita yakwe emo bayakenye isonde. Munyina ali ni Yokitani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.25",
            "verseOrgIds": [
              "GEN.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yokitani afyele Alumodadi, Shelefu, Hasalimafeti, Yera, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.26",
            "verseOrgIds": [
              "GEN.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hadoramu, Usali, Dikila, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.27",
            "verseOrgIds": [
              "GEN.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obali, Abimaeli, Sheba, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.28",
            "verseOrgIds": [
              "GEN.10.28"
            ]
          }
        },
