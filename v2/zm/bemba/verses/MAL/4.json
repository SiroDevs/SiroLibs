              "MAL.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAL 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kanshi imwe muleibukishafye amafunde ya mubomfi wandi Mose, muleibukisha ifipope na mafunde ifyo ine namukonkomeshe pa lupili lwa Holebu, pakuti efyo imwe mwe bena Israeli bonse mulekonka.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.4",
            "verseOrgIds": [
              "MAL.4.4"
            ]
          }
        }
