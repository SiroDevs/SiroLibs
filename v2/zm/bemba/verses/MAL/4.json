        },
        {
          "text": "“Moneni ilyo ubo bushiku bukalamba kabili ubwakutiina ubwakwa Yawe bushilati bufike, nkatala nkatume kasesema Eliya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.5",
            "verseOrgIds": [
              "MAL.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAL 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili akesa pilibwila imitima ya bashibo ku bana babo, ne mitima ya bana kuli bashibo, epakuti ine nshishile lapisha no konaula icalo cenu.”",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.6",
