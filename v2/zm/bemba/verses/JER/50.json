                {
                  "text": "Ubuso 18:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Eico kanshi mu musumba wa Babiloni mwakulaikalafye impaka na bamumbwe ne fipululu. Tamwakatale amwikala muntunse nelyo limo, takwakabe muntu uukasangwamo nakabili. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.39",
            "verseOrgIds": [
              "JER.50.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JER 50:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.24+GEN.19.25"
              },
              "items": [
                {
                  "text": "Icite 19:24-25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nga filya fine cali ilyo ine naonawile Sodoma na Gomora kumo kwine ne mishi iyali mumbali, efyo nalacita na Babiloni wine. Tamwakatale amwikalamo umuntu, nangufye umwana wa muntu ukusangwamo. Nine ne Yawe Lesa nalanda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.40",
            "verseOrgIds": [
              "JER.50.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
