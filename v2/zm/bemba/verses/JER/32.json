                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.31"
              },
              "items": [
                {
                  "text": "Yere 7:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mu mupokapoka wa Beni Hinomu balikuulilamo Baali ifibumbili fye lambo, apakocela abana babo abaume na banakashi pakulabatuula ilambo ku mulungu Moleki. Ine nshabapeela cebo cakucita ifi iyoo, kabili tacatala acisa na mu mano yandi, icakuti ntontonkanye ukuti aba bantu kuti bacitapo icintu cabipisha ifi, no kulenga abena Yuda balebifya.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.35",
            "verseOrgIds": [
              "JER.32.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 32:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.35",
            "verseOrgIds": [
              "JER.32.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JER 32:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe, Lesa wakwa Israeli, alisosele ati, “Yeremia, iwe naweba abantu ukuti inkondo ne cipowe ne cikuko efyalalenga ukuti imfumu ya ku Babiloni ipoke uno musumba, lelo kwena umfwa kuno ifyo ine nalalanda. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.36",
            "verseOrgIds": [
              "JER.32.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JER 32:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine nkalonganya abantu, nkabafumya mu fyalo fyonse umo nabaposele cipyu cipyu kabili cikali cikali. Nkababwesesha kuno kwine, no kuleka bakaleikalila ku matwi tondolo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.37",
            "verseOrgIds": [
              "JER.32.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JER 32:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lyena bakalaba abantu abandifye, na ine nkalaba Lesa uwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.38",
            "verseOrgIds": [
              "JER.32.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JER 32:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkalenga bakalefwayafye no mutima umo icintu cimo ceka mu miikalile yabo, emukuti icakulankwatila akatiina lyonsefye, neci cintu cikalabawamina abene, cikalawamina na bana babo abakalabakonkapo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.39",
            "verseOrgIds": [
              "JER.32.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JER 32:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine nkapangana nabo icipangano ca pe icakutila, ine nshakatale ndeka ukulabacitila ifisuma. Nkalenga nokuti bakalenkwatila akatiina mu mitima yabo, epakuti nabo bekatala abansangukila nakabili. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.40",
            "verseOrgIds": [
              "JER.32.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JER 32:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine nkalasansamuka pakubabombela ifisuma, nkabika umutima wandi onse no mweo wandi onse pakubateeka muli cino calo, pakuti emo bakaleikalilila pe.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.41",
            "verseOrgIds": [
              "JER.32.41"
            ]
          }
        }
      ]
    },
    {
