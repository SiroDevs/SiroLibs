                "loc": "JER.7.30+JER.7.31"
              },
              "items": [
                {
                  "text": "Yere 7:30-31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.19.1+JER.19.2+JER.19.3+JER.19.4+JER.19.5+JER.19.6"
              },
              "items": [
                {
                  "text": "19:1-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na mu ŋanda yakumpepelamo iye shina lyandi iyo bankuulila, namo mwine balibikamo utulubi utwabunani, no kuikowesha balikowesha. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.34",
            "verseOrgIds": [
              "JER.32.34"
            ]
          }
        },
        {
