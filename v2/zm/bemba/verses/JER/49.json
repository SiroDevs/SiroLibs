              "items": [
                {
                  "text": "Mala 1:2-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Palwa bena Edomu, Yawe umwine wa fita aletila ati,",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.7",
            "verseOrgIds": [
              "JER.49.7"
            ]
          }
        }
