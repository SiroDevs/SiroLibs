              "type": "text"
            }
          ]
        },
        {
          "text": "ne shamfumu shonse isha mu calo ca Simuri, ne sha mu calo ca Elami, ne sha mu calo ca Media, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.25",
            "verseOrgIds": [
              "JER.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
