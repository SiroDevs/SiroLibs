          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne shamfumu shonse isha ku kapinda ka ku kuso, ishaba mupepi ne shaba ukutali kwine, ukulingana nomo shakonkanine. Abantu ba mishobo yonse mpanga yonse pano isonde lyonse bali nokunwamo. Na pakulekelesha iyikanwamo ni mfumu ya ku Sheshaki,",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.26",
            "verseOrgIds": [
              "JER.25.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
