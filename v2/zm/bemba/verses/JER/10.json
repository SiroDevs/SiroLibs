        },
        {
          "text": "Imwe mwe ba mu ŋanda yakwa Israeli, umfweni amashiwi ayo Yawe alemweba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.1",
            "verseOrgIds": [
