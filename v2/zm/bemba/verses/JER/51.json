              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo abeni abaikalamo nabo epakwasuka abati,",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.9",
            "verseOrgIds": [
              "JER.51.9"
