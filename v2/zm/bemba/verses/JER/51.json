            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.13",
            "verseOrgIds": [
              "JER.51.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 51:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe umwine wa fita alilapa ati, “Napalifye ine, nalapa ukuti ine nkaletela Babiloni abantu ababa nga makanta ku bwingi, nabo bakawelesha pakukucimfya.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.14",
            "verseOrgIds": [
              "JER.51.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 51:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.19",
            "verseOrgIds": [
              "JER.51.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 51:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe alanda ukuti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.20",
            "verseOrgIds": [
              "JER.51.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 51:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.23",
            "verseOrgIds": [
              "JER.51.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 51:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe aletila ati, “Mwalamonako uko ine nalalinganya Babiloni na bena Kaludea bene pa fibi fyonse ifyo bacitile mu Sioni pa menso yenu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.24",
            "verseOrgIds": [
              "JER.51.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 51:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.24",
            "verseOrgIds": [
              "JER.51.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 51:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Babiloni, iwe waba ngo lupili ulonaula icalo conse, ine nomba nakwalukila, uli mulwani wandi. Ine nkakwikatisha nkakufumya apo pamulu pa fimabwe, ndi nokukuposa panshi, nkakusangule ulupili ulwapya ku mulilo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.25",
            "verseOrgIds": [
              "JER.51.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 51:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa fitantala fyobe tapakabe uukabuulapo ilibwe lyakukuulila pa cifutu, nangu ilibwe lyakukuulila mu mufula, pantu uli nokubafye icibolya ca pe na pe. Nine ne Yawe Lesa nalanda.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.26",
            "verseOrgIds": [
              "JER.51.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 51:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.35",
            "verseOrgIds": [
              "JER.51.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JER 51:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi Yawe asosa ati,",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.36",
            "verseOrgIds": [
              "JER.51.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "JER 51:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.58",
            "verseOrgIds": [
              "JER.51.58"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "JER 51:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya e mashiwi Yeremia kasesema akonkomeshe Seraya mwana Neriya, mwishikulu Maseya, ilyo baile ku Babiloni na Sedekia imfumu ya calo ca Yuda, mu mwaka walengele ine ukufuma apo Sedekia atampile ukulateeka icalo ca Yuda. Seraya ali ni mushika wa pa bulendo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.59",
            "verseOrgIds": [
              "JER.51.59"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "60",
            "style": "v",
            "sid": "JER 51:60"
          },
          "items": [
            {
              "text": "60",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeremia alilembele mu katabo kamo ifinkunka fonse ifili nokuponena Babiloni, alilembelemo ne milandu imbi yonse palwa Babiloni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.60",
            "verseOrgIds": [
              "JER.51.60"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "61",
            "style": "v",
            "sid": "JER 51:61"
          },
          "items": [
            {
              "text": "61",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alyebele Seraya ati, “Nga wafika ku Babiloni, iwe ukaposeko amano kuli aya mashiwi yonse ayalembelwe, kabili ukaye mukulaikatisha pakubelengela abantu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.61",
            "verseOrgIds": [
              "JER.51.61"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "62",
            "style": "v",
            "sid": "JER 51:62"
          },
          "items": [
            {
              "text": "62",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo kabili ukakonkanyepo no kupepa auti, ‘We Yawe, niwe wasosele ukuti uli nokonaula ino ncende, pakuti mwikalaikalafye nelyo cimo icipema, nangufye abantu atemwa inama, nokuti ino ncende ikasanguka amatololo ya pe.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.62",
            "verseOrgIds": [
              "JER.51.62"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "63",
            "style": "v",
            "sid": "JER 51:63"
          },
          "items": [
            {
              "text": "63",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.18.21"
              },
              "items": [
                {
                  "text": "Ubuso 18:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Seraya, iwe nga wapwa ukubelengela abantu amashiwi yonse ayali muli aka katabo, elyo ukabuule akatabo kene, ukakakakile ku libwe limo, ukakapose na pa mumana wa Yufurate, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.63",
            "verseOrgIds": [
              "JER.51.63"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "64",
            "style": "v",
            "sid": "JER 51:64"
          },
          "items": [
            {
              "text": "64",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukatile nokuti, ‘Efyo cikaba na kuli Babiloni. Akaloba, takabukuluke na limbi nakalya, pa mulandu wa finkunka ifyo Yawe alamuletela.’”",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.64",
            "verseOrgIds": [
              "JER.51.64"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "64",
            "style": "v",
            "sid": "JER 51:64"
          },
          "items": [
            {
              "text": "64",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pano pene epapela amashiwi yakwa Yeremia.",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.64",
            "verseOrgIds": [
              "JER.51.64"
            ]
          }
        }
      ]
    }
  ],
