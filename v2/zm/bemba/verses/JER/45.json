                  "text": "2 Imila 36:5-7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.1.1+DAN.1.2"
              },
              "items": [
                {
                  "text": "Dan 1:1-2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ni mu mwaka walengele ine, apo Yehoyakimu mwana Yosia atampile ukulateeka icalo ca Yuda, emo Baruki mwana Neriya alembele mu katabo kamo amashiwi yonse ayo Yeremia alemweba ukulemba. Elyo kasesema Yeremia aebele Baruki ati, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.1",
            "verseOrgIds": [
              "JER.45.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 45:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ifi efyasosa Yawe Lesa wakwa Israeli kuli iwe we Baruki. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.2",
            "verseOrgIds": [
              "JER.45.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 45:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe uletila auti, ‘Awe ine nomba naleka. Pantu Yawe nanundilapo amacushi na yambi. Ine ni mfwafye kukuteta, ndefilwa no kumona apakupemwinako.’”",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.3",
            "verseOrgIds": [
              "JER.45.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 45:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.3",
            "verseOrgIds": [
              "JER.45.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 45:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi Yawe nao epakweba Yeremia ukuti, “Eba Baruki ukutila, ‘Ine ne Yawe ndebongolola ifyo nakuulile, ndenukaula nefyo nalimbile. Ee, efyo nalacita icalofye conse. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.4",
            "verseOrgIds": [
              "JER.45.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 45:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo iwe Baruki, bushe ulefwaya ukuti ine nkucitilepo fimo ifikulu? Ala wilafwaya ifyo iyoo. Ine nalaletela abantunse bonse ifinkunka, nomba iwe tawakafwe ukaba nge citapwa ca mu nkondo konsefye uko wakulaya. Nine ne Yawe nalanda.’”",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.5",
            "verseOrgIds": [
              "JER.45.5"
            ]
          }
        }
      ]
    }
