          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi kwali umuntu umo uwa mu luko lwa bena Levi, ishina lyakwe ni Yosefu. Afyalilwe mu cishi ca Saiprasi. Abasole bena balemwita Banaba emukutila, “Umuntu wacikoseleshi.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.36",
            "verseOrgIds": [
              "ACT.4.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyu muntu alikwete ibala, elyo ashitisha. Indalama amwenemo, ashileta ku basole.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.37",
            "verseOrgIds": [
              "ACT.4.37"
            ]
          }
        }
      ]
