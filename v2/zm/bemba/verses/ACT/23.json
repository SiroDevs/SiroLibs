            "sid": "ACT 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cilya umulashi apwa ukubelenga kalata, aipusha Paulo ati, “Ni ku calo nshi wafuma?” Elyo aumfwa ukuti ni ku Kilikia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.34",
            "verseOrgIds": [
              "ACT.23.34"
            ]
          }
        },
        {
          "name": "verse",
