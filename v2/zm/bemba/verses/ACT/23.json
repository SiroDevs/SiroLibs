              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cilya fyafika ku Kesalia, ifita fyapeela kalata ku mulashi, fyamutwalila na Paulo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.33",
            "verseOrgIds": [
              "ACT.23.33"
            ]
          }
        },
        {
          "name": "verse",
