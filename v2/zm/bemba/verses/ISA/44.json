            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.8",
            "verseOrgIds": [
              "ISA.44.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 44:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bonse abapanga utulubi, fipuba fyabantu, no tulubi twine uto aba bantu bacankilwa nganshi nato twine tunangwafye. Abantu abapepa iyi milungu, awe balikutwa, kabili fipubafye, no kusebana bakasebaninapo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.9",
            "verseOrgIds": [
              "ISA.44.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 44:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu ukwenga icimpashanya ca cela elyo no kulacipepa kwati ni lesa, cine cine mulimo uwakuicushafye. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.10",
            "verseOrgIds": [
              "ISA.44.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 44:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na bantu bonse abacipepa, ninshi nabo bene bakasebana. Abenga no kupanga utulubi, ala bantufye, no kupela epo bapelela. Nabalongane bonse bese ku cilye, uleke bese bekatwe umwenso no kusebana basebane.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.11",
            "verseOrgIds": [
              "ISA.44.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 44:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.11",
            "verseOrgIds": [
              "ISA.44.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 44:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kafula wa fyela ewakubuula icela cimo, eco alafulila pa mulilo wa malasha. Elyo aikatisha inondo mu minwe alauma ne cela, apangamo akalubi mu musango uo alefwaya kabelemo. Yasuka ne nsala yamwikata, alaumfwa ne cilaka, no kunaka ninshi e minakile, pantu amaka yamupwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.12",
            "verseOrgIds": [
              "ISA.44.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 44:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.12",
            "verseOrgIds": [
              "ISA.44.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 44:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pambi kabasa wa mbao nao ewakubuula icimuti ica mikedari cimo, acipima ubutali, alengapo ne cimpashanya, nomo cili nokupelela, elyo abuula ne fibombelo, alacibasa, ilyo ninshi alekonkafye umo ali ashilile. Asuka acibasa, naco cabafye ngo muntu, no kulamonekafye icisuma ngo muntu, pakuti cibe icalinga mu ŋanda iyakucipepelamo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.13",
            "verseOrgIds": [
              "ISA.44.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 44:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.13",
            "verseOrgIds": [
              "ISA.44.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 44:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pambi Kabasa wa mbao kuti aya fwaya ifimuti ifyalepesha ifya keda, efyo aisa bomfya, pambi kuti asala icimuti ca oki, pambi icamwengele umo uwaba mu mutengo. Limbi kuti kabasa wine ewailimbila umwine umuti walepesha, wasuka nao wakula ilyo ulelokelelwa ne mfula. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.14",
            "verseOrgIds": [
              "ISA.44.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 44:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku cimuti cimo cine, umuntu umo kuti aputulako icakukosesha umulilo, elyo kabili abuula icisheleko, abasamo na kalubi kamo. Kuti aputulako icakukosesha umulilo uwakonta, no wakufumbikamo umukate, elyo kabili abuula icisheleko, apangamo umulungu umo, no kupepa eo alapepa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.15",
            "verseOrgIds": [
              "ISA.44.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 44:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi ku cimuti cimo cine kuti aputulako icakukosesha umulilo, aocelapo ne nama, alya, no kutemwa atemwa. Ilyo aleonta umulilo, aletifye, “We mulilo nobe ubusuma. Eeya, awe nomba nakangabuka.” ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.16",
            "verseOrgIds": [
              "ISA.44.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 44:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo kabili batini abuula icisheleko, apangamo na kalubi kamo. Eko alafukankilako pakukapepa. Alakapapata ati, “Ulempusushako, pantu iwe niwe mulungu wandi.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.17",
            "verseOrgIds": [
              "ISA.44.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 44:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.17",
            "verseOrgIds": [
              "ISA.44.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 44:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwena aba bantu, iyoo ni mpelwamano, tabaishiba ifyo bacita. Balikutwa, tabamona kantu, ne mitima yabo yalifumbatwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.18",
            "verseOrgIds": [
              "ISA.44.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 44:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu abapanga utulubi tabatontonkanya nelyo panono nakalya, tabakwata mano ayakumona ukuti, “Icimuti ico ine mputwileko nakoseshako umulilo, na pa mulilo waciko ine nimfumbikapo umukate, ningocapo ne nama, no kulya nindya. Elyo kabili icisheleko, bushe kuti eco ine napangamo icilubi icabunani, icakuti ine ndefukankilako, no kulacipepa, nacofye icimuti?” ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.19",
            "verseOrgIds": [
              "ISA.44.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 44:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cimo cinefye no kulya imito. Amano yabo ayabupuba yabaloshafye kumbi kumbi. Tabeluka nakalya icakuti batile, “Ici cintu njikete mu minwe, bushe tecabufifye.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.20",
            "verseOrgIds": [
              "ISA.44.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 44:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.20",
            "verseOrgIds": [
              "ISA.44.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 44:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe aletila ati,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.21",
            "verseOrgIds": [
              "ISA.44.21"
            ]
          }
        }
      ]
    }
