        },
        {
          "text": "Efyo Yawe asobele kale palwa calo ca Moabu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.13",
            "verseOrgIds": [
              "ISA.16.13"
            ]
          }
