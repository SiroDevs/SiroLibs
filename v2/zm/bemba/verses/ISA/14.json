              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu bushiku bulya Yawe akalenga imwe mwe bena Israeli mukaleipemena no kutuusha kukulunguluka no kubomba imilimo iyakosa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.3",
            "verseOrgIds": [
              "ISA.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo cikaba ifyo, elyo na imwe mukalatumfya imfumu ya Babiloni amuti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.4",
            "verseOrgIds": [
              "ISA.14.4"
            ]
          }
        }
