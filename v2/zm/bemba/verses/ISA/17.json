        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubo bushiku nga bwafika, elyo abantu bakapilibukila kuli Kabumba wabo, Lesa Wamushilo uwakwa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.7",
            "verseOrgIds": [
              "ISA.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninshi nomba capwa baleka ukulasakamana ifibumbili fya malambo ifyo abene bakuula. Ninshi nomba basuulilapo ne fintu ifyo baipangila, ifili nge nceshi sha mulungu Ashera, ne fibumbili fine ifyakocelapo ububani. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.8",
            "verseOrgIds": [
              "ISA.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubo bushiku nga bwafika, ninshi imisumba yabo iyamaka yashala insansalila, kabili ninshi yaba ifibolya nge misumba iyo abena Hifi na bena Amoli bashile insansalila, ilyo bafulumwike abana bakwa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.9",
            "verseOrgIds": [
              "ISA.17.9"
            ]
          }
        }
      ]
