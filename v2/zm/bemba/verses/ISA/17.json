                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amashiwi ayasobelwe palwa musumba wa Damasiko ni aya. Yawe alisosele ati,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.1",
            "verseOrgIds": [
