        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pali ubo bushiku Yawe umwine ewalaisa pingula abantu bakwe abena Israeli, ukutampilafye ku lutwe lumo ulwa calo, ukuya shintafye na ku lutwe lunankwe, ukutendekelafye ku mumana wa Yufurate, ukuya pelelafye na ku kamana mainsa aka pa mupaka wa calo ca Egupto. Akamulonganya umo umo imwe bamwana Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.12",
            "verseOrgIds": [
              "ISA.27.12"
            ]
          }
        }
      ]
    },
