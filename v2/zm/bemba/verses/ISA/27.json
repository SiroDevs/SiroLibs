            "verseId": "ISA.27.12",
            "verseOrgIds": [
              "ISA.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubo bushiku nga bwafika, ipenga likalila ilyakwita abena Israeli bonse abalobelele mu calo ca Asiria, na babutukile ku calo ca Egupto. Bakabwela, bakesa mukulapepela Yawe mu Yerusalemu, pa lupili lwakwe ulwamushilo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.13",
            "verseOrgIds": [
              "ISA.27.13"
            ]
          }
