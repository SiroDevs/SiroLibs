                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pali ubo ubushiku Yawe akabuula ulupanga lwakwe ulukulu ulwatwa kabili ulwakosa, no kukanda cishimweshimwe ci Lefiatani",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.1",
            "verseOrgIds": [
              "ISA.27.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "27:1",
              "type": "text"
            },
            {
              "text": "Lefiatani:",
              "type": "text"
            },
            {
              "text": "Bamo abakale batila ni ŋwena, bambi batila ciswango icapala insoka ico abakale baleti cilwani cakwa Lesa.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", cilya cisoka icifulumuka pakwenda, icisoka cilya ci Lefiatani icifyongana. Akasalipa na cilya cimwansakabinga icaikala muli bemba.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.1",
            "verseOrgIds": [
              "ISA.27.1"
            ]
          }
        }
      ]
    },
