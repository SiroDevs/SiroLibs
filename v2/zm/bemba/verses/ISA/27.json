              "type": "text"
            }
          ]
        },
        {
          "text": "Pali ubo bushiku Yawe akalaimba palwe bala lyakwe ilisuma ilya mwangashi ati,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.2",
            "verseOrgIds": [
              "ISA.27.2"
            ]
          }
        }
