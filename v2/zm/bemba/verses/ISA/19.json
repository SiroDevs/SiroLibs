              "text": "Esek 29:1—32:32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amashiwi ayasobelwe palwa calo ca Egupto ni aya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.1",
            "verseOrgIds": [
              "ISA.19.1"
            ]
          }
