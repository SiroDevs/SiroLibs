                "loc": "PSA.130.8"
              },
              "items": [
                {
                  "text": "Amalu 130:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.4.20"
              },
              "items": [
                {
                  "text": "Amaf 4:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.9"
              },
              "items": [
                {
                  "text": "1 Pet 2:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kristu Yesu aliileka ilambo umwine pakuti atulubule ku bubi bwesu bonse, tube abakaele. Epakuti tubefye abantu bakwe, abasakamana ukucita ifisuma.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.14",
            "verseOrgIds": [
              "TIT.2.14"
            ]
          }
        }
      ]
    },
