                "loc": "1TI.5.18"
              },
              "items": [
                {
                  "text": "1 Timo 5:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Wilakaka ŋombe ku kanwa ilyo ilenyantaula iŋanu pakushisokola.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.4",
            "verseOrgIds": [
              "DEU.25.4"
            ]
