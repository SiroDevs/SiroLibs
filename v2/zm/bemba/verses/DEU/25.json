          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nga cakuti abaume babili balelwa, elyo muka umo pa balelwa aisa kukupokolola umulume wakwe ku ulemuma, aikata ku fyamfwalo fya uyo umbi, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.11",
            "verseOrgIds": [
              "DEU.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "uyo mwanakashi mufwile ukumuputulako icisansa, tecakwesha kumubelela luse.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.12",
            "verseOrgIds": [
              "DEU.25.12"
            ]
          }
        }
      ]
    },
