                  "text": "Bahi 3:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kabili na ku Kadeshi Banea ilyo Yawe amutumine amwebele ati, ‘Kabiyeni muye poka icalo namupeela.’ Nako kwine mwalitalamine ifyo Yawe Lesa wenu amukonkomeshe. Tamwamucetekele nangu ukumubeela. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.23",
            "verseOrgIds": [
              "DEU.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulatalamina Yawe ukufumafye apo namwishibila.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.24",
            "verseOrgIds": [
              "DEU.9.24"
            ]
          }
        }
      ]
