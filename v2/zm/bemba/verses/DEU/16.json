              "type": "text"
            }
          ]
        },
        {
          "text": "Mukalecita umulinganya, umulinganya wekafye, epakuti muleenda abomi, mukapoke ne calo Yawe Lesa wenu alemupeela.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.20",
