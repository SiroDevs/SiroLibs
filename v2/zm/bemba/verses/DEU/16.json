        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abaume benu bonse bali nokuya monekela pa cinso cakwa Yawe Lesa wenu imiku itatu pa mwaka pa ncende iyo akasala, emukuti, Inshikunkulu iyakulyamo Imikate Iyishatutumuka, Inshikunkulu ya Milungu elyo ne nshikunkulu ya Nsakwe. Takuli mwaume wakumonekela pa cinso cakwa Yawe iminwe nkutwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.16",
            "verseOrgIds": [
              "DEU.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cila muntu ali nokusenda icabupe ukulingana ngefyo Yawe Lesa wenu amupaala.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.17",
            "verseOrgIds": [
              "DEU.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 16:17"
          },
          "items": [
            {
