                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Nomba muli isho nshiku, ilyo ubo bucushi bukapita, elyo akasuba kakafiita, umweshi nao ukaleka ukubalika, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.24",
            "verseOrgIds": [
              "MRK.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
