                  "text": "Imili 9:23-25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ilyo nali mu Damasiko, umulashi wa mfumu Aleta abikile abantu bakulinda impongolo sha musumba pakuti banjikate. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.32",
            "verseOrgIds": [
              "2CO.11.32"
            ]
          }
