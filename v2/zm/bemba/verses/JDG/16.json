              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.30",
            "verseOrgIds": [
              "JDG.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awe bamunyina pamo no lupwa lonse ulwakwa wishi baile kukusenda icitumbi cakwe. Baciletele no kucishiika pakati ka musumba wa Sola na Eshitaoli mu nindi yakwa wishi Manoa. Samsoni atungulwile abena Israeli pa myaka amakumi yabili.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.31",
            "verseOrgIds": [
              "JDG.16.31"
            ]
          }
        }
      ]
    }
