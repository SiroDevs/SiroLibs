        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.22",
            "verseOrgIds": [
              "JDG.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elintu umukashi wakwe atile, “Nga cakuti Yawe alefwaya ukutwipaya, awe nga tapokelele ilambo lyakoca no mutuulo wa cabunga ukufuma ku maboko yesu, kabili nga tatulangile ifintu fyonse ifi nangu ukutweba ifi fyonse batwebele.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.23",
            "verseOrgIds": [
              "JDG.13.23"
            ]
          }
        }
      ]
    },
    {
