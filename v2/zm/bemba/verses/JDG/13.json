          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awe asukile umwanakashi apapa umwana umwaume, kabili amwinike ishina lya Samsoni. Umwana alakula, na Yawe amupaala. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.24",
            "verseOrgIds": [
              "JDG.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Umupashi wakwa Yawe watampile ukumucincisha ilyo acili aleikala mu Mane Dani",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.25",
