        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.25",
            "verseOrgIds": [
              "JDG.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abena Israeli bonse baile ku Betele, kabili kulya kwine baile mukulila pa cinso cakwa Yawe. Pali bulya bwine bushiku tabalile nelyo kamo mpakafye icungulo. Batuulile kuli Yawe amalambo ya cakoca, elyo no mutuulo wakwampana. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.26",
            "verseOrgIds": [
              "JDG.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili abena Israeli baipwishe Yawe pantu mu nshiku shilya Imbokoshi ya Cipangano cakwa Lesa eko yali. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.27",
            "verseOrgIds": [
              "JDG.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pantu mu nshiku shilya Fineasi mwana Eleasa, nao mwana Aroni, ewaletungulula amapepo pa ntanshi ya mbokoshi, elyo atile, “Bushe nakabili tuleya ku bulwi na bena Benjamini bamunyinefwe nangu twiyako?” Nao Yawe atile, “Kabiyeni, pantu mailo lyena nkabapeela mu maboko yenu.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.28",
            "verseOrgIds": [
              "JDG.20.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.28",
            "verseOrgIds": [
              "JDG.20.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo abena Israeli babelamike ifita fyabulwi ukushinguluka umusumba wa Gibea. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.29",
            "verseOrgIds": [
              "JDG.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awe pa bushiku bwalenga shitatu abena Israeli baile sansa abena Benjamini nabatantika ifita fyabulwi ukulungatana no musumba wa Gibea pamo ngefyo bacitile pakutendeka. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.30",
            "verseOrgIds": [
              "JDG.20.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilyo nabo abena Benjamini bafumine mukuya bakumanya, babatwele ukutali, ukubatalusha ku musumba. Nga filya cali ku nshita sha kunuma, bayambile ukulaipaulula abena Israeli mu misebo, umbi uwalola ku Betele elyo umbi ku Gibea. Bambi abena Israeli babepaile mu mpanga ukufika pa mpendwa ya makumi yatatu (30). ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.31",
            "verseOrgIds": [
              "JDG.20.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abena Benjamini batampile ukutontonkanya ukuti, “Kwena twabacimfya ngefyo twacitile intanshi.” Lelo abena Israeli baletila, “Natufulumuke no kubatwala ukutali ku misebo ukufuma ku musumba.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.32",
            "verseOrgIds": [
              "JDG.20.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.32",
            "verseOrgIds": [
              "JDG.20.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JDG 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bonse abena Israeli bafumine pa cifulo cakulwilapo no kuya tantama ku Bali-Tama. Elyo abena Israeli ababelamine abanabo basokoloka lubali lwa ku masamba ya Gibea. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.33",
            "verseOrgIds": [
              "JDG.20.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JDG 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo ifita ifyasalilwe amakana ikumi limo (10,000) pa bena Israeli fyasanshile icabipisha abena Benjamini ku Gibea. Awe ubu bulwi bwalibipishe nganshi, icakuti na bena Benjamini bene tabaishibe nokuti icinkunka calabaponena. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.34",
            "verseOrgIds": [
              "JDG.20.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 20:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awe Yawe acimfishe abena Benjamini pa cinso ca bena Israeli. Kabili pali bulya bwine bushiku, abena Israeli baipeye abena Benjamini ukufika na ku mpendwa ya makana amakumi yabili na yasano no mwanda umo (25,100). Bonse bali babulwi bwa mpanga. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.35",
            "verseOrgIds": [
              "JDG.20.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JDG 20:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo abena Benjamini epakumona ukuti nabacimfiwa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.36",
            "verseOrgIds": [
              "JDG.20.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JDG 20:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abena Israeli epakufuntukako ku bena Benjamini pantu balishibe bwino ukuti nabakwata ifita fyabulwi ifyabeleme mupepi no musumba wa Gibea. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.36",
            "verseOrgIds": [
              "JDG.20.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JDG 20:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifita ifyabeleme nafyo fyapumikishe ukwingila mu musumba wa Gibea, no kuushinguluka. Fyaipaya na bantu bonse ku lupanga. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.37",
            "verseOrgIds": [
              "JDG.20.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JDG 20:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abena Israeli ababulwi balyumfwene ne fita ifyabeleme ukuti, bali nokufutumuna ikumbi ilikalamba nganshi ilya fyushi ukufuma mu musumba, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.38",
            "verseOrgIds": [
              "JDG.20.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JDG 20:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "elyo nomba ifita fyabulwi ifya bena Israeli fili nokupilibuka no kwamba ukulwa. Na pali iyi nshita ninshi abena Benjamini balyambileko ukulaipaulula abena Israeli ukufikafye na pa bantu amakumi yatatu (30). Pantu batontonkenye ukuti, “Ifwe tuli nokubacimfya ngefyo twabacimfishe ku bulwi bwantanshi.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.39",
            "verseOrgIds": [
              "JDG.20.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JDG 20:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelo ilyo intumba ya cushi yatampile ukwimina mu mulu ukufuma mu musumba, abena Benjamini bapilibwike, kabili bamwene ne cushi cikumenefye umusumba onse, cilefutumukila mu mulu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.40",
            "verseOrgIds": [
              "JDG.20.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JDG 20:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo nomba nabo abena Israeli bayalulwike mukusansa abalwani babo. Kabili abena Benjamini calibapeseshe amano, pantu baishibe ukuti nomba icinkunka nacibafikila. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.41",
            "verseOrgIds": [
              "JDG.20.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JDG 20:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi ici ecalengele bafulumuke ku cinso ca bena Israeli no kulungama ku matololo. Lelo nalyo line ubulwi tabwapwile iyoo, pantu abena Israeli abalefuma ku misumba balekumanya abena Benjamini no kubepaya. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.42",
            "verseOrgIds": [
              "JDG.20.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JDG 20:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bashingulwike abena Benjamini no kubabutusha ulubilo no kubasangila apalungatene no musumba wa Gibea, lwa ku kabanga epo babakomawilile. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.43",
            "verseOrgIds": [
              "JDG.20.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JDG 20:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi ifita fyacenjele icine cine ifya bena Benjamini ifyo baipeye fyali amakana ikumi limo na cine konse konse (18,000). ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.44",
            "verseOrgIds": [
              "JDG.20.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JDG 20:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awe nelyo bayalulukile lwa ku matololo mu kufulumuka kwabo pakuti baye fisama ku cilibwe ca Limoni, nalyo line abena Israeli baipeyepo abantu amakana yasano (5,000), abo baleipaila mu misebo. Kabili batwalililefye ukukonka abena Benjamini mpaka na ku Gidomu. Kabili bakonkeshepo ukwipaya na bambi amakana yabili (2,000). ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.45",
            "verseOrgIds": [
              "JDG.20.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JDG 20:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabili pali bulya bwine bushiku amakana amakumi yabili na yasano (25,000) aya fita fya bena Benjamini ifyacenjela nganshi ku bulwi bwa mpanga efyo baipeye mu bulwi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.46",
            "verseOrgIds": [
              "JDG.20.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JDG 20:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.46",
            "verseOrgIds": [
              "JDG.20.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JDG 20:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomba abaume imyanda mutanda (600) ebabwelulwike no kufulumukila mu matololo ku cilibwe ca Rimoni, uko baile ikala imyeshi ine. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.47",
            "verseOrgIds": [
              "JDG.20.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JDG 20:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo abena Israeli babwelulukile abena Benjamini no kwipaya bonse abantu ba mu misumba ukubomfya impanga. Kabili takwashele citekwa nelyo cimo, nangufye akantu konse ako basangile balikonawile. Imishi yonse umo balepita, baleyoca no mulilo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.48",
            "verseOrgIds": [
              "JDG.20.48"
            ]
          }
        }
      ]
    }
  ],
