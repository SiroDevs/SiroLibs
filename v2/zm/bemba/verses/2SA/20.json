                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.10.16"
              },
              "items": [
                {
                  "text": "2 Imila 10:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo kwali intalamisoka yamuntu, ishina lyakwe ni Sheba umwana wakwa Bikiri, umwina Benjamini. Alilishishe ipenga no kulapunda ati, “Ifwe tatuli na cakaniko muli Davidi, tatukwetemo ne cishilano muli mwana Yese! Mwe bena Israeli bonse kabiyeni cila umo kumwakwe!” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.1",
            "verseOrgIds": [
              "2SA.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanshi bonse abena Israeli epakusha Davidi nokulakonka Sheba umwana wakwa Bikiri. Lelo abena Yuda bena mu cishinka bashala ne mfumu yabo, ukufuma ku Yordani mpaka ku Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.2",
            "verseOrgIds": [
              "2SA.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.2",
            "verseOrgIds": [
              "2SA.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
