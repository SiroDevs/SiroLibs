              "type": "text"
            }
          ]
        },
        {
          "text": "Yoabu ali e mukalamba wa fita fyonse ifya bena Israeli. Benaya umwana wakwa Yehoiyada ali nao e mukalamba pa bena Kereti na bena Peleti. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.23",
            "verseOrgIds": [
              "2SA.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
