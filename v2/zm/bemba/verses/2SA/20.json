          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shefa ali ni kalemba wa milandu. Sadoki na Abiyata bali ni bashimapepo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.25",
            "verseOrgIds": [
              "2SA.20.25"
            ]
          }
