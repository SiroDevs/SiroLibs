          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adoramu nao ali kangalila wa bamulaasa. Yehoshafati umwana wakwa Ailudi nao ali ni kalemba wa fyalecitika mu calo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.24",
            "verseOrgIds": [
              "2SA.20.24"
            ]
          }
        },
        {
          "name": "verse",
