              "type": "tag",
              "attrs": {
                "loc": "1CH.29.27"
              },
              "items": [
                {
                  "text": "29:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Davidi ali ne myaka amakumi yatatu (30) ilyo aishile pa bufumu, no kuteeka ateekelepo imyaka amakumi yane (40). ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.4",
            "verseOrgIds": [
              "2SA.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu Hebuloni ateekele icalo ca Yuda imyaka cine lubali na citika. Elyo mu Yerusalemu ateekele Israeli pamo na Yuda pa myaka amakumi yatatu na itatu (33).",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.5",
            "verseOrgIds": [
              "2SA.5.5"
            ]
          }
        }
      ]
    },
    {
