          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo imfumu Davidi yaingile mukati no kwikala ku cinso cakwa Yawe, yasosa aiti,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.18",
            "verseOrgIds": [
              "2SA.7.18"
            ]
          }
