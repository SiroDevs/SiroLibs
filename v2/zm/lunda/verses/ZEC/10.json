        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulombenu Yehova nvula muchilaaka chanvula yakukuminina, mulombenu Yehova wakeneshaŋa mavu; yena wakayinka nvula jawo-wo-wo, kulonda enki antu ejima matahu mumpata. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.1",
            "verseOrgIds": [
              "ZEC.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkishi jakupanda jinahoshi yamukunkulwayi, akwakuhoŋa anamoni chuma chakutwamba; anashimuni yilota yakutwamba, anakundeji antu mwamukunkulwayi; dichi wena adi nakululuta neyi nyikoku, anamoni kukala muloŋa wákubula kabiŋa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.2",
            "verseOrgIds": [
              "ZEC.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.2",
            "verseOrgIds": [
              "ZEC.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nayitatashanina dehi atubiŋa kuzuwa, nakababesha yizamba yampembi. Muloŋa Yehova wamazaza wahempula dehi mukanka windi wanyikoku, wowu mutaŋa waYuda, wakayibalumuna kwikala neyi kawalu kindi kakawahi kadi kunjita. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.3",
            "verseOrgIds": [
              "ZEC.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kudi yena kwakafuma ilola dakwiwombu, kudi yena kwakafuma mpopu, kudi yena kwakafuma wuta wamukunji wakunjita, kudi yena kwakafuma akwakuyula ejima hamu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.4",
            "verseOrgIds": [
              "ZEC.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akekala neyi ayilobu, nakudatola ayilumbu jawu kunjita, mumaseki amunyikwakwa achakata; akalwa, muloŋa Yehova wudi nawu. Akwakwendela hatuwalu akabaya. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.5",
            "verseOrgIds": [
              "ZEC.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakakolesha mutaŋa waYuda, nakaamwina mutaŋa waYosefu, nakayifuntisha cheŋi, muloŋa ami nayitiyili luwi, akekala neyi hinayumbiluku. Muloŋa yami Yehova Nzambi yawu, nakayitiyaloŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.6",
            "verseOrgIds": [
              "ZEC.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "AkwaEfweremi akekala neyi ayilobu, nyichima yawu yakazaŋalala neyi chazaŋalalaŋawu navinyu. Eŋa, anyanawu akachimona, akazaŋalala; nyichima yawu yakaluŋa mudi Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.7",
            "verseOrgIds": [
              "ZEC.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.7",
            "verseOrgIds": [
              "ZEC.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakayimbila muloji wakuyitambika, nakayipompesha; Muloŋa nayikuula dehi. Akavula neyi chavuliluwu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.8",
            "verseOrgIds": [
              "ZEC.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela nayikuwakuwa dehi mukachi kanyuza, akaŋanukaŋa mumatuŋa akwakulehi. Akahandaŋa hamu nawanyanawu, akafunta cheŋi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.9",
            "verseOrgIds": [
              "ZEC.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakayifumisha mwituŋa daEjipitu, nakayifuntisha cheŋi kwawu, nakayifumisha muAshuri, nakayipompesha; nakayishikŋa mwituŋa daGileyadi naLebanoni; hiyakawanina hakushakamaku. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.10",
            "verseOrgIds": [
              "ZEC.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakahita mukaluŋalwiji kayihuŋu, waketa mankanda amukaluŋalwiji, nimanyiŋi amuNile akoma ejima chau. Niwanta wadinkeluwu aAshuri akawushikumwisha, ninkunyi yaEjipitu yawanta yakayifuma. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.11",
            "verseOrgIds": [
              "ZEC.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakayikolesha mudi Yehova; akadisamba mwijina dindi. Dimu mwanahoshiyi Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.12",
            "verseOrgIds": [
              "ZEC.10.12"
            ]
          }
        }
      ]
    }
  ],
