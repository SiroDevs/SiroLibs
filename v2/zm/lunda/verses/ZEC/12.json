      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuprofwetu wezu daYehova wakutena aIsarela. Yehova watanjikaŋa mawulu, waalaŋa chikuku cheseki, welaŋa spiritu yamuntu mukachi kindi, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.1",
            "verseOrgIds": [
              "ZEC.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Tiyenu, nakabalumuna Yerusalema kwikala lupasa lwakupedaŋila kudi nyuza yejima yanyeŋumukaku; lwakekala lwakumutamisha niYuda nawa hakakuchikawu Yerusalema kudi antu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.2",
            "verseOrgIds": [
              "ZEC.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hefuku odu nakabalumuna Yerusalema kwikala ilola dalema kudi antu akunyuza yejima. Antu ejima akaditwikadu akadikatisha nankashi, ninyuza yejima yahamaseki yakapompa nakulwa nawu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.3",
            "verseOrgIds": [
              "ZEC.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nindi, Hefuku odu nakafwisha tuwalu twejima mutentu, niakwakwendelahu nakayizalukisha. Mutaŋa waYuda nakawutonena mesu ami, nakaputisha mesu atuwalu twejima twanyuza yawantu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.4",
            "verseOrgIds": [
              "ZEC.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayilolu awaYuda akahosha munyichima yawu, nawu, Akwakushakama muYerusalema diyi Ŋovu yami mudi Nzambi yawu Yehova wamazaza.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.5",
            "verseOrgIds": [
              "ZEC.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.5",
            "verseOrgIds": [
              "ZEC.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hefuku odu nakabalumuna yilolu yawaYuda kwikala neyi inuŋu yinabutuki kesi mukachi kanyitondu, neyi chimunyi chakesi chidi mukachi kayita; akavwota antu ejima anyeŋumukaku kwi-ndo, nikuchikasa chachidiilu nikuchikasa chachimunswa. Yerusalema wakashakama cheŋi mwomuchipela chindi, mwomuYerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.6",
            "verseOrgIds": [
              "ZEC.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.6",
            "verseOrgIds": [
              "ZEC.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wakasambila kwamwina matenti awaYuda, kulonda lubanji lwamutaŋa waDavidi, nilubanji lwawakwakushakama muYerusalema akabuli kulubadisha aYuda. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.7",
            "verseOrgIds": [
              "ZEC.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dena ifuku odu Yehova wakalwila akwakushakama muYerusalema. Dena ifuku odu wabula Ŋovu mukachi kawu wakekala neyi Davidi, mutaŋa waDavidi wakekala neyi Nzambi, neyi kaŋelu kaYehova kadi kumesu awu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.8",
            "verseOrgIds": [
              "ZEC.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dena ifuku odu nakakeŋa kujilumuna nyuza yejima yakenza nakulwa naYerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.9",
            "verseOrgIds": [
              "ZEC.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.9",
            "verseOrgIds": [
              "ZEC.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamutaŋa waDavidi nihadi akwakushakama muYerusalema nakechilahu spiritu waluwi niwakulembelela; akatala hadami alokweluwu. Akamudila neyi chadilaŋa muntu mwanindi wasemuka kanka windi, akamutiyila kulula kumuchima, neyi chatiyaloŋayi muntu kulula hadi wedi windi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.10",
            "verseOrgIds": [
              "ZEC.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dena ifuku odu muYerusalema mwakekala kudila kwasweja nankashi, neyi kudila kwadililuwu kuHadadirimoni muchinekineki chaMegido. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.11",
            "verseOrgIds": [
              "ZEC.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ituŋa dakadila, chisaka nahachu, chisaka nahachu; chisaka chamutaŋa waDavidi nahachu, aŋodi jawu nahawu; chisaka chamutaŋa waNatani nahachu, aŋodi jawu nahawu; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.12",
            "verseOrgIds": [
              "ZEC.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "chisaka chamutaŋa waLevi nahachu, aŋodi jawu nahawu; chisaka chawakwaShimeyi nahachu, aŋodi jawu nahawu; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.13",
            "verseOrgIds": [
              "ZEC.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "niyisaka yakashalaku yejima, chisaka nahachu, chisaka nahachu, aŋodi jawu nahawu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.14",
            "verseOrgIds": [
              "ZEC.12.14"
            ]
          }
        }
      ]
    }
