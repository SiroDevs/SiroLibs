          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izu daYehova wamazaza denjili kudami, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.18",
            "verseOrgIds": [
              "ZEC.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ZEC 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Tiyenu chanahoshiyi Yehova wamazaza, nindi, Kujiŋa nanzala kwamukakweji kamuchiwana, nikujiŋa nanzala kwamukakweji kamuchitanu, nikujiŋa nanzala kwamukakweji kamuchitanu nachiyedi, nikujiŋa nanzala kwamukakweji kekumi, kwakekalaŋa kudi akwamutaŋa waYuda kuluŋa nakutiya kuwaha, niyawija vakuzaŋajala; dichi keŋenu ninsaŋu yalala nikuwunda.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.19",
            "verseOrgIds": [
              "ZEC.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ZEC 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.19",
            "verseOrgIds": [
              "ZEC.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ZEC 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wamazaza nindi, Kwamba kenza nyuza yawantu, niakwakushakama munyikala yayivulu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.20",
            "verseOrgIds": [
              "ZEC.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ZEC 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashakama mukala wumu akayaloŋa kudi ashakama hamukala wukwawu, nakwila nawu, Tuyenu swayi twakalembeleli wuselewa wakudi Yehova, twakakeŋakeŋi Yehova wamazaza. Ninami nawa nukuya. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.21",
            "verseOrgIds": [
              "ZEC.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ZEC 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwalala antu amavulu, ninyuza yaŋovu, yakenza nakukeŋakeŋa Yehova wamazaza muYerusalema, nakulembelela wuselewa wakudi Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.22",
            "verseOrgIds": [
              "ZEC.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ZEC 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wamazaza nindi, Hamafuku owu ikumi dawamayala akunyuza yamadimi ejima, akakwata kwihina dakaYudeya, nawu, Tuyi nenu, Muloŋa tunatiyi nawu Nzambi mwekala nindi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.23",
            "verseOrgIds": [
              "ZEC.8.23"
            ]
          }
        }
      ]
    }
