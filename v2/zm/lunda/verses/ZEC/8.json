          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.17",
            "verseOrgIds": [
              "ZEC.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
