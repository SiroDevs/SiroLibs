    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njinji jafwa janunkishaŋa malasha amukwakwila malasha ivumba datama; chochimu nawa nikukenkama kwantesha kwatamishaŋa nima ana ni kulema.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.1",
            "verseOrgIds": [
              "ECC.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.1",
            "verseOrgIds": [
              "ECC.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muchima wamukwamaana wekala kuchikasa chindi chachidiilu; ilaŋa muchima wachisupi wekala kuchimunswa.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.2",
            "verseOrgIds": [
              "ECC.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.2",
            "verseOrgIds": [
              "ECC.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwalala nawa, chisupi hayi kunjila, nikashinshi kindi kanamufumi dehi, hakuleja antu ejima nindi, Nichisupi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.3",
            "verseOrgIds": [
              "ECC.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.3",
            "verseOrgIds": [
              "ECC.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi spiritu yanyuli yinakutakumukili, bayi wufuma muchididi cheyuku; muloŋa kwovwaha kwafwomonaŋa nyiloŋa yamaneni.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.4",
            "verseOrgIds": [
              "ECC.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.4",
            "verseOrgIds": [
              "ECC.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kudi chuma chatama chinamoni mwishina detaŋwa, chidi neyi kuluwa kunafumi kudi yomweni mukwakuyula, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.5",
            "verseOrgIds": [
              "ECC.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "yowu kwila wusupi awushakamishi hewulu hahalehi, mukwakuheta amushakamishi hamaseki. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.6",
            "verseOrgIds": [
              "ECC.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoni anduŋu hiyakwendela hatuwalu, hakwila atulamba hiyakwenda hamaseki neyi anduŋu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.7",
            "verseOrgIds": [
              "ECC.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.7",
            "verseOrgIds": [
              "ECC.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu wukupunda wina wakakulukilamu yomweni; wukulokola ikoli akamusuma kudi kapela. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.8",
            "verseOrgIds": [
              "ECC.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wukubindumuna malola akamukatisha nachu; wukubalula yibalu keŋa adŋahi nachu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.9",
            "verseOrgIds": [
              "ECC.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.9",
            "verseOrgIds": [
              "ECC.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi chitwa chinashimi nimuntu kuchilola nehi chiŋa ashaku Ŋovu; nima ana awahila kuloŋesha nachu nsaŋu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.10",
            "verseOrgIds": [
              "ECC.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.10",
            "verseOrgIds": [
              "ECC.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapela neyi wukusuma muntu hachidiyi kanda amufwomoni, hichikumuwahila mukwakufwomonaku.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.11",
            "verseOrgIds": [
              "ECC.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.11",
            "verseOrgIds": [
              "ECC.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazu amukanwa kamukwamaana akweti luwi; ilaŋa nyivumbu yachisupi yamba kamuminya yomwenindi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.12",
            "verseOrgIds": [
              "ECC.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazu amukanwa kindi atachikila muwusuŋi, nimpanji yindi yakumishila mukuzaluka kwatama. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.13",
            "verseOrgIds": [
              "ECC.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisuŋi nawa wavulishaŋa mazu; muntu hatweshaŋa kwiluka chuma chamba kekalaku; nichuma chakamuhiŋa munyima wukumulejachu hinyi? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.14",
            "verseOrgIds": [
              "ECC.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukabakana kwakabakanaŋa ayisupi kwayizeyeshaŋa wejima wawu hamuntu hamuntu, muloŋa hiyeluka kuya kumukalaku.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.15",
            "verseOrgIds": [
              "ECC.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.15",
            "verseOrgIds": [
              "ECC.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi ituŋa, neyi mwanta weyi hikansi, niatulamba tweyi adyaloŋa nabudidi, yowe! ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.16",
            "verseOrgIds": [
              "ECC.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi ituŋa, neyi mwanta weyi himwana kawayilolu alema, niatulamba tweyi adyaloŋa hatelela kudya, kulonda Ŋovu, bayi kulonda kushetaku, wunakooleki!",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.17",
            "verseOrgIds": [
              "ECC.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.17",
            "verseOrgIds": [
              "ECC.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ECC 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itala kushiwuka chikufuma hakukatala; itala kuvwa chikufuma hamakasa akadi kukwata kumudimu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.18",
            "verseOrgIds": [
              "ECC.10.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ECC 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.18",
            "verseOrgIds": [
              "ECC.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ECC 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chawŋi achilila kuseha, walwa waluŋishaŋa muntu; mali akulaŋa yuma yejima.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.19",
            "verseOrgIds": [
              "ECC.10.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ECC 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.19",
            "verseOrgIds": [
              "ECC.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ECC 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi wakatuŋula mwantaku, hela tuhu muyitoŋojoka yeyi chinjila; bayi wakatuŋula mukwakuheta mwitala deyi dakukamaku, muloŋa izu odu akadisenda kudi kajila kahaluzwizu, nikakweti mpuula kakashimuna nsaŋu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.20",
            "verseOrgIds": [
              "ECC.10.20"
            ]
          }
        }
      ]
    }
