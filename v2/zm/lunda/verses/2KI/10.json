              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa Yehuhashili muchima windi wejima kukwenda munshimbi jaYehova Nzambi yaIsarelaku, muloŋa halekeli munshidi jaYerobowami javulumwishiliyi nachu aIsarelaku.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.31",
            "verseOrgIds": [
              "2KI.10.31"
            ]
          }
