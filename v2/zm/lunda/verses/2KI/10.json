          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehu wakamini hamunawanka kulula jindi. Amujiikili muSamariya. Mwanindi Yehowahazi hakumuswana. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.35",
            "verseOrgIds": [
              "2KI.10.35"
            ]
          }
        },
        {
