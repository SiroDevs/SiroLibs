          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafuku ayuliliyi Yehu aIsarela muSamariya ashikilimunyaka makumi ayedi nanyaka yitanu nayisatu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.36",
