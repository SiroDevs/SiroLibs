          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamafuku owu Yehova watachikili kusembula mpata yaIsarela. Hazayeli wayitapili kuŋinza jawaIsarela jejima, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.32",
            "verseOrgIds": [
              "2KI.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "kufumisha kuYodana nakutwala kumusela, ituŋa daGilevadi dejima, niaGadi, niaRubeni, niaManase, kufumisha kuArowenai wekala kwakwihi nachinekineki chaArinoni, kafwampi yowu Gileyadi naBashani. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.33",
            "verseOrgIds": [
              "2KI.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsaŋu jaYehu jinashalukuni yuma yejima yeliliyi, niŋovu jindi jejima, hiyanajisoneki mumukanda wa wanyanta awaIsarela wakushindululaku? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.34",
            "verseOrgIds": [
              "2KI.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
