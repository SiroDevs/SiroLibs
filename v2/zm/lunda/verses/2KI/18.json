          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akishi akuHamati nakuAripadi adi kudihi? Akishia waSefwavwayimi, niakuHena niakulvwa adi kudihi? Anayipulwishi aSamariya kudami, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.34",
            "verseOrgIds": [
              "2KI.18.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 18:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hadi akishi ejima amumatuŋa hanamwekani mukishinyi napulwishi ituŋa dawu kudami, mwaka Yehova akapulwishi Yerusalema kudami?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.35",
            "verseOrgIds": [
              "2KI.18.35"
            ]
          }
        }
      ]
