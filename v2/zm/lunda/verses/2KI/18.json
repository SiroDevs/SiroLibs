  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "2KI 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwaka wamuchisatu waHosheya mwana kaEla mwanta wawaIsarela, Hezekiya mwana kaAhazi mwanta wawaYuda watachikilikuyula. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.1",
            "verseOrgIds": [
              "2KI.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatachikiliyi kuyula wadiŋi wanyaka makumi ayedi nayitanu, wayulili muYerusalema nyaka makumi ayedi nayitanu nayiwana. Mama yindi ijina dindi Abi mwana kaZekariya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.2",
            "verseOrgIds": [
              "2KI.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Welili chaloŋa kumesu aYehova mwomwelilaŋayi nkakulula yindi Davidi mwejima. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.3",
            "verseOrgIds": [
              "2KI.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wafumishiliyinaŋanaŋa, wahumwini tuposhi twakupeshela, watemeni nyiyombu, waketoleli kapela kawuneŋu keliliyi Mosi; muloŋ anyana kaIsarela adiŋi nakwochelaku insensi kushika nikumafuku owu; hakukatumba ijina, nindi, Nehushitani. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.4",
            "verseOrgIds": [
              "2KI.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakuhweleleli Yehova Nzambi yaIsarela, hikwadiŋiwudi neyi yenaku, hela hadi anyanta awaYuda ejima ahiŋili munyima yindi, hela tuhu hadi ásambilili. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.5",
            "verseOrgIds": [
              "2KI.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa yena wamulamatili Yehova, helakubalumuka aleki kumulonda nehi, saŋa ahembelayi kuleja kwamulejelu wuMosi kudi Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.6",
            "verseOrgIds": [
              "2KI.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wadiŋi hamu nayena, kwonsu kwayilaŋayihakumonaŋa kuwaha hohu; hakudikaŋa namwanta wakuAshuri, kumukala kelaŋanawa nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.7",
            "verseOrgIds": [
              "2KI.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakutapa aFwilistinu ndo nikuGaza nikuŋinzajawu, hela kukaposhi kamukwakutalatala hela kumukala wampwembukuyitapa hohu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.8",
            "verseOrgIds": [
              "2KI.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.8",
            "verseOrgIds": [
              "2KI.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamwaka wamwanta Hezekiya wamuchiwana, wowadiŋi mwaka wamuchitanu nachiyedi waHosheya mwana kaEla mwanta wawaIsarela, mwanta wakuAshuri Shalimanesa wenjili nakwasa Samariya, hakuwukuchika. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.9",
            "verseOrgIds": [
              "2KI.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chamanini nyaka yisatu hiyakuwutambula. Mwomumwaka waHezekiya wamu chitanu nachimu, wadiŋi mwaka wamwanta wawaIsarela Hosheya wamu chitanu nachiwana, dimu mwatambwililuwu Samariya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.10",
            "verseOrgIds": [
              "2KI.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.10",
            "verseOrgIds": [
              "2KI.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wakuAshuri wafumishilumu aIsarela hakuyitwala muAshuri, hakuyisha muHala namuHabori kukaloŋa kakuGozani, nimunyikala yawaMediya, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.11",
            "verseOrgIds": [
              "2KI.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "nanochu chabulili kwovwahilawu izu daYehova Nzambi yawu, hiyakumotoka chitiyaŋenu chindi, mwejima mwamulejeluwu kambuŋa-Yehova Mosi, kwonti kwawu kutiyamu hela kwilamu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.12",
            "verseOrgIds": [
              "2KI.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.12",
            "verseOrgIds": [
              "2KI.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwaka wamwanta Hezekiya wekumi nakawana mwanta wakuAshuri Senakeribi wenjili nakwasa nyikala yawaYuda yamapwembu yejima, nakuyitambula. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.13",
            "verseOrgIds": [
              "2KI.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wawaYuda Hezekiya hakutemesha mazu kudi mwantawaku Ashuri kuLakishi, nindi, Naluwi dehi; funtakumu; mwonsu muwakantoŋwelanakafuta. Mwanta wakuAshuri wamutoŋweleli mwantawa waYuda Hezekiya kufuta ntalenta jasiliva makulakaji asatu, ninta lenta jawuru makumi asatu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.14",
            "verseOrgIds": [
              "2KI.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekiya wamwinkeli siliva yejima yadiŋimwitala daYehova, niyadiŋi muyuma yalema yakwitala damwanta.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.15",
            "verseOrgIds": [
              "2KI.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.16",
            "verseOrgIds": [
              "2KI.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wakuAshuri hakutemesha Taritani naRabisarisi naRabishake, hiyakufuma kuLakishi, hiyakuya kudi mwanta Hezekiya kuYerusalema nanjita yeneni. Hiyakuyaku, hiyakushika kuYerusalema. Chana shikuwu hiyakuya nakwimana kukapila kakwijiya dakundundamu dekala kumukwa kwawakwiha damukwakukosa mahina. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.17",
            "verseOrgIds": [
              "2KI.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chamu tambikiluwu mwanta, hikukwinza mwana kaHilikiya Eliyakimi, wadiŋi mukulumpi wawakwetala, ninsoneki Shebina, ni mwana kaAsafwi Yowa mukwakusoneka nsaŋu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.18",
            "verseOrgIds": [
              "2KI.18.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.19",
            "verseOrgIds": [
              "2KI.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wudi nakuhosha neyi, Tunakwati dehi mpùŋa, niŋovu yakwasa njitatudi nayu. Ilaŋa mazu amukanwa hohu. Wunakuhwelelinyi mwakawudikaŋi nanami? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.20",
            "verseOrgIds": [
              "2KI.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komana wunakuhweleli aEjipitu adi neyi mbwechiyeteti dachikeka dehi, yakwila muntu wukwila nindi ashilamenuhu hiyikwinila muchikasa chindi, hiyikumulemeka? Dichi chelaŋayi mwantawa kuEjipitu Fwaro nawantu ejima amukuhwelelaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.21",
            "verseOrgIds": [
              "2KI.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi mukuŋilanenu, Tunakuhweleli Yehova Nzambi yetu, hidiyi wukweti yinaŋanaŋa nitumeŋa twanafumishiyi Hezekiya, hakuyila aYuda nawakwaYerusalema nindi, Chiŋa mwakadifukula kudi yena kumesu akameŋaka kamuYerusalema ku? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.22",
            "verseOrgIds": [
              "2KI.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu mwani, mwinkenu nkaka yami mwanta wakuAshuri kapopu, ami nakakwinki tuwalu makombakaji ayedi, neyi eyi wunatweshi kushahu akwakwendelahu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.23",
            "verseOrgIds": [
              "2KI.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi wukukaŋanya kutemuna nikachilolukamu kawambuŋankaka yami akehelamu, yeyi kwaamu wukukuhwelela aEjipitu, neyi akwinki makálu nawakwatuwalu? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.24",
            "verseOrgIds": [
              "2KI.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinenzi nakujilumuna mukaliwu, komana nenzi kanka wami chakadi Yehova? Yehova diyinaŋili nindi, Yaku wakaasi ituŋidi wakadijilumuni.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.25",
            "verseOrgIds": [
              "2KI.18.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.25",
            "verseOrgIds": [
              "2KI.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana kaHilikiya Eliyakimi, niShebina, niYowa, hiyakumwila Rabishake, nawu, Atuhoshi mwani, etu ambuŋeyi mwidimi daSiriya, muŋatwadiluka. Bayi atuhosha mwidimi dawaYudeya kumatu awantu adi hampwembuku. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.26",
            "verseOrgIds": [
              "2KI.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rabishake hakuyila nindi, Komana mwanta waminantemeshi nihoshi mazu awa namwanta weyi hela naneyi hohu? Hanantemeshi kudi antu ashakama hampwembu kulonda akadyi tuji twawu, akanwimasu awu hamu naneyuku?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.27",
            "verseOrgIds": [
              "2KI.18.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 18:27"
          },
