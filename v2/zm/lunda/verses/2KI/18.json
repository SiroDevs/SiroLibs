              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa ntu adimweneneni zo-o, kumwakula izu nidimu nehi, muŋamwanta wayileja dehi nindi, Bayi mumwakulaku. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.36",
