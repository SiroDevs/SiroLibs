          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rabishake hakwimana, hakubilela nezu daŊovu mwidimi dawaYudeya, hakwila nindi, Tiyenu izu damwanta muneni, mwanta wakuAshuri.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.28",
