  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "2KI 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kawatuprofwetu amwilili Elisha, nawu, Talenu mwani, munu namutunashakami naneyi munatukeheli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.1",
            "verseOrgIds": [
              "2KI.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atwitiji mwani, tuyi kuYodana, twakatemi nyalachi, iwu nawindi, iwu nawindi, twakatuŋi kumu, twakashakamuku. Hakuyakula nindi, Yenuŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.2",
            "verseOrgIds": [
              "2KI.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wumu welili nindi, Itŋiku mwani, kuya nanetu ambuŋeyi. Nindi, Nukuya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.3",
            "verseOrgIds": [
              "2KI.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi hakuyanawu. Chashikiluwu kuYodana, hiyakutema nyitondu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.4",
            "verseOrgIds": [
              "2KI.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wumu chadiŋi nakutemayi mwalachi, chizembi chindi hichikuzokokela mumeji. Hakudila nindi, Yayo! Eyi mwanta, chizembi chambala! ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.5",
            "verseOrgIds": [
              "2KI.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu waNzambi nindi, Chinaholokeli hadihi? Hakumuleja hichaholokeleli. Hakutetaka mutondu, hakukombilahu, chikuŋu ochu chifumpuka nikufumpuka.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.6",
            "verseOrgIds": [
              "2KI.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.8",
            "verseOrgIds": [
              "2KI.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu waNzambi hakutemesha mazu kudi mwanta wawaIsarela, nindi, Babalaku, bayi wakahitila kunaku, muloŋa diku kukukunkumukilawu aSiriya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.9",
            "verseOrgIds": [
              "2KI.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.10",
            "verseOrgIds": [
              "2KI.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muchima wamwanta wakuSiriya hiwukululuta nadiumichi; hakutambika ambuŋindi, hakuyila nindi, Munabulilidi kunleja wetu nakumikudi mwanta wawaIsarela? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.11",
            "verseOrgIds": [
              "2KI.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kambuŋindi wumu nindi, Kwosi, eyinkaka yami, eyi mwanta; yowu Elisha kaprofwetu wekala muIsarela, diyiwalejaŋ mwanta wawaIsarela mazu iwahoshapeyi mwitala deyi dakukama.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.12",
            "verseOrgIds": [
              "2KI.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.14",
            "verseOrgIds": [
              "2KI.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kambanji kamuntu waNzambi chahindukiliyi budidi, hakwidika nindi atali, mukala awukuchika dehi njita, nituwalu nimakálu ŋambayindi hakukaluka nindi, Yayo! Eyi mwanta wami, tukwila jilili? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.15",
            "verseOrgIds": [
              "2KI.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindi, Bayi wutiya womaku. Awa tudi nawu etu, anabadiki awa adi nawena.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.16",
            "verseOrgIds": [
              "2KI.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.23",
            "verseOrgIds": [
              "2KI.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiyakumini yumiyi mwanta wakuSiriya Benihadadi wapompeshelinjita yindi yejima, hakuya nakukuchika Samariya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.24",
            "verseOrgIds": [
              "2KI.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "MuSamariya himukwikalanzala yayeni. Chawililuwu kuchike-e, namutu wachimbulu hiyakuwulandajishekeli jasiliva makumi atanu nasatu, tuji twakapompa twakweseka mukachikoŋu kamu hiyakutulanda jishekeli jasiliva jitanu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.25",
            "verseOrgIds": [
              "2KI.6.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.25",
            "verseOrgIds": [
              "2KI.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chelili mwanta wawaIsarela hakuhita hampwembu, mumbanda wumuhakumubilela nindi, Eyi nkaka yami mwanta, nkwashuku. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.26",
            "verseOrgIds": [
              "2KI.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwantanindi, Neyi Yehova kukukwashaku nehi, indi ami nukukukwasha nanka? Kunkalaŋa, tahindi kuwukamwinu wavinyu? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.27",
            "verseOrgIds": [
              "2KI.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta hakumwihulanindi, Kudi nsaŋwinyi? Mumbanda nindi, Iwu mumbanda waŋila nindi, Letaku mwaneyi tumudyi lelu, kumadiki twakadyi wamami. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.28",
            "verseOrgIds": [
              "2KI.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tutelekani mwanami, tumudya nikumudya. Chikunachi hinukumwila nami, Letaku mwaneyi, tumudyi. Yena nasweki mwanindi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.29",
            "verseOrgIds": [
              "2KI.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta chatiyiliyi mazu amumbanda, hakutabola nimahinindi; yena henohu wadi ijina kuhita hampwembu. Antu nawu atali, komana navwali chikeleyi mukachi hamujimba windi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.30",
            "verseOrgIds": [
              "2KI.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwila nindi, Neyi namutu wamwana kaShafwati Elisha wukwi kala kumujimba windi lelu, Nzambi ankoŋi mwomumu nichakubadikamu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.31",
            "verseOrgIds": [
              "2KI.6.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.31",
            "verseOrgIds": [
              "2KI.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisha kwindi wadiŋi washakama mwitala dindi, niakulumpi anashakaminindi hamu. Mwanta hakutemeshaŋilu dehi muntu. Chelili owuntemesha wuchidi kanda ashiki kudi yena, Elisha hakuyila awakulumpi, nindi, Iwu mwana kambanji chanatemeshiyi muntu nindi anfumishi namutu wami, munachimoni, tahindi? Talenu, chakwinzayi ntemesha mwenzelaŋa kuchisu, mwakamwenzelela hanzi, saŋa mwakwatila kuchenzelu mbe; olu lushindu ludi nakwinza munyima yindi hilushindu lwanyendu yamwanta winduku? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.32",
            "verseOrgIds": [
              "2KI.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cheliliyi iku wuchidi kuhosha nawu, kukasumuka nintemeshanenzi dehi kudi yena, hakwila nindi, Kutamiku kunafumi kudi Yehova, indi ami nukumuchilila diYehova chikwawu?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.33",
            "verseOrgIds": [
              "2KI.6.33"
            ]
          }
        }
      ]
    }
  ],
