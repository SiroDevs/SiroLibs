    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ataliya mama yaAhaziya chamweniyi mwanindi nafwi dehi, hakunyamuka nakujilumuna anyana kamwanta ejima. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.1",
            "verseOrgIds": [
              "2KI.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa Yehosheba mwana kamwanta Yehorami, muhelaAhaziya, wanoneni mwana kaAhaziya Yowashi, wamuwombolweli mukachi kawanyana kamwanta ajahiluwu, niyena ninleli yindi, hakuyisha mwitala dakukama; hiyakumusweka kuchina kumumona kudi Ataliya, dichi hiyamujahiluku. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.2",
            "verseOrgIds": [
              "2KI.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wadi ijina yenowu mumbanda mwitala daYehova nyaka yitanu nawumu; ituŋa diŋi nakudiyula kudi Ataliya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.3",
            "verseOrgIds": [
              "2KI.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.3",
            "verseOrgIds": [
              "2KI.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwaka wamu chitanu nachiyedi, Yehoyada watemesheli mazu akutambika awakulumpi amakulakaji awantu, niawambanji, niatulama, hakuyipŋmwitala daYehova mwadiŋiyi yena, hakutiyaŋana nawu chitiyaŋenu, hakuyisanyikisha mwitala daYehova, hakuyimwekeshela mwana kamwanta.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.4",
            "verseOrgIds": [
              "2KI.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.8",
            "verseOrgIds": [
              "2KI.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akulumpi amakulakaji awantu elili mwejima mwayilejeluwu kudikapristu Yehoyada. Wejima wawu atambwili antu awu, ninawa epililihefuku dasabata, ninawa akotokeli hefuku dasabata, hiyakwinza kudikapristu Yehoyada. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.9",
            "verseOrgIds": [
              "2KI.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapristu hakwinka awakulumpi amakulakaji nimayoŋaninkebu jadiŋi jamwanta Davidi, jadiŋi mwitala daYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.10",
            "verseOrgIds": [
              "2KI.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atulama hiyakwimana, iwu nayitwa yindi kuchikasa, iwu nayitwa yindi kuchikasa, kufumisha kumutamba wetala wakuchidiilu, kushika nikumutamba wetalawa kuchimunswa, hiyakukulisha nikukameŋa nikwitala, nikudi mwantakwi-ndo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.11",
            "verseOrgIds": [
              "2KI.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapristu hakwidisha mwana kamwanta, hakumuvwika nichibaaba, hakumwinka niwunsahu. Amudiisha niwranta, amuwayisha nimanji. Hiyakusakilila nkoshi, nawu, Kalombu mwanta.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.12",
            "verseOrgIds": [
              "2KI.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.12",
            "verseOrgIds": [
              "2KI.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ataliya chanatiyiyi ipumba daawatulama nidawantu, hakwinza kudiantu mwitala daYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.13",
            "verseOrgIds": [
              "2KI.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindi atali, mwanta ona nemani kuchishimineyi chelilaŋawu, niatulamba, niakwakwimba mpùŋa nemani kudi mwanta. Antu amwituŋa ejima hiyakuzaŋalala, hiyakwimba nimpirŋa. Ataliya hakutabola mahinindi, hakubidika nindi, Anankwatili makasu atama, Anankwatili makasu atama! ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.14",
            "verseOrgIds": [
              "2KI.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapristu Yehoyada hakuleja awakulumpi amakulakaji enkeliyi wuawakulumpi wanjita, nindi, Muhanwishenu munyikanka. Yowu wukumulonda mwakamujaha nampoku yakabali; muloŋa kapristu welili nindi, Bayi akamujahila mwitala daYehovaku. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.15",
            "verseOrgIds": [
              "2KI.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiya kumushiyila njila, hakuya njila yeŋilila ŋawu atuwalu mwitala damwanta; amujahila nikwenoku.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.16",
            "verseOrgIds": [
              "2KI.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.16",
            "verseOrgIds": [
              "2KI.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoyada welili chitiyaŋenu chakutiyapana niYehova nimwanta niantu, kulonda ekali antu aYehova; chakutiyaŋana mwanta nawantu nawa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.17",
            "verseOrgIds": [
              "2KI.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu amwituŋa ejima hiyakuya kwitala daBayali, hiya kudi humuna. Hiya kubalula chikupu nitumeŋai twindi niakishi indi, hiyakujaha nikapristu kaBayali Matani kumesu atumepa. Kapristu Yehoyada hakukunjika atulama mudimu wakuhemba itala daYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.18",
            "verseOrgIds": [
              "2KI.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakunya muna awakulumpi amakulakaji awantu, niambanji, niatulama, niantu amwituŋa ejima; hiya kumufumisha mwanta kwitala daYehova, hiyakwinza kwitala damwanta njila yakuchisu chaawatulama. Hakushakama hetanda dawanta dawanyanta ankanu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.19",
            "verseOrgIds": [
              "2KI.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu amwituŋa ejima azaŋalala nikuzapalala, nimukalawu mwena nizo-o. Ataliya amujahilili kwitala damwanta nampoku yakabali.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.20",
            "verseOrgIds": [
              "2KI.11.20"
            ]
          }
        }
      ]
    },
