              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakuya nawuamujiiki. Hiyakuwana kwachaŋu, namadachilu, namakabu amakasindi hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.35",
