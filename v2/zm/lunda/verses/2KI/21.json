  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "2KI 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatachikili kuyulayi Manase, wadiŋi wanyaka ikumi nayiyedi. Wayulili muYerusalema nyaka makumi atanu nanyaka yitanu. Mama yindi ijina dindi Hefwiziba. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.1",
            "verseOrgIds": [
              "2KI.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Welilaŋa chatama kumesu aYehovaneyi mwaya yishimashima yanyuza yatemwiniyi Yehova kumesu awanyana kaIsarela. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.2",
            "verseOrgIds": [
              "2KI.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa yena watupili cheŋi yinaŋanaŋa yakisapeniyi tatayindi Hezekiya. Wanamutuŋilili Bayali tumepa, washimikili muyombu, neyicheliliyi mwanta wawaIsarela Ahabi; wafukaminini yileŋaleŋa yamwiwulu yejima hakuyipesha. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.3",
            "verseOrgIds": [
              "2KI.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watuŋili tumeŋa mwitala daYehova dateneni Yehova nindi, MuYerusalema dimu nukusha ijina dami. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.4",
            "verseOrgIds": [
              "2KI.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yileŋaleŋa yamwiwulu yejima wayituŋalili tumeŋa muyipapu yiyedi yakwitala daYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.5",
            "verseOrgIds": [
              "2KI.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wocheli mwanindi mukesi, wahoŋelaŋa natutumbwa, wasansilaŋanyisepu, wahanjikilaŋa nawakwakuzakuka akishi, nawatutepa. Welilichatama nankashi kumesu aYehova, nakumuvuloka azuwi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.6",
            "verseOrgIds": [
              "2KI.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukishiwakusoŋa wakumuyombu watupiliyi, wamushili mwitala dateneniyi Yehova kudi Davidi nikudi mwanindi Solomoni, nindi, Nukusha ijina dami hayanyaka mwitalidi, nimuYerusalema munatondi mukachi kanyuza yejima yawaIsarela.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.7",
            "verseOrgIds": [
              "2KI.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.7",
            "verseOrgIds": [
              "2KI.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindi, Neyi akusha muchima wakwila mwejima munayilejeli, mwejima mwaya nshimbi jayilejeliyi kambuŋami Mosi, hinukuyipwapwishacheŋi aIsarela mwituŋa dinayinkeli ankakulula jawuku. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.8",
            "verseOrgIds": [
              "2KI.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa wena kutiya kwawu nehi. Manase wayiluwishili, mwaka eli chatama chakubadika nyuza yajilumwiniyi Yehova kumesu awanyana kaIsarela.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.9",
            "verseOrgIds": [
              "2KI.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.9",
            "verseOrgIds": [
              "2KI.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova hakuhosha kutunwa twawambuŋindi atuprofwetu, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.10",
            "verseOrgIds": [
              "2KI.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Muloŋa mwanta wawaYuda Manase neli dehi yumiyi yakushimana, neli dehi chatama chakubadika mwejima mwakoŋeluwu aAmori ásambilili, navulumwishi dehi aYuda nawa nawakishi indi akutupa; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.11",
            "verseOrgIds": [
              "2KI.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "dichi Yehova, Nzambi yaIsarela, nahoshi nindi, Tiya, ami nukuletela Yerusalema nawaYuda katama, kakwila yowu wakachitiya matu indi onsu ayedi akashoma.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.12",
            "verseOrgIds": [
              "2KI.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.12",
            "verseOrgIds": [
              "2KI.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha Yerusalema nukutanjikahu mwonji wakuSamariya, nukuweseka nalevo yakwitala daAhabi. Nukukombola Yerusalema neyi chakombolapawu cheŋa, hiyakuchikombola nakuchikuvumika. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.13",
            "verseOrgIds": [
              "2KI.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akuwuswana wami anashaluku nukuyumba kwami, nukuyihana kudi ayilumbu jawu. Akayikwata nakuyipupa kudi ayilumbu jawu ejima. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.14",
            "verseOrgIds": [
              "2KI.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa chochafuminuwu ankakulula jawu muEjipitu kwakukopa chatama hohu kumesu ami, kwakunvuloka nizuwi hohu, nikulelu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.15",
            "verseOrgIds": [
              "2KI.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.15",
            "verseOrgIds": [
              "2KI.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manase nawa wapwekesheli mashi awantu amavulu nankashi akadinyiloŋa, wenzesheli Yerusalema to-o namashi, kufumisha kunsa yimu ndonikunsa yi kwawu; hakulunjikaku nshidi yindi yavulumwishiliyi nachuaYuda, chakoŋeliyi chatama kumesu aYehova.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.16",
            "verseOrgIds": [
              "2KI.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.16",
            "verseOrgIds": [
              "2KI.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsapu jaManase jinashaluku, niyuma yejima yeliliyi, ninshidi yindiyavulumwiniyi, hiyanajisoneki mumukanda wawanyanta awaYuda wakushindululaku? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.17",
            "verseOrgIds": [
              "2KI.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manase wakamini hamu nawankakulula jindi, amujiikili mwitempa dakwitala dindi yomweni mwitempa daUza. Mwanindi Amoni hakumuswana. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.18",
            "verseOrgIds": [
              "2KI.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatachikili kuyulayi, Amoni wadiŋi wanyaka makumi ayedi nayiyedi. Wayulili muYerusalema nyaka yiyedi. Mama yindi ijina dindi Meshulemeti, mwana kaHaruzi wakuYotiba. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.19",
            "verseOrgIds": [
              "2KI.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Welili chatama kumesu aYehova neyi cheliliyi tata yindi Manase. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.20",
            "verseOrgIds": [
              "2KI.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wendeli munjila yejima yendeli tata yindi, wapesheli akishi akutuŋa apesheliyi tata yindi, hakudifukula kudi wena. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.21",
            "verseOrgIds": [
              "2KI.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walekeli Yehova Nzambi yawankakulula jindi, hendeli cheŋi munjila yaYehovaku.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.22",
            "verseOrgIds": [
              "2KI.21.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.22",
            "verseOrgIds": [
              "2KI.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "AmbuŋaAmoni amukwatilili chikuchi, hiyakumujahila mwanta mwitala dindi yomweni. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.23",
            "verseOrgIds": [
              "2KI.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa ntu amwituŋa ajahili antu ejima amukwatililimwanta Amoni chikuchi. Antu amwituŋa hiyakuswanishamu mwanindi Yosiya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.24",
            "verseOrgIds": [
              "2KI.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsaŋu jaAmoni jinashaluku jeliliyi, hiyanajisoneki mumukanda wawanyanta awaYuda wakushindululaku? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.25",
            "verseOrgIds": [
              "2KI.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amujiikili mwŋimu dindimwitempa daUza. Mwanindi Yosiya hakumuswana.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.26",
            "verseOrgIds": [
              "2KI.21.26"
            ]
          }
        }
      ]
    }
  ],
