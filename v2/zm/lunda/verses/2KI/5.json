        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nayamani mukulumpi wanjita yamwanta wakuSiriya, amulemesheli nikumutiya kuwaha kudi mwanta windi, muloŋ diyi ahandishiliyi nachu Yehova aSiriya. Wadiŋi chilobu mukwaŋovu, ilaŋa wadiŋi mukwambumba.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.1",
            "verseOrgIds": [
              "2KI.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.1",
            "verseOrgIds": [
              "2KI.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yendu yawaSiriya chiyapalaŋeneni mwituŋa akwatili nkoli wakansiwamumbanda mwituŋa dawaIsarela. Yena wakalakeleli iŋoda Nayamani.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.2",
            "verseOrgIds": [
              "2KI.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuya, hakusenda ntalenta jasiliva ikumi, nŋishekeli jawuru makombakaji atanu nadimu, niyikovwelu yakuvwala ikumi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.5",
            "verseOrgIds": [
              "2KI.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakutwala mukandakudi mwanta wawaIsarela wakwila nindi, Neyi mukandiwu wunashiki dehi kudeyi, ilukaku neyi natumi dehi kambuŋami Nayamani kudeyi wumu ukimusoŋu windi wambumba. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.6",
            "verseOrgIds": [
              "2KI.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cheliliyi mwanta wawaIsarela nataŋi dehi mukanda, hakutabola mahinindi, nindi, Ami yami Nzambi, nelaŋa nŋihanihandisha, mwaka iwu muntu akantemesheli muntu, nindi nimúukimusoŋu windi wambumba? Talenu mwani chakukeŋayi hakuzuŋilananami.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.7",
            "verseOrgIds": [
              "2KI.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.7",
            "verseOrgIds": [
              "2KI.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cheliliyi muntu waNzambi Elisha natiyi dehi nawu, Mwanta wawaIsarela nataboli dehi mahinindi, hakutemesha mazu kudi mwanta, nindi, Wunatabwilidi mahineyi? Muleki enzi mwani kudami, akeluki nindikomana muIsarela mudi kaprofwetu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.8",
            "verseOrgIds": [
              "2KI.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nochu Nayamani hakwinzani tuwalu twindi nimakálu indi, hakwimana kuchisu chetala daElisha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.9",
            "verseOrgIds": [
              "2KI.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.12",
            "verseOrgIds": [
              "2KI.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ambuŋindi hiyakukundama kwakwihi nayena, hiyakuhosha nindi, nawu, Eyi tata, neyi kaprofwetu wakuleja kwila chuma cheneni, hiwadikuchilaku, tahindi? Winzi wumoni chanakwiliyi nindi, Welaku wutooki?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.13",
            "verseOrgIds": [
              "2KI.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.14",
            "verseOrgIds": [
              "2KI.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakufunta kudi muntu waNzambi, niyena nichendu chindi chejima, hakwinza nakwimana kumesu indi. Nindi, Ichi dinu neluki dehi mwani, komana mwahita iseki dejima himwekala Nzambuku, chiŋa muIsarela hohu. Ichi dinu atambuli mwani nkisu kudami kambuŋeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.15",
            "verseOrgIds": [
              "2KI.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena nindi, Chahandayi Yehova inemanaŋa kumesu indi kwaamu, hinukutambulachumaku. Wamukakejeli nindi, Tambulaku. Yena kwonti kwindi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.16",
            "verseOrgIds": [
              "2KI.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.19",
            "verseOrgIds": [
              "2KI.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa Gehazi, kambuŋi muntu waNzambi Elisha, welili nindi, Talenu, mwanta wami namuleki tuhu iwu kaSiriya Nayamani chakadi kutambulayuma yenzayi nayu. Chahandayi Yehova kwaamu, nukumulondela lufuchini mutambuluhu yanti. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.20",
            "verseOrgIds": [
              "2KI.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gehazi hakumulondela Nayamani. Nayamani chamweniyi muntu wudi nakumulondela lufuchi, hakusuluka mwikalu amukinkilili, nindi, Kwamwena? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.21",
            "verseOrgIds": [
              "2KI.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena nindi, Kwamwena mwani. Mwanta wami nantemeshi nindi, Tala, katatakichi kunanwani dehi anyikwenzi ayedi anyana kawatuprofwetu anafumi kwituŋa daEfweremi damapidi. Nindi, Ayinkuhu mwani, ntalenta yasiliva, niyikovwelu yakuvwala yiyedi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.22",
            "verseOrgIds": [
              "2KI.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nayamani nindi, Chachiwahi, tambula tuhu hela ntalentajiyedi. Wamukakejeli, hakumukasila ntalenta jasiliva jiyedi munjeki jiyedi, niyikovwelu yakuvwala yiyedi, hakuyitwika ambuŋindi ayedi, hiya kutwamina kunaku musendela. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.23",
            "verseOrgIds": [
              "2KI.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chashikiliyi kumpidi, hakutambula yumoyukuma kasawu, hakuyisha mwitala, hakuyifuntisha amayala, hiyakuya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.24",
            "verseOrgIds": [
              "2KI.5.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.24",
            "verseOrgIds": [
              "2KI.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwijila nakwimana kudi mwanta windi. Elisha hakumwila nindi, Eyi Gehazi, wayahi? Yena nindi, Ami kambuŋeyi hinaya kuyumaku.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.25",
            "verseOrgIds": [
              "2KI.5.25"
            ]
          }
        }
      ]
    }
