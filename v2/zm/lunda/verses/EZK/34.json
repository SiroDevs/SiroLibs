            "number": "30",
            "style": "v",
            "sid": "EZK 34:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akeluka nawu ami Yehova Nzambi yawu nidi nawu, niwena akwamutaŋa waIsarela hiyantu ami. Dimu mwanahoshiyi Mwanta Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.30",
            "verseOrgIds": [
              "EZK.34.30"
            ]
          }
        },
        {
