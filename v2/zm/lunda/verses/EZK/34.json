          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakayimeneshela mutondu watiyakana mpuhu, hiyakanoŋa nawa cheŋi nanzala mwituŋaku, hiyakayikoolesha nawa cheŋi nsonyi kudi nyuzaku. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.29",
            "verseOrgIds": [
              "EZK.34.29"
            ]
          }
        },
        {
          "name": "verse",
