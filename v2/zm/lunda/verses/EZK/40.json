              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanzi yachisu chamukachi hadiŋi matala awakwakwimba tumina, muchipaŋu chamukachi chadiŋi kumbadi yachisu chakukabeta kakuchimunswa. Matalowu atala kukabeta kakuchidiilu. Kumbadi yachisu chakumusela kwadiŋi dimu datala kukabeta kakuchimunswa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.44",
            "verseOrgIds": [
              "EZK.40.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
