          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuŋila nindi, Idi itala datala kukabeta kakuchidiilu, dawatupristu akwakuhemba lushiiku lwakwitala. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.45",
            "verseOrgIds": [
              "EZK.40.45"
            ]
          }
