            }
          ]
        },
        {
          "text": "Hakuntwala kuchisu chakukabeta kakuchimunswa. Hakweseka mwomwesekeliyi yikwawu; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.35",
