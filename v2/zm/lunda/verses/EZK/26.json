    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwaka wekumi nakamu, mwifuku dakakweji damuchimu, izu daYehova denjili kudami, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.1",
            "verseOrgIds": [
              "EZK.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Eyi mwana kamuntu, Tira chanamwiliyi Yerusalema nindi, Lelo! wadiŋi chenzelu chanyuza yawantu nakotoki dehi, nabalumuki dehi nakutala kudami, ichi chanamubalumunuwu dehi ekali mahembi, ami akaŋinzesha to-o. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.2",
            "verseOrgIds": [
              "EZK.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Mwanta Yehova nindi, Eyi Tira tiya, ami nidi neyi nandombu, nakakuzemwina nyuza yayivulu, neyi chazemunaŋayi kaluŋalwiji mankandindi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.3",
            "verseOrgIds": [
              "EZK.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akakisaŋana mpwembu jaTira, akahumona tuposhi twindi. Nilunkuŋu lwindi lwalweni nakalukoolahu, hakashali kwelola damukunkulwayi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.4",
            "verseOrgIds": [
              "EZK.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakekala hawanyikilu wamawanda hakachi kakaluŋalwiji; muloŋa ami nachihoshi dehi. Dimu mwanahoshiyi Mwanta Yehova. Tira wakekala wakubuwa dehi kudi nyuza. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.5",
            "verseOrgIds": [
              "EZK.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyanindi awambanda akekala mumaha, akayijaha nampoku yakabali; akeluka nawu yami Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.6",
            "verseOrgIds": [
              "EZK.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.6",
            "verseOrgIds": [
              "EZK.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa Mwanta Yehova nindi, Tira nakamuletela mwanta wakuBabiloni Nebukaneza, mwanta wawanyanta, wakafuma kukabeta kakuchimunswa nawatuwalu, namakálu, nawakwatuwalu, nayendu yawantu, naluntu lwalweni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.7",
            "verseOrgIds": [
              "EZK.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyaneyi awambanda wakayijahila mumaha, wakakutuŋila jimpwembu, wakakudimina mukandu, wakakunyamwina nkebu kwiwulu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.8",
            "verseOrgIds": [
              "EZK.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumpwembu jeyi wakemikaku yuma yindi yakuhumona nachu mpwembu, tuposhi tweyi wakatuhumona nayizembi yindi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.9",
            "verseOrgIds": [
              "EZK.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atuwalu twindi chakaswejawu kuvula, lunkuŋu lwawu lwakakubuta wi-i. Chakeŋilayi muyisu yeyi yampwembu neyi cheŋilaŋawu antu mumukala wabalulawu dehi mpwembu, mpwembu jeyi jakatenta nalushindu lwawakwatuwalu, nilwamatemba namakálu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.10",
            "verseOrgIds": [
              "EZK.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyikwakwa yeyi yejima wakachikachikamu nakudatolamu nayikwa yatuwalu twindi. Antu eyi wakayijaha nampoku yakabali, yishimi yeyi yamalola yiwaditemba akakunduka heseki. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.11",
            "verseOrgIds": [
              "EZK.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maheteyi akayipuŋa, yuma yeyi yiwalandujolaŋa akakutambulayi. Mpwembu jeyi akajihumona, nimataleyi akutiya nichipeŋa akayikisaŋana. Maloleyi, ninyitondu yeyi, hela tuhu lunkuŋu lweyi akayijiyisha hakachi kameji. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.12",
            "verseOrgIds": [
              "EZK.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izu datumina tweyi nakadimwenesha; kuvuma kwavumaŋa tudada tweyi hikwakatiyakana nawa cheŋuku. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.13",
            "verseOrgIds": [
              "EZK.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakakubalumuna wakekali ilola damukunkulwayi; wakekala hawanyikilu wamawanda hohu, hiyakakutuŋulula nawa cheŋuku. Muloŋa ami Yehova nachihoshi dehi. Dimu mwanahoshiyi Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.14",
            "verseOrgIds": [
              "EZK.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.14",
            "verseOrgIds": [
              "EZK.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta Yehova namwili Tira, nindi, Yitutu hiyakatenta nalushindu lwakudimbuka kweyi hakabawu antu akataŋawu, hakajahawu antu mukachi keyuku? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.15",
            "verseOrgIds": [
              "EZK.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu atulamba akukaluŋalwiji ejima akafumafuma hamatandawu awanta, akatenteka mahinawu akuluka kumbadi, akavuulavuula yuma yawu yakuvwala yamahina akusowasowa. Akavwala kuzaala. Akashakama heseki, akazaala mwaana wejima, akakuhayama. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.16",
            "verseOrgIds": [
              "EZK.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akakwimbila mukeŋa, akakwila nawu, Eyi mukala washakaminaŋa akwakwenda hakaluŋalwiji, mukala watiyakeni mpuhu, wadiŋi naŋovu kukaluŋalwiji, niyena niantu ashakaminaŋamu, wafwishilaŋa mutentu antu ejima ashakaminaŋamu, o chiwunakisiki! ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.17",
            "verseOrgIds": [
              "EZK.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi dinu ifuku diwakaholoka, yitutu yakazaala, eŋa, chiwakafuma, yitutu yamukaluŋalwiji yakakwata chikasa kukanwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.18",
            "verseOrgIds": [
              "EZK.26.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.18",
            "verseOrgIds": [
              "EZK.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa Mwanta Nzambi nindi, Chinakakubalumuna wikali mukala wamahembi hohu neyi nyikala yabula kushakama antu; chinakakukumpwila inyiŋi, chakakubutawu nachimeji chachivulu, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.19",
            "verseOrgIds": [
              "EZK.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "nakakukunkumwisha hamu nawantu akakunkumuka muwina kudi antu akushankulu, akakushakamisha mumashina amaseki, mwela dehi mahembi akufumisha kunyaka, hamu nawantu akakunkumuka muwina, kulonda antu akabuli kushakama cheŋi mudeyi; ami nakasha lubanji mwituŋa dawamomi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.20",
            "verseOrgIds": [
              "EZK.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakakubalumuna wikali wakufwaŋa mutentu kudi akwenu, hiwakekalaku nawa cheŋuku, hela akakukeŋakeŋa hiyakakumona nawa cheŋuku haya nyaka. Dimu mwanahoshiyi Mwanta Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.21",
            "verseOrgIds": [
              "EZK.26.21"
            ]
          }
        }
      ]
    }
