          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.32",
            "verseOrgIds": [
              "EZK.27.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EZK 27:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuma yeyi yakulanda chiyafuminaŋa namutuluŋalwiji, wekutishilaŋa nyuza yawantu yayivulu; waheteshelaŋa anyanta ahamaseki namaheteyi alumbamini, nayuma yeyi yakulandujola. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.33",
            "verseOrgIds": [
              "EZK.27.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EZK 27:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiwakotokeli natuluŋalwiji mumanyiŋi achimeji, yuma yeyi yakulandujola nichendu cheyi chejima chakulukilili mukachi keyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.34",
            "verseOrgIds": [
              "EZK.27.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EZK 27:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwakushakama kuyitutu ejima anakuhayami, anyanta jawu anatiyi woma nankashi, anadihombi nikumesu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.35",
            "verseOrgIds": [
              "EZK.27.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EZK 27:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwakulandujola adi mukachi kanyuza yawantu hiyakukuyiŋila. Wunekali dehi wakufwaŋa mutentu kudi akwenu, hiwakekalaku nawa cheŋuku haya nyaka.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.36",
            "verseOrgIds": [
              "EZK.27.36"
            ]
          }
        }
