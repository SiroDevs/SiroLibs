        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izu daYehova denjili cheŋi kudami, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.1",
            "verseOrgIds": [
              "EZK.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Eyi mwana kamuntu, mwimbili Tira mukeŋa, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.2",
            "verseOrgIds": [
              "EZK.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "wumwili Tira neyi, Eyi washakamaŋa kuwiŋililu wakukaluŋalwiji, eyi mukwakulandujola wanyuza yayivulu, walandujolaŋa kuyitutu yayivulu, Mwanta Yehova nindi, Eyi Tira, wuneli neyi, Ami nikweti lubanji lwawanina chikupu, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.3",
            "verseOrgIds": [
              "EZK.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋinza jeyi jidi mukachi katuluŋalwiji, akwakukutuŋa anawanishi lubanji lweyi chikupu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.4",
            "verseOrgIds": [
              "EZK.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maŋalangeyi anasoŋuwu anyinjunŋa yafumini kuSeniri. Anatambuli nyisida kuLebanoni kulonda kukusoŋela nyitondu yakukudika mahina akwendesha nachu maatu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.5",
            "verseOrgIds": [
              "EZK.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yilapu yeyi anasoŋi yanyikula yakuBashani, nyitondu yeyi yakushakama yakutuŋa nambiŋa yanjamba yakufuma kuKitimi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.6",
            "verseOrgIds": [
              "EZK.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihina deyi dakwendesha nachu watu hiihina dadiwahi dakusowasowa namahina akuEjipitu, kulonda diikali neyi mpandelu yeyi; hawatu wabutiluhu mahina awuzeeli nawusombu akufuma kuyitutu yakuElisha. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.7",
            "verseOrgIds": [
              "EZK.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashakama kuZidoni nakuArivadi diwu adiŋi akwakukuvuwila; eyi Tira akwamaana adiŋi mudeyi, diwu adiŋi akwakwendesha maatu eyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.8",
            "verseOrgIds": [
              "EZK.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akulumpi akuGebali nawakwamaana adiŋuku adiŋi mudeyi, diwu adiŋi akwakuji kajika munyaji yamaatu eyi. Maatu ejima amukaluŋalwiji nawakwakukala kalamu adiŋi mudeyi nakuhimpahimpa yuma yeyi yakulandujola.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.9",
            "verseOrgIds": [
              "EZK.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.9",
            "verseOrgIds": [
              "EZK.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "APeresi nawaLudi nawaPuti adiŋi muchendu cheyi chanjita, diwu akwakukwasila majita, akudikilaŋa nkebu nimateŋa ayikuŋu mudeyi; amwekesheli wukeleŋi weyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.10",
            "verseOrgIds": [
              "EZK.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu akuArivadi adiŋi hamu nachendu cheyi chanjita hampwembu jeyi kwi-ndo, namutuposhi tweyi mwadiŋi aGamadi. Akudikilaŋa nkebu jawu kumpwembu jeyi kwi-ndo, diwu anawanishi lubanji lweyi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.11",
            "verseOrgIds": [
              "EZK.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.11",
            "verseOrgIds": [
              "EZK.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tarashishi wadiŋi nlandishi yeyi muloŋa wamaheta kuvula, maheta anyitundu yejima; alandilaŋa yuma yeyi nasiliva, nayikuŋu, nawufoyu, nansumbu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.12",
            "verseOrgIds": [
              "EZK.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yavani, naTubali, naMesheki, diwu adiŋi akwakulandalanda naneyi. Alandishilaŋa anduŋu niyuma yawuneŋu nayuma yeyi yakulandujola. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.13",
            "verseOrgIds": [
              "EZK.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwamutaŋa waTogoma akulandishili tuwalu, nituwalu twanjita, niyingonŋavalu nayuma yeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.14",
            "verseOrgIds": [
              "EZK.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu akuDedani adiŋi akwakulandalanda naneyi. Yitutu yayivulu yadiŋi soku yakuchikasa cheyi. Akuletelelaŋa mbiŋa janjamba namaŋalanŋa atupwipu ahimpina yuma yeyi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.15",
            "verseOrgIds": [
              "EZK.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.15",
            "verseOrgIds": [
              "EZK.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siriya wadiŋi nlandishi yeyi muloŋa wyuma yeyi yawukalawenu yalumbamini. Hiyakulanda yuma yeyi nama emeraladi, nawusombu, namahina akusowasowa, namahina asweja kutooka, nakorali, namarubi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.16",
            "verseOrgIds": [
              "EZK.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda netuŋa daIsarela adiŋi akwakulandalanda naneyi, alandishilaŋa tidiku yakuMiniti, niŋanaŋi, niwuchi, nimanji, niyitumbu, nayuma yeyi yakulandujola. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.17",
            "verseOrgIds": [
              "EZK.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Damakasa wadiŋi nlandishi yeyi kulonda atambulaŋa yuma yeyi yawukalawenu yalumbamini, muloŋa wamaheta kuvula, maheta anyitundu yejima, hamu navinyu yakuHeliboni, nawanda wanyikoku wutooka. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.18",
            "verseOrgIds": [
              "EZK.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vedani naYavani akulandishilaŋa wanda wakushinta nayuma yeyi; niyikuŋu yalezumuka, nikasiya, ninyisachi yevumba dadiwahi, yadiŋi muyuma yeyi yakulandujola. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.19",
            "verseOrgIds": [
              "EZK.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dedani wadiŋi mukwakulandalanda naneyi mahina alema wuseya akwenda nachu hatuwalu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.20",
            "verseOrgIds": [
              "EZK.27.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.20",
            "verseOrgIds": [
              "EZK.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arabiya nawatulamba akuKedari ejima adiŋi anlandishi akuchikasa cheyi; yuma yakulandishilaŋawu, nyana kanyikoku, niyizamba yanyikoku, nimpembi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.21",
            "verseOrgIds": [
              "EZK.27.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwakulandalanda akuSheba nakuRama diwu adiŋi anlandishi jeyi; alandilaŋa yuma yeyi nanyiseki yejima yabadika, natumalola twasweja kulema twejima, niwuru. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.22",
            "verseOrgIds": [
              "EZK.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harana naKane naEdeni, wowu akwakulandalanda akuSheba, nakuAshuri, nakuKilimadi, adiŋi akwakulandalanda naneyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.23",
            "verseOrgIds": [
              "EZK.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Diwu adiŋi akwakulandalanda naneyi yuma yasweja kuwaha, makuŋa amahina awuzeeli akusowasowa, niyikasha yamahina awanheti, yakukasa chachiwahi nanyonji yambalawanda yakushinta, yakutuŋa nanyisida, yadiŋi muyuma yeyi yakulandujola.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.24",
            "verseOrgIds": [
              "EZK.27.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.24",
            "verseOrgIds": [
              "EZK.27.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 27:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maatu amaneni akuTarashishi diwu akusendelelaŋa yuma yeyi yakulandujola. Hiwukwinzala mbe, hiwukusweja nikulema mukachi katu-luŋalwiji. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.25",
            "verseOrgIds": [
              "EZK.27.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwakukuvuwa anakushikija muchimeji chachivulu. Mpepela yakumusela yinakukotoli mukachi katuluŋalwiji.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.26",
            "verseOrgIds": [
              "EZK.27.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.26",
            "verseOrgIds": [
              "EZK.27.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimaheteyi, niyuma yeyi, niyuma yeyi yakulandujola, niantu akalakalaŋa mudeyi, niakwakukwendesha, niakwakujikajika munyaji yeyi, niakwakukuhimpila yuma yeyi yakulandujola, niantu eyi anjita ejima adi mudeyi, hamu nachendu cheyi chejima chidi mukachi keyi, akaholokela mukachi katuluŋalwiji mwifuku diwakakuluka.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.27",
            "verseOrgIds": [
              "EZK.27.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.27",
            "verseOrgIds": [
              "EZK.27.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 27:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mŋata jeyi jidi kunsa yamukala jakatenta nanyiteti yawakwakukwendesha. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.28",
            "verseOrgIds": [
              "EZK.27.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu akwatilaŋa kuyilapu ejima, niakwakukalakala mumaatu, niakwakwendesha maatu hakaluŋalwiji ejima, akasuloka mumaatu awu, akemana heseki, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.29",
            "verseOrgIds": [
              "EZK.27.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 27:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "akatiya kesha mazu awu hadeyi, akadila chalula, akadisukwila maseki hanyitu yawu, akadikumbakumba mumawuti, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.30",
            "verseOrgIds": [
              "EZK.27.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 27:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "akakutewila tuwewa, akavwala yikeleyi, akakudila nanyichima yinatiyi kulula makumbu aweni alula. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.31",
            "verseOrgIds": [
              "EZK.27.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 27:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumakumbu awu akakwimbila mukeŋa, mukeŋa wakukwila nawu, Hinyi wudi neyi Tira amweneshawu dehi zo-o mukachi kakaluŋalwiji?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.32",
            "verseOrgIds": [
              "EZK.27.32"
            ]
          }
        }
      ]
    },
    {
