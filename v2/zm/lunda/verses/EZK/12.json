          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.25",
            "verseOrgIds": [
              "EZK.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izu daYehova denjili kudami cheŋi nawa, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.26",
            "verseOrgIds": [
              "EZK.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Eyi mwana kamuntu, tiya, antu akumutaŋa waIsarela nawu, Chimwenu chanamoniyi muchidi mafuku amavulu, wudi nakuprofweta nsaŋu janyaka yichidi kwakulehi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.27",
            "verseOrgIds": [
              "EZK.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi kayili neyi, Mwanta Yehova nindi, Kwosi mazu ami akalaba nawa chepuku, izu dinakahosha dakakopewa. Dimu mwanahoshiyi Mwanta Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.28",
            "verseOrgIds": [
              "EZK.12.28"
            ]
          }
        }
      ]
    }
