          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.20",
            "verseOrgIds": [
              "EZK.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izu daYehova denjili kudami, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.21",
            "verseOrgIds": [
              "EZK.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Eyi mwana kamuntu, ichi chishimu chimukweti mwituŋa daIsarela, chakwila nawu, Mafuku anasweji dehi kuvula, niyimwenu yejima muyatwala kumwekana nehi, hichishimwinyi? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.22",
            "verseOrgIds": [
              "EZK.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi kayileji neyi, Mwanta Yehova nindi, Chishimu ichi nakachifumishamu, hiyakachita nawa cheŋi muIsarelaku. Ilaŋa kayili neyi, Mafuku ashika dehi, nimwatwala yimwenu yejima. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.23",
            "verseOrgIds": [
              "EZK.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa hikwakekala nawa cheŋi chimwenu chamukunkulwayi, hela kuhoŋa kwakulambisha nachu muntu chakutwamba mumutaŋa waIsarelaku. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.24",
            "verseOrgIds": [
              "EZK.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa yami Yehova nukuhosha, niizu dinukuhosha dakakoŋewa. Muloŋa enu akwamutaŋa wadikaŋa, mumafuku enu nukuhosha izu, nikukoŋa nukudikoŋa. Dimu mwanahoshiyi Mwanta Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.25",
            "verseOrgIds": [
              "EZK.12.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
