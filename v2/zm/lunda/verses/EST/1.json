  "copyright": "PUBLIC DOMAIN",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "EST 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamafuku adiŋiyi Ahasuwenausi, yowu Ahasuwenausi wayulilaŋamawuloŋu nkulakaii namakumi ayedi natanu nayedi, akufumishakulndiya nakushika kuEtiyopiya, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.1",
            "verseOrgIds": [
              "EST.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "hawena mafuku owu, chashakaminiyi mwanta Ahasuwenausi hetanda dawanta windi dadipi mupanda muShushani, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.2",
            "verseOrgIds": [
              "EST.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "mumwaka wayuliliyi wamuchisatu, hakuyitelekela atulamba twindi ejima, niambuŋindi ejima chawija; alema niamuPeresi, niamuMediya, wowuayilolu nawatulamba amumawuloŋu apompeli kudi yena. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.3",
            "verseOrgIds": [
              "EST.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyilejamaheta awanta windi walema, ni kulema kwakutoha kwindi kwasweja kuwaha, mafuku amavulu, kuyichinda mafuku nkulakaji namakumi atanu nasatu. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.4",
            "verseOrgIds": [
              "EST.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chamanini mafuku owu, mwanta hakutelekela antu ejima adiŋi muŋanda muShushani, nialema niakadi kulema, chawija, mafuku atanu nayedi, mwibulu dakwitempa damuchipaŋu chamwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.5",
            "verseOrgIds": [
              "EST.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akudekaku mahina atooka, niamafu amatamba, niawuzeeli, akukasa natunyonji twawandawutooka niwawusombu, akukasila kuyishimi yamalola atookanatuzeya twasiliva. Tudidi twakudiila twadiŋi twawuru nasiliva twakushakuchisesa chamalola achinana, niatooka, niawusuŋwa, nieyila bwi-i. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.6",
            "verseOrgIds": [
              "EST.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakunwa ayinkeleli mumpasa jawuru, mpasoju jadiŋi janyitundu yejina yeŋi, ayinkeli vinyu yawanta yayivulu mwomwanwishilaŋayi mwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.7",
            "verseOrgIds": [
              "EST.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anwini mwaya lushimbi, kwosi watwesheli kuyikanjikŋaku, muloŋa dimumwayilejeliyi mwanta atulala amwitala dindi ejima, nindi, Chipa antu ejima eli kwawu mwakepelawu munyichima yawu. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.8",
            "verseOrgIds": [
              "EST.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwadi Vashitayiniyena wayitelekeleli ambanda chawija, mwitala dawanta dadiŋi damwanta Ahasuwenausi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.9",
            "verseOrgIds": [
              "EST.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hefuku damu chitanu nachiyedi cheliliyi mwanta natiyi dehi kuwahanavinyu, hakutemesha niMehumani, niBizita, niHaribona, niBiŋita, niAbaŋita, niZetari, niKarikasi, wowu atulala amukalakelelaŋa mwanta Ahasuwenausi kumesu indi, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.10",
            "verseOrgIds": [
              "EST.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Yenu mwakaleti mwadi Vashitayi enzikumesu amwanta nachibaŋula chindi chawanta, kulonda amwekeshi lubanji lwindi kudi antu nawatulamba, muloŋa wadiŋi muwahi kumesu. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.11",
            "verseOrgIds": [
              "EST.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa mwadi Vashitayi kwonti kwindi kwovwahila izu damwanta datemesheliyi nawatulala twindi; dichi mwanta hakusweja kuzuwa, hakutiya nikumuchimasho-o. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.12",
            "verseOrgIds": [
              "EST.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu mwanta hakwihula akwamaana elukili nsaŋu janyakoyu, muloŋadidii chelilaŋayi mwanta nawantu ejima elukili nshimbi nawuŋaji. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.13",
            "verseOrgIds": [
              "EST.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakwihi nayena kwadiŋi aKarishena, naShetari, naAdimata, naTarashishi, naMeresi, naMarisena, naMemukani, wowu atulamba atanu nayedi amuPeresi namuMediya amumwenaŋa mwanta kumesu, adiŋi alema mwituŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.14",
            "verseOrgIds": [
              "EST.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyihula nindi, Tukumwila mwadi Vashitayi ŋahi mwayalushimbi, ichi chanabuli kwovwahilayi izu damwanta Ahasuwenausi damu temeshela wuna watulala? ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.15",
            "verseOrgIds": [
              "EST.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EST 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Memukani hakwakula kumesu amwanta nikumesuawatulamba, nindi, Mwadi Vashitayi hanatamishi mwanta hohuku, natamishi niatulamba ejima, niantu ejima ekala mumawuloŋu amwanta Ahasuwenausi ejima. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.16",
            "verseOrgIds": [
              "EST.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EST 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa chumichi chaneliyi mwadi chakatiya kana kudi ambanda ejima, chakatiyawu nawu mwanta Ahasuwenausi Watemesha antu kudi mwadi Vashitayi nindi amuleti kumesu indi, yena kwinza nehi, hiyakalemesha nawa cheŋi anfumu jawuku. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.17",
            "verseOrgIds": [
              "EST.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EST 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelu anyadi awatulamba twamuPeresi namuMediya anatiyi mwaneliyi mwadi wamwanta, akuhosha nawatulamba twamwanta ejima mwomumu, hakufuma nikusawuka nimadombu. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.18",
            "verseOrgIds": [
              "EST.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EST 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi mwanta natiyi kuwaha, kudi yena kufumi izu dawanta, adisoneki munshimbi jawaPeresi nawaMediya kulonda dibuli kuhita, dakwila nawu, Vashitayi bayi akenza cheŋi kumesu amwanta Ahasuwenausuku, mwanta enki mumbanda wacheŋi wamubadika kuwaha wumwadiwindi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.19",
            "verseOrgIds": [
              "EST.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EST 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lushimbi lwamwanta chakalutiyawu mwahita wanta windi wejima, muloŋa hiwanta weneni, ambanda ejima akalemesha anfumu jawu nialema niakadi kulema. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.20",
            "verseOrgIds": [
              "EST.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EST 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta nawatulamba atiyili izu idi kuwaha, mwanta hakwila mwahosheliyi Memukani. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.21",
            "verseOrgIds": [
              "EST.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EST 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakutemesha nyikanda mumawuloŋu amwanta ejima, yakusoneka nsona jamawuloŋu ejima, nimumadimi awantu ejima, nindi, Amayala ejima ayuli mumatalawu, akabidikishi nsaŋu iyi, mwahita madimi awantu ejima.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.22",
            "verseOrgIds": [
              "EST.1.22"
            ]
          }
        }
      ]
    }
  ],
