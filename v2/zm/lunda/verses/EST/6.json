      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wena wufuku owu tulu twamúumini mwanta mumesu chau, hakuleja antu kuleta mukanda washindululawu nsaŋu jawanta, hiya kuji taŋi lakumesu amwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.1",
            "verseOrgIds": [
              "EST.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakuwana anasoneki nawu Modekayi washimwini aBigitani naTereshi, atulala twamwanta ayedi, akweti ahembelaŋa kuchisu, akeŋeli kumujaha mwanta Ahasuwenausi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.2",
            "verseOrgIds": [
              "EST.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta hakwila nindi, Modekayi anamulemeshi hela kumutohesha mudihi nansaŋu iyi? Ambuŋa mwanta amukala kelelaŋa, hiyakumwila nawu, Hikudi chuma chamwilililuwuku. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.3",
            "verseOrgIds": [
              "EST.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta nindi, Omu mwibulu mudinyi? Herohu Hamaniwenza dehi mwibulu dakunsa dakwitala damwanta, nalondi kuhoshana mwanta amukudiki Modekayi kumutondu namuloŋesheliyi dehi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.4",
            "verseOrgIds": [
              "EST.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ambuŋa mwanta hiyakumwila nawu, Mwibulu munemani Hamani. Mwanta nindi, Eŋili. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.5",
            "verseOrgIds": [
              "EST.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamani hakwijila, mwanta hakumwila nindi, iyala anatiyiyi mwanta kuwaha kumulemesha akumwila ŋahi? Kamanihakwila mumuchima windi nindi, iyala akukeŋa kulemeshayi mwantahinyi? Hiyamuku? ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.6",
            "verseOrgIds": [
              "EST.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamani hakumwila mwanta nindi, iyala anatiyiyi mwanta kuwaha kumulemesha, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.7",
            "verseOrgIds": [
              "EST.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "amuleteli wuvwalu wawanta wavwalaŋayi mwanta, nikawalu kendelaŋayi mwanta, nichibaŋula chawanta chavwalaŋayi kunamutu windi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.8",
            "verseOrgIds": [
              "EST.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niwuvwalu, nikawalu enki kalamba kamwanta wumuwabadika kulema, amuvwiki owu iyala anatiyiyi mwanta kuwaha kumulemesha, amwendeshi hakawalu mumukwakwa wamumukala, abidiki kwakuyayinindi, Talenu mwakumwilawu iyala anatiyiyi mwanta kuwaha kumulemesha.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.9",
            "verseOrgIds": [
              "EST.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.9",
            "verseOrgIds": [
              "EST.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta hakumwila Hamani nindi, Nyakala wutambuli niwuvwalunikawalu, mwomu wunahoshi, wumwili kaYudeya Modekayi, washakamamuchisu chamwanta, choche nochu, bayi habula chuma chiwunahoshi nichimuku.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.10",
            "verseOrgIds": [
              "EST.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.10",
            "verseOrgIds": [
              "EST.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamani hakutambula niwuvwalu nikawalu, hakumuvwika Modekayi, hakumwendesha hakawalu mumukwakwa wamumukala, hakubidika kwakuyayinindi, Talenu mwakumwilawu iyala anatiyiyi mwanta kuwaha kumulemesha. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.11",
            "verseOrgIds": [
              "EST.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Modekayi hakufunta cheŋi kuchisu chamwanta, kwinza Hamani hakunyakalakuya kwitala dindi nakudila, iku nadibuti kunamutu. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.12",
            "verseOrgIds": [
              "EST.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamani hakuhitulwilamu Iŋodindi Zereshi, nawamabwambu jindi ejima, yuma yanamoniyi yejima. Antu indi akwamaana, naŋodindi Zereshi, hiyakumwilanawu, Owu Modekayi, iwunatachiki kusawukila kumesu indi, neyi hiwakudi anyana kawaYudeya, hiwakamutweshaku, chalala eyi wakasawuka kumesuindi hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.13",
            "verseOrgIds": [
              "EST.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iku achidi kuhosha nindi, atulala twamwanta enza nikwinza, hiyakumuhindisha Hamani ayi kuchawija chanaloŋeshiyi Esita.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.14",
            "verseOrgIds": [
              "EST.6.14"
            ]
          }
        }
      ]
    }
