    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Modekayi chelukiliyi mweliluwu mwejima, Modekayi hakutabulama hinindi, hakuvwala chikeleyi, hakudisukwila mawuti, hakuya mukachikamukala, hakudila ikumbu dadeni dalula. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.1",
            "verseOrgIds": [
              "EST.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakukumina kwakwihinachisu chamwanta, muloŋa kwosi muntu watweshelaŋa kwijila muchisuchamwanta iku navwali chikeleyuku. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.2",
            "verseOrgIds": [
              "EST.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumawuloŋu ejima kwejima, kwashi kili izu damwanta nilushimbi lwindi, kwadiŋi kudila kwakweni mukachi kawaYudeya, nikubula kudya, nikudila, nikutumpa, amavulu akamujokelaŋa hayikeleyi nawamuti. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.3",
            "verseOrgIds": [
              "EST.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayaŋa dima aEsita nawatulala twindi hiyakuya nakumulejamu. Mwadi hakuneŋa nankashi, hakutemesha mahina akumuvwika Modekayi, kulonda amuvúuli chikeleyi chindi; kuyitambula kwindi nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.4",
            "verseOrgIds": [
              "EST.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esita hakutambika kalala kamwanta wumu Hataki, yowu amwinkeluwu nawu amwimenaŋa, hakumuleja nindi, Yaku kudi Modekayi wutiyi nsaŋu, niniku kuyinafumi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.5",
            "verseOrgIds": [
              "EST.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hataki hakwidika hanzi, hakuya kudi Modekayi mulubanza lwamukala, lwakwakwihi nachisu chamwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.6",
            "verseOrgIds": [
              "EST.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Modekayi hakumuleja yuma yamweniyi yejima, nimwashikili mali akaniniyi Hamani kufweta muyikasha yamwanta hanyijimba yawaYudeya, kulonda ayijilumuni. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.7",
            "verseOrgIds": [
              "EST.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakumwinkani mukanda watutulwiluwu nsona jalushimbi lwakuyijilumuna, lwashimwinuwu muShushani, kulonda amulejilu Esita amushimwini mulwaya, kulonda Esita ayi kudi mwanta amulembeleli, amuleji nsaŋu yahanyiji mbayawa wusoku windi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.8",
            "verseOrgIds": [
              "EST.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hataki hakwinza nakumuleja Esita mazu aModekayi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.9",
            "verseOrgIds": [
              "EST.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esita hakuhosha cheŋi naHataki, hakumuleja izu dakutwala cheŋi kudi Modekayi, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.10",
            "verseOrgIds": [
              "EST.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Niambuŋa mwanta ejima, niantu amumawuloŋu amwanta, eluka dehi nawu muntu wukwijila mudi mwanta mwibuluda mukachi chakadi kumutambika, lushimbi lwindi luduku lumu hohu lwolwakumujaha, hela hiiyala hela himumbanda, kuhanda chiŋa mwanta amwolwela nkunyi yawuru. Dichi ami munahitili mafuku makumi asatumu, hiyanantambiki nawu niyi kudi mwantaku. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.11",
            "verseOrgIds": [
              "EST.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakumuleja Modekayi mazu aEsita. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.12",
            "verseOrgIds": [
              "EST.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Modekayi hakuyileja mazu akumufuntishila cheŋi Esita, nindi, Bayi wutoŋojoka neyi, Ami nakapulukila mwitala damwanta, kwinza akwetu aYudeya ejima diwu akafwaku. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.13",
            "verseOrgIds": [
              "EST.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyikatataka eyi wukudimwenena kweyi zo, kuhizumwisha nakupulwisha aYudeya chakafuma kwacheŋi, kwinza eyi namutaŋa watata yeyi mwakanoŋa. Kwiji chiwunenzi muwanta wunenjili nsaŋu yoyeniyi; wukuchilukahinyi? ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.14",
            "verseOrgIds": [
              "EST.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esita hakuyileja izu dakufuntishila cheŋi Modekayi, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.15",
            "verseOrgIds": [
              "EST.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EST 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Yaku wupompeshi aYudeya ekala muShushani ejima, munshakaminu kunanzala yakwila hela kudya hela kunwa nehi mafuku asatu niwufukunimwaana; ninami niayaŋadima ami twakashakama nanzala mwomumu, kulonda nakayi kudi mwanta chakumotoka nshimbi, neyi nanoŋi, nanopidehi kwami. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.16",
            "verseOrgIds": [
              "EST.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EST 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Modekayi hakuya, hakwila mwamulejeli Esita mwejima.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.17",
            "verseOrgIds": [
              "EST.4.17"
            ]
          }
        }
      ]
    }
  ],
