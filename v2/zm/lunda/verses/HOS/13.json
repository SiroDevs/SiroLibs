        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chahoshelaŋayi Efweremi nakuzaala, watiiumbakeni muIsarela; ilaŋa chatanyiniyi nansaŋu yaBayali, ofwa ni kufwa. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.1",
            "verseOrgIds": [
              "HOS.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi dinu hiyakusweja nikuvulumuna, adisuŋunwina dehi akishi asiliva yawu, wowu akishi aya mwaya maanawu awenawu, ejima hinyidimu yawukalawenu, hiyakuyila nawu, Amayala akuketwilaku yimuna diwu akupwepujola anyana kaŋombi awuru. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.2",
            "verseOrgIds": [
              "HOS.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi wena akekala neyi ivu dabudidi, neyi wuumi womaŋa swayi hohu, neyi muzuŋu walelokaŋa kuwuhulilu nachinjimbi, neyi wishi wafumaŋa mumunkinyi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.3",
            "verseOrgIds": [
              "HOS.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.3",
            "verseOrgIds": [
              "HOS.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami saŋa nekalila Yehova Nzambi yeyi wakufuma kwitaŋa daEjipitu; bayi wakeluka nzambi wacheŋuku, chiŋa yami hohu; hikudi chamwinu wacheŋuku, chiŋa yami hohu kanka wami. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.4",
            "verseOrgIds": [
              "HOS.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yami nayilukili mwisaŋa, mwitaŋa dasweja yaaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.5",
            "verseOrgIds": [
              "HOS.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chadiiluwu ekuta nikwikuta, nimavumu mbe, atwala ninyichima yawu kwiwulu; dichi chananvulamenuwu ami. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.6",
            "verseOrgIds": [
              "HOS.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi ami anmona nekala neyi mutupa; nakayibelamina kunjila neyi chisumpa; ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.7",
            "verseOrgIds": [
              "HOS.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "nakayibulakana neyi bera anajahiluwu anyanindi, nakayibalula hakapaamba kamuchima; kwenoku nakayivwota neyi mutupa; akayitabola kudi kanyama wamwisaŋa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.8",
            "verseOrgIds": [
              "HOS.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.8",
            "verseOrgIds": [
              "HOS.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi Isarela, ochu chiwunamoni kukisika, chinafumi hakudikaŋa nami nkwashi yeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.9",
            "verseOrgIds": [
              "HOS.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi dinu mwanta wenu wudi kudihi kulonda ayamwini munyikala yenu yejima? Niansompeshi jenu imwelili nenu, Twinkenu nimwanta niatulamba; adi kudihi? ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.10",
            "verseOrgIds": [
              "HOS.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinazuwili nayinkeli mwanta, chinatiyili jandombu namufumishiluku. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.11",
            "verseOrgIds": [
              "HOS.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HOS 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anakasi kuluwa kwaEfwenae-mi; anatudiki nshidi yindi. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.12",
            "verseOrgIds": [
              "HOS.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HOS 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyisoŋu yamonaŋa mumbanda wudi nakuvwala yakamuwana. Himwana weyala wakadi maana; muloŋa hatelela kuvwalika, yena kushikila hakuvwalika mwivumu nehi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.13",
            "verseOrgIds": [
              "HOS.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HOS 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.13",
            "verseOrgIds": [
              "HOS.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HOS 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami nakayikuula kuŊovu yejamu; nakayikuula kukufwa. Eyi kufwa, nyisoŋu yeyi yidihi? Eyi ŋamu, kukisaŋana kweyi kudihi? Kubalumuka mumuchima kwakajindewa kumesu ami.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.14",
            "verseOrgIds": [
              "HOS.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HOS 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.14",
            "verseOrgIds": [
              "HOS.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HOS 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela wakasemununa mukachi kawana kwindi, kwakenza mpepela yakumusela; yoyi mpepela yaYehova yakafuma kwisaŋa, nikasulu kindi kakoma chau, nikaseloki kindi kakoma chikupu; yakakisaŋana mwaswekaŋayi yuma yindi yayiwahi yejima. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.15",
            "verseOrgIds": [
              "HOS.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HOS 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samariya kutanya kwindi wakakukoola; muloŋa yena wadikaŋili naNzambi yindi. Akadimbuka kumpoku yakabali; anyanawu akayichika puchi puchi; ambandawu adi namavumu akayibuza.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.16",
            "verseOrgIds": [
              "HOS.13.16"
            ]
          }
        }
      ]
    }
  ],
