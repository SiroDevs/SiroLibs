            "style": "v",
            "sid": "HOS 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.14",
            "verseOrgIds": [
              "HOS.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HOS 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakaya, nakafunta kunadiŋi, nichamba ketŋiawu muloŋa wawu, nichamba kakeŋakeŋawu mesu ami. Mumakabi awu akadanuka nakunkeŋakeŋa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.15",
            "verseOrgIds": [
              "HOS.5.15"
            ]
          }
        }
      ]
