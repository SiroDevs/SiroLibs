        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2TI 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakuleji kumesu aNzambi ni kumesu aKristu Yesu, wakasompesha amomi niafu, nanochu chakamwekanayi nawanta windi, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.1",
            "verseOrgIds": [
              "2TI.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TI 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nami, shimunaku mazu nihanawahi nihanabuli kuwaha, kumina dakushimuna ho-o; konkololaku, hosholaku, konkomwenaku, nakudiwunjika nawu nikuyileja. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.2",
            "verseOrgIds": [
              "2TI.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2TI 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa mwaka wamba kenza akaleka kutiyilila kuleja kwalala; akaheta matu owaŋa, akadivulishila ankuluŋaŋa aya mwaya kufwila kwawu kwatama; ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.3",
            "verseOrgIds": [
              "2TI.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TI 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "akatotomona nsaŋu yalala kumatu awu, akasenukila kutuheka. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.4",
            "verseOrgIds": [
              "2TI.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TI 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa eyi ikalaku wababala muyuma yejima. Kumina dakumona kukala; ilaku mudimu wakushimuna nsaŋu yayiwahi; kalakalaku mudimu weyi wumanishi chikupu.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.5",
            "verseOrgIds": [
              "2TI.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TI 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.5",
            "verseOrgIds": [
              "2TI.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2TI 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami keŋa antwali niikali himulambu wakuhuŋununa; mpinji yami yakuya yinashi ki dehi. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.6",
            "verseOrgIds": [
              "2TI.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TI 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nalwi njita yayiwahi; namanishi njila yakutemukila; nahembi kwitiya kwakukuhwelela. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.7",
            "verseOrgIds": [
              "2TI.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2TI 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kufumisha kulelu anantentekeli chibaaba chakuloŋa, chakanyinkayi Mwanta, mukwakusompesha waloŋa, hefuku odu. Hakanyinkami hohuku, wakenka niantu ejima akeŋa kumwekana kwindi.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.8",
            "verseOrgIds": [
              "2TI.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2TI 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.8",
            "verseOrgIds": [
              "2TI.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2TI 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esekaku kwinza swayi kudami; ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.9",
            "verseOrgIds": [
              "2TI.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2TI 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "muloŋa Demasi nanshiyi dehi, nakeŋi yamakonu, nayi dehi kuTesalonika. Kereseni nayi dehi kuŋalŋa, Titusa nayi kuDalamatiya. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.10",
            "verseOrgIds": [
              "2TI.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2TI 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nidi naLuka hohu. Inzaku naMaku muloŋa wankwashaŋa kumudimu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.11",
            "verseOrgIds": [
              "2TI.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2TI 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tikikusa namutemeshi kuEfwesesa. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.12",
            "verseOrgIds": [
              "2TI.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2TI 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiwukwinza wusendaŋa kahuma kinashiyili kudi Karapu kuTirowasi, ninyikanda, nakeŋi nankashi yayitembi. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.13",
            "verseOrgIds": [
              "2TI.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2TI 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muchi wansumbu Alesanderi, wankoŋeli chatama nankashi, Mwanta wakamulubwila yashika munyidimu yindi. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.14",
            "verseOrgIds": [
              "2TI.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TI 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi nawa mubabeli, muloŋa waswejeli kudikaŋa namazu etu.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.15",
            "verseOrgIds": [
              "2TI.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2TI 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.18",
            "verseOrgIds": [
              "2TI.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2TI 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋimwishili aPirisila naAkwila niakwetala daOnesifwolu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.19",
            "verseOrgIds": [
              "2TI.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2TI 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erasitusi washeli kuKorinda; Tirofwimusa namushiyili kuMiletusa nayikatu.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.20",
            "verseOrgIds": [
              "2TI.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2TI 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.20",
            "verseOrgIds": [
              "2TI.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2TI 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esekaku kwinza aha hakwila mashika kanda enzi. Ebulusa, niPudensa, niLinusa, niKaludiya niana kwetu ejima anakwimwishi.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.21",
            "verseOrgIds": [
              "2TI.4.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2TI 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.21",
            "verseOrgIds": [
              "2TI.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2TI 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta ekali naspiritu yeyi. Luwi lwikali nanenu.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.22",
            "verseOrgIds": [
              "2TI.4.22"
            ]
          }
        }
      ]
    }
