  "verseCount": 53,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "1KI 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "ASiriya nawaIsarela ashakamini nyaka yisatu chakubula kudasanjita. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.1",
            "verseOrgIds": [
              "1KI.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwaka wamuchisatu mwanta wawaYuda Yehoshafwati wayili kudi mwanta wawaIsarela. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.2",
            "verseOrgIds": [
              "1KI.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wawaIsarela wayilili ambuŋindi, nindi, Enu mweluka dehi Ramoti Gileyadi wetu, etu tushakami tuhu kuwutambulakudi mwanta wakuSiriya nehi? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.3",
            "verseOrgIds": [
              "1KI.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakumwila Yehoshafwati nindi, Tukuya neyi kunjita kuRamoti Gileyadi, tahindi? Yehoshafwati hakumwila mwanta wawaIsarela, nindi, Ami niweyi, antu ami hiyantu eyi, tuwalu twamihituwalu tweyi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.4",
            "verseOrgIds": [
              "1KI.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.4",
            "verseOrgIds": [
              "1KI.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoshafwati hakumwila mwanta wawaIsarela, nindi, Ehuli mwani, izu daYehova lelu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.5",
            "verseOrgIds": [
              "1KI.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wawaIsarela hakupompesha atuprofwetu, amayala makulakaji awana, hakuyiihula nindi, Niyi nakudasa njita naRamoti Gileyadi, tahindi nileki? Nawu, Yaku; Yehova wakawuhana kudi mwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.6",
            "verseOrgIds": [
              "1KI.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoshafwati nindi, Kunu hikudi nikaprofwetu kaYehovaku, kulondatu mwihuli tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.7",
            "verseOrgIds": [
              "1KI.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wawaIsarela hakumwila Yehoshafwati nindi, Kwashala muntu wumu kutukumwihwila Yehova, mwana kami laMikaya. Hinamukeŋa kwamuku; muloŋa hamprofwete lapa yayiwahuku, chiŋa yatama hohu. Yehoshafwati nindi, Mwanta bayi ahosha ochuku. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.8",
            "verseOrgIds": [
              "1KI.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wawaIsarela hakutambika kalala, nindi, Yaku swayi wakaletimwana kaImila Mikaya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.9",
            "verseOrgIds": [
              "1KI.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.9",
            "verseOrgIds": [
              "1KI.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wawaIsarela nimwanta wawaYuda Yehoshafwati adiŋi ashakama iwu hetanda dindi dawanta, iwu hetanda dindi dawanta, anavwali mahinawu, kulubanza lwakuwiŋililu wakuchisu champwembu yaSamariya; atuprofwetu ejima adiŋi nakuprofweta kumesu awu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.10",
            "verseOrgIds": [
              "1KI.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana kaKenaya naZedekiya welili nsepu jindi jachikuŋu, nindi, Yehova nahoshi nindi, Jenŋi diji wakashinjika nachu aSiriya, nichakano ŋawu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.11",
            "verseOrgIds": [
              "1KI.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atuprofwetu ejima hiyakuprofweta mwomumu, nawu, Yaku kuRamoti Gileyadi, wakamonakuwaha; Yehova wakawuhana kudi mwanta.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.12",
            "verseOrgIds": [
              "1KI.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.12",
            "verseOrgIds": [
              "1KI.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntemesha wayili nakutambika Mikaya hakumwila nindi, Tiya mwani, atuprofwetu adi nakumushimwina mwanta yayiwahi, izu dawu dodimuhohu. Niizu deyi mwani diikali neyi dawu, wuhoshaŋa yayiwahi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.13",
            "verseOrgIds": [
              "1KI.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikayanindi, Chahandayi Yehova kwaamu, mwakuŋilayi Yehova dimu munukuhosha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.14",
            "verseOrgIds": [
              "1KI.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.14",
            "verseOrgIds": [
              "1KI.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chenjiliyi kudi mwanta, mwanta hakumwila nindi, Eyi Mikaya, tuyinakudasa njita kuRamoti Gileyadi, tahindi tuleki? Nindi, Yaku, wakamonakuwaha; Yehova wakuwuhana kudi mwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.15",
            "verseOrgIds": [
              "1KI.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta hakumwila nindi, Kaŋahi kinukukukumika nami chiŋa wuhoshaŋa kudami yalala hohumwijina daYehova? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.16",
            "verseOrgIds": [
              "1KI.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindi, Namona aIsarela ejima anaŋalaŋani hamapidineyi nyikoku yinabuli kabiŋa. Yehova hakwila nindi, Awa hiyakwetinkaka yawuku; afunti kwawu kumatalawu wejima wawu chamwena. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.17",
            "verseOrgIds": [
              "1KI.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wawaIsarela hakumwila Yehoshafwati, nindi, Hidimu nakulejanami hakamprofwetela yayiwahuku chipa yoyatama hohuku?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.18",
            "verseOrgIds": [
              "1KI.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.18",
            "verseOrgIds": [
              "1KI.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikaya nindi, Dichi dinu tiya izu daYehova. Namumona Yehova nashakami hetanda dindi dawanta, izaza dejima damwiwulu dincmani kudiyena, nikuchikasa chindi chachidiilu, nikuchikasa chindi chachimunswa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.19",
            "verseOrgIds": [
              "1KI.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova hakwila nindi, Hinyi wukumudimba Ahabi kulonda akayi nakudimbukila kuRamoti Gileyadi? Iwu hakuhoshimu, iwu hakuhoshimu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.20",
            "verseOrgIds": [
              "1KI.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hikukwinza kaspiritu, hakwimana kumesu aYehova, nindi, Yami nukumudimba. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.21",
            "verseOrgIds": [
              "1KI.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova hakumwila nindi, Nanka? Yena nindi, Nukufumakunu, nukuya nakwikala spiritu wakutwamba namutunwa twawatuprofwetu twindi ejima. Nindi, Wakamudimba, wakemika mushindu nawa. Yaŋa kweyi wakeli mwenomu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.22",
            "verseOrgIds": [
              "1KI.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi dinu tiya, Yehova nashi dehi spiritu wakutwamba namutunwa twanawa atuprofwetu tweyi ejima. Yehova nakuteneni dehi yatama.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.23",
            "verseOrgIds": [
              "1KI.22.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.23",
            "verseOrgIds": [
              "1KI.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana kaKenayana Zedekiya hakwinza kwakwihi, hakumweta Mikayahekidi, nindi, Spiritu yaYehova waya njila yidihi hafumayi kudami enzinakuhosha naneyi? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.24",
            "verseOrgIds": [
              "1KI.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikaya nindi, Tiya, wakachimona ifuku diwakepila nakubatama mukapeka kamukachi ketala. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.25",
            "verseOrgIds": [
              "1KI.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wawaIsarela nindi, Mutwali Mikaya, wakamufuntishi kudi mukulumpi wamukala Amoni, namwana kamwanta Yowasha; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.26",
            "verseOrgIds": [
              "1KI.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakeli neyi, Mwanta nahoshi nindi, Yeniwu mushenu mukaleya, mwakamudiishi yakudya yekabisha, nimeji ekabisha nichinakenza cheŋi chamwena. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.27",
            "verseOrgIds": [
              "1KI.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikaya nindi, Neyi wakamonajakufunta chamwena, komana Yehova hanahosheli kukanwa kamuku. Nindi, Enu antu wejima wenu tiyenu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.28",
            "verseOrgIds": [
              "1KI.22.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.28",
            "verseOrgIds": [
              "1KI.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Woho, mwanta wawaIsarela, nimwanta wawaYuda Yehoshafwati, hiyakuya kuRamoti Gileyadi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.29",
            "verseOrgIds": [
              "1KI.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wawaIsarela hakumwila Yehoshafwati, nindi, Nukudifwikŋa neyi nimuntu wacheŋi, niiŋili kunjita, ilaŋa eyiwuvwali mahineyi. Mwanta wawaIsarela hakudifwikŋa neyi muntuwacheŋi, hakwijila nikunjita.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.30",
            "verseOrgIds": [
              "1KI.22.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.30",
            "verseOrgIds": [
              "1KI.22.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu mwanta wakuSiriya waleja dehi awakulumpi amakálu indimakumi asatu nawawakulumpi ayedi, nindi, Eayi mulwa namunyanya helanamunenuku, chiŋa namwanta wawaIsarela hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.31",
            "verseOrgIds": [
              "1KI.22.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 22:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akulumpi amakálu chamwenuwu Yehoshafwati, hiyakwila nawu, Chalala yeniwu diyi mwanta wawaIsarela; hiyakufunta kwayilaŋawu, hiyakuya nakulwa nindi, Yehoshafwati hakubidika. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.32",
            "verseOrgIds": [
              "1KI.22.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 22:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akulumpi amakálu chanamonuwu komana hidiyimwanta wawaIsarelaku, hiyakufunta mwayilaŋawu nakumuhapa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.33",
            "verseOrgIds": [
              "1KI.22.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 22:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntuwumu hakwevula wuta windi chakadi kwiluka, hakumusowa mwanta wawaIsarela hahumaŋena wuvwalu wayikuŋu. Yena hakumwila mukwakwendeshaikalu dindi, nindi, Teŋululaku, wunfumishi munjita, chinankatinankashi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.34",
            "verseOrgIds": [
              "1KI.22.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 22:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.34",
            "verseOrgIds": [
              "1KI.22.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 22:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Denodu ifuku njita yaswejeli nankashi. Hiyakumwimika mwantamwikalu dindi adasi nawaSiriya, chikuneli melela hakufwa. Mashi afumini muchitu hiyakupwekela mukachi ketemba. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.35",
            "verseOrgIds": [
              "1KI.22.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 22:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chelili itaŋwa hidikuyanakuholoka, hiyakutiya izu mwahita njita yejima, dakwila nawu, Antu ejimaayi kunyikala yawu, antu ejima ayi kwafumafumawu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.36",
            "verseOrgIds": [
              "1KI.22.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 22:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.36",
            "verseOrgIds": [
              "1KI.22.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 22:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wafwili, amutweli kuSamariya, mwanta amujiikili muSamariya. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.37",
            "verseOrgIds": [
              "1KI.22.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 22:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikalu hiyakudikosela kwijiya dakuSamariya; atuwa hiyakulashamashi indi; kwenoku diku kwawelelapawu ambanda atubola; mwomwizu daYehova dahosheliyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.38",
            "verseOrgIds": [
              "1KI.22.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 22:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsaŋu jaAhabi jinashaluku, niyuma yejima yeliliyi, niitala datuŋiliyi nambiŋa yanjamba, ninyikala yejima yatuŋiliyi, hiyanajisoneki mumukanda wawanyanta awaIsarela wakushindululaku?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.39",
            "verseOrgIds": [
              "1KI.22.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 22:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.39",
            "verseOrgIds": [
              "1KI.22.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 22:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Ahabi wakamininawankakulula jindi; mwanindi Ahaziya hakumuswana. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.40",
            "verseOrgIds": [
              "1KI.22.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 22:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana kaAsa Yehoshafwati watachikili kuyula aYuda mumwaka wamuchiwana wamwanta wawaIsarela Ahabi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.41",
            "verseOrgIds": [
              "1KI.22.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 22:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatachikili kuyulayi Yehoshafwati wadiŋi wanyaka makumi asatu nayitanu; wayulili muYerusalema nyaka makumi ayedi nayitanu. Mama yindi ijina dindi Azuba mwana kaShilihi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.42",
            "verseOrgIds": [
              "1KI.22.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 22:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wendeli mwendelelaŋa tata yindi Asa mwejima; habaalukili mwokuku, welili yaloŋa kumesu aYehova. Hela chochu, yinaŋanaŋa hiyayifumishiluku; antu sapa aketwilawu yimuna hohu, saŋa ochelawu insensi hayinaŋgaŋa hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.43",
            "verseOrgIds": [
              "1KI.22.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1KI 22:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoshafwati wamwenesheli njita namwantawa waIsarela.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.44",
            "verseOrgIds": [
              "1KI.22.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1KI 22:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.44",
            "verseOrgIds": [
              "1KI.22.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1KI 22:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsaŋu jaYehoshafwati jinashaluku, niŋovu jindi jamwekesheliyi, nichalwilaŋayi, hiyanajisoneki mumukanda wawanyanta awaYuda wakushindululaku? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.45",
            "verseOrgIds": [
              "1KI.22.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1KI 22:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwawusodoma asheluku, asheli hamafuku atata yindi Asa, wayifumishili mwituŋa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.46",
            "verseOrgIds": [
              "1KI.22.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1KI 22:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.46",
            "verseOrgIds": [
              "1KI.22.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1KI 22:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "MuEdomi himwadiŋi mwantaku, mwanta yowu nchakala. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.47",
            "verseOrgIds": [
              "1KI.22.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1KI 22:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoshafwati watuŋili maatu amaneni kuTarashishi kulonda kuya kuOfwiri nakukeŋa wuru. Hiyayili kwawuku, muloŋa owu maatu abalukilili kuEziyoni Geberi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.48",
            "verseOrgIds": [
              "1KI.22.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1KI 22:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu mwana kaAhabi Ahaziya wamwila dehi Yehoshafwati, nindi, Yitŋi ambuŋami ayi nawambuŋeyi mumaatu. Ilaŋa Yehoshafwati kwonti kwindi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.49",
            "verseOrgIds": [
              "1KI.22.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1KI 22:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoshafwati wakamini nawankakulula jindi, amujiikili hamu nawankakulula jindi mumukala wankakulula yindi Davidi; mwanindi Yehorami hakumuswana.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.50",
            "verseOrgIds": [
              "1KI.22.50"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1KI 22:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.50",
            "verseOrgIds": [
              "1KI.22.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1KI 22:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana kaAhabi Ahaziya watachikili kuyula aIsarela muSamariya mumwaka wamwanta wawaYuda Yehoshafwati wekumi nakatanu nakayedi, wayulili aIsarela nyaka yiyedi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.51",
            "verseOrgIds": [
              "1KI.22.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "1KI 22:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Welili chatama kumesu aYehova, wendeli mwendelelaŋayi tata yindi, nimwendelelaŋayi mama yindi, nimwendelelaŋa yimwana kaNebati Yerobowami, mwavulumwishiliyi aIsarela. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.52",
            "verseOrgIds": [
              "1KI.22.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "1KI 22:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wapesheli Bayali, hakumufukaminaŋa, hakuvuloka Yehova Nzambiya waIsarela azuwi, mwomwelilaŋayi tata yindi mwejima.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.53",
            "verseOrgIds": [
              "1KI.22.53"
            ]
          }
        }
