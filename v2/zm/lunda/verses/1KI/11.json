      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.39",
            "verseOrgIds": [
              "1KI.11.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Solomoni wakeŋa eli kumujaha Yerobowami. Yerobowami hakunyamuka, hakutemukila muEjipitu kudi Shishaki mwanta wakuEjipitu, hakushakama muEjipitu nichafwiliyi Solomoni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.40",
            "verseOrgIds": [
              "1KI.11.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.40",
            "verseOrgIds": [
              "1KI.11.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 11:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsaŋu jaSolomoni jinashali nimweliliyi mwejima, nima ana indi, hiyanajisoneki mumukanda wayililu yaSolomonuku? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.41",
            "verseOrgIds": [
              "1KI.11.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 11:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafuku ayuliliyi Solomoni aIsarela ejima muYerusalema ashikili munyaka makumi awana. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.42",
            "verseOrgIds": [
              "1KI.11.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 11:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni hakukama hamu nawankakulula jindi, amuŋikili mumukalawatata yindi Davidi. Mwanindi Rehobowami hakumuswana.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.43",
            "verseOrgIds": [
              "1KI.11.43"
            ]
          }
        }
      ]
    }
