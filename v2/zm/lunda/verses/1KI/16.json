            "number": "29",
            "style": "v",
            "sid": "1KI 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamwaka wamakumi asatu nakatanu nakasatu wamwanta wawaYuda Asa, mwana kaOmiri Ahabi watachikili kuyula aIsarela. Mwana kaOmiri Ahabi wayulili muSamariya nyaka makumi ayedi nanyaka yiyedi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.29",
            "verseOrgIds": [
              "1KI.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana kaOmiri Ahabi welili chatama kumesu aYehova chakubadika ásambilili ejima. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.30",
            "verseOrgIds": [
              "1KI.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwenda nakwila nshidi jamwana kaNebati Yerobowami wachimweni tuhu kwindi nindi chaswayi, hakusumbula kwindini Yezebeli mwana kaEtibayali mwanta wawaZidoni, hakuya nakupesha Bayali, hakudifukula kudi yena. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.31",
            "verseOrgIds": [
              "1KI.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakutuŋila Bayali kameŋa mwitala daBayali datupiliyi muSamariya. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.32",
            "verseOrgIds": [
              "1KI.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabi hakushimika ninyiyombu. Ahabi welili yuma yakuvuloka Yehova azuwi, chakubadika anyanta awaIsarela ásambilili ejima.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.33",
            "verseOrgIds": [
              "1KI.16.33"
            ]
          }
        }
      ]
