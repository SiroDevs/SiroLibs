    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izu daYehova dakumutena Bayasha denjili kudi Yehu mwana kaHanani, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.1",
            "verseOrgIds": [
              "1KI.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Ami nakufumishili mulunkuŋu, hinukukulemesha nami wikali nlomboli yawantu ami aIsarela; eyi kweyi wunendi dehi mwendelaŋayi Yerobowami, wunavulumwishi dehi antu ami aIsarela, anvuloki nizuwi nanshidi jawu; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.2",
            "verseOrgIds": [
              "1KI.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "komana nukumukomba tuhu Bayashana mutaŋa windi; mutaŋa weyi nukuwukoŋa wakekali neyi mutaŋa waYerobowami mwana kaNebati. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.3",
            "verseOrgIds": [
              "1KI.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "WaBayasha wakafwila hamukala akamudya kudi atuwa; windi wakafwila mumpata akamudya kudi atujila amuluzwizu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.4",
            "verseOrgIds": [
              "1KI.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsaŋu jaBayasha jinashaluku, nimweliliyi, niŋovu yindi, hiyanajisoneki mumukanda wawanyanta awaIsarela wakushindululaku? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.5",
            "verseOrgIds": [
              "1KI.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayasha wakaminihamu nawankakulula jindi, amujiikili muTiriza; mwanindi Elahaku muswana.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.6",
            "verseOrgIds": [
              "1KI.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.6",
            "verseOrgIds": [
              "1KI.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukanwa kakaprofwetu Yehu mwana kaHanani, kwenjili izu dakumutena Bayasha nimutaŋa windi, muŋa wakutama kwejima kweliliyi kumesu aYehova, mwaka enzi amuvuloki azuwi nanyidimu yakumakasindi, nachina chadiŋiyi neyi mutaŋa waYerobowami; nanochu chamujahiliyi nawa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.7",
            "verseOrgIds": [
              "1KI.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.7",
            "verseOrgIds": [
              "1KI.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamwaka wamakumi ayedi nakatanu nakamu wamwanta wawaYuda Asa, mwana kaBayasha Ela watachikili kuyula aIsarela muTiriza, wayulilinyaka yiyedi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.8",
            "verseOrgIds": [
              "1KI.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kambuŋindi Zimiri, mukulumpi wachibalu chamakálu indi, wamukwatilili chikuchi, heliliyi wudi muTiriza nakunwa walwanakusheta mwitala daAraza wadiŋi mukulumpi wawakwakuhemba itala muTiriza. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.9",
            "verseOrgIds": [
              "1KI.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zimiri hakwijila nakumutaŋa, hakumujaha, hamwakawa makumi ayedi nakatanu nakayedi waAsa mwanta wawaYuda, hakumuswana.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.10",
            "verseOrgIds": [
              "1KI.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.10",
            "verseOrgIds": [
              "1KI.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chatachikiliyi kuyula, hohakushatama hetanda dindi dawanta, hakutapamutaŋa waBayasha wejima. Hamushiyilili hoku mwana weyalaniwumuku, hela tuhu awusoku windi, hela amabwambu jindi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.11",
            "verseOrgIds": [
              "1KI.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zimiri wajilu mwini mutaŋa waBayasha wejima, mwomwaya izu daYehova damuteneneniyi Bayasha kukanwa kakaprofwetu Yehu, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.12",
            "verseOrgIds": [
              "1KI.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nanshidi jaBayasha ejima, nanshidi jamwanindi Ela, javulumwinuwu, javulumwishiluwu nachu aIsarela, avuloki Yehova Nzambi yaIsarela azuwi nayuma yawu yakuhemesha. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.13",
            "verseOrgIds": [
              "1KI.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsaŋu jaEla jinashaluku, niyuma yejima yeliliyi, hiyanajisoneki mumukanda wawanyanta awaIsarela wakushindululaku?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.14",
            "verseOrgIds": [
              "1KI.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.14",
            "verseOrgIds": [
              "1KI.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamwaka wamakumi ayedi nakatanu nakayedi wamwanta wawaYuda Asa, Zimiri hakuyula mafuku atanu nayedi muTiriza. Henohu antu adiŋi atuŋa chilombu kulonda alwi naGibetoni wawaFwilistinu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.15",
            "verseOrgIds": [
              "1KI.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu adiŋi muchilombu chawu achitiyili nawu, Zimiri nakwati dehi chikuchi, namutapi dehi mwanta nawa. Dichi aIsarela ejima hiyakumudiisha Omiri mukulumpi wanjita wanta wawaIsarela denodu ifuku muchilombu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.16",
            "verseOrgIds": [
              "1KI.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omirihakufuma kuGibetoni niaIsarela ejima hamu, hiyakuya nakukuchika Tiriza. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.17",
            "verseOrgIds": [
              "1KI.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zimiri chamweniyi mukala anawulukuki dehi, hakukandama hazandamina itala damwanta, hakudochela mwitala damwanta nakesi, hakufwa, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.18",
            "verseOrgIds": [
              "1KI.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nanshidijindi javulumwiniyi heliliyi chatama kumesu aYehova, chendeliyi mwendelaŋayi Yerobowami, nimunshidi yindi yavulumwishiliyi nachu aIsarela. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.19",
            "verseOrgIds": [
              "1KI.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsapu jaZimiri jinashaluku, nichakwatiliyi makasu, hiyanaji sonekimu mukanda wawanyanta awaIsarela wakushindululaku?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.20",
            "verseOrgIds": [
              "1KI.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.20",
            "verseOrgIds": [
              "1KI.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu aIsarela aambukili yendu yiyedi; chendu chawantu chimuhiya kulondela mwana kaGinati Tibini, nawu amudiishi wanta, chikwawu hichikulondela Omiri. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.21",
            "verseOrgIds": [
              "1KI.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu alondeli Omiri ayibadikili antu alondeli mwana kaGinati Tibini Ŋovu. Dichi Tibini wafwili, Omiri hakuyula. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.22",
            "verseOrgIds": [
              "1KI.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamwaka wamakumi asatu nakamu wamwanta wawaYuda Asa, Omiriwatachikili kuyula aIsarela; wayulili nyaka ikumi nayiyedi, nyaka yitanunawumu yoyayuliliyi muTiriza. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.23",
            "verseOrgIds": [
              "1KI.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walandili kudi Shemeri mpidi yaSamariya nantalenta jasiliva jiyedi; hakutuŋila hampidi; mukala watuŋiliyiwa wutumbili ijina daSamariya, watambwilili kwijina daShemeri mwinimpidi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.24",
            "verseOrgIds": [
              "1KI.16.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.24",
            "verseOrgIds": [
              "1KI.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiri welili chatama kumesu aYehova, welili chatama chakubadika asa mbilili ejima. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.25",
            "verseOrgIds": [
              "1KI.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wendeli mwejima mwendelapayi Yerobowami mwana kaNebati, nimunshidi jindi javulumwishiliyi nachu aIsarela, avuloki Yehova Nzambi yaIsarela azuwi nayuma yawu yakuhemesha. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.26",
            "verseOrgIds": [
              "1KI.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsaŋu jaOmiri jinashaluku niyuma yeliliyi niŋovu yindi yamwekesheliyi, hiyanajisoneki mumukanda wawanyanta awaIsarela wakushindululaku? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.27",
            "verseOrgIds": [
              "1KI.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiri wakaminihamu nawankakulula jindi, amujiikili muSamariya; mwanindi Ahabi hakumuswana.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.28",
            "verseOrgIds": [
              "1KI.16.28"
            ]
          }
        }
      ]
    },
