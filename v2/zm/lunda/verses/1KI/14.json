    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamafuku owu mwana kaYerobowami Abiya wakatili. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.1",
            "verseOrgIds": [
              "1KI.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yerobowami hakumwila Iŋodindi, nindi, Nyamukaku mwani, wuvwali yakudibalumuna nachu, abuli kukwiluka nawu iŋoda Yerobowami. Wuyi kuShilo; kwenoku kwokudi kaprofwetu Ahiya wahosheli jakwikala ami mwanta wawantu awa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.2",
            "verseOrgIds": [
              "1KI.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sendaku mankendi ikumi, nitumankendi, nichitayichawuchi, wuyi kudi yena. Wakakuleja mwakamonayi mwana.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.3",
            "verseOrgIds": [
              "1KI.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.3",
            "verseOrgIds": [
              "1KI.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "IŋodaYerobowami ela nimwenomu, hakunyamuka, hakuya kuShilo, hakushika kwitala daAhiya. Henohu Ahiya kutwesha kumona nehi, muloŋa mesu indi ela dehi lwidi nawushinakaji. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.4",
            "verseOrgIds": [
              "1KI.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova hakumwila Ahiya, nindi, Tala, iŋoda Yerobowami hakwinza nakwihula jamwanindi, muloŋayena wakata. Muleji munŋanji mukanaŋa, muloŋa hakwijila yi wukudifwikija neyi himumbanda wacheŋi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.5",
            "verseOrgIds": [
              "1KI.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahiya chatiyiliyi nshindu janyenduyindi hepililaŋayi kuchisu, hakwila nindi, Eyi iŋoda Yerobowami, iŋilaku. Wukudifwikijiladi neyi muntu wacheŋi? Ami anantumi kudeyi nansaŋuyaka. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.6",
            "verseOrgIds": [
              "1KI.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaku wakamuleji Yerobowami, neyi, Yehova Nzambi yaIsarela nahoshi nindi, China chinakutohesheli mukachi kawantu, hinukuwinka wulomboli wawantu ami aIsarela, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.7",
            "verseOrgIds": [
              "1KI.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "hinukutabula wanta kumutaŋa waDavidi bwe-chi, hinukukwinkawu eyi; eyi wunaleki kwila mweliliyi kambuŋa miDavidi, wahembelaŋa kuleja kwami, wanlondelaŋa namuchima windi wejima, nakwila yaloŋa hohu kumesu ami; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.8",
            "verseOrgIds": [
              "1KI.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "eyi kweyi wuneli chatama chakubadika antu ejima ásambilili, wunayi nakwila akishi, niakishi akusuŋununa, wunvuloki kulonda nizuwi, hiwukunnatila nikunyima yeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.9",
            "verseOrgIds": [
              "1KI.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichidinu tiya. Ami nakaleta yatama hamutaŋa waYerobowami; kudi Yerobowa minaka mufumisha anyana amayala ejima, niwenzelewa niwudi hatooka muIsarela; mutaŋa waYerobowami nukuwukomba neyi chakomba ŋayi muntu tuji, ninichi chiwakamana to chikupu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.10",
            "verseOrgIds": [
              "1KI.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "WaYerobowami wakafwilamumukala akamudya kudi atuwa; wakafwila mumpata akamudya kudi atujila amuluzwizu; muŋa Yehova nachihoshi dehi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.11",
            "verseOrgIds": [
              "1KI.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyamukakuwuyi kwitala deyi. Chiwakadata mwendu hamukala, dihu hakafwa mwana. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.12",
            "verseOrgIds": [
              "1KI.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "AIsarela ejima akamudila, akamujiika. Diyi waYerobowami wakashika kwijamu hohu kanka windi; muloŋa kumutaŋa waYerobowami mudi yena hohu dimu munamwekani chuma chachiwahi kumesu aYehova, Nzambi yaIsarela. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.13",
            "verseOrgIds": [
              "1KI.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa Yehova wakamwekesha mwanta wawaIsarela, wakafumishamutaŋa waYerobowami ifuku odu. Indi ika? Mwalala katataka. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.14",
            "verseOrgIds": [
              "1KI.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wakababesha aIsarela neyi iteti dikunyinkesha mumeji; wakabwita aIsarela mwituŋa idi dadiwahi denkeliyi ankakulula jawu, wakayipalaŋe shela kwishinadi daKaloŋa, muloŋa anashimiki nyiyombu yawu nakuvuloka Yehova azuwi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.15",
            "verseOrgIds": [
              "1KI.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakaleka aIsarela nanshidi janavulumuniyi Yerobowami janavulumwishiyi nachu aIsarela.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.16",
            "verseOrgIds": [
              "1KI.14.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.16",
            "verseOrgIds": [
              "1KI.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "IŋodaYerobowami hakunyamuka, hakuya, hakwinza kuTiriza. Cheliliyi nindi ashiki kuchisu chetala, mwana afwa nikufwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.17",
            "verseOrgIds": [
              "1KI.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amujiikili kudi aIsarela ejima, amudilili, mwomwizu daYehova dahosheliyi kukanwakakambu ŋindi kaprofwetu Ahiya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.18",
            "verseOrgIds": [
              "1KI.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.18",
            "verseOrgIds": [
              "1KI.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsaŋu jaYerobowami jinashaluku, nimwalwilaŋayi, nimwayulila ŋayi, anasoneki mumukanda wawanyanta awaIsarela wakushindulula. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.19",
            "verseOrgIds": [
              "1KI.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafuku ayuliliyi Yerobowami ashikili munyaka makumi ayedi nanyaka yiyedi; wakamini hamu nawankakulula jindi, mwanindi Nadabi hakumuswana.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.20",
            "verseOrgIds": [
              "1KI.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.20",
            "verseOrgIds": [
              "1KI.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana kaSolomoni Rehobowami wayulili muYuda. Hatachikiliyi kuyula Rehobowami wadiŋi wanyaka makumi awana namwaka wumu. Wayulili nyaka ikumi nayitanu nayiyedi muYerusalema, mukala watondeliyi Yehova munyichidi yawaIsarela yejima kulonda kushaku ijina dindi. Mama yindi ijina dindi diyi Nayama kaAmoni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.21",
            "verseOrgIds": [
              "1KI.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.21",
            "verseOrgIds": [
              "1KI.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "AYuda elili chatama kumesu aYehova, hiyakumutiyisha mukawunanshidi jawu javulumwinuwu chakubadika mwejima mweliluwu ankakululajawu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.22",
            "verseOrgIds": [
              "1KI.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa niwena nawa elili yinaŋanaŋa, nituposhi twakupeshela, nakushimika nyiyombu hamawulu atupidi twatulehi twejima, nimumashina anyitondu yituuta yejima. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.23",
            "verseOrgIds": [
              "1KI.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwituŋa mwadiŋi niwusodoma nawa. Elili mwaya yishimashima yejima yanyuza yatemwiniyi Yehova kumesu awanyana kaIsarela.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.24",
            "verseOrgIds": [
              "1KI.14.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.24",
            "verseOrgIds": [
              "1KI.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwaka wamwanta Rehobowami wamu chitanu, mwanta wakuEjipitu Shishaki wenjili nakudasa njita naYerusalema. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.25",
            "verseOrgIds": [
              "1KI.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakutwala yumayalema yamwitala daYehova, niyuma yalema yamwitala damwanta; watweliyejima. Watweli ninkebu jawuru jeliliyi Solomoni jejima. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.26",
            "verseOrgIds": [
              "1KI.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehobowami hakwila nkebu jawuneŋu, hakujihiŋi shamu, hakujinka awakulumpi awatulama ahembelaŋa kuchisu chetala damwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.27",
            "verseOrgIds": [
              "1KI.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakwilaŋa neyi mwanta hakuya mwitala daYehova, atulama hiyakujisenda, hiyakujifuntisha cheŋi mwitala daawatulama, chochu ho-o. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.28",
            "verseOrgIds": [
              "1KI.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsariu jaRehobowami jinashaluku, nimweliliyi mwejima, hiyanajisoneki mumukanda wawanyanta awaYuda wakushindululaku? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.29",
            "verseOrgIds": [
              "1KI.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ARehobowami naYerobowami adasilaŋa njita mafuku ejima. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.30",
            "verseOrgIds": [
              "1KI.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehobowami wakaminihamu nawankakulula jindi, amujiikili hamu nawankakulula jindi mumukala waDavidi. Mama yindi ijina dindi diyi Nayama kaAmoni. Mwanindi Abiya hakumuswana.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.31",
            "verseOrgIds": [
              "1KI.14.31"
            ]
          }
        }
      ]
