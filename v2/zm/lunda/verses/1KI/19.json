      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabi wamulejeli Yezebeli mweliliyi Elija mwejima, nichajahiliyi atuprofwetu ejima nampoku yakabali. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.1",
            "verseOrgIds": [
              "1KI.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yezebeli hakutemeshaka ŋinda kudi Elija, nindi, Neyi wumi weyi nukubula kuwila neyi wumiwawenawa kumadiki, aha hanashiki itaŋwa aha, akishi akaŋili mwomumuni chakubadikamu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.2",
            "verseOrgIds": [
              "1KI.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanamoniyi chenochu hakunyamuka, hakuyaapulwishi wumi windi, hakwinza kuBerisheba wakuYuda, hakushiya pambayindi kwenoku.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.3",
            "verseOrgIds": [
              "1KI.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.3",
            "verseOrgIds": [
              "1KI.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yemweni hakuya mwisaŋa kwenda kwakwcnda ifuku dimu, hakuyanakushakama mwishina dachiputa; hakudilombela jakwila nindi afwi, nindi, Jinahu! Ichi dinu eyi Yehova fumishaku wumi wami, muloŋa amihinabadika ankakulula jamuku.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.4",
            "verseOrgIds": [
              "1KI.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.4",
            "verseOrgIds": [
              "1KI.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akambama nimwishina dachiputa, aya ninamutulu. Hikukwinza kaŋelunakumukunka, hakumwila nindi, Hindukaku, wudyai. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.5",
            "verseOrgIds": [
              "1KI.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindi atali, komana kunamutu windi kudi dinkendi dakwocha hamalola akesi, kudi ninsaba yameji. Hakudya, hakunwa, hakukambama cheŋi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.6",
            "verseOrgIds": [
              "1KI.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapelu kaYehova hakwinza kudi yena kamuchiyedi, hakumukunka, nindi, Hindukakuwudyai, muloŋa njila yeyi yasweja kuleha. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.7",
            "verseOrgIds": [
              "1KI.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuhinduka, hakudya nakunwa, hakwenda naŋovu yakudya oku mafuku makumi awana nimwa ana shiwufuku, hakuya kumpidi yaNzambi kuHorebi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.8",
            "verseOrgIds": [
              "1KI.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.8",
            "verseOrgIds": [
              "1KI.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwijila mwiyepu kwenoku, hakushakama nikwenoku. Izu daYehova hidikwinza kudi yena, hakumwila nindi, Eyi Elija, wudi nakwiladi kunu? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.9",
            "verseOrgIds": [
              "1KI.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena nindi, Ami namutiyili Yehova Nzambi wamazaza mukawu nankashi; muloŋa anyana kaIsarela analeki chitiyaŋenu cheyi, anasandi tumeŋa letweyi, anajahi tuprofwetu tweyi nampoku yakabali. Yami inashaluhukanka wami hohu, hiyakukeja nikufumisha wumi wami, awufumishinawa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.10",
            "verseOrgIds": [
              "1KI.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindi, Idikaku, wimani kumesu aYehova hampidi. Yehova hakuhitakwenoku, mpepela yeneni yaŋovu hiyikubalula mapidi, hiyikuhumona malola kumesu aYehova. Ilaŋa Yehova hadiŋi mumpepelaku. Hampepelahiha kulondela mutentanshi. Ilaŋa Yehova hadiŋi mumutentanshuku. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.11",
            "verseOrgIds": [
              "1KI.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamutentanshi hihakulondela kesi. Ilaŋa Yehova hadiŋi mukesuku. Hakesi hihakulondeia kadizu kanyanya kawunda. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.12",
            "verseOrgIds": [
              "1KI.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elija chaditiyiliyi hakudibuta ihina dindi kumesu, hakwidika, hakwimana kuwipililu wakwiyeŋu. Hakutiya izu hidikwinza kudi yena, nindi, Eyi Elija wudi nakwiladikunu? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.13",
            "verseOrgIds": [
              "1KI.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindi, Ami namutiyili Yehova Nzambi wamazaza mukawunankashi; muŋa anyana kaIsarela analeki chitiyaŋenu cheyi, anasandi tumeŋai tweyi, anajahi tuprofwetu tweyi nampoku yakabali. Yami inashaluhukanka wami hohu, hiyakukeŋa nikufumisha wumi wami awufumishinawa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.14",
            "verseOrgIds": [
              "1KI.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.14",
            "verseOrgIds": [
              "1KI.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova hakumwila nindi, Yaku wufunti munjila yeyi, wuyi kwisaŋada kuDamakasa. Chiwakashika wakawayishi Hazayeli akekali mwantawa kuSiriya. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.15",
            "verseOrgIds": [
              "1KI.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni mwana kaNimishi Yehu wakamuwayishi akekali mwantawa waIsarela; niElisha mwana kaShafwati wakuAbeli Mehola wakamuwayishi akekali kaprofwetu wakuhipa mudeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.16",
            "verseOrgIds": [
              "1KI.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulonda yowu wakapulukakumpoku yakabali yaHazayeli akamujahi kudi Yehu. Yowu wakapulukakumpoku yakabali yaYehu akamujahi kudi Elisha. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.17",
            "verseOrgIds": [
              "1KI.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela chochu, muIsarela nakashiyamu makombakaji awantu atanu nayedi, wowu manuŋu ejima anabuli kufukamina Bayali, twotunwa twejima tunabuli kumupwepula.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.18",
            "verseOrgIds": [
              "1KI.19.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.18",
            "verseOrgIds": [
              "1KI.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakufuma kwenoku hakuwana mwana kaShafwati Elisha, wudinakudima nampanda jaŋombi ikumi najiyedi adi nakuya kumbidi, yena nakumi kumpanda yekumi nakayedi. Elija hakuhita kwadiŋiyi, hakumunatilaihina dindi hamujimba windi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.19",
            "verseOrgIds": [
              "1KI.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakushiya aŋombi, hakumulonde laElija lufuchi, nindi, Aŋitiji mwani niyi nakapwepuli mama natata, hinakakulonda. Hakumwila nindi, Funtapa kweyi. Ochu nakwili pahi? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.20",
            "verseOrgIds": [
              "1KI.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakufunta kwayiliyi nakumulondela, hakukwata aŋombi ayedi, hakuyiha, hakuteleka mbiji yawu nayuma yakalakeshelaŋayi nachu aŋombi, hakuyinka antu, hiyakudya. Hakunyamuka, hakumulondela Elija, hakumukalakelapa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.21",
            "verseOrgIds": [
              "1KI.19.21"
            ]
          }
        }
      ]
    }
  ],
