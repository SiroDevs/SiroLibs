    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafuku akufwa kwaDavidi hiyakuya nakuswila kwakwihi, hakumukana mwanindi Solomoni, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.1",
            "verseOrgIds": [
              "1KI.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Hinukuya mwayaŋa iseki dejima. Kadikwatishi, wikali iyala; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.2",
            "verseOrgIds": [
              "1KI.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakahembi lushiiku lwaYehova Nzambi yeyi, wakendi mwatwalayi yena, wakahembi yidika yindi, nimwalejaŋayi, nimuwuŋajiwindi, nimuwunsahu windi, mwomwanasonekuwu munshimbi jaMosi, kulonda wakamoni kushakama chachiwahi muyuma yejima yiwakela, nimuwakayaŋa mwejima. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.3",
            "verseOrgIds": [
              "1KI.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulonda Yehova akakoleshi izu dindidanteneneniyi, deliliyi nindi, Neyi anyaneyi akasha muchima mwakayapawu, nakwenda kumesu ami munsaŋu yalala, nanyichima yawu yejima, nawumi wawu wejima, nindi, Hikwakabulena iyala wakudeyi wakushakama hetanda daIsarelaku.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.4",
            "verseOrgIds": [
              "1KI.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.4",
            "verseOrgIds": [
              "1KI.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weluka dehi nawa mwankoŋeliyi mwana kaZeruwiya Yowabi, mwayikopeliyi awakulumpi anjita jawaIsarela ayedi, aAbineri mwana kaNeri, naAmasa mwana kaYeteri, ajahiliyi, hakumwapa mashi anjita hamwena, hakusha mashi anjita kumuya windi wavweliyi mumbunda yindi, nikunkwabilujindi jadiŋi kunyendu yindi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.5",
            "verseOrgIds": [
              "1KI.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kamwili mwomwaya maana eyi, bayi waketiji namutu windi wanvu kukunkumuka kukalupa chamwenaku.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.6",
            "verseOrgIds": [
              "1KI.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.6",
            "verseOrgIds": [
              "1KI.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaBazilayi wakuGileyadi wakayilaŋa chachiwahi, akadyaŋa kumesa yeyi hamu nawakwawu, nachina chenjiluwu kudami hinatemukilimana kweyi Abisalomi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.7",
            "verseOrgIds": [
              "1KI.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala, wudi naShimeyi mwana kaGera, kaBenjaminiwa kuBahurimi, wankunkwilili ishipu daŊovu ifuku dinayilaŋa kuMahanayimi. Ilaŋa dinu wenjili nakunkinkilila kuYodana, ninami namusanyikilili Yehova, nami, Hinukukujaha nampoku yakabaluku. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.8",
            "verseOrgIds": [
              "1KI.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinubayi wakamuyiŋishaku, muloŋa eyi wumuntu wamaana, wakeluka muwakamwila, wakakunkumwishaŋa namutu windi wanvu kukalupa namashi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.9",
            "verseOrgIds": [
              "1KI.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.9",
            "verseOrgIds": [
              "1KI.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi wakamini nawankakulula jindi, amujiikili mumukala waDavidi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.10",
            "verseOrgIds": [
              "1KI.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafuku ashakaminiyi Davidi muwanta waIsarela ashikili munya kamakumi awana. Nyaka yashakaminiyi muwanta muHeberoni yitanu nayiyedi, nyaka yashakaminiyi muwanta muYerusalema makumi asatunanyaka yisatu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.11",
            "verseOrgIds": [
              "1KI.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.11",
            "verseOrgIds": [
              "1KI.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni washakamini hetanda dawanta datata yindi Davidi. Wantawindi wakoleli nankashi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.12",
            "verseOrgIds": [
              "1KI.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana kaHagiti Adoniya hakwinza kudi mama yaSolomoni Batisheba. Batisheba hakumwila nindi, Ichi chiwunenzi, kwamwena tahindi? Nindi, Kwamwena. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.13",
            "verseOrgIds": [
              "1KI.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwila nawa nindi, Nidi nachuma chakuhosha naneyi. Mumbanda nindi, Hoshapa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.14",
            "verseOrgIds": [
              "1KI.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindi, Wuneluki wanta wadiŋi wamami, niaIsarela ejima ashili muchima hadami nawu niikali mwanta. Ichiwanta hiwunabalumuki dehi wunekali dehi wamana kwami, muloŋa wadiŋi dehi windi wakudi Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.15",
            "verseOrgIds": [
              "1KI.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi dinu nakulombuhu chuma chimu, bayi wunkiishaku. Batisheba nindi, Hoshaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.16",
            "verseOrgIds": [
              "1KI.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindi, Anhosheluku mwani, kudi mwanta Solomoni, ochu wukukukanisha? akanyinki Abishaŋi waku-Shunemi, nisumbuli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.17",
            "verseOrgIds": [
              "1KI.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batisheba nindi, Chachiwahi, nukukuhoshelakukudi mwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.18",
            "verseOrgIds": [
              "1KI.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batisheba hakwinila mwa-mwanta Solomoni, kulonda amuhosheluku Adoniya. Mwanta hakunyamuka nakumukinkilila, hakumubandamina, hakushakama cheŋi hetanda dindi dawanta, hakuyila antunindi, Mwinkenu mama yamwanta itanda dawanta. Batisheba hakushakama kuchikasa chindi chachidiilu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.19",
            "verseOrgIds": [
              "1KI.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakumwila nindi, Nukukulombakachuma kamu, bayi wunkiishaku. Mwanta hakumwila nindi, Lombanamama, hinukukukiishaku. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.20",
            "verseOrgIds": [
              "1KI.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batisheba nindi, Abishaŋi wakuShunemia kamwinkiyi mana kweyi Adoniya amusumbuli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.21",
            "verseOrgIds": [
              "1KI.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta Solomoni hakumwakula mama yindi, nindi, Wuna mulombelidi Adoniya Abishaŋi wakuShunemi? Komana mulombeli niwanta nawa, muloŋa yena hiyaya. Wikali wawu nawakwawu akapristu Abiyatari namwana kaZeruwiya Yowabi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.22",
            "verseOrgIds": [
              "1KI.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta Solomoni hakusanyika Yehova, nindi, Nzambi ankoŋi mwomumuni chakubadi kamu, neyi idi izu danahoshiyi Adoniya hidakudŋha yemwenuku. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.23",
            "verseOrgIds": [
              "1KI.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chahandayi Yehova, nankoleshi, nanshakamishi hetanda datatayami Davidi dawanta, nantuŋishi nimukala mwakaniniyi, chalala kwaamu, lelu dakumujaha Adoniya hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.24",
            "verseOrgIds": [
              "1KI.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta Solomoni hakutemesha mwana kaYehoyada Benaya, hakumulotokela, hakufwa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.25",
            "verseOrgIds": [
              "1KI.2.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.25",
            "verseOrgIds": [
              "1KI.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta hakumwila kapristu Abiyatari, nindi, Yaku kuAnatoti kwekalamaheyi; muŋa eyi wunateli kufwa, ilaŋa hinukukujaha leluku, muŋawatembekelapa chimbaŋu chaMwanta Yehova kumesu atata yami Davidi, muŋa wakabakeni hamu natata yami mwakabakeniyi mwejima. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.26",
            "verseOrgIds": [
              "1KI.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni wamufumishili Abiyatari muwupristu waYehova, kulonda izu daYehova dateneneniyi mutaŋi waEli kuShilo diikali dalala. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.27",
            "verseOrgIds": [
              "1KI.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsaŋu yishika nikudi Yowabi. Muloŋa Yowabi wabulili kulondela Abisalomi walondeleli Adoniya. Yowabi hakutemukila kwitenti daYehova, hakukwata kunseŋu jakameŋi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.28",
            "verseOrgIds": [
              "1KI.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakumuleja mwanta Solomoni, nawu, Yowabi natemukili kwitenti daYehova, owu wudi kukameŋi owu. Solomoni hakutemesha mwana kaYehoyada Benaya, nindi, Yaku, wakamulotokeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.29",
            "verseOrgIds": [
              "1KI.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benaya hakwinza kwitenti daYehova, hakumwila nindi, Mwantanahoshi nindi idikaku. Yena nindi, Nehi, nukufwila kwami kwokunu. Benaya hakufuntisha mazu kudi mwanta nindi, Tiya mwanahoshiyi Yowabi, nimwanaŋikuliyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.30",
            "verseOrgIds": [
              "1KI.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta hakumwila nindi, Ilaku mwanahoshiyi, wakamulotokeli, wakamujiiki; kulonda mashi apwekesheliyi Yowabichakadi muloŋa wakayifumishi kudami, nikumutaŋa watata yami. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.31",
            "verseOrgIds": [
              "1KI.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mashiindi Yehova amuhilwishiluwu yomwenindi, nanochu chalotokeleliyi amayala ayedi amubadikili nikuloŋai nikuwaha, hakuyijiha nampoku yakabali, chakubula tata yami Davidi kuchiluka, yowu mwana kaNeri Abineri, wadiŋi mukulumpi wanjita yawaIsarela, namwana kaYeteri Amasa wadiŋi mukulumpi wanjita yawaYuda. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.32",
            "verseOrgIds": [
              "1KI.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mashi awu akamuhilukili Yowabi nawanyanindihaya nyaka. Hakwila kudi Davidi, nikudi anyanindi, nikumutaŋwindi, nikwitanda dindi dawanta, kwakekali kumwena kwahaya nyakakwakufuma kudi Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.33",
            "verseOrgIds": [
              "1KI.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana kaYehoya daBenaya hakuyaku, hakumulotokela hakumujaha. Hakumujiika mwitala dindi yomweni dadiŋimwisapa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.34",
            "verseOrgIds": [
              "1KI.2.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta hakuhiŋisha mwana kaYehova daBenaya mumudi muwa wuawakulumpi wanjita mwadiŋi Yowabi. Mwadiŋi Abiyatari mwanta hakuhiŋishamu kapristu Zadoki.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.35",
            "verseOrgIds": [
              "1KI.2.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.35",
            "verseOrgIds": [
              "1KI.2.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta hakutemesha antu akutambika Shimeyi, hakumwila nindi, Tuŋku itala deyi muYerusalema, wakashakamuku, kufumaku wuya kwacheŋi nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.36",
            "verseOrgIds": [
              "1KI.2.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifuku diwakedika mumukala, diwakazambuka kakaloŋa Kidironi dodiwakeluka neyi nafwi dehi kwami chalala. Mashi eyi akakukumina eyi aweni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.37",
            "verseOrgIds": [
              "1KI.2.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 2:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimeyi hakumwila mwanta, nindi, Hiizu dadiwahi. Mwanahoshiyi nkaka yami mwanta, dimu nukwila ami kambuŋeyi. Shimeyi hakushakama kuYerusalema mafuku amavulu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.38",
            "verseOrgIds": [
              "1KI.2.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 2:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.38",
            "verseOrgIds": [
              "1KI.2.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 2:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimwahitili nyaka yisatu anduŋu jaShimeyi ayedi hiyakutemukila kudi Akisha, mwana kaMayaka, mwanta wakuGati. Hiyakumuleja Shimeyinawu, Tala, anduŋu jeyi adi kuGati. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.39",
            "verseOrgIds": [
              "1KI.2.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 2:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimeyi hakunyamuka, hakulemasadi hachimbulu chindi, hakuya kuGati kudi Akisha, nakukeŋi anduŋu jindi. Shimeyi wayili, waleteli cheŋi anduŋu jindi kwayiluwu kuGati. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.40",
            "verseOrgIds": [
              "1KI.2.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 2:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakumule jaSolomoni nawu, Shimeyi nafumi dehi muYerusalema, nayi dehi kuGati, nenzi dehi cheŋi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.41",
            "verseOrgIds": [
              "1KI.2.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 2:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta hakutemesha antu akumutambi kaShimeyi, hakumwila nindi, Hinakusanyikishili Yehova hela kukuhoshana Ŋovu, nami, Ilukaku chikupu neyi ifuku diwakafuma mumukala diwakayakwacheŋi, dodiwakafwa kweyi chalalaku? Nineyi waŋilili neyi, Izu dinatiyidadiwahi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.42",
            "verseOrgIds": [
              "1KI.2.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 2:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indi wunalekelidi dinu kwila muwamusanyikilili Yehova, nimunakulejeli naŋovu? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.43",
            "verseOrgIds": [
              "1KI.2.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1KI 2:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta hakumwila Shimeyi nindi, Wunelukikutama kwejima kudi mumuchima weyi kuwamwilili tata yami Davidi. Yehova wukukuhilwishila eyi aweni kutama kweyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.44",
            "verseOrgIds": [
              "1KI.2.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1KI 2:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa mwanta Solomoni akamukiswila nkisu, niitanda daDavidi dawanta dakakola kumesu aYehova nŋu haya nyaka. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.45",
            "verseOrgIds": [
              "1KI.2.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1KI 2:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta hakumuleja mwana kaYehova daBenaya, hakwidika, hakumulotokela, afwa nikufwa. Wanta wukolela nikudi Solomoni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.46",
            "verseOrgIds": [
              "1KI.2.46"
            ]
          }
        }
      ]
    }
