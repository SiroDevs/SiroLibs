          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni wakundaŋeni namwanta wakuEjipitu Fwaro, wasumbwilimwana kaFwaro, wamuleteli mumukala waDavidi, achiŋijilili chaka manishayi kutuŋa itala dindi, niitala daYehova, nimpwembu yaYerusalema yanyeŋu mukaku. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.1",
            "verseOrgIds": [
              "1KI.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu antu achidi kuketwila yimuna yawu hayinajinaŋi, muloŋa henohu abulili kutuŋila ijina daYehova itala, kudituŋa chiŋa hamafuku owu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.2",
            "verseOrgIds": [
              "1KI.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.2",
            "verseOrgIds": [
              "1KI.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni wamukeŋeli Yehova, wendelapa mwomuyidika yatata yindi Davidi; hela chochu waketwilaŋa yimuna nakwocha insensi hayinajinaŋi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.3",
            "verseOrgIds": [
              "1KI.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wayili kuGibeyoni nakuketwilaku yimuna; muloŋa kwenokudiku kwadiŋi kuchinaŋanaŋi cheneni. Solomoni hakushitila hakameŋa kakwenoku nyilambu yakushita ikombakaji. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.4",
            "verseOrgIds": [
              "1KI.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wamumwekeneni Solomoni kuGibeyoni mukulota nawufuku. Nzambi hakumwila nindi, Lombaku chinukukwinka. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.5",
            "verseOrgIds": [
              "1KI.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni nindi, Wunamwili tata kambuŋeyi Davidi luwi lwasweja, mwonsu mwanendeliyi kumesu eyi munsaŋu yalala, nimukuloŋa, nimukwoloka muchima naneyi hohu; wunamuhembeli luwiilu lwasweja, hiwukumwinka ni mwana wakushakama hetanda dindi dawanta, neyi ichi chitunamoni lelu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.6",
            "verseOrgIds": [
              "1KI.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi dinu eyi Yehova Nzambi yami, wunanswanishi dehi ami kambuŋeyi mudi tata yami Davidi. Ami kwami nikanakanyanya hohu, hineluka hela kwidika hela kwipilaku. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.7",
            "verseOrgIds": [
              "1KI.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami kambuŋeyinidi hakachi kawantu eyi iwatondeli, himuza weneni wakadi kwiluka mwavulilawu, hela kuyichinda kutwesha nehi, asweja kuvula. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.8",
            "verseOrgIds": [
              "1KI.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyinki amikambuŋeyi muchima wakwiluka maana akusompeshaŋa antu eyi, kulondana kashinshikaŋa nimwamuwahi nimwatama. Indi iwu muza wambalaweneni akuwutwesha kuwusompeshaŋa kudinyi?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.9",
            "verseOrgIds": [
              "1KI.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.9",
            "verseOrgIds": [
              "1KI.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chuma chalombeliyi Solomoni chamutiyishili Yehova kuwaha. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.10",
            "verseOrgIds": [
              "1KI.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi hakumwila nindi, Ichi chiwunalombi chumichi, chiwunabuli kulomba mafuku amavulu, hela kulomba maheta, hela kulomba wumiwawayilumbu jeyi, hiwukulomba maana akwiluka muwupaji, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.11",
            "verseOrgIds": [
              "1KI.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "neli dehi muwunahoshi. Tala, nakwinki dehi muchima wamaana nakashinshi, kulonda wakabuli kweseka nanawa akunyaka, nikumbidi kwakabuli nawakumwekana wacheŋi wudi neyi eyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.12",
            "verseOrgIds": [
              "1KI.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakwinki nawa niyiwunabulikulomba, maheta nakulema; hadi anyanta ankanu ejima hihakekala wudineyi eyi mafuku eyi ejimaku. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.13",
            "verseOrgIds": [
              "1KI.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi wukwendaŋi munjila jami, nakuhembayidika yami nimunalejaja, neyi chendelaŋayi tata yeyi Davidi, nakakuvulishilaku nawa nimafuku eyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.14",
            "verseOrgIds": [
              "1KI.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni atona nikutona, komana wadiŋi nakulota. Hakwinza kuYerusalema, hakwimana kumesu achimbaŋu chachitiyaŋenu chaYehova, hakushita nyilambu yakushita, hakulambula ninyilambu yakuwunda, hakuyitelekeshela ambuŋindi ejima chawija.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.15",
            "verseOrgIds": [
              "1KI.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.15",
            "verseOrgIds": [
              "1KI.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kudi mwanta hikukwinza ambanda ayedi atubola, hiya kwima nakumesu indi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.16",
            "verseOrgIds": [
              "1KI.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumbanda wumu hakwila nindi, Eyi nkaka, ninaminimumbandiwu twashakama itala detu dimu; ami hinukuvwala mwana, yena tudi nindi mwitala. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.17",
            "verseOrgIds": [
              "1KI.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimunahiti mafuku asatu nanaha hinavwalamwanami, iwu mumbanda niyena hakuvwala mwana nawa. Twadiŋihamu, hikwadiŋi muntu wacheŋi hamu nanetu mwitalaku, twadiŋi mwitala etu ayedi hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.18",
            "verseOrgIds": [
              "1KI.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana kaniwu mumbanda hakufwa nawufuku nakumusachila. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.19",
            "verseOrgIds": [
              "1KI.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakachi kawufuku yena hakunyamuka, hakufumisha mwanami kunyima yami, iku ami kambuŋeyi nidi namutulu, hakumushahantulu yindi, mwanindi wafwa hakumusha hantulu yami. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.20",
            "verseOrgIds": [
              "1KI.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinahinduka budidi nami nimwamwishimwanami, kumutala, wafwa dehi. Nami nimushinshiki nabudidi, kumutala, hidiyi mwanami navwalaku. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.21",
            "verseOrgIds": [
              "1KI.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owu mumbanda mukwawu nindi, Nehi, wamumi yowu mwanami, wafwa yowu mwaneyi. Iwu nindi, Nehi. Wafwa yowu mwaneyi, wamumiyowu mwanami. Hiyakuhosha kumesu amwanta chochochu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.22",
            "verseOrgIds": [
              "1KI.3.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.22",
            "verseOrgIds": [
              "1KI.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta hakuhosha nindi, Iwu nindi, Mwanami yowu wamumi, mwaneyi yowu wafwa. Owu nawa nindi, Nehi, mwaneyi yowu wafwa, mwanami yowu wamumi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.23",
            "verseOrgIds": [
              "1KI.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta nindi, Nletelenu mpoku yakabali. Hiyakuleta mpoku yakabali kumesu amwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.24",
            "verseOrgIds": [
              "1KI.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta nindi, Balulenu mwana wamumi hayedi, mutamba wumu mwinki iwu, mutamba wukwawumwinki owu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.25",
            "verseOrgIds": [
              "1KI.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumbanda wukweti mwana wamumi, muchima windiwunayi dehi hadi mwanindi, hakumwila mwanta nindi, Eyi nkaka, mwana wamumi, bayi amujahaku, chinjila. Mukwawu nindi, Bayi ekala hela wami hela weyuku, amubaluli tuhu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.26",
            "verseOrgIds": [
              "1KI.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta hakwakulanindi, Mwinkenu mwana wamumi, bayi mumujahaku, chinjila. Diyi mamayindi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.27",
            "verseOrgIds": [
              "1KI.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "AIsarela ejima atiyili mwaketwiliyi mwanta, hiyakumutiya mwanta woma, muloŋa amweni mudi yena mudi maana aNzambi akuhosha nyiloŋi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.28",
            "verseOrgIds": [
              "1KI.3.28"
            ]
          }
        }
      ]
    }
  ],
