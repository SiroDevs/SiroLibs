  "verseCount": 39,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "ROM 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu, antu ekala mudi Kristu Yesu hikwekala kuyihisha namuloŋaku. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.1",
            "verseOrgIds": [
              "ROM.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa lushimbi lwaSpiritu lwawumi wekala mudi Kristu Yesu, lunaŋamwini dehi kulushimbi lwanshidi nakufwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.2",
            "verseOrgIds": [
              "ROM.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa nshimbi chiakaŋenyi nanochu chijazeyeli hansaŋu yachisemwa chaheseki, Nzambi hakutemesha Mwanindi yomweni akadifwani namuntu wachisemwa chanshidi, akekali himulambu wahanshidi, akatanyishi nachu nshidi muchisemwa chaheseki. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.3",
            "verseOrgIds": [
              "ROM.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulonda mwaloŋela nshimbi mulumbuluki mudetu twabulana kwenda mwaya chisemwa chaheseki, chiŋa mwaya Spiritu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.4",
            "verseOrgIds": [
              "ROM.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa antu endaŋa mwaya chisemwa chaheseki atoŋojokaŋaa yuma yachisemwa chaheseki. Antu endaŋa mwaya Spiritu atoŋojokaŋaa yuma yaSpiritu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.5",
            "verseOrgIds": [
              "ROM.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yitoŋojoka yachisemwa chaheseki hikufwa, ilaŋa yitoŋojoka yaSpiritu hiwumi nikuwunda. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.6",
            "verseOrgIds": [
              "ROM.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa vitoŋojoka yachisemwa chaheseki yekala nawulumbu naNzambi; hiyovwahilaŋa nshimbi jaNzambuku, hela kutweshamu nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.7",
            "verseOrgIds": [
              "ROM.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu achisemwa chaheseki hiyakutwesha kutiyisha Nzambi kuwahaku.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.8",
            "verseOrgIds": [
              "ROM.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.8",
            "verseOrgIds": [
              "ROM.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi Spiritu yaNzambi washakama mudenu, komana mudi aSpiritu, himudi achisemwa chahesekuku. Neyi muntu wabula Spiritu yaKristu, himuntu winduku. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.9",
            "verseOrgIds": [
              "ROM.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi Kristu wekala mudenu, mujimba wafwa dehi hansaŋu yanshidi; hakwila spiritu nahandi hansaŋu yakuloŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.10",
            "verseOrgIds": [
              "ROM.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi Spiritu yayenowu wasaŋwili Yesu mudi afu washakama mudenu, yena wasaŋwili Kristu Yesu mudi afu wukuhandisha nawa ninyijimba yenu yakufwa, naSpiritu yindi washakama mudenu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.11",
            "verseOrgIds": [
              "ROM.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.11",
            "verseOrgIds": [
              "ROM.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nochu dinu, enu ana kwetu, hitukweti mukudi wachisemwa chaheseki mwaka twendi mwaya chisemwa chahesekuku. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.12",
            "verseOrgIds": [
              "ROM.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa neyi mukwenda mwaya chisemwa chaheseki, mukufwa; ilaŋa neyi mukufwisha nyidimu yachisemwa chaheseki naSpiritu, mukuhanda. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.13",
            "verseOrgIds": [
              "ROM.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa antu ejima alombola ŋawu kudi Spiritu yaNzambi, diwu anyana kaNzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.14",
            "verseOrgIds": [
              "ROM.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa himwatambwili spiritu yawuduŋu mwaka mutiyi cheŋi womaku; mwatambwili spiritu yakwikala anyana, yowu twatambikaŋa nachu netu, Aba, Tata! ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.15",
            "verseOrgIds": [
              "ROM.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yomweni Spiritu washimunaŋa wunsahu hamu naspiritu yetu, nindi muyanyana kaNzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.16",
            "verseOrgIds": [
              "ROM.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi tuyanyana komana tudi answana; answana aNzambi akuswana chimu naKristu, neyi tukumona nindi makabi, kulonda akatulemeshi chimu nindi nawa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.17",
            "verseOrgIds": [
              "ROM.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.17",
            "verseOrgIds": [
              "ROM.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nafu ukuli nami makabi akatataka hiyanateli kweseka nakulema kwamba kamwekana kudetuku. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.18",
            "verseOrgIds": [
              "ROM.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuleŋa kwejima kwachiŋililaŋa nakudihudika chamba kamwekana anyana kaNzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.19",
            "verseOrgIds": [
              "ROM.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa kuleŋa kwejima chi kwelili kwakuhemesha, hichakudikeŋelaku, chiŋa mwomwaya muchima wanowu wakwilili chochochu nakuchiŋeja. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.20",
            "verseOrgIds": [
              "ROM.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulonda kuleŋa kwakweni kufumi muwuduŋu wakutoka kwiŋili muwaana wawanyana kaNzambi wowu waana walema. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.21",
            "verseOrgIds": [
              "ROM.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuneluki netu kuleŋa kwejima kwa abaŋa nakufunyisha hamu, nikulelu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.22",
            "verseOrgIds": [
              "ROM.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hidimu hohu bweŋuku, ninetu aweni, tukweti nyikabu yatachi yaSpiritu, twaabaŋa munyichima yetu nawa, nakuchiŋilila chitwakela anyana chikupu, kwokukuula kwamba kakúulawu nyijimba yetu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.23",
            "verseOrgIds": [
              "ROM.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tunahandili kuchiŋeja; ilaŋa kuchiŋeja chuma chakumona dehi hikuchiŋejaku. Hinyi wachiŋejaŋa chuma chamonayi dehi? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.24",
            "verseOrgIds": [
              "ROM.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ROM 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa neyi twachiŋejaŋa chuma chakubula kumona, henohu dinu tukutatakena nakuchichiŋilila.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.25",
            "verseOrgIds": [
              "ROM.8.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ROM 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.25",
            "verseOrgIds": [
              "ROM.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ROM 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwomumu nawa niSpiritu watukwashaŋa hitwazeyazeyaloŋa; muloŋa hituneluki mutwadi kulombaku, ilaŋa Spiritu yomweni watulembelelaŋa nakwaba kwakweni kwakaŋanya kushimuna. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.26",
            "verseOrgIds": [
              "ROM.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ROM 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyena washinshikaŋa munyichima yawantu, neluki mwatoŋojokaŋayi Spiritu, muloŋa walembelelaŋa akwakujila mwaya muchima waNzambi.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.27",
            "verseOrgIds": [
              "ROM.8.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ROM 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.27",
            "verseOrgIds": [
              "ROM.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ROM 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuneluki netu yuma yejima yakaiakelaŋa hamu, nakuletela antu akeŋa Nzambi kuwaha, wowu atambikiliyi mwafuukwiliyi dehi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.28",
            "verseOrgIds": [
              "ROM.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ROM 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa antu asambili laŋayi dehi kwiluka, wayikunjikila ŋahu dehi nawa, nindi abalumuki kwikala neyi chekalayi Mwanindi; kulonda yena akekali wedi mukachi kawana kwindi amavulu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.29",
            "verseOrgIds": [
              "ROM.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ROM 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awa asambili laŋayi dehi kukunjika, wayitambikili nawa; awa atambikiliyi wayibalumwini kwikala aloŋa nawa; awa abalumwiniyi kwikala aloŋa hakuyilemesha nawa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.30",
            "verseOrgIds": [
              "ROM.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ROM 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.30",
            "verseOrgIds": [
              "ROM.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ROM 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi dinu, yumiyi tukwakula netwidi? Neyi Nzambi nekali wetwetu, wukwi kala chilumbu chetu hinyi? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.31",
            "verseOrgIds": [
              "ROM.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ROM 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena wabulili kwanakena Mwanindi omweni, hakumuhana hansaŋu jetwetu ejima, abuli kutulunjikila hadi yena yuma yejima makasa ayedi? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.32",
            "verseOrgIds": [
              "ROM.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ROM 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu atondayi Nzambi, akuyiholokela kudinyi? Yomweni Nzambi diyi wayibalumunaŋa kwikala aloŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.33",
            "verseOrgIds": [
              "ROM.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ROM 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akuyihisha kudinyi? Yomweni Kristu Yesu diyi wafwili, eŋa chalala, diyi asaŋwiluwu mudi afu, diyi wekala kuchikasa chaNzambi chachidiilu, diyi watulembelelaŋa nawa. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.34",
            "verseOrgIds": [
              "ROM.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ROM 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wukutwambula kukukeŋa kwaKristu hinyi? Yihuŋu tahindi? Kumona kukala tahindi? Makabisha tahindi? Nzala tahindi? Wuvu tahindi? Yuma yafwana tahindi? Mpoku yakabali tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.35",
            "verseOrgIds": [
              "ROM.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ROM 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chochanasonekuwu nawu, Hansaŋu yeyi atujahaŋa mwaana wonsu, atufuukulaŋa neyi anyikoku ateji kujaha. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.36",
            "verseOrgIds": [
              "ROM.8.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ROM 8:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakulehi! Muyuma yejimiyi tunekali akwakwimika mushindu nikubadikamu, naŋovu jayena watukeŋeli. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.37",
            "verseOrgIds": [
              "ROM.8.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ROM 8:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa neluki chikupu nami hela kufwa, hela wumi, hela aŋelu, hela mawanta, hela yuma yakatataka, hela yuma yamba kenza, hela yuma yikweti Ŋovu, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.38",
            "verseOrgIds": [
              "ROM.8.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ROM 8:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "hela kuleha kwakwiwulu, hela kukunama, hela chuma chacheŋi chaleŋeluwu chimu, hiyikutwesha kutwambula kukukeŋa kwaNzambi kwekala mudi Kristu Yesu, Mwanta wetuku.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.39",
            "verseOrgIds": [
              "ROM.8.39"
            ]
          }
        }
      ]
    }
