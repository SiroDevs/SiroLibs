    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsaŋu yakukwasha akwakujila; ami hinamoni nsaŋu yakuyisonekela mukandaku. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.1",
            "verseOrgIds": [
              "2CO.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa neluka dehi nami nyichima yenu yaya dehi mukwila chumichi, dichi chinadisambaŋa nachu kudi akwaMasidoniya, nami akwaAkaya aloŋesha dehi munahiti dehi niinwaka; niŋovu yenu yimunakalakali nachu yinaleteshi Ŋovu mudi antu amavulu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.2",
            "verseOrgIds": [
              "2CO.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa natemeshapahu dehi mana kwetu kulonda mudiloŋeshaŋahu dehi neyi chinahosheli; nalondi nami chinadisambapa hansaŋu yenu chibuli kusawuka.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.3",
            "verseOrgIds": [
              "2CO.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.5",
            "verseOrgIds": [
              "2CO.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa muntu wukukuwa yantesha wakaaŋula nawa yantesha; muntu wukukuwa yayivulu wakaaŋula nawa yayivulu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.6",
            "verseOrgIds": [
              "2CO.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu ejima atoŋojoki chachiwahi munyichima yawu hamuntu hamuntu, ahani chakadi kuneŋa hela kumukanjikija; Muloŋa Nzambi wakeŋa a muntu wahanaŋa nakuseha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.7",
            "verseOrgIds": [
              "2CO.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi natweshi kuyivulishila luwi lwejima, kulonda enu anaheteshuwu yuma yejima mafuku ejima, mutweshi kukwasha nachu akwenu nawa nanyidimu yayiwahi yejima. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.8",
            "verseOrgIds": [
              "2CO.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwomwanasonekuwu nawu, Yena naŋalaŋcshi kwejima, nenki atuzweŋi; kuloŋa kwindi kwekala kwoku chahaya nyaka. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.9",
            "verseOrgIds": [
              "2CO.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena wenkaŋa mukwakukuwa mbutu niyuma yakudya, wakayinka mbutu jakukuwa, hakuyivulishilaju; hakuyivulishila ninyikabu yakuloŋa kwenu nawa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.10",
            "verseOrgIds": [
              "2CO.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyihetesha yuma yejima, kulonda mumonaŋa yakuhana; chimukuhana hichikuletesha kumusakilila Nzambi mudetu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.11",
            "verseOrgIds": [
              "2CO.9.11"
            ]
          }
        }
      ]
    }
  ],
