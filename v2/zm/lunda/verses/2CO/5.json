    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuneluki netu itala detu dahanu hamaseki detenti, neyi dikushiwuka, tukweti itala dakutuŋa kudi Nzambi, dakadi kutuŋa namakasa, dahayanyaka mumawulu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.1",
            "verseOrgIds": [
              "2CO.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa chalala mwitenti idi twaabaŋa, twakeŋa aŋa nankashi netu akatuvwiki itala detu dakwiwulu; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.2",
            "verseOrgIds": [
              "2CO.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulonda chakatuvwikawu, akabuli kutuwana nzekesi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.3",
            "verseOrgIds": [
              "2CO.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa chalala etu tudi mwitenti idi twaabaŋa, twatiyaloŋa kulema; hitunakeŋi netu akatuvúuluku, ilaŋa netu akatuvwiki, kulonda ichi chanoŋaŋa akachiminyi kudi wumi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.4",
            "verseOrgIds": [
              "2CO.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwu watwilili chumichi Nzambi, watwinkeli chikilu chaSpiritu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.5",
            "verseOrgIds": [
              "2CO.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.5",
            "verseOrgIds": [
              "2CO.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu, twadinkaŋaku mafuku ejima, muloŋa tuneluki netu, hituchidi kushakama mumujimba, hitwashakamaŋa naMwantaku; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.6",
            "verseOrgIds": [
              "2CO.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "muloŋa twendaŋa kwanakukuhwelela hohu, hichakumona namesuku. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.7",
            "verseOrgIds": [
              "2CO.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neli nami etu twadinkaŋaku, tunakeŋi netu chachiwahi tubuli kushakama mumujimba, tushakami kweetu naMwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.8",
            "verseOrgIds": [
              "2CO.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi hela tudi kweetu, hela tudi kwacheŋi, twashaŋa muchima netu tumutiyishaŋa yena kuwaha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.9",
            "verseOrgIds": [
              "2CO.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wejima wetu chiŋa twakamwekana kwitanda daKristu dakusompela; kulonda twakatambuli yuma yitwelili hitwadiŋi munyijimba hamuntu hamuntu, iwu mweliliyi, iwu mweliliyi, hela yayiwahi hela yatama.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.10",
            "verseOrgIds": [
              "2CO.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.10",
            "verseOrgIds": [
              "2CO.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chitweluka kutiya Mwanta woma, dihu hanafumi kushinjila antu; ilaŋa tunamwekani kudi Nzambi, nakuhweleli nami tunamwekani nikuchinleji chamuchima wenu nawa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.11",
            "verseOrgIds": [
              "2CO.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hitukudishimuna cheŋi kudenu netu mutwitejuku, ilaŋa tukuyileja nsaŋu yakudisambila hadetu, kulonda mwakamoni chakuyakula nachu antu akudisamba chakumesu, bayi chakumuchimaku.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.12",
            "verseOrgIds": [
              "2CO.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.15",
            "verseOrgIds": [
              "2CO.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi kufumisha kulelu hituneluki muntu chadiyi mumujimbaku; hela twelukili Kristu chadiŋiyi mumujimba, katataka hitwamwiluka nawa cheŋi chochochuku. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.16",
            "verseOrgIds": [
              "2CO.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi muntu wudi mudi Kristu, anamuleŋi dehi chachiha; yuma yayikulu yinahiti dehi, komana yuma yejima yinabalumuki dehi yayiha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.17",
            "verseOrgIds": [
              "2CO.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa yuma yejima yakudi Nzambi, watukundamishili kudi yomweni mudi Kristu, watwinkeli mudimu wakushimuna nsaŋu yakukundamisha; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.18",
            "verseOrgIds": [
              "2CO.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CO 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "yadiŋiyi Nzambi mudi Kristu nakukundamisha antu ampata yamunu mwishina kudi yomweni, nákubula kuyifuukwila nyiloŋa yawu; natukunjiki mazu akukundamisha.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.19",
            "verseOrgIds": [
              "2CO.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CO 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.19",
            "verseOrgIds": [
              "2CO.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CO 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi etu tuyatuŋanda twaKristu; chidi neyi Nzambi hakuyilembelela mudetu. Hitukuyilembelela hamujimba waKristu netu, kundamenu kudi Nzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.20",
            "verseOrgIds": [
              "2CO.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CO 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwu Yesu wabulili kwiluka nshidi, diyi elishiliyi ekali nshidi kukoola etu, kulonda etu twi kali kuloŋa kwaNzambi mudi yena.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.21",
            "verseOrgIds": [
              "2CO.5.21"
            ]
          }
        }
      ]
    }
