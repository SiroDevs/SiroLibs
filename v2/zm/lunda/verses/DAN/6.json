            "sid": "DAN 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikupulwisha antu diyi, nikuyihandisha diyi, diyi nawa wakoŋaŋa yinjikijilu nayihayamisha nimwiwulu nihamaseki. Diyi nahandishi Danyeli kudi anyitupa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.27",
            "verseOrgIds": [
              "DAN.6.27"
            ]
          }
        }
