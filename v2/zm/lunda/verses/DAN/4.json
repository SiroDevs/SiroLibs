        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami Nebukaneza nasoneki mukanda wakutemeshela antu amwacheŋi namwacheŋi ejima, ninyuza yawantu yejima, niakwamadimi eŋi naŋi ejima, ashakama mwahita iseki dejima. Kuwunda kuyivulili. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.1",
            "verseOrgIds": [
              "DAN.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natoŋojoki nami chachiwahi kushimuna niyinjikijilu, niyihayamisha yanankoŋiyi Nzambi Wabadika Mwiwulu. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.2",
            "verseOrgIds": [
              "DAN.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yinjikijilu yindi o kutoha! Yihayamisha yindi o chiyasweja Ŋovu! Wanta windi hiwanta wahaya nyaka nanyaka, kuyula kwayulaŋayi yena kwakwila mufwawa muhiŋawa, mufwawa muhiŋawa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.3",
            "verseOrgIds": [
              "DAN.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.3",
            "verseOrgIds": [
              "DAN.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami Nebukaneza nadiŋi nakushakama mwitala dami chachiwahi, nadiŋi nakuluŋa muchipaŋu chami. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.4",
            "verseOrgIds": [
              "DAN.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinukulota chuma chantiyishili woma. Niyitoŋojoka yami yinatoŋojokeli hakadidi kami, niyuma yinamweni kunamutu wami yaloŋakamishili. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.5",
            "verseOrgIds": [
              "DAN.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi nashilumu lushimbi lwakumpompeshela akwamaana amuBabiloni ejima, kulonda akanlumbulwili chachiwahi mwaya kulota kunaloteli. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.6",
            "verseOrgIds": [
              "DAN.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niatutepa, niakwakutala tutumbwa, niaKaladeya, niatuneŋa, enjili munadiŋi. Ami nayawilili munaloteli, ilaŋa wena akaŋenyi kunlumbulwila muchayili. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.7",
            "verseOrgIds": [
              "DAN.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkumininaku Danyeli wenjili nakwimana kumesu ami, diyi atumbawu nawu Beleteshaza, mwomwekala niijina damukishi wami, mudi yena dimu mwekala spiritu yaNzambi wajila. Ami namwawilili munaloteli, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.8",
            "verseOrgIds": [
              "DAN.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nami, Eyi Beleteshaza, yeyi mukulumpi wawatutepa, neluki dehi nami mudeyi mwekala spiritu yaNzambi wajila, hikwekala chuma chakujinda chakwakamishaŋa eyuku, nleji dinu yimwenu yamukulota yinamoni, nlumbulwili muyaya.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.9",
            "verseOrgIds": [
              "DAN.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.9",
            "verseOrgIds": [
              "DAN.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiya yuma yinamweni kunamutu wami hakadidi kami. Namweni mutondu fwi-i mukachi kampata yahamaseki, wasweja kuleha. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.10",
            "verseOrgIds": [
              "DAN.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutondu owu hiwukukula, hiwukwikala naŋovu, insa yawu hiyikushika nimwiwulu, wenda wumwekana ho-o kunsa yampata kwejima. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.11",
            "verseOrgIds": [
              "DAN.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafu awu amawahi, ninyikabu yawu yayivulu, wadiŋi nayakudya yakuwanina antu ejima. Anyama amwisaŋa abatamini muwulelu wawu, atujila ahaluzwizu atunta mini munyitayi yawu, akwanyijimba ejima hiyakudiilaku.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.12",
            "verseOrgIds": [
              "DAN.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.12",
            "verseOrgIds": [
              "DAN.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyimwenu yakunamutu wami yinamweni hakadidi kami, namweni mukwakutalatala, mukwakujila, hakufuma mwiwulu nakwinza mwishina. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.13",
            "verseOrgIds": [
              "DAN.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabidikili naŋovu, welili nindi, Temenu owu mutondu, sakululenu nyitayi yawu, nyikumunenu mafu awu, palaŋeshenu nyikabu yawu; awa anyama afumi mwishina dawu, niatujila afumi munyitayi yawu. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.14",
            "verseOrgIds": [
              "DAN.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwinza chishinji chawu shiyenu mumaseki yakukasa nakankasi kachikuŋu nawuneŋu, yishali mumunyenvu wamatahu amwisaŋa; wuzowaŋa nawuumi wamuluzwizu. Akadyaloŋa matahu indi hamu nawanyama. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.15",
            "verseOrgIds": [
              "DAN.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muchima windi wadiŋi wamuntu wubalumuki, amwinki muchima wakanyama. Hadi yena hakahiti mpinji jitanu najiyedi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.16",
            "verseOrgIds": [
              "DAN.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsaŋu yinu hinshimbiyawakwakutalatala. Hinsaŋu yambala yamukanwa kawakwakujila; kulondaakwakuhanda akeluki nawu komana Mukwakubadika Mwiwulu diyiwayulaŋa wanta wawantu, wawinkaŋa muntu anatoŋoliyi yowu, wadiishaŋamu wanta antu amukunkulu akadi kulema. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.17",
            "verseOrgIds": [
              "DAN.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami mwanta Nebukanezanaloti mwenimu. Eyi Beleteshaza, nlumbulwili muchaya, muloŋa akwamaana amwituŋa dami ejima anakaŋanyi kunlumbulwila muchaya, ilaŋaeyi kweyi wukutwesha, muloŋa mudeyi mwekala spiritu yaNzambiwajila.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.18",
            "verseOrgIds": [
              "DAN.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.18",
            "verseOrgIds": [
              "DAN.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Danyeli, atumbawu nawu Beleteshaza, hakuhayama, hayamee. Yitoŋojoka yindi yamwakamishili. Mwanta hakumwila nindi, Eyi Beleteshaza, bayi wakama munaloti hela kulumbululamuku. Beleteshaza hakumwila nindi, Eyi nkaka yami, kulota kuwunaloti adi kuchimona kudi akuhelaŋa, hela muchaya adi kumonamu kudi ayilumbu jeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.19",
            "verseOrgIds": [
              "DAN.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutondu wamona, wadiŋi nakukula, wadiŋi naŋovu, washika nimwiwulu, wamwekana mwahita iseki dejima; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.20",
            "verseOrgIds": [
              "DAN.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "wadiŋi namafu amawahi, wasoŋa ninyikabu yayivulu, wadiŋi nayakudya yakuwanina antu ejima, mwishina dawu mwashakama anyama amwisaŋa, wukweti ninyitayi yadiŋi nakushakama atujila ahaluzwizu; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.21",
            "verseOrgIds": [
              "DAN.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DAN 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "mutondu owu yeyi mwanta, yeyi wunakuli, wunakwati Ŋovu; muloŋa kulema kweyeyi kunakuli, kunashiki nimwiwulu, wanta weyi wunashiki nikwakumina iseki. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.22",
            "verseOrgIds": [
              "DAN.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ochu chamonayi mwanta mukwakutalatala, mukwakujila, hakufuma mwiwulu hakwinza mwishina, hakwila nindi, Temenu owu mutondu, muwukisaŋani; shiyenu chishinji ninyiji yachu mumaseki, chakukasa nakankasi kachikuŋu nawuneŋu, chakashali mumunyenvu wamatahu amwisaŋa; wakazowaŋa nawuumi wamuluzwizu; akadyaloŋa hamu nawanyama amwisaŋa, ninichi chihakahita hadi yena mpinji jitanu najiyedi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.23",
            "verseOrgIds": [
              "DAN.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiya muchaya, eyi mwanta, hilushimbi lwambala lwaMukwakubadika Mwiwulu, dilu lunashiki dehi hadi nkaka yami mwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.24",
            "verseOrgIds": [
              "DAN.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi akakuhaŋa mukachi kawantu, wakashakama hamu nawanyama amwisaŋa, akakudiishaŋa matahu neyi ŋombi, wakazowaŋa nawuumi wahaluzwizu, mpinji jitanu najiyedi jakahita hadeyi, nichiwamba keluka neyi komana Mukwakubadika Mwiwulu diyi wayulaŋa wanta wawantu, diyi wawinkaŋa anatoŋoliyi yowu. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.25",
            "verseOrgIds": [
              "DAN.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ochu chelawu nawu akashiyi chishinji chamutondu ninyiji yachu, wanta weyi wakela weyeyi chikupu, neyi wuneluki dehi neyi amwiwulu diwu ayulaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.26",
            "verseOrgIds": [
              "DAN.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu mwanta, itŋiaku munukukuleja, lekaku nshidi jeyi wilaŋa mwaloŋa, lekaku muwaluwaluwaŋa, wuyikoŋelaŋa atuzweŋi yaluwi; wamba kela akakwanakena, wakashakama chachiwahi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.27",
            "verseOrgIds": [
              "DAN.4.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.27",
            "verseOrgIds": [
              "DAN.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DAN 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yumiyi Nebukaneza wayimweni yejima. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.28",
            "verseOrgIds": [
              "DAN.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DAN 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimuneli tukweji ikumi natuyedi hitukuya nakumana, yena wadiŋi nakwendola muchipaŋu chindi chawanta chamuBabiloni. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.29",
            "verseOrgIds": [
              "DAN.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DAN 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta hakuhosha nindi, Iwu hidiyi Babiloni munenuku? Nawutuŋa dehi naŋovu jami jasweja; wikali mwami mwakushakama mwawanta, kulonda mpuhu yawanta wami yisweji. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.30",
            "verseOrgIds": [
              "DAN.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DAN 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iku izu dichidi tuhu mukanwa kamwanta, kwiwulu kuholoka niizu, nawu, Eyi mwanta Nebukaneza, anakuleji dehi; wanta weyi wunakufumi dehi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.31",
            "verseOrgIds": [
              "DAN.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DAN 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akukutemuna hadi antu, wakashakama hamu nawanyama amwisaŋa, akakudiishaŋa matahu neyi ŋombi, mpinji jitanu najiyedi jakahita hadeyi, ninichi chiwakeluka neyi Mukwakubadika Mwiwulu diyi wayulaŋa muwanta wawantu, diyi wawinkaŋa anatoŋoliyi yowu. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.32",
            "verseOrgIds": [
              "DAN.4.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DAN 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoyena mpinji oyu Nebukaneza wamweni chumochu. Amutemwini hadi antu, hakudyaloŋa matahu neyi ŋombi, mujimba windi hiwukuzowaŋa nawuumi wamuluzwizu; nsuki jindi jaleheli neyi mavuji ambuulu, mazalindi aleheli neyi mazala awatujila.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.33",
            "verseOrgIds": [
              "DAN.4.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DAN 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.33",
            "verseOrgIds": [
              "DAN.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "DAN 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chakumini wena mafuku owu, ami Nebukaneza hinukutala mwiwulu, hinukukiswila Mukwakubadika Mwiwulu nkisu, hinukumuhameka nakumulemesha yena wahanda haya nyaka; muloŋa kuyula kwindi kwahaya nyaka, niwanta windi saŋa wayila mufwawa muhiŋawa, mufwawa muhiŋawa. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.34",
            "verseOrgIds": [
              "DAN.4.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "DAN 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu ejima ashakama hamaseki wayifuukula neyi hiyekala nikwokuku. Hela hayileŋaleŋa yamwiwulu, hela hadi ashakama hamaseki wakuminaŋa dakwila mwomwaya muchima windi hohu; kwosi muntu niwumu wukutwesha kumweta kuchikasa, hela kumwila nindi, Eyi wudi nakwila ŋahuku?",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.35",
            "verseOrgIds": [
              "DAN.4.35"
            ]
          }
        }
      ]
    },
