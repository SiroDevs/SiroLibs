          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.11",
            "verseOrgIds": [
              "REV.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaŋelu wamuchiwana hakwimba; nichibalu chetaŋwa chamuchisatu acheta nikucheta, nichibalu chakakweji chamuchisatu, nichibalu chatutumbwa chamuchisatu; kulonda chibalu chawu chamuchisatu chibalumuki kwiyila, nimwaana wubuli kumwekana chibalu chawu chamuchisatu, niwufuku chochimu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.12",
            "verseOrgIds": [
              "REV.8.12"
            ]
          }
        }
      ]
    },
