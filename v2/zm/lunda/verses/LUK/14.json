{
  "id": "LUK.14",
  "number": "14",
  "bookId": "LUK",
  "reference": "Luka 14",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "LUK 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hasabata yimu, cheŋililiyi mwitala danyuli yawaFwarisi wumu adiyi nindi, hiyakumushinshika swi-i. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.1",
            "verseOrgIds": [
              "LUK.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwatalishiliyi mesu indi kudi muntu wukweti musoŋu wandondu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.2",
            "verseOrgIds": [
              "LUK.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakuhosha nawakwanshimbi nawaFwarisi nindi, Kúuka hasabata chaloŋa, tahindi nehi? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.3",
            "verseOrgIds": [
              "LUK.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wena chochamwenawu kwazo-o. Hakumukwata, hakumúuka, hakumwila nindi, Yaŋa kweyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.4",
            "verseOrgIds": [
              "LUK.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyila nindi, Mwinenwinyi wukwila neyi wukweti chimbulu hela ŋombi, aholokela mwishima hasabata, alabajala nakumukokamu? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.5",
            "verseOrgIds": [
              "LUK.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyamweni mwakumwakwila cheŋi mazu awaku.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.6",
            "verseOrgIds": [
              "LUK.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.6",
            "verseOrgIds": [
              "LUK.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chamweniyi owu antu atambikiluwu hiyakutonda kushakama halema hohu, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.7",
            "verseOrgIds": [
              "LUK.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakuyitila chishimu nindi, Neyi anakutambiki kumawija akusumbwisha, bayi wutonda kushakama halemaku, hamwaha anatambiki dehi muntu wabadikeyi kulema; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.8",
            "verseOrgIds": [
              "LUK.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "chakwinzayi owu natambiki nineyi niyenowu, hakukwila nindi, Aha hambala haniwu. Chiwukutachika kuya habula kulema, o jinsonyi! ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.9",
            "verseOrgIds": [
              "LUK.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi anakutambiki, sambilaku kushakama habula kulema; chakwinzayi owu nakutambiki akwili nindi, Eyi ibwambu dami, inzaku wushakami hanu halema; akakumona kulema kudi akwenu ejima wunashakami nawu nakudya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.10",
            "verseOrgIds": [
              "LUK.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa muntu wukuditohesha akamukehesha; nimuntu wukudikehesha akamutohesha.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.11",
            "verseOrgIds": [
              "LUK.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.11",
            "verseOrgIds": [
              "LUK.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakumwila owu muntu wamutambi kili, nindi, Neyi wukuteleka chawija chamwaana hela chamelela, bayi wutambika amabwambu jeyi hela ana kweyi hela awusoku weyi, hela akwenu ahetaku; akenda kakutambika nineyi nawa, akakuhiŋishilamu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.12",
            "verseOrgIds": [
              "LUK.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi wukuteleka chawija cheyi, katambiki atuzweŋi, niayifwayi, niakwakubalakata, niamputamesu, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.13",
            "verseOrgIds": [
              "LUK.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulonda wukooleki; muloŋa wena hiyakweti yakukuhiŋishilamuku, akakuhiŋishilamu hamba kasaŋuka akwakuloŋa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.14",
            "verseOrgIds": [
              "LUK.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.14",
            "verseOrgIds": [
              "LUK.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazu awa chanayitiyuwu kudi muntu wumu, wadiŋi hamu nawenowu ashakaminiyi nawu nakudya, hakumwila nindi, Muntu wakadya muwanta waNzambi nakooleki. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.15",
            "verseOrgIds": [
              "LUK.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakumwila nindi, Muntu wumu watelekeli chawija cheneni, hakushiikashiika antu amavulu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.16",
            "verseOrgIds": [
              "LUK.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpinji yakudya chawija chiyinashiki, hakutemesha nduŋu yindi nindi, Yaŋa wutambiki ashiikawu dehi neyi, Inzenuŋa, yuma yejima aloŋesha dehi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.17",
            "verseOrgIds": [
              "LUK.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wejima wawu hiyakutachika kuleyaleya namuchima wawu wumu hohu. Watachi nindi, Nalandi iha dami, nakeŋi niyi nakuditala; aŋiteji mwani kushala. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.18",
            "verseOrgIds": [
              "LUK.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukwawu nawa nindi, Nalandi ikumi daŋombi jakudimisha, nakeŋi niyi nakujeseka; aŋiteji mwani kushala. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.19",
            "verseOrgIds": [
              "LUK.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukwawu nawa nindi, Nasumbuli iŋodami, hinukutwesha kuyaku. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.20",
            "verseOrgIds": [
              "LUK.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owu nduŋu hakwinza, hakumuleja nkaka yindi yumiyi. Owu mwanta wetala hakuzuwa, hakumwila nduŋu yindi nindi, Yaku swayi munyikwakwa ninamutujila twamumukala, wuletaleti atuzweŋi, niayifwayi, niamputamesu, niakwakubalakata, wuyijiŋumu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.21",
            "verseOrgIds": [
              "LUK.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owu nduŋu hakumwila nkaka yindi nindi, Mwanta, neli dehi muwunanleji, ilaŋa munashali mwakushakama antu amakwawu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.22",
            "verseOrgIds": [
              "LUK.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta hakumwila nduŋu yindi nindi, Yaku munjila jakula, ninamutunyilamba, wuyikanjikiji eŋilumu, kulonda mwitala dami mwinzali to-o. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.23",
            "verseOrgIds": [
              "LUK.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulona nukuyileja nami, awa antu ashiikiluwu, hosi niwumu wakatompa kuchawija chamuku.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.24",
            "verseOrgIds": [
              "LUK.14.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.24",
            "verseOrgIds": [
              "LUK.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwadiŋi nakuyayi himukuya nimazaza awantu amavulu; yena hakushetumuka, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.25",
            "verseOrgIds": [
              "LUK.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakuyila nindi, Muntu wukwinza kudami chakadi kuhela tata yindi, nimama yindi, niŋodindi, ni anyanindi, niana kwindi, niahelindi, eŋa, hela wumi windi yomweni, hakutwesha kwikala kambanji kamuku. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.26",
            "verseOrgIds": [
              "LUK.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu wukubula kusenda kulusu yindi nakunlondami, hakutwesha kwikala kambanji kamuku. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.27",
            "verseOrgIds": [
              "LUK.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwinenwinyi wukwila neyi wukukeŋa kutuŋa itala deneni, wukubula kusambila kusnakama nakuchinda mali achidi kochu, atali neyi wukweti mali akudimanisha nachu? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.28",
            "verseOrgIds": [
              "LUK.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamba kela wukwala kwachikuku hohu, kumanisha nehi, antu ejima akutalaku hiyakutachika kumuseha, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.29",
            "verseOrgIds": [
              "LUK.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "nawu, Iwu muntu wakuminini dakutachika kutuŋa hohu, kumanisha nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.30",
            "verseOrgIds": [
              "LUK.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela mwantanyi wukwila neyi wukukeŋa kuya nakulwa njita namwanta mukwawu, wukubula kusambila kushakama nakutoŋojoka nindi, ami nidi namakombakaji ikumi hohu; nukutwesha kuya nakumonaŋana namwantowu wudi nakwinza namakombakaji makumi ayedi kwaamu, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.31",
            "verseOrgIds": [
              "LUK.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi hanatweshuku, wukunyakala kutemeshaŋahu dehi atuŋanda akwihula mwakuvu mbikilawu ikala, hohachidiyi mukwawu kwakulehi nankashi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.32",
            "verseOrgIds": [
              "LUK.14.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi nimwinenu wukubula kuleka yadiyi nayu yejima, hakutwesha kwikala kambanji kamuku.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.33",
            "verseOrgIds": [
              "LUK.14.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.33",
            "verseOrgIds": [
              "LUK.14.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muŋwa wawuwahi; neyi muŋwa wuneli dehi wasamuka, akutwesha kuwutoweja cheŋi nanka? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.34",
            "verseOrgIds": [
              "LUK.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiwukutelela nawa cheŋi hamaseki hela hezeleluku, akuwunata tuhu. Yowu wukweti matu akutiya atiyi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.35",
            "verseOrgIds": [
              "LUK.14.35"
            ]
          }
        }
