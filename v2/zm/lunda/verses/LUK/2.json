          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanamanishuwu yuma yakunshimbi jaYehova yejima, hiyakufunta kuŊaliliya kumukala wawu awenawu kuNazareta. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.39",
