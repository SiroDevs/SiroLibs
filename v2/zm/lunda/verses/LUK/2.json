          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "henohu wela dehi nfwila wanyaka makumi atanu nasatu nanyaka yiwana; hafuminaŋa mutembeluku, wafukaminaŋa niwufuku nimwaana, nakulembelela kwakujiŋojoka nanzala yakuleka kudya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.37",
            "verseOrgIds": [
