          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Helili nashiki dehi munyaka ikumi nayiyedi, hiyakukanduka kuYerusalema mwomuchaaku chachawijochu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.42",
            "verseOrgIds": [
              "LUK.2.42"
            ]
          }
