              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eŋa, mpoku yakabali yakapwika mumuchima weyeyi aweni zwa, kulonda kumwekesha yitoŋojoka yajindawu antu amavulu munyichima yawu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.35",
