          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anvwali jindi ayilaŋa kuYerusalema hamwaka hamwaka hachawija chapaseka. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.41",
            "verseOrgIds": [
