          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana hakuya nakukula, akwata niŋovu, asweja nima ana; amutiya nikuwaha kudi Nzambi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.40",
