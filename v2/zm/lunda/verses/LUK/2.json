          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena mpinji oyu hakwinza, hakusakilila Nzambi, hakumushimuna kudi antu ejima adiŋi nakutalila kukuula kwamba kakúulawu Yerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.38",
