          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chabuliluwu kumumona, hiyakufunta cheŋi kuYerusalema nakumukeŋakeŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.45",
            "verseOrgIds": [
              "LUK.2.45"
            ]
          }
