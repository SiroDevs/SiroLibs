  "verseCount": 56,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "LUK 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakutambika ikumi nayedi hamu, hakuyinka Ŋovu niwanta wakufumisha ademoni ejima nikuuka nyisoŋu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.1",
            "verseOrgIds": [
              "LUK.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyitemesha nakushimuna wanta waNzambi, nikuuka akata. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.2",
            "verseOrgIds": [
              "LUK.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyila nindi. Bayi musenda yuma yakuya nachu munjila yenuku; hela mbwechi, hela ipakumuna, hela yakudya, hela mali; hela kwikala nayikovwelu yiyedi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.3",
            "verseOrgIds": [
              "LUK.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itala dimwakeŋa ila mwakashakama mwomwenomu, diku nawa kumwakanyamukila. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.4",
            "verseOrgIds": [
              "LUK.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu akabula kuyitambula, chimwakanyamuka mumukalowu, mwakadikumuna lunkuŋu ludi kunyendu yenu, kulonda lwinzi lwakayikonkololi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.5",
            "verseOrgIds": [
              "LUK.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakunyamuka, hiyakuya nakushimuna nsaŋu yayiwahi mwahita nyikala yejima, nikuuka hamu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.6",
            "verseOrgIds": [
              "LUK.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.6",
            "verseOrgIds": [
              "LUK.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta Herodi chanatiyiyi yuma yeliluwu yejima, hakusweja kujinoka; muloŋa amakwawu elili nawu Yowanu nasaŋuki mudi afu; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.7",
            "verseOrgIds": [
              "LUK.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "amakwawu nawu Elija diyi namwekani dehi; acheŋi nawu kaprofwetu wakunyaka diyi nasaŋuki. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.8",
            "verseOrgIds": [
              "LUK.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchinka Herodi nindi, Yowanu yowu naketwili dehi namutu, indi iwu nidi nakutiya nsaŋu ŋi hinyi? Hakukeŋa nindi amumoni.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.9",
            "verseOrgIds": [
              "LUK.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.9",
            "verseOrgIds": [
              "LUK.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apostolu chanafuntuwu, hiyakumuleja yuma yeliluwu. Hakuyitwala kumbadi kwisaŋa dakwakwihi namukala weneni wumu, ijina dawu Beteseda.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.10",
            "verseOrgIds": [
              "LUK.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.17",
            "verseOrgIds": [
              "LUK.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chadiŋi nakulombayi kwakanka windi, atumbanji adiŋi chimu nayena; hakuyihula nindi, Mazaza elaŋa nawu yaminyi? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.18",
            "verseOrgIds": [
              "LUK.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wena hiyakwakula nawu, Amakwawu elaŋa nawu yeyi Yowanu Mpapatishu; amakwawu nawu yeyi Elija; acheŋi nawu kaprofwetu wakunyaka wumu diyi nasaŋuki. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.19",
            "verseOrgIds": [
              "LUK.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena hakuyila nindi, Indi enu aweni mwelaŋa nenu yaminyi? Petulu hakwakula nindi, Yeyi Kristu waNzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.20",
            "verseOrgIds": [
              "LUK.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena hakuhosha nawu naŋovu, hakuyilekesha nindi, Bayi muleja muntuku; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.21",
            "verseOrgIds": [
              "LUK.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "muloŋa Mwana kamuntu chiŋa yokaba yuma yayivulu, chiŋa akamuleka kudi awakulumpi, nikudi awakulumpi jawatupristu, nikudi ansoneki, akamujaha, akamusaŋula hetaŋwa damu chisatu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.22",
            "verseOrgIds": [
              "LUK.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.22",
            "verseOrgIds": [
              "LUK.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyila wejima wawu nindi, Muntu wukukeŋa kunlondami, adibondi yomweni, anyamunaŋa kulusu yindi hefuku hefuku, anlondaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.23",
            "verseOrgIds": [
              "LUK.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa muntu wukukeŋa kuhemba wumi windi, diyi wakawujimbesha; hakwila wukujimbeshela wumi windi hamujimba wamami, diyi wakawuhemba. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.24",
            "verseOrgIds": [
              "LUK.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa muntu, hela naheti matuŋa ejima adijimbesha yomweni, hela wukúumba wumi windi, wukudiilaku chumanyi? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.25",
            "verseOrgIds": [
              "LUK.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "muloŋa muntu wukutiya nsonyi jamami nŋamazu ami, ni mwana kamuntu wakamutiya nsonyi hakenzayi nalubanji lwakulema kwindi yomweni, nikwaTata yindi nikwawaŋelu ajila. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.26",
            "verseOrgIds": [
              "LUK.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyenu niyileji mwalala nami, awa amakwawu anemani kunu, hiyakusambilaŋahu dehi kumona kufwaku, chiŋa anamoni wanta waNzambi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.27",
            "verseOrgIds": [
              "LUK.9.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.27",
            "verseOrgIds": [
              "LUK.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chelili munahiti dehi mafuku atanu nasatu nanochu hahosheliyi yumiyi, hakutwala aPetulu naYowanu niYakoba, hakukanduka nawu hampidi kulonda alombi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.28",
            "verseOrgIds": [
              "LUK.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hadiŋi nakulombayi, kumesu indi hikukubalumuka mwacheŋi hohu, mahinindi hiyakusweja kutooka, kutwesha kutalaku nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.29",
            "verseOrgIds": [
              "LUK.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutala hakuhanjika nawamayala ayedi, diwu aMosi naElija; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.30",
            "verseOrgIds": [
              "LUK.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "hiyakumwekana nalubanji lwakulema, hiyakutena kufwa kwindi kwakuYerusalema kwakukeŋa kufumayi nachu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.31",
            "verseOrgIds": [
              "LUK.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petulu nawakwawu adiŋiyi nawu kwakunoŋoka tulu hohu. Chanatonuwu chikupu, hiyakumona lubanji lwakulema kwindi, niwenowu amayala ayedi emeniyi nawu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.32",
            "verseOrgIds": [
              "LUK.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cheliluwu hiyakwambuka nindi, Petulu hakumwila Yesu nindi, Mwanta chachiwahi chitudi kunu; tutuŋi yisolu yisatu; chimu cheyeyi, chimu chaMosi, chikwawu chaElija; helukili ninimu mwahoshelaŋayuku. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.33",
            "verseOrgIds": [
              "LUK.9.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iku wuchidi kuhosha mazu awa, ivu hidikwinza nakuyizeŋamina, atiya niwoma ochu chaneŋiluwu mwivu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.34",
            "verseOrgIds": [
              "LUK.9.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwivu himukufuma izu nawu, Diyi Mwanami nakeŋa, mutiyililenu yena. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.35",
            "verseOrgIds": [
              "LUK.9.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 9:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izu chidinamweni, hiyakumona kwaYesu hohu kanka windi. Amwena nizo; wena mafuku owu hiyalejeli muntu yuma yamwenuwuku.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.36",
            "verseOrgIds": [
              "LUK.9.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 9:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.36",
            "verseOrgIds": [
              "LUK.9.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 9:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chikunachi chaneluwu anakunkumuki dehi mwishina dampidi, izaza deneni hidikwinza nakumukinkilila. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.37",
            "verseOrgIds": [
              "LUK.9.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 9:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwizaza himukubidika muntu wumu nindi, Eyi Nkuluŋaŋa, nalembi mwani wutali mwanami, muloŋa himwanami wumu hohu; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.38",
            "verseOrgIds": [
              "LUK.9.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 9:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "amukwataŋa kudi demoni, kukasumuka hakukaloka; hakumukonyesha, hakwidisha nimafulolu kukanwa, hakumuchika nankashi, kumufuma swayi nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.39",
            "verseOrgIds": [
              "LUK.9.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 9:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nayilembelela atumbanji tweyi nami amufumishi; akaŋanya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.40",
            "verseOrgIds": [
              "LUK.9.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 9:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakwakula nindi, Enu antu akuchisakichi, mwabula kukuhwelela, mwaheŋa, nyaka yinukwikala nanenu nakukabakana nanenu yiŋahi? Muleti mwaneyi kunu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.41",
            "verseOrgIds": [
              "LUK.9.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 9:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iku wuchidi kwinza, demoni amunata nihamaseki, hakumukonyesha nankashi. Yesu hakuhoshola demoni wazonda, yomúuka ninowu mwana, amufuntisha nikudi tata yindi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.42",
            "verseOrgIds": [
              "LUK.9.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 9:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu ejima hiyakuhayama Ŋovu yawanta waNzambi yinamwekani.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.43",
            "verseOrgIds": [
              "LUK.9.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 9:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iku achidi kuhayama yuma yeliliyi yejima, hakuyila atumbanji twindi, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.43",
            "verseOrgIds": [
              "LUK.9.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 9:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Toŋojokenu chachiwahi mazu inukukeŋa kuyileja, nami, Mwana kamuntu akamuhana kumakasa awantu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.44",
            "verseOrgIds": [
              "LUK.9.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 9:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wena kwiluka izu odu nehi, ayijindilidu kulonda abuli kushinshika mudaya; hiyakutiya woma wakumwihuladu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.45",
            "verseOrgIds": [
              "LUK.9.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 9:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.45",
            "verseOrgIds": [
              "LUK.9.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 9:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukachi kawu himukuvulumuka ntadi yakwila nawu nabadiki akwawu hinyi? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.46",
            "verseOrgIds": [
              "LUK.9.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LUK 9:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu chanamoniyi mudi nakutoŋojokawu munyichima yawu, hakunona mwana wanyanya, hakumwimika kwakwihi nachikasa chindi; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.47",
            "verseOrgIds": [
              "LUK.9.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LUK 9:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakuyila nindi, Muntu wukutambula mwana wanyanyiwu mwijina dami nantambulami; wukuntambulami natambuli niyena wantemesheli; muntu nakehi mukachi kenwenu ejima, diyi muneni.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.48",
            "verseOrgIds": [
              "LUK.9.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LUK 9:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.48",
            "verseOrgIds": [
              "LUK.9.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LUK 9:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowanu hakwakula nindi, Mwanta, twamona muntu wudi nakufumisha ademoni mwijina deyi; twamulekesha muloŋa hitwalondelaŋa chimuninduku. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.49",
            "verseOrgIds": [
              "LUK.9.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LUK 9:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakumwila nindi, Bayi mumulekeshaku; muloŋa wabula kuyihela diyi mwinenu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.50",
            "verseOrgIds": [
              "LUK.9.50"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LUK 9:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.50",
            "verseOrgIds": [
              "LUK.9.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LUK 9:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chelili mafuku akumutambula mwiwulu hiyakukeŋa kushika, asha nimesu indi naŋovu munjila yakuya kuYerusalema. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.51",
            "verseOrgIds": [
              "LUK.9.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LUK 9:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakutemesha ŋahu dehi atuŋanda kwakuyayi; hiyakuya, eŋila nimumukala wawaSamariya wumu, nawu amuloŋesheli. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.52",
            "verseOrgIds": [
              "LUK.9.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LUK 9:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wena kumutambula nehi, nanochu chamwenuwu mesu indi anatali kuYerusalema. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.53",
            "verseOrgIds": [
              "LUK.9.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "LUK 9:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanachimonuwu, atumbanji twindi aYakoba naYowanu hiyakumwila Mwanta nawu, Wunakeŋi tutambiki kesi kaholoki mwiwulu kayijilishi neyi cheliliyi Elija, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.54",
            "verseOrgIds": [
              "LUK.9.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "LUK 9:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena hakushetumuka, hakuyihoshola nindi, Himweluka chekala spiritu yenuku. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.55",
            "verseOrgIds": [
              "LUK.9.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "LUK 9:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana kamuntu henjili nakujilisha antuku, wenjili nakuyihandisha. Hiyakuya kumukala wukwawu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.56",
            "verseOrgIds": [
              "LUK.9.56"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "LUK 9:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.56",
            "verseOrgIds": [
              "LUK.9.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "LUK 9:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayilaŋawu munjila, muntu wumu hakumwila nindi, Nukukulondaŋa kwejima kuwukuya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.57",
            "verseOrgIds": [
              "LUK.9.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "LUK 9:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakumwila nindi, Anyumbu akweti menawu, niatujila ahaluzwizu akweti yisakala yawu; hakwila Mwana kamuntu hakweti hakusachila namutu winduku. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.58",
            "verseOrgIds": [
              "LUK.9.58"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "LUK 9:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakumwila muntu mukwawu nindi, Nlondaŋa; ilaŋa yena nindi, Mwanta, nleki nisambili kuya nakajiiki tata yami. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.59",
            "verseOrgIds": [
              "LUK.9.59"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "60",
            "style": "v",
            "sid": "LUK 9:60"
          },
          "items": [
            {
              "text": "60",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakumwila nindi, Yileki afu ajiiki afu jawu awenawu; eyi yaloŋa nakushimojola wanta waNzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.60",
            "verseOrgIds": [
              "LUK.9.60"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "61",
            "style": "v",
            "sid": "LUK 9:61"
          },
          "items": [
            {
              "text": "61",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukwawu niyena nawa hakumwila nindi, Mwanta, nukukulonda; nleki niyi nakashaliki akwetala dami. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.61",
            "verseOrgIds": [
              "LUK.9.61"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "62",
            "style": "v",
            "sid": "LUK 9:62"
          },
          "items": [
            {
              "text": "62",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakumwila nindi, Muntu wukwila nakwati dehi kwitemwa hakutala munyima, hanateli wanta waNzambi uku.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.62",
            "verseOrgIds": [
              "LUK.9.62"
            ]
          }
        }
      ]
    }
