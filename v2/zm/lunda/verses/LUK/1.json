          },
          "items": [
            {
              "text": "73",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwokusanyika kwasanyikililiyi nkakulula yetu Abarahama; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.73",
            "verseOrgIds": [
              "LUK.1.73"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "74",
            "style": "v",
            "sid": "LUK 1:74"
          },
          "items": [
            {
              "text": "74",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulonda chakutwamwinayi kumakasa awakwankunyi netu, twakamukala kelaŋa kumesu indi chakadi woma, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.74",
            "verseOrgIds": [
              "LUK.1.74"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "75",
            "style": "v",
