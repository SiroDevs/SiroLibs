          },
          "items": [
            {
              "text": "80",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana wakulili, wakwatili Ŋovu muspiritu, Hakwikalaŋa mumasaŋa kushika nikwifuku damumwekesheluwu kudi aIsarela.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.80",
