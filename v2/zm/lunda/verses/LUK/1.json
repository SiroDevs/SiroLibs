          },
          "items": [
            {
              "text": "75",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimukujila nimukuloŋa mafuku etu ejima. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.75",
            "verseOrgIds": [
              "LUK.1.75"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "76",
            "style": "v",
            "sid": "LUK 1:76"
          },
          "items": [
            {
              "text": "76",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nineyi mwana akakwilaŋa nawu wukaprofwetu kaMukwakubadika. Wakatwaminaŋahu dehi kumbidi yaYehova, kulonda kumuloŋeshelaŋahu dehi njila jindi; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.76",
            "verseOrgIds": [
              "LUK.1.76"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "77",
            "style": "v",
            "sid": "LUK 1:77"
          },
          "items": [
            {
              "text": "77",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulonda chiwakayileja neyi anayanakeni dehinyiloŋayenu, akeluki nawu anatuhandishi dehi, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.77",
            "verseOrgIds": [
              "LUK.1.77"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "78",
            "style": "v",
            "sid": "LUK 1:78"
          },
          "items": [
            {
              "text": "78",
              "type": "text"
            }
          ]
        },
        {
          "text": "naluwi lwaNzambi yetu lwawushona. Naluwi olu twakamona nachu kucha kwakufuma mwiwulu, kwakwinza nakututala; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.78",
            "verseOrgIds": [
              "LUK.1.78"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "79",
            "style": "v",
            "sid": "LUK 1:79"
          },
          "items": [
            {
              "text": "79",
              "type": "text"
            }
          ]
        },
        {
          "text": "kucha kwakuchiila ashakama mumwidima nimuwulelu wakufwa, kwakalomboli nyendu yetu yakaholokeli munjila yakumona kuwunda. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.79",
            "verseOrgIds": [
              "LUK.1.79"
            ]
          }
        },
        {
          "name": "verse",
