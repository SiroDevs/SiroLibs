  "copyright": "PUBLIC DOMAIN",
  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "GAL 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GAL 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa mi nami, helaŋa nswana wuchidi kansi, hashiyaloŋanaŋa nandunuku, kutoŋa diyi mwanta wayuma yejima; ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.1",
            "verseOrgIds": [
              "GAL.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GAL 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ilaŋa wakuminaŋa dakwovwahila amuhembaŋa niatulama, nihakashika mwaka watoŋolayi tata yindi. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.2",
            "verseOrgIds": [
              "GAL.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GAL 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninetu nawa, chitwadiŋi atwansi, twadiŋi muwuduŋu wayuma yampata yamunu mwishina yakuhemesha; ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.3",
            "verseOrgIds": [
              "GAL.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GAL 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ilaŋa mwaka chiwashikili chikupu, Nzambi hakutemesha Mwanindi, amuvweli kudi mumbanda, amuvweli kunshimbi; ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.4",
            "verseOrgIds": [
              "GAL.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GAL 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulonda akakúuli antu adiŋi kunshimbi, kulonda twakatambuli waana wakwikala anyana kambala. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.5",
            "verseOrgIds": [
              "GAL.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GAL 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimunekali dehi anyana kambala, Nzambi atemesha niSpiritu yaMwanindi munyichima yetu nindi, Aba, Tata. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.6",
            "verseOrgIds": [
              "GAL.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GAL 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi hiwudi nawa cheŋi nduŋuku, wumwana; neyi wumwana komana wunswana wakuswanisha kudi Nzambi.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.7",
            "verseOrgIds": [
              "GAL.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GAL 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.7",
            "verseOrgIds": [
              "GAL.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GAL 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamwaka chimwabulili kumwiluka Nzambi, mwadiŋi anduŋu jawabula kwikala Nzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.8",
            "verseOrgIds": [
              "GAL.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GAL 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwila ichi chimunamwiluki dehi Nzambi, wata Nzambi diyi wayilukenu, muloŋanyi mukufuntila nawa cheŋi kuyuma yakuhemesha yazeya yawuzweŋi, mwaka mukeŋi kwijila cheŋi muwuduŋu wayu? ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.9",
            "verseOrgIds": [
              "GAL.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwajilikaŋa mafuku, nitukweji, niyilaaka, ninyaka. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.10",
            "verseOrgIds": [
              "GAL.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GAL 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natiyi woma nami hadaha nayikabakeneni tuhu chamukunkulwayi.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.11",
            "verseOrgIds": [
              "GAL.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GAL 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.11",
            "verseOrgIds": [
              "GAL.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GAL 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu ana kwetu, nayilembeleli nami ikalenu neyi ami, muloŋa ami nidi neyi enu. Himwaŋilili chatamaku. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.12",
            "verseOrgIds": [
              "GAL.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GAL 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu aweni mweluka dehi chuma chaletesheli kuyishimwina nsaŋu yayiwahi hakusambila, chochayikatu yami. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.13",
            "verseOrgIds": [
              "GAL.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "China chuma chamumujimba wami chimwamweni kutama, himwachisekesheli, hela kuchisawulaku; mwakuminini dakuntambula neyi chakutambula kapelu kaNzambi, neyi yomweni Kristu Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.14",
            "verseOrgIds": [
              "GAL.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GAL 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukooleka kumwateneni kunayi dehi mudihi? Tiyenu niyileji chuma chinayimweni, nami neyi chatweshekeli, mutenowu mwantubwilili mesu enu himukunyinkawu ami. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.15",
            "verseOrgIds": [
              "GAL.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GAL 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami nabalumuki dehi kwikala mukwankunyi nenu nanichi chinayilejaŋa mwalala, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.16",
            "verseOrgIds": [
              "GAL.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulemesha kwaswejaŋawu kuyilemesha hikwayaloŋa mwamuwahuku; analondi kuyambula nachu kulonda kuyilemeshaŋa wena. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.17",
            "verseOrgIds": [
              "GAL.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GAL 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chachiwahi kulemesha muchawahila mafuku ejima, bayi chinukwikala nenu hohuku. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.18",
            "verseOrgIds": [
              "GAL.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GAL 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu anyanami anyanya, inukumwena cheŋi nyisoŋu yakuvwala nichimwamba kabalumuka nakufwana neyi Kristu! ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.19",
            "verseOrgIds": [
              "GAL.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GAL 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eŋa, neyi nadiŋi nenu katataka mutenowu nabalumuni dehi niizu dami, muloŋa nidi nakuyijinoka.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.20",
            "verseOrgIds": [
              "GAL.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GAL 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.20",
            "verseOrgIds": [
              "GAL.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GAL 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu mwakeŋa a kwikala kunshimbi, nlejenu; nshimbi jajeni himwajitiyaloŋaku, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.21",
            "verseOrgIds": [
              "GAL.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GAL 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa nasoneki nawu, Abarahama wadiŋi nawanyanindi amayala ayedi, iwu wakudi mumbanda wanduŋu, mukwawu wakudi mumbanda wesumbu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.22",
            "verseOrgIds": [
              "GAL.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GAL 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwu wakudi mumbanda wanduŋu wavwalikili chakumujimba; hakwinza owu wavwalikili kudi mumbanda wesumbu wadiŋi wakukana. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.23",
            "verseOrgIds": [
              "GAL.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GAL 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena yumiyi hichishimu; muloŋa wenawa ambanda hiyitiyaŋenu yiyedi; chimu chakufuma kumpidi yaSinayi, diyi Haga wavwalaŋa anyana awuduŋu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.24",
            "verseOrgIds": [
              "GAL.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GAL 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwu Haga diyi mpidi yaSinayi yamuArabiya, kafwampi diyi Yerusalema yamakonu, muloŋa yena wudi muwuduŋu nawanyanindi. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.25",
            "verseOrgIds": [
              "GAL.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GAL 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwila Yerusalema yakwiwulu hiyekala muwuduŋuku, diyi mama yetwetu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.26",
            "verseOrgIds": [
              "GAL.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GAL 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa nasoneki nawu, Eyi nshinta, wabulilaŋa kuvwala anyana, zapalalaku. Eyi wabulilaŋa kutiya nyisoŋu yakuvwala, bulaku nyipula nikwimba tumina; muloŋa anyana kamumbanda analekuwu anabadiki anyana kamumbanda wesumbu kuvula. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.27",
            "verseOrgIds": [
              "GAL.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GAL 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu ana kwetu tudi anyana achikaninu neyi chadiŋiyi Isaka. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.28",
            "verseOrgIds": [
              "GAL.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GAL 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chelili owu wavwalikili chakumujimba hakukabisha owu wakudi Spiritu, dichi chelaŋawu nilelu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.29",
            "verseOrgIds": [
              "GAL.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GAL 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumukanda wajila nawudi? Nawu, Mutemuni iwu nduŋu nimwanindi hamu; Muloŋa mwana kayeniwu nduŋu hakutwesha kuswanina hamu namwana kamumbanda wesumbuku. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.30",
            "verseOrgIds": [
              "GAL.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GAL 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi enu ana kwetu, etu hituyanyana kamumbanda wanduŋuku, tuyanyana kamumbanda wesumbu.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.31",
            "verseOrgIds": [
              "GAL.4.31"
            ]
          }
        }
      ]
    }
  ],
