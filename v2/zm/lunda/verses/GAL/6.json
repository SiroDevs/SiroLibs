        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.17",
            "verseOrgIds": [
              "GAL.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GAL 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luwi lwaMwanta Yesu Kristu lwikali naspiritu yenwenu ana kwetu. Amena.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.18",
            "verseOrgIds": [
              "GAL.6.18"
            ]
          }
        }
      ]
    }
  ],
