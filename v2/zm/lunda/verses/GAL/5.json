  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "GAL 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GAL 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kristu watufumisha dehi muwuduŋu; dichi shimatenu chakola, bayi mudikasila cheŋi mumpanda yawuduŋuku.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.1",
            "verseOrgIds": [
              "GAL.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GAL 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.1",
            "verseOrgIds": [
              "GAL.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GAL 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyenu, ami Pawulu nukuyila nami, Neyi akuyalamisha himwakamwena chuma mudi Kristuku. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.2",
            "verseOrgIds": [
              "GAL.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GAL 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwamweni, nikushimwina nawa cheŋi amayala ejima akwalamishawu, nami anekali dehi nachidika chakwila nshimbi jejima. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.3",
            "verseOrgIds": [
              "GAL.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GAL 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu mukukeŋa kwikala aloŋa nanshimbi, munaketuki dehi kudi Kristu, munasenuki dehi nawa munjila yaluwi. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.4",
            "verseOrgIds": [
              "GAL.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GAL 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa etu kwetu twachiŋililaŋa kuloŋa kutwachiŋejaŋa, kutunatambwili kudi Spiritu nakukuhwelela. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.5",
            "verseOrgIds": [
              "GAL.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GAL 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa mudi Kristu Yesu, kwalama hela kubula kwalama hikwakwashapaku, chiŋa yowu kukuhwelela kwakalakalaŋa nakukeŋa hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.6",
            "verseOrgIds": [
              "GAL.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GAL 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwadiŋi nakutemuka chachiwahi, ayilekesheluku kudinyi, mwaka muleki kwovwahila nsaŋu yalala? ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.7",
            "verseOrgIds": [
              "GAL.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GAL 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukanjikŋa kwanayikanji kŋuwu, hikunafumi kudi yena wayitambikaku. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.8",
            "verseOrgIds": [
              "GAL.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GAL 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iluŋi dantesha dananishaŋa chikanka chejima. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.9",
            "verseOrgIds": [
              "GAL.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nayikuhweleleli mudi Mwanta, nami himukutoŋojoka mwacheŋuku; hakwila muntu wayikabishaŋa ochu wakawana muloŋa, yonsu akawanawu yowu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.10",
            "verseOrgIds": [
              "GAL.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GAL 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa enu ana kwetu, neyi ami nichidi kushimuna kwalama, adi nakunkabishiladi nihanu? Neyi chadiŋi ochu, komana ninsonyi yakulusu yinahiti dehi. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.11",
            "verseOrgIds": [
              "GAL.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GAL 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutenowu ayiluwaŋeshaŋa adi kudiketula awenawu!",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.12",
            "verseOrgIds": [
              "GAL.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GAL 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.12",
            "verseOrgIds": [
              "GAL.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GAL 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa enu ana kwetu, ayitambikilili kwenu waana. Ichi chimunabuli wuduŋu, bayi muchibalumuna chiikali chakukwasha nachu chisemwa chahesekuku; ikalenu kwenu akwakudikalakela wumu namukwawu mukukeŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.13",
            "verseOrgIds": [
              "GAL.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa nshimbi jejima jahwilaŋa mulushimbi lumu lwakwila nawu, Keŋaku mukwenu neyi chiwadikeŋa eyi aweni. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.14",
            "verseOrgIds": [
              "GAL.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GAL 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwinza neyi mukudisumona nakudidya wumu namukwawu, babalenu kuchina kudijilisha wumu namukwawu.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.15",
            "verseOrgIds": [
              "GAL.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GAL 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.15",
            "verseOrgIds": [
              "GAL.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GAL 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami nami endenuŋa chakuyendesha kudi Spiritu, kulonda mubuli kwila yafwilaŋa chisemwa chaheseki. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.16",
            "verseOrgIds": [
              "GAL.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa chisemwa chaheseki chafwilaŋa yabula kukeŋayi Spiritu, niSpiritu nawa wafwilaŋa yabula kukeŋa chisemwa chaheseki; Muloŋa wena, chabula kutiyaloŋanawu wumu namukwawu, alonda kuyikaŋesha kwila yuma yimwakeŋa aŋa kwila. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.17",
            "verseOrgIds": [
              "GAL.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GAL 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa neyi ayilombolaŋa kudi Spiritu, himudi nawa kunshimbuku.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.18",
            "verseOrgIds": [
              "GAL.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GAL 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.18",
            "verseOrgIds": [
              "GAL.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GAL 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyidimu yachisemwa chaheseki hiyakuyambaku. Diyeniyi; wuvumbi, wuzondu wamumuchima, kufwila yatama, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.19",
            "verseOrgIds": [
              "GAL.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GAL 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "kupesha, kupanda, kuhelaŋana, kuzuŋa, ichima, madombu, kukokwela kwenu, kudambola, kwitiya nsaŋu yaheŋa, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.20",
            "verseOrgIds": [
              "GAL.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GAL 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "lwisu, kusheta, yisela, niyuma yidi neyi iyi. Yeniyi nuleuyileja munayilejeli dehi, nami antu akwila mwenimu hiyamba kaswana wanta waNzambi uku. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.21",
            "verseOrgIds": [
              "GAL.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GAL 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwila nyikabu yaSpiritu yowu kukeŋa, muzaŋalu, kuwunda, kukaba kabe-e, luwi, kuwaha, kushinshika,",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.22",
            "verseOrgIds": [
              "GAL.5.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GAL 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.24",
            "verseOrgIds": [
              "GAL.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GAL 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi tukuhanda chakutuhandisha kudi Spiritu, twendenuŋa nawa chakutwendesha kudi Spiritu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.25",
            "verseOrgIds": [
              "GAL.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GAL 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi tukeŋa kudilemesha chamukunkulwayuku, tubuli kudivuloka, nikuditiyila ichima.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.26",
            "verseOrgIds": [
              "GAL.5.26"
            ]
          }
        }
      ]
    }
  ],
