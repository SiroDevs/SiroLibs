          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hawuhulilu hakenzala tidiku, muwukamwinu mwakasumpoka nivinyu nimanji. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.24",
            "verseOrgIds": [
              "JOL.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOL 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukuyifuntishila nyaka yadiili atubola, niatubola amotokaŋa, niatubola akisaŋanaŋa, niansenya, yoyi njita yami yeneni yinatemesheli mukachi kenu.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.25",
            "verseOrgIds": [
              "JOL.2.25"
            ]
          }
        }
      ]
    },
