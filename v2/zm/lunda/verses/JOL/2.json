          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakulondelahu, ami nakechila Spiritu yami hadi antu ejima; anyanenu amayala nawambanda akaprofweta, mapalenu amayala akalota yilota, anyikwenzi jenu akamona yimwenu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.28",
            "verseOrgIds": [
              "JOL.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOL 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hadi ambuŋenu amayala nihadi ambuŋenu awambanda hamafuku owu nakechila Spiritu yami.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.29",
            "verseOrgIds": [
              "JOL.2.29"
            ]
          }
        }
      ]
    },
