          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwakadya yalumbama mwakekuta, mwakahameka ijina daYehova Nzambi yenu, diyi nayili chakuhayamisha. Antu ami hiyamba katiya cheŋi nsonyuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.26",
            "verseOrgIds": [
              "JOL.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOL 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwakeluka nenu ami nidi mukachi kawaIsarela, nenu yami Yehova Nzambi yenu, hikudi wacheŋuku. Antu ami hiyamba katiya cheŋi nsonyuku.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.27",
            "verseOrgIds": [
              "JOL.2.27"
            ]
          }
        }
      ]
    },
