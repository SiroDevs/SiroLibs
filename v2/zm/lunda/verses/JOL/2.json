          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu anyana kaZiyona, tiyenu kuwaha, zaŋalalenu mudi Yehova Nzambi yenu; muloŋa yena hakuyinka nvula yamusanvu chamukuloŋa hohu, hakuyinokeshela nvula, niyamusanvu, niyamayinza, neyi hakusambila.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.23",
            "verseOrgIds": [
              "JOL.2.23"
            ]
          }
        }
      ]
