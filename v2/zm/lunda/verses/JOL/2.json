          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbenu mpùŋa muZiyona; jilikenu ifuku dakuleka kudya; tambikenu kukumaŋana kwakudihudika, ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.15",
            "verseOrgIds": [
              "JOL.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOL 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumaŋejenu antu, jilikenu chipompelu, pompeshenu awakulumpi, kumaŋejenu atwansi, ninawa achidi kwamwa kumayeli. Nsumbuli afumi mwitala dindi, ninsumbuki ediki mukapeka kindi.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.16",
            "verseOrgIds": [
              "JOL.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
