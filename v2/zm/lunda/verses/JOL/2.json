              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbenu mpùŋa muZiyona, jisweji kuvuma kumpidi yami yajila; kulonda antu ejima ashakama mwituŋa akumini dakuzaala; muloŋa ifuku daYehova hidikwinza, didi kwakwihi; ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.1",
            "verseOrgIds": [
              "JOL.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOL 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ifuku damwidima dakwiyila, ifuku damavu damwidima wakushishita, neyi kucha kunatookeshi hamapidi kwejima; muza wasweja kuvula, wukweti Ŋovu, kanda kumwekanaŋahu dehi muza wudi chochochuku, himwamba kalondela acheŋi adi chochochuku, hela kunyaka yamakiŋu amavulu amba kavwalikilaŋawu antu.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.2",
            "verseOrgIds": [
              "JOL.2.2"
            ]
          }
        }
      ]
