          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukuyawu kulasha kwakesi hohu, kwakufumawu nawa kubidimaŋa kwanyilaŋu yakesi hohu. Kukuyawu ituŋa didi neyi itempa daEdeni, kwakufumawu kwesaŋa dakisika dehi hohu; mwalala, kwosi chuma nichimu chikupulukaku.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.3",
            "verseOrgIds": [
              "JOL.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
