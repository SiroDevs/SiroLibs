  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "2SA 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahitofweli hakumwila Abisalomi nawa, nindi, Nleki mwani nitondi amayala makombakaji ikumi nayedi, ninyamuki, nimulondeli Davidi lufuchi wufuku owu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.1",
            "verseOrgIds": [
              "2SA.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakamushintakeshi hachidiyi wazeya, hachidiyi wabula Ŋovu nakamufwishi mutentu, niantu ejima adiyi nawu akatemoka, nakatapi kwamwanta hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.2",
            "verseOrgIds": [
              "2SA.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu ejima nakayifuntishi kudeyi; antu ejima akufunta akweseka neyala wudi nakutondatonda. Antu ejima hiya kashakama chachiwahi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.3",
            "verseOrgIds": [
              "2SA.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chahosheliyi ochu Abisalomi nawawakulumpi awaIsarela ejima elili nawu, Chachiwahi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.4",
            "verseOrgIds": [
              "2SA.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.4",
            "verseOrgIds": [
              "2SA.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisalomi hakwila nindi, Mutambikenu Hushayi wakuAraki nawa, tutiyi mwakuhoshayi niyena nawa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.5",
            "verseOrgIds": [
              "2SA.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hushayi chenjiliyi kudi Abisalomi, Abisalomi hakumwila nindi, Tiya mwanahoshiyi Ahitofweli. Twili mwana hoshiyi, tahindi? Neyi nehi, hoshaku. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.6",
            "verseOrgIds": [
              "2SA.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hushayi hakumwila Abisalomi nindi, Maana anayilejiyi Ahitofweli lelu hiyamawahuku. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.7",
            "verseOrgIds": [
              "2SA.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hushayi hakunuŋaku nindi, Tata yeyi nawantu indi wunayiluki dehi, hiyayilobu kwawu, atiya dehi kunyichima bwi neyi chikwabera anakwatiluwu anya nindi mumpata. Tata yeyi himukwanjita, akami hamu nawantu kwaamu? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.8",
            "verseOrgIds": [
              "2SA.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanu wabatama dehi muwina, indi kwiji kwacheŋi. Neyi hakusambila antu amakwawu akafwa, yowu wakatiya nawu, Antu akulondela Abisalomi anayitapi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.9",
            "verseOrgIds": [
              "2SA.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela womika, hela wukweti muchima wudi neyi mutupa, wakafwomoka zo-o. Muloŋa aIsarela ejima amwiluka dehi tata yeyi hichilobu, niantu adiyi nawu hiyayilobu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.10",
            "verseOrgIds": [
              "2SA.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi ami nukuyileja maana, nami, Akakupompesheli aIsarela ejima, kufumisha kuDani ndo nikuBeri sheba, avula neyi wusekulula wudi kuchikumu chakaluŋalwiji. Wakayi kunjita nineyi aweni. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.11",
            "verseOrgIds": [
              "2SA.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twakamushintakeshi kwonsu kwakamwekenayi, twakamuwulami neyi chaholokaŋa wilumi hamaseki. Hela yena, hela antu ejima adiyi nawu, hosi niwumu twakashiyaku. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.12",
            "verseOrgIds": [
              "2SA.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi twakamuwana neŋili dehi mumukala wampwembu aIsarela ejima akatwala nyonji kumuka lowu, twakawukokela mukaloŋa koke-e, nikadilola kamu kakushalahu nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.13",
            "verseOrgIds": [
              "2SA.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisalomi namayala awaIsarela ejima elili nawu, Maana anatulejiyi Hushayi wakuAraki anabadiki maana anatulejiyi Ahitofweli. Muloŋa Yehova nafuukuli dehi kubayisha maana amawahi ayilejeliyi Ahitofweli, kulonda Yehova akamuleteli Abisalomi jatama.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.14",
            "verseOrgIds": [
              "2SA.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.14",
            "verseOrgIds": [
              "2SA.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hushayi hakuleja atupristu aZadoki naAbiyatari, nindi, Tiyenu maana alelawu Abisalomi nawawakulumpi awaIsarela kudi Ahitofweli; tiyenu nawa nimaana inayileji ami. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.15",
            "verseOrgIds": [
              "2SA.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu katemeshenu swayi mazu akumuleja Davidi, nenu, Wufuku walelu bayi wukama kunyaba yamwisaŋaku, chiŋa wuzambuka hohu; mwanta nawantu ejima adiyi nawu akenza kayiminyina kumu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.16",
            "verseOrgIds": [
              "2SA.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu aJonatani naAhimayazi adiŋi ashakama kuEnirogeli. Kwayilaŋa kaŋamba kamumbanda nakuyilejaleja nsaŋu, kulonda wena ayaŋa nakuleja mwanta Davidi kuchina kuyimona kudi antu nakwijila mumukala. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.17",
            "verseOrgIds": [
              "2SA.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela chochu, ayimweni kudi mukwenzi wumu, hakuleja Abisalomi. Hiyakuya lufuchi mwayedi wawu, hiyakushika kwitala damuntu wakuBahurimi wadiŋi neshima muchipaŋu chindi, hiyakwijila mu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.18",
            "verseOrgIds": [
              "2SA.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumbanda hakunona chifwiku, hakubuta hewulu deshima, hakwanyikahu nitidiku yakusohola. Antu kwiluka chuma nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.19",
            "verseOrgIds": [
              "2SA.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋamba jaAbisalomi ashikili kwitala kudi mumbanda, nawu, Ahimayazi naJonatani adi kudihi? Mumbanda hakuyila nindi, Azambuka dehi kakaloŋa kadi nameji. Cheliluwu keŋe-e, kuyimona nehi, hiyakufunta kuYerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.20",
            "verseOrgIds": [
              "2SA.17.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.20",
            "verseOrgIds": [
              "2SA.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cheliluwu anayi dehi, hiyakufuma mwishima, hiyakuya nakuleja mwanta Davidi. Hiyakumwila Davidi, nawu, Nyamukenu, muzambuki swayi kaloŋa. Muloŋa Ahitofweli nayileji dehi maana akuyitamisha. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.21",
            "verseOrgIds": [
              "2SA.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakunyamuka, niantu ejima adiŋiyi nawu, hiyakuzambuka Yodana. Chi kwelili hikukwanzakana nakucha hikwasheli hoku muntu niwumu wabulili kuzambuka Yodanaku.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.22",
            "verseOrgIds": [
              "2SA.17.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.22",
            "verseOrgIds": [
              "2SA.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahitofweli chamweniyi wena kwila mwanayilejiyi nehi, hakulema sadi hachimbulu chindi, hakunyamuka, hakuya kwawu, kumukala wawu, haku loŋesha loŋesha nsaŋu jakwitala dindi, adikudika nikudikudika. Wafwilili, amujiikili mwŋamu datata yindi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.23",
            "verseOrgIds": [
              "2SA.17.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.23",
            "verseOrgIds": [
              "2SA.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi washikili kuMahanayimi. Abisalomi wazambukili Yodana, niyena niamayala awaIsarela ejima adiŋiyi nawu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.24",
            "verseOrgIds": [
              "2SA.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisalomi wakunjikili Amasa kwikala mwanta wanjita, ahiŋi mudi Yowabi. Amasa wadiŋi mwana keyala wumu, ijina dindi Itira kaIsarela, weŋihli mudi Abigayili mwana kaNahashi, mana kwaZeruwiya, Zeruwiya mama yaYowabi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.25",
            "verseOrgIds": [
              "2SA.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "AIsarela niAbisalomi atuŋili chilombu chawu mwituŋa daGileyadi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.26",
            "verseOrgIds": [
              "2SA.17.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.26",
            "verseOrgIds": [
              "2SA.17.26"
            ]
          }
        },
