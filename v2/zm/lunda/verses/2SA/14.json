  "reference": "2 Samuele 14",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "2SA 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowabi mwana kaZeruwiya wamweni muchima wamwanta wunayi hadi Abisalomi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.1",
            "verseOrgIds": [
              "2SA.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowabi hakutuma antu kuTekowa nakuleta mumbanda wamaana. Hakumwila nindi, Kadimbani mwani kudila, wakavwali wuvwalu wakudila nachu mwani, bayi wakawaya manjuku, chiŋa wikala neyi mumbanda wadila dehi mufu windi dilee hanalehi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.2",
            "verseOrgIds": [
              "2SA.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiŋili mwa-mwanta wuhoshi nindi munukukuleja. Yowabi hakumuleja mwakaho shayi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.3",
            "verseOrgIds": [
              "2SA.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.3",
            "verseOrgIds": [
              "2SA.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumbanda wakuTekowa chahosheliyi namwanta, hakudimbuka chamesu indi hamaseki, hakudifukula, nindi, Nkwashuku mwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.4",
            "verseOrgIds": [
              "2SA.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta hakumwila nindi, Kudidi? Mumbanda hakwakula nindi, Mwalala ami nimumbanda wantuluwa, nfumwami wafwa dehi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.5",
            "verseOrgIds": [
              "2SA.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami kambuŋeyi nadiŋi nawanyana amayala ayedi, azuŋila mumpata, hikwadiŋi wakuyamu nwinaku, wumu hakutapa mukwawu, hakmnujaha. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.6",
            "verseOrgIds": [
              "2SA.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinukukasumuka chisaka chetu chejima hichikuvwakukila ami kambuŋeyi, nawu, Twinki natapi mana kwindi, tumujahi nawumi wamana kwindi anajahiyi; keŋa akisaŋani kwawu ninswana nawa, enza ajimi ikala dami dinashaluku, chakadi kumushila nfumwami hela ijina hela wakushalahu hanu hewulu deseki. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.7",
            "verseOrgIds": [
              "2SA.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta hakumwila mumbanda, nindi, Yaku kwitala deyi, nukuleja antu akaloŋeshi nsaŋu yeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.8",
            "verseOrgIds": [
              "2SA.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumbanda wakuTekowa hakumwila mwanta nindi, Nkaka yami mwanta, kuluwa kwikali kwamami namutaŋa watata i yami; mwanta netanda dindi abuli muloŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.9",
            "verseOrgIds": [
              "2SA.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta nindi, Muntu wakakuhosha chuma kamuleti kudami, hakakwila nawa cheŋi chumaku.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.10",
            "verseOrgIds": [
              "2SA.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.11",
            "verseOrgIds": [
              "2SA.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumbanda nindi, Ami kambuŋeyi nihoshi mwani kadizu nankaka yami mwanta. Nindi, Hoshaŋa kweyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.12",
            "verseOrgIds": [
              "2SA.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumbanda nindi, Indi ochu wunafuukwilidi chuma chakutamisha antu aNzambi chidi neyi ichi? Muloŋa chanahoshiyi mwanta izu idi wudi neyi muntu natanyi dehi, nanichi chanabuliyi kufuntisha cheŋi windi anakinjikuwu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.13",
            "verseOrgIds": [
              "2SA.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa chetu yokufwa hohu, tudi neyi meji anamwaŋali heseki, abulaŋa kunonawu cheŋi. Chikaŋa Nzambi hafumishaŋa wumi wamuntuku, ilaŋa yena wafuukulaŋa mwakwila owu anakinjikuwu akabuli kumuhaŋila kwakulehi nayena. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.14",
            "verseOrgIds": [
              "2SA.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi chinenzi nakuhosha kudi nkaka yami mwanta izu idi, chinafumi hakuntiyisha woma kudi antu. Ami kambuŋeyi nela nami, Leka nihoshi namwanta. Nami wamba kela mwanta wukwila mwakumulombayi kambu ŋindi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.15",
            "verseOrgIds": [
              "2SA.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ochu mwanta abuli kutiya, abuli kwamwina kambuŋindi kudi muntu nakeŋi kunkisaŋana ninami nimwanami kumu tufumi muwuswana waNzambi? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.16",
            "verseOrgIds": [
              "2SA.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami kambuŋeyi nela nami, Izu dankaka yami mwanta diikali mwani dakukundeja. Muloŋa nkaka yami mwanta wudi neyi kaŋelu i kaNzambi, welukaŋa nimwamuwahi nimwatama. Yehova Nzambi yeyi ekali naneyi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.17",
            "verseOrgIds": [
              "2SA.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.17",
            "verseOrgIds": [
              "2SA.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta hakumwakula owu mumbanda, hakumwila nindi, Bayi wunjinda mwani chuma chinukukwihulaku. Mumbanda nindi, Nkaka yami mwanta ahoshi mwani. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.18",
            "verseOrgIds": [
              "2SA.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta nindi, Yuma yejimiyi yinafumi kudi Yowabi, tahindi? Mumbanda hakwakula nindi, Chiwahanda kwaamu, eyi nkaka yami mwanta, hosi muntu wayaŋa hela kuchikasa chachidiilu hela kuchimunswa chakwambuka mwanahoshiyi nkaka yami mwantaku. Muloŋa kambuŋeyi Yowabi diyi wanleja, diyi washa mazu ejima awa mukanwa kamami kambuŋeyi; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.19",
            "verseOrgIds": [
              "2SA.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "chaneliyi kambuŋeyi Yowabi chumichi nalondi kubalumuna nsaŋu. Nkaka yami wukweti maana adi neyi akaŋelu kaNzambi, akwiluka nachu yuma yahamaseki yejima.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.20",
            "verseOrgIds": [
              "2SA.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.20",
            "verseOrgIds": [
              "2SA.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta hakumwila Yowabi, nindi, Tiya dinu, ami neli dehi chumichi. Dichi yaku wakaleti cheŋi mukwenzi Abisalomi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.21",
            "verseOrgIds": [
              "2SA.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowabi hakudinata chamesu indi hamaseki, hakudifukula, hakumukiswila mwanta nkisu. Yowabi nindi, Ami kambuŋeyi neluki dehi nami komana nawani dehi wuselewa kumesu eyi, nkaka yami, eyi mwanta, nanichi chaneliyi mwanta munalombi ami kambuŋeyi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.22",
            "verseOrgIds": [
              "2SA.14.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.22",
            "verseOrgIds": [
              "2SA.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowabi yonyamuka nikunyamuka, hakuya nikuGeshuri nakuleta Abisalomi enzi kuYerusalema. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.23",
            "verseOrgIds": [
              "2SA.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta hakwila nindi, Ayi kwakwitala dindi yomwenindi, bayi anmona kumesuku. Abisalomi hakuya nikwitala dindi yomwenindi, hamweni kumesu amwantaku.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.24",
            "verseOrgIds": [
              "2SA.14.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.24",
            "verseOrgIds": [
              "2SA.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "MuIsarela mwejima himwadiŋi muntu walubanji wakweseka naAbi salomuku, aswejeli kumuhameka nankashi. Kufumisha kumadachilu indi ndo nihewulu danamutu windi hadiŋi nahataminayuku. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.25",
            "verseOrgIds": [
              "2SA.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watewilaŋa namutu windi hamwaka hamwaka muloŋa nsuki jindi jadiŋi nakumulemena, dichi chajitewililaŋayi. Chatewilaŋayi namutu windi, hakweseka nsuki jakunamutu windi hijikushika mujishekeli makulakaji ayedi, mwomupezu yamwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.26",
            "verseOrgIds": [
              "2SA.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisalomi amuvweleleli anyana amayala asatu, wamumbanda wumu, ijina dindi Tamari, wadiŋi mumbanda wasweja lubanji kumesu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.27",
            "verseOrgIds": [
              "2SA.14.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.27",
            "verseOrgIds": [
              "2SA.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisalomi washakamini muYerusalema nyaka yamana chikupu yiyedi chakadi kumumona mwanta kumesu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.28",
            "verseOrgIds": [
              "2SA.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisalomi hakutemesha mazu akutambika Yowabi, kulonda kumutemesha kudi mwanta. Yena kwindi kwonti kwindi kwinza kudi yena. Watemesheluku kamuchiyedi, saŋa alekelayi kwinza. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.29",
            "verseOrgIds": [
              "2SA.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyila aŋamba jindi nindi, Talenu, iha daYowabi didi kwakwihi nadami, mudi bali yindi; yenu mwakadochi. Aŋamba jaAbisalomi hiyakwocha iha. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.30",
            "verseOrgIds": [
              "2SA.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowabi hakunyamuka, hakwinza nikwitala daAbisalomi, hakumwila nindi, Aŋamba jeyi anochelidi iha dami? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.31",
            "verseOrgIds": [
              "2SA.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisalomi hakumwakula Yowabi nindi, Nakutemesha nami, Twaya nikute meshi kudi mwanta, wihuli neyi, Indi nafuminidi kuGeshuri? Chakeŋa kuwaha neyi diku kunidi kwami nihanu. Dichi dinu aŋitŋi nimumoni mwanta kumesu. Neyi mudami mudi kuluwa, akanjahi tuhu kwindi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.32",
            "verseOrgIds": [
              "2SA.14.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowabi hakwinza kudi mwanta, hakumuleja. Chamutambikiliyi Abisalomi hakwinza kudi mwanta, hakubandama chamesu indi hamaseki kumesu amwanta. Mwanta hakumupwepula Abisalomi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.33",
            "verseOrgIds": [
              "2SA.14.33"
            ]
          }
        }
      ]
    }
