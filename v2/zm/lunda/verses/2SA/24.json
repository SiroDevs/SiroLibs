  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "2SA 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wayizuwilili cheŋi aIsarela, hakuyisaŋumwina Davidi, nindi, Yaku waka chindi niaIsarela niaYuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.1",
            "verseOrgIds": [
              "2SA.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwantaha kumwila Yowabi mukulumnpi wanjita adiŋiyi nindi, nindi, Yaku mwani nakutambatamba mwahita nyichidi yawaIsarela yejima, kufumisha kuDani ndo nikuBerisheba, mwakachindi antu, kulonda nakeluki mwashikilawu antu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.2",
            "verseOrgIds": [
              "2SA.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowabi hakumwila mwanta, nindi, Mwonsu mwanashikiluwu antu Yehova Nzambi yeyi alunjikuku mapampa nkulakaji, ninkaka yami mwanta achimonu hunamesu indi; indi nkaka yami mwanta natiyilidi kuwaha nachumichi? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.3",
            "verseOrgIds": [
              "2SA.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izu damwanta dafwomweni Yowabi, niakulumpi anjita. AYowabi nawawakulumpi anjita hiyakufuma mwadiŋiyi mwanta, hiyakuya nakuchinda antu akuIsarela.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.4",
            "verseOrgIds": [
              "2SA.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.4",
            "verseOrgIds": [
              "2SA.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakuzambuka Yodana, hiyakutuŋa chilombu kuArowenai, mutamba wamukala wachidiilu wekala mukachi kachinekineki chaGadi, nikuYazeri. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.5",
            "verseOrgIds": [
              "2SA.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashikani kuGileyadi, nikwituŋa daTahiti miHodishi; ashikani kuDani yayani, akotola nikuZidoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.6",
            "verseOrgIds": [
              "2SA.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakushika nikuchipaka chakuTira mwadikaŋililuwu nikunyikala yawaHivi nawaKenani yejima; hiyakwidikila kukabeta kakuchidiilu kakuYuda, kwokuBerisheba. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.7",
            "verseOrgIds": [
              "2SA.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chatambata mbiluwu mwahita ituŋa dejima, hiyakushika kuYerusalema munahiti dehi tukweji tutanu natuwana, namafuku makumi ayedi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.8",
            "verseOrgIds": [
              "2SA.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowabi hakumwinka mwanta kuchinda kwachindilililuwu antu; muIsarela mwadiŋi amayala omika akwatilaŋa kumpoku yakabali makombakaji makulakaji atanu nasatu; amayala amuYuda adiŋi mayala makombakaji makulakaji atanu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.9",
            "verseOrgIds": [
              "2SA.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.9",
            "verseOrgIds": [
              "2SA.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heliliyi nachindi dehi antu, muchima waDavidi hiwukumutaŋa. Davidi hakumwila Yehova, nindi, Imu muneli navulumuni nankashi; ichi dinu, eyi Yehova, nakulembeleli, fumisha kuluwa kwamami kambuŋeyi, muloŋa ami nasupi nankashi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.10",
            "verseOrgIds": [
              "2SA.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chahindukiliyi Davidi budidi, izu daYehova hidikwinza kudi kaprofwetu Gadi, mukwakumona waDavidi, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.11",
            "verseOrgIds": [
              "2SA.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Yaku wakahoshi naDavidi, neyi, Yehova nahoshi, nindi, Naku chindili yuma yisatu; tondakuhucheyi chimu, nikwilili. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.12",
            "verseOrgIds": [
              "2SA.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gadi hakwinza kudi Davidi, hakumuleja, hakumwila nindi, Wumoni nyaka yanzala yitanu nayiyedi mwituŋa deyi, tahindi wutemuki tukweji tusatu kumesu awakwa nkunyi neyi iku adi nakukuhaŋa, tahindi wumoni chipupu chamafuku asatu mwituŋa deyi? Toŋojokaku chakashinshi mwiluki munakamwakwila wantemesha. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.13",
            "verseOrgIds": [
              "2SA.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakumwila Gadi, nindi, Chinankalili nankashi. Tukumini dakuholokela mwani muchikasa chaYehova, muloŋa wushona windi wawuvulu; bayi niholokela kwami muchikasa chamuntuku.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.14",
            "verseOrgIds": [
              "2SA.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.14",
            "verseOrgIds": [
              "2SA.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova hakutemesha chipupu hadi aIsarela kufumisha kubudidi kushika nihafuukwililiyi; kufumisha kuDani nakushika kuBerisheba kwafwili amayala makombakaji makumi atanu nayedi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.15",
            "verseOrgIds": [
              "2SA.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cholweliyi kaŋelu chikasa chindi haYerusalema nindi awujilumuni, kumuchima waYehova hikukubalumuka nachumochu chatama, hakumwila kaŋelu waji lumwini antu, nindi, Kunahu. Lekaku. Kaŋelu kaYehova wadiŋi kuwuhulilu waArawuna kaYebusi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.16",
            "verseOrgIds": [
              "2SA.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi chamweniyi kaŋelu wudi nakutapa antu, hakuhosha naYehova, nindi, Ami navulumuni; mwalala neli chakuluwa, indi awa anyikoku, aneli chumanyi? Nakulembeli, chikasa cheyi chimbabeshi ami namutaŋa watata yami.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.17",
            "verseOrgIds": [
              "2SA.24.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.17",
            "verseOrgIds": [
              "2SA.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Denodu ifuku Gadi hakwinza kudi Davidi, hakumwila nindi, Kandu kaku, wakanamutuŋili Yehova kameŋa kuwuhulilu waArawuna kaYebusi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.18",
            "verseOrgIds": [
              "2SA.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakukanduka mwomwamwililuwu kudi Gadi, mwamulejeluwu kudi Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.19",
            "verseOrgIds": [
              "2SA.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arawuna nindi atali, hakumona mwanta nawambuŋindi hiyakwinza kudi yena. Arawuna hakwidika hanzi, hakubandama kumesu amwanta chamesu indi hamaseki. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.20",
            "verseOrgIds": [
              "2SA.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arawuna nindi, Nkaka yami mwanta nenjilidi kudi kambuŋindi? Davidi nindi, Nenzi nakulanda kudeyi hawu hulilu, kulonda nakanamutuŋili Yehova kameŋa, kulonda chipupu chifumi kudi antu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.21",
            "verseOrgIds": [
              "2SA.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arawuna hakumwila Davidi, nindi, Nkaka yami mwanta atambuli yonsu yanakeŋiyi akashiti. Tala aŋombi ahimulambu wakushita awa, niyuma yakuhula nachu niyuma yakalakalaŋawu nachu aŋombi yiikali nchawa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.22",
            "verseOrgIds": [
              "2SA.24.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arawuna hakuhana yuma yejimiyi neyi chiyadinkaŋawu anyanta. Arawuna hakumwila mwanta nindi, Yehova Nzambi yeyi akwitŋi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.23",
            "verseOrgIds": [
              "2SA.24.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta hakumwila Arawuna, nindi, Nchi, chiŋa nilanda chakulanda. Hinukutwesha kuhimulambu la Yehova Nzambi yami nyilambu yakushita yakadi wuseyaku. Davidi hakulanda nihawuhulilu niŋombi najishekeli jasiliva makumi atanu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.24",
            "verseOrgIds": [
              "2SA.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakunamutuŋila Yehova kameŋa kwenoku, hakushita ninyilambu yakushita ninyilambu yakuwunda. Dichi Yehova wetiyili mwamulembeleluwu nansaŋu yetuŋa, chipupu chifuma nikudi aIsarela.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.25",
            "verseOrgIds": [
              "2SA.24.25"
            ]
          }
        }
      ]
    }
  ],
