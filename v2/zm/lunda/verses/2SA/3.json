        "number": "3",
        "style": "c",
        "sid": "2SA 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutaŋa waSawulu aasili njita namutaŋa waDavidi haleheli. Ŋovu jaDavidi hijikuyaŋa kumbidi, kwinza mutaŋa waSawulu hiwukuyaŋa nakuzeya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.1",
            "verseOrgIds": [
              "2SA.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.1",
            "verseOrgIds": [
              "2SA.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaDavidi amayala avwalikilili kuHeberoni; wedi windi Aminoni, mwana kaAhinowami mumbanda wakuYezereyeli; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.2",
            "verseOrgIds": [
              "2SA.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "chilondawedi Chile yabi, mwana kaAbigayili, wadiŋi iŋoda Nabali wakuKarameli; wamuchisatu Abisalomi, mwana kaMayaka, wadiŋi mwana kaTalimayi mwanta waku Geshuri; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.3",
            "verseOrgIds": [
              "2SA.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "wamuchiwana Adoniya, mwana kaHagiti; wamuchitanu Shefwatiya, mwana kaAbitali; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.4",
            "verseOrgIds": [
              "2SA.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "wamuchitanu nawumu Itereyami, mwana kaEgela iŋoda Davidi. Diwu anyana kaDavidi avwalikilili kuHeberoni.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.5",
            "verseOrgIds": [
              "2SA.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.5",
            "verseOrgIds": [
              "2SA.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chelili mutaŋa waSawulu hiwukwasa njita namutaŋa waDavidi, Abineri hakudikolesha kumutaŋa waSawulu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.6",
            "verseOrgIds": [
              "2SA.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulu wadiŋilaŋa nantombu yindi ijina dindi Rizipa, mwana kaAya. Ishibosheti wamwilili Abineri nindi, Wuneŋililidi mwitala dantombu yatata yami? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.7",
            "verseOrgIds": [
              "2SA.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abineri hakuzuwa nankashi namazu amuhosheliyi Ishibosheti, nindi, Ami ninamutu wakawa kawaYuda komana? Ami nidi nakwila chachiwahi mutaŋa watata yeyi Sawulu, niana kwindi, niamabwambu jindi, kukwinka muchikasa chaDavidi nehi, eyi lelu wunyinki muloŋa wansaŋu yamumbandiwu? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.8",
            "verseOrgIds": [
              "2SA.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi nuku bula kumwila Davidi mwamusanyikililuwu kudi Yehova, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.9",
            "verseOrgIds": [
              "2SA.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nifumishi wanta kumutaŋa waSawulu, nikoleshi wanta waDavidi ayuli naIsarela na Yuda kufumisha kuDani ndo nikuBerisheba, Nzambi amukoŋi Abineri mwomumu nichakubadikamu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.10",
            "verseOrgIds": [
              "2SA.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatwesheli kumwakula Abineri izu nidimuku, muloŋa wamutiyili woma.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.11",
            "verseOrgIds": [
              "2SA.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.11",
            "verseOrgIds": [
              "2SA.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abineri hakutemesha antemesha indi kudi Davidi kwadiŋiyi, nindi, Ituŋa danyi? Nindi, Neyi wukutiyaŋana nanami, ami nukukuma kudeyi, nukukufumbila aIsarela ejima. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.12",
            "verseOrgIds": [
              "2SA.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena nindi, Chachiwahi, nukutiyaŋana naneyi. Ilaŋa kudi chuma chimu chinakeŋi kudeyi, nami eyi kwinza naku ntalami, chiŋa wakasambila kuleta mwana kaSawulu Mikali hiwakenza nakuntala dinu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.13",
            "verseOrgIds": [
              "2SA.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakutemesha atuŋanda kudi Ishibosheti mwana kaSawulu, nindi, Nyinki iŋodami Mikali nasumbwili nanyivumbu yawa Fwilistinu nkulakaji. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.14",
            "verseOrgIds": [
              "2SA.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishibosheti hakutemesha antu nakumutambula kudi nfumwindi Palitiyeli mwana kaLayishi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.15",
            "verseOrgIds": [
              "2SA.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nfumwindi hakuya nindi, hakumulondela nakudila hoo nikuBahurimi. Abineri hakumwila nindi, Yaku, funtaku. Hakufunta.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.16",
            "verseOrgIds": [
              "2SA.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.16",
            "verseOrgIds": [
              "2SA.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abineri hakuhosha nawawakulumpi awaIsarela, nindi, Hanyaka mwake ŋelaŋa Davidi nenu ekali mwanta wakuyiyula. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.17",
            "verseOrgIds": [
              "2SA.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi dinu ilenumu; muloŋa Yehova wamuteneni Davidi, nindi, Chikasa chakambuŋami Davidi dichi nakaamwina nachu antu ami aIsarela kudi awaFwilistinu, nikudi ayilumbu jawu ejima. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.18",
            "verseOrgIds": [
              "2SA.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abineri hakuhosha nikumatu awakwaBenjamini. Abineri hakuya kuHeberoni nakuhosha nikumatu aDavidi nawa, mwonsu mwamwenuwu aIsarela niakwa mutaŋa waBenjamini ejima kuwaha.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.19",
            "verseOrgIds": [
              "2SA.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.19",
            "verseOrgIds": [
              "2SA.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abineri hakushika kuHeberoni kudi Davidi niantu indi makumi ayedi. Davidi hakutelekela Abineri nawantu indi chawija. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.20",
            "verseOrgIds": [
              "2SA.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abineri hakumwila Davidi, nindi, Nukunyamuka niyi nakupompesha aIsarela ejima enzi kudi nkaka yami mwanta kulonda akatiyaŋa ninaneyi, wakayuli ejima iwunakeŋi mumuchima weyi. Davidi hakumwila Abineri nindi, Yaŋa kweyi. Hakuya nichamwena.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.21",
            "verseOrgIds": [
              "2SA.3.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.21",
            "verseOrgIds": [
              "2SA.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutala ambuŋa Davidi niYowabi hiyakufuma kunjita, hiyakuleta yuma yayivulu yapupiluwu kunjita. Abineri hadiŋi hamu naDavidi kuHeberonuku, muloŋa henohu wamwila dehi nindi, Yaŋa kweyi, waya dehi nicha mwena. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.22",
            "verseOrgIds": [
              "2SA.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Helili Yowabi nashiki dehi nanjita yejima yadiŋiyi nayu, hiya kumuleja Yowabi, nawu, Mwana kaNeri Abineri, wenza dehi kudi mwanta, mwanta wamwila dehi nindi, Yaŋa kweyi, yena nayi dehi nichamwena.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.23",
            "verseOrgIds": [
              "2SA.3.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.25",
            "verseOrgIds": [
              "2SA.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chafuminiyi Yowabi kudi Davidi, hakutemesha antemesha akumu londela Abineri, hiyakumufuntishila kwishima daSira; Davidi kuchiluka kwindi nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.26",
            "verseOrgIds": [
              "2SA.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chafuntiliyi Abineri kuHeberoni, Yowabi hakumutwala kumbadi muchisu champwembu nindi ahoshi nindi chamumesu mwatula, hakumutaŋa mwivumu kwokwenoku, hakufwa, namuloŋa wajahiliyi mana kwindi Asaheli. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.27",
            "verseOrgIds": [
              "2SA.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkumininaku chaneli Davidi nachitiyi dehi, hakwila nindi, Ninami niantu ami amuwanta wami muloŋa wakujaha Abineri mwana kaNeri hituwukweti kwetu kumesu aYehovaku chahaya nyaka. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.28",
            "verseOrgIds": [
              "2SA.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awu kooli kudi Yowabi, nikudi akwamutaŋa watata yindi ejima; kumutaŋa waYowabi bayi kwakabula wukweti kaseli, hela mbumba, hela wendelaŋa hamukombu, hela wakufwa kumpoku yakabali, hela wákubula yakudyaku. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.29",
            "verseOrgIds": [
              "2SA.3.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "AYowabi namana kwindi Abishayi amujahilili Abineri muloŋa wajahiliyi mana kwawu Asaheli kuGibeyoni kunjita.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.30",
            "verseOrgIds": [
              "2SA.3.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.30",
            "verseOrgIds": [
              "2SA.3.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakuyila aYowabi nawantu ejima adiŋiyi nawu, nindi, Tabo lenu yuma yenu yakuvwala, muvwali yikeleyi, mumudili Abineri. Mwanta Davidi hakulondela mutembu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.31",
            "verseOrgIds": [
              "2SA.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakumujiika Abineri kuHeberoni. Mwanta hakudila ikumbu kwŋamu daAbineri; niantu ejima hiyakudila. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.32",
            "verseOrgIds": [
              "2SA.3.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 3:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wamwimbilili Abineri mukeŋa wakudila, nindi, Abineri afwi neyi chafwaŋa chisupi? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.33",
            "verseOrgIds": [
              "2SA.3.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2SA 3:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makaseyi kuyikasa nehi, nyendu yeyi kuyisha mumpompa nehi, wudimbuki tuhu neyi chadimbukaŋa muntu kudi antu atama. Antu ejima asweja nikumudila. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.34",
            "verseOrgIds": [
              "2SA.3.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2SA 3:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu ejima hiyakuya kudi Davidi nawu, Dyaku yakudya hikuchidi mwaana. Davidi hakusanyika nindi, Neyi nukusuma hela kuyakudya hela kuyuma yacheŋi chakadi itaŋwa diholoka, Nzambi aŋili mwomumu nichakubadikamu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.35",
            "verseOrgIds": [
              "2SA.3.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2SA 3:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chachimwenuwu antu ejima atiyili kuwaha, neyi chatiyilaŋawu antu ejima kuwaha mwelilaŋayi mwanta mwejima. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.36",
            "verseOrgIds": [
              "2SA.3.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2SA 3:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niantu ejima niaIsarela ejima hiyakwiluka nawu chanajahuwu mwana kaNeri Abineri, komana hichinafumi kudi mwantaku. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.37",
            "verseOrgIds": [
              "2SA.3.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2SA 3:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta hakuyila ambuŋindi nindi, Enu komana kwiluka nenu muIsarela munadimbuki kalamba muneni lelu, nehi? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.38",
            "verseOrgIds": [
              "2SA.3.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2SA 3:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami lelu nazeyi kutoŋa yami awayishawu kwikala mwanta; awa antu anyana kaZeruwiya anasweji kunkalila; Yehova amufweti mukwakukoŋa chatama wufwetu wakweseka nachanako ŋiyi chatama.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.39",
            "verseOrgIds": [
              "2SA.3.39"
            ]
          }
        }
      ]
    }
  ],
