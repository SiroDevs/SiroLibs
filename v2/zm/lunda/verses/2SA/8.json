        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulondela henahana Davidi watapili aFwilistinu, wayifwomweni; Davidi watambwili lukanu lwaŋanda yawu kudi aFwilistinu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.1",
            "verseOrgIds": [
              "2SA.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.2",
            "verseOrgIds": [
              "2SA.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi watapili nawa niaHadadezeri, mwana kaRehobi, mwanta waku Zoba, hayilaŋayi nindi akatambuli cheŋi wanta windi kuKaloŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.3",
            "verseOrgIds": [
              "2SA.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi wamutambwili akwatuwalu ikombakaji namakulakaji atanu nayedi, akwa kwenda hamaseki makombakaji makumi ayedi; Davidi waketwili nyijila yatuwalu twamakálu twejima, hakwambulaku makálu indi nkulakaji. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.4",
            "verseOrgIds": [
              "2SA.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ASiriya akuDamakasa chayiluwu nawu akakwashi Hadadezeri, mwanta wakuZoba, Davidi watapili aSiriya makombakaji makumi ayedi namakomba kaji ayedi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.5",
            "verseOrgIds": [
              "2SA.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi washili mashidika muSiriya yakuDamakasa, aSiriya ela niambuŋaDavidi, hiyakuleta nyilambu. Yehova wemikishili Davidi mushindu kwayilaŋayi kwejima. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.6",
            "verseOrgIds": [
              "2SA.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi watambwili nkebu jawuru jadiŋi kudi ambuŋaHadadezeri, wayileteli kuYerusalema. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.7",
            "verseOrgIds": [
              "2SA.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyikala yaHadadezeri, iwu Beta, iwu Berotayi, mwanta Davidi watambwiluku wuneŋu wawuvulu nankashi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.8",
            "verseOrgIds": [
              "2SA.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.8",
            "verseOrgIds": [
              "2SA.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wakuHamati Toyi, chatiyiliyi nawu Davidi natapi dehi njita yaHadadezeri yejima, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.9",
            "verseOrgIds": [
              "2SA.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toyi hakutemesha mwanindi Yorami kudi mwanta Davidi nakumwimwisha, nakumukiswila nkisu nanochu chalwiliyi naHadadezeri, hakumutaŋa; mulopa Hadadezeri wadasilaŋa naToyi. Yorami hakusenda yuma yasiliva, niyuma yawuru, niyuma yawuneŋu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.10",
            "verseOrgIds": [
              "2SA.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyeniyi nawa Davidi wamujilikililiyi Yehova, hamu nasiliva nawuru yamujilikililiyi yakunyuza yejima yafwomeniyi; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.11",
            "verseOrgIds": [
              "2SA.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "niyakuSiriya, niyaku Mowabi, niyakudi anyana kaAmoni, niyakudi aFwilistinu, niya kuAmaleki, niyakuyuma yapupiluwu kudi Hadadezeri, mwana kaRehobi, mwanta wakuZoba.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.12",
            "verseOrgIds": [
              "2SA.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.12",
            "verseOrgIds": [
              "2SA.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi watiyakesheli ijina dindi hafuntiliyi kwayiliyi nakutapa aSiriya muChinekineki Chamugwa, kwatapiliyi antu makombakaji ikumi natanu nasatu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.13",
            "verseOrgIds": [
              "2SA.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asha nimashidika muEdomi; washili mashidika mwahita Edomi yejima, aEdomi ejima ela niambuŋaDavidi. Yehova wemikishili Davidi mushindu kwayilaŋayi kwejima.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.14",
            "verseOrgIds": [
              "2SA.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.14",
            "verseOrgIds": [
              "2SA.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi wehli mwanta wawaIsarela ejima. Davidi welili antu indi ejima nimuwuŋaji nimwaloŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.15",
            "verseOrgIds": [
              "2SA.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana kaZeruwiya Yowabi diyi wadiŋi mwanta wanjita; mwana kaAhiludi Yehoshafwati diyi wadiŋi mukwakuso neka nsaŋu; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.16",
            "verseOrgIds": [
              "2SA.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwana kaAhitubi Zadoki, nimwana kaAbiyatari Ahimeleki, diwu adiŋi atupristu; Seraya diyi wadiŋi mukwakusoneka nyikanda; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.17",
            "verseOrgIds": [
              "2SA.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwana kaYehova daBenaya diyi wadiŋi mukulumpi wawaKereti nawa Peleti; anyana kaDavidi diwu adiŋi aŋambela.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.18",
            "verseOrgIds": [
              "2SA.8.18"
            ]
          }
        }
      ]
    }
