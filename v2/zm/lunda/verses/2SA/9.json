  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "2SA 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi welili nindi, Kumutaŋa waSawulu hikwashala hoku muntukutahindi, kulonda nimwili luwi hamujimba waJonatani? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.1",
            "verseOrgIds": [
              "2SA.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumutaŋa waSawulu kwadiŋi ŋamba wumu ijina dindi Ziba. Hiyakumutambika ayi kudi Davidi. Mwanta hakumwila nindi, Yeyi Ziba tahindi? Yena nindi, Yami kambuŋeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.2",
            "verseOrgIds": [
              "2SA.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta nindi, Kumutaŋa waSawulu kuduhu muntu wumu nihanu tahindi, kulonda nimwili luwi lwaNzambi? Ziba hakumwila mwanta, nindi, Kuchidi mwana kaJonatani, hichifwayi chanyendu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.3",
            "verseOrgIds": [
              "2SA.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwantaha kumwila nindi, Wudikudihi? Ziba hakumwi amwantanindi, Wudi kwitala damwana kaAmiyeli Makiri muLodebari.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.4",
            "verseOrgIds": [
              "2SA.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.4",
            "verseOrgIds": [
              "2SA.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta Davidi hakutemesha antu nakumuleta, amufumishi kwitala daMakiri mwana kaAmiyeli, kuLodebari. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.5",
            "verseOrgIds": [
              "2SA.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mefwibosheti, mwana kaJonatani, Jonatani mwana kaSawulu, hakwinza kudi Davidi hakudimbuka chamesu hamaseki, hakudifukula. Davidi nindi, Eyi Mefwibosheti. Nindi, Yamonu kambuŋeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.6",
            "verseOrgIds": [
              "2SA.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakumwila nindi, Bayi wutiya womaku; chalala nukukwila luwi hamujimba watata yeyi Jonatani, nukuku funtishila cheŋi mpata yankaka yeyi Sawulu yejima; wukudyaŋa yakudya kumesa yami mafuku ejima. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.7",
            "verseOrgIds": [
              "2SA.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakudifukula, hakwila nindi, Kambuŋeyi hikachumanyi mwaka wutali ami mufu wakawa?",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.8",
            "verseOrgIds": [
              "2SA.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.8",
            "verseOrgIds": [
              "2SA.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta hakutambika Ziba, ŋamba yaSawulu, hakumwila nindi, Yuma yadiŋi yaSawulu yejima niyadiŋi yawantaŋa lindi nayinki dehi mwana kamwanta weyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.9",
            "verseOrgIds": [
              "2SA.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeyi wakamudiminaŋa mpata yindi hamu nawa nyaneyi nawaŋamba jeyi; wakamuletelaŋa yakudya kulonda mwana kamwanta weyi amonaŋa yakudya; kwinza mwana kamwanta weyi Mefwibosheti, wukudyaŋa yakudya mafuku ejima kumesa yami. Ziba wadiŋi nawanyanindi amayala ikumi natanu, niaŋamba makumi ayedi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.10",
            "verseOrgIds": [
              "2SA.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ziba hakumwila mwanta nindi, Mwejima mwanalejiyi nkaka yami mwanta ami kambuŋindi, dimu mwakela kambuŋeyi. Mwanta nindi, Kwinza Mefwibosheti wukudyaŋa kumesa yami neyi mwana kamwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.11",
            "verseOrgIds": [
              "2SA.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mefwi bosheti wadiŋi namwana wanyanya ijina dindi Mika. Antu ejima ashakamini mwitala daZiba elili aŋamba jaMefwibosheti. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.12",
            "verseOrgIds": [
              "2SA.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mefwibosheti hakushakama muYerusalema, muloŋa wadiilaŋa kumesa yamwanta mafuku ejima. Wadiŋi chifwayi chanyendu yonsu yiyedi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.13",
            "verseOrgIds": [
              "2SA.9.13"
            ]
          }
        }
      ]
    }
  ],
