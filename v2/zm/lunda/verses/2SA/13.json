  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "2SA 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulondela henohu mwana kaDavidi Abisalomi wadiŋi namuhelindiwalubanji, ijina dindi Tamari; amukeŋeli kudi Aminoni mwana kaDavidi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.1",
            "verseOrgIds": [
              "2SA.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aminoni hakusweja kuhilashana, hakukata nikukata nansaŋu yamuhelindi Tamari; muloŋa yena wadiŋi mujiki; Aminoni niyena watiyili kukala kumwila chuma. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.2",
            "verseOrgIds": [
              "2SA.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aminoni wadiŋi nebwambu dindi, ijina dindi Yonadabi, mwana kaShimeya mana kwaDavidi. Yonadabi wadiŋi iyala wasweja kubabala. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.3",
            "verseOrgIds": [
              "2SA.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakumwila nindi, Eyi mwana kamwanta muloŋanyi wudi nakukosa chochichi hefuku hefuku? Kunlejamu nehi? Aminoni hakumwila nindi, Namukeŋi Tamari muhelamana kwami Abisalomi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.4",
            "verseOrgIds": [
              "2SA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.6",
            "verseOrgIds": [
              "2SA.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakutemesha muntu kwitala kudi Tamari, nindi, Yaku mwani kwitala damana kweyi Aminoni, wakamuloŋesheli yakudya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.7",
            "verseOrgIds": [
              "2SA.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.7",
            "verseOrgIds": [
              "2SA.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tamari hakuya kwitala damana kwindi Aminoni, kumuwana nakami. Hakunona wuŋa wakuvuba dehi, hakuwukama, hakutuŋa mankendi kumesu indi, hakwocha mankendi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.8",
            "verseOrgIds": [
              "2SA.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanoneni meŋa, hakuyisukwila kumesu indi. Ilaŋa yena kwonti kwindi kudya. Aminoni nindi, Yifumishenu antu ejima munu munidi. Hiyakufumamu wejima wawu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.9",
            "verseOrgIds": [
              "2SA.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aminoni hakumwila Tamari, nindi, Letaku yakudya munu mukapeka, kulonda nidiili kuchikasa cheyi. Tamari hakunona mankendi atuŋilivi, hakuyitwala kudi mana kwindi Aminoni mukapeka. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.10",
            "verseOrgIds": [
              "2SA.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cheliliyi hakuyishikŋa kwakwihi nayena nindi adyi, hakumukwata, hakumwila nindi, Twaya nikami neyi, eyi muhelami. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.11",
            "verseOrgIds": [
              "2SA.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena hakumwakula nindi, Nehi, eyi mana kwami, bayi wunsawishaku. MuIsarela kwila chenichi chinjila. Bayi wila mwawusupi chochichuku. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.12",
            "verseOrgIds": [
              "2SA.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indi ami nakaya mudihi nansonyi yinakatiya? Nineyi aweni wakekala neyi ayisupi amuIsarela. Neyi chochu, hoshaku mwani namwanta; yena hakakulekesha kuntambulaku. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.13",
            "verseOrgIds": [
              "2SA.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena kwonti kwindi kutiyilila mwizu dindi. Wamuswejeleli Ŋovu, hakumusawisha, hakukama nindi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.14",
            "verseOrgIds": [
              "2SA.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.14",
            "verseOrgIds": [
              "2SA.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aminoni amuhela nikumuhela nankunyi yabadika nankashi. Nkunyi yamuheleliyi yabadikili kukeŋa kwamukeŋeliyi. Aminoni hakumwila nindi, Nyamukaku, yaku. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.15",
            "verseOrgIds": [
              "2SA.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumbanda hakumwila nindi, Chinida! Ichi chiwukunhaŋa, chatama. Chinabadiki dehi kutama kukwawu kuwuna ŋili. Yena kumutiyilila kwonti kwindi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.16",
            "verseOrgIds": [
              "2SA.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakutambika ŋamba yindi wamukalakelelaŋa, hakwila nindi, Muhaŋi iwu mumbanda munu munidi, wumupatilihanzi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.17",
            "verseOrgIds": [
              "2SA.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena mumbanda wadiŋi wavwala chikovwelu chama hina eŋi na eŋi; muloŋa wena makanji owu diwu avwalilaŋa anyana kamwanta achidi ajiki. Ŋamba yindi hakumwidisha, hakumupatila hanzi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.18",
            "verseOrgIds": [
              "2SA.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tamari hakudisukwila wuti kunamutu, hakutabula chikovwelu chindi chamahina eŋi na eŋi chavweliyi, hakukwata mbimbanamutu, hakuya, iku wudi nakudila ikumbu, iku wudi nakwenda.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.19",
            "verseOrgIds": [
              "2SA.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.19",
            "verseOrgIds": [
              "2SA.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana kwindi Abisalomi hakumwila nindi, Wunadiŋi namana kweyi Aminoni, tahindi? Mwenaku dinu muhelami, yena himana kweyi; bayi wuchisha kumuchima weyuku. Tamari hakushakama kwitala damana kwindi Abisalomi nakaneŋu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.20",
            "verseOrgIds": [
              "2SA.13.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.20",
            "verseOrgIds": [
              "2SA.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta Davidi chatiyiliyi yumiyi yejima, wazuwili nankashi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.21",
            "verseOrgIds": [
              "2SA.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisalomi hahosheli naAminoni hela mwamuwahi hela mwatamaku, muloŋa Abisalomi wamuheleli Aminoni nanochu chamusawishiliyi muhelindi Tamari.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.22",
            "verseOrgIds": [
              "2SA.13.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.22",
            "verseOrgIds": [
              "2SA.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimwahitili nyaka vamana chikupu yiyedi, Abisalomi hakwikala nawakwakutewula nyikoku kuBayali Hazori, wekala kwakwihi naEfweremi. Abisalomi hakutambikaku anyana kamwanta amayala ejima. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.23",
            "verseOrgIds": [
              "2SA.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisalomi hakwinza kudi mwanta, nindi, Tiya mwani, kambuŋeyi wudi nawakwakutewula nyikoku. Mwanta nawambuŋindi ayi mwani nakambuŋeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.24",
            "verseOrgIds": [
              "2SA.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta hakumwila Abisalomi, nindi, Nehi, mwanami, bayi tuya wejima wetuku, twakenza kakukabisha. Hakumukakeja. Hela chochu, hetŋili kuyaku, wakuminini dakumukiswila nkisu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.25",
            "verseOrgIds": [
              "2SA.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisalomi nindi, Neyi nehi, amwitŋi mwani mana kwami Aminoni tuyi nindi. Mwanta hakumwila nindi, Wukuyiladi nindi? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.26",
            "verseOrgIds": [
              "2SA.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisalomi hakumukakeja, yena hakwitŋa niAminoni nianyana kamwanta amayala ejima kuya nindi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.27",
            "verseOrgIds": [
              "2SA.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisalomi waleja dehi aŋamba jindi, nindi, Chimwakamona mwani muchima wa Aminoni hiwukuzaŋajala navinyu, hinakela nami, Mutapenu Aminoni, himwakamujaha, bayi mwakatiya womaku. Netu, yami inayilejuku? Mwakadi kwatishaŋa mwakekalaŋa ayilobu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.28",
            "verseOrgIds": [
              "2SA.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋamba jaAbisalomi hiya kumwila Aminoni mwomwayilejeluwu kudi Abisalomi. Anyana kamwanta ejima hiyakunyamoka, hiyakukandama kandama hayi ngonŋavalu yawu, hiyakutemoka.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.29",
            "verseOrgIds": [
              "2SA.13.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.29",
            "verseOrgIds": [
              "2SA.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cheliluwu achidi munjila, nsaŋu hijikushika kudi Davidi jakwila nawu, Abisalomi najahi dehi anyana kamwanta amayala ejima, niwumu wakusha lahu nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.30",
            "verseOrgIds": [
              "2SA.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta hakunyamuka hakutabola mahinindi, hakukama niheseki. Ambuŋindi ejima hiyakwimanaku mahinawu akutabola dehi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.31",
            "verseOrgIds": [
              "2SA.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonadabi mwana kaShimeya mana kwaDavidi, hakuhosha nindi, Nkaka yami bayi atoŋojoka nindi anajahi anyana kamwanta anyikwenzi ejimaku. Nafwi Aminoni hohu. Chamukanwa kaAbisalomi chumichi achifuukula dehi kufumisha hefuku damusawishiliyi muhelindi Tamari. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.32",
            "verseOrgIds": [
              "2SA.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi dinu, nkaka yami mwanta, bayi asha muchima kuchumichuku, bayi atoŋojoka nindi anyana kamwanta amayala anafwi ejimaku, nafwi yowu Aminoni hohu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.33",
            "verseOrgIds": [
              "2SA.13.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.33",
            "verseOrgIds": [
              "2SA.13.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2SA 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa Abisalomi watemukili. Mukwenzi mukwakutalatala nindi afu mbuli mesu atali, hakumona kunyima yindi kudi nakwinza antu amavulu mwivumu dampidi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.34",
            "verseOrgIds": [
              "2SA.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2SA 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonadabi hakumwila mwanta nindi, Tala, anyana kamwanta awa anenzi dehi awa, mwomwanahoshaŋa kambuŋeyi dimu chineli. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.35",
            "verseOrgIds": [
              "2SA.13.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2SA 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cheliliyi nindi akumishi kuhosha, kutala anyana kamwanta anenzi dehi, avwakuka nimumakumbu akudila. Nimwanta nawa niambu ŋindi ejima adilili nankashi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.36",
            "verseOrgIds": [
              "2SA.13.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2SA 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.36",
            "verseOrgIds": [
              "2SA.13.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2SA 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa Abisalomi watemukili, wayili kudi Talimayi mwana kaAmihuri mwanta wakuGeshuri. Davidi wadilili mwanindi hefuku hefuku.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.37",
            "verseOrgIds": [
              "2SA.13.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2SA 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.37",
            "verseOrgIds": [
              "2SA.13.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2SA 13:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Abisalomi watemukili hakuya kuGeshuri, hakushakamaku nyaka yisatu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.38",
            "verseOrgIds": [
              "2SA.13.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2SA 13:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta Davidi wafwilili nankashi kumona Abisalomi, muloŋa henohu wadikundeja dehi nansaŋu yaAminoni, nindi wafwa dehi kwindi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.39",
            "verseOrgIds": [
              "2SA.13.39"
            ]
          }
        }
      ]
