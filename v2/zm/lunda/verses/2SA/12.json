      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova hakutemesha Natani kudi Davidi. Hakwinza kudi yena, hakumwila nindi, Hamukala wumu hadiŋi amayala ayedi, wumu mukwakuheta, mukwawu kazweŋi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.1",
            "verseOrgIds": [
              "2SA.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukwakuheta wadiŋi namayinda nimataŋa amavulu; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.2",
            "verseOrgIds": [
              "2SA.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kazweŋi hadiŋi nachumaku, wadiŋi nakana kamukoku kamukaji kamu hohu kakulanda chakulanda, hakukalela. Hikakukulila kudi yena hamu nawanyanindi; kadiili nindi hamu, hikakunwinaŋa mulu pasa lwindi yomweni, hikakukamaŋa hantulu yindi, hikakwikala neyi mwa nindi wamumbanda. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.3",
            "verseOrgIds": [
              "2SA.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kweyala waheta kwenjili mukwakwenda. Haku leka kukwata chimuna chamwiyinda dindi, hela chamwitaŋa dindi, adiishi mukwakwcnda nenzi kudi yena, hakukwata kana kamukoku keyala waka zweŋi, hakumudiisha owu iyala wenjili kudi yena.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.4",
            "verseOrgIds": [
              "2SA.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.4",
            "verseOrgIds": [
              "2SA.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakuzuwa nankashi nansaŋu yayenowu iyala. Hakumwila Natani, nindi, Chahandayi Yehova kwaamu, owu iyala nakoŋi chumichi nateli kufwa, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.5",
            "verseOrgIds": [
              "2SA.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "akafuntishi nyikoku yiwana nanoku kana kamukoku, nanochu chanakoŋiyi chumichi, chanabuliyi niluwi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.6",
            "verseOrgIds": [
              "2SA.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.6",
            "verseOrgIds": [
              "2SA.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natani hakumwila Davidi, nindi, Iyalowu yeyi. Yehova Nzambi yaIsarela nahoshi nindi, Ami nakuwayishili kwikala mwanta wawaIsarela, ami nakupulwishili kudi Sawulu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.7",
            "verseOrgIds": [
              "2SA.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakwinkeli mutaŋa wamwanta weyi, nakwinkeli niaŋodi jamwanta weyi akamaŋa kunyima yeyi, nakwinkeli nimutaŋa waIsarela naYuda. Hela neyi yenoyu yakukehela asi nakushiluku mwonsu muwunakeŋeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.8",
            "verseOrgIds": [
              "2SA.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indi wunadiwilidi izu daYehova mwaka wukoŋi chumichi chatama kumesu indi? Wunatapi dehi kaHiti Uriya nampoku yakabali, wunatambuli dehi niŋodindi hakwikala ujodeyi, wunamujahi dehi nampoku yakabali yawanyana kaAmoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.9",
            "verseOrgIds": [
              "2SA.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi dinu mpoku yakabali hiyamba kafuma kumutaŋa weyuku haya nyaka. Muloŋa wunandiwuli dehi, wunatambuli iŋodakaHiti Uriya ekali ipodeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.10",
            "verseOrgIds": [
              "2SA.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nahoshi nindi, Tiya, nukukusaŋumwina yatama kumutaŋa weyi, nukukutambula aŋodi jeyi, eyi aweni wumonaŋa, nukuyinka mukwenu, wakakama nawu mwaana wetenda. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.11",
            "verseOrgIds": [
              "2SA.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi wachikoŋeleli kumbadi, hakwila ami chumichi nakachila namwaana, aIsarela ejima amonaŋa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.12",
            "verseOrgIds": [
              "2SA.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.12",
            "verseOrgIds": [
              "2SA.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakumwila Natani, nindi, Namuvulumuni dehi Yehova. Natani hakumwila Davidi, nindi, Yehova niyena nafumishi dehi nshidi yeyi, hiwakafwaku. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.13",
            "verseOrgIds": [
              "2SA.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Helachochu, ichichiwunaleteshi ayilumbuja Yehova kudi wula nankashi nachumichi chiwunakoŋi, iwu mwana navwaliki kudeyi wakafwa hohu chalala. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.14",
            "verseOrgIds": [
              "2SA.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natani hakudiyila nikwitala dindi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.15",
            "verseOrgIds": [
              "2SA.12.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova hakumweta mwana avweleleluwu Davidi kudi iŋoda Uriya, haku kata nankashi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.15",
            "verseOrgIds": [
              "2SA.12.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.23",
            "verseOrgIds": [
              "2SA.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi wamukundejeli iŋodindi Batisheba, weŋilili mwadiŋiyi, wakamini nindi. Wamuvweleli mwana weyala, Davidi wanamutumbili ijina dindi nindi Solomoni. Yehova wamukeŋeli, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.24",
            "verseOrgIds": [
              "2SA.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakutemesha kaprofwetu Natani, hakunamutumba ijina dindi nindi Yedidiya, hansaŋu yaYehova.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.25",
            "verseOrgIds": [
              "2SA.12.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.25",
            "verseOrgIds": [
              "2SA.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowabi walwili naRaba mukala wawanyana kaAmoni, watambwili ŋanda yamwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.26",
            "verseOrgIds": [
              "2SA.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowabi hakutemesha antemesha kudi Davidi, nindi, Nalwa dehi naRaba, mwalala natambula dehi mukala wamajiya. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.27",
            "verseOrgIds": [
              "2SA.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi dinu pompeshaku antu anashali, winzi wuteekeleli mukala, wuwutambuli; kuchina kuwutambula kudami, akenza kawutumba ijina dami. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.28",
            "verseOrgIds": [
              "2SA.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakupompesha antu ejima, hakuya kuRaba, hakulwa nawu, hakuwutambula. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.29",
            "verseOrgIds": [
              "2SA.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakufumisha chibaŋula chamwanta wawu kunamutu windi, pezu yachu yashikili muntalenta yawuru yimu, chadiŋi natumalola twalema. Hiya kuchisha kunamutu waDavidi; yena hakwidisha yuma yamumukala yapupiluwu yayivulu nankashi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.30",
            "verseOrgIds": [
              "2SA.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwidishamu antu adiŋumu, hakuyisha mwishina dampoku jamazewu, nimwishina dayikuŋu yamajimaji, nimwishina dayizembi yayikuŋu, wayihanwishili nimuyibidi yamatafwali. Dimu mwakoŋeliyi nyikala yawanyana kaAmoni yejima. Davidi nawantu ejima hiyakufunta kuYerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.31",
            "verseOrgIds": [
              "2SA.12.31"
            ]
          }
        }
      ]
    }
  ],
