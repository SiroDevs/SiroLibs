              "type": "text"
            }
          ]
        },
        {
          "text": "Wakatuŋi ihina dakujika nachu, dawuzeeli, nawusombu, nawanda wuchinana nge, niwanda wawuwahi wakushinta, akadituŋa nawakerubi akuchiminamu kudi akwawukalawenu; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.31",
            "verseOrgIds": [
              "EXO.26.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
