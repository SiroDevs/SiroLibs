          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakadikudiki hayishimi yiwana nyanyitondu yanyishitimi yakulamikahu wuru, mbwambu jayu jakukudi kilajakeli jawuru, mayandayu akuyimikila asiliva. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.32",
            "verseOrgIds": [
              "EXO.26.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
