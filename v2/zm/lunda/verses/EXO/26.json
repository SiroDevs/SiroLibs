          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihina dakujika nachuwakadikudi ki mwishina dankobu, mwenomu mukachi kehina dakujika nachu wakeŋijumu chimbaŋu chawunsahu; ihina dakujika nachu dakayambwili mwajila namwamweni mwajila. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.33",
            "verseOrgIds": [
              "EXO.26.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 26:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakashi itanda daluwi hewulu dachimbaŋu chawunsahu muna mwamweni mwajila.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.34",
            "verseOrgIds": [
              "EXO.26.34"
            ]
          }
        }
