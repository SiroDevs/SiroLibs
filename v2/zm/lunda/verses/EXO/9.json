    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wamwilili Mosi, nindi, Iŋilaku mudi Fwaro, wumwili neyi, Tiya chanahoshiyi Yehova, Nzambi yawaHeberu, nindi, Yileki antu ami ayi akankalakeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.1",
            "verseOrgIds": [
              "EXO.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi kwonti kweyi kuyileka, neyi saŋa wayikakelahohu, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.2",
            "verseOrgIds": [
              "EXO.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakamona chikasa chaYehova chakakwata hayimuna yeyi yidimumpata; nihatuwalu, nihayimbulu, nianŋameli, nihaŋombi, nihayimunayanyanya; kwakela musoŋu watama nankashi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.3",
            "verseOrgIds": [
              "EXO.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayimuna yawaIsarelana yimuna yawaEjipitu Yehova waka ambula hakachi, hayimuna yejima yawanyana kaIsarela hihakafwa hoku niwumuku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.4",
            "verseOrgIds": [
              "EXO.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nakani dehi nihakachi koŋelayi, nindi, Kumadiki Yehova wakakoŋa chumichi munumwituŋa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.5",
            "verseOrgIds": [
              "EXO.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.5",
            "verseOrgIds": [
              "EXO.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi chikwachili Yehova welili chumochu, yimuna yejima yamuEjipitu yafwili; ilaŋa hayimuna yawanyana kaIsarela hihafwili hoku niwumuku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.6",
            "verseOrgIds": [
              "EXO.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fwaro watemesheluku nakwihula, komana chalala, hayimunaya waIsarela hihafwili hoku chimunaku, niwumuhu ntahi. Ilaŋa muchima waFwaro saŋa wadi kaŋila mbe, hayilekeli antuku.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.7",
            "verseOrgIds": [
              "EXO.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.7",
            "verseOrgIds": [
              "EXO.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wayilili aMosi naAroni, nindi, Zomonenu wuti wamulutenina makasenu, Mosi awufukumuni mwiwulu Fwaro chochamutalayi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.8",
            "verseOrgIds": [
              "EXO.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wukwi kala lunkupu lwapepela nankashi mwejima mwahita ituŋa daEjipitu, wukubalumuka mahuti akubujika, niyilonda hamu, nihadi antunihadi anyama, mwejima mwahita ituŋa daEjipitu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.9",
            "verseOrgIds": [
              "EXO.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azomweni wutiwa muluteŋi, ayili nakwimana kumesu aFwaro. Mosi wawufukumwini mwiwulu, wabalumukili himahuti akubujika, niyilonda hamu nihadi antunihadi anyama. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.10",
            "verseOrgIds": [
              "EXO.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niatutepa akaŋenyi kwimana kumesu aMosi muloŋawa mahuti; muŋa niatutepa adiŋi namahuti, ni aEjipitu ejima adiŋi nawu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.11",
            "verseOrgIds": [
              "EXO.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wachinchikishili muchima waFwaro, haytŋiluku, mwomwahosheliyi Yehova naMosi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.12",
            "verseOrgIds": [
              "EXO.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.12",
            "verseOrgIds": [
              "EXO.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wamwilili Mosi, nindi, Wakamenekeshapa budidi, wakayinakwimana kumesu aFwaro, wakamwili neyi, Tiya chanahoshiyi Yehova, Nzambi yawaHeberu, nindi, Yileki antu ami, ayi akankalakeli.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.13",
            "verseOrgIds": [
              "EXO.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.13",
            "verseOrgIds": [
              "EXO.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi dinunukutemesha hamuchima weyi, nihadi ambuŋeyi, nihadi antu eyi, yipupuyami yejima, kulonda wiluki neyi hanu hamaseki hejima hikudi wakwesekananamuku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.14",
            "verseOrgIds": [
              "EXO.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukwolola kwami chikasa chami dinu kulonda ni kubabeshinineyi niantu eyi ejima nanyisoŋu; akakufumisha hanu hamaseki. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.15",
            "verseOrgIds": [
              "EXO.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chalala dichi chinakulemesheli kulonda nikumwekesheli Ŋovu yami, kulonda ijina dami dakatiyakani mwejima mwahita maseki. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.16",
            "verseOrgIds": [
              "EXO.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nihanu wudi kaŋaŋatuhu nawantu ami chakadi kuyumbaku, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.17",
            "verseOrgIds": [
              "EXO.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiya, itaŋwa dakuma di kichidakashika itaŋwa hohenohu hidinashiki, nakanokesha nvula yamalola yeneni nankashi, antu kanda dehi amonaŋahu nvula yidi chochochumunu muEjipitu, kufumisha hamwaka wakusambila nakushika kwitaŋwadaleluku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.18",
            "verseOrgIds": [
              "EXO.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu temeshaku wiŋiji swayi swayi yimuna yeyi, niyuma yeyi yejima yidi mumpata, muloŋa niantu ejima, nianyama ejima aka shintakeshawu mumpata, akabula kuletawu hamukala, nvula yamalola yakayinoka, akafwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.19",
            "verseOrgIds": [
              "EXO.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahadi ambuŋa Fwaro atiyili woma wezu daYehova atemwishili ni aŋamba jawu niyimuna yawu nakuyiŋa mumatala; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.20",
            "verseOrgIds": [
              "EXO.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "abulili kwakama izu daYehova ashiyili ni aŋamba jawu niyimuna yawu mumpata.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.21",
            "verseOrgIds": [
              "EXO.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.21",
            "verseOrgIds": [
              "EXO.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wamwilili Mosi, nindi, Ololaku chikasa cheyi kwiwulu kulondanvula yamalola yinoki mwituŋa dejima daEjipitu, yinoki niantu ni anyamani nyitondu yayisakola yakudima yejima yekala mumaha, mwejima mwahita ituŋa daEjipitu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.22",
            "verseOrgIds": [
              "EXO.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi wolweli chikasa chindi kwiwulu nimbwechiyindi; Yehova watemesheli nikudidima ninvula yamalola, ni kesi kahitililufuchi nakuholokela hamaseki; Yehova wanokesheli hetuŋa daEjipitu nvula yamalola. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.23",
            "verseOrgIds": [
              "EXO.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwadiŋi nimalola, ni kesi kadibomba namalola, kakala nankashi, kanda dehi achimonaŋahu dehi mwituŋa daEjipitu dejima kufumisha hatachi kiluwu aEjipitu kutuŋa nyikalaku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.24",
            "verseOrgIds": [
              "EXO.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwejima mwahitili ituŋa daEjipitu nvula yamalola yahumpwili yejima yadiŋi mumaha, niantuni anyama; nvula yamalola yahumpwili ninyitondu yayisakola yakudi mayamumaha, yakotweli ninyitondu yamaneni yejima yamumaha namumasaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.25",
            "verseOrgIds": [
              "EXO.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiŋa mwituŋa daGosheni hohu, mwashakaminuwu anyana kaIsarela, mwomwabulili nvula yamalola.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.26",
            "verseOrgIds": [
              "EXO.9.26"
            ]
          }
        }
      ]
    },
