            }
          ]
        },
        {
          "text": "Fwaro watemesheli nakutambika aMosi naAroni, wayilili nindi, Ichinavulumuni dehi; Yehova diyi waloŋa, ninami niantu ami twatama. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.27",
            "verseOrgIds": [
              "EXO.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulembelelenu Yehova; iku kudidima kweneni ninvula yamalola yinawani dehi, nukuyileka kwami, himwakashakama nawa cheŋuku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.28",
            "verseOrgIds": [
              "EXO.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosiwa mwilili nindi, Chinukufuma hamukala nukumwolwela Yehova makasami, nikudidima kwakamwena, hikwakela nawa cheŋi ninvula yamalolaku, kulonda wakeluki neyi maseki ambala aYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.29",
            "verseOrgIds": [
              "EXO.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwinza nineyini ambuŋeyi nayiiluki nami himwaka mutiya Yehova Nzambi womaku, kanda. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.30",
            "verseOrgIds": [
              "EXO.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nifwalakisi nibali yachikekeli, bali yadiŋi yasoŋa dehi, fwalakisi yadiŋiyakenuka dehi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.31",
            "verseOrgIds": [
              "EXO.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwinza tidiku namakundi hiyachikekeluku, muloŋa yachidiŋi kanda yikuli.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.32",
            "verseOrgIds": [
              "EXO.9.32"
            ]
          }
        }
      ]
    },
