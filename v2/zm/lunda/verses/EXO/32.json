          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chikwachili Mosi wayilili antu, nindi, Enu munavulumuni nshidiyeneni; ichi dinu hinukukandama cheŋi hampidi niyi kudi Yehova, hadahanakela yakubuta nachu nshidi yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.30",
            "verseOrgIds": [
              "EXO.32.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi wafuntili cheŋi kudi Yehova, welili nindi, Nalembi mwani, awa antu anavulumuni dehi nshidi yeneni, aneli dehi akishi awu awuru. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.31",
            "verseOrgIds": [
              "EXO.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi dinu neyi wukuyanakena nshidiyawu! Neyi nehi, anjimi mwani kumukanda weyi wunasoneki.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.32",
            "verseOrgIds": [
              "EXO.32.32"
