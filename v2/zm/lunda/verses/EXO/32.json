            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 32:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaLevi elili mwomwizu daMosi; denodu ifuku hafwili antu neyi kwiji makombakaji asatu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.28",
            "verseOrgIds": [
              "EXO.32.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 32:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosiwelili nindi, Dikunjikenu lelu kudi Yehova, mwalala iwu hamujimba wamwanindi weyala, iwu hamujimba wamana kwindi, kulonda ayikiswilinkisu lelu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.29",
            "verseOrgIds": [
              "EXO.32.29"
            ]
          }
        }
      ]
    },
    {
