  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "EXO 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wamwilili Mosi, nindi, Yaku mudi Fwaro wumwili neyi, Tiya chanahoshiyi Yehova, nindi, Yileki antu ami ayi, akankalakeli.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.1",
            "verseOrgIds": [
              "EXO.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.4",
            "verseOrgIds": [
              "EXO.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wamwilili Mosi, nindi, Mwili Aroni neyi, Ololaku chikasa cheyinambwechi yeyi hatuloŋa twamaneni, nihatuloŋa twanyanya, nihamajiya, wukandwishumu yúula yiyi mwituŋa daEjipitu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.5",
            "verseOrgIds": [
              "EXO.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni wolweli chi kasachindi hameji amuEjipitu, yúula yakandukilumu, yajikili ituŋa daEjipituwi-i. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.6",
            "verseOrgIds": [
              "EXO.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atutepa niwena elili chochimu nawana wawu, akandwishilumu yúula, yayili mwituŋa daEjipitu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.7",
            "verseOrgIds": [
              "EXO.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.7",
            "verseOrgIds": [
              "EXO.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fwaro watambikili Mosi naAroni, wayilili nindi, Mulembelele naYehova anfumishili yúula, ayifumishi nikudi antu ami, ami nukuyileka antu akuya akamuketwili Yehova yimuna. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.8",
            "verseOrgIds": [
              "EXO.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi wamwilili Fwaro, nindi, Disambi tuhu kweyi; ifukwinyi nukukulembelelaku eyi, nukuyilembelelaku niambuŋeyi niantu eyi kulonda yúula yikisiki yifumi nihadi eyi nimumataleyi, yishali kwamukaloŋa hohu? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.9",
            "verseOrgIds": [
              "EXO.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena nindi, Kumadiki. Mukwawunindi, Chaka mwekana mwomu wunahoshi, kulonda wakeluki neyi hikwekala wakweseka naYehova Nzambi yetuku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.10",
            "verseOrgIds": [
              "EXO.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yúula yakafuma nihadeyi, nimumataleyi, nihadi ambuŋeyi, nihadi antu eyi; yakashala kwamukaloŋa hohu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.11",
            "verseOrgIds": [
              "EXO.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.11",
            "verseOrgIds": [
              "EXO.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi naAroni edi kili mwadiŋi yi Fwaro. Mosi watambikili kudi Yehova hansaŋu yayúula yamuleteleliyi Fwaro. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.12",
            "verseOrgIds": [
              "EXO.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova welili mwomwahosheliyi Mosi; yúula yafwili zo-o nimumatala, nimuyipapu, nimumaha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.13",
            "verseOrgIds": [
              "EXO.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.15",
            "verseOrgIds": [
              "EXO.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wamwilili Mosi, nindi, Mwili Aroni neyi, Ololaku mbwechiyeyi, weti halunkuŋu lwahamaseki, lubalumuki nkusa mwejima mwahita ituŋa daEjipitu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.16",
            "verseOrgIds": [
              "EXO.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi cheliluwu. Aroni wolweli chikasa chindinambwechi yindi, weteli halunkuŋu lwahamaseki, hikukwila nkusa nihadiantu, hihadi anyama; lunkuŋu lwejima lwahamaseki lwabalumukili nkusahohu mwejima mwahita ituŋa daEjipitu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.17",
            "verseOrgIds": [
              "EXO.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atutepa elili chochimunawaŋa wawu, nawu aleti nkusa, hiyatwesheluku. Kwadiŋi nkusa nihadiantu, nihadi anyama. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.18",
            "verseOrgIds": [
              "EXO.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atutepa amwilili Fwaro, nawu, Iwu himuntu waNzambi. Muchima waFwaro wachinchikihi, hayujiluku, mwomwahosheliyi Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.19",
            "verseOrgIds": [
              "EXO.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.19",
            "verseOrgIds": [
              "EXO.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wamwilili Mosi, nindi, Wakamenekesha budidi, wakemani kumesu aFwaro; wakamuwana hakuya kumeji; wakamwili neyi, Tiya chanahoshiyi Yehova, nindi, Yileki antu ami ayi akankalakeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.20",
            "verseOrgIds": [
              "EXO.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyikwonti kweyi kuyileka antu ami, ami nakatemesha malembu awanjinji hadeyi, nihadi ambuŋeyi, nihadi antu eyi, nimumataleyi; mumatala awaEjipitu mwakenzala to-o malembu awanjinji, nihamaseki hakeliya bwi diwuhohu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.21",
            "verseOrgIds": [
              "EXO.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Denodu ifuku naka ambulaku ituŋa daGosheni dashakama antu ami, kulonda mwakabuli kwikala malembu awanjinji, kulonda wakeluki neyi ami yami Yehova hakachi kamaseki. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.22",
            "verseOrgIds": [
              "EXO.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hadi antu ami nahadi antu eyinaka ambula hakachi. Chinjikijilu ochu chakamwekana kumadiki. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.23",
            "verseOrgIds": [
              "EXO.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichicheliliyi Yehova. Kwenjili malembu aweni awanjinji, eŋilili mwitala daFwaro, nimumatala awambuŋindi, ni mwituŋa daEjipitu dejima, ituŋa datokeli bu-lu-lu namalembu awanjinji.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.24",
            "verseOrgIds": [
              "EXO.8.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.24",
            "verseOrgIds": [
              "EXO.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fwaro watambikili Mosi naAroni, wayilili nindi, Yenu mumuketwili Nzambi yenu yimuna munu mwituŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.25",
            "verseOrgIds": [
              "EXO.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi welili nindi, Hichikuwahakwila chochinaku, muloŋa chitwakamuketwila Yehova Nzambi yetu yimuna aEjipitu akatumona tunashimi chikupu. Etu twakaketuli yimuna twakashimi kumesu awaEjipitu, tahindi? Hiyakatwasa malolaku? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.26",
            "verseOrgIds": [
              "EXO.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twakaya mwisaŋa kwakulehi kwakwenda mafuku asatu, twakamuketwila Yehova Nzambi yetu yimuna, mwomwa katulejayi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.27",
            "verseOrgIds": [
              "EXO.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchinka Fwaro nindi, Nukuyileka mukuya mumuketwili Yehova Nzambi yenu yimuna mwisaŋa; bayi muya dinu kwakulehi nankashuku. Nlembelele nuku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.28",
            "verseOrgIds": [
              "EXO.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosinindi, Tiya, ami nukukushiya, nukuya nimulembeleli Yehova kulondamalembu awanjinji akafumi kudi Fwaro, nikudi ambuŋindi, nikudi antu indi, kumadiki. Ilaŋa dinu Fwaro bayi akadimbana cheŋi nákubula kuyileka antu ayi nakumuketwila Yehova yimunaku.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.29",
            "verseOrgIds": [
              "EXO.8.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.29",
            "verseOrgIds": [
              "EXO.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi wamushiyili Fwaro, wayili nakumulembelela Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.30",
            "verseOrgIds": [
              "EXO.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova welili mwomwahosheliyi Mosi, wafumishiluku malembu awanjinji kudi Fwaro, nikudi ambuŋindi, nikudi antu indi, hikwasheli niyimuku. ",
