          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi chiwakelina ŋombi jeyi, nanyikoku yeyi; wakashakami mafuku atanu nayedi namamayindi, ifuku damu chitanu nachisatu wakanyinkiyi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.30",
