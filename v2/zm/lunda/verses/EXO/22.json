          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi wakahosha nakudiwula Nzambuku, hela kushiŋa bayi wakashika nyuli yawantaŋa jeyuku.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.28",
            "verseOrgIds": [
              "EXO.22.28"
