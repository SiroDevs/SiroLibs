          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi wakalaba kulambula hela yakudya yeyi yamumaha, hela vinyuyeyi yinavuli dehuku.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.29",
            "verseOrgIds": [
              "EXO.22.29"
