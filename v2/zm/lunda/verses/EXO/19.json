    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakakweji kamuchisatu nahafuminuwu anyana kaIsarela mwituŋa daEjipitu, dodifuku dodimu ashikili mwisaŋa daSinayi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.1",
            "verseOrgIds": [
              "EXO.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chafumi nuwuku Refwidimi, chashikiluwu kwisapa daSinayi, atuŋili chilombuchawu mwisaŋa; kwenoku aIsarela ashakamini nakutala mesu kumpidi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.2",
            "verseOrgIds": [
              "EXO.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi wakandukili kudi Nzambi, Yehova hadiŋiyi hana hampidi wamutambi kili, wamwilili nindi, Tiya muwakahosha namutaŋa waYakoba, muwakayileja anyana kaIsarela, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.3",
            "verseOrgIds": [
              "EXO.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "neyi, Enu munamoni chinayikoŋeli aEjipitu, chinayelekeli kwami hampuula jambuulu, chinayishi kŋili kudami aweni.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.4",
            "verseOrgIds": [
              "EXO.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.4",
            "verseOrgIds": [
              "EXO.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu neyi chalala mukwovwahilaŋa izu dami, neyi mukuhe mbaŋa chitiyaŋenu chami, mukwi kala chuma chalema, chamami awenicha kwambula munyuza yejima yawantu; muloŋa iseki dejima damami; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.5",
            "verseOrgIds": [
              "EXO.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "mukwi kala wanta wami wawatupristu, nimuza wajila. Diwu mazuiwukuhosha kudi anyana kaIsarela. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.6",
            "verseOrgIds": [
              "EXO.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi wayili watambikili awakulumpi jawantu, wayishimwinini mazu awa ejima amulejeli Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.7",
            "verseOrgIds": [
              "EXO.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu ejima aakwilili hamu, nawu, Mwejima mwanahoshiyi Yehova tukwilamu. Mosi wafuntishili mazu awantu kudi Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.8",
            "verseOrgIds": [
              "EXO.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wamwilili Mosi nindi, Tiya, ami nakenza kudeyimwivu dashishita, kulonda awa antu akatiyi chinakahosha naneyi, akakwitiyaŋa haya nyaka. Mosi walejeli Yehova mazu ahosheluwu antu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.9",
            "verseOrgIds": [
              "EXO.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.9",
            "verseOrgIds": [
              "EXO.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wamwilili Mosi, nindi, Yaku kudi antu, wuyijiliki nilelunikumadi ki, akosi nimahinawu, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.10",
            "verseOrgIds": [
              "EXO.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "akadiloŋeshaŋahu dehi kulonda kutalila ifuku damu chisatu; muloŋa hefuku damu chisatu Yehova wakasulukila kumpidi yaSinayi kumesu awantu ejima. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.11",
            "verseOrgIds": [
              "EXO.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanyeŋu mwishiluku antuchipaŋu kwi-ndo, wakayili neyi, Babalenu, bayi mukanduka hampiduku, hela kukwata kuŋinza jayu bayi mukwata kwokuku, yowu wakakwata hampidi akamujahi hohu chalala; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.12",
            "verseOrgIds": [
              "EXO.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "bayi akamukwita namakasaku, chiŋa akamusowela malola, hela kumwasa muvu, hela kanyama hela muntu, bayi akahandaku; chiyakavuma mpùŋa vume-e, tu-u-u, haleha, akakanduka nakwinza kumpidi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.13",
            "verseOrgIds": [
              "EXO.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi wakunku mukili hampidi nakuya kudi antu, wayijilikili antu; akoseli mahinawu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.14",
            "verseOrgIds": [
              "EXO.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.14",
            "verseOrgIds": [
              "EXO.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayilili antu nindi, Diloŋeshaŋahu dehi kulondakutalila ifuku damu chisatu; bayi mukundama kwakwihi namumbandaku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.15",
            "verseOrgIds": [
              "EXO.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hefuku damu chisatu, chikwachili budidi, kwelili nikudidima nikukenasana, niivu dashishita hana hampidi, mpinja yavumini nankashi naŋovu; antu ejima adiŋi muchilombu kwakudiza alila hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.16",
            "verseOrgIds": [
              "EXO.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi wayiidishili antu muchilombu kulonda amubulakani Nzambi; emeni kwishina dampidi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.17",
            "verseOrgIds": [
              "EXO.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpidi yaSinayi yafwindashanini kwawishi hohu, muloŋa Yehova wasulukililuku mukesi; wishi wayu wakakumukili neyi wishi wakuluteŋi, nimpidi yejima yakankili nankashi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.18",
            "verseOrgIds": [
              "EXO.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiyavumini mpùŋa, hiyi kusweja ni kuswejakuvuma, Mosi hakuhosha, niNzambi hakumwakula nezu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.19",
            "verseOrgIds": [
              "EXO.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wasulukilili kumpidi yaSinayi, kunamutu wampidi kachi; Yehova wamutambi kiliMosi ayi hewulu dampidi; Mosi wakandaminuku.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.20",
            "verseOrgIds": [
              "EXO.19.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.20",
            "verseOrgIds": [
              "EXO.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wamwilili Mosi, nindi, Kunkumukaku, wuyi kumiki antu, akenza kabuza chipaŋu, epili mwadiyi Yehova atali, amavulu akenza kajilumuka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.21",
            "verseOrgIds": [
              "EXO.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niatupristu nawa, akwinza kwakwihi naYehova, chiŋa adijilika, Yehova wakenza kayilotokela. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.22",
            "verseOrgIds": [
              "EXO.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi wamwilili Yehova, nindi, Antu hiyanatweshi kukandama hampidi yaSinayuku, muloŋa eyi watulejaneyi, Nyepu mwishaku chipaŋu kumpidi, wuyijiliki. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.23",
            "verseOrgIds": [
              "EXO.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wamwililinindi, Yaku, kunkumukaku; wakenza cheŋi kunu, nineyi niAroni hamuneyi; ilaŋa niatupristu niantu bayi abuza chipaŋu nakushika munu mwadiyi Yehovaku, wakenza kayilotokela. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.24",
            "verseOrgIds": [
              "EXO.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nochu Mosi wakunku mukili kwadi ŋuwu antu, wayilejeli.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.25",
            "verseOrgIds": [
              "EXO.19.25"
            ]
          }
        }
      ]
    }
