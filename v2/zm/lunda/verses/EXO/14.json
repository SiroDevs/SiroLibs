          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Denodu ifuku Yehova wayamwinini aIsarela kudi aEjipitu; aIsarela ayimweni aEjipitu afwa dehi hachi kumu chakaluŋalwiji. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.30",
