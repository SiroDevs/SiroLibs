              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.27",
            "verseOrgIds": [
              "EXO.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi ŋombi wakalemeka hela iyala hela mumbanda, akafwa, ŋombi mwaka mujahi hohu chalala namalola, nimbiji yindi bayi akayidyaku; ilaŋa mukwaŋombi wakabula muloŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.28",
            "verseOrgIds": [
              "EXO.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa neyi ŋombi walemekelapa antu chachikulu, nimukwaŋombi amulejelumu dehi, ilaŋa yena kwindiha muŋatili mwitaŋaku, niŋombi hakujaha hela iyala hela mumbanda; niŋombi akamujahi namalola, nimukwa ŋombi akamujahi niyena. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.29",
            "verseOrgIds": [
              "EXO.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyiaka mutoŋwela kufuta, akahani chakudikuula nachu wumi windi mwejima mwaka muloŋa welawu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.30",
            "verseOrgIds": [
              "EXO.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela neyi nalemeki mwana weyala, helaneyi nalemeki mwana wamumbanda akamwili mwomwaya wuŋaji iwu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.31",
            "verseOrgIds": [
              "EXO.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi ŋombi wakalemeka nduŋu weyala hela nduŋu wamumbanda, akamwinki nkaka yawu jishekeli makumi asatu jasiliva, niŋombi akamujahi namalola.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.32",
            "verseOrgIds": [
              "EXO.21.32"
            ]
          }
        }
      ]
