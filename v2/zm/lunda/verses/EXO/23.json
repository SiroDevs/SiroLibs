            }
          ]
        },
        {
          "text": "Muloŋa kaŋelu kami wakatwaminina kumbidi kuwukuya, wakakushi ki nikudi aAmori, nikudi aHiti, nikudi aPerizi, nikudi aKenani, nikudi aHivi, nikudi aYebusi; ami nakayijilumuna. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.23",
            "verseOrgIds": [
              "EXO.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi wakafukamina akishi awuku, hela kuyipeshaku, hela kwila mwelaŋawuku; chiŋa wakayihinuna hamaseki chikupu, nakuchika tuposhi twawu puchi-puchi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.24",
            "verseOrgIds": [
              "EXO.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaka mukalakelaŋa Yehova Nzambi yenu, wakakiswila nkisu nikudyakweyi nimeji eyi; nakafumisha yikatu mukachi kenu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.25",
            "verseOrgIds": [
              "EXO.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwosi wakafwisha ivumu hela kwikala nshinta mwituŋa deyuku; nakawanisha mafuku eyi mwanayichindiluwu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.26",
            "verseOrgIds": [
              "EXO.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakatemeshaŋahu dehi woma wami kuwakaya, nakakisaŋana antu ejima kuwakaya, nakayila akwankunyi neyiejima akakutalisha nyima jawu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.27",
            "verseOrgIds": [
              "EXO.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakatemeshaŋahu dehi mayanvu kuwakaya, diwu akakutemwinamu kuwakaya niaHivi, ni aKenani, niaHiti. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.28",
            "verseOrgIds": [
              "EXO.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinakakutemwinawu kumesu eyi mumwaka wumu hohu bweŋuku; mukunkulwayi ituŋa dakekala neyi chihembi tuhu, nianyama amumpata akasemununa tuhu nakukuvulila. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.29",
            "verseOrgIds": [
              "EXO.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakakutemwinawu kumesu eyi chovu chovu, chiŋa wunavuli dehi, hiwakaswana niituŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.30",
            "verseOrgIds": [
              "EXO.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋinza yeyi nakakubalwilaya kutachikila kuKaluŋa lwŋi Kachinana yakashika nikukaluŋalwijika waFwilistinu, yakafuma nikwisaŋa, yakashika nikuKaloŋa; muloŋa ashakama mwituŋa denodu nakakwinkawu; wakayitemunumu kuwakaya. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.31",
            "verseOrgIds": [
              "EXO.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi wakatiyaŋana nawu chitiyaŋenu hela nawakishi awuku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.32",
            "verseOrgIds": [
              "EXO.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi akashakama mwituŋa deyuku, akenda kakunvulu mwisha; muloŋa neyi eyi wakapesha akishi awu, chakakubalu mukila muhetu wakufwamu eyi aweni.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.33",
            "verseOrgIds": [
              "EXO.23.33"
            ]
          }
        }
      ]
    }
