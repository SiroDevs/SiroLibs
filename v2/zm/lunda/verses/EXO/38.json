        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 38:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watuŋili kameŋa kahimulambu wakushita nanyitondu yanyishitimi; mukuleha kwaku munkotweli jachikasa jitanu, mukutoha kwaku munkotweli jachikasa jitanu, kwesekana hamu, ndwa, mumbaŋu jakujiwana; kuzandama kwaku kwesekeli munkotweli jachikasa jisatu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.1",
            "verseOrgIds": [
              "EXO.38.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 38:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Welilinseŋu jaku hamawombu aku awana, nseŋu jelili jakutuŋila hamu nakameŋa; walamikiluhu wuneŋu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.2",
            "verseOrgIds": [
              "EXO.38.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 38:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Welili yuma yakameŋa yejima, wowu manuŋu, ni mafwosholu, niyeŋa, nitutuwa twanyisomu, niyifoyu yakesi, nayuma yakuyejima wayilili nawuneŋu hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.3",
            "verseOrgIds": [
              "EXO.38.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 38:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kameŋa wakatuŋilili kanyungulu kawuneŋu kakutuŋa mesu mesu neyi wanda wakuta nachu, kakushilakwishina damutondu wasompokaku kwishina kwi-ndo, washi kili hakachi, kwishina kuleha, kwiwulu nawa kuleha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.4",
            "verseOrgIds": [
              "EXO.38.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 38:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wawumbili tuzeya tuwanatwakushila kumawombu akanyungulu kawuneŋu awana, hekali hawushiluwanyikambu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.5",
            "verseOrgIds": [
              "EXO.38.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 38:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasoŋeli nyikambu yanyitondu yanyishitimi, walami kiluhuwuneŋu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.6",
            "verseOrgIds": [
              "EXO.38.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 38:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyi kambu wayishili namutuzeya mumbavu jakameŋa, kulonda kukatembeka nachu; wakatuŋili namapalanga, kampaku.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.7",
            "verseOrgIds": [
              "EXO.38.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 38:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.7",
            "verseOrgIds": [
              "EXO.38.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watuŋili mbashila yakuwelela yawuneŋu, niitentaminu dayu dawuneŋu, nayibanjilu yawambanda akwakukalakala akalakeleli kuchisu chetenti dakubulakena.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.8",
            "verseOrgIds": [
              "EXO.38.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 38:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.20",
            "verseOrgIds": [
              "EXO.38.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 38:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyenu mwachindiluwu yuma yatabanaka, diyu tabanaka yawunsahu, chayichindiluwu chayilejeluwu kudi Mosi, yoyuma yakukalakala nachu aLevi, akukalakeshawu kudi Itamari, mwana kakapristu Aroni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.21",
            "verseOrgIds": [
              "EXO.38.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 38:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bezaleli, mwana kaUri, Uri mwana kaHuri, wakumuchidi waYuda, welili ytima yejima yamulejelu wuMosi kudi Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.22",
            "verseOrgIds": [
              "EXO.38.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 38:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oholiyabi mwana kaAhisamaki, wakumuchidi waDani, mukwakubaza yuma yakubaza, mukwakukoŋa nyidimu yawutotombu, mukwakuchima nakusowashana niwuzeeli, niwusombu, niwanda wuchinana nge, niwanda wawuwahi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.23",
            "verseOrgIds": [
              "EXO.38.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 38:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.23",
            "verseOrgIds": [
              "EXO.38.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 38:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuru wejima wakalakeluwu nachu nyidimu yamalala yejima, wawuru wakuhimulambu, washi kili muntalenta makumi ayedi najitanu najiwana, nijishekeli makulakaji atanu nayedi namakumi asatu, nakweseka mwomwesekelaŋa lushekeli lwakumalala.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.24",
            "verseOrgIds": [
              "EXO.38.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 38:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.24",
            "verseOrgIds": [
              "EXO.38.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 38:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nisiliva yawantu ana amuchipompelu achindiluwu yashi kili muntalenta nkulakaji, jishekeli ikombakaji dimu namakulakaji atanu nayedi namakumi atanu nayedi najitanu, nakweseka mwomwesekelaŋawu lushekeli lwakumalala; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.25",
            "verseOrgIds": [
              "EXO.38.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 38:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "kafwampi hibeka yimu hamuntu, lwolushekeli lwachibalu, lwakweseka mwomwesekela ŋawu lushekeli lwakumalala, yakufweta kudi antu ejima ahitili oku kwadiŋuwu achindiluwu, kufumisha kudi antu ashikamunyaka makumi ayedi nakubadika, yakufweta kudi amayala makulakaji atanu nadimu amakombakaji namakombakaji asatu namakulakaji atanu namakumi atanu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.26",
            "verseOrgIds": [
              "EXO.38.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 38:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkulakaji yantalenta yasiliva yadiŋi yakuwumba nachu mayanda akumalala, nimayanda ayishimi yakukudi kila ihina dakujika nachu; mayanda nkulakaji nantalenta nkulakaji, ntalenta yimu yeyandadi mu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.27",
            "verseOrgIds": [
              "EXO.38.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 38:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nekombakaji dimu namakulakaji atanu nayedi namakumi atanu nayedi najitanu welili nachu mbwambu jakuyishimi jakukudikila, walami kilininyitu yayishimi, welili nachu nimakozayu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.28",
            "verseOrgIds": [
              "EXO.38.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 38:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.28",
            "verseOrgIds": [
              "EXO.38.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 38:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuneŋu wakuhimulambu washi kili muntalenta makumi atanu nayedi, nijishekeli makombakaji ayedi namakulakaji awana. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.29",
            "verseOrgIds": [
              "EXO.38.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 38:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Welili nachunimayanda ayishimi yakuchisu chetenti dakubulakena, nikameŋa kawuneŋu, nikanyungulu kaku kawuneŋu, niyuma yakukameŋa yejima, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.30",
            "verseOrgIds": [
              "EXO.38.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 38:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimayanda akuchipaŋu kwi-ndo, nimayanda akuchisu chakuchipaŋu, nimpopu jakutabanaka jejima, nimpopu jakuchipaŋu jejima kwi-ndo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.31",
            "verseOrgIds": [
              "EXO.38.31"
            ]
          }
        }
      ]
    }
