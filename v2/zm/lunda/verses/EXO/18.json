  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "EXO 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu kapristu kakuMidiyani Yetero, diyi muku waMosi, watiyiliyejima yeliliyi Nzambi, yamwilililiyi Mosi, yayilililiyi ni antu indi aIsarela, chayifumishiliyi Yehova aIsarela muEjipitu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.1",
            "verseOrgIds": [
              "EXO.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Yetero, muku waMosi, wasendeli iŋodaMosi Zipora, atweliyi kumukala wawu, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.2",
            "verseOrgIds": [
              "EXO.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni anyanindi amayala ayedi; wumu wukweti ijina dindi Gereshomi, dayamukwila nindi, Nashakami ni mwenyi mwituŋa dambala; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.3",
            "verseOrgIds": [
              "EXO.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "mukwawuwukweti ijina dindi Eliyezeri, daya mukwila nindi, Nzambi yatata yami diyiwa nkwashili, diyi wampulwishili kumpoku yakabali yaFwaro; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.4",
            "verseOrgIds": [
              "EXO.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yetero, muku waMosi, wamutweleli Mosi ni anyanindi niŋodindi mwisaŋa mwatuŋililiyi chilombu chindi kumpidi yaNzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.5",
            "verseOrgIds": [
              "EXO.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamwilili Mosi, nindi, Amimuku weyi Yetero nenzi dehi kudeyi, niŋodeyi, ni anyanindi muyayediwawu hamu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.6",
            "verseOrgIds": [
              "EXO.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi wayili nakumukinkilila muku windi, wamufukaminini, wamupwepujoleli; adihujoleli mwashaka minuwu; eŋila nikwijila mwitenti.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.7",
            "verseOrgIds": [
              "EXO.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.7",
            "verseOrgIds": [
              "EXO.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi wamulejeli muku windi yuma yejima yeliliyi Yehova, yamwililiyi Fwaro niyayililiyi aEjipitu hanyijimba yawaIsarela, wamulejeli ni kukabakana kwejima kwamwe nuwu munjila, nichayi pulwishiliyi Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.8",
            "verseOrgIds": [
              "EXO.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yetero watiyili kuwaha chatiyiliyi kuwaha kwejima kwayi koŋeleliyi Yehova aIsarela, nichayi pulwishiliyi kudi aEjipitu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.9",
            "verseOrgIds": [
              "EXO.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yetero welili nindi, Kisu kisu Yehova wayipulwishili enu nikudi aEjipitu nikudi Fwaro; wayipulwishili niantu afumi kudi aEjipitu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.10",
            "verseOrgIds": [
              "EXO.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi dinu neluki dehi kwami, nami Yehova diyiwabadika akishi ejima; mwalala hela kuchuma chadinkeluwu nachu wantanawena, yena wayibadikili. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.11",
            "verseOrgIds": [
              "EXO.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yetero muku waMosi, wamukwatilili Nzambi nihimulambu wakushita niyimuna yakumuketwila; niAroni wenjili, niakulumpi awaIsarela ejima, nakudya yakudya namuku waMosi kumesu aNzambi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.12",
            "verseOrgIds": [
              "EXO.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.12",
            "verseOrgIds": [
              "EXO.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chelili hakuchaha Mosi washakamini nakusompesha antu; antu chochema nawu kwadiŋiyi Mosi kufumisha kubudidi ndo nikumelela. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.13",
            "verseOrgIds": [
              "EXO.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chamwe niyi muku waMosi yuma yejima yadiŋi nakuyililayi antu, hakuhosha nindi, Awa antu wudi nakuyila ŋahi? Indi eyi washaka minadi kanka weyi hohu, awa antu saŋa emajalilawu kudeyi kufumisha kubudidindo nikumelela? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.14",
            "verseOrgIds": [
              "EXO.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi wamwilili muku windi nindi, Muloŋa antu hiyakwi nzenzakudami ehuli mwakuyilejayi Nzambi; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.15",
            "verseOrgIds": [
              "EXO.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "neyi akweti nsaŋu yawuhiyakwinza kudami; ami hinukusompa muloŋa wamuntu namukwawu, hinukuyilukisha mwaya yidika yaNzambi, ninshimbi jindi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.16",
            "verseOrgIds": [
              "EXO.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muku waMosi wamwilili nindi, Ichichuma chiwela hichachi wahuku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.17",
            "verseOrgIds": [
              "EXO.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chalala mwamba kazeyela hamu nineyi niantu awa wekala nawu; chumichi china pandakani muŊovu jeyi; mudimu iwu hiwunatweshi kuwukoŋa kankaweyuku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.18",
            "verseOrgIds": [
              "EXO.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyaku munukuhosha, nikuleji maana, Nzambi wikali nindi; eyi wikali wambala wawantu wakuyiho shelaŋa kudi Nzambi, wushi kŋi ŋansaŋu jawu kudi Nzambi; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.19",
            "verseOrgIds": [
              "EXO.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "wuyilejaŋa nimuyidika yindi nimunshi mbijindi, nakuyilukisha nimunjila mwakwe ndelawu, nimudimu wakukoŋawu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.20",
            "verseOrgIds": [
              "EXO.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi wambuli mukachi kawantu amayala ashinshika amwakama Nzambi, amayala alala akadi makasu, ahelaŋa kudya yawukombi; wuyikunjiki kwikala anyuli, awa ayuli makombakaji awantu, awa ayuli makulakaji awantu, awa ayuli makumi atanu awantu, awa ayuli makumi awantu; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.21",
            "verseOrgIds": [
              "EXO.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "wena akasompeshi antu mafuku ejima; nsaŋu jejima jamaneni akajileti kudeyi, ilaŋa nsaŋu jejima janyanya akajisompi awenawu; chochina hichaka kukalila chalalaku, niwena akakukwashaku kusenda chiteli. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.22",
            "verseOrgIds": [
              "EXO.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi wakelaŋa chumichi, niNzambi wakakuleja kwila mwenomu, eyi wakabula kukaŋanya, niantu awa ejima akaya chachiwahi kwawu kwakuyawu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.23",
            "verseOrgIds": [
              "EXO.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.23",
            "verseOrgIds": [
              "EXO.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Mosi watiyili mwizu damuku windi, welili mwejima mwahosheliyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.24",
            "verseOrgIds": [
              "EXO.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mudi aIsarela ejima Mosi watondelumu amayala ashinshika, wayikunjikili ekali awakulumpi jawantu, awa ayuli makombakaji awantu, awa ayuli makulakaji awantu, awa ayuli makumi atanu awantu, awa ayuli makumi awantu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.25",
            "verseOrgIds": [
              "EXO.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asompeshelaŋa antu mafuku ejima; nsaŋu jakala akishi kŋilikudi Mosi, nsaŋu janyanya jejima ajisompeli awenawu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.26",
            "verseOrgIds": [
              "EXO.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi wetŋili muku windi kuya; niyena wadiyilili cheŋi mwituŋa dindi mwafumi niyi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.27",
            "verseOrgIds": [
              "EXO.18.27"
            ]
          }
        }
      ]
    }
  ],
