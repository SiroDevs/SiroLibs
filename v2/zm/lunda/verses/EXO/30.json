      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakatuŋi kameŋa kakwochelahu insensi; wakakatuŋi nanyito nduvu Uyanyishitimi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.1",
            "verseOrgIds": [
              "EXO.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukuleha kwaku mwakashiki munkotweli yachikasayimu, mukutoha kwaku munkotweli yachikasa yimu; kakeli kambaŋu jiwana jesekana; muwuzandamu waku mwakeli munkotweli jachikasajiyedi; nseŋu jaku jakeli hakutuŋila hamu nakameŋa, chuma chochimu hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.2",
            "verseOrgIds": [
              "EXO.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakalamikuhu wuru wakoseka, nihewulu daku, nihambavu jaku kwi-ndo, nihanseŋu jaku; wakatuŋiluhu mukinkita wawuru kwi-ndo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.3",
            "verseOrgIds": [
              "EXO.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakaka tuŋilituzeya twawuru tuyedi twakwishina damukinkita waku; wakatutuŋi twakumbavu jaku jiyedi, twakumbaŋu jaku jiyedi; twakeli twakushila nyikambu yakusendela.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.4",
            "verseOrgIds": [
              "EXO.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
