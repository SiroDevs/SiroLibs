        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.10",
            "verseOrgIds": [
              "EXO.30.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
