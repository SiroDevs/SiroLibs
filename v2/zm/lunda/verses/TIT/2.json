      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "TIT 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwila eyi lejaku nsaŋu jata mukuleja kwakoleshaŋaa. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.1",
            "verseOrgIds": [
              "TIT.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "TIT 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akulumpi amayala chiŋa ekali ababala, akweti kalemesha, awundisha mumesu, akola mukwitiya, nimukukeŋa, nimukutatakena. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.2",
            "verseOrgIds": [
              "TIT.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "TIT 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akulumpi awambanda niwena chiŋa endi mwendelaŋawu akwakujila; bayi ekala akwakutuŋula akwawuku; bayi asweja kunwa walwaku; ekali akwakuleja akwawu yuma yayiwahi, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.3",
            "verseOrgIds": [
              "TIT.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "TIT 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "afumbi ansanda kukeŋa anfumu jawu nikukeŋa anyanawu; ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.4",
            "verseOrgIds": [
              "TIT.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "TIT 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ekali awundisha mumesu, akadi kubajama, akwakukalakala kumatalawu, akwaluwi, akwakwovwahila anfumu jawu aweni, kulonda mazu aNzambi abuli kutukewa. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.5",
            "verseOrgIds": [
              "TIT.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "TIT 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konkomwena anyikwenzi niwena ekali awundisha mumesu. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.6",
            "verseOrgIds": [
              "TIT.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "TIT 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dimwekeshi wikali wakutalilahu munyidimu yayiwahi yejima; kuleja kweyi kwikali kwakadi kubomba nayatama, kwakalemesha. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.7",
            "verseOrgIds": [
              "TIT.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "TIT 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hoshaku mazu alala akaŋanya kutanyishewa, kulonda kutiyisha nsonyi muntu wukukeŋa kuleta ntadi, abuli kumona chuma chakututena chatama. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.8",
            "verseOrgIds": [
              "TIT.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "TIT 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yileji aŋamba ashakami nakwovwahila anyanta jawu, nakuyitiyisha kuwaha muyuma yejima, chakadi ntadi. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.9",
            "verseOrgIds": [
              "TIT.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "TIT 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi eya wukombi wawunyemunyemuku, ilaŋa amwekeshi kashinshi kakawahi, kulonda awahishi kuleja kwaNzambi, Chamwinu chetu, muyuma yejima.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.10",
            "verseOrgIds": [
              "TIT.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "TIT 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.10",
            "verseOrgIds": [
              "TIT.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "TIT 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa luwi lwaNzambi lwaletaŋa wamwinu wawantu ejima, lunamwekani dehi. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.11",
            "verseOrgIds": [
              "TIT.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "TIT 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwatufumbaŋa nawu tuleki kusekesha Nzambi, nikufwila yatama yampata yamunu mwishina, tushakami nyaka yinu nakuwundisha mumesu, nikuloŋa, nikwakama Nzambi; ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.12",
            "verseOrgIds": [
              "TIT.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "TIT 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nakutalila kuchiŋeja kwatiyishaŋa kuwaha, nichakamwekana lubanji lwakulema kwaNzambi yetu muneni, Chamwinu chetu Yesu Kristu; ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.13",
            "verseOrgIds": [
              "TIT.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "TIT 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "yowu wadiheni hadetu kulonda atukuuli kukuluwa kwejima, aditookesheli antu akudihetela, akuta nyichima hanyidimu yayiwahi.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.14",
            "verseOrgIds": [
              "TIT.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "TIT 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.14",
            "verseOrgIds": [
              "TIT.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "TIT 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lejaku yumiyi nakukonkomwena nakukonkolola naŋovu yejima. Bayi witeja muntu kukudiwulaku.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.15",
            "verseOrgIds": [
              "TIT.2.15"
            ]
          }
        }
      ]
    }
