          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.17",
            "verseOrgIds": [
              "NAM.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NAM 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi mwanta wakuAshuri, atubiŋa tweyi adi nakukama tulu. Ayilobu jeyi anashakami dehi. Antu eyi anaŋalaŋani hamapidi; hikudi wakuyipompeshaku. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.18",
            "verseOrgIds": [
              "NAM.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NAM 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hikudi kuwundisha yikatu yeyuku; chitu cheyi chinasweji. Antu ejima akatiya nsaŋu yeyi aketa mumakasa hansaŋu yeyi; ochu hanashalinyi hanabuli kuhita kutama kweyi kwakakumaŋa?",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.19",
            "verseOrgIds": [
              "NAM.3.19"
            ]
          }
        }
      ]
    }
