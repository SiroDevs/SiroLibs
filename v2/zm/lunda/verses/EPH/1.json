      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EPH 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami Pawulu, kapostolu kaKristu Yesu mwaya muchima waNzambi, nidi nakuyisonekela mukanda, enu akwakujila mwekala kuEfwesesa, akwakushinshika amudi Kristu Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.1",
            "verseOrgIds": [
              "EPH.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EPH 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luwi lwikali nanenu nikuwunda kwakufuma kudi Nzambi, yowu Tata yetu, nikudi Mwanta Yesu Kristu.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.2",
            "verseOrgIds": [
              "EPH.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EPH 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.2",
            "verseOrgIds": [
              "EPH.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EPH 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amukiswili Nzambi yaMwanta wetu Yesu Kristu, yowu Tata yindi, natukiswili nkisu jawuspiritu jejima mumawulu mudi Kristu; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.3",
            "verseOrgIds": [
              "EPH.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EPH 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "chatutondeliyi mudi yena henohu chikuku champata yamunu mwishina chichidi kanda, kulonda tujili, tubuli hakutwinkela muloŋa kumesu indi, mukukeŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.4",
            "verseOrgIds": [
              "EPH.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EPH 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watukunjikilaŋahu dehi nindi twi kali anyana kambala mudi Yesu Kristu, mwatiyililiyi kuwaha kumuchima windi, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.5",
            "verseOrgIds": [
              "EPH.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EPH 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulonda kuhameka kulema kwaluwi lwindi lwatutiyililiyi chamukunkulu mudi yena Wakeŋewa. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.6",
            "verseOrgIds": [
              "EPH.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EPH 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mudi yena dimu tukweti kukuula kwanatukúuluwu namashi indi, yowu kutwanakena nyiloŋa yetu, mweseka maheta aluwi lwindi ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.7",
            "verseOrgIds": [
              "EPH.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EPH 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "lwatuvulishililiyi, nama ana ejima nikashinshi. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.8",
            "verseOrgIds": [
              "EPH.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EPH 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakutuleja nsaŋu yajindiliyi mumuchima windi, mwatiyihliyi kuwaha, mwafuukwiliyi mudi Kristu, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.9",
            "verseOrgIds": [
              "EPH.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EPH 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nichamba kawanina nyaka; kulonda yuma yamumawulu niyahamaseki yejima yakahwili mudi Kristu.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.10",
            "verseOrgIds": [
              "EPH.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EPH 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.10",
            "verseOrgIds": [
              "EPH.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EPH 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mudi yena nawa dimu mwatubalumwininuwu twi kali wuswana, Muloŋa twambwilaŋahu dehi mwatoŋweliyi yena wakoŋaŋa yuma yejima mwadilejaŋayi kumuchima windi; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.11",
            "verseOrgIds": [
              "EPH.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EPH 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulonda etu, twásambilili kukuhwelela Kristu, tuleteshi kuhameka kwakuhameka kulema kwindi. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.12",
            "verseOrgIds": [
              "EPH.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EPH 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mudi yena ninenu nawa, mwatiyili mazu ansaŋu yalala, yoyu nsaŋu yawamwinu wenu yayiwahi, himwamwitiyili yena, ayifundili nawa naSpiritu Wajila wakukana. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.13",
            "verseOrgIds": [
              "EPH.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EPH 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena Spiritu diyi chikilu chawuswana wetu, nichamba kakúulawu iheta dambala dayena, kulonda kuhameka kulema kwindi.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.14",
            "verseOrgIds": [
              "EPH.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EPH 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.14",
            "verseOrgIds": [
              "EPH.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EPH 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi ami nawa, chinatiyili nsaŋu yenu yakumukuhwelela Mwanta Yesu, nichimwakeŋa aŋa akwakujila ejima, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.15",
            "verseOrgIds": [
              "EPH.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EPH 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "hinalekaŋa kuyisakilila chinayitenaŋa mukulomba kwamuku. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.16",
            "verseOrgIds": [
              "EPH.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EPH 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nalombaŋa nami, Nzambi yaMwanta wetu Yesu Kristu, Tata wakulema, ayinki spiritu yama ana nichimwekeshu, kulonda musweji kumwiluka; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.17",
            "verseOrgIds": [
              "EPH.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EPH 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "mesu amunyichima yenu atoni, kulonda mwiluki kuchiŋeja kwakutambika kwayitambikiliyi, nimaheta akulema kwawuswana windi wahetayi mudi akwakujila; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.18",
            "verseOrgIds": [
              "EPH.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EPH 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nichabadika kututohela Ŋovu jindi nankashi, etu twakuhwelelaŋa, mweseka Ŋovu jindi jasweja kutoha nankashi, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.19",
            "verseOrgIds": [
              "EPH.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EPH 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "jakoŋeliyi mudi Kristu hamusaŋwiliyi mudi afu, hakumushakamisha kuchikasa chindi chachidiilu mumawulu, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.20",
            "verseOrgIds": [
              "EPH.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EPH 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwabadika nankashi kuyula kwejima, niwanta, niŋovu, nimawanta antúumba, nimajina ejima atenaŋawu, hiwowu amakonu hohuku, nianyaka yakenza nawa. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.21",
            "verseOrgIds": [
              "EPH.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EPH 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamwoywahishila dehi yuma yejima nakuyisha kwishina danyendu yindi; wamukunjika dehi kwikala namutu wahewulu dayuma yejima kuchipompelu; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.22",
            "verseOrgIds": [
              "EPH.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EPH 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "chipompelu diwu mujimba windi, kwinzala kwayena wenzeshaŋa yuma yejima mwejima.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.23",
            "verseOrgIds": [
              "EPH.1.23"
            ]
          }
        }
      ]
    }
