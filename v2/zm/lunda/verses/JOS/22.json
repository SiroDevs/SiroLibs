        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.29",
            "verseOrgIds": [
              "JOS.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapristu Fwinehasi niatulamba amuchipompelu, wowu awakulumpi amakombakaji awaIsarela, adiŋiyi nawu, chatiyiluwu mazu ahosheluwu anyana kaRubeni, nianyana kaGadi, nianyana kaManase, atiyili kuwaha nankashi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.30",
            "verseOrgIds": [
              "JOS.22.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fwinehasi mwana kakapristu Eleyazari, wayilili anyana kaRubeni, nianyana kaGadi, nianyana kaManase, nindi, Lelu tuneluki netu komana Yehova wekala mukachi ketu nanochu chimunabuli kuputa muloŋa iwu kumesu aYehova; munayamwini anyana kaIsarela kuchikasa chaYehova.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.31",
            "verseOrgIds": [
              "JOS.22.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
