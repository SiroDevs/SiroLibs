        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.31",
            "verseOrgIds": [
              "JOS.22.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 22:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fwinehasi mwana kakapristu Eleyazari, niatulamba afuntili kwayiluwu kudi anyana kaRubeni nikudi anyana kaGadi, mwomwituŋa daGileyadi, ayili cheŋi kwituŋa daKenani kudi anyana kaIsarela, ayifuntishilili izu dayilejeluwu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.32",
            "verseOrgIds": [
              "JOS.22.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 22:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaIsarela atiyilumu kuwaha, anyana kaIsarela amukiswilili Nzambi nkisu, hiyahosheli cheŋi nawu tuyenu twakadasi nawu njita kulonda twakakisaŋani ituŋa dashakamawu anyana kaRubeni nianyana kaGaduku. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.33",
            "verseOrgIds": [
              "JOS.22.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOS 22:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaRubeni nianyana kaGadi atumbili kameŋa oku nawu Chinsahu, muloŋa nawu, kaneli mukachi ketu hichinsahu chakwila nawu Yehova diyi Nzambi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.34",
            "verseOrgIds": [
              "JOS.22.34"
            ]
          }
        }
