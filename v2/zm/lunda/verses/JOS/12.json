      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyenu anyanta etuŋa atapiluwu anyana kaIsarela, hiyakutambulani ituŋa dawu kwishinadi daYodana mbadi yatuntukilaŋa itagwa, kufumisha kuchinekineki chaArinoni kutwala nikumpidi yaHerimoni, niyana yejima yambadi yamusela; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.1",
            "verseOrgIds": [
              "JOS.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sihoni mwanta wawaAmori washakamini muHeshiboni, wadiŋi mwanta wawu kufumisha kuArowenai, hansa yachinekineki chaArinoni, nihakachi kachinekineki, nichibalu chimu chaGileyadi nakutwala kukaloŋa Yaboki, dimu muŋinza yawanyana kaAmoni; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.2",
            "verseOrgIds": [
              "JOS.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nichana chakwata nikukaluŋalwiji kaKineroti, mbadi yamusela, nakutwala nikwijiya dakuchana, dodu Ijiya Damugwa, mbadi yamusela, njila yakuya kuBetiyeshimoti; nikumbadi yakabeta kakuchidiilu kwakunkumukila nyikandu yaPisiga; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.3",
            "verseOrgIds": [
              "JOS.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimuŋinza yaOŋi mwanta wakuBashani yowu washeluhu hadiŋi aRefwa, washakamini nikuAshataroti nikuEdereyi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.4",
            "verseOrgIds": [
              "JOS.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "wadiŋi mwanta wawu nimuHerimoni, nimuSaleka nimuBashani yejima ndo nikuŋinza yawaGeshuri, niyawaMayakati, nichibalu chimu chaGileyadi, dimu muŋinza yaSihoni mwanta wakuHeshiboni. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.5",
            "verseOrgIds": [
              "JOS.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kambuŋa Yehova Mosi nianyana kaIsarela ayitapili. Kambuŋa Yehova Mosi wayinkeli dawu dakuheta, dambala dawaRubeni, nidawaGadi, nidamuchidi waManase wachibalu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.6",
            "verseOrgIds": [
              "JOS.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
