        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyenu anyanta etuŋa atapiluwu aYoshuwa nawanyana kaIsarela ishinadi daYodana damujika, kufumisha kuBayali Gadi muchinekineki chaLebanoni nakutwala kumpidi yaHalaka yaya kuSeyiri. Yoshuwa wayinkelidu nyichidi muza wawantu aswejeli kutaluka, yawaIsarela dawu dakuheta mwomwadambwililuwu; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.7",
            "verseOrgIds": [
              "JOS.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimwituŋa damapidi, nidakunkumuka, nidayana, nidanyikandu, nidesaŋa, nimwituŋa dakukabeta kakuchidiilu, nikaHiti, nikaAmori, nikaKenani, nikaPerizi, nikaHivi, nikaYebusi; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.8",
            "verseOrgIds": [
              "JOS.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "wumu, mwanta wakuYeriku, wumu, mwanta wakuAyi, wekala kumbadi yaBeteli; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.9",
            "verseOrgIds": [
              "JOS.12.9"
            ]
          }
        },
