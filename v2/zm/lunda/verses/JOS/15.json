    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwasakwililuwu muchidi wawanyana kaYuda nachinjikijilu mwahita yisaka yawu mwashikili kuŋinza yaEdomi nikwisaŋa daZini kukabeta kakuchidiilu, kukabeta kakuchidiilu kwakweni kunsa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.1",
            "verseOrgIds": [
              "JOS.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋinza yawu yakabeta kakuchidiilu yafumini kwakumina Ijiya Damugwa kwokumwendu wadu watala kukabeta kakuchidiilu; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.2",
            "verseOrgIds": [
              "JOS.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "wayili mbadi yakabeta kakuchidiilu hamukandu waAkarabimi, yahitili nikuZini, yakandukili kumbadi yaKadeshi Baraneya yakabeta kakuchidiilu, yahitili nikuHezeroni, yakandukili kuAdara, yanyegumukili nakuya kuKaraka; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.3",
            "verseOrgIds": [
              "JOS.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "yahitili nikuAzamoni yiidika nikukaloŋa kaEjipitu; ŋinza yina yakuminini kukaluŋalwiji; yeniyi diyi yikwikala ŋinza yenu yakukabeta kakuchidiilu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.4",
            "verseOrgIds": [
              "JOS.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋinza yakumusela yowu Ijiya Damugwa nikwakumina Yodana. Ŋinza yamutamba wakukabeta kakuchimunswa yafumini kumwendu wejiya kwakumina Yodana. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.5",
            "verseOrgIds": [
              "JOS.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋinza yina yakandukili kuBetihoŋala, yahitili kumbadi yaBetaraba yakabeta kakuchimunswa; ŋinza hiyikukandukila nikwilola daBohana mwana kaRubeni. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.6",
            "verseOrgIds": [
              "JOS.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋinza yakandukili kuDebiri nakufuma muchinekineki chaAkori, hiyikuya nikukabeta kakuchimunswa nakutalisha kuGiligali, watala mesu kumukandu waAdumimi, wekala ishinadi dakaloŋa dakabeta kakuchidiilu; ŋinza yahitili nikumeji akuEnshemeshi, yakuminini kuEnirogeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.7",
            "verseOrgIds": [
              "JOS.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋinza yakandukilili kuchinekineki chamwana kaHinomi nakuya kumbadi yawaYebusi yakukabeta kakuchidiilu, diku kuYerusalema; ŋinza yakandukili nikunamutu wampidi yemana kuchinekineki chaHinomi kumujika, chekala kwakumina muhoŋi wawaRefwa mbadi yakukabeta kakuchimunswa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.8",
            "verseOrgIds": [
              "JOS.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋinza ayipimini kufumisha kunamutu wampidi nakutwala kukaseloki kameji akuNefwetowa, yayili nikunyikala yamumpidi yaEfwenaoni; ŋinza ayipimini nikuBayalahi, diyi Kiriyati Yeyarimi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.9",
            "verseOrgIds": [
              "JOS.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋinza yanyegumukili Bayalahi nakuya kumujika kumpidi yaSeyiri, yihita nikumbavu yampidi yaYeyarimi yakabeta kakuchimunswa, diyi Chesaloni, hiyikukunkumuka nikuBetishemeshi, nakuhita kuTimina. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.10",
            "verseOrgIds": [
              "JOS.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋinza yedikili nikumbadi yaEkeroni yakabeta kakuchimunswa; ŋinza ayipimini nikuShikeroni, hiyikuhita nikuhita nikumpidi yaBayala, hiyikwidika nikuYabaneyeli; ŋinza kuyakuminini kwokukaluŋalwiji. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.11",
            "verseOrgIds": [
              "JOS.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋinza yakumujika yashikili kwokukaluŋalwiji keneni, nikumukulishu waku. Dimu muŋinza yawanyana kaYuda kwi-ndo mwahita yisaka yawu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.12",
            "verseOrgIds": [
              "JOS.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamwinkeli mwana kaYefune Kalebi iseka damukachi kawanyana kaYuda; mwomwaya lushimbi lwaYehova lwalejeliyi Yoshuwa, wowu mukala waAraba, yenowu diyi tata yaAnaki; diku kuHeberoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.13",
            "verseOrgIds": [
              "JOS.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalebi watemwinumu anyana kaAnaki asatu amayala, iwu Sheshayi, iwu Ahimani, iwu Talamayi, wowu anyana kaAnaki. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.14",
            "verseOrgIds": [
              "JOS.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanyamukili kwenoku nakuya nakudasa naweniDebiri; ijina daDebiri hakusambila dadiŋi Kiriyati Sefwenai. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.15",
            "verseOrgIds": [
              "JOS.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalebi welili nindi, Yowu wukutapa Kiriyati Sefwenai nakuwulukuka nakamwinka mwanami Akisa asumbuli. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.16",
            "verseOrgIds": [
              "JOS.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otiniyeli, mwana kaKenazi mana kwaKalebi, owulukuka nikuwulukuka; wamwinkeli mwanindi Akisa, nindi sumbulaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.17",
            "verseOrgIds": [
              "JOS.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cheliliyi nenzi dehi kudi yena, hakumukanjikija iyala amulombi tata yindi iha. Wasulukili hachimbulu chindi; Kalebi wamwilili nindi, Wunakeŋidi? ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.18",
            "verseOrgIds": [
              "JOS.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena mumbanda nindi, Nkiswili nkisu; wunanyinki ituŋa dakabeta kakuchidiilu, nyinki nituseloki. Kalebi wamwinkeli tuseloki nitwakundundamu nitwakunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.19",
            "verseOrgIds": [
              "JOS.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.19",
            "verseOrgIds": [
              "JOS.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weniwu diwu wuswana wamuchidi wawanyana kaYuda mwahita yisaka yawu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.20",
            "verseOrgIds": [
              "JOS.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyikala yamaneni yadiŋi kwakumina muchidi wawanyana kaYuda, mbadi yaŋinza yaEdomi, kukabeta kakuchidiilu yadiŋi niKabezeyeli, niEderi, niYaguri; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.21",
            "verseOrgIds": [
              "JOS.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "niKina, niDimonaha, niAdada; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.22",
            "verseOrgIds": [
              "JOS.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "niKedeshi, niHazori, niltinani; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.23",
            "verseOrgIds": [
              "JOS.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "niZifwi, niTelemi, niBeyaloti; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.24",
            "verseOrgIds": [
              "JOS.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "niHazorihadata, niKeriyoti Hezeroni, diwu Hazori; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.25",
            "verseOrgIds": [
              "JOS.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "niAmama, niShema, niMolada; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.26",
            "verseOrgIds": [
              "JOS.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "niHazaraŋada, niHeshimoni, niBetipeleti; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.27",
            "verseOrgIds": [
              "JOS.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "niHazarashuwali, niBerisheba, niBiziyotiya; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.28",
            "verseOrgIds": [
              "JOS.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "niBayalahi, nilyimi, niEzemi; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.29",
            "verseOrgIds": [
              "JOS.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "niEletoladi, niChesili, niHorama; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.30",
            "verseOrgIds": [
              "JOS.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "niZikilaŋi, niMadamana, niSanesana; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.31",
            "verseOrgIds": [
              "JOS.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "niLebayoti, niShilihimi, niAyina, niRimoni; nyikala yamaneni yejima makumi ayedi ninyikala yitanu nayiwana, ninyikala yayu yanyanya.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.32",
            "verseOrgIds": [
              "JOS.15.32"
            ]
          }
        }
      ]
    },
