          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amayala akuMikimasi, nkulakaji namakumi ayedi nawantu ayedi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.27",
            "verseOrgIds": [
