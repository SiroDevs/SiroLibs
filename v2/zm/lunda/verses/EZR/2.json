              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyenu anyana amuwuloŋu afumini muwuduŋu, wowu atweluwu kuBabiloni kudi mwanta wakuBabiloni Nebukaneza, afuntili kuYerusalema nakuYuda, iwu kumukala windi, iwu kumukala windi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.1",
            "verseOrgIds": [
              "EZR.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enjili naZerubabeli; Yeshuwa, Nehemiya, Seraya, Reyelaya, Modekayi, Bilishani, Misipari, Biŋivayi, Rehumi, Bayana. Kuchinda amayala akudi antu aIsarela; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.2",
            "verseOrgIds": [
              "EZR.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "anyana kaParoshi makombakaji ayedi nankulakaji namakumi atanu nayedi nawantu ayedi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.3",
            "verseOrgIds": [
              "EZR.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaShefwatiya, makulakaji asatu namakumi atanu nayedi nawantu ayedi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.4",
            "verseOrgIds": [
              "EZR.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaAra, makulakaji atanu nayedi namakumi atanu nayedi nawantu atanu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.5",
            "verseOrgIds": [
              "EZR.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaPahati Mowabi, akudi anyana kaYeshuwa naYowabi, makombakaji ayedi namakulakaji atanu nasatu nawantu ikumi nayedi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.6",
            "verseOrgIds": [
              "EZR.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaElami, ikombakaji namakulakaji ayedi namakumi atanu nawantu awana. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.7",
            "verseOrgIds": [
              "EZR.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaZatu, makulakaji atanu nawana namakumi awana nawantu atanu ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.8",
            "verseOrgIds": [
              "EZR.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaZakayi, makulakaji atanu nayedi namakumi atanu nadimu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.9",
            "verseOrgIds": [
              "EZR.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaBani, makulakaji atanu nadimu namakumi awana nawantu ayedi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.10",
            "verseOrgIds": [
              "EZR.2.10"
            ]
