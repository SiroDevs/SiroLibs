              "text": "64",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chipompelu chejima kuchibombela hamu, chashikili mumakombakaji awantu makumi awana namakombakaji ayedi namakulakaji asatu namakumi atanu nadimu; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.64",
            "verseOrgIds": [
              "EZR.2.64"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "65",
            "style": "v",
            "sid": "EZR 2:65"
          },
          "items": [
            {
              "text": "65",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubombelaku aŋamba jawu amayala nawambanda, ashikili mumakombakaji atanu nayedi namakulakaji asatu namakumi asatu nawantu atanu nayedi; adiŋi nawakwakwimba tumina amayala nawambanda makulakaji ayedi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.65",
            "verseOrgIds": [
              "EZR.2.65"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "66",
            "style": "v",
            "sid": "EZR 2:66"
          },
          "items": [
            {
              "text": "66",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuwalu twawu, makulakaji atanu nayedi namakumi asatu natanu nawumu; yingonŋavalu yawu, makulakaji ayedi namakumi awana nayitanu; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.66",
            "verseOrgIds": [
              "EZR.2.66"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "67",
            "style": "v",
