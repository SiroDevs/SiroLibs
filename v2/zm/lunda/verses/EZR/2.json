          },
          "items": [
            {
              "text": "60",
              "type": "text"
            }
          ]
        },
        {
          "text": "anyana kaDelaya, anyana kaTobiya, anyana kaNekoda, makulakaji atanu nadimu namakumi atanu nawantu ayedi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.60",
            "verseOrgIds": [
