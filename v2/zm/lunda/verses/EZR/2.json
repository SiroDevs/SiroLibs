          },
          "items": [
            {
              "text": "67",
              "type": "text"
            }
          ]
        },
        {
          "text": "anŋameli jawu, makulakaji awana namakumi asatu natanu; yimbulu, makombakaji atanu nadimu namakulakaji atanu nayedi namakumi ayedi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.67",
            "verseOrgIds": [
