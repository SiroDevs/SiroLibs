            }
          ]
        },
        {
          "text": "neyi nadyimu yakudya yakadi kufweta, hela neyi nakojeji akwanyihaŋa yawu kufwa; ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.39",
