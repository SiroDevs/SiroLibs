            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi ituŋa dami dikuntwila mukunyi, hela neyi nyihaŋa yikudilila madilu kumu; ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.38",
