  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "JOB 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chalala mungochi wakupunda siliva wekala kwoku, kwekala nikwakutookeshela wuru. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.1",
            "verseOrgIds": [
              "JOB.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chikuŋu achifumishaŋa mumaseki, wuneŋu aweŋululaŋa kumalola. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.2",
            "verseOrgIds": [
              "JOB.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu wakumishaŋa mwidima, wakeŋa akeŋaŋa malola amumwidima washishita, nimuwulelu wakufwa kwakweni kunsa kwakumina ŋinza. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.3",
            "verseOrgIds": [
              "JOB.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walokolaŋa mungochi kwakulehi nakwashakama antu; antu ahitiluku avulamenaku dehi; ayikudeka kwakulehi nawantu, yayekelaŋa niniku niniku. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.4",
            "verseOrgIds": [
              "JOB.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwila iseki dafumaŋa yakudya, anadikuvumiki mwishina dadu neyi nakesi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.5",
            "verseOrgIds": [
              "JOB.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumalola adu kwokwekala tusafira, dikweti niwuŋa wawuru.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.6",
            "verseOrgIds": [
              "JOB.28.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.6",
            "verseOrgIds": [
              "JOB.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njila yenoyu kwosi kajila wakwataŋa akwawu wayilukaku, hela chikoji kukewukilaku disu nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.7",
            "verseOrgIds": [
              "JOB.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyama ananukaŋa kuyidata nehi, hela mutupa wazuwa kuhitaku nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.8",
            "verseOrgIds": [
              "JOB.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu wololaŋa chikasa chindi nakukwata helola dabalulaŋaawu mukalula; wakuvumikaŋa mapidi ninyiji yayu kumu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.9",
            "verseOrgIds": [
              "JOB.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabalulaŋa tupila mumalola; disu dindi damonaŋa yuma yayiwahi yejima. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.10",
            "verseOrgIds": [
              "JOB.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakasaŋa tuloŋa kulonda tubuli kuvwa, chuma chadiŋi chakujinda hakuchiidisha kumwaana.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.11",
            "verseOrgIds": [
              "JOB.28.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.11",
            "verseOrgIds": [
              "JOB.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa maana akuyiwana kudihi? Nikwekala kashinshi kudihi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.12",
            "verseOrgIds": [
              "JOB.28.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.12",
            "verseOrgIds": [
              "JOB.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu hiyeluka muwuseya wawuku, hiyayiwanaŋa mwituŋa dawantu amomuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.13",
            "verseOrgIds": [
              "JOB.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyiŋi nindi, Hiyekala mudamuku, kaluŋalwiji nindi, Hiyekala mudamuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.14",
            "verseOrgIds": [
              "JOB.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyayilandaŋa nawuruku, hiyapezeleshaŋa siliva yamuwuseya wawuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.15",
            "verseOrgIds": [
              "JOB.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuru wakuOfwiri hiweseka nawuku, hela tuhu kashohama kalema, hela kasafira. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.16",
            "verseOrgIds": [
              "JOB.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuru nayibanjilu hiyashikila mwokuku; maana hiyayihimpaŋa hela nayuma yawuru wakosekaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.17",
            "verseOrgIds": [
              "JOB.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korali nakristali kuyitena nehi; mwalala wuseya wamaana wabadika wamarubi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.18",
            "verseOrgIds": [
              "JOB.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntopaza wamuEtiyopiya kushikilamu nehi, hela wuru wakoseka kweseka nawu nehi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.19",
            "verseOrgIds": [
              "JOB.28.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.19",
            "verseOrgIds": [
              "JOB.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indi maana afumaŋa kudihi? Nikwekala kashinshi kudihi? ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.20",
            "verseOrgIds": [
              "JOB.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana ayisweka kumesu ayuma yayumi yejima ayijindawu atujila twahaluzwizu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.21",
            "verseOrgIds": [
              "JOB.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "NiKujilumuka ni kufwa nawu, Tunatiyi mpuhu yawu namatu etu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.22",
            "verseOrgIds": [
              "JOB.28.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.22",
            "verseOrgIds": [
              "JOB.28.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi diyi washinshika njila yawu, diyi weluka kwekalawu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.23",
            "verseOrgIds": [
              "JOB.28.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa diyi watalaŋa nikunsa jeseki, diyi wamonaŋa mwishina dewulu dejima; ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.24",
            "verseOrgIds": [
              "JOB.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulonda atuŋi pezu yakupezelesha nachu mpepela; mwalala diyi wesekaŋa meji nachesekelu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.25",
            "verseOrgIds": [
              "JOB.28.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henkeliyi nvula lushimbi, halejeliyi kukenashana kwakudidima njila, ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.26",
            "verseOrgIds": [
              "JOB.28.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 28:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "dihu hamweniyi maana, hakushimunamu, hakukoleshamu, mwalala, hakukeŋakeŋa nimwayawu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.27",
            "verseOrgIds": [
              "JOB.28.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOB 28:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haku mwila muntu nindi, Tiya, kumutiya Mwanta woma wowu maana, kwambuka kuyatama koku kashinshi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.28",
            "verseOrgIds": [
              "JOB.28.28"
            ]
          }
        }
      ]
    }
  ],
