  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "JOB 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bilidadi wakuShuhi hakwakula nindi: ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.1",
            "verseOrgIds": [
              "JOB.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wukukumisha kuhosha yumiyi mwakanyi? Mazu amukanwa keyi elaŋa tuhu neyi mpepela yeneni? ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.2",
            "verseOrgIds": [
              "JOB.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi waheŋeshaŋa wuŋaji, tahindi? Chinaweji waheŋeshaŋa kuloŋa, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.3",
            "verseOrgIds": [
              "JOB.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi anyaneyi diwu anamuvulumuni, niyena nayishikŋi dehi mumuloŋa wawu, ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.4",
            "verseOrgIds": [
              "JOB.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "neyi eyi wukumukeŋakeŋa Nzambi nankashi, nakumulembelela Chinaweji; ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.5",
            "verseOrgIds": [
              "JOB.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "neyi wadiŋi walala woloka, chalala yena wadi kukuhindukila namutulu, wadi kushakamisha chachiwahi itala dakuloŋa kweyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.6",
            "verseOrgIds": [
              "JOB.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela kuwatachikili kwakeheli, kuwakakumishila kwakatoha nankashi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.7",
            "verseOrgIds": [
              "JOB.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.7",
            "verseOrgIds": [
              "JOB.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ehujoli ntahi mwani, mwahitili nyaka yakusambila, wushuku muchima wiluki yakeŋakeŋeluwu ankakulula jawu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.8",
            "verseOrgIds": [
              "JOB.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa etu kwetu tuyantu ahaloshi aha hohu, hitweluka chumaku, muloŋa mafuku etu ahamaseki himwevulu hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.9",
            "verseOrgIds": [
              "JOB.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ochu wena ankakulula abuli kukuleja, hela kukushimwina, hela kukuhosha mazu amunyichima yawu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.10",
            "verseOrgIds": [
              "JOB.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.10",
            "verseOrgIds": [
              "JOB.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushiinji watweshaŋa kukula chakadi malowa, tahindi? Hela ilela datweshaŋa kukula chakadi meji, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.11",
            "verseOrgIds": [
              "JOB.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hidichidi ditúuta, nikudiketula nehi, dalepukaŋahu dehi, nyitondu yejima kanda. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.12",
            "verseOrgIds": [
              "JOB.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dimu mwamonaŋawu antu ejima amuvulamenaŋa Nzambi; muntu wakadi kusha Nzambi kumuchima mwakuhwelelaŋayi mwakakuma. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.13",
            "verseOrgIds": [
              "JOB.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chikuhwelela chindi chakaketuka hakachi ngwa, yakuhwelelayi hiwanda wachimbalaŋenzi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.14",
            "verseOrgIds": [
              "JOB.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindi ashindameni hetala dindi, kwimana nehi, nindi akwatuku mbe-e, kukola nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.15",
            "verseOrgIds": [
              "JOB.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namwa ana, nyitayi yindi yidi nakuya nakutandama hetempa dindi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.16",
            "verseOrgIds": [
              "JOB.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyiji yindi yaya nakudiselasela kumulumba, wamonaŋa hamalola. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.17",
            "verseOrgIds": [
              "JOB.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi wakakisikila hindi hekalayi, hakadikala nindi, Hinakumwenuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.18",
            "verseOrgIds": [
              "JOB.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowe! muzaŋalu wanamoniyi wowenowu, hamaseki hihakamena antu acheŋi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.19",
            "verseOrgIds": [
              "JOB.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.19",
            "verseOrgIds": [
              "JOB.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyenu, Nzambi hakamúumba muntu walalaku, akwakukoŋa yatama hakayikwasha kwinduku. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.20",
            "verseOrgIds": [
              "JOB.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninodu wakenzesha mukanwa keyi nanyiselu, ninyivumbu yeyi yakadikuwa hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.21",
            "verseOrgIds": [
              "JOB.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akuheleyi akadivwika nsonyi, itenti dawatama hidakekala nawa kwoku.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.22",
            "verseOrgIds": [
              "JOB.8.22"
            ]
          }
        }
      ]
    }
  ],
