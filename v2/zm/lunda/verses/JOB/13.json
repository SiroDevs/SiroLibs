{
  "id": "JOB.13",
  "number": "13",
  "bookId": "JOB",
  "reference": "Jobo 13",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "JOB 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Talenu, disu dami damona dehi mwejimimu, itu dami dinatiyi, chinanlumbulukili. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.1",
            "verseOrgIds": [
              "JOB.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yimwelukenu ninami nayiluka nawa, ami hinakuminumu kwamuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.2",
            "verseOrgIds": [
              "JOB.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela chochu, nakeŋi kuhosha naChinaweji, nukutiya kuwaha kutadika naNzambi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.3",
            "verseOrgIds": [
              "JOB.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwila enu mudi akwakukasakasa yakutwamba, mudi ayimbuki amukunkulwayi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.4",
            "verseOrgIds": [
              "JOB.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutenowu mwadi kudi mwenena tuhu kwenu chikupu, chadi kwikala maana enu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.5",
            "verseOrgIds": [
              "JOB.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyenu ntahi munukutadika, tiyililenu munukudihakwila nanyivumbu yami.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.6",
            "verseOrgIds": [
              "JOB.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.12",
            "verseOrgIds": [
              "JOB.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dimwenenenu tuhu kwenu zo-o, nlekenu nihoshi kwami, yonsu yinakeŋi kunwana yinwani tuhu kwayu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.13",
            "verseOrgIds": [
              "JOB.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musunyi wami nukuwukwatiladi namaji ami? Hela wumi wami nukuwukwatiladi muchikasa chami? ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.14",
            "verseOrgIds": [
              "JOB.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela wukunjaha kwindi, nukumuchiŋililaŋa ho-o; hela chochu, njila jami nukujihakula kumesu indi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.15",
            "verseOrgIds": [
              "JOB.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenimu dimu nakamwena wamwinu wami. Muloŋa muntu wukweti kasekesha kakusekesha Nzambi, hakwinza kumesu induku. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.16",
            "verseOrgIds": [
              "JOB.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyenu chachiwahi munukuhosha, chinukushimuna chishiki mumatu enu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.17",
            "verseOrgIds": [
              "JOB.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyenu dinu, Muloŋa nawuloŋeshi dehi. Neluki nami naloŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.18",
            "verseOrgIds": [
              "JOB.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tukudisompesha nanyi? Ichi dinu nukudimwenena kwami, nidifwili tuhu kwami.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.19",
            "verseOrgIds": [
              "JOB.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.19",
            "verseOrgIds": [
              "JOB.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela chochu, eyi Nzambi, kudi yuma yiyedi bayi wuŋilayuku; neyi chochu hinakabatama kumesu eyuku; ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.20",
            "verseOrgIds": [
              "JOB.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "fumishaŋa chikasa cheyi chiyi kwakulehi nanami, mutentu weyi bayi wunfwisha mutentuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.21",
            "verseOrgIds": [
              "JOB.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tambikaku eyi, ami nukwitiya; hela nukuhosha ami, eyi wuŋakuli. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.22",
            "verseOrgIds": [
              "JOB.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuluwaluwa kwami kuŋahi? Nshidi jami jiŋahi? ŋilukishi Muloŋa wami, ninshidi yami. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.23",
            "verseOrgIds": [
              "JOB.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanswekela ŋadi mesu eyi, wunfwikŋi neyi nichilumbu cheyi? ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.24",
            "verseOrgIds": [
              "JOB.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wukabishi ifu didi nakuya nakuleloka? Wuhaŋi ntotu jawuma? ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.25",
            "verseOrgIds": [
              "JOB.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "muloŋa eyi wudi nakunsonekela yuma yalula, wudi nakunswanisha kuluwaluwa kunaluwilaŋa hawukwenzi wami. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.26",
            "verseOrgIds": [
              "JOB.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wudi nakusha nyendu yami mumpompa, wudi nakulamakesha njila jami jejima; wudi nakunfundila mufunda kumadachilu ami kwi-ndo; ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.27",
            "verseOrgIds": [
              "JOB.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOB 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "ami muntu nidi neyi chuma chatoka dehi chidi nakuya nakunoŋa, nidi neyi ihina dakuvwala dadyawu dehi kudi atububu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.28",
            "verseOrgIds": [
              "JOB.13.28"
            ]
          }
        }
      ]
    }
  ],
