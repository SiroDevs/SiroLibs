  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "ACT 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apostolu niana kwawu amuYudeya, hiyakutiya nawu aJentili niwena nawa anatambuli dehi mazu aNzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.1",
            "verseOrgIds": [
              "ACT.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanenziyi Petulu kuYerusalema, akwakwalama hiyakutadika nindi, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.2",
            "verseOrgIds": [
              "ACT.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nawu, Eyi wepilili mwawayidima, hiwukudya nawu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.3",
            "verseOrgIds": [
              "ACT.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petulu hakutachika kuyilumbulwila mwahitili nsaŋu yejima. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.4",
            "verseOrgIds": [
              "ACT.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindi, Chinadiŋi kumukala waYopa nakulomba, hinukwila neyi nukukeŋa kuya namutulu, hinukumona chimwenu, chuma kwiji chika, chidi neyi ihina deneni, hichikuzelumuka, hiyakuchizelumuna kwiwulu muchadiŋi kumawombu achu awana, chishi ka nikudami. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.5",
            "verseOrgIds": [
              "ACT.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kushinshikamu hinukumona mudi anyama ahanu heseki, nianyama amumpata, niyuma yazalalaŋa, nitujila twahaluzwizu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.6",
            "verseOrgIds": [
              "ACT.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinukutiya izu nawu, Eyi Petulu, nyamukaku, wujahi, wudyai. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.7",
            "verseOrgIds": [
              "ACT.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami hinukwila nami, Aha-a, Mwanta, kanda dehi nidyi chuma chatama hela chajilaku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.8",
            "verseOrgIds": [
              "ACT.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izu hidikwakula kwiwulu kamuchiyedi nawu, Chuma chanawahishiyi Nzambi, bayi wuchitena neyi chatamaku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.9",
            "verseOrgIds": [
              "ACT.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanachiluwu kasatu ayikokela niyejima mwiwulu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.10",
            "verseOrgIds": [
              "ACT.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hohenohu kutala amayala asatu, anatemeshuwu dehi kudami kufuma kuKesareya, anemani dehi kwitala kutwadiŋi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.11",
            "verseOrgIds": [
              "ACT.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Spiritu hakunleja nindi yaloŋa nawu, nindi bayi mudambulaku. Nayili hamu nanawa ana kwetu atanu nawumu; twiŋila nimwitala dayenowu iyala. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.12",
            "verseOrgIds": [
              "ACT.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakutuleja chamweniyi kaŋelu nemanimwitala dindi, nichamulejeluwu kudi owu kaŋelu nindi, Temeshaku antu kuYopa, akaleti Shimona atumbiluwu ijina di kwawu daPetulu; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.13",
            "verseOrgIds": [
              "ACT.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "akakuleji mazu akukuhandisha nachu nineyi niakwetala deyi ejima. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.14",
            "verseOrgIds": [
              "ACT.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinadiŋi nakutachika kuhosha, Spiritu Wajila hakuholokela hadi wena, mwomwaholokeleliyi hadetu hakusambila. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.15",
            "verseOrgIds": [
              "ACT.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinukwanuka mazu aMwanta eliliyi nindi, Chalala Yowanu wapapatishili mumeji, hakwila enu akayipapatisha mudi Spiritu Wajila. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.16",
            "verseOrgIds": [
              "ACT.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu, Nzambi ayinka chamukunkulu chochimu chatwinkeliyi etu hitwetiyili Mwanta Yesu Kristu, yaminyi mwaka nimoni kudikaŋa naNzambi? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.17",
            "verseOrgIds": [
              "ACT.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanatiyuwu yumiyi, amwena nizo-o; hiyakumulemesha Nzambi nawu, Komana Nzambi neteji aJentili kubalumuka munyichima amoni wumi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.18",
            "verseOrgIds": [
              "ACT.11.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.18",
            "verseOrgIds": [
              "ACT.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owu apalaŋesheluwu nekabisha dasaŋumukili hansaŋu yaSetefwanu, hiyakwenda chakushika nikuFwenisiya, nikuKipirosi, nikuAntiyoki, nakushimuna mazu kudi aYudeya hohu, bayi kudi acheŋuku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.19",
            "verseOrgIds": [
              "ACT.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "KuKipirosi nakuKireni kwadiŋi amayala amakwawu avwalikili kwenoku; wenawa chanashikuwu kuAntiyoki, hiyakuhoshahosha nawaYudeya awaHeleni nawa, nakushimuna nsaŋu yaMwanta Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.20",
            "verseOrgIds": [
              "ACT.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chikasa chaMwanta hichikwikala nawena; amavulu nankashi hiyakwitiya, hiyakubalumuka nakutala kudi Mwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.21",
            "verseOrgIds": [
              "ACT.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsaŋu yayumiyi yitiyakana nikudi akwachipompelu chadiŋi muYerusalema, hiyakutemeshaku Baranaba akashiki nikuAntiyoki. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.22",
            "verseOrgIds": [
              "ACT.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena chanashikiyi, chanamoniyi luwi lwaNzambi, hakutiya kuwaha; hakuyikonkomwena wejima wawu nindi akakakeli Mwanta chakutaku muchima. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.23",
            "verseOrgIds": [
              "ACT.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa wadiŋi iyala wamuwahi, wenzala Spiritu Wajila nikukuhwelela. Antu amavulu adibombeli naMwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.24",
            "verseOrgIds": [
              "ACT.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baranaba hakuya nakukeŋa Sawulu kuTarusa. Chanamuwaniyi hakumuleta kuAntiyoki. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.25",
            "verseOrgIds": [
              "ACT.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakupompaŋa hamu nachipompelu mwaka wejima, nakuleja antu amavulu nankashi. KuAntiyoki diku kwásambilili kutenawu atumbanji ijina dawakwaKristu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.26",
            "verseOrgIds": [
              "ACT.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamafuku owu, kuYerusalema hikukufuma atuprofwetu hiyakwinza kuAntiyoki. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.27",
            "verseOrgIds": [
              "ACT.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hikukwimana muntu wumu, ijina dindi Aŋabusi, hakushimuna ŋahu dehi naSpiritu nindi kwakenza nzala yeneni mwahita mpata yamunu mwishina mwejima. Nzaloyu yaholokeli hamafuku adiŋiyi Kaludusa mwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.28",
            "verseOrgIds": [
              "ACT.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nochu atumbanji ejima hiyakwila nawu tukwashuku ana kwetu adi muYudeya. Hiyakuhanahana iwu mwanatwesheliyi, iwu mwanatwesheliyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.29",
            "verseOrgIds": [
              "ACT.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chaneluwu, hiyakutemesha kudi awakulumpi yuma yapompesheluwu, kumakasa aBaranaba naSawulu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.30",
            "verseOrgIds": [
              "ACT.11.30"
            ]
          }
        }
      ]
    }
  ],
