  "verseCount": 37,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "ACT 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heliluwu achidi kuhosha nawantu, atupristu nimukulumpi wamashidika amutembeli, niaSadusi, hiyakuyishintakesha; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.1",
            "verseOrgIds": [
              "ACT.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "anatiyi dehi kutama chadi nakulejawu antu nawu mudi Yesu afu amba kasaŋuka. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.2",
            "verseOrgIds": [
              "ACT.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakuyikwata, hiyakuyisha mwakuyihembela, kulonda achiŋilili kucha, muloŋa henohu kuneli dehi melela. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.3",
            "verseOrgIds": [
              "ACT.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa mavulu anatiyi dehi mazu hiyakwitiya, kuchinda amayala ashikili kafwampi neyi makombakaji atanu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.4",
            "verseOrgIds": [
              "ACT.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.4",
            "verseOrgIds": [
              "ACT.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chikunachi, anyuli jawu niakulumpi niansoneki, hiyakupompa muYerusalema, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.5",
            "verseOrgIds": [
              "ACT.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikapristu muneni Anasi, niKayafwasi, niYowanu, niAlesanderi, nichisaka chakapristu muneni chejima. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.6",
            "verseOrgIds": [
              "ACT.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakuyimika mukachi, hiyakuyihula nawu, Ichichuma chimuneli munachili naŋovwinyi? nejina danyi? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.7",
            "verseOrgIds": [
              "ACT.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petulu, nenzali dehi Spiritu Wajila, hakuyila nindi, Enu mwayulaŋa antu, ninenu awakulumpi, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.8",
            "verseOrgIds": [
              "ACT.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "chimudi nakutwihula lelu iwu mudimu wawuwahi wutunakoleshi nachu muntu wadiŋi chifwayi; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.9",
            "verseOrgIds": [
              "ACT.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "tiyenu chachiwahi mwiluki, wejima wenu mwahita aIsarela ejima nenu, ijina daYesu Kristu wakuNazareta, mwapopelenu kukulusu, asaŋulawu dehi kudi Nzambi mudi afu, mudi yena dimu munakoleli iwu muntu nemani kunu kumesu enu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.10",
            "verseOrgIds": [
              "ACT.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu diyi ilola dimwadiwili enu akwakutuŋa, delishiluwu namutu wewombu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.11",
            "verseOrgIds": [
              "ACT.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hikwekala kuhanda mudi wacheŋuku, muloŋa munu mwishina mukachi kawantu hiyanenkumu ijina dacheŋi dakuhanda nachuku.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.12",
            "verseOrgIds": [
              "ACT.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.12",
            "verseOrgIds": [
              "ACT.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chamwenuwu kuumika kwawaPetulu naYowanu, kuyitala komana hiyantu akadi kwiluka nyikanda, hela kwijila mumashikola amaana, hiyakuhayama. Chanayishinshikuwu ayiluka nikuyiluka, nawu wowu adiŋi laŋa naYesu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.13",
            "verseOrgIds": [
              "ACT.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanamonuwu iyala akolesheluwu nemani nawu, hiyamweni mwakutadikilaku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.14",
            "verseOrgIds": [
              "ACT.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa chanayilejuwu kufuma muchota ayi kumbadi, hiyakushakama hampùŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.15",
            "verseOrgIds": [
              "ACT.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawu, Awa amayalawa tukuyila ŋahili Muloŋa chinjikijilu chanakoŋuwu hichakuyambaku, chinamwekani kudi antu ejima ashakama muYerusalema; hitukutwesha kudikala mwokuku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.16",
            "verseOrgIds": [
              "ACT.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tukuminenu dakuyikonkomwena chakuyizuwila, kulonda kufumisha hanu aleki kuhosha nawantu mwijina daYesu, kulonda nsaŋu iyi yibuli kutiyakana kwacheŋi mukachi kawantu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.17",
            "verseOrgIds": [
              "ACT.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakuyitambika, hiyakuyileja naŋovu nawu, Bayi muhosha cheŋi hela kuleja antu mwijina daYesu, hela hantuku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.18",
            "verseOrgIds": [
              "ACT.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa Petulu naYowanu hiyakuyakula nawu, Chachiwahi kumesu aNzambi kutiyilila enu, tahindi chachiwahi kutiyilila Nzambi? Sompenu ntahi enu aweni. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.19",
            "verseOrgIds": [
              "ACT.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa kuleka kutena yuma yitwelili nikumona nikutiya, etu kwetu kutwesha nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.20",
            "verseOrgIds": [
              "ACT.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanayikonkomwenuwu cheŋi chakuzuwa, hiyakuyumbaku, anakaŋanyi dehi kumona chuma chakuyibabeshela; anatiyi dehi woma wawantu, muloŋa antu ejima hiyakulemesha Nzambi hachuma chaneluwu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.21",
            "verseOrgIds": [
              "ACT.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ona muntu eliluwu chinjikijilu chakumukolesha wadiŋi wanyaka yakubadika makumi awana.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.22",
            "verseOrgIds": [
              "ACT.4.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.22",
            "verseOrgIds": [
              "ACT.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanayilekuwu, hiyakuya kudi akwawu, hiyakushimuna mwejima mwanayihoshuwu kudi awakulumpi jawatupristu nikudi awakulumpi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.23",
            "verseOrgIds": [
              "ACT.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanatiyuwu mwenomu, hiyakubidika kudi Nzambi namuchima wawu wumu hohu nawu; Eyi Mwanta, yeyi waleŋeli niiwulu niiseki nikaluŋalwiji, niyuma yejima yidumu; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.24",
            "verseOrgIds": [
              "ACT.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwomu wahosheleli kukanwa kankakulula yetu kambuŋeyi Davidi neyi, AJentili anazuwilidi? Antu atoŋojokelidi chuma chamukunkulwayi? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.25",
            "verseOrgIds": [
              "ACT.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyanta ahamaseki anatandami, anyuli jawu hiyakushakama hampùŋa lwi naYehova nawindi awayishayi dehi manji. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.26",
            "verseOrgIds": [
              "ACT.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chalala kwaamu, nikambuŋeyi wajila Yesu, iwawayishili manji, amupompeleli kudi aHerodi naPontusi Pilatu, hamu nawaJentili, ninyuza yawaIsarela, muŋanda yinu; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.27",
            "verseOrgIds": [
              "ACT.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "eli mwakeŋa eli kwila chikasa cheyi, muwatoŋwelaŋahu dehi hampùŋa yeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.28",
            "verseOrgIds": [
              "ACT.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi dinu Mwanta, talaku chanatukonkomwenuwu chakuzuwa, atwiteji etu anduŋu jeyi tushimuni mazu eyi chakadi woma, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.29",
            "verseOrgIds": [
              "ACT.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "iku wudi nakwolola chikasa cheyi nakukolesha antu, nakwila yinjikijilu niyihayamisha yakwila nejina dakambuŋeyi wajila Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.30",
            "verseOrgIds": [
              "ACT.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanalombuwu, omu mwapompeleluwu himukukanka; wejima wawu hiyakwinzala Spiritu Wajila, hiyakuhosha mazu aNzambi chakadi woma.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.31",
            "verseOrgIds": [
              "ACT.4.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
