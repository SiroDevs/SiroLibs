          ]
        },
        {
          "text": "muloŋa antu adiŋi namaha, hela matala, hiyakuyilandisha, hiyakuleta mali ayuma yanalandishuwu, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.34",
