  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "ACT 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanaŋandakanuwu muAmfwipoIi nimuApoloniya, ashika nikuTesalonika kwadiŋi shikola yawaYudeya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.1",
            "verseOrgIds": [
              "ACT.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pawulu hakwijila muneyi chelilaŋayi dikalu, hakutadika nawu mwomwaya nyikanda yajila, sabata jisatu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.2",
            "verseOrgIds": [
              "ACT.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyilumbulwila nakukolesha chikupu nindi, Chalala chateleleli Kristu kukaba nakusaŋuka mudi afu; nindi, Iwu Yesu inidi nakuyishimwina, diyi Kristu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.3",
            "verseOrgIds": [
              "ACT.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakwawu hiyakwiteja, hiyakudibomba nawaPawulu naSilasi, niaHeleni akwakuhameka Nzambi izaza dadeni, niambanda alema amavulu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.4",
            "verseOrgIds": [
              "ACT.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa Yudeya, anatiyi dehi ichima, hiyakufumba amayala atama amukunkulwayi, hiyakupompesha izaza dawantu, avwakula niipumba mwahita ŋanda yejima. Hiyakulotokela kwitala daYasoni, hiyakukeŋa nawu ayiidishi kudi antu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.5",
            "verseOrgIds": [
              "ACT.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanakaŋanyuwu kuyiwana, hiyakukokela Yasoni niana kwetu amakwawu kumesu awanyuli jaŋanda, nakubideka naŋovu nawu, Wenawa hiyatuvuba anavunduli mpata yamunu mwishina yejima, anenzi nikunu nawa; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.6",
            "verseOrgIds": [
              "ACT.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "anayitambuli kudi Yasoni. Wejima wawu hiyovwahilaŋa nshimbi jaKesaruku, elaŋa nawu kudi mwanta walukanu wacheŋi, yowu Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.7",
            "verseOrgIds": [
              "ACT.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izaza dawantu nianyuli jaŋanda, chanatiyuwu yumiyi, atiya nimumuchima futu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.8",
            "verseOrgIds": [
              "ACT.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanatambuluwu kapopu kudi Yasoni nawakwawu, hiyakuyumbaku nawu ayi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.9",
            "verseOrgIds": [
              "ACT.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.9",
            "verseOrgIds": [
              "ACT.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hohenohu ana kwetu hiyakutemesha aPawulu naSilasi kuBereya nawufuku. Chanashikuwu, hiyakwijila mushikola yawaYudeya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.10",
            "verseOrgIds": [
              "ACT.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "AYudeya akwenoku hiyakubadika amuTesalonika kalemesha, muloŋa wena anyakeli kutambula mazu; hiyakutalatala munyikanda yajila hefuku hefuku, amoni neyi yumiyi dimu yaya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.11",
            "verseOrgIds": [
              "ACT.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi amavulu hiyakwitiya; niambanda aHeleni alumbwa amavulu, hela amayala kukeha nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.12",
            "verseOrgIds": [
              "ACT.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa Yudeya akuTesalonika, chanelukuwu nawu Pawulu nashimuni dehi mazu aNzambi muBereya nawa, hiyakuya kwenoku nakuyibobwesha, kulonda afutwishi munyichima yezaza dawantu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.13",
            "verseOrgIds": [
              "ACT.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana kwetu atemesha niPawulu hohenohu, ayi akashikaŋahu dehi kukaluŋalwiji; aSilasi naTimotewu hiyakushala kwenoku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.14",
            "verseOrgIds": [
              "ACT.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu amutweleluku Pawulu hiyakumushikŋa kuAtenisi. Chanayilejiyi nindi aSilasi naTimotewu akanyakali kwinza, hiyakufunta.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.15",
            "verseOrgIds": [
              "ACT.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.15",
            "verseOrgIds": [
              "ACT.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pawulu chadiŋi nakuyichiŋililayi kuAtenisi, spiritu yindi hiyikutiya chikela, chanamoniyi ŋanda yejima yinenzali akishi to. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.16",
            "verseOrgIds": [
              "ACT.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi hakutadikaŋa mushikola nawaYudeya nawakwakufukula kudi Nzambi; nikuwulandilu nawantu akudimonayi nawu, hefuku hefuku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.17",
            "verseOrgIds": [
              "ACT.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "AEpikureya nawaSitoki amakwawu adiŋi akwakukeŋakeŋa maana, hiyakumubulakana. Amakwawu hiyakwila nawu, Iwu Sakubobola keŋa ahoshi nindidi? Amakwawu nawu, Kwiji hakushimuna akishi akwituŋa dacheŋi; nanochu chadiŋi nakushimunayi Yesu, nikusaŋuka mudi afu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.18",
            "verseOrgIds": [
              "ACT.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakumukwata kuchikasa, hiyakuya nindi hampidi yaMarasa; hiyakumwila nawu, Iyi nsaŋu yayiha yiwudi nakushimuna, etu nawa tukutwesha kuyiluka, tahindi?",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.19",
            "verseOrgIds": [
              "ACT.17.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.21",
            "verseOrgIds": [
              "ACT.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Pawulu hakwimana hakachi kampidi yaMarasa, hakwila nindi, Enu akwetu amayala akwaAtenisi, namoni mwasweja kukeŋa kupeshapesha.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.22",
            "verseOrgIds": [
              "ACT.17.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 17:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.31",
            "verseOrgIds": [
              "ACT.17.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 17:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi wena chanatiyuwu nsaŋu yakusaŋuka mukufwa, amakwawu hiyakuseha; hakwila amakwawu nawu, Tunakeŋi kutiya cheŋi nsaŋu iyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.32",
            "verseOrgIds": [
              "ACT.17.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 17:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Pawulu hakufuma mukachi kawu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.33",
            "verseOrgIds": [
              "ACT.17.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 17:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amayala amakwawu hiyakumukakela, hiyakwitiya; adiŋi iwu Diyonisi mukwampidi yaMarasa, nimumbanda wumu ijina dindi Damarisi, hamu nawamakwawu nawa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.34",
            "verseOrgIds": [
              "ACT.17.34"
            ]
          }
        }
      ]
    }
