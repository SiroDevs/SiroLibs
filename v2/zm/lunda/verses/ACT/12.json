  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "ACT 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kafwampi wowena mafuku owu Mwanta Herodi hakwolola makasindi akabishi antu amakwawu amuchipompelu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.1",
            "verseOrgIds": [
              "ACT.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakujaha Yakoba mana kwaYowanu nampoku yakabali. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.2",
            "verseOrgIds": [
              "ACT.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chamweniyi chinatiyishi aYudeya kuwaha, hakubombelaku chuma chikwawu chakukwata niPetulu nawa. Wenowu mafuku adiŋi akudya mankendi akadi iluŋi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.3",
            "verseOrgIds": [
              "ACT.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanamukwatiyi, hakumusha mukaleya, hakumuhana kudi mashidika ikumi natanu nawumu, amuhembaŋa awana awana, nindi paseka yisambili kuhita nimwidishi kudi antu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.4",
            "verseOrgIds": [
              "ACT.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Petulu hiyakumuhembaŋa mukaleya; ilaŋa akwachipompelu hiyakumulombelaŋa naŋovu kudi Nzambi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.5",
            "verseOrgIds": [
              "ACT.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.5",
            "verseOrgIds": [
              "ACT.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wowena wufuku watoŋojokelaŋayi Herodi nindi nakamwidisha kuma diki, Petulu wadiŋi wakama swataka namutulu, saŋa amukasilawu mukachi kamashidika ayedi namaleŋi ayedi, atulama adi kuchenzelu ahembeli kaleya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.6",
            "verseOrgIds": [
              "ACT.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukasumuka kaŋelu kaYehova nemani dehi kwadiŋiyi; chejeji chitoŋeka nimukatala kamukachi kakaleya. Hakumweta Petulu hakabavu, hakumuhindwisha namutulu nindi, Nyamukaku swayi. Maleŋi indi aholoka nikumakasindi bambala. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.7",
            "verseOrgIds": [
              "ACT.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaŋelu hakumwila nindi, Vwalaku, wukasi ninkwabilu jeyi. Hakwila mwenomu. Hakumwila nindi, Dikumbakeshi ihina deyi, wunlondi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.8",
            "verseOrgIds": [
              "ACT.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Edika nikwidika, hakumulondela. Chadiŋi nakumwilawu kudi kaŋelu, yena kwiluka nehi; hakutoŋojoka nindi namoni chimwenu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.9",
            "verseOrgIds": [
              "ACT.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanaŋandakanuwu atulama akusambila niamuchiyedi, hiyakushika kuchenzelu chachikuŋu chakuma kuŋanda; hichikudenzulukila chacheni. Hiyakwidika, hiyakuya mumukwakwa wumu; hohenohu kaŋelu hakudiyila kwindi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.10",
            "verseOrgIds": [
              "ACT.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petulu chanabazumukiyi nindi, Komanayami! Hakuhosha nindi, Ichi dinu neluki chalala, komana Mwanta nate meshi kaŋelu kindi, nampulwishi dehi kuchikasa chaHerodi, nimwejima mwadiŋi nakuchiŋejawu aYudeya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.11",
            "verseOrgIds": [
              "ACT.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanatoŋojokiyi, hakuya kwitala daMariya, mama yaYowanu atumbi luwu ijina di kwawu daMaku, mwapompelawu dehi antu amavulu naku lomba. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.12",
            "verseOrgIds": [
              "ACT.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanadondomweniyi kuchenzelu chakuchipaŋu, hikukwinza chaŋadima chamumbanda, ijina dindi Roda, kulonda atiyilili. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.13",
            "verseOrgIds": [
              "ACT.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanelu kiyi izu daPetulu, hamweni jakumwenzulwilaku nakuzaŋalala kwanatiyiyi. Hakufunta lufuchi nakuleja akwawu nindi, Petulu nemani kuchisu iwu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.14",
            "verseOrgIds": [
              "ACT.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wena hiyakumwila nawu, Eyi wunaanŋali! Yena hakukolesha chikupu nindi mwomwenomu. Wena nawu, Kwiji hikaŋelu kindi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.15",
            "verseOrgIds": [
              "ACT.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa Petulu saŋa adondomwenayi. Chanenzululuwu, hiyakumumona hiyakuhayama. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.16",
            "verseOrgIds": [
              "ACT.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa yena hakuyimwenesha nachikasa; hakuyilumbulwila mwanamwidishiluwu mukaleya kudi Mwanta. Hakuyila nindi, Mumulejaŋamu Yakoba niana kwetu. Hakufumaku, hakuya kwacheŋi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.17",
            "verseOrgIds": [
              "ACT.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chikunachi, kudi mashidika hikukuvwakuka ipumba, nawu Petulu nayi kudihi? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.18",
            "verseOrgIds": [
              "ACT.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Herodi chanamwiliyi keŋe-e, kumumona nehi, hakuyihujola atulama; hakuhosha nindi yŋahenu. Herodi hakufuma kuYudeya, hakukunkumuka kuKesareya, ashakama nikwenoku.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.19",
            "verseOrgIds": [
              "ACT.12.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.19",
            "verseOrgIds": [
              "ACT.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Herodi hakutiya kutama nankashi nawakwaTira naZidoni, wena hiyakuya kudi yena mukanka, asambila dehi kukwata wubwambu naBalasatu, yowu wahembaŋa itala dawanta, hiyakulemba nawu ashakami chachiwahi chakadi kumona njita; muloŋa ituŋa dawu datambwilaŋa kudya kwituŋa damwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.20",
            "verseOrgIds": [
              "ACT.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashikili ifuku dakutoŋola dehi, Herodi hakuvwalavwala yuma yindi yawanta, hakushakama hetanda dindi dawanta, hakuhosha hoshe-e. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.21",
            "verseOrgIds": [
              "ACT.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu hiyakubidika naŋovu nawu, Hiizu daNzambi, hidamuntuku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.22",
            "verseOrgIds": [
              "ACT.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hohenohu amweta nikudi kaŋelu kaYehova, nanochu chabulililiyi kulemesha Nzambi; hiyakumudya kudi mavunu, afwa ni kufwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.23",
            "verseOrgIds": [
              "ACT.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa mazu aNzambi hiyakuyaloŋa nakukula, asemwaŋana nikuse-mwaŋana.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.24",
            "verseOrgIds": [
              "ACT.12.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.24",
            "verseOrgIds": [
              "ACT.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "ABaranaba naSawulu chanamanishuwu mudimu wawu, hiyakufuma kuYerusalema kwayiluwu, hiyakumuhitula Yowanu atumbiluwu ijina di kwawu daMaku.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.25",
            "verseOrgIds": [
              "ACT.12.25"
            ]
          }
        }
      ]
    }
  ],
