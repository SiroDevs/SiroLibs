  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "ACT 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chitunapuluki dehi, hitukwiluka ijina dachitutu ochu netu Melita. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.1",
            "verseOrgIds": [
              "ACT.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enimbu hiyakututambula wejima wetu naluwi nankashi, hiyakubutula kesi muloŋa kwadiŋi nakunoka nvula, nichishika hamu, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.2",
            "verseOrgIds": [
              "ACT.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pawulu chanakuŋuliyi chita chansonsu, nachishi dehi hakesi, kabandayula chanatiyiyi iyena, hakufuma hakesi halamata nikuchikasa chindi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.3",
            "verseOrgIds": [
              "ACT.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enimbu chanamonuwu inoka nalamati dehi kuchikasa chindi, hiyakudileja muntu namukwawu, nawu, Chalala iyaliwu himbanji, hela wapuluka dehi mukaluŋalwiji, Chiyuli hanamwiteji kuhandaku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.4",
            "verseOrgIds": [
              "ACT.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa yena hakudikumuna inoka mukesi, kutiya kukata nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.5",
            "verseOrgIds": [
              "ACT.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wena enimbu atoŋojokeli nawu keŋa anani, indi kwiji tukukasumuka nadimbuki nafwi dehi. Chaneluwu talile-e, kumumona yena hanatiyi chuma chatamaku, hiyakubalumuka munyichima yawu, nawu komana himukishi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.6",
            "verseOrgIds": [
              "ACT.28.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.6",
            "verseOrgIds": [
              "ACT.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwenoku kwadiŋi mpata yamwanta wachitutu ochu ijina dindi Pubilusi. Yena hakututambula hakutudiisha chachiwahi mafuku asatu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.7",
            "verseOrgIds": [
              "ACT.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chelili tata yaPubilusi nakami dehi nayikatu yamusoŋu wamashika nikapokota, Pawulu hakwijila mudi yena, hakulomba, chanamunaŋikiyi makasa, hakumukolesha. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.8",
            "verseOrgIds": [
              "ACT.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chaneliyi mwenimu, antu amakwawu hachitutu ochu adiŋi nanyisoŋu, hiyakwinza, hiyakuyikolesha nawa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.9",
            "verseOrgIds": [
              "ACT.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakutulemeshaŋa nakutwinka yuma yayivulu; chitwakeŋa eli kuya muwatu hiyakushamu yuma yayivulu yakudiila munjila.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.10",
            "verseOrgIds": [
              "ACT.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.10",
            "verseOrgIds": [
              "ACT.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimunahiti tukweji tusatu, hitukuya muwatu wakufuma kuAlesanderiya, wukweti chinjikijilu chaAnyana Mpamba, wachelukilaku dehi noŋa kuchitutu ochu; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.11",
            "verseOrgIds": [
              "ACT.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "tudata nikuSirakusa, hitukujiŋilaku mafuku asatu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.12",
            "verseOrgIds": [
              "ACT.28.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.16",
            "verseOrgIds": [
              "ACT.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimunahiti mafuku asam, Pawulu hakutambika awakulumpi jawaYudeya. Chanapompuwu hamu, hakuyileja nindi, Enu akwetu amayala, ami hinakoŋi chuma chakutamisha akwetu aYudeya, hela yaaku yawankakulula jetuku. Hela chochu, ankwatili kuYerusalema nakunhana kudi aRoma; wena hiyakuŋusha mukaleya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.17",
            "verseOrgIds": [
              "ACT.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wena chanaŋihujoluwu, hiyakukeŋa nawu aŋumbuku, muloŋa hiyanmona nachitela chakufwaku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.18",
            "verseOrgIds": [
              "ACT.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanatiyuwu aYudeya kutama mwenomu, ami hinukumona nami kunashali jakulomba kuya kudi Kesari hohu; ochu ni kweti muloŋa wakuholokela akwamuza wetu wanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.19",
            "verseOrgIds": [
              "ACT.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dihu hanafumi kuyitambika, nami niyimoni nihoshi nenu. Anankasili ileŋi idi nsaŋu yakuchiŋeja kwachiŋe jaŋawu aIsarela. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.20",
            "verseOrgIds": [
              "ACT.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wena hiyakumwila nawu, Hitunatambuli nyikanda yakufuma kuYudeya yakukuteneyuku. Hela ana kwetu enjili kunu, kukushimuna hela kukutena chatama nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.21",
            "verseOrgIds": [
              "ACT.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa tunakeŋi tukutiyi muwatoŋojokaŋa eyi aweni; hakwila chaaku ichi tweluka dehi netu achitenaŋa chatama kwejima kwejima.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.22",
            "verseOrgIds": [
              "ACT.28.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.22",
            "verseOrgIds": [
              "ACT.28.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanamushi ikuwu ifuku, aYudeya amavulu nankashi hiyakwinza kwitala kwashakaminiyi. Yena hakuhita munsaŋu oyu, hakushimuna wanta waNzambi, hakuyilumbulwila nsaŋu yaYesu, chakufumisha munyi kanda yanshimbi jaMosi, niya watuprofwetu, kufumisha kubudidi ndo nikumelela. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.23",
            "verseOrgIds": [
              "ACT.28.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakwawu hiyakwiteja mwahosheliyi, amakwawu hiyakuleka. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.24",
            "verseOrgIds": [
              "ACT.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanabuluwu kutiyaloŋana mulwawu, hiya kudi fumi namu. Henohu Pawulu nahoshi dehi izu dimu nindi, Mwalala mwahosheli Spiritu Wajila nawankakulula jenu mudi kaprofwetu Isaya, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.25",
            "verseOrgIds": [
              "ACT.28.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "cheliliyi nindi, Yaku wakaleji antu awa neyi, Kutiya mukutiya, himwakashinshika nihantuku; kumona mukumona, himwakeluka nihantuku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.26",
            "verseOrgIds": [
              "ACT.28.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 28:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa nyichima yawantu awa yinasupi dehi, kumatu awu anajiki, ni kumesu awu anajimi; akenda kamona namesu awu, akenda katiya namatu awu, akenda kashinshika munyichima yawu, akenda kabalumuka cheŋi nakenda kayuka. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.27",
            "verseOrgIds": [
              "ACT.28.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 28:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi ilukenu nenu iwu wamwinu waNzambi anawutemeshi kudi ajentili; komana wena akatiya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.28",
            "verseOrgIds": [
              "ACT.28.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 28:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanahoshiyi mazu awa, aYudeya hiyakufumaku hiyakutadika nankashi mukachi kawu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.29",
            "verseOrgIds": [
              "ACT.28.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 28:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pawulu washakamini nyaka yiyedi yamana chikupu mwitala dindi dakudifwetela; hakutambula antu ejima ayilaŋa mwadiŋiy. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.30",
            "verseOrgIds": [
              "ACT.28.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 28:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakushimunaŋa wanta waNzambi, nakutena nsaŋu yaMwanta Yesu Kristu chakadi woma; kwosi nawa wamulekesheluku.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.31",
            "verseOrgIds": [
              "ACT.28.31"
            ]
          }
        }
      ]
    }
  ],
