      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi nianyanta anjita niwena aambwiluku anyana kaAsafwina Hemani naYedutuni kulonda akalakalaŋa, diwu akuprofweta panatudada, nayisanji, namachakayi. Achindiluwu akoŋelaŋa nyidimu mwakalakelaŋawu diwu awa; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.1",
            "verseOrgIds": [
              "1CH.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kudi anyana kaAsafwi; Zakuri, niYosefu, niNetaniya, niAsharela, wowanyana kaAsafwi amayala; chakuyimbishakudi Asafwi waprofwetelapa chakumuleja kudi mwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.2",
            "verseOrgIds": [
              "1CH.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kudi Yedutuni, anyana kaYedutuni; Gedaliya, niZeri, niYeshaya, Hashabiya, niMatitiya, atanu nawumu; chakuyimbisha kudi tata yawu Yedutuni nakadada kindi, waprofwetelaŋa nakusakilila nakuhame kaYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.3",
            "verseOrgIds": [
              "1CH.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kudi Hemani, anyana kaHemani; Bukiya, Mataniya, Uziyeli, Shebuweli, niYerimoti, Hananiya, Hanani, Eliyata, Gidaliti, Romamiti Ezeri, Yoshibekasha, Maloti, Hotiri, Mahaziyoti; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.4",
            "verseOrgIds": [
              "1CH.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "wenawa ejima adiŋi anyana kaHemani mukwakumona wamwanta, wamwenana nsaŋu jaNzambi, kulonda kunyamunaŋa luseŋu kwiwulu. Nzambi wamwinkeli Hemani anyana amayala ikuminawana, awambanda asatu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.5",
            "verseOrgIds": [
              "1CH.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wejima wawu ayimbishilaŋa tumina kuditata yawu mwitala daYehova, namachakayi, nayisanji natudada, kulondakukalakala mwitala daNzambi; Asafwi naYedutuni naHemani akalakelichakuyileja kudi mwanta.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.6",
            "verseOrgIds": [
              "1CH.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.6",
            "verseOrgIds": [
              "1CH.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achindiluwu hamu nawana kwawu afundishiluwu kumwimbila Yehova, wowu ejima eluka nankashi kwimba, ashikili mumakulakaji ayedi, namakumi atanu nasatu nawantu atanu nasatu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.7",
            "verseOrgIds": [
              "1CH.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adisakwili nayinjikijilu kulonda muwukopelu wanyidimu yawu, wejima wawu hohamu, niwakadi kulemaniwalema, niwalejapa akwawu nialejaŋawu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.8",
            "verseOrgIds": [
              "1CH.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinjikijilu chakusambila chedikilili Asafwi kudi Yosefu; chamuchiyedi Gedaliya; niyena niana kwindi ni anyanindi amayala ashikili mwikumina yedi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.9",
            "verseOrgIds": [
              "1CH.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "chamuchisatu Zakuri, anyanindi niana kwindi, ikumi nayedi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.10",
            "verseOrgIds": [
              "1CH.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "chamuchiwana Iziri, anyanindi niana kwindi, ikumi nayedi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.11",
            "verseOrgIds": [
              "1CH.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "chamuchitanu Netaniya, anyanindi niana kwindi, ikumi nayedi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.12",
            "verseOrgIds": [
              "1CH.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "chamuchitanu nachimu Bukiya, anyanindi niana kwindi, ikumi nayedi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.13",
            "verseOrgIds": [
              "1CH.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "chamuchitanu nachiyedi Yesharela, anyanindi niana kwindi, ikumi nayedi;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.14",
            "verseOrgIds": [
              "1CH.25.14"
            ]
          }
        }
      ]
    }
  ],
