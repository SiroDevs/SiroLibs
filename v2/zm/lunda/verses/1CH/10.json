    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "AFwilistinu hiyakulwa nawaIsarela, aIsarela amayala hiyakutemuka aFwilistinu, atapoleluwu hiyakudimbokela kumpidi yaGilibowa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.1",
            "verseOrgIds": [
              "1CH.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "AFwilistinu hiyakuyihaŋa aSawulu nawanyanindi nankashi; aFwilistinu hiyakujaha Jonatani, niAbinadabi, niMalikishuwa, wowu anyana kaSawulu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.2",
            "verseOrgIds": [
              "1CH.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njita hiyikumwila Sawulu mwatama, hiyakumuwana kudi akwamata anyikunji, hiyakumumwesha kukala nankashi kudi akwamata anyikunji. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.3",
            "verseOrgIds": [
              "1CH.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulu hakumwila mukwakusenda yitwa yindi, nindi Holaku mpoku yeyi yakabali, wuyimpwiki hamujimba wami zwa-a, kuchina kwinza nakunkoŋa chatama kudi awa ayidima. Ilaŋa mukwakusenda yitwa yindi wakolamini, muloŋa watiyili woma nankashi. Dichi Sawulu hakukwata mpoku yindi yakabali, hakudimbukilaku. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.4",
            "verseOrgIds": [
              "1CH.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukwakusenda yitwa yindi chamweniyi Sawulu nafwi dehi, niyena nawa hakudimbukila kumpoku yindi, hakufwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.5",
            "verseOrgIds": [
              "1CH.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi afwili niSawulu nianyanindi amayala asatu; wafwilili hamu nimutaŋa windi wejima. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.6",
            "verseOrgIds": [
              "1CH.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "AIsarela amayala ejima adiŋi muchinekineki, chmwenuwu akwawu hiyakutemoka, niSawulu nawanyanindi anafwi dehi, niwena hiyakufuma munyikala yawu, hiyakutemoka, aFwilistinu shakamamu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.7",
            "verseOrgIds": [
              "1CH.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chikunadu aFwilistinu hiyakwinza nakuvuulavuula afu, hiyakuwana Sawulu nawanyanindi adi heseki kumpidi yaGilibowa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.8",
            "verseOrgIds": [
              "1CH.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakumuvuula, hiyakunona mutu windi, niyuma yindi yanjita, hiyakuyitemesha mwituŋa dawaFwilistinu dejima niniku niniku, nakutwala nsanu nikudi akishi awu akutuŋa nikudi antu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.9",
            "verseOrgIds": [
              "1CH.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuma yindi yanjita ayishili mwitala dawakishi awu, chaaŋu chindi achihatilili mwitala daDagoni.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.10",
            "verseOrgIds": [
              "1CH.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
