      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta Davidi hakwila chipompelu chejima nindi, Mwanami Solomoni anatondiyi Nzambi kanka windi, wuchidi kansi kandaapami, nimudimu weneni; niitalidi dawanta hidamuntuku, daYehova Nzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.1",
            "verseOrgIds": [
              "1CH.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naŋovu jami jejima nalopeshela dehi itala daNzambi yami wuruwayuma yawuru, nisiliva yayuma yasiliva, niwunepu wayuma yawuneŋu, niyikupu yayuma yayikupu, ninyitondu yayuma yanyitondu, nitumalolatwatushohama, nitwakupata chachiwahi, nimalola akubazabaza, niawulombuwepi naweŋi, nitumalola twalema tweŋi natweŋi, nimalola atooka amavulu nankashi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.2",
            "verseOrgIds": [
              "1CH.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanichi chinatiyi kuwaha netala daNzambi yami, nichinikwetiluhetu lwamami aweni lwawuru nasiliva, hinukuluhana lwikali lwetala daNzambi yami, lwakulunjika hayuma yejima yinalopeshela dehi itala dajila;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.3",
            "verseOrgIds": [
              "1CH.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.5",
            "verseOrgIds": [
              "1CH.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tulamba twakumavumu awankakulula jawu, nitulamba twakunyichidiya waIsarela, niakulumpi amakombakaji niamakulakaji, nianyuli anyidimuya mwanta, hiyakulambula chakutiya kuwaha. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.6",
            "verseOrgIds": [
              "1CH.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakuhana yakukalakala nachu itala daNzambi wuru ntalenta makombakaji atanu, najidariki makombakaji ikumi, siliva ntalenta makombakaji ikumi, wuneŋu ntalenta makombakaji ikumi natanu nasatu, yikuŋu ntalenta makombakaji nkulakaji.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.7",
            "verseOrgIds": [
              "1CH.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.8",
            "verseOrgIds": [
              "1CH.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu hiyakuzaŋalala, nanochu chalambwiluwu chakutiya kuwaha, muloŋa amulambwili Yehova namuchima walala chikupu chakutiya kuwaha. Nimwanta Davidi nawa hakuzaŋalala kuzaŋalala kwakweni.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.9",
            "verseOrgIds": [
              "1CH.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.9",
            "verseOrgIds": [
              "1CH.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakumukiswila Yehova nkisu kumesu achipompelu chejima. Davidi nindi, Kisu kisu, eyi Yehova, Nzambi yankakulula yetu Isarela, akamukiswilaŋa nkisu haya nyaka. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.10",
            "verseOrgIds": [
              "1CH.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikutoha, niŋovu, nilubanji, nimuii shindu, nimpuhu, yiikali yeyeyi eyi Yehova; muloŋa yuma yejima, niyidimwiwulu, niyidi heseki yeyeyi hohu; eyi Yehova wanta weyeyi, yeyi wunatúumbakani, wunekali namutu wahewulu dayuma yejima. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.11",
            "verseOrgIds": [
              "1CH.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimahetani kulema kwafuma kudeyi, yeyi wayulapa yuma yejima; chikasa cheyichikweti niŋovu nikunyipa, chikasa cheyi dichi chatoheshaŋi, dichi chakoleshaŋi yuma yejima. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.12",
            "verseOrgIds": [
              "1CH.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu tunakusakilili eyi Nzambi yetu, tunahameki ijina deyi dampuhu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.13",
            "verseOrgIds": [
              "1CH.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.19",
            "verseOrgIds": [
              "1CH.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakwila chipompelu chejima, nindi, Mukiswilenu Yehova Nzambi yenu nkisu. Chipompelu chejima hichikumukiswila Yehova Nzambi yawankakulula jawu nkisu, hiyakubandama nyitu yawu, hiyakudifuku lakudi Yehova nikudi mwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.20",
            "verseOrgIds": [
              "1CH.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakumuketwila Yehova yimuna, hiyakuhimulambu la Yehova nyilambu yakushita, ifuku dakulondela denodu, aŋombi amayala ikombakaji, yizamba yanyikoku ikombakaji, nyana kanyikoku ikombakaji, hamu nanyilambu yawu yakuhuŋununa, niyimuna yaketwililuwu aIsarela kukumina dakulumbama. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.21",
            "verseOrgIds": [
              "1CH.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Denodu ifuku hiyakudyaakunwa kumesu aYehova nakuluŋi kwakweni.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.22",
            "verseOrgIds": [
              "1CH.29.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakumudiisha mwana kaDavidi Solomoni wanta kamuchiyedi, hiyakumuwayishilayi Yehova manji, ekali nlomboli, niZadoki nawa nawu ekalikapristu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.22",
            "verseOrgIds": [
              "1CH.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni hakushakama hetanda daYehova dawanta, himwantanahiŋi dehi mudi tata yindi Davidi, ekala nichachiwahi; aIsarela ejima hiyakumwovwahila. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.23",
            "verseOrgIds": [
              "1CH.29.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niatulamba ejima, niayilobu, hamu nawanyana kaDavidi ejima, hiyakumufwomokela mwanta Solomoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.24",
            "verseOrgIds": [
              "1CH.29.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova hakumutohesha Solomoni nankashi, kumesu awaIsarela ejima hakumwinka wanta walemanankashi, wakadi kwinkaŋahu dehi mwanta wacheŋi muIsarela.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.25",
            "verseOrgIds": [
              "1CH.29.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.25",
            "verseOrgIds": [
              "1CH.29.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi mwana kajesi Davidi wayulili aIsarela ejima. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.26",
            "verseOrgIds": [
              "1CH.29.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyaka yayuliliyi aIsarela yashi kili munyaka makumi awana; muHeberoni wayulilinyaka yitanu nayiyedi, muYerusalema wayulili nyaka makumi asatu nayisatu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.27",
            "verseOrgIds": [
              "1CH.29.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.28",
            "verseOrgIds": [
              "1CH.29.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsapu jamwanta Davidi, nkusambila nkukuminina, talenu, anajisoneki kumazu aSamweli mukwakumona, nikumazu akaprofwetu Natani, nikumazu aGadi mukwakumona; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.29",
            "verseOrgIds": [
              "1CH.29.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "hamu nawanta windi wejima, niŋovu jindi, niyuma yamweniyi, niyamwenuwu aIsarela, niyamweni mawanta ejima amumatuŋa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.30",
            "verseOrgIds": [
              "1CH.29.30"
            ]
          }
        }
      ]
    }
