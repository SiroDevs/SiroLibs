    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsaŋu yayuma yakupesha nachu akishi. Tuneluki netu wejima wetu tweluka. Kwiluka kwaletaŋa kudinka wanta; hakwila kukeŋa kwakoleshaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.1",
            "verseOrgIds": [
              "1CO.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu natoŋojoki nindi neluki, kanda eluki mwadi kwilukayuku. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.2",
            "verseOrgIds": [
              "1CO.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu wakeŋa a Nzambi, diyi elukawu kudi Nzambi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.3",
            "verseOrgIds": [
              "1CO.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.6",
            "verseOrgIds": [
              "1CO.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu amakwawu hiyeluka chenochuku; ilaŋa amu, enjilila dehi akishi, adyaloŋa yakudya yawu kafwampi neyi hichuma chanapeshuwu nachu akishi; hiyakutamisha nachu chinleji chawu chamuchima chazeya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.7",
            "verseOrgIds": [
              "1CO.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kudya hikwatuwahishaŋa kumesu aNzambuku. Neyi tukubula kudya hichikututamishaku; hela neyi tukudya nawa hichikutuwahishaku. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.8",
            "verseOrgIds": [
              "1CO.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa babalenu, Ŋovu yenu iyi yibuli kwikala chuma chakudimbwisha nachu akwenu akadi Ŋovu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.9",
            "verseOrgIds": [
              "1CO.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa neyi muntu wukukumona eyi weluka wunashakami mumalala amukishi nakudya, kwiji chinleji chindi chamuchima chikukwatilaku Ŋovu yakudya yuma yanapeshuwu nachu akishi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.10",
            "verseOrgIds": [
              "1CO.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwiluka kweyi hikukunoŋesha mana kweyi wakadi Ŋovu, afwililiyi Kristu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.11",
            "verseOrgIds": [
              "1CO.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimwavulumunaŋa ana kwenu nakukatisha chinleji chawu chamuchima chabula Ŋovu, mwavulumunaŋa Kristu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.12",
            "verseOrgIds": [
              "1CO.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi neyi yakudya yikudimbwisha mana kwami, nukuleka kudya mbiji chikupu haya nyaka, nakenda kadimbwisha mana kwami.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.13",
            "verseOrgIds": [
              "1CO.8.13"
            ]
          }
        }
      ]
    }
  ],
