              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefu hakuyila ana kwindi niantaŋa jatata yindi, nindi, Nukuya nakamuleji Fwaro, nakamwili nami, Ana kwami nantaŋa jatata, adiŋi mwituŋa daKenani, anenzi dehi kunu kunidami. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.31",
            "verseOrgIds": [
              "GEN.46.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 46:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami, Wenawa amayala hiyatubiŋa, enjilila dehi kushakama nayimuna; anasendi ninyikoku yawunimpembi jawu, niŋombi jawu, niyuma yawu yejima. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.32",
            "verseOrgIds": [
              "GEN.46.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
