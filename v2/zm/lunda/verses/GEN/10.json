          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenawa diwu anyana kaShemi amayala, hayisaka yawu, hayisakayawu, mwahita nimadimi awu, mwahita nimpata jawu, mwekala ninyuza yawu.",
          "type": "text",
