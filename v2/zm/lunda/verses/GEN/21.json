              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichihenahana watumbiluhu ijina, nindi dihu haBerisheba, nanochu chasanyikiluwu mwayedi wawu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.31",
