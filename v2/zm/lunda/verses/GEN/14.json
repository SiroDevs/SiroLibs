  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "GEN 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyaka hadiŋi niAmirafweli mwanta wakuShinari, niAriyoki mwanta wakuElasari, niKedolawoma mwanta wakuElami, niTidali mwanta wakuGoyimi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.1",
            "verseOrgIds": [
              "GEN.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "hiyakudasa njita naBera mwanta wakuSodoma, naBirisha mwanta wakuGomora, naShinabi mwanta wakuAdima, naShemebi mwanta wakuZeboyimi, namwanta wakuBela diyi Zowari. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.2",
            "verseOrgIds": [
              "GEN.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenawa wejima wawu adibombeleli muchinekineki chakuSidimi, doduŋiya Damuŋwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.3",
            "verseOrgIds": [
              "GEN.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amulambwili Kedolawoma nyaka ikumi nayiyedi, hamwaka wekumi namuchisatu adikaŋili. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.4",
            "verseOrgIds": [
              "GEN.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaka wekumi namuchiwana Kedolawoma hakushika, nianyanta adibombeliyi nawu, hakutapani aRefwa muAsheteroti Karanayimi, niaZuzi muHami, niaEmi muShave Kiriyatayimi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.5",
            "verseOrgIds": [
              "GEN.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "niaHori kumpidi yawu yakuSeyiri, tapee nikuEliparani, kwakwihi nesaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.6",
            "verseOrgIds": [
              "GEN.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afunta nikufunta, ashika nikuEnimishipati, kwoku kuKadeshi, atapa niituŋa dejima dawaAmaleki, atapa niaAmori, ashakamini muHazazoni Tamari. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.7",
            "verseOrgIds": [
              "GEN.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimwanta wakuSodoma, nimwantawa kuGomora, nimwanta wakuAdima, nimwanta wakuZeboyimi, nimwanta wakuBela diwu Zowari, anyamuka nikunyamuka; ayitanjika ninyikankayanjita muchinekineki chakuSidimi; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.8",
            "verseOrgIds": [
              "GEN.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "njita yakudasa naKedola woma mwanta wakuElami, naTidali mwanta wakuGoyimi, naAmira fweli mwanta wakuShinari, naAriyoki mwanta wakuElasari; anyanta awanahiyakulwa nawanyanta atanu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.9",
            "verseOrgIds": [
              "GEN.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwila ochu chinekineki chakuSidimi chadiŋi chejima kwamachiŋi chiŋi hohu; anyanta akuSodoma nakuGomora hiyakutemuka, hiyakudimbukila kwenoku, anashali hiyakutemukila kumpidi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.10",
            "verseOrgIds": [
              "GEN.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apupa niyuma yejima yamuSodoma niya muGomora, niyakudya yawuyejima, hiyakudiyila kwawu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.11",
            "verseOrgIds": [
              "GEN.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwata niLoti mwana kamana kwaAbarama niyuma yindi, aya nikuya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.12",
            "verseOrgIds": [
              "GEN.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.12",
            "verseOrgIds": [
              "GEN.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwayili muntu wumu wapulukih, hakuya nakuleja Abarama kaHeberu; yena dinu wadiŋi nakushakama kunyikula yakaAmori Mamiri, mana kwaEshikoli, mana kwaAneri; wenawa adiŋi adikwata wubwambu naAbarama. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.13",
            "verseOrgIds": [
              "GEN.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarama chachitiyiliyi nawu mukwawu anamukwati, hakutwala antu indi amayala afundishayi dehi njita, avwalikili hamukala windi, amayala makulakaji asatu namayala ikumi natanu nasatu, hakuyilondela lufuchi nikuDani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.14",
            "verseOrgIds": [
              "GEN.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyena ni ambuŋindi adambwili nawufuku nakuyilotokela, ayitapa nikuyitapa, hiyakuyihaŋa hape-e nikuHoba, wekala hambadi yaDamakasa yachikasa chachimunswa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.15",
            "verseOrgIds": [
              "GEN.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waleteli cheŋi yuma yejima, waleteli cheŋi nimana kwindi Loti, niyuma yindi, niambanda niantu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.16",
            "verseOrgIds": [
              "GEN.14.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.16",
            "verseOrgIds": [
              "GEN.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wakuSodoma wayili nakumukinkilila chafuntiliyi kwayili yinakutapa niKedolawoma nawanyanta adiŋiyi nawu, kuchinekineki chakuShave, dichi chinekineki chaMwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.17",
            "verseOrgIds": [
              "GEN.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Melekizedeki mwanta wakuSalema wedishili nidinkendi nivinyu; yena diyi wadiŋi kapristu kaNzambi, Nzambi Wabadika Kwiwulu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.18",
            "verseOrgIds": [
              "GEN.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena wamukiswilili Abarama nkisu, nindi, Abarama amukiswili kudi Nzambi Wabadika Kwiwulu, diyi wahetani mawulu nimaseki; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.19",
            "verseOrgIds": [
              "GEN.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisu kisu Nzambi Wabadika Kwiwulu, nahanikudeyi akwankunyi neyi. Niyena wa ambwili yuma yejima mumaseka ikumi, wamwinkeluku iseka dimu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.20",
            "verseOrgIds": [
              "GEN.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wakuSodoma wamwilili Abarama, nindi, Nyinkami antu, hakwila eyi wutambuluku yuma. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.21",
            "verseOrgIds": [
              "GEN.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarama wamwilili mwanta wakuSodoma, nindi, Ami nololi chikasachami kwiwulu nenyiki kudi Yehova, diyi Nzambi Wabadika Kwiwulu, diyi waheta nimawulu nimaseki, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.22",
            "verseOrgIds": [
              "GEN.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "nami, Ami hinukutambula hela kawanda, hela kamwonji kakunkwabilu, hela kachuma keyi kamuku, wakandakela neyi, Ami yami namuhetesheli Abarama; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.23",
            "verseOrgIds": [
              "GEN.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "chiŋa yoyina yanaduwu anyikwenzi, niyakwinkahu amayala inayili nawu, wowu aAneri naEshikoli naMamiri, wena atambuli mwaka yanzaŋenawu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.24",
            "verseOrgIds": [
              "GEN.14.24"
            ]
          }
        }
      ]
    }
  ],
