      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chashikiliyi Abarama munyaka makumi atanu nawana nanyakayitanu nayiwana, Yehova wadi mwekesheli kudi Abarama, wamwililinindi, Ami yami Nzambi Chinaweji; endaku kumesu ami, ikalaŋawalala chikupu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.1",
            "verseOrgIds": [
              "GEN.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami nukutiyaŋana neyi, nakakuvulishila nankashi anyaneyi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.2",
            "verseOrgIds": [
              "GEN.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.2",
            "verseOrgIds": [
              "GEN.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarama wadinatili chamesu indi hamaseki; Nzambi wahoshelinindi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.3",
            "verseOrgIds": [
              "GEN.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindi, Tiya, ami kwami chitiyaŋenu chami chidi naneyi, eyiwakela nkakulula yamukanka wanyuza. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.4",
            "verseOrgIds": [
              "GEN.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijina deyi hiyakaditena cheŋi nawu Abaramaku, ilaŋa ijina deyi dakekala yeyi Abarahama; muloŋa nakwilishi dehi wunkaleulula wamukanka wanyuza. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.5",
            "verseOrgIds": [
              "GEN.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakakwilisha wunsemi nankashi, nakelisha nyuza kudeyi nianyanta akafuma kudeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.6",
            "verseOrgIds": [
              "GEN.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakakolesha chitiyaŋenu chami chinu kutiyaŋana naneyi, nawanya neyi akakulondela muyamba kavwalikilawu haya nyaka, kulonda kudeyi niikali Nzambi nikudi anyaneyi akalondelamu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.7",
            "verseOrgIds": [
              "GEN.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakakwinka eyi nianyaneyi akalondelamu ituŋa diwashakama, dodituŋa daKenani dejima, denudahaya nyaka, ninami nakekalaŋa Nzambi yawu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.8",
            "verseOrgIds": [
              "GEN.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.8",
            "verseOrgIds": [
              "GEN.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi hakumwila Abarahama, nindi, Eyi kweyi, muchitiyaŋenu china tiyaŋanami naneyi wakakakelamu, nineyi nianyaneyi akalondelamu mwejima muyamba kavwalikilawu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.9",
            "verseOrgIds": [
              "GEN.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiya chitiyaŋenu chami chimwakakakela, chiwukutiyaŋana ninami ninenu nianyaneyi akalondelamu; enuamayala ejima akayalamisha. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.10",
            "verseOrgIds": [
              "GEN.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akayalamisha nyivumbu yenu; chakekalachuma chakwilukisha nachu chitiyaŋenu chetu chitunatiyaŋani ninamininenu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.11",
            "verseOrgIds": [
              "GEN.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwinenu navwaliki dehi mafuku atanu nasatu akamwala misha, amayala ejima muyamba kavwalikilawu, hela wavwalika hamukala, helawakulanda namali naŋeji, mwabula kusemuka nawu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.12",
            "verseOrgIds": [
              "GEN.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela wakuvwalikaha mukala weyi, hela wakulanda namali eyi, chiŋa kumwalamisha hohu; chitiyaŋenu chami chikwikala kunyijimba yenu hichitiyaŋenu chahayanyaka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.13",
            "verseOrgIds": [
              "GEN.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yenowu chidima iyakabula kwalamishawu muvumbu windi, akamufumishi mudi antaŋa jindi; najahi dehi chitiyaŋenu chami.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.14",
            "verseOrgIds": [
              "GEN.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.14",
            "verseOrgIds": [
              "GEN.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi hakumwila Abarahama, nindi, Hakwila iŋodeyi Sarayi bayi wakamutena cheŋi ijina dindi neyi Sarayuku, ilaŋa ijina dindi dakekala diyiSara. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.15",
            "verseOrgIds": [
              "GEN.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukumukoolekesha, mwamweni nukukwinka mwana weyalanayena; mwalala nukumukoolekesha, wamba kekala nyuza yayeni; anyantaja wantu amba kafuma kudi yena. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.16",
            "verseOrgIds": [
              "GEN.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarahama wadinatili chamesu indi heseki, hakuseha, hakuhosha mumuchima windi, nindi, Muntu washika dehi munyaka nkulakaji amuvweli mwana? Sara niyena washika dehi munyaka makumi atanu namakumi awana avwali? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.17",
            "verseOrgIds": [
              "GEN.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarahama hakumwila Nzambi, nindi, Ishimeli ahandi mwani, kumesu eyi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.18",
            "verseOrgIds": [
              "GEN.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchinka Nzambi nindi, Nehi, iŋodeyi Sara diyi wakakuvwela mwaneyi weyala; wakanamutumba ijina dindi, neyi Isaka; nakamukoleshelayi, chitiyaŋenu. Beri Lahayi Royi chami chiikali chitiyaŋenu chahaya nyaka chawanya nindi akalondelamu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.19",
            "verseOrgIds": [
              "GEN.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hansaŋu yaIshimeli, nakutiyi dehi; tala namukiswili dehi nkisu, nakamwilisha nsemi, nakamuvulishila anyana chacheni chabadika; wakavwala atulamba ikumi nayedi, nakamwilisha muza weneni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.20",
            "verseOrgIds": [
              "GEN.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa chitiyaŋenu chami nakamukoleshelayi Isaka, yowu Isaka akakuvwela wukudi Sara mwaka wakenzaku kafwampi hakakweji kokenoku. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.21",
            "verseOrgIds": [
              "GEN.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yokumisha nikukumisha kuhosha nindi, Nzambi yofuma kudi Abarahama.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.22",
            "verseOrgIds": [
              "GEN.17.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.22",
            "verseOrgIds": [
              "GEN.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarahama hakutambula nimwanindi Ishimeli, niejima avwalikiliha mukala windi, niejima akulanda namali indi, yotambula amayala ahamukala waAbarahama ejima hakuyalamisha nyivumbu yawu ifuku dawudimu, mwomwa mwililiyi Nzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.23",
            "verseOrgIds": [
              "GEN.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarahama washi kili munya kamakumi atanu nawana nanyaka yitanu nayiwana hamwala mishiluwu muvumbu windi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.24",
            "verseOrgIds": [
              "GEN.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishimeli mwanindi wadiŋi wanyaka ikumi nayisatuha mwalamishiluwu muvumbu windi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.25",
            "verseOrgIds": [
              "GEN.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "NiAbarahama nimwanindi Ishimeli ayalamishili ifuku dawu dimu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.26",
            "verseOrgIds": [
              "GEN.17.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amayala ejima ahamukala windi, niavwalikili hamukala, niakulanda namali nawapeji, ayalamishili hamunindi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.27",
            "verseOrgIds": [
              "GEN.17.27"
            ]
          }
        }
      ]
    }
  ],
