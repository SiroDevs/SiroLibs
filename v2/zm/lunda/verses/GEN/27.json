  "verseCount": 46,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
        "style": "c",
        "sid": "GEN 27"
      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cheliliyi Isaka nakuli dehi, mesu indi aneli dehi mbundu, nakapanyi kumona, hakutambika wedi windi Esawu, hakumwila nindi, Mwanami. Yena nindi, Vude. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.1",
            "verseOrgIds": [
              "GEN.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindi, Tala ntahi, ami nela dehi kashinakaji, hineluki kwami itaŋwa dinakafwaku. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.2",
            "verseOrgIds": [
              "GEN.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu, nonaku mwaniyitwa yeyi yiwazombaŋa nachu, mungongu weyi wanyivu, niwuta weyi, wuyi mumpata wunjahili mbiji; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.3",
            "verseOrgIds": [
              "GEN.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakantelekeli mbiji yikweti lupwembuyi na keŋa, wakanleteli nakadyi, kulonda nakakukiswili nkisu yamumuchima wami hohanu nichidi kanda nifwi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.4",
            "verseOrgIds": [
              "GEN.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.4",
            "verseOrgIds": [
              "GEN.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rebeka wachitiyili chahosheliyi Isaka namwanindi Esawu. Esawuhakuya mwisapa nakuzomba, akajahi mbiji, akaleti. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.5",
            "verseOrgIds": [
              "GEN.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rebeka wahoshelina mwanindi Yakoba, nindi, Tiya dinu, ami namutiyi tata yeyi nahoshinamana kweyi Esawu; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.6",
            "verseOrgIds": [
              "GEN.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "namuleji nindi, Kanleteli mbiji yamwisaŋa, wakantelekeli mbiji yikweti lupwembu, kulonda nakadyi, nakakukiswilinkisu kumesu aYehova hohanu nichidi kanda nifwi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.7",
            "verseOrgIds": [
              "GEN.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu, eyimwanami, ovwahilaku mwizu dami mwejima munukukuleja. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.8",
            "verseOrgIds": [
              "GEN.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaku dinukwiyinda wakankwatiluku twana twampembi tuyedi twatuwahi, nakamutelekelitata yeyi mbiji yikweti lupwembu, yakeŋayi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.9",
            "verseOrgIds": [
              "GEN.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakayitwala kuditata yeyi, kulonda akadyi, akakukiswili nkisu hohanu kanda afwi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.10",
            "verseOrgIds": [
              "GEN.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.10",
            "verseOrgIds": [
              "GEN.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba hakumwila mama yindi Rebeka, nindi, Mana kwami Esawu himuntu wawutambu, hakwila ami nimuntu wasenena wakadi wuvuji. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.11",
            "verseOrgIds": [
              "GEN.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamba kela tata wakankwatakwata nakuntiya, yena wakanmona neyinimukwakudimbana, nakadikojeja kwakunshipa honu, nikunkiswila hakunkiswilaku. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.12",
            "verseOrgIds": [
              "GEN.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mama yindi hakumwila nindi, Neyi akukushiŋa, mashiŋu akela amami, mwanami; kumina dakutiya mwizu dami, yaŋa kankwatiliyi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.13",
            "verseOrgIds": [
              "GEN.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayili nakuyikwata. Wayileteli kudi mama yindi. Mama yindi watelekeli mbiji yikweti lupwembu, yakeŋeliyi tata yindi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.14",
            "verseOrgIds": [
              "GEN.27.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.14",
            "verseOrgIds": [
              "GEN.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rebeka wanoneni mahina amawahi awedi windi Esawu adiŋiyi nawumwitala, wamuvwikili mwanindi wakansi Yakoba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.15",
            "verseOrgIds": [
              "GEN.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Washili yitembi yawanyana kampembi nihamakasindi, nihanshiŋu yindi hana hakadi wuvuji. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.16",
            "verseOrgIds": [
              "GEN.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamwinkeli mwanindi Yakoba muchikasa chindi nimbiji yikweti lupwembu nidinkendi dehliyi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.17",
            "verseOrgIds": [
              "GEN.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyena hakuya kudi tata yindi, nindi, Tata. Yena nindi, Yamonu; yeyinyi mwanami? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.18",
            "verseOrgIds": [
              "GEN.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba hakumwilatata yindi, nindi, Yami wedi weyi Esawu; nela dehi muwunanleji. Ahinduki mwani, ashakami adiyi mbiji yami yamwisapa, ankiswili nkisu yamu muchima weyi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.19",
            "verseOrgIds": [
              "GEN.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka hakumwila mwanindi, nindi, Wunayiwani ŋahi kachawichi, mwanami? Yena nindi, Muloŋa Yehova, Nzambi yeyi, diyi waŋendesha chachiwahi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.20",
            "verseOrgIds": [
              "GEN.27.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.20",
            "verseOrgIds": [
              "GEN.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka hakumwila Yakoba, nindi, Swilaku kwakwihimwanami, niku kwatakwati nikutiyi, niiluki neyi chalala wumwanami Esawu, tahindi nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.21",
            "verseOrgIds": [
              "GEN.27.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba hakuswila kwakwihi natata yindi Isaka; yena hakumu kwatakwatana kumutiya, nindi, Izu dinu hiizu daYakoba, kwinza makasa himakasa aEsawu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.22",
            "verseOrgIds": [
              "GEN.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamwilukiluku, muloŋa makasindi adiŋi awuvuji neyichadiŋuwu makasa amana kwindi Esawu. Nochu wamukiswilili nkisu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.23",
            "verseOrgIds": [
              "GEN.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindi, Eyi chalala yeyi mwanami Esawu? Yena nindi, Yami. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.24",
            "verseOrgIds": [
              "GEN.27.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 27:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindi, Yileti kunu kwakwihi, kulonda nidyi mbiji yamwanami, kulonda nikukiswilinkisu yamumuchima wami. Wamu tweleleliyi kwakwihi, wadiili; wamutweleleli nivinyu, wanwini.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.25",
            "verseOrgIds": [
              "GEN.27.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 27:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.25",
            "verseOrgIds": [
              "GEN.27.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tata yindi Isaka hakumwila nindi, Swilaku dinu kwakwihi wumpwepuli, mwanami. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.26",
            "verseOrgIds": [
              "GEN.27.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamwilili kwakwihi, wamupwepwili. Watiyili ivumba damahinindi, wamukiswilili nkisu, nindi, Talenu, ivumba damwanami didineyi ivumba dampata yanakiswililiyi Yehova nkisu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.27",
            "verseOrgIds": [
              "GEN.27.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 27:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi akwinkaŋa wuumi wamwiwulu, nimpata jamwekana manji, akuvulishili nitidiku nivinyu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.28",
            "verseOrgIds": [
              "GEN.27.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu amavulu akukalakeli, ninyuza yawantu akubandamini. Ikalaku mwanta wawana kweyi, nianyana kamama yeyi akufukamini. Yowu wukukushiŋeyi niyena amushiŋi, yowu wukukukiswileyi nkisu niyeni amukiswili nkisu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.29",
            "verseOrgIds": [
              "GEN.27.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.29",
            "verseOrgIds": [
              "GEN.27.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 27:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cheliliyi Isaka hohakukumisha kumukiswila Yakoba nkisu, niYakoboni yena mwomu kufuma mwadiŋiyi tata yindi Isaka, mana kwindi Esawu hakwinza kwayiliyi nakuzomba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.30",
            "verseOrgIds": [
              "GEN.27.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 27:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyena watelekeli mbiji yikweti lupwembu, wayitweli mwadi niyi tata yindi; wamwilili tata yindi nindi, Tata ahinduki mwani, adiyi mbiji yamwaneyi, kulonda muchima weyi wunkiswilinkisu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.31",
            "verseOrgIds": [
              "GEN.27.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 27:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tata yindi Isaka hakumwila nindi, Yeyinyi? Yena nindi, Yamimwa neyi, yami wedi weyi Esawu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.32",
            "verseOrgIds": [
              "GEN.27.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 27:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka hakuzaala nikuzaala nankashi chakubadika, nindi, Indi owu wajaha mbiji nakunletela, ninami nayidyi dehi yejima to-o eyi kanda winzi, namukiswila dehi ninkisu, wadi ŋinyi? Chalala niyena diyi wakakooleka chi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.33",
            "verseOrgIds": [
              "GEN.27.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 27:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esawu chatiyayi mazu atata yindiyodila ikumbu dadeni dasweja niwushona nankashi, hakumwila tata yindi, nindi, Nkiswili nkisu ninami nawa, eyi tata. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.34",
            "verseOrgIds": [
              "GEN.27.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 27:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindi, mana kweyi wenza dehi nakudimbana, watambula dehi nkisu yeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.35",
            "verseOrgIds": [
              "GEN.27.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 27:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena nindi, Komana chalala dichi chanamutu mbililuwu ijina daYakoba, muloŋa naŋamuki dehi aka kayedi aka; wantambwili wuawakulumpi wami, ichi dinu nantambuli dehi ninkisu yami. Nindi, Hiwunanswekeluku nkisu yamuku? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.36",
            "verseOrgIds": [
              "GEN.27.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 27:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka wamwakwili Esawu, nindi, Namwilislii dehi himwanta weyi, niana kwindi ejima namwinkuwu akeli aŋamba jindi; namuhandishi dehi natidiku navinyu; ndochu dinu eyi nukukwililadi, mwanami? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.37",
            "verseOrgIds": [
              "GEN.27.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 27:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esawu wamwililitata yindi, nindi, Wukweti nkisu yimu hohu bweŋi, tata? Nkiswilinkisu ninami nawa, eyi tata yami. Esawu hakutwa ikumbu dakudila.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.38",
            "verseOrgIds": [
              "GEN.27.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 27:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.38",
            "verseOrgIds": [
              "GEN.27.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "GEN 27:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tata yindi Isaka wamwakwili nindi, Tiya, kumpata jamwekana manji diku kuwakashakama, nikudi wuumi wamwiwulu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.39",
            "verseOrgIds": [
              "GEN.27.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "GEN 27:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakahandila mpokuyeyi yakabali, wakamukala kelaŋa mana kweyi. Chakekala chiwaka dipukumuna wakasahula mpanda yindi kunshiŋu yeyi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.40",
            "verseOrgIds": [
              "GEN.27.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "GEN 27:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.40",
            "verseOrgIds": [
              "GEN.27.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "GEN 27:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esawu wamuheleli Yakoba nanoyu nkisu yamukiswililiyi tata yindi. Esawu wahosheli mumuchima windi, nindi, Mafuku akudila tata adikwakwihi, henohu dihu nakamujaha mana kwami Yakoba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.41",
            "verseOrgIds": [
              "GEN.27.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "GEN 27:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amulejeli Rebeka mazu awedi windi Esawu; niyena hakutemesha nakutambi kamwa nindi wakansi Yakoba, hakumwila nindi, Tiyaku, mana kweyi Esawu hansaŋu yeyi hakudikundeja mumuchima windi nindi wakakujaha. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.42",
            "verseOrgIds": [
              "GEN.27.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "GEN 27:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu, eyi mwanami, ovwahilaku mwizu dami; nyamukaku, wutemukili kuHarana kudi mana kwami Labani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.43",
            "verseOrgIds": [
              "GEN.27.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "GEN 27:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakashakami nindi mafuku antesha, nichi yakakuma ndombu yamana kweyi; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.44",
            "verseOrgIds": [
              "GEN.27.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "GEN 27:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "chikwakakuma kuzuwa kwamana kweyi, chakavulame nayi chiwunamwili, nakakutumeshela kaŋanda akakuleti cheŋi akumbondeladi wejima wenu ayedi ifuku denudimu?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.45",
            "verseOrgIds": [
              "GEN.27.45"
            ]
          }
        }
      ]
    },
