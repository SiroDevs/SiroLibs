          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hushami wafwili, Hadadi mwana kaBedadi, yowona watapili Midiyani mumpata yaMowabi, wadiili wanta windi, mukala windi ijina dawu dadiŋi Aviti. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.35",
            "verseOrgIds": [
              "GEN.36.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
