              "type": "text"
            }
          ]
        },
        {
          "text": "kalamba Kenazi, kalamba Temani, kalamba Mibizari, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.42",
            "verseOrgIds": [
              "GEN.36.42"
            ]
          }
        },
        {
