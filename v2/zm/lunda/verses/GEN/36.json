            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "kalamba Oholibama, kalamba Ela, kalamba Pinoni, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.41",
            "verseOrgIds": [
              "GEN.36.41"
            ]
