          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hadadi wafwili, Samala wakuMasereka wadiili wanta windi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.36",
            "verseOrgIds": [
              "GEN.36.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 36:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samala wafwili, Shawulu wakuRehoboti kwakwihi naKaloŋa wadiiliwanta windi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.37",
            "verseOrgIds": [
              "GEN.36.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 36:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shawulu wafwili, Bayali Hanani mwana kaAkibori wadiili wanta windi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.38",
            "verseOrgIds": [
              "GEN.36.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "GEN 36:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayali Hanani mwana kaAkibori wafwili, Hadari wadiili wanta windi, mukala windi ijina dawu dadiŋi Pawu. Ijina daŋodindi dadiŋi Mehetabeli, mwana kaMateredi wamumbanda, mwana kaMezahabi wamumbanda.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.39",
            "verseOrgIds": [
              "GEN.36.39"
            ]
          }
        }
