          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "chakamonayikansi kwosi, wakafwa, ninetu ambuŋeyi twakashiko invu jakambuŋeyi tata yetu kukaluŋa nayihuŋu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.31",
            "verseOrgIds": [
              "GEN.44.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
