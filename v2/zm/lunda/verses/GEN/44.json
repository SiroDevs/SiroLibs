              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinuchitwakashika kudi kambuŋeyi tata yami chakadi kansi, chaneliyi muchima windi wunadikasili hamu namuchima wakansi mbe; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.30",
            "verseOrgIds": [
              "GEN.44.30"
            ]
          }
        },
        {
          "name": "verse",
