          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indi ami nukuya ŋahi kudi tata yami chakadi kansi? Nakenda kamona kutama kwakamonayi tata.",
          "type": "text",
