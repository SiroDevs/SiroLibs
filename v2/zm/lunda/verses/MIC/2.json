          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.11",
            "verseOrgIds": [
              "MIC.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MIC 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu akwaYakoba, chalala nakayipompesha wejima wenu; chalala nakakumaŋeja aIsarela anashaluku; nakayisha hamu neyi nyikoku yakuBozira; neyi mukanka wanyikoku wudi mukachi kawudiilu wawu, akasweja muyoyu muloŋa wawantu kuvula. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.12",
            "verseOrgIds": [
              "MIC.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MIC 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukwakulokola ipana nayi dehi kumbidi yawu. Alokola dehi ipana, anahiti dehi nikuchisu champwembu, diku kwanedikiluwu. Mwanta wawu nayi dehi kumbidi yawu, niYehova natwaminuku kumbidi.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.13",
            "verseOrgIds": [
              "MIC.2.13"
            ]
          }
        }
      ]
    }
