  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "1SA 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amulejeli Davidi, nawu, Tala, aFwilistinu adi nakulwa naKeila, hiyakubuwa kuwuhulilu watidiku. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.1",
            "verseOrgIds": [
              "1SA.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakwihula kudi Yehova nindi, Awa aFwilistinu niyi nakayitapi, tahindi? Yehova hakumwila Davidi, nindi, Yaku wakayitapi aFwilistinu, wakaamwini Keila.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.2",
            "verseOrgIds": [
              "1SA.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.3",
            "verseOrgIds": [
              "1SA.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakwihula kudi Yehova cheŋi nawa. Yehova hakumwakulanindi, Nyamukaku, wukunkumuki kuKeila, muloŋa aFwilistinu nakayihanakudeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.4",
            "verseOrgIds": [
              "1SA.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi nawantu indi hiyakuya kuKeila, hiyakulwa nawaFwilistinu, hiyakukwata niŋombi jawu, hiyakuyitapa nankashi. Davidi hakwamwineni Keila.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.5",
            "verseOrgIds": [
              "1SA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.5",
            "verseOrgIds": [
              "1SA.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chatemukiliyi mwana kaAhimeleki Abiyatari hakuya kuKeila kudi Davidi, wasendeli ifwodi muchikasa chindi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.6",
            "verseOrgIds": [
              "1SA.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amulejeli Sawulu, nawu, Davidi nayi kuKeila. Sawulu nindi, Nzambi namuhani dehi kudami, muŋa chanepiliyi dehi mumukala wukweti yenzelu nanyikomenu, anamwenzelumu dehi kwindi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.7",
            "verseOrgIds": [
              "1SA.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulu hakufumba antu ejima ayi nawu kunjitakulonda akunkumuki kuKeila, akamukuchiki Davidi hamu nawantu indi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.8",
            "verseOrgIds": [
              "1SA.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.13",
            "verseOrgIds": [
              "1SA.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi washakamini mwisaŋa muyipaka, washakamini mumpata yamapidi yamwisapa daZifwi, Sawulu wamukeŋakeŋelaŋa hefuku hefuku, ilaŋa Nzambi hamuheni kudi yenaku.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.14",
            "verseOrgIds": [
              "1SA.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.14",
            "verseOrgIds": [
              "1SA.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi wamweni nindi, Komana Sawulu nenzi dehi nakunkeŋakeŋa anjahi. Davidi wadiŋi mwisaŋa daZifwi mumahumbu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.15",
            "verseOrgIds": [
              "1SA.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana ka-Sawulu Jonatani hakunyamuka, hakuya kudi Davidi mumahumbu, hakumu kolesha mudi Nzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.16",
            "verseOrgIds": [
              "1SA.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakumwila nindi, Bayi wutiya womaku, muloŋa tata yami Sawulu hakakuwanaku, eyi wakekala mwanta waIsarela, ami nakakukuma munyima, nitata yami Sawulu nelukumu tuhu kwindi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.17",
            "verseOrgIds": [
              "1SA.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.18",
            "verseOrgIds": [
              "1SA.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "AkwaZifwi hiyakwinza kuGibeya kudi Sawulu, hiyakwila nawu, Davidi hanabatami kudetu muyipaka yamumahumbu akumpidi yaHakila muchibaba chakukabeta kakuchidiiluku? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.19",
            "verseOrgIds": [
              "1SA.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu, eyi mwanta, mwejima mwakeŋa ela muchima weyi kwinza inzaŋa. Etu mudimu wetu wowuwakumukwatisha kudi mwanta hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.20",
            "verseOrgIds": [
              "1SA.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulu hakuyila nindi, Ayikiswilinkisu kudi Yehova, nanichi chimunantiyili wushona. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.21",
            "verseOrgIds": [
              "1SA.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yenu mwaka shinshiki chalala mwani, mwakeluki chachiwahi, mwakamoni hanabatamiyi, nimuntu namumoni kwenoku namesu, muloŋa ananleji nawuwasweja kubabala. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.22",
            "verseOrgIds": [
              "1SA.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katalatalenu mwakeluki chachiwahi hindi habatajala ŋayihejima, kulonda mwakafunti cheŋi kudami, mwakanleji chakumonajiika hachikupu, kulonda nakayi nenu. Mona neyi wudi mwituŋa nakamukeŋakeŋa mwekalila makombakaji amuYuda ejima. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.23",
            "verseOrgIds": [
              "1SA.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakunya mukahi yakuya pahu dehi kuZifwi, Sawulu hakushala.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.24",
            "verseOrgIds": [
              "1SA.23.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi nawantu indi adiŋi kwawu mwisaŋa dakuMawoni muchana, kuchibaba chakukabeta kakuchidiilu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.24",
            "verseOrgIds": [
              "1SA.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulu nawantu indi hiyakuya nakumukeŋakeŋa. Hiyakumulejamu Davidi, hakukunkumuka kwilola, hakushakama mwisaŋa dakuMawoni. Chachitiyiliyi Sawulu hakumulondela lufuchi mwisaŋa dakuMawoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.25",
            "verseOrgIds": [
              "1SA.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakwila Sawulu hakuya ishinadidampidi hanidi, Davidi hakuya ishinadi dampidi hana di kwawu, Davidi hakunyakala kufumaku nawoma wamutiyiliyi Sawulu, muŋa Sawulu nawantu indi amutanda minini Davidi nawantu indi kwi-ndo, nawu ayikwati.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.26",
            "verseOrgIds": [
              "1SA.23.26"
            ]
          }
        }
      ]
    }
  ],
