  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "1SA 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakutemuka kuNayoti muRama, hakuya nakuhosha kumesu ajonatani, nindi, Neli ŋahi? Naluwidi? Tata yeyi namuvulumuni muloŋa wanka, mwaka afwili kunjaha? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.20.1",
            "verseOrgIds": [
              "1SA.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakumwila nindi, Ochu chinjila, eyi hiwukufwaku, tiya, tata yami helaŋa hela chuma cheneni, hela kachuma kanyanya chakadi kunlejamuku, indi tata wukunjindila dichumichi? Hidimuku. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.20.2",
            "verseOrgIds": [
              "1SA.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakusanyika, hakwila nindi, Tata yeyi neluki chachiwahi chinawanami wuselewa kudeyi, dihu hanafumi kwilanindi Jonatani bayi achilukaku, wakenda katiya chikela, chalala chahandayi Yehova kwaamu, nichahanda wumi weyi kwaamu, ami hanashali hanti hohunakufwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.20.3",
            "verseOrgIds": [
              "1SA.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonatani hakumwila Davidi nindi, Nukukwilila mwejima munakeŋi muchima weyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.20.4",
            "verseOrgIds": [
              "1SA.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakumwila Jonatani, nindi, Tala, kumadiki kakweji kakaaluka, kinelaŋa chiŋa nishakama namwanta nakudya. Nlekiniyi nakabatami mumpata batame-e nikumelela amwifuku damu chisatu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.20.5",
            "verseOrgIds": [
              "1SA.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi tata yeyi wakantonda, wakelaŋa neyi, Davidi wanlombeli nankashinindi, Ŋitŋi niyi lufuchi kumukala wetu kuBetelemi, nindi, Muloŋa hanudihu haketulaŋawu chimuna chahamwaka chachisaka chetu chejima. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.20.6",
            "verseOrgIds": [
              "1SA.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi wakahosha nindi, Chachiwahi, komana ami kambuŋeyi nakamonakuwunda, Ilaŋa neyi wakazuwa wakeluka neyi nafuukuli dehi mwatama.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.20.7",
            "verseOrgIds": [
              "1SA.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.20.12",
            "verseOrgIds": [
              "1SA.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi tata yami wakakeŋa kukwila mwatamaami nibula kukulejamu kulonda kukutemesha kwacheŋi, wakayichachiwahi chamwena zo-o, Yehova akamwili Jonatani mwomumu nichakubadikamu, Yehova akekali naneyi neyi chadiŋilaŋayi natata yami. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.20.13",
            "verseOrgIds": [
              "1SA.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi wukumina dakuŋila luwi lwaYehova hinichidi wamumi neyi nibuli kufwakunehi, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.20.14",
            "verseOrgIds": [
              "1SA.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "luwi lweyi chiŋa wakalutiyilaŋa nimutaŋa wami haya nyaka kulukumishanehi, eŋa hela hamba kanoŋeshayi Yehova ayilumbu jaDavidi ejima hanu heseki. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.20.15",
            "verseOrgIds": [
              "1SA.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dimu mwatiyaŋeniyi Jonatani namutaŋa waDavidi, ela nikwila nindi, Yehova akatendi Davidi hadi ayilumbu jindi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.20.16",
            "verseOrgIds": [
              "1SA.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonatani hakumusanyikisha cheŋi Davidi nanochu chamukeŋeliyi, muloŋa wamukeŋelineyi chakeŋeliyi wumi windi yomweni.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.20.17",
            "verseOrgIds": [
              "1SA.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.20.17",
            "verseOrgIds": [
              "1SA.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonatani hakumwila nindi, Kumadiki kakweji kacheŋi kakaaluka, akakutonda, muloŋa muchididi cheyi mwakekala mwamukunkulwayi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.20.18",
            "verseOrgIds": [
              "1SA.20.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.20.23",
            "verseOrgIds": [
              "1SA.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Davidi wabatamini mumpata. Chaalukili kakweji kacheŋi mwanta hakushakama nakudya. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.20.24",
            "verseOrgIds": [
              "1SA.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta washakamini muchididi chindineyi chelilaŋayi dikalu, chochididi chakuma kumbaŋu. Jonatani onyamukani kunyamuka, Abineri hakushakama kumbadi yaSawulu, mwaDavidi mwadiŋi mwamukunkulwayi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.20.25",
            "verseOrgIds": [
              "1SA.20.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.20.25",
            "verseOrgIds": [
              "1SA.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Denodu ifuku Sawulu hahosheli chumaku, welili nindi, Kudi chuma chinamuwani, hanadiŋilikuku, chalala hanadiŋiliku ku. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.20.26",
            "verseOrgIds": [
              "1SA.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chikunachi hefukuda muchiyedi dakakweji kakaha mwaDavidi saŋa mudi mwamukunkulwayi. Sawulu hakumwila mwanindi Jonatani, nindi, Mwana kajesi nalekelidikwinza nakudya hela haloshi hela lelu? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.20.27",
            "verseOrgIds": [
              "1SA.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonatani hakumwakula Sawulu, nindi, Davidi walombeli nankashi nindi nimwitŋi ayi kuBetelemi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.20.28",
            "verseOrgIds": [
              "1SA.20.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Welilinindi, Nleki niyi mwani, muloŋa chisaka chetu chinaketuli dehi chimunakumukala, nimana kwami nantambiki dehi, neyi wunantoŋuhu, nleki mwani, niyi nakatali ana kwami. Dichi chanabuliliyi kwinza kumesa yamwanta.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.20.29",
            "verseOrgIds": [
              "1SA.20.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.20.29",
            "verseOrgIds": [
              "1SA.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1SA 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulu hakuzuwa najonatani, hakumwila nindi, Eyi mwana kamumbanda watama wadikaŋa, ochu ami nabuli kwiluka chiwunamutondi dehi mwana kajesi, kulonda akutiyishi eyi aweni nsonyi, atiyishili nawa kumuninsonyi yeheŋu damama yeyi? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.20.30",
            "verseOrgIds": [
              "1SA.20.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1SA 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwejima mwakahandilaŋayi mwana kaJesi hanu heseki, eyi hiwakakolaku, hela wanta weyi hiwakakolaku. Dichi dinu temeshaku wumuleti kudami, afwi hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.20.31",
            "verseOrgIds": [
              "1SA.20.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1SA 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonatani hakumwakulatata yindi Sawulu, hakumwila nindi, Akumujahiladi? Neli ŋahi? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.20.32",
            "verseOrgIds": [
              "1SA.20.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1SA 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulu hakumwasa iyoŋa nindi amutapi. Jonatani eluka nikwiluka nindi komana tata nakeŋi dehi kumujaha Davidi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.20.33",
            "verseOrgIds": [
              "1SA.20.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1SA 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonatani hakunyamuka kumesa chakuzuwa nankashi, denodu ifuku dakakweji damuchiyedi odu hadiili yakudyaku, muloŋa natiyi dehi chikela nansaŋu yaDavidi, nanochu chanamutiyishuwu dehi nsonyi kudi tata yindi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.20.34",
            "verseOrgIds": [
              "1SA.20.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1SA 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.20.34",
            "verseOrgIds": [
              "1SA.20.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1SA 20:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chikunachi budidi Jonatani hakuya mumpata nikansi kindi hohadikaniniyi naDavidi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.20.35",
            "verseOrgIds": [
              "1SA.20.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1SA 20:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakumwila owu kansi nindi, Yaku lufuchi, wunoninyivu yinukwasa. Chelili kansi hakuya lufuchi, aasa nimuvu wakumumotwesha. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.20.36",
            "verseOrgIds": [
              "1SA.20.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1SA 20:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chaneliyi kansi nindi ayaŋa nakushika kudi muvu waasiliyi Jonatani, Jonatani hakumubidika kansi, nindi, Muvu hiwudi kumbiduku? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.20.37",
            "verseOrgIds": [
              "1SA.20.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1SA 20:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonatani hakumubidika cheŋi kansi nindi, Temukaku lufuchi, nyakalaŋaa, bayi wulabajalaku. Kansi kajonatani kapompesha ninyivu, kenza nikudimwanta windi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.20.38",
            "verseOrgIds": [
              "1SA.20.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1SA 20:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kansi kwiluka chuma nehi, hinsanu yakwiluka ajonatani naDavidi hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.20.39",
            "verseOrgIds": [
              "1SA.20.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1SA 20:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonatani hakumwinka kansi yitwa yindi, hakumwila nindi, Yaku, yitwali kumukala. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.20.40",
            "verseOrgIds": [
              "1SA.20.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1SA 20:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chaneliyi kansi nayi dehi, Davidi hakunyamuka kukabeta kakuchidiilu kwadiŋiyi, hakudimbukila chamesu indi hamaseki, hakubandama mapampa kasatu, hiyakudipwepujola, hiyakudililahamu, dile-e, Davidi yosweja nikusweja. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.20.41",
            "verseOrgIds": [
              "1SA.20.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1SA 20:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonatani hakumwila Davidi, nindi, Yaŋa kweyi chachiwahi, muloŋa tunasanyiki dehi ijina daYehova wejima wetu, netu Yehova ekali mukachi ketu nanami naneyi, nimukachi kawanyanetu niamami nieyeyi haya nyaka. Hakunyamuka, hakuya, Jonatani niyena nawa hakwijila mumukala.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.20.42",
            "verseOrgIds": [
              "1SA.20.42"
            ]
          }
        }
      ]
    }
