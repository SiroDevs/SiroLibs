          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi yonyamuka nikunyamuka, hakutemuka dodena ifuku odu, namutiyi dehi Sawulu woma, hakuya kudi Akisha mwanta wakuGati.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.10",
            "verseOrgIds": [
              "1SA.21.10"
            ]
          }
        }
