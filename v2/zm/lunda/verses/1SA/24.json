      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cheliliyi Sawulu nafunti dehi kwayiliyi nakulondela aFwilistinu, hiyakumuleja nawu, Tiya, Davidi hadi mwisaŋa dakuEngedi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.1",
            "verseOrgIds": [
              "1SA.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.7",
            "verseOrgIds": [
              "1SA.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkumininaku Davidi niyena nawa hakunyamuka, hakwidika mwiyeŋu, hakumubidika Sawulu mwakuyayi, nindi, Nkaka yami mwanta. Chataliliyi Sawulu hanyima, Davidi hakubandama chamesu hamaseki, hakudifukula.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.8",
            "verseOrgIds": [
              "1SA.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.15",
            "verseOrgIds": [
              "1SA.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chelili Davidi nakumishi dehi kuhosha mazu awa naSawulu, Sawulu hakwila nindi, Idi izu hiizu deyeyi mwanami Davidi tahindi? Sawulu hakudila niikumbu dadeni. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.16",
            "verseOrgIds": [
              "1SA.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakumwila Davidi, nindi, Eyi wunambadi kami kuloŋa, muŋa eyi wunaŋili mwamuwahi hohu, kwinza ami nakukoŋi mwatama. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.17",
            "verseOrgIds": [
              "1SA.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nineyi aweni wunanshi mwinumu dehi chiwunaŋili chachiwahi, ochu chiwela Yehova anhani kudeyi eyi kunjaha nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.18",
            "verseOrgIds": [
              "1SA.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu awani chilumbu chindi, amuleki ayi tuhu? Yehova akufweti yayiwahi nanichi chiwunaŋili lelu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.19",
            "verseOrgIds": [
              "1SA.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi dinu tiya, ami neluki dehi chalala namiyeyi wakekala mwanta, niwanta wawaIsarela wakakolela kudeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.20",
            "verseOrgIds": [
              "1SA.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichidinu nsanyikili Yehova neyi, Hina kakujilu mwina anyaneyi akakulondela munyi maku. Neyi, Hinakajiyisha ijina deyi kumutaŋa watata yeyuku.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.21",
            "verseOrgIds": [
              "1SA.24.21"
            ]
          }
        }
      ]
    }
  ],
