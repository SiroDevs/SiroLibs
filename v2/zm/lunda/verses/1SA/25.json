          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.42",
            "verseOrgIds": [
              "1SA.25.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1SA 25:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakusumbula nawa niAhinowami wakuYezereyeli, hiyakwikala aŋodi jindi mwayedi wawu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.43",
            "verseOrgIds": [
              "1SA.25.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1SA 25:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwila iŋoda Davidi Mikali, mwana ka-Sawulu, henohu Sawulu wamwinkayi dehi Paliti mwana kaLayishi, wakuGalimi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.44",
            "verseOrgIds": [
              "1SA.25.44"
            ]
          }
        }
      ]
