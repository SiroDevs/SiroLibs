  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "1SA 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cheliluwu Davidi nawantu indi anashiki dehi kuZikilaŋi hefuku damuchisatu, hiyakuwana aAmaleki analukuki dehi mpata yakukabeta kakuchidiilu naZikilaŋi, anatapi delii Zikilaŋi, anawochi dehi ni kesi, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.1",
            "verseOrgIds": [
              "1SA.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "anakwati dehi niambanda adiŋumu niantu ejima, niatwansi niakulumpi, hosi ajahiluwuku, akuminini dakuya nawu hohu, hiyakudiyila. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.2",
            "verseOrgIds": [
              "1SA.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi niantu indi chanashikuwu kumukala kuwana anawochi dehi kesi, ni aŋodi jawu, ni anyanawu amayala, nawambanda, anayikwati dehi hiyankoli, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.3",
            "verseOrgIds": [
              "1SA.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi niantu adiŋiyi nawu, avwakuka nikudila dile-e, jiyikuma nikuyikuma nijakudila. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.4",
            "verseOrgIds": [
              "1SA.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni aŋodi jaDavidi ejima ayedi ayikwatili nawa niwena, iwu yowu Ahinowami wakuYezereyeli, iwu yowu Abigayili wadiŋi iŋodaNabali wakuKarameli. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.5",
            "verseOrgIds": [
              "1SA.30.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hamweni nawa mwakwilaku, niantuhiyakwila nawu amujahi namalola, muloŋ antu ejima atiyili kunyichimabwi, nakwakama anyanawu amayala nawambanda, ilaŋa Davidi hakudikoleshela mudi Yehova Nzambi yindi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.6",
            "verseOrgIds": [
              "1SA.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.6",
            "verseOrgIds": [
              "1SA.30.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakumwila kapristu Abiyatari, mwana kaAhimeleki, nindi, Aleti mwani ifwodi kunu. Abiyatari hakuleta ifwodi kwadiŋiyi Davidi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.7",
            "verseOrgIds": [
              "1SA.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.10",
            "verseOrgIds": [
              "1SA.30.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakuwana kaEjipitu mumpata, hiyakumuleta kudi Davidi hiyakumwinka ya kudya, adya nikudya, hiyakumwinka meji akunwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.11",
            "verseOrgIds": [
              "1SA.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amwinka nichibalu chadinkendi dachikuyu chakudima, ninyikanji yavinyu yawumayiyedi, chanadiyi yohizumuka nikuhizumuka, muloŋa washakamini mafuku asatu nimwaana niwufuku chakadi kudya yakudya, chakadi kunwa nimeji. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.12",
            "verseOrgIds": [
              "1SA.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakumwila nindi, Wudi wanyi? Wunafumi kudihi? Yena nindi, Nimukwenzi wakaEjipitu ninduŋu yakaAmaleki, naholokeli muyikatu, nkaka yami hakunshiya munahiti dehi mafuku asatu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.13",
            "verseOrgIds": [
              "1SA.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twalukukili aKereti akukabeta kakuchidiilu, niituŋa dawaYuda, nidaKalebi dakukabeta kakuchidiilu, twocha niZikilaŋi kesi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.14",
            "verseOrgIds": [
              "1SA.30.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakumwila nindi, Wukunkunkumwi shakudi chendu ochu? Yena nindi, Nsanyikili Nzambi neyi, Hinakakujaha hela kukulubula kudi nkaka yeyuku, kulonda nikukunkumwishikudi chendu ochu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.15",
            "verseOrgIds": [
              "1SA.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.15",
            "verseOrgIds": [
              "1SA.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chamukunkumwishiliyi, kuwana anaketwili dakupalaŋena mwahita iseki dejima, adi nakudya nakunwa, hiyakuluŋa nayuma yayivulu yejima yapupiluwu mwituŋa dawaFwilistinu, nimwituŋa dawaYuda. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.16",
            "verseOrgIds": [
              "1SA.30.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakuyitapa tapee, kufumisha hakabwidibwidi ndo nikumelela efukudikwawu, hikwapulukili muntu niwumuku chiŋa makulakaji awanyikwenzi awana endelapa hanŋameli hohu, diwu atemukili. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.17",
            "verseOrgIds": [
              "1SA.30.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakutambula cheŋi yuma yejima yatweluwu aAmaleki, Davidi hakupulwisha niapodiŋindi ejima ayedi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.18",
            "verseOrgIds": [
              "1SA.30.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hosi wawu wumu hela kansi, hela mukulumpi wabuliluhu, hela anyana amayala hela awambanda, hela yuma yapupilewi helakachuma hikachuma kayitambwiluwu kabuliluhuku. Davidi wafuntishiliyuma yejima. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.19",
            "verseOrgIds": [
              "1SA.30.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakutambula nyikoku yejima niaŋombi ejimahakuyi twampa kumbidi yayimuna yi kwawu, nindi, hiyuma yaDavidi yanapupiyi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.20",
            "verseOrgIds": [
              "1SA.30.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.20",
            "verseOrgIds": [
              "1SA.30.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakushika kwadiŋi makulakaji awantu ayedi aswejeli kuzeya, akaŋenyi kumulonda Davidi, ashakamishiluwu kukakaŋa Besori, hiyakwinza nakumukinkilila Davidi, nakukinkilila niantu adiŋiyi nawu, Davidi chanashikiyi kwakwihi nawantu hakuyimwisha. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.21",
            "verseOrgIds": [
              "1SA.30.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu atama niantu amukumkulwayi ahadi wena endelaŋa naDavidi, hiyakuhosha wejima wawunawu, Awa twabula kuya nawu hitwakayinkahu yuma yitunapupuku, tukukuminadakuyinka wejima wawu aŋodi jawu nawanyanawu hohu, kulonda ayitwali ayi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.22",
            "verseOrgIds": [
              "1SA.30.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 30:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumbila Davidi nindi, Enu ana kwami, bayi mwilaŋayuma yanatwinkuwu kudi Yehova chochochuku, yena diyi natuhembi dehi, nichendu chatulukukili nachihani dehi kudetu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.23",
            "verseOrgIds": [
              "1SA.30.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wukuyujia enunsaŋu iyi hinyi? Mukudiila wukuya kunjita mwomu mukudiila niniwuwukushala nayuma, akadiila hohamu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.24",
            "verseOrgIds": [
              "1SA.30.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chila nichochu kufumisha kwifuku odu, nashumu dehi chidika nilushimbi lwawaIsarela nikwifukudalelu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.25",
            "verseOrgIds": [
              "1SA.30.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.25",
            "verseOrgIds": [
              "1SA.30.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chenjiliyi Davidi kuZikilaŋi, hakuyitemeshela amabwambu jindi awakulumpi amuYuda yuma yapupiluwu, nindi, Tambulenu chamukunkulu chenu chakuyuma yapupiluwu kudi ayilumbu jaYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.26",
            "verseOrgIds": [
              "1SA.30.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 30:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakutemeshelani adiŋi muBeteli, niadiŋi muRamoti wakukabeta kakuchidiilu, niadiŋi muYatiri, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.27",
            "verseOrgIds": [
              "1SA.30.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 30:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "niadipi muArowenai, niadipi muSifwimoti, niadipi muEshetemowa, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.28",
            "verseOrgIds": [
              "1SA.30.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 30:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "niadiŋi muRakali, niadipi mtinyikala yawaYerameyeli, niadipi munyikala yawaKeni. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.29",
            "verseOrgIds": [
              "1SA.30.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1SA 30:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niadipi muHorama, niadiŋi muKorashani, niadipi muAtaki, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.30",
            "verseOrgIds": [
              "1SA.30.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1SA 30:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
