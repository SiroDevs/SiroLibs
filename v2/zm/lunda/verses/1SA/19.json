    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulu hakuhosha namwanindi Jonatani ninawambuŋindi ejima, nindi, Mujahenu Davidi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.1",
            "verseOrgIds": [
              "1SA.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa mwana kaSawulu Jonatani wamutiyili Davidi kuwaha nankashi. Jonatani hakumuleja Davidi nindi, Tatayami Sawulu wudi nakukeŋa kukujaha, dichi dinu mwani, nabudidi chiŋa wakababalaŋa wakashakama kweyi kwaswamana, wakabatami, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.2",
            "verseOrgIds": [
              "1SA.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ami nakaya nakwimana hamu natata kumpata kuwakekala, nakahosha natatansaŋu yeyi, neyi namoni kudi chuma nakakuleja. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.3",
            "verseOrgIds": [
              "1SA.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonatani hakumuhoshela Davidi chachiwahi kudi tata yindi Sawulu, hakumwila nindi, Mwantabayi amuvulumuna kambuŋeyi Daviduku; muŋa yena hanakuvulumunuku, ninyidimu yanakwililiyi yinasweji kuwaha, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.4",
            "verseOrgIds": [
              "1SA.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "haakamini wumiwinduku, watapili kaFwilistinu, Yehova wayihandishili nankashi aIsarela ejima, eyi wachimweni, wazapaleli, ichi mashi akadi muloŋa wuyitiyilinshidi? Wumujahi tuhu Davidi chakadi ninsaŋu? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.5",
            "verseOrgIds": [
              "1SA.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulu hakutiyilila mwahosheli Jonatani, Sawulu hakusanyika nindi, Chahandayi Yehova kwaamu, hiyakamujahaku. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.6",
            "verseOrgIds": [
              "1SA.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonatani hakumutambika Davidi, Jonatani hakumuleja yuma yejimiyi. Jonatani hakumushikŋa Davidi kudi Sawulu, hakushakama nindi neyi hakusambila.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.7",
            "verseOrgIds": [
              "1SA.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.7",
            "verseOrgIds": [
              "1SA.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hikukwi kala cheŋi njita, Davidi hakuya nakulwa nawaFwilistinu, hakuyira hakwanyilaŋa laŋa, amutemuka nikumutemuka. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.8",
            "verseOrgIds": [
              "1SA.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kudi Yehova kufuma nispiritu yatama, hakwinza hadi Sawulu hashakaminiyi mwitala dindi, iku niiyoŋa dindi kuchikasa. Davidi hakwimba kadada nachikasa chindi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.9",
            "verseOrgIds": [
              "1SA.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulu hakwila nindi amwasi Davidi iyoŋa zwa-a, dishimatinikumbaŋu yetala, Davidi hakuleya, hakufuma kudi Sawulu, iyoŋa daasiliyi dashimatili mumbaŋu, Davidi hakutemuka hakupuluka wena wufuku owu,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.10",
            "verseOrgIds": [
              "1SA.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.17",
            "verseOrgIds": [
              "1SA.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Davidi watemukili, wapulukili, washi kili kudi Samweli kuRama, wamulejeli mwamwililiyi Sawulu mwejima. Hiyakuya nakushakama kuNayoti, niyena niSamweli. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.18",
            "verseOrgIds": [
              "1SA.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakumuleja Sawulu nawu, Tiya, Davidi hadi kuNayoti muRama. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.19",
            "verseOrgIds": [
              "1SA.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulu hakutemesha antemesha nindiakamukwati Davidi, chamwenuwu chendu chawatuprofwetu hichikuprofweta, Samweli nemanuku neyi mwanta wawu, Spiritu yaNzambi hakwinzahadi antemesha jaSawulu, niwena hiyakuprofweta. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.20",
            "verseOrgIds": [
              "1SA.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanamulejuwu Sawulu, hakutemesha antemesha amakwawu, niwena nawa hiyakuprofweta. Sawulu hakutemesha nawa cheŋi antemesha amakwawu kapampa kamuchisatu, niwena hiyakuprofweta nawa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.21",
            "verseOrgIds": [
              "1SA.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuya nawa niyena kuRama, hakushika kwishima deneni dekala kuSeku, hakwihula nindi, Indi aSamweli naDavidi adi kudihi? Muntu wumu nindi, Adi kuNayoti muRama.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.22",
            "verseOrgIds": [
              "1SA.19.22"
            ]
          }
        }
      ]
    }
  ],
