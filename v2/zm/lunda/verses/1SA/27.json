      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi welili mumuchima windi, nindi, Sawulu wamba kanlamakesha tuhu ifuku dimu, chuma chachiwahi chochakupulukila mwituŋa dawaFwilistinu hohu, niSawulu wukudiwulaku kwindi, hakankeŋakeŋacheŋi mwahita pinza jejima jawaIsarelaku, hinakapuluka kudi yena. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.1",
            "verseOrgIds": [
              "1SA.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakunyamuka niyena, niantu indi adiŋiyi nawu makulakaji atanunadimu, hiyakumotoka pinza, hiyakwinza kudi Akisha mwana kaMayoki, mwanta wakuGati. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.2",
            "verseOrgIds": [
              "1SA.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakushakama naAkisha kuGati, niyena ni antu indi, iwu niakwetala dindi, iwu niakwetala dindi, Davidi niyena niaŋodi ŋindi ayedi nawa, iwu Ahinowami wakuYezereyeli, iwu Abigayili waku-Karameli, wadiŋilaŋa iŋoda Nabali. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.3",
            "verseOrgIds": [
              "1SA.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amulejeli Sawulu nawu, Davidi natemukili dehi kuGati, hamukeŋakeŋeli nawa chepuku.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.4",
            "verseOrgIds": [
              "1SA.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.4",
            "verseOrgIds": [
              "1SA.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakumwila Akisha nindi, Neyi nawani luwi kudeyi ankunjiki kumukala wumu wamumpata yeyi, nishakamuku mwani, indi ami kambuŋeyi ashakamaŋa tuhu muŋanda naneyi? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.5",
            "verseOrgIds": [
              "1SA.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akisha hakumwinka Zikilaŋi dena ifuku odu, dihafuma Zikilaŋi kwikala wambala wawanyanta awaYuda nikulelu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.6",
            "verseOrgIds": [
              "1SA.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafuku ashakaminiyi Davidi mumpata yawaFwilistinu ashikilimumwaka wamukuma natukweji tuwana.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.7",
            "verseOrgIds": [
              "1SA.27.7"
            ]
          }
        }
      ]
    }
