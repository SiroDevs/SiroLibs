  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "1SA 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cheliliyi nakumishi dehi kuhosha naSawulu, muchima wajonatani wudikasa namuchima waDavidi hamu mbe, Jonatani hakumukeŋaneyi chadikeŋeliyi yemweni. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.1",
            "verseOrgIds": [
              "1SA.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulu hakumutambula dodena ifuku odu, kumwitŋia nawa cheŋi yena kufunta kwitala datata yindi nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.2",
            "verseOrgIds": [
              "1SA.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "AJonatani naDavidi akwata nichitiyaŋenu, muloŋa wamukeŋeli neyi chadikeŋeliyi yemweni, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.3",
            "verseOrgIds": [
              "1SA.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonatani hakuvúula nichikovwelu chindi chavweliyi, hakumwinkachu Davidi, niyuma yindi yakuvwala, nimpoku yindi yakabali, niwuta windi wamukunji, nimuya windi waweni, kumwinka hohu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.4",
            "verseOrgIds": [
              "1SA.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.4",
            "verseOrgIds": [
              "1SA.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi wayilaŋa kwejima kwadiŋi nakumutemeshawu kudi Sawulu, welilaŋa chachiwahi nama ana hohu; Sawulu hakumwinka niwuawakulumpi wawakwanjita, niantu ejima, niambuŋaSawulu ejima chachimwenuwu eiili nawu, Chinawahi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.5",
            "verseOrgIds": [
              "1SA.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cheliluwu hiyakwinza, Davidi hakufuma kwayiluwu nakutapa aFwilistinu, ambanda hiyakufumafuma munyikala yawaIsarela yejima, hiyakumukinkilila mwanta Sawulu, hiyakwimba tumina nakuhaŋana, hiyakuzaŋalala, hiyakwimba ndimba nayisanji. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.6",
            "verseOrgIds": [
              "1SA.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ambanda hiyakusambilila, awa nakutumbula, awa nakwakwijia, nawu, Sawulu najalii makombakaji indi, Davidi makumi indi amakombakaji.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.7",
            "verseOrgIds": [
              "1SA.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.7",
            "verseOrgIds": [
              "1SA.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulu azuwa ninankashi, mazu owu hiyakumutiyisha kutama, nindi, Davidi anamuteneni makumi amakombakaji, kwinza ami ananteneni kwamakombakaji hohu; chumanyi chinamushali nawa? Kwiji wowuwanta hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.8",
            "verseOrgIds": [
              "1SA.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kufuma hefuku odu Sawulu hakumuralapa Davidi nanyikuhohu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.9",
            "verseOrgIds": [
              "1SA.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chelili kunachi dehi, kudi Nzambi hikukufuma spiritu yatama, hiyikwinza hadi Sawulu naŋovu, hakuzakukila mukachi ketala; Davidi hakwimba kadada nachikasa chindi neyi chelilaŋayi mafuku ejima, Sawulu wadiŋi neyoŋa dindi kuchikasa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.10",
            "verseOrgIds": [
              "1SA.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulu hakwasa iyoŋa, nindi amwasiDavidi zwa-a nikumbaŋu yetala, Davidi hakuleya, hakufuma kumesu indimapampa kayedi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.11",
            "verseOrgIds": [
              "1SA.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.11",
            "verseOrgIds": [
              "1SA.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulu haku mutiyaŋa Davidi woma, muloŋa Yehova hadi nayena, nafumi dehi kudi Sawulu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.12",
            "verseOrgIds": [
              "1SA.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Sawulu hakumufumisha kudi yena, hakumwinka wuawakulumpi wekombakaji, hakwilaŋa kumesu awantu aya enza, aya enza. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.13",
            "verseOrgIds": [
              "1SA.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwayilaŋayi Davidi mwejima welilaŋa chachiwahi nama ana hohu; Yehova wadiŋi nayena. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.14",
            "verseOrgIds": [
              "1SA.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulu chamweniyi chelilaŋayi chachiwahi namaana abadika, hakumwakama. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.15",
            "verseOrgIds": [
              "1SA.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "AIsarela nawaYuda ejimaamukepa niDavidi, muloŋa welilaŋa kumesu awu aya enza, aya enza.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.16",
            "verseOrgIds": [
              "1SA.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.16",
            "verseOrgIds": [
              "1SA.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulu wamwilili Davidi, nindi, Tala, mwanami wamumbanda wamukulumpi Merabi, nukukwinkayi wumusumbuli; chiŋa wikalaŋa dinu muntuwami wawulobu, wasaŋa njita jaYehova, muŋa Sawulu welili nindi, Chikasa chami kanda chimwila chumaku, chipa chikasa chawaFwilistinu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.17",
            "verseOrgIds": [
              "1SA.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.19",
            "verseOrgIds": [
              "1SA.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana kaSawulu wamumbanda Mikali omukeŋa niDavidi; hiyakumuleja muSawulu; chumochu chamutiyisha niSawulu kuwaha. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.20",
            "verseOrgIds": [
              "1SA.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulunindi, Nukumwinkayi kulonda ekali muhetu wakufwamu, kulonda chikasa chawaFwilistinu chakamukwati. Sawulu hakumwila Davidi kamuchiyedinindi, Lelu wukwi kala Sambanza wami. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.21",
            "verseOrgIds": [
              "1SA.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulu hakuyila ambuŋindi, nindi, Hoshenu naDavidi kumbadi, mumwili nenu, Mwanta nakutiyikuwaha, ni ambuŋindi ejima anakukeŋi, ikalaku dinu Sambanza.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.22",
            "verseOrgIds": [
              "1SA.18.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.26",
            "verseOrgIds": [
              "1SA.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimafuku achidi kanda amani Davidi hakunyamuka, hakuya niyenaniantu indi, hakujaha aFwilistinu makulakaji ayedi, Davidi hakuleta nyivumbuyawu, wamuchindilili mwanta yejima, kulonda ekali Sambanza. Sawulu yomwinka nimwanindi Mikali nindi, Sumbulaku. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.27",
            "verseOrgIds": [
              "1SA.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulu wamweni, welukili nindi, Yehova wudi naDavidi; mwana kaSawulu Mikaliwa mukeŋeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.28",
            "verseOrgIds": [
              "1SA.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulu asweja nikumutiya Davidi woma, Sawulu hakwikala chilumbu chaDavidi hefuku hefuku.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.29",
            "verseOrgIds": [
              "1SA.18.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.29",
            "verseOrgIds": [
              "1SA.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1SA 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atulamba twawaFwilistinu hiyakusolomoka nihenohu, cheliluwuhiya kusolomoka, Davidi hakwila chachiwahi nama ana akubadika maana awambuŋa Sawulu ejima; ijina dindi dilema ni kulema.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.30",
            "verseOrgIds": [
              "1SA.18.30"
            ]
          }
        }
      ]
    }
  ],
