  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "MAT 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanakunkumukiyi hampidi oyu, mazaza awantu hiyakumulondela.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.1",
            "verseOrgIds": [
              "MAT.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.1",
            "verseOrgIds": [
              "MAT.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukwambumba hakwinza nakudifukula kudi yena nindi, Mwanta, neyi wuneteji, wukutwesha kuntookesha. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.2",
            "verseOrgIds": [
              "MAT.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakwolola chikasa chindi, hakumukunka nindi, Neteji, tookaku. Hohenohu musoŋu windi wambumba wutooka nikutooka. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.3",
            "verseOrgIds": [
              "MAT.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakumwila nindi, Babalaku, bayi wulejamu muntuku; ilaŋa yaloŋa kweyi wakadimwekeshi kudi kapristu, wakahani mushiŋa wayilejeluwu kudi Mosi, kulonda chakayilili antu wunsahu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.4",
            "verseOrgIds": [
              "MAT.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.4",
            "verseOrgIds": [
              "MAT.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanepiliyi muKaperinawu, kudi yena hikukwinza senturinu, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.5",
            "verseOrgIds": [
              "MAT.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakumulembelela nindi, Mwanta, ŋamba yami nakami kwaami, wakata musoŋu wakalepa, wudi nakukaba nankashi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.6",
            "verseOrgIds": [
              "MAT.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakumwila nindi, Nukwinza nakamúuki. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.7",
            "verseOrgIds": [
              "MAT.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Senturinu hakumwakula nindi, Mwanta, ami hinatela eyi kwijila mwitala damuku, kumina dakuhosha kwezu hohu, ŋamba yami wukukola. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.8",
            "verseOrgIds": [
              "MAT.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa ninami nawa ni kweti anyanta jami, ni kweti mashidika aŋovwahilaŋa, nelaŋa iwu nami, Yaŋa, hakuya; mukwawu nami, Inzaŋa, hakwinza; nduŋu yami hinukumwila nami, Ilaku ichi, hakuchila. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.9",
            "verseOrgIds": [
              "MAT.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu chanachitiyiyi hakuhayama, hakuyila adiŋi nakumulonda nindi, Nukuyileja chalala nami kanda nimonaŋahu dehi kukuhwelela kwatoha chochichuku, hela muIsarela mwamweni. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.10",
            "verseOrgIds": [
              "MAT.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukuyileja nami amavulu amba kafuma kumusela nikumujika, akashakama naAbarahama naIsaka niYakoba muwanta wamwiwulu; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.11",
            "verseOrgIds": [
              "MAT.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakwila anyana kawanta aweni akayumbila kumwidima wahanzi, kwakekala kutumpa nikudisumona kumaji. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.12",
            "verseOrgIds": [
              "MAT.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakumwila owu senturinu nindi, Yaŋa kweyi; muwunakuhweleli dimu mwakukwililawu. Owu ŋamba wakoleli mpinji yoyenoyu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.13",
            "verseOrgIds": [
              "MAT.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.13",
            "verseOrgIds": [
              "MAT.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanepiliyi Yesu mwitala daPetulu, wamweni mawenu yaPetulu nakami, wakata mashika. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.14",
            "verseOrgIds": [
              "MAT.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakumukunka kuchikasa chindi, mashika amufuma nikumufuma, hakuhinduka nakumukalakela. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.15",
            "verseOrgIds": [
              "MAT.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chikuneli melela, hiyakumuletela amavulu adiŋi nakuzakuka ademoni, hakufumisha ademoni nezu, hakuuka adiŋi akata ejima; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.16",
            "verseOrgIds": [
              "MAT.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulonda mwahosheliyi kaprofwetu Isaya mwakalumbuluki, mweliliyi nindi, Yomweni watambwili kuzeyazeya kwetu, wasendeli nyisoŋu yetu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.17",
            "verseOrgIds": [
              "MAT.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.17",
            "verseOrgIds": [
              "MAT.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nochu Yesu chanamoniyi mazaza awantu amavulu hiyakumuwuŋila, hakwila nindi, Tuyenu mwishinadi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.18",
            "verseOrgIds": [
              "MAT.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hikukwinza nsoneki wumu, hakumwila nindi, Eyi Nkuluŋaŋa, nukukulonda kwejima kuwukuya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.19",
            "verseOrgIds": [
              "MAT.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakumwila nindi, Anyumbu akweti menawu, niatujila ahaluzwizu akweti yisakala yawu, hakwila Mwana kamuntu hakweti nihakusachila namutu winauku. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.20",
            "verseOrgIds": [
              "MAT.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kambanji mukwawu hakumwila nindi, Mwanta, leki nisambili kuya nakajiiki tata yami. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.21",
            "verseOrgIds": [
              "MAT.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa Yesu hakumwila nindi, Nlondami; yileki afu ajiiki afu jawu awenawu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.22",
            "verseOrgIds": [
              "MAT.8.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.22",
            "verseOrgIds": [
              "MAT.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanepiliyi muwatu atumbanji twindi hiyakumulonda. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.23",
            "verseOrgIds": [
              "MAT.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hikukwinza mpepela yeneni nankashi hameji, yakwila watu hiwukujimina mumankanda; ilaŋa yena kwindi wadiŋi namutulu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.24",
            "verseOrgIds": [
              "MAT.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wena hiyakwinza kudiyena, hiyakumuhindwisha nawu, Mwanta twamwini, tunafwi! ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.25",
            "verseOrgIds": [
              "MAT.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena hakuyila nindi, Enu mukweti kukuhwelela kwanti, munatiyi woma wanka? Hakuhinduka, hakuhoshola mpepela nimeji, kuwunda nizo-o nankashi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.26",
            "verseOrgIds": [
              "MAT.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu owu hiyakuhayama nawu, Yeniwu muntu wekala ŋahi, chamwovwahilaŋawu kudi mpepela nimeji?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.27",
            "verseOrgIds": [
              "MAT.8.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.27",
            "verseOrgIds": [
              "MAT.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanashikiyi mwishinadi mwituŋa dawaGadareni, antu ayedi hiyakumubulakana, azakukaŋa ademoni, adi nakufuma kumajamu, asweja kuzuwa nankashi, kuzuwa kwakukaŋesha antu kuhita njiloyu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.28",
            "verseOrgIds": [
              "MAT.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutiya wena hiyakubilela nawu, Tukwiladi naneyi, eyi Mwana kaNzambi? Eyi wunenzi kunu nakutukabisha hachidi mwaka kanda wushiki, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.29",
            "verseOrgIds": [
              "MAT.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi hahalehi nawena hadiŋi izanvu dawaŋulu amavulu enda adya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.30",
            "verseOrgIds": [
              "MAT.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owu ademoni hiyakumulembelela nawu, Neyi wukutufumishamu, tutemeshi mwizanvu dawaŋulu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.31",
            "verseOrgIds": [
              "MAT.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyila nindi, Yenu. Hiyakufumamu, hiyakwijila mudi aŋulu; izanvu dejima danduka nikwanduka, hidikuya mwakunkumuka nankashi nimwijiya chu-u, afwa nimumeji. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.32",
            "verseOrgIds": [
              "MAT.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owu ayidiishilaŋa hiyakutemuka, hiyakuya kumukala, hiyakuleja antu yuma yejima, niyamwenuwu owu adiŋi azakuka ademoni. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.33",
            "verseOrgIds": [
              "MAT.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutala antu amumukala wejima hiyakwinza nawu amubulakani Yesu; chanamuwanuwu, hiyakumulembelela nawu afumi mwituŋa dawu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.34",
            "verseOrgIds": [
              "MAT.8.34"
            ]
          }
        }
      ]
