  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "MAT 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu havwalikiliyi Yesu kuBetelemi wamuYudeya, hanyaka yadiŋiyi mwanta Herodi, kwenjili akwamaana afumini kumusela, hiyakushika kuYerusalema. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.1",
            "verseOrgIds": [
              "MAT.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawu, Owu Mwanta wawaYudeya navwaliki, wudi kudihi? Muloŋa twamweni katumbwa kindi kumusela, tunenzi nakudifukula kudi yena. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.2",
            "verseOrgIds": [
              "MAT.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta Herodi chanachitiyiyi, hakwakama hamu nawakwaYerusalema ejima. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.3",
            "verseOrgIds": [
              "MAT.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakupompesha awakulumpi jawatupristu niansoneki ejima awantu awa, hakuyihula kwamba kavwalikilayi Kristu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.4",
            "verseOrgIds": [
              "MAT.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakumwila nawu, KuBetelemi wamuYudeya; muloŋa dichi chasonekeliyi kaprofwetu ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.5",
            "verseOrgIds": [
              "MAT.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Eyi Betelemi wamwituŋa daYuda, hiwakehela mukachi kawatulamba amuYudaku; muloŋa mudeyi dimu mwakafuma nguvulu, wakela kabiŋa kawantu ami aIsarela.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.6",
            "verseOrgIds": [
              "MAT.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.6",
            "verseOrgIds": [
              "MAT.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu Herodi hakutambika akwamaana kwakanka wawu, hakuyihula chakashinshi hamwekeni katumbwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.7",
            "verseOrgIds": [
              "MAT.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyitemesha kuBetelemi nindi, Yenu mukeŋakeŋi chachiwahi owu mwana wanyanya; neyi munamumoni dehi munfuntishili izu, kulonda ninami nakayi nakudifukula kudi yena. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.8",
            "verseOrgIds": [
              "MAT.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wena chanamutiyuwu mwanta hiyakuya; nawu atali, komana katumbwa kamwenuwu kumusela hikakutwamina kumbidi yawu, nichikayili nakwimana hadiŋi owu mwana wanyanya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.9",
            "verseOrgIds": [
              "MAT.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chamwenuwu katumbwa, hiyakuzaŋalala muzaŋalu wabadika nankashi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.10",
            "verseOrgIds": [
              "MAT.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eŋila nimwitalodu, hiyakumona owu mwana wanyanya hamu namama yindi Mariya; hiyakudinata heseki nakudifukula kudi mwana; hiyakujikula mwadiŋi yuma yawu yalema, hiyakuhimulambu la nyilambu yawuru nilibona nimora. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.11",
            "verseOrgIds": [
              "MAT.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanayilejuwu mukulota nawu bayi afunta kudi Heroduku, hiyakuya kwituŋa dawu njila yacheŋi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.12",
            "verseOrgIds": [
              "MAT.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.12",
            "verseOrgIds": [
              "MAT.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi cheliluwu wena anayi dehi, kaŋelu kaYehova hakumwekana kudi Yosefu mukulota nindi, Nyamukaku wutwali iwu mwana wanyanya nimama yindi, wutemukili kuEjipitu, wakashakami kwenoku, kufumaku chiŋa nakuleji; muloŋa Herodi wakakeŋakeŋa iwu mwana wanyanya nindi amukisaŋani. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.13",
            "verseOrgIds": [
              "MAT.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakunyamuka, hakutwala owu mwana wanyanya nimama yindi nawufuku, hakuya kuEjipitu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.14",
            "verseOrgIds": [
              "MAT.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakushakama kwenoku ninichi chafwiliyi Herodi, kulonda mwahosheliyi Yehova mudi kaprofwetu mwakalumbuluki, mweliliyi nindi, Natambikili mwanami kuEjipitu kwadiŋiyi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.15",
            "verseOrgIds": [
              "MAT.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.15",
            "verseOrgIds": [
              "MAT.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Herodi chanamoniyi nindi anamudiwuli kudi akwamaana, hakusweja kuzuwa nankashi, hakutemeshaku njita yakujaha anyana amayala ejima adiŋi muBetelemi, niadiŋi kuŋinza jawu jejima, nianyaka yiyedi niabulili kushika munyaka yiyedi, nakweseka mwatiyililiyi chakashinshi kudi akwamaana. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.16",
            "verseOrgIds": [
              "MAT.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu mwahosheliyi kaprofwetu Yeremiya himukulumbuluka, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.17",
            "verseOrgIds": [
              "MAT.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "mweliliyi nindi, KuRama atiyili izu dakutumpa, nimakumbu aweni; Racheli hakudila anyanindi. Kumukundeja kwonti kwindi, muloŋa anyanindi kwosi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.18",
            "verseOrgIds": [
              "MAT.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.18",
            "verseOrgIds": [
              "MAT.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa chanafwiyi Herodi, kaŋelu kaYehova hakumwekana kudi Yosefu mukulota, omu muEjipitu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.19",
            "verseOrgIds": [
              "MAT.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindi, Nyamukaku wutwali iwu mwana wanyanya nimama yindi, wuyi mwituŋa daIsarela; muloŋa antu akeŋeli kujaha iwu mwana wanyanya afwa dehi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.20",
            "verseOrgIds": [
              "MAT.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakunyamuka, hakutwala owu mwana wanyanya nimama yindi, hakwinza mwituŋa daIsarela. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.21",
            "verseOrgIds": [
              "MAT.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iluŋa chanatiyiyi nawu Akelawusi naswani dehi wanta watata yindi Herodi muYudeya, hakutiya woma wakuya kwenoku; chanamulejuwu mukulota, hakutondolwela kumbadi yaŊaliliya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.22",
            "verseOrgIds": [
              "MAT.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuya nakushakama kumukala ijina dawu Nazareta; kulonda mwahosheluwu atuprofwetu mulumbuluki; mweliluwu nawu, Akamutena nawu kaNazareta.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.23",
            "verseOrgIds": [
              "MAT.2.23"
            ]
          }
        }
      ]
    }
  ],
