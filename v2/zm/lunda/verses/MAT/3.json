        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wena mafuku owu hikukwinza Yowanu Mpapatishu nakushimuna mwisaŋa damuYudeya, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.1",
            "verseOrgIds": [
              "MAT.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Balumukenu munyichima yenu, muloŋa wanta wamwiwulu wunashiki dehi kwakwihi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.2",
            "verseOrgIds": [
              "MAT.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Diyi atenenuwu mudi kaprofwetu Isaya nawu, Izu damukwakubilela mwisaŋa nindi, Loŋeshenu njila yaYehova, ololenu njila jindi jatulolu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.3",
            "verseOrgIds": [
              "MAT.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.3",
            "verseOrgIds": [
              "MAT.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowanu wavwelaŋa mahina amavuji anŋameli, nimwonji wachikaba mumayindi, kudya kwindi wadiilaŋa tubola niwuchi wamwisaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.4",
            "verseOrgIds": [
              "MAT.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi antu akuYerusalema, niamuYudeya mwejima, niakumpata yejima yanyeŋumuka Yodana, hiyakuya kudi yena; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.5",
            "verseOrgIds": [
              "MAT.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "hiyakuyipapatisha kudi yena mukaloŋa Yodana, hiyakwiteja mwavulumwinuwu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.6",
            "verseOrgIds": [
              "MAT.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanamoniyi aFwarisi nawaSadusi amavulu hiyakwinza kuchipapatishu chindi, hakuyila nindi, Enu anyana katubandayula, nayileji kutemuka kuzuwa kwamba kenza hinyi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.7",
            "verseOrgIds": [
              "MAT.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soŋenu nyikabu yatelela kubalumuka mumuchima. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.8",
            "verseOrgIds": [
              "MAT.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi mutoŋojoka kuhosha munyichima yenu nenu, Tukweti nkakulula yetu Abarahamaku. Tiyenu niyileji, Nzambi natweshi kutetula mumalolawa anyana kaAbarahama. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.9",
            "verseOrgIds": [
              "MAT.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katataka anashi dehi chizembi kunyiji yanyitondu, dichi nyitondu yejima yikubula kusoŋa nyikabu yayiwahi akuyitemamu, akuyinatila mukesi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.10",
            "verseOrgIds": [
              "MAT.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chalala ami nidi nakuyipapatisha mumeji kulonda mubalumuki munyichima; ilaŋa owu wukwinza munyima yami wambadika Ŋovu, nkwabilu jindi ami kutela kujisenda nehi; yena wakayipapatisha mudi Spiritu Wajila nimukesi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.11",
            "verseOrgIds": [
              "MAT.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muchikasa chindi mudi lwalu; wakatookesha mwitala dindi dakuhulila, to-o chikupu; wakapompeshela tidiku munkalaŋa, hakwila mafulu wakayocha mukesi kakajimaŋa, bwi-i chikupu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.12",
            "verseOrgIds": [
              "MAT.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.12",
            "verseOrgIds": [
              "MAT.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu Yesu hakufuma kuŊaliliya, hakwinza kuYodana kudi Yowanu, kulonda akamupapatishi kudi yena. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.13",
            "verseOrgIds": [
              "MAT.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowanu wakeŋa eli kumulekesha nindi Ami yami nateli kumpapatisha kudeyi, indi eyi winzi kudami? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.14",
            "verseOrgIds": [
              "MAT.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa Yesu hakumwakula nindi, Kumina dakwiteja katataka, muloŋa dichi chinatuteleli, kulonda kuwanisha kuloŋa kwejima. Hakumwiteja. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.15",
            "verseOrgIds": [
              "MAT.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu chanamupapatishuwu, hohenohu azambuka nimumeji. Kutala mawulu hiyakumwenzulukila, hakumona Spiritu yaNzambi wudi nakusuluka neyi katela, hakuwila hadi yena. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.16",
            "verseOrgIds": [
              "MAT.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutiya mumawulu himukufuma izu nindi, Diyi Mwanami nakeŋa, natiyaloŋa kuwaha nankashi mudi yena.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.17",
            "verseOrgIds": [
              "MAT.3.17"
            ]
          }
        }
      ]
    }
  ],
