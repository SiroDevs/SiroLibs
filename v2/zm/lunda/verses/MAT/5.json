    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanamoniyi mazaza awantu hakukanduka hampidi; chanashakamiyi atumbanji twindi hiyakwinza kudi yena; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.1",
            "verseOrgIds": [
              "MAT.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakuhosha nakuyileja,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.2",
            "verseOrgIds": [
              "MAT.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.8",
            "verseOrgIds": [
              "MAT.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwakwambulwila akwawu anakooleki, muloŋa akayitena nawu anyana kaNzambi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.9",
            "verseOrgIds": [
              "MAT.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.9",
            "verseOrgIds": [
              "MAT.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akukabishilawu hansaŋu yakuloŋa anakooleki, muloŋa wanta wamwiwulu wunekali wawu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.10",
            "verseOrgIds": [
              "MAT.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.10",
            "verseOrgIds": [
              "MAT.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi akayihosha chatama, nakuyikabisha, nakuyituŋaula mazu atama ejima, nikuyitwambila hansaŋu yamami, munakooleki. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.11",
            "verseOrgIds": [
              "MAT.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zaŋalalenu, luŋenu chacheni, muloŋa akayisomona masomu amaneni mwiwulu; muloŋa dichi chakabishiluwu niatuprofwetu asambililenu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.12",
            "verseOrgIds": [
              "MAT.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.12",
            "verseOrgIds": [
              "MAT.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu yenu muŋwa wahanu heseki, ilaŋa neyi muŋwa wunasamuki akuwutoweja nanka? Hiwukweti nawa cheŋi mudimuku, wakunata tuhu hanzi, awudatoli kudi antu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.13",
            "verseOrgIds": [
              "MAT.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu yenu chejeji champata yamunu mwishina. Mukala wakutuŋila hampidi hiyatweshaŋa kuwujindaku. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.14",
            "verseOrgIds": [
              "MAT.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela inoŋu hiyadibutulaŋa adisweka mwibaŋuku, chiŋa kudisha hamesa ditoŋekeli ejima adi mwitala. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.15",
            "verseOrgIds": [
              "MAT.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninenu nawa chejeji chenu chitoŋekaŋa kumesu awantu, kulonda amonaŋa nyidimu yenu yayiwahi, alemeshaŋa Tata yenu wudi mwiwulu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.16",
            "verseOrgIds": [
              "MAT.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.16",
            "verseOrgIds": [
              "MAT.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi mutoŋojoka nenu ami nenzi nakukisaŋana nshimbi hela mazu awatuprofwetuku; hinenzi nakujikisaŋanaku, nenzi nakujikolesha. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.17",
            "verseOrgIds": [
              "MAT.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukuyileja chalala nami iwulu namaseki amba kahita, ilaŋa kajotu hela kepaya hikamba kafuma kunshimbuku, chiŋa yuma yejima yinalumbuluki dehi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.18",
            "verseOrgIds": [
              "MAT.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi muntu wukumotoka kachuma kamu kinayileji, hakulejamu ni akwawu, muwanta wamwiwulu akamutena nawu wasweja kukeha; hakwila muntu wukwilamu, hakulejamu ni akwawu, muwanta wamwiwulu akamutena nawu muneni. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.19",
            "verseOrgIds": [
              "MAT.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa nukuyileja nami, kuloŋa kwenu chiŋa kubadika kwawansoneki nikwawaFwarisi, mukunkulwayi himwakatwesha kwijila muwanta wamwiwulu nihantuku.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.20",
            "verseOrgIds": [
              "MAT.5.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.20",
            "verseOrgIds": [
              "MAT.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munatiyi chayililuwu antu ahashankulu nawu, Kujaha muntu chinjila; nawu, yowu wukujaha muntu keŋa ashiki kukusompesha. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.21",
            "verseOrgIds": [
              "MAT.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa mi nukuyileja nami yowu wukuzuwa namana kwindi keŋa ashiki kukusompesha; yowu wukusoza mana kwindi keŋa ashiki muchota; yowu wukwila nindi, Eyi chisupi, wudi kwakwihi nakumona kesi kakaluŋa kachinana. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.22",
            "verseOrgIds": [
              "MAT.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi neyi wudi nakutwala himulambu weyi kukameŋa, kwenoku hiwukwanuka neyi nidi namuloŋa namana kwami, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.23",
            "verseOrgIds": [
              "MAT.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "shiyaku himulambu weyi kwenoku kukameŋa, wuyi wusambili kutiyaloŋana namana kweyi; winzi dinu nakuhana himulambu weyi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.24",
            "verseOrgIds": [
              "MAT.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyaloŋana swayi nachilumbu cheyi hiwuchidi nindi munjila, kuchina chilumbu cheyi kukutwala kudi mukwakusompesha, mukwakusompesha hakukuhana kudi kalama, yena hakukusha mukaleya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.25",
            "verseOrgIds": [
              "MAT.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukukuleja chalala nami hiwamba kafuma mwokuku, kufumamu chiŋa wunafuti muloŋa wejima, nikadali kanyanya kushalaku nehi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.26",
            "verseOrgIds": [
              "MAT.5.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.26",
            "verseOrgIds": [
              "MAT.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munatiyi cheliluwu nawu, Kwila wuvumbi chinjila. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.27",
            "verseOrgIds": [
              "MAT.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa mi nukuyileja nami muntu wukutala mumbanda namesu akumufwila, neli dehi nindi wuvumbi mumuchima windi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.28",
            "verseOrgIds": [
              "MAT.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi disu deyi dachidiilu dikukudimbwisha, ditubuli wudinati; chinawahi chidi cheyi chimu kukisika, hichinawahi kunatila mujimba weyi wejima mukaluŋa kachinanaku. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.29",
            "verseOrgIds": [
              "MAT.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi chikasa cheyi chachidiilu chikuku dimbwisha, chiketuli wuchinati; chinawahi chidi cheyi chimu kukisika, hichinawahi mujimba weyi wejima kuya muka luŋa kachinanaku. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.30",
            "verseOrgIds": [
              "MAT.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elili cheŋi nawu, Muntu wukuseŋa Iŋodindi, amwinki mukanda wakumuseŋa nachu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.31",
            "verseOrgIds": [
              "MAT.5.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa mi nukuyileja nami muntu wukuseŋa Iŋodindi, chiŋa hamuloŋa wawuvumbi hohu, namubalumuni dehi nindi hichivumbi; muntu wukusumbula owu mumbanda analekuwu, neli wuvumbi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.32",
            "verseOrgIds": [
              "MAT.5.32"
            ]
          }
        }
      ]
    },
    {
