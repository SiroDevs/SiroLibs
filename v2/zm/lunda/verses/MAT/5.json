              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.42",
            "verseOrgIds": [
              "MAT.5.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 5:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munatiyi cheliluwu nawu, Keŋaku mukwenu, helaku chilumbu cheyi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.43",
            "verseOrgIds": [
              "MAT.5.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 5:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa mi nukuyileja nami keŋenu ayilumbu jenu, ninawa ayikabishaŋa, yilombelenu; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.44",
            "verseOrgIds": [
              "MAT.5.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 5:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulonda mwikali anyana kaTata yenu wudi mwiwulu, muloŋa yena watuntwishaŋa itaŋwa dindi nihadi atama nihadi amawahi, wanokeshaŋa nvula nihadi aloŋa nihadi áheŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.45",
            "verseOrgIds": [
              "MAT.5.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 5:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa neyi mukukeŋa antu ayikeŋaŋa hohu, mwakadiila mwodi? Hidimu mwelaŋa ansonkeshuku? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.46",
            "verseOrgIds": [
              "MAT.5.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "MAT 5:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi mukwimwisha ana kwenu hohu munabadikili akwenu hadihi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.47",
            "verseOrgIds": [
              "MAT.5.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "MAT 5:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hidimu mwelaŋa aJentiluku? Dichi enu chiŋa mwikala antu alala chikupu, neyi chadiyi Tata yenu wamwiwulu niyena walala chikupu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.48",
            "verseOrgIds": [
              "MAT.5.48"
            ]
          }
        }
      ]
