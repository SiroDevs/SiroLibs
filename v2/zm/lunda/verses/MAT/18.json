  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "MAT 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpinji yoyenoyu atumbanji hiyakwinza kudi Yesu nawu, Nabadiki akwawu muwanta wamwiwulu hinyi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.1",
            "verseOrgIds": [
              "MAT.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakutambika mwana wanyanya, hakumusha mukachi kawu, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.2",
            "verseOrgIds": [
              "MAT.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi. Nukuyileja chalala nami chiŋa mubalumuka, mwikali neyi anyana anyanya, mukunkulwayi himwakatwesha kwijila muwanta wamwiwuluku. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.3",
            "verseOrgIds": [
              "MAT.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi yowu wukudizoza neyi mwana wanyanyiwu, diyi nabadiki muwanta wamwiwulu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.4",
            "verseOrgIds": [
              "MAT.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimuntu wukutambula mwana wanyanya wumu wudi neyi iwu mwijina dami, nantambulami; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.5",
            "verseOrgIds": [
              "MAT.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakwila muntu wukudimbwisha mwinawu wanyanya wumu wankuhwelelami, chikuwaha kumukasila ilola dakuhala deneni kunshiŋu, hikumujiyisha mwinyiŋi damukaluŋalwiji.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.6",
            "verseOrgIds": [
              "MAT.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.6",
            "verseOrgIds": [
              "MAT.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "O yihuŋu yakamona matuŋa ahanu hamaseki nansaŋu jakudimbwisha! Muloŋa nsaŋu jakudimbwisha jakenza hohu; ilaŋa o yihuŋu yakamona muntu wukujileta! ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.7",
            "verseOrgIds": [
              "MAT.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi chikasa cheyi, hela mwendu weyi wakudimbwishaŋa wuketuli, wuwunatili kwakulehi naneyi; chinawahi kwijila muwumi nawufwayi hela nawulema; kukunatila mukesi kahaya nyaka wudi namakaseyi ayedi, hela nanyendu yeyi yiyedi, hichinawahuku. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.8",
            "verseOrgIds": [
              "MAT.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi disu deyi dakudimbwishaŋa ditubuli, wudinatili kwakulehi naneyi; chinawahi kwijila muwumi nadisu dimu, kukunatila mukesi kamukaluŋa kachinana namesu ayedi hichinawahuku.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.9",
            "verseOrgIds": [
              "MAT.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.9",
            "verseOrgIds": [
              "MAT.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babalenu mubuli kudi wula hela mwana wanyanya wumu wudi neyi iwu; muloŋa nukuyileja nami akweti aŋelu jawu atalaŋa mafuku ejima kumesu aTata yami wekala mwiwulu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.10",
            "verseOrgIds": [
              "MAT.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa Mwana kamuntu nenzi nakwamwina ajimbala. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.11",
            "verseOrgIds": [
              "MAT.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munatoŋojoki ŋahi? Neyi kudi muntu wukweti nyikoku yindi nkulakaji, neyi hanapwapuki wumu, abuli kushiya makumi atanu nawana natanu nawana, ayi kumapidi nakukeŋakeŋa owu napwapuki, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.12",
            "verseOrgIds": [
              "MAT.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamba kela wukumuwana, nukuyileja chalala nami, wukuzaŋalala namukoku owu chakubadika awa makumi atanu nawana natanu nawana abulili kupwapuka. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.13",
            "verseOrgIds": [
              "MAT.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi muchima waTata yenu wudi mwiwulu hanakeŋi mwana wanyanya wudi neyi iwu kunoŋaku.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.14",
            "verseOrgIds": [
              "MAT.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.14",
            "verseOrgIds": [
              "MAT.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi mana kweyi nakuvulumuni, yaku wumukonkololi mwanaluwiyi kwakanka wenu; neyi wukukutiya, wunamoni dehi mana kweyi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.15",
            "verseOrgIds": [
              "MAT.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa neyi kwonti kwindi kukutiya, yakuku namuntu wumu hela nawantu ayedi, kulonda mazu ejima akakoleli kutunwa twawayinsahu ayedi hela asatu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.16",
            "verseOrgIds": [
              "MAT.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi kwonti kwindi kutiyilila wena nawa, lejaku chipompelu; neyi saŋa adikaŋilayi, kutiyilila chipompelu nehi, mufwanishi kweyi neyi kaJentili, hela neyi nsonkeshi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.17",
            "verseOrgIds": [
              "MAT.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukuyileja chalala nami, yuma yimwakakasa hanu hamaseki, nimwiwulu akayikasa; yuma yimwakasubula hanu hamaseki, nimwiwulu akayisubula. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.18",
            "verseOrgIds": [
              "MAT.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cheŋi nawa nukuyileja nami, neyi hadi akwenu ayedi akutiyaloŋana kulomba chuma hanu hamaseki, akayililachu kudi Tata yami wudi mwiwulu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.19",
            "verseOrgIds": [
              "MAT.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa kunapompi hela ayedi hela asatu mwijina dami, diku kunidi mukachi kawu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.20",
            "verseOrgIds": [
              "MAT.18.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.20",
            "verseOrgIds": [
              "MAT.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu Petulu hakwinza nakumwila nindi, Mwanta, mapampa kaŋahi akanvulumunayi mana kwami, ami nimwanakenaŋa ho-o? Kakashika mumapampa katanu nakayedi, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.21",
            "verseOrgIds": [
              "MAT.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakumwila nindi, Hinukukuleja nami kakashiki mumapampa katanu nakayedi hohuku; ilaŋa nami kakashiki mumakumi atanu nayedi, mapampa katanu nakayedi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.22",
            "verseOrgIds": [
              "MAT.18.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.22",
            "verseOrgIds": [
              "MAT.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi wanta wamwiwulu wudi neyi mwanta wumu wakeŋa eli kushinshika nyikudi yawanduŋu jindi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.23",
            "verseOrgIds": [
              "MAT.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chatachikiliyi kuyishinshika, hiyakumuletela muntu waihudiilili mukudi wamakombakaji antalenta ikumi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.24",
            "verseOrgIds": [
              "MAT.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chijinamukaŋi kufuta, nkaka yindi hakuyileja nindi mulandenu niyena, niŋodindi, ni anyanindi hamu, niyahetayi yejima, akafuti. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.25",
            "verseOrgIds": [
              "MAT.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi owu nduŋu hakudinata hamaseki, hakumulembelela nindi, Mwanta awundishi muchima, nakakufuta yejima. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.26",
            "verseOrgIds": [
              "MAT.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaka yanowu nduŋu hakumutiyila wushona, hakumuumbaku, hakumwanakena mukudi owu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.27",
            "verseOrgIds": [
              "MAT.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa owu nduŋu chanedikiyi, hakumona mukwawu nduŋu nindi wadiŋi nindi namukudi wankulakaji yamali, hakumukwata, amukwata nihanyidiwu, nindi, Futaku mukudi weyi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.28",
            "verseOrgIds": [
              "MAT.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi owu mukwawu nduŋu nindi hakudinata hamaseki, hakumulembelela nindi, Wundishaku muchima, nakakufuta. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.29",
            "verseOrgIds": [
              "MAT.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena kwonti kwindi, hakuya nakumusha mukaleya, nindi kufumamu chiŋa wunafuti mukudi wejima. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.30",
            "verseOrgIds": [
              "MAT.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwawu anduŋu nindi chanamonuwu ochu cheliliyi, hiyakuneŋa nankashi, hiyakwinza nakumuleja nkaka yawu yuma yejima. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.31",
            "verseOrgIds": [
              "MAT.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaka yindi hakumutambi ka, hakumwila nindi, Eyi nduŋu watama, ami nakwanakena mukudi wuna wejima nachina chiwanlembelela; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.32",
            "verseOrgIds": [
              "MAT.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "eyi kutiyila mukwenu nduŋu neyi luwi, neyi china chinakutiyilami nehi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.33",
            "verseOrgIds": [
              "MAT.18.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaka yindi hakumuzuwila, hakumuhana kudi akwakubabesha, nindi kufumamu chiŋa nafuti mukudi wejima. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.34",
            "verseOrgIds": [
              "MAT.18.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 18:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi chakayilayi nawa niTata yami wamwiwulu, neyi enu mukubula kwanakena akwenu nyiloŋa yawu munyichima yenu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.35",
            "verseOrgIds": [
              "MAT.18.35"
            ]
          }
        }
      ]
