  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "MAT 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi musompeshaŋa akwenuku, kulonda abuli kuyisompesha ninenu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.1",
            "verseOrgIds": [
              "MAT.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa kusompesha kumukusompesha akwenu diku kwakayisompeshawu nachu ninenu; chesekelu chimukuyesekela akwenu dichi chakayesekelawu ninenu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.2",
            "verseOrgIds": [
              "MAT.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wukutaliladi kachibalu kadi mudisu damana kweyi, kwinza chipamba chidi mudisu deyeyi aweni hiwachimonaŋaku? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.3",
            "verseOrgIds": [
              "MAT.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indi wukumwililadi mana kweyi neyi, Tali nikufumishi kachibalu kadi mudisu deyi; indi chipamba chidi mudisu deyeyi aweni? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.4",
            "verseOrgIds": [
              "MAT.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi nfwikŋi! Sambilaku kufumisha chipamba chidi mudisu deyeyi aweni, mwaka wumoni chachiwahi kufumisha kachibalu kadi mudisu damana kweyi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.5",
            "verseOrgIds": [
              "MAT.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.5",
            "verseOrgIds": [
              "MAT.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi mwinka atuwa yuma yajilaku, hela kunatila aŋulu mperola jenu, akenda kajidatola, hiyakuyibalumukila nakuyisansanya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.6",
            "verseOrgIds": [
              "MAT.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.6",
            "verseOrgIds": [
              "MAT.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lombenu akuyinka; keŋakeŋenu mukuwana; dondomwenenu akuyenzulwila. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.7",
            "verseOrgIds": [
              "MAT.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa ejima akulomba akutambula; muntu wukukenakeŋa wukuwana; niwukudondomwena akumwenzulwila. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.8",
            "verseOrgIds": [
              "MAT.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwinenwinyi wukwila mwanindi weyala namulombi dinkendi, yena amwinki ilola? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.9",
            "verseOrgIds": [
              "MAT.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela namulombi inshi, amwinki kapela? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.10",
            "verseOrgIds": [
              "MAT.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi neyi enu atama mweluka kwinka anyanenu yamukunkulu yayiwahi, Tata yenu wudi mwiwulu abuli kubadika kuyinka akumulomba yuma yayiwahi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.11",
            "verseOrgIds": [
              "MAT.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi yejima yimunakeŋi antu kuyililenu, ninenu nawa yililenu mwomumu, muloŋa dimu mwaya nshimbi niatuprofwetu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.12",
            "verseOrgIds": [
              "MAT.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.12",
            "verseOrgIds": [
              "MAT.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iŋililenu kuchisu chanyanya; muloŋa chisu cheneni, ninjila yabwambaŋana yaya kukujilumuka, mweŋilaŋa amavulu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.13",
            "verseOrgIds": [
              "MAT.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa chisu chanyanya, ninjila yanyanya yaya kuwumi, ayimonaŋa antesha.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.14",
            "verseOrgIds": [
              "MAT.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.14",
            "verseOrgIds": [
              "MAT.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babelenu atuprofwetu akutwamba, enzaŋa kudenu avwala yitembi yanyikoku, ilaŋa mukachi hiyatuŋiwidi atuhuka. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.15",
            "verseOrgIds": [
              "MAT.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukuyilukila kunyikabu yawu. Antu akumunaŋa nyikabu yavinyu kunyiŋa? hela yikuyu kunzonzonzu, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.16",
            "verseOrgIds": [
              "MAT.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi nyitondu yayiwahi yejima yasoŋaŋa nyikabu yayiwahi, ilaŋa mutondu watama wasoŋaŋa nyikabu yatama. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.17",
            "verseOrgIds": [
              "MAT.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutondu wawuwahi hiwukutwesha kusoŋa nyikabu yatamaku, nimutondu watama hiwukutwesha kusoŋa nyikabu yayiwahuku. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.18",
            "verseOrgIds": [
              "MAT.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyitondu yejima yabulaŋa kusoŋa nyikabu yayiwahi ayitemaŋa, ayinatilaŋa mukesi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.19",
            "verseOrgIds": [
              "MAT.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu mukuyilukila kunyikabu yawu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.20",
            "verseOrgIds": [
              "MAT.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu ejima akuntenatena nawu, Mwanta, Mwanta; hiyakawanina kwijila muwanta wamwiwuluku, chiŋa muntu welaŋa muchima waTata yami wudi mwiwulu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.21",
            "verseOrgIds": [
              "MAT.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amavulu amba kaŋila hefuku odu nawu, Mwanta, Mwanta, hitwaprofweteli mwijina deyuku? Hitwafumishili ademoni mwijina deyuku? Hitwakoŋeli nyidimu yaŋovu yayivulu mwijina deyuku? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.22",
            "verseOrgIds": [
              "MAT.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu nakayakula nami, Hinayilukili hela ifuku nidimuku; fumenu kudami enu mwakoŋaŋa yakuluwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.23",
            "verseOrgIds": [
              "MAT.7.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.23",
            "verseOrgIds": [
              "MAT.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi antu ejima akutiya awa mazu amami hiyakuyila, akayifwikija neyi mukwamaana watuŋilili itala dindi helola. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.24",
            "verseOrgIds": [
              "MAT.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninvula yachabumukili, nimabaji enjili, nimpepela jakunkili, jeteli hetalodu; hidahumukiluku, muloŋa adituŋalili helola. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.25",
            "verseOrgIds": [
              "MAT.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niantu ejima akutiya awa mazu amami nákubula kuyila, akayifwikija neyi muntu wabula maana, watuŋilili itala dindi hawusekulula. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.26",
            "verseOrgIds": [
              "MAT.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninvula yachabumukili, nimabaji enjili, nimpepela jakunkili, jeteli hetalodu; dahumukili, nikuhumuka kwadu kwaswejeli.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.27",
            "verseOrgIds": [
              "MAT.7.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.27",
            "verseOrgIds": [
              "MAT.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chelili Yesu nakumishi dehi mazu awa, mazaza awantu hiyakuhayama kuleja kwindi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.28",
            "verseOrgIds": [
              "MAT.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa wadiŋi nakuyileja neyi wukweti wanta, bayi neyi ansonekuku.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.29",
            "verseOrgIds": [
              "MAT.7.29"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "MAT.8",
