  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "MAT 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu Yesu hiyakumutwala mwisaŋa kudi Spiritu, kulonda akamweseki kudi diyabolu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.1",
            "verseOrgIds": [
              "MAT.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cheliliyi naleki dehi kudya mafuku makumi awana nimwaana niwufuku, kukumininaku hakutiya nzala. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.2",
            "verseOrgIds": [
              "MAT.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukwakweseka hakwinza kudi yena, hakumwila nindi, Neyi eyi wuMwana kaNzambi, hoshaku neyi malolawa abalumuki mankendi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.3",
            "verseOrgIds": [
              "MAT.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena hakwakula nindi, Anasoneki nawu, Muntu hakuhanda namankendi hohuku, chiŋa namazu ejima akufuma mukanwa kaNzambi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.4",
            "verseOrgIds": [
              "MAT.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.4",
            "verseOrgIds": [
              "MAT.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Diyabolu hakumutwala muŋanda yajila; hakumusha hewulu dambaŋu yatembeli, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.5",
            "verseOrgIds": [
              "MAT.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakumwila nindi, Neyi eyi wuMwana kaNzambi dinati mwishina, muloŋa anasoneki nawu, Wakakulejela aŋelu jindi; wena akakwaka namakasawu wakenza kahuma mwendu weyi kwilola. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.6",
            "verseOrgIds": [
              "MAT.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakumwila nindi, Anasoneki cheŋi nawu, Bayi wakamweseka Yehova Nzambi yeyuku.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.7",
            "verseOrgIds": [
              "MAT.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.7",
            "verseOrgIds": [
              "MAT.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Diyabolu hakumutwala cheŋi hampidi yayilehi nankashi, hakumuleja mawanta ampata yamunu mwishina ejima, ni kulema kwawu; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.8",
            "verseOrgIds": [
              "MAT.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakumwila nindi, Neyi wukudinata heseki nakudifukula kudami, nukukwinka yuma yejimiyi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.9",
            "verseOrgIds": [
              "MAT.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakumwila nindi, Fumaku eyi Satana, muloŋa anasoneki nawu, Kadifukulaŋa kudi Yehova Nzambi yeyi, wakakalakelaŋa yena hohu kanka windi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.10",
            "verseOrgIds": [
              "MAT.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu diyabolu hakumushiya; kutala aŋelu hiyakwinza nakumukalakela.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.11",
            "verseOrgIds": [
              "MAT.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.11",
            "verseOrgIds": [
              "MAT.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu chanatiyiyi nawu Yowanu anamukwati, hakufumaku hakuya muŊaliliya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.12",
            "verseOrgIds": [
              "MAT.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanafumiyi kuNazareta, hakuya nakushakama kuKaperinawu wudi kwijiya, muŋinza jaZebuluni naNafwatali, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.13",
            "verseOrgIds": [
              "MAT.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulonda mwahosheliyi kaprofwetu Isaya mulumbuluki, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.14",
            "verseOrgIds": [
              "MAT.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "mweliliyi nindi, Ituŋa daZebuluni niituŋa daNafwatali, kumbadi yejiya, kwishinadi daYodana, Ŋaliliya yawaJentili; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.15",
            "verseOrgIds": [
              "MAT.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "antu ashakamini mumwidima amweni chejeji chacheni, ninawa ashakamini mwituŋa dawulelu wakufwa amweni kucha.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.16",
            "verseOrgIds": [
              "MAT.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.16",
            "verseOrgIds": [
              "MAT.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kufuma henohu, Yesu hakutachika kushimuna nindi, Balumukenu munyichima yenu, muloŋa wanta wamwiwulu wunashiki dehi kwakwihi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.17",
            "verseOrgIds": [
              "MAT.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.17",
            "verseOrgIds": [
              "MAT.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chadiŋi nakwendayi kwijiya daŊaliliya, hakumona amayala ayedi ivumu dawu dimu, iwu Shimona atumbiluwu nawu Petulu, iwu mana kwindi Anderi, adiŋi nakuumba wanda mwijiya, muloŋa adiŋi yibinda yanshi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.18",
            "verseOrgIds": [
              "MAT.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyila nindi, Inzenu mumondaŋa niyisukuli wubinda wawantu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.19",
            "verseOrgIds": [
              "MAT.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hohenohu ashiya nimawandawu, hiyakumulonda. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.20",
            "verseOrgIds": [
              "MAT.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuswilaku cheŋi, hakumona amayala amakwawu ayedi, niwena nawa ivumu dawu dimu, iwu mwana kaZebedewu Yakoba, nimana kwindi Yowanu, adi muwatu natata yawu Zebedewu, adi nakutuŋiulula mawandawu; hakuyitambika. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.21",
            "verseOrgIds": [
              "MAT.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hohenohu ashiya niwatu nitata yawu, hiyakumulonda.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.22",
            "verseOrgIds": [
              "MAT.4.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.22",
            "verseOrgIds": [
              "MAT.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakwendujola mwahita Ŋaliliya yejima nakuyilejaleja mumashikolawu, nikushimuna nsaŋu yawanta yayiwahi, nikuuka nyisoŋu yeŋi nayeŋi, niyikatu yeŋi nayeŋi yadiŋi nawantu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.23",
            "verseOrgIds": [
              "MAT.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpuhu yindi yitiyakana nimuSiriya kwejima ti-li-li; niwena hiyakumuletela antu akata ejima, akwachika nyisoŋu yeŋi nayeŋi, niamona yihuŋu, niazakukaŋa ademoni, niakwachinkonya, niakwakalepa; yena hakuyikolesha. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.24",
            "verseOrgIds": [
              "MAT.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazaza awantu hiyakumulonda, afumini kuŊaliliya, nikuDekapoli, nikuYerusalema, nikuYudeya, nikwishinadi daYodana.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.25",
            "verseOrgIds": [
              "MAT.4.25"
            ]
          }
        }
      ]
    }
  ],
