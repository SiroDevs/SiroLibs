  "verseCount": 58,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "MAT 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifuku dodenodu Yesu hakwidika mwitala, hakushakama kuchi kumu chejiya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.1",
            "verseOrgIds": [
              "MAT.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazaza awantu hiyakumupompela, dichi hakwijila nakushakama muwatu; izaza dejima hidikwimana kuchi kumu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.2",
            "verseOrgIds": [
              "MAT.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuhosha nawu yuma yayivulu nayishimu, nindi, Talenu, mukwakukuwa mbutu wayili nakukuwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.3",
            "verseOrgIds": [
              "MAT.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chakuwiliyi jikwawu jaholokeleli kunsa yanjila; atujila hiyakwinza nakujidya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.4",
            "verseOrgIds": [
              "MAT.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jikwawu jaholokeleli hamalola, habulili maseki amavulu; jibaluka nihohenohu, muloŋa habulili maseki amavulu kwishina. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.5",
            "verseOrgIds": [
              "MAT.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itaŋwa chidinashiki mwiwulu hijikubabika, hijikuuma muloŋa jabulili nyiji. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.6",
            "verseOrgIds": [
              "MAT.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jikwawu jaholokeleli munyiŋa; oyu nyiŋa hiyikukula, hiyikujika mbutu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.7",
            "verseOrgIds": [
              "MAT.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jikwawu jaholokeleli hamaseki amawahi; hijikusoŋa mbutu, jikwawu nkulakaji, jikwawu makumi atanu nadimu, jikwawu makumi asatu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.8",
            "verseOrgIds": [
              "MAT.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowu wukweti matu akutiya, atiyi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.9",
            "verseOrgIds": [
              "MAT.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.9",
            "verseOrgIds": [
              "MAT.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atumbanji hiyakwinza nakumwila nawu, Wahoshelaŋadi nawu nayishimu? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.10",
            "verseOrgIds": [
              "MAT.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena hakuyakula nindi, Enu anayiteji kwiluka nsaŋu jawanta wamwiwulu jajindawu, hakwila wena hiyanayitejuku. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.11",
            "verseOrgIds": [
              "MAT.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wukweti akamwinka, wakaheta yayivulu; hakwila wabula akamutambula ninaka kadiyi naku. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.12",
            "verseOrgIds": [
              "MAT.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi nahoshaŋa nawu nayishimu; muloŋa chamonaŋawu hiyamonaŋaku, chatiyaloŋawu hiyatiyaloŋaku, hela kwiluka hiyelukaŋaku. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.13",
            "verseOrgIds": [
              "MAT.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hansaŋu yawena, wuprofwetu waIsaya wunalumbuluki, weliliyi nindi, Kutiya mwakatiya, himwakashinshika nihantuku; kumona mwakamona, himwakeluka nihantuku. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.14",
            "verseOrgIds": [
              "MAT.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa antu awa nyichima yawu anayisupishi, nimatu awu anajiki, nimesu awu anajimi; akenda kamona namesu awu, akenda katiya namatu awu, akenda kashinshika munyichima yawu; kuchina kubalumuka cheŋi hinukuyuka. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.15",
            "verseOrgIds": [
              "MAT.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwila mesu enwenu anakooleki, muloŋa amonaŋa; nimatu enu, muloŋa atiyaloŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.16",
            "verseOrgIds": [
              "MAT.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa nukuyileja chalala nami, atuprofwetu amavulu niantu aloŋa akeŋeli nawu amoni yumiyi yimukumonenu, hiyayimwenuku; nawu atiyi yuma yimukutiyenu, hiyayitiyiluku.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.17",
            "verseOrgIds": [
              "MAT.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.17",
            "verseOrgIds": [
              "MAT.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi tiyenu chishimu chamukwakukuwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.18",
            "verseOrgIds": [
              "MAT.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu wukwila chakutiyayi mazu awanta, yena kumulumbulukila nehi, watama hakwinza nakuhukula yanakuwuwu mumuchima windi. Diyi anakuwuwu kunsa yanjila. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.19",
            "verseOrgIds": [
              "MAT.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anakuwuwu hamalola diyi wukwila chakutiyayi mazu, hakuyitambula namuzaŋalu hohenohu; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.20",
            "verseOrgIds": [
              "MAT.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ilaŋa hakweti muji mudi yomweninduku, wukukakelahu chanti, chikukwinza lukadi hela ikabisha dahansaŋu yamazu, hohenohu yodimbuka nikudimbuka. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.21",
            "verseOrgIds": [
              "MAT.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anakuwuwu mukachi kanyiŋa, diyi muntu wukwila chakutiyayi mazu, kwakama kwamakonu nikudimbana kwamaheta hikukuvumbisha mazu, niyena wukwi kala wakasoŋaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.22",
            "verseOrgIds": [
              "MAT.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anakuwuwu hamaseki amawahi, diyi muntu wukwila chakutiyayi mazu, hiyakumulumbulukila; chalala diyi wukusoŋa, iwu nkulakaji, iwu makumi atanu nadimu, iwu makumi asatu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.23",
            "verseOrgIds": [
              "MAT.13.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.23",
            "verseOrgIds": [
              "MAT.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyitila chishimu chikwawu nindi, Wanta wamwiwulu wudi neyi muntu wakuwili mbutu yayiwahi mwiha dindi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.24",
            "verseOrgIds": [
              "MAT.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa ntu chakaminuwu tulu, mukwankunyi nindi hakwinza nakukuwa mbutu yamatahu mukachi katidiku, hakudiyila kwindi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.25",
            "verseOrgIds": [
              "MAT.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa chabalukili nyitombu hiyikusakumuna, matahu hiyakumwekana nawa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.26",
            "verseOrgIds": [
              "MAT.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋamba jamwiniitala hiyakwinza nakumwila nawu, Mwanta, hiwakuwili mbutu yayiwahi mwiha deyuku? ndochu matahu anafumihi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.27",
            "verseOrgIds": [
              "MAT.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena hakuyila nindi, Anachili kudi mukwankunyi nami. Aŋamba hiyakumwila nawu, Wunakeŋi tuyi nakuyikuŋulamu, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.28",
            "verseOrgIds": [
              "MAT.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa yena nindi, Nehi, mwakenza kela chimukukuŋulamu matahu, mukubwitila kumu nitidiku. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.29",
            "verseOrgIds": [
              "MAT.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jikulili tuhu kumu jejima nihakumuna; hachila aka chakumuna nakayila akwakumuna nami, Sambilenu kukuŋulamu matahu, muyikasi yita mwakayochi; hakwila tidiku muyiku-ŋwili munkalaŋa yami.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.30",
            "verseOrgIds": [
              "MAT.13.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.30",
            "verseOrgIds": [
              "MAT.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyitila chishimu chikwawu nindi, Wanta wamwiwulu wudi neyi kalubutu kamostadi kamu kanoneni muntu, hakukatumba mwiha dindi; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.31",
            "verseOrgIds": [
              "MAT.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "chalala diku kalubutu kakuminamu kukeha hambutu jejima, ilaŋa chikakukula hikakubadika yisakola yejima, hikakwikala mutondu hindi, wakwila niatujila ahaluzwizu hiyakwinza nakutuŋila yisakala yawu kunyitayi yawu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.32",
            "verseOrgIds": [
              "MAT.13.32"
            ]
          }
        }
      ]
    },
    {
