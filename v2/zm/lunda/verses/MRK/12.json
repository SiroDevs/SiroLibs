      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MRK 12:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.40",
            "verseOrgIds": [
              "MRK.12.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MRK 12:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakushakama kwatalaŋana nachikasha chakusha mali; hakutala izaza chidikuumbila mali muchikasha, amavulu adiŋi aheta ombililumu mali amavulu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.41",
            "verseOrgIds": [
              "MRK.12.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MRK 12:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwenjili kazweŋi, nfwila wamumbanda, hakúumbilamu tumali twanyanya tuyedi, kuyibomba ashika mukadali kamu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.42",
            "verseOrgIds": [
              "MRK.12.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MRK 12:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakutambika atumbanji twindi, hakuyila nindi, Nukuyileja chalala nami, iwu nfwila kazweŋi nombilumu yakubadika ejima adi nakuumbila mali muchikasha; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.43",
            "verseOrgIds": [
              "MRK.12.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MRK 12:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa wejima wawu anombilumu yakuyuma yawu yasweja kuvula; ilaŋa iwu mumbanda nombilumu yakuwuzweŋi windi yoyindi yejima yadiŋi yakudihandisha nachu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.44",
            "verseOrgIds": [
              "MRK.12.44"
            ]
          }
        }
