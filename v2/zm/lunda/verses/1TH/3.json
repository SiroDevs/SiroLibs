    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TH 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi chitwakaŋenyi kuditulisha mumuchima, twatoŋojokeli netuchachiwahi kushala kanka wetu kuAtenisi; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.1",
            "verseOrgIds": [
              "1TH.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "hitukutemesha mana kwetu Timotewu, himukwakukalakela Nzambi munsaŋu yaKristu yayiwahi, netu ayikoleshi nakuyikundeja munsaŋu jakukuhwelela kwenu; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.2",
            "verseOrgIds": [
              "1TH.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TH 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulonda kubuli muntu wukutiya kutama nanochu chakumukabishawu. Muneluki mwenomu dimu mwatufuukwililuwu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.3",
            "verseOrgIds": [
              "1TH.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa chalala chitwadiŋi nenu, twayilejelaŋahu dehi netu akutukabishaŋa; dichi chinamwekani dehi, ninenu munelukumu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.4",
            "verseOrgIds": [
              "1TH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi ami, chinakaŋenyi kuditulisha mumuchima, hinukutemesha Timotewu, kulonda nakeluki munekali kukuhwelela kwenu; nami hadaha anayeseki dehi kudi mukwakweseka, ni kukabakana kwetu kuneli dehi kwamukunkulwayi.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.5",
            "verseOrgIds": [
              "1TH.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.5",
            "verseOrgIds": [
              "1TH.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TH 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa chanafumiyi Timotewu kudenu, ashiki kudetu nakutuletela nsaŋu jakuluŋa jakukuhwelela kwenu nakukeŋa kwenu, nindi mwatwanukaŋa chachiwahi mafuku ejima, nindi mwakeŋa a nankashi kutumona neyi chitunakeŋi etu nawa kuyimonenu, tutiya nimumuchima hi-i. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.6",
            "verseOrgIds": [
              "1TH.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TH 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu enu ana kwetu, chitwadiŋi nakumona kukala nalukadi, tunadikundeji dehi hansaŋu yenu nakukuhwelela kwenu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.7",
            "verseOrgIds": [
              "1TH.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TH 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa tunahandi neyi enu mukwimana mudi Mwanta ngu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.8",
            "verseOrgIds": [
              "1TH.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tukutwesha ŋahi kumusakilila Nzambi namuzaŋalu wejima wutwayizaŋalelaŋa kumesu aNzambi? ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.9",
            "verseOrgIds": [
              "1TH.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TH 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wufuku namwa ana twalombaŋa nankashi netu tuyimoni kumesu, netu twakawanishi chashala kukukuhwelela kwenu.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.10",
            "verseOrgIds": [
              "1TH.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TH 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.10",
            "verseOrgIds": [
              "1TH.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TH 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yomweni Nzambi yetu, yowu Tata, niMwanta wetu Yesu, atulomboli munjila yetu yakuya kudenu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.11",
            "verseOrgIds": [
              "1TH.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TH 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta ayivulishili kukeŋaŋana kwasweja, nikukeŋa antu ejima, neyi chitwelaŋa etu nawa nanenu; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.12",
            "verseOrgIds": [
              "1TH.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulonda akoleshi nyichima yenu yibuli hakuyinkela muloŋa mukujila kumesu aNzambi yetu, yowu Tata, hakenzayi Mwanta wetu Yesu nawantu indi ajila ejima.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.13",
            "verseOrgIds": [
              "1TH.3.13"
            ]
          }
        }
      ]
    }
  ],
