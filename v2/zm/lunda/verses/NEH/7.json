          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atupristu; anyana kaYedaya, akwamutaŋa waYeshuwa, makulakaji atanu nawana namakumi atanu nayedi nawantu asatu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.39",
            "verseOrgIds": [
              "NEH.7.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NEH 7:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kalmeri, ikombakaji namakumi atanu nawantu ayedi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.40",
            "verseOrgIds": [
              "NEH.7.40"
            ]
          }
        },
        {
          "name": "verse",
