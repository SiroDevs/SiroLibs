            "sid": "NEH 7:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "ALevi; anyana kaYeshuwa naKadimiyeli, akudi anyana kaHodeva, makumi atanu nayedi nawantu awana. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.43",
            "verseOrgIds": [
              "NEH.7.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
