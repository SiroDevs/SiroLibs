              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kawambuŋa Solomoni; anyana kaSotayi, anyana kaSofwenaeti, anyana kaPerida; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.57",
