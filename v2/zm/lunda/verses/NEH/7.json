            "sid": "NEH 7:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwakwimba tumina; anyana kaAsafwi nkulakaji namakumi awana natanu nasatu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.44",
            "verseOrgIds": [
              "NEH.7.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NEH 7:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kawakwaku hembakuyisu; anyana kaShalumi, anyana kaAteri, anyana kaTalimoni, anyana kaAkubi, anyana kaHatita, anyana kaShobayi, nkulakaji namakumi asatu natanu nasatu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.45",
            "verseOrgIds": [
              "NEH.7.45"
            ]
          }
        }
