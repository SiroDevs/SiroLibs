          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "anyana kaShefwatiya, anyana kaHatili, anyana kaPokereti wakuZebayimi, anyana kaAmoni. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.59",
            "verseOrgIds": [
              "NEH.7.59"
            ]
          }
        },
