          },
          "items": [
            {
              "text": "60",
              "type": "text"
            }
          ]
        },
        {
          "text": "ANetini ejima, nianyana kawambu paSolomoni, ashikili mumakulakaji asatu namakumi atanu nawana nawantu ayedi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.60",
            "verseOrgIds": [
              "NEH.7.60"
            ]
          }
        }
