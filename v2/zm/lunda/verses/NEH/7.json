          },
          "items": [
            {
              "text": "70",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akulumpi amakwawu akumavumu awankakulula jawu hiyakuhanayuma kumudimu. Nŋuvulu waheneni jidariki jawuru ikombakaji, mbashilamakumi atanu, yi kovwelu yakuvwala atupristu makulakaji atanu namakumi asatu mwitala dakuswekela yuma yalema. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.70",
            "verseOrgIds": [
              "NEH.7.70"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "71",
            "style": "v",
            "sid": "NEH 7:71"
          },
          "items": [
            {
              "text": "71",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akulumpi amakwawu akumavumu awankakulula aheneni jidariki jawuru makombakaji makumi ayedi, ŋŋipa wundi jasiliva makombakaji ayedi namakulakaji ayedi mwitala dakuswekela yuma yalema yamudimu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.71",
            "verseOrgIds": [
              "NEH.7.71"
            ]
          }
        },
        {
