          },
          "items": [
            {
              "text": "66",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chipompelu chejima kuchibombela hamu, chashikili mumakombakaji awantu makumi awana namakombakaji ayedi, namakulakaji asatu, namakumi atanu nadimu; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.66",
            "verseOrgIds": [
              "NEH.7.66"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "67",
            "style": "v",
            "sid": "NEH 7:67"
          },
          "items": [
            {
              "text": "67",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubombelaku aŋamba jawu amayala nawambandaashikili mumakombakaji atanu nayedi namakulakaji asatu namakumi asatu nawantu atanu nayedi. Adiŋi nawakwakwimba tumina amayala nawambanda makulakaji ayedi namakumi awana natanu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.67",
            "verseOrgIds": [
              "NEH.7.67"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "68",
            "style": "v",
            "sid": "NEH 7:68"
          },
          "items": [
            {
              "text": "68",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuwalu twawu, makulakaji atanu nayedi namakumi asatu natanu nawumu; yingonŋavaluyawu, makulakaji ayedi namakumi awana nayitanu; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.68",
            "verseOrgIds": [
              "NEH.7.68"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "69",
            "style": "v",
            "sid": "NEH 7:69"
          },
          "items": [
            {
              "text": "69",
              "type": "text"
            }
          ]
        },
        {
          "text": "anŋameli makulakaji awana namakumi asatu natanu; yimbulu, makombakaji atanu nadimuna makulakaji atanu nayedi namakumi ayedi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.69",
            "verseOrgIds": [
              "NEH.7.69"
            ]
          }
        }
      ]
    },
