          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "anyana kaYayara, anyana kaDarikoni, anyana kaGideli; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.58",
