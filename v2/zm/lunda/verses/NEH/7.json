              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaPashuri, ikombakaji namakulakaji ayedi namakumi awana natanu nayedi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.41",
            "verseOrgIds": [
