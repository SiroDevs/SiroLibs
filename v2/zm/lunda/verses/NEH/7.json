          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaHarimi, ikombakaji nekumi natanu nayedi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.42",
            "verseOrgIds": [
              "NEH.7.42"
            ]
          }
        },
        {
          "name": "verse",
