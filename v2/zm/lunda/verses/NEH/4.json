      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambalati chatiyiliyi nawu hitukutuŋa mpwembu, hakuzuwa, hakutiya kumuchima bwi, hakuyiseha aYudeya. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.1",
            "verseOrgIds": [
              "NEH.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuhosha nawanakwindi, nanjita yamuSamariya, nindi, Awa aYudeya akadi Ŋovu adi nakwilaŋahi? Keŋa adihatilumu tahindi? Keŋa aketuli yimuna tahindi? Amanishi ifuku dimu hohu tahindi? Asaŋuli malola adi munyilumba yanswadi ochawu dehi, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.2",
            "verseOrgIds": [
              "NEH.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "KaAmoni Tobiya kwokwadiŋiyi, hakuhoshanindi, Chakutuŋawu china hela neyi mumbu wukuyaku wukuhumunampwembu yawu yamalola. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.3",
            "verseOrgIds": [
              "NEH.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi Nzambi yetu tiyaku, anatudiwuli. Yilubwili hanyitu yawu kusawula kwanatusawuluwu, wuyimweshi kuyibuwa mwituŋa dawudupu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.4",
            "verseOrgIds": [
              "NEH.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi wubuta kuluwa kwawuku, nshidi yawu bayi ayijimaŋesha kumesu eyuku, muloŋa anakuvuloki dehi kumesu awakwakutuŋa wuzuwi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.5",
            "verseOrgIds": [
              "NEH.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.5",
            "verseOrgIds": [
              "NEH.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saŋa twatuŋila mpwembu, mpwembu yejima yinupaŋana nikunuŋaŋana, yishika nihakachi kamuwuzandamu, muloŋa antu adiŋi namuchimawa kukalakala.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.6",
            "verseOrgIds": [
              "NEH.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.6",
            "verseOrgIds": [
              "NEH.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ASambalati naTobiya, niaArabiya, niaAmoni, niaAshidodi, chatiyiluwunawu mudimu wakutupulula mpwembu jaYerusalema hiwukuya kumbidi, nihahumoka humoka anajikajikuhu dehi, aswejeli kuzuwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.7",
            "verseOrgIds": [
              "NEH.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wejima wawuhiyakukwata mpùŋa yawu yatama, nawu, Tuyenu twakalwi naYerusalema kulonda twakayiluwaŋeshi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.8",
            "verseOrgIds": [
              "NEH.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etu hitukulomba kudi Nzambi yetu, hitukwimikaku atulama akuyitalaŋa nimwaana niwufuku, kuchina kutukasumwishakudi wena.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.9",
            "verseOrgIds": [
              "NEH.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.9",
            "verseOrgIds": [
              "NEH.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "AYuda nawu, Ŋovu jawakwakusenda yiteli jinakehi dehi, nswadijina sweji, keŋa tukapanyi kutuŋa mpwembu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.10",
            "verseOrgIds": [
              "NEH.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alewankunyi netu nawu, Hiyakachilukaku, hiyakatumonaku, akakasumuka tunashi ki dehi mukachikawu, hitukuyijaha, hitukulekesha nimudimu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.11",
            "verseOrgIds": [
              "NEH.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.11",
            "verseOrgIds": [
              "NEH.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chenjiluwu aYudeya ashakamini nawena, hiyakufu mafuma kwejima, hiyakutwila mapampaikumi, nawu, Chachiwahi enu kufunta kudetu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.12",
            "verseOrgIds": [
              "NEH.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumalupa akwishinada mpwembu kunyima kwakadi kujika hinukushaku antu mwahita yisakayawu, nampoku jawu jatubali, namayopawu, nimatawu anyikunji. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.13",
            "verseOrgIds": [
              "NEH.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinukutala, hinukunyamuka nakuyila atulamba nawanyuli nawantu amakwawu, nami, Bayi muyitiya womaku; anukenu Mwanta, himuneni, wakutiya womanankashi, mulwili ana kwenu nawanyanenu amayala nawambanda, niaŋodŋenu, nimatalenu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.14",
            "verseOrgIds": [
              "NEH.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.14",
            "verseOrgIds": [
              "NEH.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayilumbu jetu chatiyiluwu nawu tunachiluki dehi niNzambi nabayishi dehi mpupa yawu, hitukufunta wejima wetu kumpwembu, iwu kumudi muwindi, iwu kumudimu windi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.15",
            "verseOrgIds": [
              "NEH.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kufuma henohu chibalu chawaŋambajami chimu hiyakukala kalaŋa mudimu, chibalu chikwawu hiyakukwataŋa mayoŋa nankebu namata anyikunji nayikovwelu yatumaleŋi; anyuli adini kunyima yawakwetala daYuda ejima. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.16",
            "verseOrgIds": [
              "NEH.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adiŋi nakutuŋa mpwembu, ninawa asendelaŋa yiteli, adiŋi nakuditwika wejima wawu, elili chikasachimu chidi nakukalakala mudimu, chikwawu chinakwati chitwa chindi, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.17",
            "verseOrgIds": [
              "NEH.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "niakwakutuŋa wejima wawu akasa mpoku jawu jatubali hambunda jawu, hiyakutuŋapa. Mukwakwimba mpupa wadiŋi kudami.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.18",
            "verseOrgIds": [
              "NEH.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.18",
            "verseOrgIds": [
              "NEH.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinukuyila atulamba nawanyuli nawantu amakwawu, nami, Mudimuweneni watandumuka, ninetu tunatandami hampwembu, iwu hahalehinamukwawu, iwu hahalehi namukwawu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.19",
            "verseOrgIds": [
              "NEH.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NEH 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonsu kumukutiyila mpùŋa, pu-u, himwakahwila kudetu; Nzambi yetu wakatulwila.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.20",
            "verseOrgIds": [
              "NEH.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NEH 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.20",
            "verseOrgIds": [
              "NEH.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NEH 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hitukukalakala mudimu, chibalu chawantu chimu chinakwati mayopa, kufumisha hankunku yakucha kushika nihamwekanaŋa tutumbwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.21",
            "verseOrgIds": [
              "NEH.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NEH 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamafuku owu nawa nayilili antu, nami, Antu ejima akakamaŋa muYerusalema hamu nawaŋamba jawu, kulonda akekalaŋa atulama twetu nawufuku, namwa ana akakalakalaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.22",
            "verseOrgIds": [
              "NEH.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NEH 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heja ami, hela ana kwami, hela aŋamba jami, hela atulama anlondelapa munyima, hosi wavúulilaŋa mahininduku, wejimawetu kuya kumeji niyitwa yetu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.23",
            "verseOrgIds": [
              "NEH.4.23"
            ]
          }
        }
      ]
    }
