          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.14",
            "verseOrgIds": [
              "NEH.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisu chakukaseloki achituŋulwili kudi mwana kaKolihoze Shaluni, nyuli yampata yakuMizipa; diyi wachituŋali, wachibutili, washilukuyenzelu yachu, nitupatishu twachu, ninyikomenu yachu, watuŋili nimpwembu yakwijiya dakuSilowa kwitempa damwanta, kushika nikunkandaminu jakunkumukilaŋawu hafumaŋawu mumukala waDavidi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.15",
            "verseOrgIds": [
              "NEH.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.15",
            "verseOrgIds": [
              "NEH.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyima yindi mwatuŋulwili mwana kaAzibuki Nehemiya, nyuliyachibalu champata yakuBetizuri, kushika nikwiluŋa datalaŋana namajamu aDavidi, nikwijiya deliluwu, nikwitala dawayilobu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.16",
            "verseOrgIds": [
              "NEH.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NEH 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.27",
            "verseOrgIds": [
              "NEH.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NEH 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hewulu dachisu chawatuwalu hatuŋulwili atupristu, iwu hatalaŋana netala dindi yomweni, iwu hatalaŋana netala dindi yomweni. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.28",
            "verseOrgIds": [
              "NEH.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NEH 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyima yawu mwatuŋulwili mwana kaImeri Zadoki, hatalaŋana netala dindiyomweni. Munyima yindi mwatuŋulwili mwana kaShekaniya Shemaya, mukwakuhemba kuchisu chakumusela. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.29",
            "verseOrgIds": [
              "NEH.3.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyima yindi mwatuŋulwili mwana kaShelemiya Hananiya, namwana kaZalafu Hanuni, wamuchitanu nawumu, chibalu chikwawu. Munyima yindi mwatuŋulwili mwana kaBerekiya Meshulami hatalaŋana netala dindi dahewulu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.30",
            "verseOrgIds": [
              "NEH.3.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyima yindi mwatuŋulwili Malikiya, muchi wawuru wumu, washikŋili kwitalada waNetini, nidawa kwakulandulula, kwatalaŋana nachisu chahaMifwikadi, kushika nikuwukandaminu wakwiwombu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.31",
            "verseOrgIds": [
              "NEH.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NEH 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakachi kakuwukandaminu wakwiwombu nachisu chanyikoku hatuŋulwili achiŋi awuru nawakwakulandulula.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.32",
            "verseOrgIds": [
              "NEH.3.32"
            ]
          }
        }
      ]
