          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dena ifuku odu atapili mukanda waMosi iku antu adi nakutiya. Awenumu anasoneki nawu, KaAmoni nakaMowabi kwijila muchipompelu chaNzambi chinjila, chahaya nyaka; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.1",
            "verseOrgIds": [
              "NEH.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "muŋa abulili kukinkilila anyana kaIsarela nayakudya nameji, hiyakuyilobela Balami kulonda ayishipi; Nzambi yetu hakubalumuna ishipu hidikwikala nkisu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.2",
            "verseOrgIds": [
              "NEH.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chatiyiluwulushimbi olu, hiyakwambula kudi aIsarela luntu lwejima lwawantu adibomba acheŋi nawacheŋi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.3",
            "verseOrgIds": [
              "NEH.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.3",
            "verseOrgIds": [
              "NEH.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Helili yumiyi yichidi kanda, kapristu Eliyashibi, akunjikiluwu kumudimu wakutalaŋa matala amwitala daNzambi yetu, wakwatili wubwambuna Tobiya. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.4",
            "verseOrgIds": [
              "NEH.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamuloŋesheleli itala deneni daswekelelaŋawu nyilambuyawuŋa, nilibona, ninyitondu, niyamwikumi yakudya kwansaachi, niyavinyu, niyamanji yenkelapawu aLevi nawakwakwimba nawakwakuhembakuyisu mwayilejeluwu; ninyilambu yakuleleka yawatupristu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.5",
            "verseOrgIds": [
              "NEH.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwejimomu hinadiŋi kuYerusalemaku. Muloŋa mumwaka wamakumi asatunakayedi wamwanta wakuBabiloni Aratasheshe, nayili kudi mwanta; chimwahitili mafuku namulombeli mwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.6",
            "verseOrgIds": [
              "NEH.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinukufunta kuYerusalema, hinukwiluka chuma chatama chanamwililuwu Tobiya kudi Eliyashibi, chakumulopeshela itala muyipapu yakwitala daNzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.7",
            "verseOrgIds": [
              "NEH.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chantiyishili kutama nankashi, yuma yaTobiya yamwitala yejima hinukuyinatila hanzi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.8",
            "verseOrgIds": [
              "NEH.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinukuyileja, hiyakujilika mumatala; hinukuletamu cheŋi yuma yamwitala daNzambi hamu nanyilambu yawuŋa nalibona.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.9",
            "verseOrgIds": [
              "NEH.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.9",
            "verseOrgIds": [
              "NEH.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinukumona nami komana maseka awaLevi hiyayinkelaŋa wuku, niwena aLevi nawakwakwimba tumina aditemokela dehi, iwu kwiha dindi, iwu kwiha dindi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.10",
            "verseOrgIds": [
              "NEH.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinukuyihoshola anyuli, nami, Itala daNzambi anadilekelidi? Hinukuyipompesha hamu, hinukuyiimika hemenaŋawu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.11",
            "verseOrgIds": [
              "NEH.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "AYuda ejima hiyakuieta yamwikumi yakudya kwansaachi, niyavinyu, niyamanji, mumatala akuswekela yuma. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.12",
            "verseOrgIds": [
              "NEH.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwakusweka yuma hinukuyikunjika kumudimu wakutala matala akuswekela yuma, diwu kapristu Shelemiya, nansoneki Zadoki, naPedaya wakudi aLevi; mukwakuyikwasli aHanani mwana kaZakuri, Zakuri mwana kaMataniya. Muloŋa diwuamwenuwu kushinshika, diwu nawa adiŋi namudimu wakwanjapena anakwawu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.13",
            "verseOrgIds": [
              "NEH.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi Nzambi vami ntoŋuhu nansaŋu iyi, bayi wujima nvidimuyami yayiwahi yinakopela dehi itala daNzambi vami niyinakoŋela dehi yijilayaduku. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.14",
            "verseOrgIds": [
              "NEH.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamafuku owu namweni muYuda amakwawu adi nakudatola muwuka mwinu wavinyu hasabata, adi nakuleta yita, adi nakutwikatwika yimbulu; adi nakuleta muYerusalema mwifuku dasabata nivinyu yayemi, ninyikabuyanyivinyu, niyikuyu, niyiteli yeŋi nayeŋi. Hinukuyitotamu mwifukudalandishiluwu yakudya. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.15",
            "verseOrgIds": [
              "NEH.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "AkwaTira adiŋi nakushakamamu, adiŋi nakuletamu inshi, nayuma yakulanda yeŋi nayeŋi, adiŋi nakuyilandisha hasabata, nikudi aYuda, nimuYerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.16",
            "verseOrgIds": [
              "NEH.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.16",
            "verseOrgIds": [
              "NEH.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinukuyihoshola atulamba twawaYuda, hinukuyila nami, Ichichumachatama chimudi nakwila hichumanyi? Mujilolaŋa tuhu ifuku dasabata?",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.17",
            "verseOrgIds": [
              "NEH.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NEH 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.22",
            "verseOrgIds": [
              "NEH.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NEH 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamafuku owu namweni nawa aYudeya amakwawu asumbwili ambanda akuAshidodi, nakuAmoni, nakuMowabi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.23",
            "verseOrgIds": [
              "NEH.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyanawu adiŋi nakuhosha chibalu chimu idimi dakuAshidodi, kutwesha kuhosha idimi dawaYudeyanehi, chiŋa madimi awantu acheŋi nawacheŋi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.24",
            "verseOrgIds": [
              "NEH.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NEH 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinukuyihoshola, hinukuyishiŋa, amakwawu hinukuyeta, hinukuyipela nsuki jawu, hinukuyisanyikishanami, Sanyikenu Nzambi; nami, Bayi mwakasumbwishapa anyanenu awambanda kudi anyanawuku, hela anyanenu amayala bayi muyisumbwila anyanawuku, hela kudisumbwila enu aweni. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.25",
            "verseOrgIds": [
              "NEH.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NEH 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wawaIsarela Solomoni havulumwini nayumiyuku? Kutoŋa munyuza yayivuluhi mwadiŋi mwanta wudi neyi yenaku, amukeŋeli kudi Nzambi yindi, Nzambi wamudiishili wanta wawaIsarela ejima. Chikaŋa yena amuvulumwishili kudi ambanda akwacheŋi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.26",
            "verseOrgIds": [
              "NEH.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NEH 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komana etu tutiyilili kudenu twilikutama kwatoha chi kuma hichi, tumotoki Nzambi yetu, tusumbuli ambanda akwacheŋi? ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.27",
            "verseOrgIds": [
              "NEH.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NEH 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana wakudi anyana kaYoyada, mwana kakapristu muneni Eliyashibi, wadiŋi mukwesanu waSambalati wakuHoroni. Hinuku mutemunanami, Fumaku. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.28",
            "verseOrgIds": [
              "NEH.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NEH 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi Nzambi yami yanuki nanichi chanajiloluwu niwupristu, nichitiyaŋenu chawupristu nichawa. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.29",
            "verseOrgIds": [
              "NEH.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinukuyitookesha chakuyifumisha enyi ejima, hinukuyikunjika kuwukoŋeluwa watupristu nawaLevi, iwu namudimu windi, iwu namudimu windi; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.30",
            "verseOrgIds": [
              "NEH.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "niwamulambu wanchawa wakulambula hayishiikawu, hayishiikawu, niwayakudya yatachi. Eyi Nzambi yami, ntoŋuhu yayiwahi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.31",
            "verseOrgIds": [
              "NEH.13.31"
            ]
          }
        }
      ]
    }
  ],
