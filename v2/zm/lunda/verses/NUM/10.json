              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyamukili kumpidi yaYehova, endeli lwendu lwawu mafuku asatu; chimbaŋu chachitiyaŋenu chaYehova chatwaminini kumbidi lwendulwa mafuku asatu, kulonda kuyitondela hakunookela. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.33",
            "verseOrgIds": [
              "NUM.10.33"
