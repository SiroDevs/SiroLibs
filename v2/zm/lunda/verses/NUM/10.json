    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wahosheli naMosi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.1",
            "verseOrgIds": [
              "NUM.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, T uŋaku mpuŋa jasiliva jiyedi, wakajituŋa jakuchila chakuchila, jeyi jakutambikaŋa nachuchipompelu, kulonda kunyamwishaŋa nachu yilombu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.2",
            "verseOrgIds": [
              "NUM.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chakajimbawu, chipompelu chejima liichakapompa kudeyi kuchisu chetenti dakubulakena. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.3",
            "verseOrgIds": [
              "NUM.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chakwimbawu yimu, atulamba, wowu anyanta amakombakaji awaIsarela, akapompa kudeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.4",
            "verseOrgIds": [
              "NUM.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimukwimba pu-u-u, yilombu yidi kumutambawamusela hiyakunyamuka hiyakuya munjila yawu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.5",
            "verseOrgIds": [
              "NUM.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimu kwimbaka muchiyedi pu-u-u, yilombu yidi kumutamba wakabeta kakuchidiilu yakanyamuka, hiyakaya munjila yawu; hakanyamukawu akemba pu-u-u. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.6",
            "verseOrgIds": [
              "NUM.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi munakeŋi kupompesha antu ejima mwakembaŋa, ilaŋa kwimbachawoma nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.7",
            "verseOrgIds": [
              "NUM.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaAroni, wowu atupristu diwu akembaŋampinja, jalushimbi lwenu lwahaya nyaka nimwamba kavwalikaŋa anyanenu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.8",
            "verseOrgIds": [
              "NUM.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimwamba kayaŋa nakwasa njita nawakwankunyi nenu akayikabisha mwituŋa denu, mwakembaŋa mpùŋa pu-u-u; hiyakayanukaŋa kumesu aYehova Nzambi yenu, akayamwina kudi ayilumbu jenu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.9",
            "verseOrgIds": [
              "NUM.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimwifukudenu dachiseki, hela hayawŋa yenu yayishiikawu, hela hatachikilaŋa tukwejitwenu, hela hanyilambu yenu yakusnita, hela hayimuna yanyilambu yenu yakuwunda, mwakembaŋa mpùŋa, jakekalaŋa jakuyanuka nachu kumesu aNzambi yenu; yami Yehova Nzambi yenu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.10",
            "verseOrgIds": [
              "NUM.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.10",
            "verseOrgIds": [
              "NUM.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Woho, mumwaka wamuchiyedi, mukakweji kamuchiyedi, mwifuku dakakweji damakumi ayedi, ivu hidikunyamuka hatabanaka yawunsahu hidadiŋi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.11",
            "verseOrgIds": [
              "NUM.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaIsarela anyamukili mwomwendelelaŋawu, afumini mwisaŋa dakuSinayi; ivu hidikushakama mwisaŋa daParani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.12",
            "verseOrgIds": [
              "NUM.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atachikili kwenda njila yawu, mwomwayilejeluwu kudi Yehova kukanwa kaMosi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.13",
            "verseOrgIds": [
              "NUM.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpandelu yachilombu chawanyana kaYuda diyi yasambililaŋahu dehi kunyamuka, yanyamukili mwomwendelelapa yendu yawu; Nahashoni mwana kaAminadabi diyi mwanta wachendu chindi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.14",
            "verseOrgIds": [
              "NUM.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wadiŋi mwanta wachendu chamuchidi wawanyana kaIsakari diyi Netaneli mwana kaZuwari. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.15",
            "verseOrgIds": [
              "NUM.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wadipi mwanta wachendu chamuchidi wawanyana kaZebuluni diyiEliyabi mwana kaHeloni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.16",
            "verseOrgIds": [
              "NUM.10.16"
            ]
          }
        }
      ]
    },
    {
