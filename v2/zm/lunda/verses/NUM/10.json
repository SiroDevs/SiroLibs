        {
          "text": "Dimu mwendelelaŋawu anyana kaIsarela mwahita yendu yawu; hiyakunyamuka.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.28",
            "verseOrgIds": [
              "NUM.10.28"
