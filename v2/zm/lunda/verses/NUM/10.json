          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi wamwilili Hobabi mwana kaReyuweli kaMidiyani, muku waMosi, nindi, Hitukwenda njila yetu yakuya kwituŋa danatwiliyi Yehova, nindi, Nakayinkadu; tuyi neyi, twakakwila chachiwahi; muŋa Yehova nahoshinindi wakayila aIsarela chachiwahi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.29",
            "verseOrgIds": [
              "NUM.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamwilili nindi, Hinukuyaku, nukuya kwami kumukala wetu kudi awusoku wami. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.30",
            "verseOrgIds": [
              "NUM.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena welili nindi, B ayi wutushiyaku mwani, muloŋa eyi yeyi weluka kwakutuŋila yilombumwisaŋa, wakekali mesu etu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.31",
            "verseOrgIds": [
              "NUM.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chakela, neyi tukuya neyi, yayiwahi yakatwilayi Yehova yejima, twakakwilamu nineyi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.32",
            "verseOrgIds": [
              "NUM.10.32"
            ]
          }
        }
