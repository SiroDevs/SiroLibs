          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpandelu yachilombu chawanyana kaDani, chilombu chakumishilu kuhanyima yayilombu yejima, yanyamukili, hiyikwenda mwomwendelelaŋa yendu yawu; Ahiyezeri mwana kaAmishadayi diyi mwanta wachendu chindi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.25",
            "verseOrgIds": [
              "NUM.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wadiŋi mwanta wachendu chamuchidi wawanyana kaAsheri, diyi Paŋiyeli mwana kaOkirani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.26",
            "verseOrgIds": [
              "NUM.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wadiŋi mwanta wachendu chamuchidi wawanyana kaNafwatali, diyi Ahira mwana kaEnani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.27",
            "verseOrgIds": [
              "NUM.10.27"
            ]
          }
        }
      ]
    },
