            "number": "21",
            "style": "v",
            "sid": "NUM 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "AKohati niwena hiyakunyamuka asenda malala; akwawu hiyakulemaŋahu dehi tabanaka wena kanda ashiki.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.21",
            "verseOrgIds": [
              "NUM.10.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.21",
            "verseOrgIds": [
              "NUM.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpandelu yachilombu hawanyana kaEfweremi hiyikunya mukahiyi kwenda mwomwendelelapa yendu yawu; Elishama mwana kaAmihudidiyi mwanta wachendu chindi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.22",
            "verseOrgIds": [
              "NUM.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wadiŋi mwanta wachendu chamuchidi wa wanyana kaManase, diyi Ŋamaleli mwana kaPedazuri. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.23",
            "verseOrgIds": [
              "NUM.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wadiŋi mwanta wachendu chamuchidi wawanyana kaBenjamini, diyi Abidani, mwana kaGideyoni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.24",
            "verseOrgIds": [
              "NUM.10.24"
            ]
          }
        }
      ]
    },
    {
