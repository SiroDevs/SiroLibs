              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ninjita yindi niachindiluwu ashikili mumakombakaji makumi asatu natanu, namakulakaji awana. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.23",
            "verseOrgIds": [
              "NUM.2.23"
