          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninjitayindi niachindiluwu ashikili mumakombakaji makumi awana nekombakajidimu, namakulakaji atanu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.28",
            "verseOrgIds": [
              "NUM.2.28"
            ]
          }
        },
        {
