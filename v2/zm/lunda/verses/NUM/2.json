          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muchidi wakakumakwakwihi nayena muchidi waManase. Kalamba kawanyana kaManase yowu ŋamaleli, mwana kaPedazuri. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.20",
            "verseOrgIds": [
              "NUM.2.20"
            ]
