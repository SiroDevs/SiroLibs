          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akate-ekaŋa kumutamba wamusela kwaselelaŋa itaŋwa wowakwampandeluya chilombu chaYuda, mwahita majitawu, wakela kalamba kawanyana kaYuda yowu Nahashoni mwana kaAminadabi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.3",
            "verseOrgIds": [
              "NUM.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninjita yindi niachindiluwu ashikili mumakombakaji makumi atanu nayedi namakombakaji awana, namakulakaji atanu nadimu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.4",
            "verseOrgIds": [
              "NUM.2.4"
            ]
          }
        }
      ]
    },
    {
