            }
          ]
        },
        {
          "text": "Kumutamba wakukabeta kakuchidiilu diku kwakekalaŋa mpandeluya chilombu chaRubeni mwahita majitawu; kalamba kawanyana kaRubeni yowu Elizuri mwana kaShedeyuri. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.10",
            "verseOrgIds": [
              "NUM.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
