          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ninjita yindinia chindiluwu ashikili mumakombakaji makumi awana natanu, namakulakaji atanu nadimu namakumi atanu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.15",
            "verseOrgIds": [
              "NUM.2.15"
