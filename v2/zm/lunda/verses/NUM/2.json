          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninjita yindi niachindiluwu ashikili mumakombakaji makumi atanu nadimu nayedi, namakulakaji atanu nayedi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.26",
