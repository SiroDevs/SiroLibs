          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninjita yindi niachindiluwu ashikilimuma kombakaji makumi awana, namakulakaji atanu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.19",
