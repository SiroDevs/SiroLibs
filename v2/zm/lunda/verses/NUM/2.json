          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awa akate-eka kwakwihi nayena akwamuchidi waSimeyona; kalamba kawanyana kaSimeyona yowu Shelumiyeli mwana kaZurishadayi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.12",
            "verseOrgIds": [
              "NUM.2.12"
            ]
          }
