          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninjita yindi niachindiluwu ashikilimuma kombakaji makumi awana natanu nadimu, namakulakaji atanu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.11",
            "verseOrgIds": [
              "NUM.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
