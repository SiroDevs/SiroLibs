            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awa akate ekaŋa kwakwihi nayena akwamuchidi waAsheri. Kalamba kawanyana kaAsheri, yowu Paŋiyeli mwana kaOkirani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.27",
            "verseOrgIds": [
              "NUM.2.27"
            ]
          }
        },
        {
