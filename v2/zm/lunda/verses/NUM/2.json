          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimuchidi waNafwatali; kalambaka wanyana kaNafwatali yowu Ahira mwana kaEnani; ",
          "type": "text",
