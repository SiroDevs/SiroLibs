          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninjita yindi niachindiluwu ashikili mumakombakaji makumi atanu natanu nawana, namakulakaji asatu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.13",
            "verseOrgIds": [
              "NUM.2.13"
            ]
          }
        },
        {
          "name": "verse",
