          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimwifuku dambutu jakahila nawa, chimwakahimulambulaŋa Yehova himulambu wawiha wawuŋa hachawija chenu chayalumingu, mwakapompaŋakupompa kwajila, kukoŋelamu mudimu waŋovu nehi; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.26",
            "verseOrgIds": [
              "NUM.28.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 28:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "chiŋa mwakalambulaŋa mulambu wakushita wakumununkishila Yehova ivumba dadiwahi, aŋombi amayala amayoŋa ayedi, chizamba chamukoku wumu, anyanakanyikoku ayizamba amwaka wumu atanu nayedi; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.27",
            "verseOrgIds": [
              "NUM.28.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 28:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "nihimulambu wawuwawuŋa, wuŋa walembuluka wakubomba namanji, mabaŋu asatu haŋombi, haŋombi, mabaŋu ayedi hamukoku wumu, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.28",
            "verseOrgIds": [
              "NUM.28.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
