  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "NUM 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu Kora, mwana kaIzihari, mwana kaKohati, mwana kaLevi, akwatili mpuna naDatani naAbirami, anyana kaEliyabi, naOni, mwana kaPeleti, anyana kaRubeni; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.1",
            "verseOrgIds": [
              "NUM.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "aleteli winyi naMosi hamu nawanyana kaIsarela amakwawu atulamba amuchipompelu, alema muchipompelu, ayampuhu, makulakaji ayedi namakumi atanu; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.2",
            "verseOrgIds": [
              "NUM.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "apompeleli aMosi naAroni na ndombu, ayilili nawu, Munadikila keshi dehi, chipompelu chejima chajila niwunashaluhu hosi, Yehova wudi mukachi kawu hohu. Indi enu munadilemeshelidi hachipompelu chaYehova? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.3",
            "verseOrgIds": [
              "NUM.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chachitiyiliyi Mosi wadinatili chamesu hamaseki. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.4",
            "verseOrgIds": [
              "NUM.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wahosheli naKora nawantu apompeliyi nawu, nindi, Kumadiki budidi Yehova wakamwekesha windi niwajila wuduhu, wakamukundamisha kwakwihi nayena. Yowu akatondayi diyi akakundamishayi kwakwihi nayena. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.5",
            "verseOrgIds": [
              "NUM.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "T iyenu chimwakela. Mwakanona yeŋa yakusendela insensi, nineyi Kora, niakwenu ejima wunapompi nawu; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.6",
            "verseOrgIds": [
              "NUM.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwakashu mukesi, mwakashuhu niinsensi kumesu aYehova kumadiki. Twakamona iyala akatondayi Yehova diyi wakajila, munadikilakeshi enu anyana kaLevi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.7",
            "verseOrgIds": [
              "NUM.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.11",
            "verseOrgIds": [
              "NUM.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi watemesheli nakutambika Datani naAbirami, anyana kaEliyabi. Wena nawu, Hitukwinza kwokuku; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.12",
            "verseOrgIds": [
              "NUM.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "chiwunatufumishi mwituŋa datuloŋa twamayeli nawuchi hiwukutujahisha munu mwisaŋa, komana chinakehi, winzi wubombeluku nikudilisha kalamba ketu? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.13",
            "verseOrgIds": [
              "NUM.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ochu wunatushikiji mwituŋa datuloŋa twamayeli nawuchi wanyi. Wunatwinki wuswanawamaha namatempa anyivinyu wanyi. Keŋa wulokoli awa mayala mesutahindi? Hitukwinza kwokuku.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.14",
            "verseOrgIds": [
              "NUM.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.14",
            "verseOrgIds": [
              "NUM.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi waswejeli kuzuwa, hakumwila Yehova, nindi, Bayi wutala hahimulambu wawuku. Hinayidiili hoku chimbulu niwumuhu, hela kukatishahu muntu niwumuhu kwamuku. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.15",
            "verseOrgIds": [
              "NUM.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi hakumwila Kora, nindi, Kumadiki kemanenu kumesu aYehova, nineyi, nichipompelu cheyi chejima, nineyi, niwena, niAroni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.16",
            "verseOrgIds": [
              "NUM.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwakasendi wejima wenu yeŋa yenu yakusendela insensi, mwakashuhu insensi, mwakaleti wejima wenu yeŋa yenu kumesu aYehova, yeŋa makulakaji ayedi namakumi atanu; nineyi niAroni, iwunacheŋa chindi, iwu nacheŋa chindi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.17",
            "verseOrgIds": [
              "NUM.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.17",
            "verseOrgIds": [
              "NUM.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asendeli wejima wawu yeŋa yawu, ashilumu kesi, ashiluhu niinsensi, emeni kuchisu chetenti dakubulakena hamu naMosi naAroni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.18",
            "verseOrgIds": [
              "NUM.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kora wayipompesheleli chipompelu chejima nandombu kuchisu chetenti dakubulakena; kulema kwaYehova kwamwekeneni chipompelu chejima.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.19",
            "verseOrgIds": [
              "NUM.16.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.19",
            "verseOrgIds": [
              "NUM.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wahosheli naMosi naAroni, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.20",
            "verseOrgIds": [
              "NUM.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Ambukenu mufumi mukachi kachipompelu ichi, kulonda niyinoŋeshi hohenahanu zo-o chikupu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.21",
            "verseOrgIds": [
              "NUM.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adinatili chamesu awu hamaseki, nawu, Eyi Nzambi, Nzambi yawaspirituja wantu ejima, muntu wukuvulumuna wumu hohu, wuzuwili chipompelu chejima? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.22",
            "verseOrgIds": [
              "NUM.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wahosheli naMosi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.23",
            "verseOrgIds": [
              "NUM.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Hoshaku nachipompelu, neyi, Oku kutabanaka yaKora, naDatani, naAbirami, fumenuku. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.24",
            "verseOrgIds": [
              "NUM.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi wanyamukili, wayili kudi aDatani naAbirami. Akulumpi awaIsarela amulondeli.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.25",
            "verseOrgIds": [
              "NUM.16.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.25",
            "verseOrgIds": [
              "NUM.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wahosheli nachipompelu, nindi, Fumenu mwani, kumatenti anawamayala atama, bayi mukwata kuyuma yawuku, mwakenza kanoŋela kumunanshidi jawu jejima. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.26",
            "verseOrgIds": [
              "NUM.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afuma nikutabanaka yaKora, naDatani, naAbirami, mwa-mwa. Datani naAbirami edi kili, emeni kuyisu yamatentawu, ni aŋodi jawu, ni anyanawu amayala, ninyikeki yawu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.27",
            "verseOrgIds": [
              "NUM.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi welilinindi, Tiyenu mumwakelukila nenu Yehova diyi wantemesheli, nindinakeli nyidimu yejimiyi, mwiluki nenu hinayilaŋa chakumuchima wamuku; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.28",
            "verseOrgIds": [
              "NUM.16.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "neyi amayalawa akufwa neyi chafwaŋawu akwawu antu ejima, indi neyiakamona chamonaŋawu akwawu antu ejima, komana Yehova hantemesheluku. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.29",
            "verseOrgIds": [
              "NUM.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa neyi Yehova wukwila chuma chachiha, niiseki dikwasamamukanwa kadu, dikuyiminya niyuma yawu yejima, hiyakuholokela amomi mwikela, dihu himwakashinshikila nenu amayalawa anamudiwuli Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.30",
            "verseOrgIds": [
              "NUM.16.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.30",
            "verseOrgIds": [
              "NUM.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amweni, nakumishi dehi kuhosha mazu awa ejima, iseki dadiŋi kwishina dawu dabalukili. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.31",
            "verseOrgIds": [
              "NUM.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iseki daasamini mukanwa kadu dayiminyini, nimatalawu, niantu aKora ejima, niyuma yawu yejima. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.32",
            "verseOrgIds": [
              "NUM.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niwena niyuma yawuyejima aholokeli amomi mwikela, iseki dibulakana nicheŋi hewulu dawundwa, ajilumukili muchipompelu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.33",
            "verseOrgIds": [
              "NUM.16.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "AIsarela ejima adiŋi emajala kwakwihi, atemukili chatiyiluwu nyiteti yawu. Nawu, Iseki dakenza katuminya. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.34",
            "verseOrgIds": [
              "NUM.16.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 16:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kesi kafumini kudi Yehova, kayinoŋesheli owu amayala makulakaji ayedi namakumi atanu aleteli insensi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.35",
            "verseOrgIds": [
              "NUM.16.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 16:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.35",
            "verseOrgIds": [
              "NUM.16.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 16:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wahosheli naMosi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.36",
            "verseOrgIds": [
              "NUM.16.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 16:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Muleji Eleyazari mwana kakapristu Aroni anoni yeŋa yakusendela insensi mukesi, ni kesi akasandili kunakwakulehi, muloŋa yajila; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.37",
            "verseOrgIds": [
              "NUM.16.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 16:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyi yeŋa yanawa akwanshidi anatamishi wumiwawu awenawu, ayichili yeŋa yawubasa yakujika hakameŋa; muloŋa anayilambuli kumesu aYehova, dichi yajila. Yakekalaŋa chinjikijilu chakutalilaŋahu anyana kaIsarela. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.38",
            "verseOrgIds": [
              "NUM.16.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 16:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapristu Eleyazari wanoneni yeŋa yainsensiya wuneŋu yalambwiluwu owu ocheluwu; ayichilili chifwiku chakameŋa; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.39",
            "verseOrgIds": [
              "NUM.16.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 16:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulonda kwanukishaŋa nachu anyana kaIsarela, kulonda hakabuli kumwekana mwenyi wabula kusemuka kudi Aroni wakenza kwakwihi nakwocha insensi kumesu aYehova; wakenza kamona chamweniyi Kora nawakwawu apompeliyi nawu; mwomwahosheliyi Yehova nayena kukanwa kaMosi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.40",
            "verseOrgIds": [
              "NUM.16.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 16:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.40",
            "verseOrgIds": [
              "NUM.16.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 16:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chikwachili, chipompelu chawanyana kaIsarela chejima chatobeleli aMosi naAroni, nawu, Munajahi antu aYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.41",
            "verseOrgIds": [
              "NUM.16.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NUM 16:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chelili chipompelu chinapompeli dehi aMosi naAroni, hiyakutala kwitenti dakubulakena, hiyakumonavu dinabutuhu, ni kulema kwaYehova hikukumwekana. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.42",
            "verseOrgIds": [
              "NUM.16.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NUM 16:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amosi na Aroni enjili kumesu etenti dakubulakena. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.43",
            "verseOrgIds": [
              "NUM.16.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "NUM 16:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wahosheli naMosi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.44",
            "verseOrgIds": [
              "NUM.16.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NUM 16:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Fumenu mukachi kachipompelu ichi kulonda niyinoŋeshi hohenahanuzo-o. Hiyakudinata chamesu hamaseki. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.45",
            "verseOrgIds": [
              "NUM.16.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "NUM 16:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi wamwilili Aroni, nindi, Nonaku cheŋa cheyi chakusendela insensi, wushumu kesi kahakameŋa, wushuhu insensi, wutwali swayi kudi chipompelu, wuyilili yakuyibuta nachu; kudi Yehova kunenzi dehi ndombu, chipúpu chinatachiki dehi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.46",
            "verseOrgIds": [
              "NUM.16.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "NUM 16:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni wanoneni mwomwamulejeli Mosi, wayili lufuchi mukachika chipompelu. Nindi atali, chipúpu mwaka chinatachiki dehi mukachikawantu. Washiluhu insensi, welili yakubuta nachu antu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.47",
            "verseOrgIds": [
              "NUM.16.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "NUM 16:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wemenihakachi kawafu nawamomi. Chipúpu chiimana ni kwimana. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.48",
            "verseOrgIds": [
              "NUM.16.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "NUM 16:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu afwili nachipúpu makombakaji ikumi nawana namakulakaji atanu nayedi, akubombela hadi awa afwili nansaŋu yaKora. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.49",
            "verseOrgIds": [
              "NUM.16.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "NUM 16:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni wafuntili cheŋi kudi Mosi kuchisu chetenti dakubulakena. Chipúpu chiimana ni kwimana.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.50",
            "verseOrgIds": [
              "NUM.16.50"
            ]
          }
        }
      ]
    }
