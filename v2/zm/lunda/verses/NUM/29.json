          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nihimulambu wawuwawuŋa, wuŋa walembuluka wakubomba namanji, mabaŋu asatu haŋombi, mabaŋu ayedi hamukoku, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.9",
