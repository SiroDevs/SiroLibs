        },
        {
          "text": "Hefuku dekumi dakakweji aka kamuchitanu nachiyedi mwakapompaŋa kupompa kwajila; mwakadikabishaŋa munyichima yenu, kukoŋela mumudimu himudimu nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.7",
            "verseOrgIds": [
              "NUM.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
