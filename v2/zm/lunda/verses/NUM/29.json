            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakakweji kamuchitanu nachiyedi, hefuku dakakweji dakusambila, mwakapompaŋa kupompa kwa jila; kukoŋelamu nyidimu yaŋovunehi; hiifuku denu dakwimbaŋa mpùŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.1",
            "verseOrgIds": [
              "NUM.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwakalambulaŋa himulambu wakushita wakumununkishila Yehova ivumba dadiwahi; iyoŋa daŋombi weyala wumu, chizamba chamukoku wumu, anyana kanyikoku ayizamba amwaka wumu atanu nayedi, akadi ninaha hataminawu; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.2",
            "verseOrgIds": [
              "NUM.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nihimulambu wawu wawuŋa, wuŋa walembuluka wakubomba namanji, mabaŋu asatuhaŋombi, mabaŋu ayedi hamukoku, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.3",
            "verseOrgIds": [
              "NUM.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ibaŋu dimu hamwana kamukoku, anyana kanyikoku ejima atanu nayedi; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.4",
            "verseOrgIds": [
              "NUM.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nichizamba champembi wumuwamulambu wahanshidi, wakuyibuta nachu; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.5",
            "verseOrgIds": [
              "NUM.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakulunjika hahimulambu wakushita wahaalukaŋa kakweji, nahimulambu wawu wawuŋa, nahimulambu wakushita wahefuku hefuku, nahimulambu wawu wawuŋa ninyilambu yawuyaku huŋununa, mwahita lushimbi lwawu wevumba dadiwahi, himulambu wakumwilila Yehova nakesi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.6",
            "verseOrgIds": [
              "NUM.29.6"
            ]
          }
        }
      ]
