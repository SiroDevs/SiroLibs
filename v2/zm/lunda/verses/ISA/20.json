        },
        {
          "text": "Mwaka wenjili Taritani kuAshidodi, hamutemesheliyi mwanta wakuAshuri Sariponi, halwiliyi naAshidodi hakuwutambula, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.1",
            "verseOrgIds": [
              "ISA.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
