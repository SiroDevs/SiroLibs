        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izu damweniyi mwana kaAmozi Isaya hansaŋu yaYuda naYerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.1",
            "verseOrgIds": [
              "ISA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.1",
            "verseOrgIds": [
              "ISA.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyaka vakukuminina antu amba kamona mpidi yetala daYehova yinashimati dehi hewulu damapidi, yakasompoka mpidi janyanya; nyuzayejima yakahwila kwenoku. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.2",
            "verseOrgIds": [
              "ISA.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyuza yayivulu yakaya nakuhosha nawu, Tuyenu twakakanduki kumpidi yaYehova, kwitala daNzambi yaYakoba; akatu leji mwendelaŋayi, kulonda twakendapa munjila jindi; muloŋa muZiyona mwakafuma nshimbi, kuYerusalema kwakafuma izu daYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.3",
            "verseOrgIds": [
              "ISA.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakekala hakachi kanyuza nakuyisompesha, wakahoshola nyuza yayivulu; nimpoku jawu akajichila matemwa, nimayoŋa awu akayichila nyipanŋa; muza hiwakanyamwina muza wukwawu mpokuku, hiyakadiza nawa cheŋi njitaku.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.4",
            "verseOrgIds": [
              "ISA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.4",
            "verseOrgIds": [
              "ISA.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi mutaŋa waYakoba, tuyenu twakendeli muchejeji chaYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.5",
            "verseOrgIds": [
              "ISA.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa eyi wunaleki dehi antu eyi wowu mutaŋa waYakoba, mulonawena anasweji tushidikilu twakumusela, hiyakwakuhopa natutumbwa neyi aFwilistinu, hiyakudeta mumakasa nawanyana awantu akwacheŋi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.6",
            "verseOrgIds": [
              "ISA.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itupadawu nawa dinenzali siliva nawuru, yuma yawu yalema hiyakumapaku; ituŋa dawu dinenzali nawa tuwalu, nimakálu awu hiyakumapaku. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.7",
            "verseOrgIds": [
              "ISA.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ituŋadawu dinenzali nkishi nawa; adifukulaŋa kumudimu wamakasawu, chuma chakutupa nanyinu yawu awenawu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.8",
            "verseOrgIds": [
              "ISA.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu wakadi kulema hakubandama, muntu walema hakudizoza; dichi bayi wakayanakenaku. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.9",
            "verseOrgIds": [
              "ISA.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipilaku mwilola, wakabatami mulunkuŋu, wutemuki woma waYehova, nakuwaha kwawukeleŋa windi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.10",
            "verseOrgIds": [
              "ISA.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mesu akudimujola akayizozesha, nikudivuna kwadivunaŋawu antu akakufukamisha heseki, ifuku odu akatúumbakesha Yehova hohu kanka windi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.11",
            "verseOrgIds": [
              "ISA.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.11",
            "verseOrgIds": [
              "ISA.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa hakekala ifuku daYehova wamazaza dakawana antu ejima adinka wanta, adivuna, dakawana antu ejima adinyamuna kwiwulu; dakayishikija hamaseki; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.12",
            "verseOrgIds": [
              "ISA.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "dakawana ninyisida yakuLebanoni yasweja kuleha yadinyamuna kwiwulu, ninyikula yakuBashani; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.13",
            "verseOrgIds": [
              "ISA.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "dakawana nimpidijimaneni jejima jasweja kuleha, nimpidi janyanya jejima jadinyamuna kwiwulu; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.14",
            "verseOrgIds": [
              "ISA.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "dakawana nituposhi twahahalehi, nimpwembu jejima; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.15",
            "verseOrgIds": [
              "ISA.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "dakawananimaatu akuTarashishi ejima, nimapichara ejima akweti nichipepa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.16",
            "verseOrgIds": [
              "ISA.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.18",
            "verseOrgIds": [
              "ISA.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakanyamukayi nakukankisha iseki naŋovu, antu akeŋala mumayeŋu amumalola, nimumena ahamaseki, nawu atemuki woma waYehova nikuwaha kwawukeleŋi windi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.19",
            "verseOrgIds": [
              "ISA.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dena ifuku odu muntu wakanatila ampumba nawatunfunfwa nkishi jindi jasiliva, ninkishi jindi jawuru jasoŋa eliyi, kulonda kudifukula kudi wena; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.20",
            "verseOrgIds": [
              "ISA.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulonda ayi mumayeŋu amumalola nimunyaji yamumalola abaloka baloka, nindi atemuki woma waYehova nikuwaha kwawukeleŋi windi, hakanyamukayi nakukankisha iseki naŋovu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.21",
            "verseOrgIds": [
              "ISA.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ketukenu kudi antu akweti muuya wamumazulu hohu, ochu wena alemena hadihi?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.22",
            "verseOrgIds": [
              "ISA.2.22"
            ]
          }
        }
      ]
    }
  ],
