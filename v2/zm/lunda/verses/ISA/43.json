    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 43:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi dinu Yehova wakuleŋeli, eyi Yakoba, wakuwumbili, eyiIsarela, nindi, Bayi wutiya womaku, muloŋa nakukúuli dehi. Nakutambiki hejina deyi, eyi wuwami. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.1",
            "verseOrgIds": [
              "ISA.43.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 43:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiwukuhitaŋa muchimeji nukwikalaŋa aneyi. Chiwukuhitaŋa namutuloŋa, hitwakakuhita hanamutuku. Chiwukuhitaŋa mukesi, hiwakasukumaku; kwosi mulaŋu wakakwochaku. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.2",
            "verseOrgIds": [
              "ISA.43.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 43:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa yami Yehova Nzambi yeyi, Wajila waIsarela, chamwinu cheyi. Nahani aEjipitu ekali akukukuula nachu, nahani aEtiyopiya nawaSeba hamujimbaweyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.3",
            "verseOrgIds": [
              "ISA.43.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 43:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiwasweja wuseya kumesu ami, nichiwalema, nichina kukeŋi, dichi chinukuhena antu hamujimba weyi, nyuza yawantu hawumi weyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.4",
            "verseOrgIds": [
              "ISA.43.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 43:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi wutiyapa womaku, muloŋa ami nidi neyi. Nukukuletelaŋa anyaneyi kumusela, nukukukuŋula kumuji ka. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.5",
            "verseOrgIds": [
              "ISA.43.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 43:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukumwila kabeta kakuchimu nswanami, Hanaku. Nikabeta kakuchidiilu, nukumwila nami, Bayi wudikaŋa anawuku. Nleteli anyanami amayala akafumi kwakulehi, nianyanami awambanda akafumi kunsa yeseki;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.6",
            "verseOrgIds": [
              "ISA.43.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 43:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.13",
            "verseOrgIds": [
              "ISA.43.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 43:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nkúuli yenu, Wajila waIsarela, nindi, Natemeshi njita kuBabiloniha mujimba wenu, nakayitemuna wejima wawu, niaKaladeya hamumuma atu aluŋilaŋa awu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.14",
            "verseOrgIds": [
              "ISA.43.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 43:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yami Yehova, wenu Wajila, Nleŋi yaIsarela, Mwanta wenu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.15",
            "verseOrgIds": [
              "ISA.43.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 43:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wabuzaŋa njila mukaluŋalwiji, ninjila muchimeji chaŋovu, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.16",
            "verseOrgIds": [
              "ISA.43.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 43:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "wedishaŋa ikalu nakawalu, ninjita niakwaŋovu; anakamihamu, hiyakahindukaku, anajiyi dehi, anayijimi neyi wanda. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.17",
            "verseOrgIds": [
              "ISA.43.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 43:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi mwanukaŋa yuma yakusambila, hela kutoŋojoka yuma yakushankuluku.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.18",
            "verseOrgIds": [
              "ISA.43.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 43:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.21",
            "verseOrgIds": [
              "ISA.43.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 43:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela chochu, eyi Yakoba, hiwunanta mbikuku; muloŋa, eyi Isarela, wunantiyi kafulumba kumuchima fu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.22",
            "verseOrgIds": [
              "ISA.43.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 43:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiwunanleteli nyana kampembi nanyikoku yanyilambu yeyi yakushitaku; hiwunanlemeshi nakunketwila yimuna yeyuku. Hinakulambwishi nyilambu hela kukukabakesha nalibonaku. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.23",
            "verseOrgIds": [
              "ISA.43.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 43:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiwunanlandili nyisachi yevumba dadiwahi namali, hela kuŋikutisha namanji ayimuna yeyuku, ilaŋa wunankalakeshi nanshidi jeyi, wunanzeyeshi nakuluwaluwa kweyi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.24",
            "verseOrgIds": [
              "ISA.43.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 43:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.24",
            "verseOrgIds": [
              "ISA.43.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 43:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami yami najimaŋa nyiloŋa yeyi hamujimba wamami aweni; hinaka anukaŋa nawa nshidi jeyuku. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.25",
            "verseOrgIds": [
              "ISA.43.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ISA 43:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋanukishi; tuhoshenu muloŋa; awulaku muloŋa weyi, kulonda akakuyiŋishi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.26",
            "verseOrgIds": [
              "ISA.43.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ISA 43:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkakulula yeyi wakusambila wavulumwini, akwakukulu mbulwila anamotoki dehi izu dami.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.27",
            "verseOrgIds": [
              "ISA.43.27"
            ]
          }
        }
      ]
    }
