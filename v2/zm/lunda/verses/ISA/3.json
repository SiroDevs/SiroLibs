              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu tiyenu, Mwanta, Yehova wamazaza, hakufumisha nikuYerusalema nikuYuda wushindamenu nimukombu, niwushindamenu wejima wayakudya, niwushindamenu wejima wameji; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.1",
            "verseOrgIds": [
              "ISA.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nichilobu, nimukwanjita; ninsompeshi, nikaprofwetu, nimukwakuhopa, nimukulumpi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.2",
            "verseOrgIds": [
              "ISA.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.13",
            "verseOrgIds": [
              "ISA.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova liakukwata kumudimu wakusompesha awakulumpi awantu indi, nitulamba twawu, nindi, Yenu munadyi itempa danyivinyu; yuma yimunabuwi atuzweŋi yidi mumatalenu; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.14",
            "verseOrgIds": [
              "ISA.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "chimudi nakuchika antu ami, nakulola mesu awatuzweŋi helola, munatwalihanka? Dimu mwanahoshiyi Mwanta Yehova wamazaza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.15",
            "verseOrgIds": [
              "ISA.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nindi, Ochu chaneluwu anyana awambanda amuZiyona adiŋi kawanta, endaŋa nakwolola nshiŋu jawu ki-i, namesu awu akukenkama, chendaŋawu endaŋa nakunanuka hohu, nakuvumisha machakayi kunyenduyawu; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.16",
            "verseOrgIds": [
              "ISA.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "dichi chakayetelayi Mwanta anyana awambanda amuZiyona nakapelupelu mumashina anyitu yawu, Yehova wakayivúula nihawusonyiwawu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.17",
            "verseOrgIds": [
              "ISA.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dena ifuku odu Mwanta wakafumisha lubanji lwamanjolu awu, nimakila akunyitu, niyibaŋula; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.18",
            "verseOrgIds": [
              "ISA.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimasumba, nimakayi, nimahina amunshiŋu; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.19",
            "verseOrgIds": [
              "ISA.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimahina akunyitu, nitumaleŋi twakunyendu, nimahina akukasa mumbunda, nituyikasha twamalasha, nimpashi; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.20",
            "verseOrgIds": [
              "ISA.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "nituzeya, nituzeyatwakumazulu; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.21",
            "verseOrgIds": [
              "ISA.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "niwuvwalu wakuvwela kumawija; ninyilesu, niŋombinamwana, nitumapakumuna; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.22",
            "verseOrgIds": [
              "ISA.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "nituyibanjilu, nimahina amawahi atooka, nimahina akujiŋa kunyitu, nimahina akubuta kumesu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.23",
            "verseOrgIds": [
              "ISA.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amba kamona mwadiŋi nyiseki yepukilaŋa mavumba amawahi, himudi kutoka; mwadiŋi muya, himudi lumwonji; mwadiŋa nsuki jakuyinda chachiwahi, himudiibala; mwadiŋi sanya yayiwahi, himudi mukonzu wachikeleyi; mwadiŋi lubanji, himudi chibata. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.24",
            "verseOrgIds": [
              "ISA.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu eyi amayala akakantumoka nampokuyakabali, niayilobu jeyi akakantumoka kunjita. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.25",
            "verseOrgIds": [
              "ISA.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ISA 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muyisu yampwembu yeyi mwakekala kuyeŋashana nikudishona; yena akamúumba tuhu kankawindi, wakashakama heseki.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.26",
            "verseOrgIds": [
              "ISA.3.26"
            ]
          }
        }
      ]
    }
