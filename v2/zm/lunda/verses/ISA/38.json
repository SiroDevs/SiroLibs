  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "38",
        "style": "c",
        "sid": "ISA 38"
      },
      "items": [
        {
          "text": "38",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 38:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamafuku owu Hezekiya wakatili yikatu yakufwa. Kaprofwetu Isaya, mwana kaAmozi, hakwinza kudi yena, hakumwila nindi, Yehova nahoshi nindi, Loŋaeshaku nsaŋu jahamukala weyi, muloŋa eyiwukufwa, hiwukuhandaku. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.1",
            "verseOrgIds": [
              "ISA.38.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 38:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekiya hakubalumuka chamesu indikumbariu, hakulomba kudi Yehova, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.2",
            "verseOrgIds": [
              "ISA.38.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 38:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Eyi Yehova, nalembi, aanuki mwani chinendi kumesu eyi chakashinshi namuchima walala, chineli niyumayayiwahi kumesu eyi. Hezekiya hakudila nankashi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.3",
            "verseOrgIds": [
              "ISA.38.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 38:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.3",
            "verseOrgIds": [
              "ISA.38.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 38:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izu daYehova hidikwinza kudi Isaya, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.4",
            "verseOrgIds": [
              "ISA.38.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 38:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Yaku wakamwili Hezekiya, neyi, Yehova Nzambi yankakulula yeyi Davidi, nahoshi nindi, Natiyi kulomba kweyi, namoni madilu eyi. Tiya, kumafuku eyi nukukushilakunyaka ikumi nayitanu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.5",
            "verseOrgIds": [
              "ISA.38.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 38:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukukupulwisha nineyi nimukaliwu muchikasa chamwanta wakuAshuri. Nukuhemba mukaliwu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.6",
            "verseOrgIds": [
              "ISA.38.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 38:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiya chinjikijilu chiwakamona kudi Yehova kulonda wiluki neyi, Yehova wukwila chumichi chanahoshiyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.7",
            "verseOrgIds": [
              "ISA.38.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiya, mwevulu wahayimaŋu wuna kunkumuki dehi netaŋwa, nukuwufuntisha cheŋi hanyima yimaŋu ikumi. Dichi itaŋwa dafuntili yimaŋu ikumi, chakweseka nekumi dayi maŋu yakunkumukayi dehi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.8",
            "verseOrgIds": [
              "ISA.38.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.8",
            "verseOrgIds": [
              "ISA.38.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 38:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kusoneka kwasonekeliyi mwanta wawaYuda Hezekiya, heliliyi nakatidehi, nakoli dehi kuyikatu yindi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.9",
            "verseOrgIds": [
              "ISA.38.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 38:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nelili nami, Mafuku ami anayiketuli dehi ngwa hakachi, hinukwijila muyisu yakaluŋa. Nyaka yami yasheluku ananta mbuliyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.10",
            "verseOrgIds": [
              "ISA.38.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 38:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nelili nami, Yehova, Yehova, hinakamumona mwituŋa dawamomuku. Hinakamona nawa cheŋi muntu hamu nawakwakushakama mumpata yamunu mwishinaku. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.11",
            "verseOrgIds": [
              "ISA.38.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 38:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wushinakaji wami anawufumishi dehi, anawutwali dehi neyi chatwalaŋawu itenti dakabiŋa, wumi wami nawuvuŋidehi neyi chavuŋaŋayi mukwakutuŋa mahina, wakanketula kwikwaali. Kufumisha kumwaana ndo nikuwufuku wukunnuŋululaŋa hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.12",
            "verseOrgIds": [
              "ISA.38.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 38:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nadu pumikilihohu kushika nikubudidi. Wukukotola mafwahami ejima chikwamutupa. Kufumisha kumwaana ndo nikuwufuku wukunnuŋululaŋa hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.13",
            "verseOrgIds": [
              "ISA.38.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 38:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nelili checheche neyi kambimbi neyi munkoloŋa. Nadishishimwini neyi kambolu. Mesu ami azeyeli nakutala kwiwulu. EyiYehova, namoni ihuŋu, ikalaku kapopu kami. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.14",
            "verseOrgIds": [
              "ISA.38.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 38:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukwila namidi? Yena neli nikuhosha kudami nikwilamu. Nukwendapa chovu chovu nyakayami yejima nakulula kwami mumuchima. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.15",
            "verseOrgIds": [
              "ISA.38.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 38:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi Mwanta, antu ahandilaŋa kuyumiyi, wumi waspiritu yami wekala mwomwenimu hohu. Dichi ankoleshi, anhandishi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.16",
            "verseOrgIds": [
              "ISA.38.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 38:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komana chinamweni kulula kwasweja chadiŋi chakunletela kuwunda. Wunapulwishi wumi wami muwina wakutokanakukeŋa kuwawukeŋa; muloŋa wunanatili dehi nshidi jami jejima kunyimayeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.17",
            "verseOrgIds": [
              "ISA.38.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 38:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa ŋamu hidatweshaŋa kukusakililaku, kufwa hikwatweshaŋa akukuhamekaku. Antu akukunkumuka muwina hiyakutwesha kukuhwelelansaŋu yeyi yalalaku. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.18",
            "verseOrgIds": [
              "ISA.38.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 38:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumi, mumi, diyi wakakusakilila neyi chinukwilamilelu. Tata yawantu diyi wakayilukisha anyana nsaŋu yeyi yalala. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.19",
            "verseOrgIds": [
              "ISA.38.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 38:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova keŋa apamwini. Dichi tukwimba tumina twami nayisanji yanyonji, mafuku ejima awumi wetu mwitala daYehova.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.20",
            "verseOrgIds": [
              "ISA.38.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 38:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.20",
            "verseOrgIds": [
              "ISA.38.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 38:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu Isaya wahosha dehi nindi, Anoni dinkendi danyikabu yachikuyu, ali hehuti, akakoli.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.21",
            "verseOrgIds": [
              "ISA.38.21"
            ]
          }
        }
      ]
    }
  ],
