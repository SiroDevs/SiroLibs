  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "26",
        "style": "c",
        "sid": "ISA 26"
      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyenu kamina kakembawu mwituŋa daYuda dena ifuku odu, nawu, Tudi namukala wasweja Ŋovu, yena wakashaku wamwinuwikali mpwembu jawu nimwakudikaŋala. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.1",
            "verseOrgIds": [
              "ISA.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enzululenu yenzelu yakumpwembu kulonda mwiŋili muza waloŋa wahembaŋa nsaŋu yalala. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.2",
            "verseOrgIds": [
              "ISA.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu wukweti yitoŋojoka yashindamena hadeyi, wakamuhemba, wakatulamuchima windi mwivumu hi-i nanochu chakukuhwelelayi eyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.3",
            "verseOrgIds": [
              "ISA.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukuhwelelenu Yehova haya nyaka, muloŋa mudi YaYehova, dimumwilola dahaya nyaka. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.4",
            "verseOrgIds": [
              "ISA.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu ashakama kwiwulu nayinopamishi dehi heseki, mukala wekala hazandama nawushikumwishi dehi, nawushikumwishi dehi niheseki, nawushikiji dehi nikulunkuŋu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.5",
            "verseOrgIds": [
              "ISA.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akawudatola nyendu, yonyendu yawatuzweŋi, yoyintampu yawabula yuma. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.6",
            "verseOrgIds": [
              "ISA.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njila yamukwakuŋayowu kwoʼnka; eyi woloka, yeyi washikumunaŋa njila yamukwakuŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.7",
            "verseOrgIds": [
              "ISA.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi Yehova mwalala tunakuchiŋilili munjila yawuŋa aji weyi; mucnimawetu wafwila ijina deyi nikukwanukaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.8",
            "verseOrgIds": [
              "ISA.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakufwili namuchima wami nawufuku. Mwalala nadanukaŋa nakukukeŋa akeŋa naspiritu yami mukachi. Muloŋa chiwukwikala wuŋaji weyi hanu heseki, akwakushakama munumwishina akadiza kuloŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.9",
            "verseOrgIds": [
              "ISA.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukwakukopa chatama, hela wukuwana wuselewa, hakadiza kuŋaku, mwituŋa dakwoloka saŋa elilayi chatama ho-o, hakamona niwanta waYehovaku.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.10",
            "verseOrgIds": [
              "ISA.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.10",
            "verseOrgIds": [
              "ISA.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi Yehova, hela chikasa cheyi chinanyamuki kwiwulu wena kumona nehi; muwakatiyila antu iyena kumuchima wena akamonamu, akatiya nsonyi; mwalala kesi kakalasha akwankunyi neyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.11",
            "verseOrgIds": [
              "ISA.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi Yehova wukutuletela kuwunda, muloŋa wunatukalakeli nyidimu yetu yejima. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.12",
            "verseOrgIds": [
              "ISA.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala, Yehova Nzambi yetu, ankaka acheŋi anatuyuli, eyi nehi; kwinza kutena ijina deyi chinafumi kudeyi hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.13",
            "verseOrgIds": [
              "ISA.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afwa dehi hiyakahandaku; anoŋa dehi hiyakasaŋukaku; dichi chiwunayihempuli wunayijilumuni, wunayijiyishi nikuyanuka nawa cheŋi nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.14",
            "verseOrgIds": [
              "ISA.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wunavulishi muza, eyi Yehova, wunavulishi muza, anakulemeshi; wunatoheshi ŋanza jetuŋa jejima.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.15",
            "verseOrgIds": [
              "ISA.26.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.15",
            "verseOrgIds": [
              "ISA.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi Yehova, chamwenuwu yihuŋu akukeŋakeŋeli, chamwenuwu kubabesha kuwayibabesheli, akuminini dakwichila kulomba. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.16",
            "verseOrgIds": [
              "ISA.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chelaŋa mumbanda wudi nevumu, hikwakwihi nakuvwala, hakutiya kukata, hakukaloka nanyisoŋu yindi yakuvwala, dichi twadiŋi etu kumesu eyi, eyi Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.17",
            "verseOrgIds": [
              "ISA.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twadiŋi nevumu, twatiyili kukata, chidi neyi tunavwali mpepela; hituna Itoŋi wamwinu hanu hesekuku; hikunavwaliki akwakushakama munu mwishinaku. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.18",
            "verseOrgIds": [
              "ISA.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afu eyi akahanda; yibimbi yawu yakasaŋuka. Enu mwashakama mulunkuŋu tonenu, mwimbi tumina; muloŋa wuumi weyiwudi neyi wuumi wakuyiputa, niiseki dakatupula afu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.19",
            "verseOrgIds": [
              "ISA.26.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.19",
            "verseOrgIds": [
              "ISA.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu antu ami inzenu, mwiŋili mumatalenu mwaka denzelelumu; batamenu katata kanti ndombu yihiti. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.20",
            "verseOrgIds": [
              "ISA.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyenu, Yehova hakufuma mwindi mwekalayi, hakwinza nakubabesha akwakushakama hanu heseki nakuluwakwawu; iseki dakamwekesha mashi adu, hidakabuta nawa cheŋi indi ajahewaku.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.21",
            "verseOrgIds": [
              "ISA.26.21"
            ]
          }
        }
      ]
    }
  ],
