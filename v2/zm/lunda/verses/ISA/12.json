      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dena ifuku odu wakela neyi, Nukukusakililaŋa, eyi Yehova; muloŋa hela wadiŋi nakunzuwila, kuzuwa kweyi kunahiti dehi, hiwukunkundeja dinu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.1",
            "verseOrgIds": [
              "ISA.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwalala, Nzambi diyi wamwinu wami; nukukuhwelelaŋa, hinukutiya womaku; muloŋa Ya, Yehova, diyi Ŋovu yami, diyi kamina kami; yena nekali dehi wamwinu wami. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.2",
            "verseOrgIds": [
              "ISA.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi mwakaluŋga kutaha meji mumashima awamwinu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.3",
            "verseOrgIds": [
              "ISA.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dena ifuku odu mwakela nenu, Musakililenu Yehova, bidikenu ijina dindi, shimunenu mukachi kanyuza mwelaŋayi, hoshenu nenu, ijina dindi dinatuumbakani. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.4",
            "verseOrgIds": [
              "ISA.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambililenu Yehova, muloŋa yena neli yuma yawanta, chumichi achiluki mwahita isekidejima. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.5",
            "verseOrgIds": [
              "ISA.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi washakama muZiyona bulaku nyiŋula, dikuwi nanochuchelayi Wajila waIsarela, wekala mudeyi, himuneni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.6",
            "verseOrgIds": [
              "ISA.12.6"
            ]
          }
        }
      ]
    }
  ],
