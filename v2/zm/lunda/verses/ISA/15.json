    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuprofwetu wakutena Mowabi. Ari wakuMowabi awusanda dehi shati wufuku wumu hohu, wela dehi wamukunkulwayi; Kiriwa kuMowabi awusanda dehi shati wufuku wumu hohu, wela dehi wamukunkulwayi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.1",
            "verseOrgIds": [
              "ISA.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena wakanduka dehi kuBayiti, nikuDiboni, kuyinaijinaŋa, akadililuku; Mowabi hakukaloka nansaŋu yaNebo naMedeba, nyitu yawuyejima kwankumbu hohu, mawevu ejima atewula dehi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.2",
            "verseOrgIds": [
              "ISA.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiya kuvwalavwalayikeleyi hanzi jawu; nihewulu damatalawu nihamalubanzawu wejimawawu hiyakukaloka nakwalumoka heseki. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.3",
            "verseOrgIds": [
              "ISA.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heshiboni hakwaboka niEleyali nawa; izu dawu dinatiyakani nikuYahazi; dichi chakudililawu naŋovuamayala amuMowabi amanyeka; muchima windi hiwukuzaala mwivumu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.4",
            "verseOrgIds": [
              "ISA.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muchima wami hiwukwaboka nansaŋu yaMowabi; yilolu yindi hiyakutemukila kuZowari, kuEgelati Shelishiya; muloŋa adi nakukandukila kumukanduwa kuLuhiti nakudila; muloŋa kunjila yakuHoronayimi anavwakuki dehi mbila yakujilumuka. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.5",
            "verseOrgIds": [
              "ISA.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meji akuNimirimi akashala tuhu amukunkulwayi; nimatahu anomi dehi chau, nimunyenvu wunamani dehi zo-o, hosi chuma chitúuta nichimuku. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.6",
            "verseOrgIds": [
              "ISA.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi yuma yayivulu yanahetuwuni yanaswekuwu akayitwala kukakaloŋa kanyisombu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.7",
            "verseOrgIds": [
              "ISA.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa mbilayinahitahiti kuŋinza jaMowabi; kukaloka kwakalokapawu kunashiki dehini kuEgelayimi, kukaloka kwakalokapawu kunashiki dehi nikuBeyeri Elimi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.8",
            "verseOrgIds": [
              "ISA.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa meji akuDimoni aneli dehi kwamashi hohu; muloŋa nichidikuletela Dimoni yuma yi kwawu; mutupa wakalotokela antu akupuluka kuMowabi, niantu akashalahu mwituŋa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.9",
            "verseOrgIds": [
              "ISA.15.9"
            ]
          }
        }
      ]
    }
  ],
