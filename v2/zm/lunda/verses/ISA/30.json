              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa Ashuri etelaŋa antu namuhinyi, akakotoka nezu daYehova kotu kotu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.31",
            "verseOrgIds": [
              "ISA.30.31"
            ]
          }
        },
