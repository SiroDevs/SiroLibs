              "type": "text"
            }
          ]
        },
        {
          "text": "O, ituŋa davumaŋa mpuula, dekala mwishinadi datuloŋa twakulo Etiyopiya! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.1",
            "verseOrgIds": [
              "ISA.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "datemeshaŋa atuŋanda mukaluŋalwiji muma atuanyilela hameji, nawu, Enu antemesha alufuchi, yenu kumuza wawantu ataluka aselumuka, antu akutiya woma kufuma kutachi nihanu; muzawesekaŋa namwonji, wadatolaŋa, wukweti ituŋa daambuka natuloŋa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.2",
            "verseOrgIds": [
              "ISA.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
