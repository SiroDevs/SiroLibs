            "sid": "ISA 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu dihu hakamuletelawu Yehova wamazaza chamukunkulu chakudi antu ataluka aselumuka, chakudi antu akutiya woma kufumisha kutachinihanu, muza wesekaŋa namwonji, wadatolaŋa, akweti ituŋa daambuka natuloŋa, akaleta kuchipela chejina daYehova wamazaza, kumpidi yaZiyona.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.7",
            "verseOrgIds": [
              "ISA.18.7"
            ]
          }
        }
      ]
