        "sid": "2CH 35"
      },
      "items": [
        {
          "text": "35",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosiya wamudiilili Yehova paseka muYerusalema. Hiyakujaha paseka hefuku dekumi nakawana dakakweji kakusambila. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.1",
            "verseOrgIds": [
              "2CH.35.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakusha atupristu kunyidimu yawu yayishiikiluwu, hakuyikundeja akalakali mudimu wamwitala daYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.2",
            "verseOrgIds": [
              "2CH.35.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyila aLevi alejelaŋa aIsarela ejima, adiŋi amujilila Yehova, nindi, Iŋŋenu chimbaŋu chajila mwitala datuŋiliyi Solomoni mwana kaDavidi, mwanta wawaIsarela. Himwakasendaŋa cheŋi chiteli hamafwiji enuku. Ichi dinu kalakelenu Yehova Nzambi yenu nantu indi aIsarela. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.3",
            "verseOrgIds": [
              "2CH.35.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Diloŋeshenu mwahita mavumu awankakululajenu hezanvu hezanvu, mwasonekeli mwanta wawaIsarela Davidi, mwasonekelini mwanindi Solomoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.4",
            "verseOrgIds": [
              "2CH.35.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imanenu mwajila mwomwambukila mavumu awankakulula jawana kwenu anyana kawantu, mwambukila niyisakaya waLevi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.5",
            "verseOrgIds": [
              "2CH.35.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jahenu paseka, mudijiliki, muloŋesheli ana kwenu kulondaeli mwaya izu daYehova dakukanwa kaMosi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.6",
            "verseOrgIds": [
              "2CH.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.6",
            "verseOrgIds": [
              "2CH.35.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosiya hakuyinka anyana kawantu ejima adiŋuku yimuna yamwiyinda, nianyana kanyikoku nianyana kampembi, ejima anyilambu yapaseka, kuyichinda ashikili mumakombakaji makumi asatu, ni aŋombi amayala makombakaji asatu. Wenawa akumaheta amwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.7",
            "verseOrgIds": [
              "2CH.35.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atulamba hiyakuyinka antu nawatupristu, nawaLevi yakulambula chakunyichima yawu. AHilikiya naZekariya naYehiyeli, wowu anyuli akwitala daNzambi, hiyakuyinka atupristu yimuna yanyanya makombakaji ayedi namakulakaji asatu, ni aŋombi makulakaji asatu anyilambu yapaseka. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.8",
            "verseOrgIds": [
              "2CH.35.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "AKonani yanawa nawana kwindi aShemaya naNetaneli, niHashabiya, niYeyeli, niYozabadi, wowu awakulumpi awaLevi, hiyakuyinka aLevi yimuna yanyanyama kombakaji atanu, ni aŋombi makulakaji atanu anyilambu yapaseka.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.9",
            "verseOrgIds": [
              "2CH.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.9",
            "verseOrgIds": [
              "2CH.35.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mudimu wuloŋa nikuloŋa, atupristu hiyakwimana kuwimenu wawu, niaLevi niwena, hezanvu hezanvu, mwomwayilejeli mwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.10",
            "verseOrgIds": [
              "2CH.35.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajahanipaseka, atupristu hiyakusampula mashi atambwiluwu kudi wena, aLevidiwu ayuwilaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.11",
            "verseOrgIds": [
              "2CH.35.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakufumisha nyilambu yakushita, hiyakuyinka mwomwambukila mavumu awankakulula jawanyana kawantu, kulonda ahimulambu li Yehova, mwomwasonekeluwu mumukanda waMosi. Mwomweliluwu ninawaŋombi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.12",
            "verseOrgIds": [
              "2CH.35.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakwocha paseka nakesi mwomwayalushimbi; nyilambu yi kwawu yajila hiyakuyiteleka mumanilŋu, namumabupu, namujimeŋa, hiyakujitwala swayi kudi anyana kawantu ejima.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.13",
            "verseOrgIds": [
              "2CH.35.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.14",
            "verseOrgIds": [
              "2CH.35.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwakwimba anyana kaAsafwi, hiyakwimana muwimenu wawumwomwayilejeluwu aDavidi naAsafwi, naHemani, namukwakumona wamwanta Yedutuni. Akwakuhemba kuyisu adiŋi kuyisu yejima. Hichikwetiwena kufuma kumudimu wawuku, muloŋa ana kwawu aLevi diwuadiŋi nakuyiloŋeshela.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.15",
            "verseOrgIds": [
              "2CH.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.15",
            "verseOrgIds": [
              "2CH.35.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifuku dodenodu dodaloŋesheluwu mudimu waYehova wejima, niwakudya paseka, niwakulambula nyilambu yakushita hakameŋa kaYehova, mwomwayilejeluwu kudi mwanta Yosiya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.16",
            "verseOrgIds": [
              "2CH.35.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 35:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaIsarela adiŋuku adiili paseka hohenahana, adiili nichawija chamankendi akadi iluŋi mafuku atanu nayedi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.17",
            "verseOrgIds": [
              "2CH.35.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 35:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paseka yidochu kanda ayidyaŋahu dehi muIsarela, kufumisha hamafuku akaprofwetu Samweluku. Hela anyanta awaIsarela ejima kudyahu paseka yidi neyi yadiili Yosiya, nawatupristu, nawaLevi, nawaYuda, nawaIsarela ejima adiŋuku, nawakwakushakama muYerusalema, nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.18",
            "verseOrgIds": [
              "2CH.35.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwaka wawanta waYosiya wekumi nakatanu nakasatu, dimu mwadiiluwu paseka iyi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.19",
            "verseOrgIds": [
              "2CH.35.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.19",
            "verseOrgIds": [
              "2CH.35.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 35:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulondela hayuma yejimiyi, heliliyi Yosiya naloŋeshi dehi tembeli, mwanta wakuEjipitu Neko hakuya, nindi akalwi naKarikemishi kuYufurati. Yosiya hakuya nakulwa nindi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.20",
            "verseOrgIds": [
              "2CH.35.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 35:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.25",
            "verseOrgIds": [
              "2CH.35.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 35:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsaŋu jaYosiya jinashaluku, ninyidimu yayiwahi yaya mwanasoneku wumumukanda wanshimbi jaYehova, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.26",
            "verseOrgIds": [
              "2CH.35.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 35:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "nsaŋu jindi nkusambilankuku minina, talenu, anajisoneki mumukanda wawanyanta awaIsarela nawa Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.27",
            "verseOrgIds": [
              "2CH.35.27"
            ]
          }
        }
      ]
    }
