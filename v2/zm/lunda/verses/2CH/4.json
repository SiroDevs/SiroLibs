        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakutuŋa kameŋa kawuneŋu, mukuleha kwaku munkotweli jachikasa makumi ayedi, mukutoha kwaku munkotweli makumi ayedi, muwuzandamuwaku munkotweli ikumi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.1",
            "verseOrgIds": [
              "2CH.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Welili niŋiya dakusuŋununa, kufumishakunsa yimu nakushika kunsa yi kwawu nkotweli ikumi dawujiya, mukuzandama kwadu munkotweli jitanu; dakunyeŋumwisha mwonji wamunkotweli makumi asatu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.2",
            "verseOrgIds": [
              "2CH.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwishina dadu mwadiŋi yuma yidi neyiaŋombi, yadinyeŋu mwishili kwi-ndo, yamunkotweli ikumi, yanyeŋu mwishili ŋiya kwi-ndo. Aŋombi adiŋi nyisululu yiyedi, akusuŋunwina kumu nejiya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.3",
            "verseOrgIds": [
              "2CH.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.6",
            "verseOrgIds": [
              "2CH.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Welili nimanoŋu awuru ikumi, mwomwaya lushimbi lwayiteneni. Hakuyisha mutembeli, atanu kuchikasa chachidiilu, atanu kuchimunswa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.7",
            "verseOrgIds": [
              "2CH.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.8",
            "verseOrgIds": [
              "2CH.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Welili nichipaŋu chawatupristu, nichipaŋu cheneni, niyenzelu yachipaŋu, hayenzelu yayu walamikiluhu wunepu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.9",
            "verseOrgIds": [
              "2CH.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakusha ŋiya kuchikasa chachidiilu kumusela, datala kukabeta kakuchidiilu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.10",
            "verseOrgIds": [
              "2CH.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.10",
            "verseOrgIds": [
              "2CH.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hurami welili nimanupu, namafwosholu, nimbashila janyanya. Hurami amanisha nikumanisha mudimu wamwitala daNzambi wakoŋeleliyimwanta Solomoni; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.11",
            "verseOrgIds": [
              "2CH.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "yoyishimi yiyedi, nihananina nyitu, ninyituyiyedi yahewulu dayishimi; nitunyungulu tuyedi twafwana neyi kaleŋi twakujikaŋa hananina nyitu yadiŋi hewulu dayishimi; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.12",
            "verseOrgIds": [
              "2CH.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimabula makulakajiawana akusha kutunyungulu tuyedi; nyisululu yamabula yiyedi yakalepikamu, twonsu tuyedi chochu, kulonda kujika hananina nyitu yadiŋi hewuludayishimi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.13",
            "verseOrgIds": [
              "2CH.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Welili nawa nimatentaminu, welili nimbashila hamatentaminu; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.14",
            "verseOrgIds": [
              "2CH.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "niŋiya dimu, niaŋombi ikumi nayedi mwishina dadu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.15",
            "verseOrgIds": [
              "2CH.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimanuŋunawa ni mafwosholu nitutuwa twanyisomu, niyuma yayu yejima, tatayindi Hurami wayituŋalili mwanta Solomoni yeta la daYehova vawuneŋuwakejima. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.16",
            "verseOrgIds": [
              "2CH.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wayisuŋunwinini muchana chaYodana mumasekiewumba, Sukoti iku Zereda iku.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.17",
            "verseOrgIds": [
              "2CH.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.17",
            "verseOrgIds": [
              "2CH.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Solomoni welili yumiyi yejima yaswejeli kuvula. Pezu yawuneŋukutwesha kuyiluka nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.18",
            "verseOrgIds": [
              "2CH.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni welili yuma yejima yadiŋi mwitala daNzambi, nikameŋi kawuru nawa, nŋimesa jakutentekela mankendi kumesu aNzambi; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.19",
            "verseOrgIds": [
              "2CH.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimanoŋu namanoŋu awu, kulonda akabutukaŋa kumesu awuhoshelu mwomwaya lushimbi, yawuru wakoseka; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.20",
            "verseOrgIds": [
              "2CH.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ninkenu, nimanoŋu, ninzamba, jawuru, wuru waweni walala hachikupu; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.21",
            "verseOrgIds": [
              "2CH.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "niyumayakujima nachu manopu, nimbashila janyanya, nitutuwa, niyeŋa yakusendela insensi, yawuru wakoseka. Hakwila kuwiŋililu wakwitala, niyenzelu yayu yamukachi yamwasweja kujila, niyenzelu yetala dadeni, yotembeli, yadiŋiyawuru.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.22",
            "verseOrgIds": [
              "2CH.4.22"
            ]
          }
        }
      ]
    }
  ],
