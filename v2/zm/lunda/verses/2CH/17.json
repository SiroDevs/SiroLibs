        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanindi Yehoshafwati hakumuswana, hakudikolesha kulondakulwa nawaIsarela.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.1",
            "verseOrgIds": [
              "2CH.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.4",
            "verseOrgIds": [
              "2CH.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Yehova hakumukoleshela wanta muchikasa chindi; aYuda ejima hiyakumuletela Yehoshafwati nyilambu; waswejeli nikuhetanikulema. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.5",
            "verseOrgIds": [
              "2CH.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muchima windi awukolesheli munjila jaYehova; hakulunjikakunichuma chikwawu chakufumisha yinaŋanaŋa nanyiyombu muYuda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.6",
            "verseOrgIds": [
              "2CH.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.6",
            "verseOrgIds": [
              "2CH.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwaka wayulihyi wamuchisatu, hakutemesha atulamba twindi aBenihayili naObadiya, niZekariya, niNetaneli, niMikaya, akaleji antumunyikala yamuYuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.7",
            "verseOrgIds": [
              "2CH.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayitemesheli hamu nawaLevi, aShemayana Netaniya, niZebadiya, niAsaheli, niShemiramoti, niYehonatani, niAdoniya, niTobiya, niTobi Adoniya, wowu aLevi; niatupristu aElishamana Yehorami hamu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.8",
            "verseOrgIds": [
              "2CH.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakuleja antu amuYuda, iku anasendi mukandawanshimbi jaYehova; hiyakukimboka munyikala yamuYuda yejima, hiyakulejaleja mukachi kawantu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.9",
            "verseOrgIds": [
              "2CH.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.9",
            "verseOrgIds": [
              "2CH.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Woma waYehova waholokeli mumawanta amumatuŋa adiŋi kwakwihi naYuda, kumwasaŋa Yehoshafwati majita nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.10",
            "verseOrgIds": [
              "2CH.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "AFwilistinu amakwawu amuleteleli Yehoshafwati nyilambu, hiyakuhimulambu la nisiliva. Arabiya niwena amuleteleli nyikoku, yizamba makombakaji atanu nayedi namakulakaji atanu nayedi, niyizamba yampembi makombakaji atanu nayedina makulakaji atanu nayedi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.11",
            "verseOrgIds": [
              "2CH.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoshafwati hakuya nakutoha nankashi, hakutuŋa muYuda matala akuhata, ninyikala yakuswekela yuma. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.12",
            "verseOrgIds": [
              "2CH.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wadi ijina nyidimu yayivulu munyikala yamuYuda; niakwanjita niayilobu akwaŋovu muYerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.13",
            "verseOrgIds": [
              "2CH.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.13",
            "verseOrgIds": [
              "2CH.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyenu mwayi chindililuwu mwahita mavumu awankakulula jawu; amuYuda, awakulumpi amakombakaji; kapiteni Adina, nawantu indi ayilobu akwaŋovu makombakaji makulakaji asatu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.14",
            "verseOrgIds": [
              "2CH.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mudi yena mwalondeli mukulumpi wanjita Yehohanani nawantu indi makombakaji makumi atanunadimu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.15",
            "verseOrgIds": [
              "2CH.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mudi yena mwalondeli mwana kaZikiri Amasiya, wadihenikudi Yehova chakumuchima windi yomweni, nawantu indi ayilobu akwaŋovu makombakaji makulakaji ayedi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.16",
            "verseOrgIds": [
              "2CH.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "AmuBenjamini; Eliyada chilobu mukwa Ŋovu, nawantu indi akweti mata anyikunji nankebu, makombakaji makulakaji ayedi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.17",
            "verseOrgIds": [
              "2CH.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mudi yena mwalondeli Yehozabadi, nawantu indima kombakaji nkulakaji, namakombakaji makumi atanu nasatu adiloŋesha dehi kulonda ayi kunjita. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.18",
            "verseOrgIds": [
              "2CH.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenawa diwu adiŋi nakumwimena mwanta, kubombelaku ninawa ashiliyi mwanta munyikala yampwembu mwahita Yuda mwejima.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.19",
            "verseOrgIds": [
              "2CH.17.19"
            ]
          }
        }
      ]
    }
  ],
