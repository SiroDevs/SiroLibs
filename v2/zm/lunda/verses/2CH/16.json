        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwaka wayuliliyi Asa wamakumi asatu nakatanu nakamu, mwanta wawaIsarela Bayasha, haltuya nakulwa nawaYuda, hakutuna Rama, kulonda akaneshi antu hela kuya kudi mwanta wawaYuda Asa, hela kufunta cheŋi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.1",
            "verseOrgIds": [
              "2CH.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asa hakwidisha siliva, nawuru, mwaswekelana wuyuma yalema yamwitala daYehova, nimwitala damwanta, hakuyitemesha kudi mwanta wakuSiriya Benihadadi washakamini kuDamakasa, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.2",
            "verseOrgIds": [
              "2CH.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Tunakwati dehi wubwambu naneyi, neyi chakwatiliyi tata yami natata yeyi. Tala, siliva nawuru owu, yaku wakajahi wubwambu weyi namwanta wawaIsarela Bayasha, kulonda anfumi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.3",
            "verseOrgIds": [
              "2CH.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.4",
            "verseOrgIds": [
              "2CH.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chachitiyiliyi Bayasha, hakuleka kutuŋi Rama, etŋi nimudimu windikukuma. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.5",
            "verseOrgIds": [
              "2CH.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta Asa hakutambula aYuda ejima, hiyakututa malola akuRama, ninyalachi yawu yatuŋilaŋayi nachu Bayasha, hakutuna nachuGeba niMizipa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.6",
            "verseOrgIds": [
              "2CH.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.6",
            "verseOrgIds": [
              "2CH.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu Hanani mukwakumona hakwinza kudi mwanta wawaYuda Asa, hakumwila nindi, Chiwunashindameni hadi mwanta wakuSiriya, kushindamena hadi Yehova Nzambi yeyi nehi, dichi njita yamwantawa kuSiriya yinapuluki dehi kudeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.7",
            "verseOrgIds": [
              "2CH.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komana aEtiyopiya nawaLubi hiyadiŋi njita yeneni nankashuku, tahindi? Hiyadiŋi namakálu nawakwatuwalu abadika kuvulaku, tahindi? Chiwashindameneni hadi Yehova wayiheni kudeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.8",
            "verseOrgIds": [
              "2CH.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa mesu aYehova adi nakutalatala mwahita iseki dejima, kulonda akwashuku naŋovu adi nanyichima yalala, yindi chikupu. Chumichi chiwunakoŋi wunakoŋi chawusupi; dichi kufumisha henahanu wakamonamajita hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.9",
            "verseOrgIds": [
              "2CH.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asa hakuzuwa namukwakumona, hakumushamwitala dakaleya; hakumuzuwila nankashi nachumichi. Hamafuku owu Asa hakukabisha antu amakwawu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.10",
            "verseOrgIds": [
              "2CH.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.10",
            "verseOrgIds": [
              "2CH.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyenu, nsaŋu jaAsa nkusambila nkukuminina, anajisoneki mumukanda wawanyanta awaYuda nawaIsarela. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.11",
            "verseOrgIds": [
              "2CH.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwaka wayuliliyiwamakumi asatu nakatanu nakawana, Asa hakukata nyendu; musoŋu windiwaswejeli nankashi. Hela chochu, hakeŋakeŋeli Yehova namusoŋuwinduku, chiŋa ayimbuki hohu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.12",
            "verseOrgIds": [
              "2CH.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.12",
            "verseOrgIds": [
              "2CH.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asa wakamini hamu nawankakulula jindi, wafwili mumwaka wayuliliyiwamakumi awana namwaka wumu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.13",
            "verseOrgIds": [
              "2CH.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amujiikili kumajamu indi yomweni adiŋo kweleleliyi mumukala waDavidi, amukamiki Lihakadidi kenzala namavumba amawahi, nanyiseki yeŋi nayeŋi yakulonesha chachiwahi kudi akwakusohola yitumbu yayiwahi; amubutwilili ŋiku deneni nankashi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.14",
            "verseOrgIds": [
              "2CH.16.14"
            ]
          }
        }
      ]
    }
  ],
