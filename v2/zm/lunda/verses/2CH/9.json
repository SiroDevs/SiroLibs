        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wakuSheba wamumbanda walukanu, chatiyiliyi mpuhu yaSolomoni, hakwinza nakumweseka Solomoni nakumwihujola yumayakala kuYerusalema. Wenjili naluntu lwaluvulu nankashi, nianŋameli asenda nyiseki, niwuru wawuvulu nankashi, nitumalola twawuseya weneni. Chenjiliyi kudi Solomoni hakuhosha nindi yadiŋi mumuchima windiyejima. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.1",
            "verseOrgIds": [
              "2CH.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni wamulejeli mwamwihwiliyi mwejima; hikwadiŋi chuma chakaŋenyiyi Solomoni chabuliliyi kumulejayuku.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.2",
            "verseOrgIds": [
              "2CH.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.2",
            "verseOrgIds": [
              "2CH.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wakuSheba chamweniyi maana aSolomoni ejima, niitaladatuŋiliyi, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.3",
            "verseOrgIds": [
              "2CH.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "niyadiilaŋawu kumesa yindi, nimwasha kaminaŋawu ambuŋindi, nimwemenaŋawu aŋambela jindi, niwuvwalu wawu, niantu indi akwakutwalampasa, niwuvwalu wawu, nimwakandukililaŋayi kwitala daYehova, hadiŋi nawa cheŋi naŋovuku. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.4",
            "verseOrgIds": [
              "2CH.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakumwila mwanta nindi, Chinatiyili mwituŋa dami mwashi mwinuwuni muwelaŋa ninsaŋu jamaaneyi, komana chalala. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.5",
            "verseOrgIds": [
              "2CH.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwashi mwinuwu hinetiyili mwokuku. Ichi chinenzi namoni dehi namesu ami; komana hiyanshi mwinini hela chibalu chamaaneyi aswejaku; wunabadiki mpuhuyinatiyili. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.6",
            "verseOrgIds": [
              "2CH.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu eyi akooleka, awa ambuŋeyi emanaŋa mafuku ejimakumesu eyi nakutiya maaneyi akooleka. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.7",
            "verseOrgIds": [
              "2CH.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisu kisu Yehova Nzambi yeyi wakutiyili kuwaha, wakushakamishili hetanda dindi dawanta, wikali mwanta wakumuyulila Yehova Nzambi yeyi. Ochu chakeŋeluwu Isarela kudi Yehova, kulonda ayikoleshi chahaya nyaka, dichi chanakudiishiliyi wantawawu, kulonda wilaŋa ngwuŋaji nkuloŋa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.8",
            "verseOrgIds": [
              "2CH.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.8",
            "verseOrgIds": [
              "2CH.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakumwinka mwanta ntalenta jawuru nkulakaji namakumi ayedi, ninyiseki yayivulu nankashi, nitumalola twawuseya weneni. Hikwadininawa cheŋi nyiseki yayivulu yidi neyi yamwinkeluwu mwanta Solomoni kudi mwanta wamumbanda wakuShebaku.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.9",
            "verseOrgIds": [
              "2CH.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.9",
            "verseOrgIds": [
              "2CH.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "AmbuŋaHurami nawa niambuŋa Solomoni, wowu enjili nawuru wakuOfwiri, diwu aleteli nyitondu yaaliŋumi nitumalola twawuseya weneni.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.10",
            "verseOrgIds": [
              "2CH.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.10",
            "verseOrgIds": [
              "2CH.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyu nyitondu yaaliŋumi mwanta hakutuŋa nachu yimaŋu yakwitala daYehova niyakwitala damwanta, nitudada niyisanji yawakwakwimba; kanda amonaŋahu dehi yidi chochochu mwituŋa daYudaku.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.11",
            "verseOrgIds": [
              "2CH.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.11",
            "verseOrgIds": [
              "2CH.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta Solomoni wamwinkeli mwanta wakuSheba yakeŋeliyi yejima, yanalombiyi yoyu, yakulunjika hayuma yaleteleliyi mwanta Solomoni. Hakubalumuka, hakufunta kwituŋa dindi, niyena niamouŋindi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.12",
            "verseOrgIds": [
              "2CH.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.12",
            "verseOrgIds": [
              "2CH.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pezu yawuru yenjilaŋa kudi Solomoni mumwaka wumu, yashikilaŋa muntalenta jawuru makulakaji atanu nadimu, namakumi atanu nadimu, nantalenta jitanu nayimu; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.13",
            "verseOrgIds": [
              "2CH.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "yakulunjika hayafuminaŋa kudi akwakulandulula, nikudi akwakulandisha; anyanta akuArabiya niayilolu amwituŋa letelaŋa niwuru nisiliva kudi Solomoni.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.14",
            "verseOrgIds": [
              "2CH.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.14",
            "verseOrgIds": [
              "2CH.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta Solomoni welili yibasa yawuru wakuchila makulakaji ayedi; chibasa chimu chakwila najishekeli jawuru wakuchila makulakaji atanunadimu, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.15",
            "verseOrgIds": [
              "2CH.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ninkebu jawuru wakuchila makulakaji asatu; nkebu yimuyakwila najishekeli jawuru makulakaji asatu. Mwanta wajishili mwitala damwisaŋa daLebanoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.16",
            "verseOrgIds": [
              "2CH.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta watuŋili nawa itanda dawanta denenidambiŋa yanjamba, walamikiluhu wuru wakoseka. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.17",
            "verseOrgIds": [
              "2CH.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwadiŋi yimaŋuyitanu nachimu yakukandamina kwitanda, niitanda dakunyendu dawuru, yumiyi ayipatilili kwitanda. Kuwushakaminu kwadiŋi hawusachilu wamakasani ishinadi niishinadi, kwakwihi nakuwusachilu kwadiŋi kwemananyituŋa yiyedi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.18",
            "verseOrgIds": [
              "2CH.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninyitupa ikumi nayiyedi yemana kwenoku kumbadijiyi maŋu yakukandamina yitanu nachimu nimbadi nimbadi. Mwituŋa dacheŋi himwadiŋi chuma chidi neyi ochuku.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.19",
            "verseOrgIds": [
              "2CH.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.19",
            "verseOrgIds": [
              "2CH.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuma yakunwina mwanta Solomoni yadiŋi yawuru hohu yejima, niyuma yakwitala dakwisapa daLebanoni yadiŋi yawuru wakoseka hohuyejima; siliva hamafuku aSolomoni ayimweni nawu yamukunkulwayi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.20",
            "verseOrgIds": [
              "2CH.9.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.21",
            "verseOrgIds": [
              "2CH.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi mwanta Solomoni wabadikili anyanta ankanu ahamaseki ejima nimaheta nima ana. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.22",
            "verseOrgIds": [
              "2CH.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyanta ahamaseki ejima enjilaŋa kudi Solomoni kulonda kutiya maana indi anamushiluwu mumuchima windi kudi Nzambi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.23",
            "verseOrgIds": [
              "2CH.9.23"
            ]
          }
        }
      ]
    },
