            "sid": "2CH 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsaŋu jaSolomoni jinashaluku, nkusambila nkukuminina, hiyana jisoneki mumukanda wakaprofwetu Natani, nimuwuprofwetu waAhiyawa kuShilo, nimuyimwenu yaldo mukwakumona yansaŋu yamwana kaNebati Yerobowamu ku? ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.29",
            "verseOrgIds": [
              "2CH.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni wayulili aIsarela ejima muYerusalema nyaka makumi awana. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.30",
            "verseOrgIds": [
              "2CH.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni hakukama nawankakulula jindi, amujiikili mumukala watata yindi Davidi. Mwanindi Rehobowami hakumuswana.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.31",
            "verseOrgIds": [
              "2CH.9.31"
            ]
