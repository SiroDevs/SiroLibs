              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi akakuvulumuna; ochu kudi muntu wabulaŋa kuvulumuna? nineyi hiwakazuwa nawu, hiwakayihana kudi ayilumbu jawu, hiyakayitwala munyonji mwituŋa dacheŋi, hela kwakulehi hela kwakwihi; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.36",
            "verseOrgIds": [
              "2CH.6.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2CH 6:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwituŋa dakayitwalawu munyonji, neyi akabalumuka cheŋi, hiyakakulembelela omumwituŋa dayitweluwu munyonji, nawu, Tunavulumuni dehi, tunatamishi dehi, tunakoŋi chatama; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.37",
            "verseOrgIds": [
              "2CH.6.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
