          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "neyi akafunta kudeyi nanyichima yawu yejima, nawumi wawu wejima, omu mwituŋa dawukoli wawu dayitweluwu munyonji, neyi akalomba nakutalisha kwituŋa dawu diwenkeli ankakulula jawu, nikumukala wunatondi, nikwitala dinatuŋili ijina deyi; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.38",
            "verseOrgIds": [
              "2CH.6.38"
            ]
          }
        },
        {
          "name": "verse",
