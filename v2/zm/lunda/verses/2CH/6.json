          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakatiyaŋa mwiwulu nimwanalombuwu, nimwanalembeleluwu, wakayikwashaŋaku nansaŋu yawu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.35",
