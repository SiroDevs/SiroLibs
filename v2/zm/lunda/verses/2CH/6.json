              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi antu eyi akaya nakudasa njita nawayilumbu jawu, njila yonsuyiwakayituma yoyu, neyi akalomba nakutalisha kumukala wunatondi, kwitala dinatuŋili ijina deyi; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.34",
            "verseOrgIds": [
              "2CH.6.34"
            ]
          }
        },
