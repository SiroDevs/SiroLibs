  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "2CH 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu Solomoni hakuhosha nindi, Yehova wahosheli nindi wukushakama mumwidima washishita. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.1",
            "verseOrgIds": [
              "2CH.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwila ami nakutuŋili italadakushakama, mwakushakameyi haya nyaka.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.2",
            "verseOrgIds": [
              "2CH.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.2",
            "verseOrgIds": [
              "2CH.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta hakushetumuka, hakukiswila chipompelu chawaIsarela chejimankisu; chipompelu chawaIsarela chejima hichikwimana. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.3",
            "verseOrgIds": [
              "2CH.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwila nindi, Kisu kisu Yehova Nzambi yaIsarela, wahosheli natata yami Davidi nakanwakindi, nakoŋumu nawa namakasindi, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.4",
            "verseOrgIds": [
              "2CH.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "cheliliyi nindi, Kufumisha hefukudi nafumishili antu ami mwituŋa daEjipitu, munyichidi yawaIsarela yejima hinatondelumu mukala wakutuŋilamu itala kulonda mwikalumu ijinadamuku; hela kutonda muntu wakwikala nlomboli yawantu ami aIsarela nehi; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.5",
            "verseOrgIds": [
              "2CH.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ilaŋa ichi natondi dehi Yerusalema, kulonda ijina dami dakekaluku; natondi dehi Davidi akayulaŋa antu ami aIsarela. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.6",
            "verseOrgIds": [
              "2CH.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumuchima watata yami Davidi kwadiŋi jakutuŋa itala dejina daYehova Nzambi yaIsarela. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.7",
            "verseOrgIds": [
              "2CH.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa Yehova wamwilili tata yami Davidi, nindi, Chikwadiŋi kumuchima weyi jakutuŋila ijina dami itala chachiwahi, chawaha chiwachifuukula kumuchima weyi; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.8",
            "verseOrgIds": [
              "2CH.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "hela chochu, eyi kutuŋa itala nehi; ilaŋa mwaneyi wakafuma munkuma yeyi diyi wakatuŋila ijina dami itala. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.9",
            "verseOrgIds": [
              "2CH.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi dinu Yehova nakoŋi dehi mwizu dindi dahosheliyi; muloŋa ami nahiŋi mwadiŋiyitata yami Davidi, nashakami hetanda dawaIsarela dawanta, mwakaniniyi Yehova, natuŋi dehi itala dejina daYehova Nzambi yaIsarela. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.10",
            "verseOrgIds": [
              "2CH.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dimun nashi chimbaŋu chi kweti chitiyaŋenu chaYehova chatiyaŋeniyi nawanyana kaIsarela.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.11",
            "verseOrgIds": [
              "2CH.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.11",
            "verseOrgIds": [
              "2CH.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwimana kumbidi yakameŋa kaYehova kumesu achipompelu cha waIsarela chejima, hakutanjika makasindi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.12",
            "verseOrgIds": [
              "2CH.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa Solomoni watuŋili chimeta chawuneŋu chankotweli jachikasa jitanu mukuleha, nkotweli jitanu mukutoha, nkotweli jisatu muwuzandamu, wachishili mukachi kachipaŋu; hakwimanahu, hakufukaminahu hamanuŋu indikumesu achipompelu chawaIsarela chejima, hakutanjika makasindi kwiwulu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.13",
            "verseOrgIds": [
              "2CH.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.21",
            "verseOrgIds": [
              "2CH.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi muntu wakavulumuna mukwawu, neyi akamukakeja nawu, Sanyikaku, sanyikaku, yena hakenza nakusanyikila kukameŋa keyi mwitalidi; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.22",
            "verseOrgIds": [
              "2CH.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakatiyaŋa mwiwulu, wakakwataŋaku, wakasompeshaŋa ambuŋeyi, wakababeshaŋa watama nakumushikŋila hanamutu windi mwaneliyi; wakayiŋishaŋawalorŋa nakumwinka yineseki nakuloŋa kwindi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.23",
            "verseOrgIds": [
              "2CH.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.23",
            "verseOrgIds": [
              "2CH.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi antu eyi aIsarela akayitapa kudi ayilumbu jawu nanochu chanakuvulumunuwu, neyi akabalumuka cheŋi kudeyi nakwitŋi ijina devinakulomba, nakulembelela kumesu eyi mwitalidi, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.24",
            "verseOrgIds": [
              "2CH.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakatiyaŋa mwiwulu, wakaanakenaŋa antu eyi aIsarela nshidi yawu, wakayifuntishaŋa cheŋi mwituŋa diwenkeli ankakulula jawu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.25",
            "verseOrgIds": [
              "2CH.6.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.25",
            "verseOrgIds": [
              "2CH.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi mwiwulu mwakajika, nvula nehi, nanochu chanakuvulumunuwu, chiwakayi babesha, neyi akalomba nakutalisha kuchipelichi, nakwitŋi ijina deyi, nakubalumuka nakuleka nshidi yawu; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.26",
            "verseOrgIds": [
              "2CH.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakatiyaŋa mwiwulu, wakaanakenaŋa ambuŋeyi nshidi yawu niantu eyi aIsarela, chiwakayi lejanjila yayiwahi yakwenda; wakatemesha nvula hetuŋi deyi diwenkeli antu eyi kuswana.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.27",
            "verseOrgIds": [
              "2CH.6.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.27",
            "verseOrgIds": [
              "2CH.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi mwituŋa mwakaholoka nzala, hela neyi mwakaholoka chipupu, hela neyi mwakenza kuuma kwakuuma yuma yejima chau, hela mbuwa, hela tubola, hela mahashi; hela neyi chilumbu chawu wakayikuchikamunyikala yawu mwituŋa; chipupu chonsu chakamonawu, hela yikatu yonsu yakamonawu; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.28",
            "verseOrgIds": [
              "2CH.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwonsu mwakalomba, mwonsu mwakalembelelamuntu himuntu mwahitila antu eyi aIsarela ejima, mwakelukilawu yipupu yamunyichima yawu wejima wawu, niyihuŋu yawu wejima wawu, hiyakolola makasawu nakutalisha kwitalidi; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.29",
            "verseOrgIds": [
              "2CH.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakatiyaŋa mwiwulu muwashakama, wakayanakenaŋa, wakayilaŋa antu ejima, iwu mwaneliyi, iwu mwaneliyi, yeyi weluka nyichima yawu. Muloŋa eyi, yeyi hohu weluka nyichima yawanyana kawantu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.30",
            "verseOrgIds": [
              "2CH.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulonda akakutiyaŋa woma, akendaŋa mwaya njila jeyi mafuku ejima akashakamawu mwituŋa diwenkeli ankakulula jetu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.31",
            "verseOrgIds": [
              "2CH.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela mwenyi wákubula kwikala muntu weyi kaIsarela, neyi wakafuma mwituŋa dakwakulehi nansaŋu yejina deyi deneni, nansaŋu yachikasa cheyichaŋovu, niyachikasa cheyi chakwolola; chakenzawu nakulomba nakutalishakwitalidi, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.32",
            "verseOrgIds": [
              "2CH.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "eyi omu mwiwulu muwashakama wakatiyapa, wakelaŋa yejima yakakutambikilawu enyi; kulonda nyuza yahamaseki yejima yakeluki ijina deyi, akakutiyi woma, neyi chatiyaŋawu antu eyi aIsarela, kulonda akelukinawu, italidi dinatuŋi anaditeneni ijina deyi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.33",
            "verseOrgIds": [
              "2CH.6.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
