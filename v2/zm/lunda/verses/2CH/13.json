          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamwaka wamwanta Yerobowami wekumi nakatanu nakasatu hatachikiliyi Abiya kuyula aYuda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.1",
            "verseOrgIds": [
              "2CH.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.2",
            "verseOrgIds": [
              "2CH.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiya hakuya kunjita nanjita yindi yawayilobu akwaŋovu makombakaji makulakaji awana, awamayala akutonda chakutonda; Yerobowami hakumutanji kilanjita yawamayala akutonda chakutonda makombakaji makulakaji atanu nasatu, ayilobu akwaŋovu hohu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.3",
            "verseOrgIds": [
              "2CH.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.3",
            "verseOrgIds": [
              "2CH.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiya hakwimana hampidi yaZemarayimi yekala mwituŋa daEfweremi damapidi, nindi, Enu aYerobowami nawaIsarela ejima, ntiyenu; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.4",
            "verseOrgIds": [
              "2CH.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chidi kudenu kwiluka nenu Yehova Nzambi yawaIsarela wenkeli Davidi wantawa waIsarela chahaya nyaka, hamwinkeli yena nawanyanindi nachitiyaŋe nucha muŋwaku, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.5",
            "verseOrgIds": [
              "2CH.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana kaNebati Yerobowami, kambuŋa mwana kaDavidi Solomoni, wamunyamukilili, wadikaŋili nankaka yindi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.6",
            "verseOrgIds": [
              "2CH.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kudiyena kwapompeli antu amukunkulwayi, anyana kaBeliyali, hiyakuleta Ŋovu namwana kaSolomoni Rehobowami hachidipiyi Rehobowami wuchidi kansi, wuchidi namuchima wawovu, kutwesha kudikolesha nawu nehi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.7",
            "verseOrgIds": [
              "2CH.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.7",
            "verseOrgIds": [
              "2CH.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu munatopojoki nenu mudikaŋi nawanta waYehova wudinanetu anyana kaDavidi; enu muluntu lwalweni, mudi nanyana kaŋombiyawuru yayilililiyi Yerobowami nindi yiikali akishi enu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.8",
            "verseOrgIds": [
              "2CH.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atupristu twaYehova, anyana kaAroni, niaLevi himunayihaŋuku? Himuneli dehi atupristu twenu neyi chelaŋawu antu akumatuŋa acheŋuku? Himukwilawukwinza nakudi kunjikaku neyoŋa daŋombi weyala niyizamba yanyikoku yitanu nayiyedi, diyi wukwi kala kapristu kanawa anabuli kwikala Nzambi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.9",
            "verseOrgIds": [
              "2CH.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.12",
            "verseOrgIds": [
              "2CH.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yerobowami hakuhitisha kunyima yawu akwakuyi bela mina; hiyakwila kumesu aYuda kudi antu, kunyima yawu kudi akwakuyi bela mina. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.13",
            "verseOrgIds": [
              "2CH.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "AYuda cheliluwu nawu atali hanyima, hiyakumona komana njita yidi nikumbidi nikunyima. Hiyakubilela kudi Yehova, atupristu niwenahiyakwimba mpuŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.14",
            "verseOrgIds": [
              "2CH.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amayala aYuda hiyakudikuwa; chakudikuwawu amayala aYuda, Nzambi hakutapa Yerobowami nawaIsarela ejima kwakuya wuAbiya nawaYuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.15",
            "verseOrgIds": [
              "2CH.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaIsarela atemukili kwakuyawu aYuda; Nzambi wayiheni kudi wena.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.16",
            "verseOrgIds": [
              "2CH.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.16",
            "verseOrgIds": [
              "2CH.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiya nawantu indi ayijahili kwanyilaŋalaŋahohu; kwadimbukili aIsarela akufwa amayala akutonda chakutonda makombakaji makulakaji atanu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.17",
            "verseOrgIds": [
              "2CH.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaIsarela afwomoka nikufwomokahenohu fwo-o, anyana kaYuda emika nimushindu, muloŋa ashindameneni hadi Yehova, Nzambi yawankakulula jawu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.18",
            "verseOrgIds": [
              "2CH.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiya hakukupisha Yerobowami, hakumutambula nyikala, niBeteli ninyikala yawu, niYeshana ninyikala yawu, niEfwenaoni ninyikala yawu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.19",
            "verseOrgIds": [
              "2CH.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yerobowami hakwatilicheŋi Ŋovu hamafuku adiŋiyi Abiyaku; Yehova wamweteli hakufwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.20",
            "verseOrgIds": [
              "2CH.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiya hakusweja Ŋovu, hakusumbula aŋodi jindi ikumi nawana, hakuvwala anyana amayala makumi ayedi nayedi, ambanda ikumi natanu nawumu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.21",
            "verseOrgIds": [
              "2CH.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsaŋu jaAbiya jinashaluku, nimwendeleliyi, nimwahosheliyi, anajisonekimu nsaŋu yakaprofwetu Ido.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.22",
            "verseOrgIds": [
              "2CH.13.22"
            ]
          }
        }
      ]
    }
  ],
