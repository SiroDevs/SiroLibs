  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "HEB 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakelenu kukeŋaŋana nawana kwenu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.1",
            "verseOrgIds": [
              "HEB.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi muvulamena kukeŋaenyuku; muloŋa amakwawu adiishili dehi aŋelu chakadi kuyiluka. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.2",
            "verseOrgIds": [
              "HEB.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anukenu adi munyonji, neyi kafwampi mudi nawu munyonji. Anukenu anakabishuwu, nanochu chimuneli ninenu aweni mudi mumujimba nawa. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.3",
            "verseOrgIds": [
              "HEB.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kusumbula kwikali kwalema kudi antu ejima, nikadidi kekali kajila; muloŋa Nzambi wakasompesha akwakubajama niayivumbi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.4",
            "verseOrgIds": [
              "HEB.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikalenu nanyichima yakadi kufwila mali; toŋojokenu yuma yimudi nayu nenu yinawani dehi; muloŋa yomweni nahoshi nindi, Hinamba kakulekaku, hela kukushiya hinakakushiyaku. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.5",
            "verseOrgIds": [
              "HEB.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi twahoshaŋa chakadi woma netu, Yehova diyi nkwashi yami, hinukutiya womaku, antu akuŋila chumanyi?",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.6",
            "verseOrgIds": [
              "HEB.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.6",
            "verseOrgIds": [
              "HEB.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anukenu anlomboli jenu ayilejeli mazu aNzambi; shinshikenu chashakaminuwu, imbujolenu kukuhwelela kwawu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.7",
            "verseOrgIds": [
              "HEB.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu Kristu yowumu nihaloshi, nilelu, nihaya nyaka. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.8",
            "verseOrgIds": [
              "HEB.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi mulelujoka nakuleja kwakwiha kwacheŋi nakwacheŋuku; chachiwahi kukolesha muchima naluwi, bayi nayakudya yabulili kukwasha antu ashiluku muchimaku. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.9",
            "verseOrgIds": [
              "HEB.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etu tukweti kameŋa kakwila antu akalakalaŋa mudimu watabanaka kudiilaku chinjila. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.10",
            "verseOrgIds": [
              "HEB.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa nyijimba yawanyamowu akweti mashi awu, atwalaŋawu mumalala kudi kapristu muneni nakulambula hansaŋu yanshidi, ayiidishili mumusumba hiyakuyishita. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.11",
            "verseOrgIds": [
              "HEB.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Yesu niyena wedi kili kuchisu hakumona yihuŋu, kulonda ajiliki antu namashi indi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.12",
            "verseOrgIds": [
              "HEB.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi ninetu tuyenu kudi yena wedika dehi mumusumba, tusendenu kusawuka kwindi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.13",
            "verseOrgIds": [
              "HEB.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa hanu hitukweti ŋanda yakushakama nyaka yejimaku, ilaŋa twatalilaŋa ŋanda yamba kamwekana. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.14",
            "verseOrgIds": [
              "HEB.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi tuhimulambu lenu Nzambi himulambu wakumuhameka mafuku ejima mudi Yesu, yowu nyikabu yakunyivumbu yakwiteja ijina dindi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.15",
            "verseOrgIds": [
              "HEB.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwinza kwila yuma yayiwahi nikudyaloŋana bayi muchivulamenaku; muloŋa Nzambi watiyaloŋa kuwaha nanyilambu yidi chochochu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.16",
            "verseOrgIds": [
              "HEB.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.16",
            "verseOrgIds": [
              "HEB.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ovwahilenu anlomboli jenu nakuyitiyilila, muloŋa ahembaŋa nyichima yenu, nawu twamba kashimunamu; kulonda eli mwenimu namuzaŋalu bayi nakuneŋaku, Muloŋa neyi akuneŋa hichikuyikwasha enuku.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.17",
            "verseOrgIds": [
              "HEB.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.17",
            "verseOrgIds": [
              "HEB.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tulombelenuku. Tuneluki chalala netu tukweti chinleji chamuchima chachiwahi, tunakeŋi kushakama chakashinshi muyuma yejima. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.18",
            "verseOrgIds": [
              "HEB.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nayilembeleli nami swejenu kulomba kulonda anyakali kunfuntisha kudenu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.19",
            "verseOrgIds": [
              "HEB.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.19",
            "verseOrgIds": [
              "HEB.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HEB 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi dinu, Nzambi wakuwunda, wasaŋwili kabiŋa kawanyikoku muneni mudi afu, yowu Mwanta wetu Yesu, namashi achitiyaŋenu chahaya nyaka, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.20",
            "verseOrgIds": [
              "HEB.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HEB 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ayiwahishi chikupu munyidimu yayiwahi yejima, mwili muchima windi, akalakali mudenu yuma yikumutiyisha kuwaha kuyimona, mudi Yesu Kristu. Kulema kwikali kudi yena haya nyaka nanyaka. Amena.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.21",
            "verseOrgIds": [
              "HEB.13.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HEB 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.21",
            "verseOrgIds": [
              "HEB.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HEB 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu ana kwetu, nayilembeleli nami ilukenu dakwiteja mazu awa akukonkomwena; nayisonekeli mukanda wamazu antesha hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.22",
            "verseOrgIds": [
              "HEB.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HEB 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nayileji nsaŋu yamana kwetu Timotewu, anamuumbuku dehi; neyi wukwinza swayi nakayimwena hamu nindi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.23",
            "verseOrgIds": [
              "HEB.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "HEB 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋimwishili anlomboli jenu ejima, niakwakujila ejima. Akwaltaliya anayimwishi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.24",
            "verseOrgIds": [
              "HEB.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "HEB 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luwi lwikali nanenu ejima. Amena.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.25",
            "verseOrgIds": [
              "HEB.13.25"
            ]
          }
        }
      ]
    }
  ],
