        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa yeniwu Melekizedeki, mwanta waSalema, kapristu kaNzambi Mukwakubadika, wakinkililili Abarahama hafuntiliyi kwayiliyi nakutapa anyanta, wamukiswilih nkisu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.1",
            "verseOrgIds": [
              "HEB.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarahama hakumwambwila yena iseka damwikumi dayuma yejima. Kulumbulula ijina daMelekizedeki, chakusambila nawu, Mwanta wakuloŋa; cheŋa nawu, Mwanta waSalema, diyi Mwanta wakuwunda; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.2",
            "verseOrgIds": [
              "HEB.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakadi tata yindi hela mama yindi hela muyachi; wakadi hatachikililiyi mafuku indi, hela hakumishilihyi kuhanda; ilaŋa amufwikŋili neyi Mwana kaNzambi, wekala kapristu haya nyaka.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.3",
            "verseOrgIds": [
              "HEB.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.3",
            "verseOrgIds": [
              "HEB.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toŋojokenu chatohehyi muntu iwu, enkeluwu kudi nkakulula Abarahama iseka damwikumi dayuma yabadika kuwaha yapupiliyi kunjita. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.4",
            "verseOrgIds": [
              "HEB.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chalala anyana kaLevi, atambulaŋa mudimu wawupristu, ayilejaŋa kulambwisha antu iseka damwikumi mwaya nshimbi; hiyakulambwisha ana kwawu, kutoŋa anayivwali kudi Abarahama. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.5",
            "verseOrgIds": [
              "HEB.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwila Melekizedeki, wabulili kufuma kumuchidi wawaLevi, watambwili kudi Abarahama iseka damwikumi, hakumukiswila nkisu yena wekala nayikaninu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.6",
            "verseOrgIds": [
              "HEB.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwosi wukutadika mwoku, wanyanya amukiswilaŋa nkisu kudi wamubadika. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.7",
            "verseOrgIds": [
              "HEB.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunu alambulaŋa antu afwaŋa iseka damwikumi, ilaŋa kwenoku alambulaŋa owu anashimunuwu nawu wahandaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.8",
            "verseOrgIds": [
              "HEB.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chaya mukwila nawu Levi, watambulaŋa yamwikumi, walambwili Melekizedeki yamwikumi mudi Abarahama, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.9",
            "verseOrgIds": [
              "HEB.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "hadiŋiyi Levi kanda amuvwali kudi tata yindi, hamukinkilililuwu kudi Melekizedeki.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.10",
            "verseOrgIds": [
              "HEB.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.10",
            "verseOrgIds": [
              "HEB.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi dinu, neyi kuwaha chikupu kwenjili nawupristu wawaLevi, muloŋa dimu mwatambwiluwu antu nshimbi, kwadi kumwekenadi kapristu mukwawu wafwana neyi Melekizedeki, bayi wakumuyachi waAronuku?",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.11",
            "verseOrgIds": [
              "HEB.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.14",
            "verseOrgIds": [
              "HEB.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinalumbuluki dehi nankashi ichi chikunamwekani dehi kapristu mukwawu wafwana neyi Melekizedeki, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.15",
            "verseOrgIds": [
              "HEB.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "anakunjikuwu kwikala kapristu wakuŊovu jawumi wakanoŋaŋa, bayi wakulushimbi lwakuleja kwawuntuku. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.16",
            "verseOrgIds": [
              "HEB.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋanamushimuni wunsahu nawu, Eyi wukapristu wahaya nyaka wafwana neyi Melekizedeki. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.17",
            "verseOrgIds": [
              "HEB.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afumishili kuleja kwakusambila muŋa kwazeyeli, kukwashana nehi; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.18",
            "verseOrgIds": [
              "HEB.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "muloŋa nshimbi hijawahishili chikupu chuma nichimuku; hiyakuletamu kuchiŋeja kwabadika kuwaha kutukukundama nachu kwakwihi naNzambi.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.19",
            "verseOrgIds": [
              "HEB.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.19",
            "verseOrgIds": [
              "HEB.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HEB 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hichadiŋi chakadi kusanyikaku; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.20",
            "verseOrgIds": [
              "HEB.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HEB 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "muloŋa wena ayikunjikili kwikala atupristu chakadi kusanyika, hakwila yena chiŋa nakusanyika kwanowu welili nindi, Yehova wasanyikili, hakabalumuka mwoku, nindi, Eyi wukapristu wahaya nyaka. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.21",
            "verseOrgIds": [
              "HEB.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HEB 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Yesu nekali dehi chikilu chachitiyaŋenu chabadika kuwaha.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.22",
            "verseOrgIds": [
              "HEB.7.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HEB 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.22",
            "verseOrgIds": [
              "HEB.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HEB 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chalala akunjikili antu amavulu kwikala atupristu, nanochu chakapenyuwu kushakama muwupristu hansaŋu yakufwa; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.23",
            "verseOrgIds": [
              "HEB.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "HEB 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakwila yena wukweti wupristu windi wakabalumukaŋa, nanochu chashakamayi haya nyaka. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.24",
            "verseOrgIds": [
              "HEB.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "HEB 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi yena natweshi kwamwina chikupu antu akundamaŋa kwakwihi naNzambi nayena, nanichi chahandayi yena haya nyaka nakuyilembelela.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.25",
            "verseOrgIds": [
              "HEB.7.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "HEB 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.25",
            "verseOrgIds": [
              "HEB.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "HEB 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa kapristu muneni wudi ochu watuteleleli, wajila, wakadi makasu, wakadi kujilola, waambuka kudi akwanshidi, anamubadishi dehi mawulu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.26",
            "verseOrgIds": [
              "HEB.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "HEB 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakweti mudimu wakulambula hefuku hefuku neyi awa atupristu amaneni acheŋuku; wena asambililaŋa kuketula yimuna yahanyiloŋa yawu awenawu, nkumininaku niyawantu amakwawu nawa; Yesu welili mwenimu kamu hohu hadiheniyi yomweni ekali himulambu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.27",
            "verseOrgIds": [
              "HEB.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "HEB 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa nshimbi jakunjikaŋa antu azeya kwikala atupristu amaneni, hakwila izu dakusanyika dalondeleli munshimbi, hidikukunjika Mwana wela dehi walala chikupu haya nyaka.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.28",
            "verseOrgIds": [
              "HEB.7.28"
            ]
          }
        }
      ]
    }
