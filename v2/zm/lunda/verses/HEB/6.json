    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi tulekenu kuhosha nsaŋu jaKristu jatachi, tukulenu tupami. Bayi twala cheŋi chikuku chakubalumuka mumuchima nakuleleanyidimu yafwa, nichakumwitiya Nzambi, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.1",
            "verseOrgIds": [
              "HEB.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nichakuleja nsaŋu jakuwelawela nŋakunaŋika makasa nŋakusaŋuka afu nŋakusompa kwahaya nyakaku. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.2",
            "verseOrgIds": [
              "HEB.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi Nzambi neteji tukwila mwenomu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.3",
            "verseOrgIds": [
              "HEB.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa wenawa amweni dehi chejeji, atompeli chamukunkulu chamwiwulu, atambwili yaSpiritu Wajila, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.4",
            "verseOrgIds": [
              "HEB.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "atompeli mazu aNzambi nawu amawahi, niŋovu janyaka yakenza, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.5",
            "verseOrgIds": [
              "HEB.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "neyi wena akulekamu, hiyakutwesha kuyovwahisha cheŋi abalumuki mumuchimaku, Muloŋadi nakupopela Mwana kaNzambi kukulusu munyichima yawu chachiliha, enda amusawula hatooka. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.6",
            "verseOrgIds": [
              "HEB.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa iseki dinanwi nvula yanokaŋa kakavulu, dikusoŋesha yisakola yatela kudya awa anadidimi, adikiswilaŋa kudi Nzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.7",
            "verseOrgIds": [
              "HEB.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa neyi dikusoŋesha nyiŋa nanzonzonzu akudisekesha, keŋa dishiŋewi; kukumisha kweseki odu hikusukuma.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.8",
            "verseOrgIds": [
              "HEB.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.8",
            "verseOrgIds": [
              "HEB.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwila enu akwetu twakeŋa a, hela tunahoshi mwenimu, tunayikuhweleli netu mukweti yuma yabadika iyi kuwaha, yuma yenzaŋa nawamwinu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.9",
            "verseOrgIds": [
              "HEB.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa Nzambi waloŋa, hakavulamena mudimu wenu hela kukeŋa kumwakeŋa eli ijina dinduku, nanochu chimwakalakeleli akwakujila, nihanu muchidi kuyi kalakela. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.10",
            "verseOrgIds": [
              "HEB.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tunakeŋi netu wejima wenu hamuntu hamuntu mudikwatishi chalala chochimu, kulonda musweji kuchiŋeja, ndo nikunsa. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.11",
            "verseOrgIds": [
              "HEB.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubuli kushimpokela, chiŋa mwimbujoli wenawa akuswana yikaninu nakukuhwelela nakudiwunjika.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.12",
            "verseOrgIds": [
              "HEB.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.12",
            "verseOrgIds": [
              "HEB.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chamukaninuwu Abarahama kudi Nzambi, chabuliliyi mukwawu wamubadika, hakudisanyika yomweni, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.13",
            "verseOrgIds": [
              "HEB.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Chalala kukisula nakakukiswila, kuvuhsha nakakuvulishila anyaneyi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.14",
            "verseOrgIds": [
              "HEB.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chadiwunjikihyi nakutatakena, hakutambula chikaninu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.15",
            "verseOrgIds": [
              "HEB.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu asanyikaŋa kwawu ayibadika; ntadi jawu jejima ajiketulaŋa nakusanyika, kulonda kukoleshamu chikupu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.16",
            "verseOrgIds": [
              "HEB.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chochimu niNzambi, chakeŋeliyi kuleja chachiwahi answana jachikaninu chimwabulaŋa kubalumuka mwatoŋweliyi, hakushaku kusanyika; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.17",
            "verseOrgIds": [
              "HEB.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulonda nayuma yiyedi yakabalumukaŋa, yabulaŋa kutweshayi Nzambi kutwamba, tumwenuku kukundeja kukweti Ŋovu, etu tunatemukili kwakupulukila, tukwati kukuchiŋeja kwanatushiluwu kumbidi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.18",
            "verseOrgIds": [
              "HEB.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchiŋejoku kwemikishaŋa wumi wetu, neyi chikuŋu chakwimikisha nachu watu; kwalala, kwakola, kweŋila mwamweni mwajila mwakujika nehina; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.19",
            "verseOrgIds": [
              "HEB.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HEB 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwenomu mweŋilayi Yesu, mukwakuyaloŋahu dehi kumbidi hansaŋu yetu, anamukunjiki dehi kwikala kapristu muneni wahaya nyaka wafwana neyi Melekizedeki.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.20",
            "verseOrgIds": [
              "HEB.6.20"
            ]
          }
        }
      ]
    }
  ],
