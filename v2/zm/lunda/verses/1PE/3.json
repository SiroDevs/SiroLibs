  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "1PE 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1PE 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwomumu ninenu ambanda, shakamenu nakwovwahila anfumu jenwenu aweni; kulonda, hela amu anabuli kwovwahila mazu, akayikoki chakadi mazu, nanochu chakushakamawu aŋodi jawu; ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.1",
            "verseOrgIds": [
              "1PE.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1PE 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "chaku monawu chimukushakama nawoma, chakubula kubajama. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.2",
            "verseOrgIds": [
              "1PE.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1PE 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi mudi wahisha chakumujimba nakuyindayinda nsuki, hela nakudikudeka yingelingeli yawuru, hela nakuvwalavwala mahinaku. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.3",
            "verseOrgIds": [
              "1PE.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1PE 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiŋa mudiwahishi mumuchima wamuntu wamukachi, naspiritu yayovu yawunda yabulaŋa kutoka, dichi chalema nankashi kumesu aNzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.4",
            "verseOrgIds": [
              "1PE.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1PE 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dimu mwadiwahishililuwu nawa ambanda ajila ahamwaka, amukuhweleleli Nzambi, ovwahilili anfumu jawu aweni; ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.5",
            "verseOrgIds": [
              "1PE.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1PE 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "neyi chovwahililiyi Sara Abarahama, hakumutena nindi mwanta. Enu muneli anyanindi, neyi mukwila chachiwahi nákubula kutiya woma hela kufwa mutentu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.6",
            "verseOrgIds": [
              "1PE.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1PE 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.6",
            "verseOrgIds": [
              "1PE.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1PE 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwomumu ninenu amayala, shakamenu nawaŋodi jenu mwaya maana, nakulemesha mumbanda nenu diyi wakuminamu Ŋovu, nanochu chimunekali akwakuswanina luwi lwawumi hamu; kulonda mubuli kukaŋesha kulomba kwenu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.7",
            "verseOrgIds": [
              "1PE.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1PE 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.7",
            "verseOrgIds": [
              "1PE.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1PE 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkumininaku, toŋojokenu wejima wenu mwomumu, nakutiyila akwenu wushona, nakukeŋaŋana neyi chamwivumu denu, nakwikala nanyichima yaluwi, nayitoŋojoka yakudizoza. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.8",
            "verseOrgIds": [
              "1PE.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1PE 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi mutamisha mukwenu nanochu chanakutamishiyuku, hela kunamutuka nanochu chanakutukiyuku. Chinjila kwila mwenomu, chiŋa kukiswila nkisu; muloŋa anayitambikili kuswana nkisu. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.9",
            "verseOrgIds": [
              "1PE.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1PE 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa nasoneki nawu, Muntu wukukeŋa wumi nakumona mafuku amawahi, ahembi idimi dindi dibuli kuhosha yatama, ninyivumbu yindi yibuli kuhosha yamakasu; ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.10",
            "verseOrgIds": [
              "1PE.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1PE 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "aambuki kuyuma yatama, eli mwamuwahi; akeŋakeŋi kuwunda akuhaŋi chakuhaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.11",
            "verseOrgIds": [
              "1PE.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa mesu aYehova atalaŋa antu aloŋa, nimatu indi atiyililaŋa chakulembelelawu; ilaŋa mesu aYehova adikaŋaŋa nawantu elaŋa chatama.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.12",
            "verseOrgIds": [
              "1PE.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.12",
            "verseOrgIds": [
              "1PE.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1PE 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi mukukabila kwila mwamuwahi, ochu wukuyila chatama hinyi? ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.13",
            "verseOrgIds": [
              "1PE.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1PE 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwila neyi mukumona yihuŋu hansaŋu yakuloŋa, munakooleki; bayi musha muchima hawoma wayitiyishaŋawuku, hela kuyakama; ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.14",
            "verseOrgIds": [
              "1PE.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1PE 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "chiŋa mujiliki Kristu munyichima yenu nenu diyi Mwanta, mutweshi kwakula mafuku ejima antu ejima akuyihula nsaŋu yakuchiŋeja kumwachiŋejaŋa; nakudizoza nawoma. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.15",
            "verseOrgIds": [
              "1PE.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1PE 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikalenu nachinleji chamuchima chachiwahi; kulonda, chakuyituŋulawu nakutena chatama kushakama kwenu kwakuwahi kwamudi Kristu, atiyi nsonyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.16",
            "verseOrgIds": [
              "1PE.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1PE 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa neyi muchima waNzambi wuneteji nindi mumoni yihuŋu nanochu chimwelaŋa chachiwahi, dichi chinabadiki kuwaha; bayi nanochu chimwelaŋa chatamaku. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.17",
            "verseOrgIds": [
              "1PE.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1PE 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa Kristu nawa wamweni ihuŋu hansaŋu yanyiloŋa, kamu hohu, waloŋa kukoola áheŋa, kulonda atushikiji kudi Nzambi. Amujahili mumujimba ilaŋa amuhandishili muspiritu, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.18",
            "verseOrgIds": [
              "1PE.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1PE 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwayililiyi nakushimuna kudi aspiritu amukaleya; ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.19",
            "verseOrgIds": [
              "1PE.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1PE 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "wenawa wowu ajikwili hamwaka, hadiwunjikiliyi Nzambi nakuchiŋilila mafuku aloŋeshelaŋayi Nowa watu, mwahandilili antu antesha, wowu atanu nasatu, kumeji. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.20",
            "verseOrgIds": [
              "1PE.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1PE 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wena meji owu hichifwikija chachipapatishu chayihandishaŋa; hichakufumisha nachu majilu amujimbaku, ilaŋa chakumwekesha nachu kudi Nzambi chinleji chamuchima chachiwahi, nakusanuka kwaYesu Kristu mudi afu. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.21",
            "verseOrgIds": [
              "1PE.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1PE 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena waya dehi mwiwulu, wekala kuchikasa chaNzambi chachidiilu; aŋelu niakwawanta niakwaŋovu anamwovwahishiluwu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.22",
            "verseOrgIds": [
              "1PE.3.22"
            ]
          }
        }
      ]
    }
  ],
