{
  "id": "JHN.9",
  "number": "9",
  "bookId": "JHN",
  "reference": "Joani 9",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "JHN 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chadiŋi nakuhitayi, hakumona iyala wadiŋi mputamesu kufumisha havwalikiliyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.1",
            "verseOrgIds": [
              "JHN.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atumbanji twindi hiyakumwihula nawu, Eyi Rabi, wavulumwini hinyi, iwu iyala, tahindi anvwali jindi, mwaka avwaliki mputamesu? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.2",
            "verseOrgIds": [
              "JHN.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakwakula nindi, Hela iyala iwu hela anvwali jindi hiyavulumwinuku; Nzambi walondeli nyidimu yindi yakamwekeni mudi yena. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.3",
            "verseOrgIds": [
              "JHN.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiŋa tukalakalenu nyidimu yayena wantemesheli hikuchidi mwaana; wufuku keŋa winzi mwabulaŋa kukalakalawu nyidimu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.4",
            "verseOrgIds": [
              "JHN.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hohanu hinichidi mumpata yamunu mwishina, nichejeji champata yamunu mwishina. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.5",
            "verseOrgIds": [
              "JHN.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanahoshiyi ochu, hakufwija mazeŋi hamaseki, hakuputa maseki namazeŋi, hakumulambawu hamesu indi, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.6",
            "verseOrgIds": [
              "JHN.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakumwila nindi, Yaku wuweli mwijiya daSilowami; chaya mukwila nawu, Atemesheli. Dichi hakuya, hakuwela, hakufunta namoni dehi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.7",
            "verseOrgIds": [
              "JHN.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi akwawu atuŋayi nindi kwakwihi ni akwawu amumweni hakusambila hadiŋiyi mukwakulomba, hiyakwila nawu, Hidiyi washakaminaŋa nakulombaku? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.8",
            "verseOrgIds": [
              "JHN.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakwawu nawu, Diyi. Amakwawu nawu, Nehi, wamufwana tuhu. Yena nindi, Yami. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.9",
            "verseOrgIds": [
              "JHN.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi wena hiyakumwihula nawu, Indi mesu eyi anayitoneshi pahi? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.10",
            "verseOrgIds": [
              "JHN.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwakula nindi, iyala ijina dindi Yesu, waputa maseki, hakulamba hamesu ami, hakunila nindi, Yaku kuSilowami wuweli. Hinukuya, chinaweli hinukumona. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.11",
            "verseOrgIds": [
              "JHN.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakumwihula nawu, Wudi kudihi? Nindi, Kwiji.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.12",
            "verseOrgIds": [
              "JHN.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.12",
            "verseOrgIds": [
              "JHN.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakutwala muntu owu wadiŋi mputamesu kudi aFwarisi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.13",
            "verseOrgIds": [
              "JHN.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Denodu ifuku daputiliyi Yesu maseki, damutonesheliyi muntu mesu, dadiŋi dasabata. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.14",
            "verseOrgIds": [
              "JHN.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi aFwarisi niwena hiyakumwihula cheŋi nawu, Watona ŋahi? Yena hakuyila nindi, Washa maseki akuputa hamesu ami, chinaweli hinukumona. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.15",
            "verseOrgIds": [
              "JHN.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi aFwarisi amakwawu hiyakwila nawu, Iwu muntu hafuma kudi Nzambuku, Muloŋa hajilikaŋa sabataku. Ilaŋa makwawu nawu, Mukwanshidi wukutwesha ŋahi kwila yinjikijilu yidi neyi iyi? Henohu adambula nikudambula. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.16",
            "verseOrgIds": [
              "JHN.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi hiyakumwihula cheŋi owu mputamesu, nawu, Atuleji, ichi chanakutoneshiyi mesu, wunatoŋojoki ŋahi? Wukumutena neyinyi? Yena nindi, Hikaprofwetu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.17",
            "verseOrgIds": [
              "JHN.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.17",
            "verseOrgIds": [
              "JHN.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi aYudeya kwitiya nawu diyi mputamesu anatoneshuwu nehi, chiŋa anatambiki anvwali jamuntu anatoneshuwu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.18",
            "verseOrgIds": [
              "JHN.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakuyihula nawu, Yeniwu diyi mwanenu, mwelaŋa nenu wavwalikili mputamesu, tahindi? Ichi dinu namoni pahi? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.19",
            "verseOrgIds": [
              "JHN.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anvwali jindi hiyakwakula nawu, Tuneluki netu diyi mwanetu, wavwalikili mputamesu; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.20",
            "verseOrgIds": [
              "JHN.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ilaŋa ichi chanamoniyi hitunachilukuku; hela wamutonesha mesu indi hitunelukuku. Mwihulenu yomweni, wakula dehi, yomweni wukushimuna kwindi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.21",
            "verseOrgIds": [
              "JHN.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anvwali jindi ahosheli ochu nawoma watiyiluwu aYudeya, muloŋa aYudeya atiyaloŋana dehi nawu, neyi muntu wukwiteja nindi yeniwu diyi Kristu, akamuhaŋa mushikola yawu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.22",
            "verseOrgIds": [
              "JHN.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dihu hafumini anvwali jindi kuhosha nawu, Wakula dehi, mwihulenu yomweni.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.23",
            "verseOrgIds": [
              "JHN.9.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.23",
            "verseOrgIds": [
              "JHN.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi hiyakutambika owu iyala wadiŋi mputamesu kamuchiyedi, hiyakumwila nawu, Mulemeshi Nzambi, etu tuneluki netu iwu iyala himukwanshidi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.24",
            "verseOrgIds": [
              "JHN.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyakulanindi, Neyi himukwanshidi ami kwiluka nehi; neluki chuma chimu hohu nami, ami nadiŋi mputamesu, katataka namoni dehi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.25",
            "verseOrgIds": [
              "JHN.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi hiyakumwihula cheŋi nawu, Wakwila ŋahi? Mesu eyi wayitonesha ŋahi? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.26",
            "verseOrgIds": [
              "JHN.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyakula nindi, Ami nayileji katataka, enu kutiya nehi. Munakeŋi mutiyumu cheŋi, tahindi? Enu aweni munakeŋi mubalumuki kwikala atumbanji twindi nawa, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.27",
            "verseOrgIds": [
              "JHN.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakunamutuka nawu, Eyi yeyi kambanji kindi, etu kwetu tuyatumbanji twaMosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.28",
            "verseOrgIds": [
              "JHN.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuneluki netu Nzambi wahosheli naMosi, hakwinza iwu iyala hituneluki kwafumayuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.29",
            "verseOrgIds": [
              "JHN.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owu iyala hakuyakula nindi, Aka! Munanhayamishi chimunabuli kwiluka kwafumayi, kutoŋa diyi natoneshi dehi mesu ami. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.30",
            "verseOrgIds": [
              "JHN.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etu tuneluki netu Nzambi hatiyililaŋa akwanshiduku; ilaŋa neyi kudi muntu mukwakulemesha Nzambi, welaŋa nimuchima windi, Nzambi wukumutiyilila. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.31",
            "verseOrgIds": [
              "JHN.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kufumisha kushankulu kanda achitiyaloŋahu dehi nawu, kudi muntu watoneshahu dehi mesu amukwawu wavwalikili mputamesu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.32",
            "verseOrgIds": [
              "JHN.9.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.34",
            "verseOrgIds": [
              "JHN.9.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakutiya nawu anamuhaŋi dehi mukachi kawu. Chanamuwaniyi, hakumwihula nindi, Eyi wunamwitiyi Mwana kaNzambi, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.35",
            "verseOrgIds": [
              "JHN.9.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 9:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena hakwakula nindi, Hinyi Mwanta, kulonda nimwitiyi? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.36",
            "verseOrgIds": [
              "JHN.9.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 9:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakumwila nindi, Wunamumoni dehi, diyi iwu wudi nakuhosha naneyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.37",
            "verseOrgIds": [
              "JHN.9.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 9:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena hakwila nindi, Mwantanetiyi. Hakudifukula kudi yena. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.38",
            "verseOrgIds": [
              "JHN.9.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 9:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakwila nindi, Chinenjili mumpata yamunu mwishina nalondeli kusompesha, kulonda abulaŋa kumona amoni, niamonaŋa abalumuki amputamesu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.39",
            "verseOrgIds": [
              "JHN.9.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 9:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "AFwarisi amakwawu adiŋiyi nawu chanatiyuwu mazu owu, hiyakumwila nawu, Ninetu nawa tuyamputamesu, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.40",
            "verseOrgIds": [
              "JHN.9.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 9:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakuyila nindi, Neyi mwadiŋi amputamesu, himwadi kwikala nanshiduku; ichi dinu chimudi nakwila nenu, Twamonaŋa; komana nshidi yenu yayiwenyi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.41",
            "verseOrgIds": [
              "JHN.9.41"
            ]
          }
        }
      ]
    }
