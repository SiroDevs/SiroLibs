          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nindi, Eyi Isarela neyi wukufunta cheŋa, funtaku kudami. Neyi wukufumisha yishimashima yeyi kumesu ami, hiwakatu ntakaku;",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.1",
            "verseOrgIds": [
              "JER.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.2",
            "verseOrgIds": [
              "JER.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa Yehova hakuyila akwaYuda nawa kwaYerusalema, nindi, Chipenu mwiha denu, bayi mukuwaŋa mbutu jenu munyiŋa aku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.3",
            "verseOrgIds": [
              "JER.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enua kwaYuda, ninenu akwakushakama muYerusalema, dadikenu mwikali aYehova, fumishenu nyivumbu yawudima wakunyichima yenu; kuchina kuzuwa kwami kuyilendumukila neyi kesi, kwakocha, chakukaŋanya kujima kudi muntu, nanoyu yatama yimwe laŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.4",
            "verseOrgIds": [
              "JER.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimunenu muYuda, tiyakeshenu muYerusalema, ilenu nenu, Imbenu mpùŋa mwituŋala, bidikenu nenu, Pompenu, twiŋilenu munyikala yayipaka. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.5",
            "verseOrgIds": [
              "JER.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imikenu mpandelu yitali kuZiyona, temukenu muhandi, bayi mwimaja laku; muloŋa nakayi letela yatama yakafuma kukabeta kakuchimunswa, nikujilumuka kwakweni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.6",
            "verseOrgIds": [
              "JER.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.6",
            "verseOrgIds": [
              "JER.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutuŋa nanyamuki dehi hakabolototu kindi, mukwa kujilu muna nyuzanaholokeli dehi munjila yindi; nafumi dehi kwindi kwekalayi, kulonda akakisaŋani ituŋa deyi, akabalumuni nyikala yeyi yiikali yihembi yakadi antu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.7",
            "verseOrgIds": [
              "JER.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vwalenu yike leyi hansaŋu iyi, mudili makumbu, mukaloki nyite ti; muŋa kuzuwa kwaYehova kwasweja saŋa kwa yila, kutufuma nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.8",
            "verseOrgIds": [
              "JER.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nindi, Denodu ifuku muchima wamwanta wakanoŋa mwivumu, ninyichima yawatulamba hamu, atupristu akahayama, niatuprofwetu nawa akahayama.",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.9",
            "verseOrgIds": [
              "JER.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.9",
            "verseOrgIds": [
              "JER.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinu kwila nami, Ala Mwanta Yehova; chalala imu muwuna yiliawa antu niakwaYerusalema, neyi, Mwakamona kumwena; wunayidimbi chikupu, komana mpoku yakabali iyi yikuhanuka zwa-a nikumu chima iyi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.10",
            "verseOrgIds": [
              "JER.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.10",
            "verseOrgIds": [
              "JER.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu akayila awa antu niakwaYerusalema nawu, Mpepela yasweja iyena yakafuma kuyinaŋanaŋa yankumbu yidi mwisaŋa dawuma, yakatalishahadi mwana kamumbanda wawantu ami, hiyakekala yakupepa hela yakutookeshaku.",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.11",
            "verseOrgIds": [
              "JER.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.11",
            "verseOrgIds": [
              "JER.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpepelaya Ŋovu yakafuma kuyu moyu yakenjila nsaŋuyamami. Ichi ninami nawa nukushimuna jakuyisompesha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.12",
            "verseOrgIds": [
              "JER.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.12",
            "verseOrgIds": [
              "JER.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyenu, wakakanduka neyi mavu, makálu indi akekala neyi chinjimbi, tuwalu twinditwa kabadika mbu ulu lufuchi. Yayo etu akwawu! Atu pupa dehi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.13",
            "verseOrgIds": [
              "JER.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi Yerusalema, kosaku mumuchima weyi mufumi kutama kulonda wakamwinewi. Nyaka yipahi yikushakama yitoŋojoka yeyi yatama mudeyi? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.14",
            "verseOrgIds": [
              "JER.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa izu dakufuma kuDani didi nakushimuna, didi nakufuma kumpidŋa kuEfweremi, didi nakutiyakesha yatama. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.15",
            "verseOrgIds": [
              "JER.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tenenu nyuza. Tiyenu, tiyakeshenu nsaŋu yakubayisha Yerusalema, nenu, Kudi nakwinza akwakutalatala, adi nakufuma kwituŋa dakwakulehi, adi nakutiyakesha izu dawudakubayisha nyikala yaYuda. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.16",
            "verseOrgIds": [
              "JER.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anamu ku chiki dehi kwi-ndo, neyi akwakuhemba iha, muloŋa yena nadikaŋi nanami. Dimu mwanahoshiyi Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.17",
            "verseOrgIds": [
              "JER.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.17",
            "verseOrgIds": [
              "JER.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njila yeyi yiwendapa niyuma yeyi yiwe lapadiyi yinakumweshi yumiyi, diku kutama kweyi; muloŋa kwalula, kunakulemeki zwa-a nikumuchima. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.18",
            "verseOrgIds": [
              "JER.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "O kumu chimo! O kumu chimo! Kukata kunashiki nikumuchima wami chikupu. Muchima wami wudi nakululuta mwivumu. Hinatweshikumwenaku, muloŋa eyi muchima wami wuna tiyi dehi kuvuma kwampùŋa, nikabobobu kanjita. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.19",
            "verseOrgIds": [
              "JER.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adi nakubidikisha kujilumuna kwakulunjika hakujilumuna; ituŋa dejima apupa dehi. Matenti ami anapupi chakunkasu mwisha hohu, nimahinami nakudekaku chochu, mumpinji yimu hohu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.20",
            "verseOrgIds": [
              "JER.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.22",
            "verseOrgIds": [
              "JER.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namweni maseki komana hiyakweti nimu ya yawuku, amukunkulu; nimawulu nawa, hikwadipi kuchaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.23",
            "verseOrgIds": [
              "JER.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namweni mpidi jamaneni komanajidi nakukanka, nimpidi janyanya jejima jidi nakwenda niniku niniku.",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.24",
            "verseOrgIds": [
              "JER.4.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.26",
            "verseOrgIds": [
              "JER.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa Yehova nahoshi nindi, Ituŋa dejima dakabalumuka yihembihohu, hela chochu, hina kamani shamu to-o chikupuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.27",
            "verseOrgIds": [
              "JER.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hachumi chidihu hakadi shonena iseti, dihu hakeyilila mawulubwi; muŋa ami nachiho shi dehi, nachifu ukuli dehi, hinabalumuki kwamuku, hela kufunta muhinu kufunta mwokuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.28",
            "verseOrgIds": [
              "JER.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
