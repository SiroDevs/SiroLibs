    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izu denjili kudi Yeremiya dakufuma kudi Yehova, helili mwanta Zedekiya namutemesheli dehi mwana kaMalikiya Pashuri, nimwana kakapristu Mayaseya Zefwaniya, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.1",
            "verseOrgIds": [
              "JER.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "hiyakumwila nawu, Twihwili mwani, kudi Yehova, muloŋa mwanta wakuBabiloni Nebukaneza hakulwa netu, wamba kela Yehova wakatwi! mwaya nyidimu yindi yakuhayama yejima, kulonda Nebukaneza atufumi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.2",
            "verseOrgIds": [
              "JER.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeremiya hakuyila nindi, Tiyenu chimwakamwila Zedekiya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.3",
            "verseOrgIds": [
              "JER.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwakamwila nenu, Yehova Nzambi yaIsarela nahoshi nindi, Tiyenu, yuma yakwasa nachu njita yidi mumakasenu, vimudi nakulwa nachu namwanta wakuBabiloni, nawaKaladeya anayikuchiki kunzi yampwembu, nakayibalumuna yakatala hanyima, niwenawa antu nakayipompesha mukachi kamukala wunu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.4",
            "verseOrgIds": [
              "JER.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninami aweni Yehova nakalwa nenu nachikasa chakwolola, nachikasa chaŋovu, chakuzuwa hohu nikulendumuka, nindombu yasweja. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.5",
            "verseOrgIds": [
              "JER.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashakama mumukala iwu nakayeta niantu nianyama; akafwa nachipupu cheneni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.6",
            "verseOrgIds": [
              "JER.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nindi, kulondela henaha mwanta wawaYuda Zedekiya, niambuŋindi, niantu akashala mumukala akabula kufwa nachipupu, nampoku yakabali, ninzala, nakayihana kudi mwanta wakuBabiloni Nebukaneza, nikudi ayilumbu jawu, nikudi akukeŋa kuyijaha. Wakayitapa nawumwemu wampoku yakabali. Hakayanakenaku, hakatiya luwi, hela wushonaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.7",
            "verseOrgIds": [
              "JER.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi wakayila antu awa neyi, Yehova nahoshi nindi, Tiyenu, hinukuyishila kumesu enu ninjila yawumi ninjila yakufwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.8",
            "verseOrgIds": [
              "JER.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakashakama mumukala wunu wakafwa nampoku yakabali, nanzala, nichipupu; ilaŋa wakafumamu, wakaya nakudimbukila kudi aKaladeya adi nakuyikuchika, wakahanda, niwumi windi wakekala neyi chuma chakupupa kunjita. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.9",
            "verseOrgIds": [
              "JER.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa mukala iwu nawiti mesu akuwukoŋa chatama, bayi akuwukoŋa chachiwahuku. Dimu mwanahoshiyi Yehova. Nindi, Akawuhana kudi mwanta wakuBabiloni, wakawocha nakesi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.10",
            "verseOrgIds": [
              "JER.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.10",
            "verseOrgIds": [
              "JER.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyenu izu daYehova dakutena mutaŋa wamwanta wawaYuda. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.11",
            "verseOrgIds": [
              "JER.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nahoshi nindi, Enu akwamutaŋa waDavidi, ilenu mwawuŋaji habudidi, mwakapulwishaŋa nabuwuwu kudi akwakuyikabisha, mukunkulwayi nukuyilendumukila neyi kesi kakwochaŋa chakukaŋanya kukajima, nakutama kumwelaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.12",
            "verseOrgIds": [
              "JER.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nindi, Eyi washakama muchinekineki, washakama kwilola damuchana, ami nidi nenu nandombu, enu mwelaŋa nenu, Wakakunkumuka nakulwa nanetu hinyi? Hela nenu, Hinyi wakeŋa ila mutwashakama etu? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.13",
            "verseOrgIds": [
              "JER.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nindi, Ami nakayibabesha mwaya nyikabu yayuma yimwelaŋa; nakabutula kesi mwisaŋa dindi kakalasha yuma yanyeŋumukaku yejima.",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.14",
            "verseOrgIds": [
              "JER.21.14"
            ]
          }
        }
      ]
    }
  ],
