            "number": "29",
            "style": "v",
            "sid": "JER 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nindi, Nile kikwinza nakuyihempula nayumiyi, tahindi? Muchima wami wuleki kuditenda hamuza wudi chochichi, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.29",
            "verseOrgIds": [
              "JER.5.29"
            ]
          }
        },
