            "number": "28",
            "style": "v",
            "sid": "JER 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anuna dehi, hiyakukejima; eŋa, hiyakusweja nikwila yuma yatama; hiyahakulaŋa muloŋa wanshona, kulonda ayiŋuku; muteji kuyiŋila kazweŋa hiya sompeshaŋa amwokuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.28",
            "verseOrgIds": [
              "JER.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
