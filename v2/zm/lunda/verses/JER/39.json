          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izu daYehova denjili kudi Yeremiya hadiŋiyi achidi amwenzela muchipaŋu chaawatulama, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.15",
            "verseOrgIds": [
              "JER.39.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 39:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Yaku wakahoshi nakaEtiyopiya Ebedi Meleki, neyi, Yehova wamazaza, Nzambi yaIsarela, nahoshi nindi, Tiya, nakashikija mazu ami hamukaliwu kulonda henzi yatama, bayi yayiwahuku; akayikoŋela kumesu eyi ifuku odu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.16",
            "verseOrgIds": [
              "JER.39.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 39:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nindi, Hakwila eyi nakakupulwishahefuku odu. Hiyakakuhana kudi antu iwunatiyi womaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.17",
            "verseOrgIds": [
              "JER.39.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 39:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa ami chalala nakakwamwina, hiwakadimbukila kumpoku yakabaluku; wumi weyi wakekala neyi chuma chakupupa kunjita, nanochu chiwunankuhweleli. Dimu mwanahoshiyi Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.18",
            "verseOrgIds": [
              "JER.39.18"
            ]
          }
        }
