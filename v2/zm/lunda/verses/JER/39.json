              "type": "text"
            }
          ]
        },
        {
          "text": "Chelili anatambuli dehi Yerusalema, mumwaka wamuchitanunachiwana wamwanta wawaYuda Zedekiya, mukakweji kekumi, mwanta wakuBabiloni Nebukaneza ninjita yindi yejima enjili nakulwa naYerusalema, awukuchikili. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.1",
            "verseOrgIds": [
              "JER.39.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 39:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwaka waZedekiya wekumi nawumu, mukakweji kamuchiwana, mwifuku dakakweji damu chitanu nachiwana, alokweli mpwembu yamukala.",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.2",
            "verseOrgIds": [
              "JER.39.2"
            ]
          }
        }
      ]
    },
