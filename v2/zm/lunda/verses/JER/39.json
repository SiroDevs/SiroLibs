          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atulamba twamwanta wakuBabiloni ejima enjili, hiyakushakama muchisu champwembu chahakachi, iwu Nerigali Sharezeri, iwu Samigari Nebo, iwu Saresekimi, iwu Rabi Sarisi, iwu Nerigali Sharezeri, iwu Rabi Maŋi, hamu nawatulamba twamwanta wakuBabiloni anashaluku ejima.",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.3",
            "verseOrgIds": [
              "JER.39.3"
            ]
          }
        }
      ]
    },
