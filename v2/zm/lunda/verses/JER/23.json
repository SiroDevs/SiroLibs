  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "JER 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nindi, Yayo, o yihuŋu yikukeŋa kumonawu atubiŋa ajilumunaŋa, apalageshaŋa nyikoku yahawudiilu wanyikoku yami! ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.1",
            "verseOrgIds": [
              "JER.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Yehova, Nzambi yaIsarela, nateni atubiŋa adiishaŋa ntu ami nindi, Munaŋalaŋeshi mukanka wami wanyikoku, munayihaŋi, himunayi nakuyitalaku. Yehova nindi, Tiyenu, nakayishikŋila kutama kwyuma yimwelaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.2",
            "verseOrgIds": [
              "JER.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahamukanka wami wanyikoku anashalashali, nakayikuŋula mumatuŋa ejima munayitemwini, nakayileta cheŋi kumayindawu; akasemununa, akavula. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.3",
            "verseOrgIds": [
              "JER.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakayishila atubiŋa akayidiishaŋa. Hiyakatiya cheŋi woma hela kwakamaku. Hikwakabula wumuku. Dimu mwanahoshiyi Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.4",
            "verseOrgIds": [
              "JER.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.4",
            "verseOrgIds": [
              "JER.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nindi, Tiyenu, kwakenza mafuku inakamusaŋu mwina Davidi Mutayi waloŋa, wakekala Mwanta, wakela mwamaana, wakela yawuŋaji niyacluyulu mwituŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.5",
            "verseOrgIds": [
              "JER.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumafuku indi dimu mwakaamwinewa aYuda, niaIsarela akashakama chakadi kwakama. Tiyenu ijina dindi dakamutenawu, akamutena nawu, Yehova diyi kuloŋa kwetu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.6",
            "verseOrgIds": [
              "JER.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Yehova nindi, Tiyenu, kwakenza mafuku akabula kuhoshawu cheŋi nawu, Chahandayi Yehova kwaamu, Yehova wakandwishili anyana kaIsarela mwituŋa daEjipitu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.7",
            "verseOrgIds": [
              "JER.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa akela nawu, Chahandayi Yehova kwaamu, Yehova wakandwishili akwamutaŋa waIsarela, wayilombweli chakuyifumisha mwituŋa dakukabeta kakuchimunswa, nimumatuŋa ejima munayitemwinini; akashakama mwituŋa dawu awenawu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.8",
            "verseOrgIds": [
              "JER.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.8",
            "verseOrgIds": [
              "JER.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsaŋu yawatuprofwetu. Muchima wami wunabaluki mwivumu, mafwahami ejima adi nakunyinkesha. Nidi neyi muntu nasheti, neyi muntu wafwomoka dehi navinyu, nansaŋu yaYehova, nansaŋu yamazu indi ajila.",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.9",
            "verseOrgIds": [
              "JER.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.9",
            "verseOrgIds": [
              "JER.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nindi, Muloŋa ituŋa denzala dehi yivumbi, ituŋa didi nakudishona nsaŋu yakushiŋana. Madiilu amwisaŋa anomi. Mwatwalaŋaawu mwatama Ŋovu jawu hŋaloŋaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.10",
            "verseOrgIds": [
              "JER.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa niatuprofwetu, niatupristu, ajilola dehi. Eŋa, mwitala dami nawani kutama kwawu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.11",
            "verseOrgIds": [
              "JER.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nindi, Dichi munjila yawu akayimona neyi mwasenena senena mumwidima; akayitemuna, ayaloŋa ho-o, akadimbukilamu. Muloŋa ami nakayiletela katama, katamoku wowu mwaka wakuyihempula.",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.12",
            "verseOrgIds": [
              "JER.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.12",
            "verseOrgIds": [
              "JER.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mudi atuprofwetu akuSamariya namonumu wusupi. Ayiprofwetesheli kudi Bayali, hiyakuluwaŋesha antu ami aIsarela. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.13",
            "verseOrgIds": [
              "JER.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mudi atuprofwetu amuYerusalema nawa namonumu chuma chamajilu. Hiyakukoŋa wuvumbi, hiyakwenda mwakutwambatwamba, hiyakukolesha makasa awantu akoŋaŋa chatama, chakubula nimuntu wumu wukufuntamu aleka kutama kwindi. Wejima wawu nayimoni anekali dehi neyi Sodoma, ashakamaku anekali dehi neyi Gomora.",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.14",
            "verseOrgIds": [
              "JER.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.14",
            "verseOrgIds": [
              "JER.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Yehova wamazaza nateni atuprofwetu, nindi, Tiyenu, nakayidiisha mutondu walula, nakayinwisha meji awulembi. Muloŋa kujilola kunafumi kudi atuprofwetu akuYerusalema kuneŋili dehi mwituŋa dejima.",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.15",
            "verseOrgIds": [
              "JER.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.22",
            "verseOrgIds": [
              "JER.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nindi, Ami niNzambi wakwakwihi, hiniNzambi wakwakulehuku, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.23",
            "verseOrgIds": [
              "JER.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nindi, Muntu atweshi kubatama kumbeŋu nakumbeŋu kwakubula kumumona kudami, tahindi? Yehova nindi, Hiyami inenzali nimwiwulu nihesekuku? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.24",
            "verseOrgIds": [
              "JER.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami natiyi mwanahoshuwu atuprofwetu aprofwetaŋa yakutwamba mwijina dami, nawu, Ami naloti, naloti. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.25",
            "verseOrgIds": [
              "JER.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chumichi chikushakama nyaka yiŋahi munyichima yawatuprofwetu aprofwetaŋa yakutwamba, aprofwetaŋa kudimbana kwamunyichima yawu? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.26",
            "verseOrgIds": [
              "JER.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atogojokaŋa jakuvulamesha antu ijina dami nayilota yawu yadilejaleja ŋawu nawakwawu, neyi chavulamenuwu ankakulula jawu ijina dami hiyakuhiŋishamu daBayali. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.27",
            "verseOrgIds": [
              "JER.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaprofwetu wukweti chilota, ashimuni chilota. Wukweti izu dami, ashimuni izu dami chakashinshi. Muzuŋu wowumu natidiku? Dimu mwanahoshiyi Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.28",
            "verseOrgIds": [
              "JER.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nindi, Izu dami hididi neyi kesuku? Hididi neyi hamala yabalulaŋa ilola yibalu yibaluku?",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.29",
            "verseOrgIds": [
              "JER.23.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.29",
            "verseOrgIds": [
              "JER.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Yehova nindi, Tiyenu, atuprofwetu eyaloŋa akwawu mazu ami, hinakumi kudi wenaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.30",
            "verseOrgIds": [
              "JER.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nindi, Atuprofwetu elaŋa ahosha namadimi awu awenawu, hiyakwila nawu, Yena diyi nahoshi, ami hinakumi kudi wenaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.31",
            "verseOrgIds": [
              "JER.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nindi, Tiyenu, atuprofwetu aprofwetaŋa yilota yakutwamba, hiyakuyilejayu akwawu, hiyakuluwaŋesha antu ami nakutwamba kwawu, nakudisamba kwawu kwamukunkulwayi, ami hinakumi kudi wenaku. Ami kwami hinayitemesheli hela kuyilejaku; niwena hiyakayiwahisha antu awa nihantuku. Dimu mwanahoshiyi Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.32",
            "verseOrgIds": [
              "JER.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela antu awa, hela kaprofwetu, hela kapristu, akakwihula nawu, Wuprofwetu waYehova hiwuprofwetwinyi? eyi wakayila neyi, Wuprofwetu, yenu. Yehova nindi, Nukuyinata kwami. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.33",
            "verseOrgIds": [
              "JER.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwila hela kaprofwetu, hela kapristu, hela antu, akela nawu, Wuprofwetu waYehova, ami nakababesha yena muntu owu nimutaŋa windi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.34",
            "verseOrgIds": [
              "JER.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyenu chimwakayila akwenu nawana kwenu. Kayilenu nenu, Yehova naakuli nindidi? Hela nenu, Yehova nahoshi nindidi? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.35",
            "verseOrgIds": [
              "JER.23.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JER 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi mwakatena cheŋi wuprofwetu waYehovaku, muloŋa wuprofwetu wamuntu himuntu dodizu dindi yomweni muntu. Muloŋa munabalumuni dehi mazu aNzambi wamumi, aNzambi yetu Yehova wamazaza. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.36",
            "verseOrgIds": [
              "JER.23.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JER 23:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiya chiwakamwila owu kaprofwetu, kamwili neyi, Yehova nakwakuli nindidi? Hela neyi, Yehova nahoshi nindidi? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.37",
            "verseOrgIds": [
              "JER.23.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JER 23:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa neyi mwakela nenu, Wuprofwetu waYehova; dichi Yehova nahoshi nindi, Ochu chimunahoshi nenu, Wuprofwetu waYehova, kutoŋa ami natemesheli kudenu nami, Bayi mwakela nenu, Wuprofwetu waYehovaku; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.38",
            "verseOrgIds": [
              "JER.23.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JER 23:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "dichi tiyenu, ami nakayivulamena chikupu, nakayinata ninenu, nimukala wunenkelenu nawankakulula jenu, mwakafumi kumesu ami. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.39",
            "verseOrgIds": [
              "JER.23.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JER 23:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakayisawisha kusawuka kwahaya nyaka, nakayitiyisha nsonyi yakadi kukuma, yakabula kuvulamenawu antu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.40",
            "verseOrgIds": [
              "JER.23.40"
            ]
          }
        }
      ]
    }
