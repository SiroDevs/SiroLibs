          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.22",
            "verseOrgIds": [
              "JER.33.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 33:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izu daYehova denjili kudi Yeremiya, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.23",
            "verseOrgIds": [
              "JER.33.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 33:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Ochu chanahoshuwu antu awa, nawu, Yisaka yiyedi yatondeliyi Yehova nayinati dehi, hiwunatoŋojoki mwokuku? Dimu mwadi nakudiwilawu antu ami, mwaka abulaŋa kuyimona cheŋi nawu muza. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.24",
            "verseOrgIds": [
              "JER.33.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 33:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nahoshi nindi, Neyi chitiyanenu chami chamwaana nawufuku hichakolaku, neyi yami nabuli kutoŋola mwelaŋa mawulu neseki, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.25",
            "verseOrgIds": [
              "JER.33.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 33:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "komana ninami nawa nakanata anyana kaYakoba, nikakambuŋami Davidi, kulonda nakabuli kutambula kudi anyanindi akwakuyula anyana kaAbarahama naIsaka naYakoba. Muloŋa ami nakafuntisha antu awu ayili muwukoli, nakayitiyila wushona.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.26",
            "verseOrgIds": [
              "JER.33.26"
            ]
          }
        }
      ]
    }
