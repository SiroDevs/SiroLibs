      },
      "items": [
        {
          "text": "41",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 41:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukakweji kamuchitanu nachiyedi Ishimeli mwana kaNetaniya, Netaniya mwana kaElishama, wakwivumu dawanta, wahadi atulambatwa mwanta, nawantu ikumi, hiyakwinza kudi mwana kaAhikami Gedaliya kuMizipa. Kwenoku kuMizipa hiyakudiila hamu yakudya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.1",
            "verseOrgIds": [
              "JER.41.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 41:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana kaNetaniya Ishimeli niantu ikumi adiŋiyi nawu, hiya kunya muka hiya kumutaŋa Gedaliya mwana kaAhikami, Ahikami mwana kaShafwani, nampoku yakabali, hiyakumujaha, muntu akunjikiluwu kudi mwanta wakuBabiloni kwikala nguvulu yetuŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.2",
            "verseOrgIds": [
              "JER.41.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishimeli hakujaha nawa aYudeya ejima adiŋi nayena, adiŋi naGedaliya kuMizipa, niaKaladeya adiŋa kwenoku, wowu akwanjita.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.3",
            "verseOrgIds": [
              "JER.41.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.3",
            "verseOrgIds": [
              "JER.41.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifuku damu chiyedi nanaha hajahiliyi Gedaliya, kwosi muntu nachilukuku, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.4",
            "verseOrgIds": [
              "JER.41.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 41:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "hikukwinza antu akufuma kuShekemi, nikuShilo, nikuSamariya, amayala makumi atanu nasatu, m awevu awu akutewula, mahinawu akutabula, aditaŋola dehi, kumakasawu anasendi nyilambu nilibona, nawu atwalikwitala daYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.5",
            "verseOrgIds": [
              "JER.41.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 41:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana kaNetaniya Ishimeli hakufuma kuMizipaha kuya nakuyikinkilila, iku wudi nakuya, iku wudi nakudila. Chayibulakeniyi hakuyila nindi, Twatuyenu kudi mwana kaAhikami Gedaliya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.6",
            "verseOrgIds": [
              "JER.41.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.8",
            "verseOrgIds": [
              "JER.41.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 41:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wena winowu wanatililiyi Ishimeli yibimbi yejima yamayala ajahiliyi nansaŋu yaGedaliya, diwu wapundiliyi mwanta Asa nawoma watiyiliyi mwanta wawaIsarela Bayasha; mwana kaNetaniya Ishimeli hakuwinzesha antu ajahiliyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.9",
            "verseOrgIds": [
              "JER.41.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu ejima asheluku adiŋi muMizipa, nianyana kamwanta awambanda, niantu ejima asheli muMizipa enkeluwu mwana kaAhikami Gedaliya kudi mukulumpi wawatulama Nebuzaradani, Ishimeli hakuyitwala muwukoli. Mwana kaNetaniya Ishimeli hakuyitwala muwukoli, nindi aketuli ayi kudi anyana kaAmoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.10",
            "verseOrgIds": [
              "JER.41.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "AYohanani mwana kaKareyana wawakulumpi ayendu adiŋiyi nawu ejima, chatiyiluwu kutama kwakoŋeliyi mwana kaNetaniya Ishimeli kwejima, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.11",
            "verseOrgIds": [
              "JER.41.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "hiyakutambika amayala ejima, hiyakuya nakulwa namwana kaNetaniya Ishimeli, hiyakumuwana kwijiyadeneni dekala muGibeyoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.12",
            "verseOrgIds": [
              "JER.41.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi cheliluwu antu ejima adiŋi naIshimeli anamoni dehi mwana kaKareya Yohanani niakulumpi ayendu adiniyi nawu ejima, hiyakutiya kuwaha. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.13",
            "verseOrgIds": [
              "JER.41.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 41:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu ejima afumishiliyi Ishimeli kuMizipa adiŋi nakutwalayi muwukoli hiyakubalumuka, hiya kufunta, hiyakuya kudi mwana kaKareya Yohanani. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.14",
            "verseOrgIds": [
              "JER.41.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 41:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa mwana kaNetaniya Ishimeli hakupuluka kudi Yohanani namayala atanu nasatu, hiyakuya kudi anyana kaAmoni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.15",
            "verseOrgIds": [
              "JER.41.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 41:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.15",
            "verseOrgIds": [
              "JER.41.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 41:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana kaKareya Yohanani niakulumpi ayendu adiŋayi nawu ejimahiya kuya nawantu ejima asheluhu, wowu akuMizipa afuntishiliyi mwayi laŋa wuna mwana kaNetaniya Ishimeli, heliliyi najahi dehi mwana kaAhikami Gedaliya, wowu akwanjita, niambanda, nianyana, niatulala afuntishiliyi cheŋi kuGibeyoni kwayiluwu; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.16",
            "verseOrgIds": [
              "JER.41.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 41:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "hiya kufumaku hiyakuya nakushakama muchilombu chaChimihami chekala kwakwihi naBetelemi, kulonda ayinakwinila kuEjipitu, nansaŋu yawaKaladeya; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.17",
            "verseOrgIds": [
              "JER.41.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 41:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "muloŋa anayitiyi dehi woma muloŋa mwana kaNetaniya Ishimeli najahi dehi mwana kaAhikami Gedaliya akunjikiluwu kudi mwanta wakuBabiloni kwikala nguvulu yetuŋa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.18",
            "verseOrgIds": [
              "JER.41.18"
            ]
          }
        }
      ]
    }
