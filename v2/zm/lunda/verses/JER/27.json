    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatachikili wanta waYehoyakimi mwana kaYosiya, mwanta wawaYuda, kudi Yeremiya kwenjili izu ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.1",
            "verseOrgIds": [
              "JER.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "dakudi Yehova dakwila nindi, Yehova naŋili nindi, Ilaku nyonji yeyi nimpanda jeyi, wakajishi munshiŋu yeyi; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.2",
            "verseOrgIds": [
              "JER.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakajitemeshi kudi mwanta wakuEdomi, nikudi mwanta wakuMowabi, nikudi mwanta wawanyana kaAmoni, nikudi mwanta wakuTira, nikudi mwanta wakuZidoni, nawatmjanda akwinza kuYerusalema kudi mwanta wawaYuda Zedekiya; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.3",
            "verseOrgIds": [
              "JER.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakayileji akahampumwini ankaka jawu, nawu, Yehova wamazaza, Nzambi yaIsarela, nahoshi nindi, Tiyenu chimwakaleja ankaka jenu, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.4",
            "verseOrgIds": [
              "JER.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nenu, Yami neli iseki, niantu, nianyama ekala hewuludeseki, naŋovu jami jasweja, nachikasa chami chakwolola; iseki nadihani kudi antu anawahili kumuchima wami. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.5",
            "verseOrgIds": [
              "JER.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi dinu nenki dehi matuŋawa ejima kudi kambuŋami mwanta wakuBabiloni Nebukaneza, nianyama amumpata namwinki akamukalakeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.6",
            "verseOrgIds": [
              "JER.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyuza yejima yakamukalakela yena, yakakalakela nimwanindi, nimwana kamwanindi, niehakashika mpinji yetuŋa dindi yomweni; henohu nyuza yayivulu nianyanta amaneni akamubalumuna kwikala nduŋu yawu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.7",
            "verseOrgIds": [
              "JER.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.7",
            "verseOrgIds": [
              "JER.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nindi, Chakela, muza hela wanta wakabula kukalakela yena mwanta wakuBabiloni Nebukaneza owu, wakabula kusha nshiŋu yindi mumpanda yamwanta wakuBabiloni, muzowu nakawubabesha nampoku yakabali, nanzala, nachipupu nichinakayinogesha kuchikasa chindi to-o.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.8",
            "verseOrgIds": [
              "JER.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.8",
            "verseOrgIds": [
              "JER.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu bayi mutiyililaŋa kudi atuprofwetu twenu, hela kudi akwakuyi hoŋela, nikuyilota yenu, hela kudi akwakuyi fuchikila, hela kudi akwakuyipandila ahoshaŋa nenu nawu, Bayi mwaka mukalakela mwanta wakuBabilonuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.9",
            "verseOrgIds": [
              "JER.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa wena adi nakuyiprofwetela chuma chakutwamba, kulonda ayitwali kwakulehi netuŋa denu; kulonda ami niyitemunumu, mwakanoŋi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.10",
            "verseOrgIds": [
              "JER.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nindi, Ilaŋa muza wakeŋija nshiŋu jawu mumpanda yamwanta wakuBabiloni, wukamukalakela, muzowu nakawuleka wakashali mwituŋa dawu, akadimaŋamu, akashakamumu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.11",
            "verseOrgIds": [
              "JER.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.11",
            "verseOrgIds": [
              "JER.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinukuhosha namwanta wawaYuda Zedekiya mwaya mazu awa ejima, nami, Iŋŋenu nshiŋu jenu mumpanda yamwanta wakuBabiloni, mwakamukalakelaŋa yena niantu indi, mwakahandi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.12",
            "verseOrgIds": [
              "JER.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukufwiladi nineyi niantu eyi, nampoku yakabali, nanzala, nichipupu, neyi chanahoshiyi Yehova chakutena muza wukubula kukalakela mwanta wakuBabiloni? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.13",
            "verseOrgIds": [
              "JER.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi mutiyililaŋa mazu awatuprofwetu adi nakuhoshawu nanenu, nawu, Bayi mwakamukalakela mwanta wakuBabilonuku. Muloŋa wena adi nakuyiprofwetela chuma chakutwamba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.14",
            "verseOrgIds": [
              "JER.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nindi, Muloŋa ami hinayitemeshuku, adi nakuprofweta mwakutwamba mwijina dami, kulonda nakayitemunumu, mwakanoŋi ninenu niatuprofwetu ayiprofwetelaŋa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.15",
            "verseOrgIds": [
              "JER.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.15",
            "verseOrgIds": [
              "JER.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinukuhosha nawa nawatupristu nawantu awa ejima, nami, Yehova nahoshi nindi, Bayi mutiyililaŋa mazu awatuprofwetu twenu ayiprofwetelaŋa nawu, Tiyenu yuma yamwitala daYehova keŋa ayifuntishi cheŋi kuBabiloni yifumi kuyayiluku. Muloŋa wena adi nakuyiprofwetela chuma chakutwamba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.16",
            "verseOrgIds": [
              "JER.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi mutiyilila kudi wenaku. Mukalakelenu mwanta wakuBabiloni, muhandi. Indi mukaliwu wakabalumukiladi chihembi? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.17",
            "verseOrgIds": [
              "JER.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi hiyatuprofwetu, hela neyi izu daYehova didi nawena, alembeleli dinu Yehova wamazaza, kulonda yuma yinashali mwitala daYehova, nimwitala damwanta wawaYuda, nikuYerusalema, yibuli kuya kuBabiloni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.18",
            "verseOrgIds": [
              "JER.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa Yehova wamazaza nateni yishimi, niŋiya, nimatentaminu, niyuma yinashali yasheli mumukala wunu, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.19",
            "verseOrgIds": [
              "JER.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "yabulili kutwalayi mwanta wakuBabiloni Nebukaneza, hafumishiliyi mwanta wawaYuda Yekoniya mwana kaYehoyakimi kuYerusalema, hakumutwala kuBabiloni hamu nawayilolu ejima amuYuda namuYerusalema; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.20",
            "verseOrgIds": [
              "JER.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "eŋa, Yehova wamazaza, Nzambi yaIsarela, nateni yuma yasheli mwitala daYehova, nimwitala damwanta wawaYuda, nikuYerusalema, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.21",
            "verseOrgIds": [
              "JER.27.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Akayitwala kuBabiloni, diku kuyakekala kushika nikwifuku dinakayihempula. Dimu mwanahoshiyi Yehova. Nindi, Dihu hinakayileta cheŋi, nakayifuntisha cheŋi kwenakunu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.22",
            "verseOrgIds": [
              "JER.27.22"
            ]
          }
        }
      ]
    }
