    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova hakunleja, kutala hikudi nyitoŋa yayikuyu yiyedi, anayitenteki kumesu atembeli yaYehova, henohu mwanta wakuBabiloni Nebukaneza natwali dehi aYekoniya mwana kaYehova kimi mwanta wawaYuda, nawatulamba twawaYuda, nawakwawukalawenu, nawachi, muwukoli, nayifumishi dehi kuYerusalema, nayitwali dehi kuBabiloni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.1",
            "verseOrgIds": [
              "JER.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutoŋa wumu wadiŋi nayikuyu yasweja kuwaha neyi yikuyu yasambilaŋahu dehi kwiha; mutoŋa wukwawu wadiŋi nayikuyu yasweja kutama kutwesha kuyidya nehi, nanochu chiyasweja kutama nankashi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.2",
            "verseOrgIds": [
              "JER.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova hakuŋila nindi, Eyi Yeremiya, wunamoni chumanyi? Nami, Yikuyu; yikuyu yayiwahi yasweja kuwaha; yatama yasweja kutama, kutwesha kuyidya nehi nanochu chiyasweja kutama nankashi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.3",
            "verseOrgIds": [
              "JER.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izu daYehova hidikwinza kudami, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.4",
            "verseOrgIds": [
              "JER.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Yehova Nzambi yaIsarela nahoshi nindi, Chineli yikuyu iyi yayiwahi dichi chinakafuukula niankoli awaYuda inafumishi mwenamunu, inatemeshi mwituŋa dawaKaladeya, kulonda kuwaha. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.5",
            "verseOrgIds": [
              "JER.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa ami nakasha mesu ami hadi wena kulonda kuwaha, nakayileta cheŋi mwituŋa dinu. Nakayituŋa, hinakayisandaku. Nakayitumba, hinakayibwitaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.6",
            "verseOrgIds": [
              "JER.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakayinka muchima wakuŋiluka, nawu yami Yehova. Akekala antu ami, ninami nakekala Nzambi yawu. Muloŋa wena akafunta kudami namuchima wawu wejima. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.7",
            "verseOrgIds": [
              "JER.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chalala Yehova nahoshi nindi, Chineli yikuyu iyi yatama, kutwesha kuyidya nehi nanochu chiyasweja kutama, dichi chinakahana niZedekiya mwanta wawaYuda, niatulamba twindi, niamuYerusalema anashali, wowu anashali mwituŋidi, niashakama mwituŋa daEjipitu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.8",
            "verseOrgIds": [
              "JER.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakayihana kulonda ayizukumoni mwahita mawanta aheseki ejima kulonda kutama, kulonda kusawuka, kulonda ekali chishimu, kulonda kuyitaŋula, nikuyishiŋa, mumpata jejima munakayitemwina. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.9",
            "verseOrgIds": [
              "JER.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukachi kawu nakatemeshamu mpoku yakabali, ninzala, nichipupu, nichakanoŋawu mwituŋa dinayinkeli niwena niankakulula jawu to-o.",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.10",
            "verseOrgIds": [
              "JER.24.10"
            ]
          }
        }
      ]
    }
  ],
