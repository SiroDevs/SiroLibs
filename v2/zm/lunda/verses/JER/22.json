  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "JER 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nahoshi nindi, Kunkumukaku kwitala damwanta wawa-Yuda wakahosheluku izu idi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.1",
            "verseOrgIds": [
              "JER.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakeli neyi, Eyi mwanta wawaYuda washakama hetanda daDavidi dawanta, nineyi, niambugeyi, niantu eyi eŋilana kuyisu iyi, tiyenu izu daYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.2",
            "verseOrgIds": [
              "JER.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nahoshi nindi, Ilenu mwawuŋaji nakuloŋa, mwakapulwishaŋa nabuwuwu kudi akwakuyikabisha; nimwenyi, ninshona, nintuluwa wamumbanda bayi mwakayitamisha hela kuyikoŋa jandombuku, bayi mupwekesha hela mashi akadi muloŋa mwenamunuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.3",
            "verseOrgIds": [
              "JER.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa neyi chalala mwakela chumichi, kuyisu yetalidi kwamba keŋilaŋa anyanta ashakamaŋa hetanda daDavidi dawanta, akendelaŋa nimumakálu, nihatuwalu, niwena niambuŋawu niantu awu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.4",
            "verseOrgIds": [
              "JER.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwinza neyi mwakabula kutiya mazu awa, Yehova nindi, Ami nadisanyiki dehi ami aweni nami, Italidi dakabalumuka chihembi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.5",
            "verseOrgIds": [
              "JER.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa Yehova nateni dehi mutaŋa wamwanta wawaYuda, nindi, Eyi kudami wuGileyadi, wunamutu waLebanoni; hela chochu, nakakubalumuna kwikala isaŋa tuhu, ninyikala yakadi antu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.6",
            "verseOrgIds": [
              "JER.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakakulogeshela akwakukujilu muna, iwu nayuma yindi, iwu nayuma yindi; akatema nyisida yeyi yayiwahi, akayinatila mukesi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.7",
            "verseOrgIds": [
              "JER.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyuza yayivulu yakahita kumukaliwu, akahosha, iwu nakumwila mukwawu nindi, Yehova nakogelidi mukaliwu weneni chenichi? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.8",
            "verseOrgIds": [
              "JER.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akadakula nawu, Muloŋa alekeli chitiyaŋenu chaYehova Nzambi yawu, hiyakudifukula kudi akishi, hiyakuyipesha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.9",
            "verseOrgIds": [
              "JER.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.9",
            "verseOrgIds": [
              "JER.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi mudila mufu hela kudihuŋa kunamutuku. Chiŋa musweja kudila wukufumaku; muloŋa yena hakafunta cheŋi hela kumona ituŋa dindi dasemukililiyuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.10",
            "verseOrgIds": [
              "JER.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa Yehova nateni Shalumi mwana kaYosiya, mwanta wawaYuda, waswanini tata yindi Yosiya, wedikili mweamunu hakuya, nindi, Hakafunta cheŋi munuku; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.11",
            "verseOrgIds": [
              "JER.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "muloŋa wakafwila kwokwenakuna kwanamutwaluwu muwukoli, ituŋa dinu hakadimoa cheŋuku.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.12",
            "verseOrgIds": [
              "JER.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.12",
            "verseOrgIds": [
              "JER.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yayo muntu wukutuŋa itala dindi nakuheŋa, wukutuŋa tupeka twindi nakubula chiyulu, wukukalakesha mukwawu chamukunkulwayi, chakubula kumwinka wufwetu; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.13",
            "verseOrgIds": [
              "JER.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "wukwila nindi, Nukutuŋa itala dami deneni, nitupeka twamaneni, wukulokola njanina jindi; itala datupala twanyisida dakupenta wulombu wuchinana. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.14",
            "verseOrgIds": [
              "JER.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muwanta wakashakaminamu nanochu chiwafwila kubadika akwenu nyisida, tahindi? Tata yeyi hadiilaŋaku? Hanwinaŋaku? Helilaŋa mwawuŋaji nachiyuluku? Hashakamini chachiwahuku? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.15",
            "verseOrgIds": [
              "JER.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena kwindi wasompelaŋa nyiloŋa yawatuzweŋi nawabula yuma; chadiŋi chachiwahi. Chelilaŋayi mwenimu hiyowu kuŋilukaku? Dimu mwanahoshiyi Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.16",
            "verseOrgIds": [
              "JER.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa mesu eyeyi, nimuchima weyeyi hiwukweti mudimu wacheŋuku chiŋa lwolwisu lweyi, nikupwekesha mashi akadi muloŋa, nikukabisha antu, nikwila jandombu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.17",
            "verseOrgIds": [
              "JER.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Yehova nateni dehi Yehova kimi mwana kaYosiya mwanta wawaYuda nindi, Akabula kumudila nawu, Lelu mana kwami! hela nawu, Lelu muhelami! Akabula kumudila nawu, Lelu nkako! hela nawu, Lelu lubanji lwindi! ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.18",
            "verseOrgIds": [
              "JER.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamujiika neyi chajiikaŋawu chimbulu, wakukoka nakunata hanzi yayisu yampwembu yaYerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.19",
            "verseOrgIds": [
              "JER.22.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.19",
            "verseOrgIds": [
              "JER.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandukaku kuLebanoni, wukaluki nyiteti; koleshaku izu deyi muBashani, wakakalukili nyiteti kuAbarimi; akwenu akukegelaŋa anajilumuki. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.20",
            "verseOrgIds": [
              "JER.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiwashakaminaŋa nakuluŋa nahosheli neyi, eyi welili neyi, Ami kwami kutiya nehi. Dimu welilaŋa kufumisha kuwansi weyi, hiwovwahililaŋa izu damuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.21",
            "verseOrgIds": [
              "JER.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tubiŋa tweyi twejima akayidiisha mpepela, akukegeli akaya muwukoli. Chalala wakatiya nsonyi, wakabaya nakutama kweyi kwejima. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.22",
            "verseOrgIds": [
              "JER.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi washakama muLebanoni, watuŋilaŋa wuswa weyi munyisida, o chiwakatela kukutiyila wushona, hakakuwana nyisoŋu yidi neyi yikatu yamumbanda wudi nakuvwala!",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.23",
            "verseOrgIds": [
              "JER.22.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.23",
            "verseOrgIds": [
              "JER.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nindi, Ichi nahandichi kwaamu, hela eyi Koniya mwana kaYehova kimi mwanta wawaYuda, neyi wadiŋi kazeya kakuchikasa chami chachidiilu, nadi kukutomonaku tuhu kwami; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.24",
            "verseOrgIds": [
              "JER.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "nadi kukuhana kudi wena akukeŋa kukujaha, nikudi wena watiya woma, kwokudi mwanta wakuBabiloni Nebukaneza, nikudi aKaladeya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.25",
            "verseOrgIds": [
              "JER.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nineyi nimama yeyi wakuvweli, nakayinatila mwituŋa dacheŋi dimwabulili kusemukila, kwoku mwakafwila.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.26",
            "verseOrgIds": [
              "JER.22.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.28",
            "verseOrgIds": [
              "JER.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi iseki, iseki, iseki, tiya izu daYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.29",
            "verseOrgIds": [
              "JER.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
