  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "51",
        "style": "c",
        "sid": "JER 51"
      },
      "items": [
        {
          "text": "51",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 51:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nahoshi nindi, Tiyenu, nakasaŋu mwina Babiloni, nanawa ashakamamu akunnyamukila, mpepela yakuyijilumuna. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.1",
            "verseOrgIds": [
              "JER.51.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 51:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakatemesha kuBabiloni antu akwacheŋa, akamupepa, akamanisha antu mwituŋa dindi to-o. Muloŋa kamu nyeŋumuka kwi-ndo mwifuku dayihuŋu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.2",
            "verseOrgIds": [
              "JER.51.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 51:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.4",
            "verseOrgIds": [
              "JER.51.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 51:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa hela Isarela, hela Yuda, hiyanayumbi kudi Nzambi yawu, kudi Yehova wamazazaku; kutopa ituŋa dawu dinenzali nanyiloŋa yana wanu wukudi Wajila waIsarela. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.5",
            "verseOrgIds": [
              "JER.51.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 51:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Temukenu mukachi kaBabiloni mupulwishiwumi wenu wejima wenu; bayi mukoola kuluwa kwinduku; muloŋa himpinji yakutenda kwaYehova; akamuwanishili wufwetu windi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.6",
            "verseOrgIds": [
              "JER.51.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 51:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babiloni wadiŋa neli lupasa lwawuru muchikasa chaYehova lwakushetesha isekidejima. Nyuza yanwamu dehi vinyu yidumu; dichi nyuza yinazaluki dehi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.7",
            "verseOrgIds": [
              "JER.51.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 51:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babiloni nadimbuki chakukasumuka hohu, najilumuki. Mukalokelenu nyiteti. Mukeŋelenu yitumbu yayikatu yindi, wamba kela akamúuka. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.8",
            "verseOrgIds": [
              "JER.51.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 51:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twakeŋeli netu tumúuki Babiloni, aka, kukola kwindi nehi. Múumbenu, tuyenu wejima wetu, iwu kwituŋa dawu iwu kwituŋa dawu. Muloŋa kusompesha kwindi kunashiki nikwiwulu, anachishikŋi nikumavu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.9",
            "verseOrgIds": [
              "JER.51.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 51:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.10",
            "verseOrgIds": [
              "JER.51.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 51:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalulenu nsewu, kwatenu kunkebu mbe. Yehova nasaŋumuni dehi jispiritu jawanyanta awaMediya; muloŋa yena nakwatili dehi Babiloni mpùŋa yaku mujilu muna, muloŋa kutenda kwaYehova kwakutenda tembeliyindi kunashiki dehi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.11",
            "verseOrgIds": [
              "JER.51.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 51:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpwembu jaBabiloni jiimikilenu mpandelu, koleshenu atulama, shenuku akwakutalatala, loŋeshenu akwakubela mina. Muloŋa Yehova neli nikufuukula diyi, nikukoŋa chuma chatenene niyi akwakushakama muBabiloni diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.12",
            "verseOrgIds": [
              "JER.51.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 51:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelu eyi washakama hameji amavulu, wasweja yuma yalema, jinakukumi, mwashikila lwisu lweyi mwomwenimu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.13",
            "verseOrgIds": [
              "JER.51.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 51:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.14",
            "verseOrgIds": [
              "JER.51.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 51:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena neli maseki naŋovu jindi, nakoleshi mpata yamunu mwishina namaana indi, natanjiki mawulu nakashinshi kindi; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.15",
            "verseOrgIds": [
              "JER.51.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 51:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "chakuhoshayi izudindi hiipumba dameji mumawulu, wakakumwishaŋa chishishi kunsa jeseki, wakeneshaŋa kulonda nvula, wedishapa mpepela mwaswekaŋa ayi yumayindi yalema. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.16",
            "verseOrgIds": [
              "JER.51.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 51:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu ejima anabalumuki neyi anyama, hiyeluka chumaku, achi awuru ejima anayitiyishi nsonyi kudi akishi awu akusoŋa; muloŋa akishi awu akusuŋununa hiyuma yakutwamba, himwekala muuya ku.",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.17",
            "verseOrgIds": [
              "JER.51.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 51:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.19",
            "verseOrgIds": [
              "JER.51.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 51:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeyi chibáaŋa chami chanjita, yeyi yitwa yami yanjita. Yeyi nakakotolanachu nyuza kotu-kotu. Yeyi nakajilumuna nachu mawanta. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.20",
            "verseOrgIds": [
              "JER.51.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 51:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeyi nakakotola nachu nituwalu niakwakwendelahu kotu-kotu. Yeyi nakakotola nachu makálu anjita niakwakwendelamu kotu-kotu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.21",
            "verseOrgIds": [
              "JER.51.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 51:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeyi nakakotola nachu ni amayala niambanda kotu-kotu. Yeyi nakakotola nachu niakulumpi niansanda kotu-kotu. Yeyi nakakotola nachu nianyi kwenzini ayaloŋa adima kotu-kotu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.22",
            "verseOrgIds": [
              "JER.51.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 51:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeyi nakakotola nachu niatubipa ninyikanka yawu yayimuna kotu-kotu. Yeyi nakakotola nachu niandimi niaŋombi jawu akudima nachu kotu-kotu. Yeyi nakakotola nachu nianguvulu nianyuli kotu-kotu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.23",
            "verseOrgIds": [
              "JER.51.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 51:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "NiBabiloni niakwakushakama muKaladeya nakayifwetesha kutama kwawu kwejima kwakoŋeluwu kumesu enu muZiyona. Dimu mwanahoshiyi Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.24",
            "verseOrgIds": [
              "JER.51.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 51:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.24",
            "verseOrgIds": [
              "JER.51.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 51:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nahoshi nindi, Eyi mpidi yajilumunaŋa antu, yajilumunaŋaseki dejima, tiya, ami nakwimani mbe. Nakakwolwela chikasa chami, nakakufumisha mumalola, nakakukunkumuna, nakakubalumuna kwikalampidi yasukuma. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.25",
            "verseOrgIds": [
              "JER.51.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 51:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kudeyi hiyakafumishaku ilola dakwiwombu hela dakuchikukuku. Wakekala kweyi kwachihembi hohu haya nyaka. Dimu mwanahoshiyi Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.26",
            "verseOrgIds": [
              "JER.51.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 51:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imikenu mpandelu mwituŋa, imbenu mpùŋa mukachi kanyuza, loŋeshenu nyuza yimwimani mbe, mutambikilenu mawanta aArarati, naMini naAshikenazi, amwimani mbe. Mukunji kenu mwanta wanjita amwimanimbe. Mukanjikilenu tuwalu tudi neyi mahashi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.27",
            "verseOrgIds": [
              "JER.51.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 51:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.27",
            "verseOrgIds": [
              "JER.51.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 51:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋeshelenu nyuza, nianyanta awaMediya, nianguvulu jawu, nianyuli jawu ejima, niituŋa dawanta windi dejima, amwimani mbe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.28",
            "verseOrgIds": [
              "JER.51.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 51:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ituŋa hidikuzaala, dinatiyi yikatu. Muloŋa yanafuukwiluwu Babiloni kudi Yehova, yakubalumuna ituŋa daBabiloni diikali kwayihembi yakadi antu, yinakoli.",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.29",
            "verseOrgIds": [
              "JER.51.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 51:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.32",
            "verseOrgIds": [
              "JER.51.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 51:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa Yehova wamazaza, Nzambi yaIsarela, nindi, Mwana kaBabiloniwa mumbanda neli dehi neyi hawuhulilu watidiku hayidatolaŋawu; kapinji kanti hohu chilaaka chakwaŋula chakamuwana. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.33",
            "verseOrgIds": [
              "JER.51.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 51:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wakuBabiloni Nebukaneza naŋudyi, nanchiki, nambalumuni neyi nswaha yakumwaŋa adehi, nanminyi dehi neyi chanza ŋombi, nekuti dehi ivumu mbena yuma yami yalembuka; naŋumbili dehi hanzi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.34",
            "verseOrgIds": [
              "JER.51.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 51:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wáshakama muZiyona wakela nindi, Jandombu jankoŋeluwu ninami nimujimba wami, Babiloni ajikooli; Yerusalema wakela nindi, Ashakama muKaladeya akooli mashi ami.",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.35",
            "verseOrgIds": [
              "JER.51.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JER 51:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.40",
            "verseOrgIds": [
              "JER.51.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JER 51:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "O chanatambuluwu Sheshaki! Ashimekawu iseki dejima o chana mukasu mwishuwu, Babiloni o chelayi dehi kwachihembi hohu mukachi kanyuza! ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.41",
            "verseOrgIds": [
              "JER.51.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JER 51:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaluŋalwiji kanamuwani dehi Babiloni, anamubuti dehi namankanda indi amavulu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.42",
            "verseOrgIds": [
              "JER.51.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JER 51:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyikala yindi yela dehi kwayihembi, ituŋadawuma, chinkalampata, ituŋa dakadi kushakama antu, dakadi nikuhitila mwana kamuntu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.43",
            "verseOrgIds": [
              "JER.51.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JER 51:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakamusompesha Beli muBabiloni, nakamusanzisha yami nyayi dehi; nyuza hiyakahwila nawa cheŋa kudi yenaku. Mwalala, mpwembu yaBabiloni yakakunduka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.44",
            "verseOrgIds": [
              "JER.51.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JER 51:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.44",
            "verseOrgIds": [
              "JER.51.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JER 51:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu antu ami fumenu mudi yena, mudamwini wejima wenu kukuzuwa kwaYehova kwasweja. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.45",
            "verseOrgIds": [
              "JER.51.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JER 51:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi mwakazeya munyichima yenuku, bayi mwakatiya woma wansaŋu yanáwunáwu yakatiyakana mwituŋaku; muloŋa kwakenza nsaŋu yanáwunáwu hamwaka wumu, kukumininaku hamwaka wukwawu kwakenza nsaŋu yanáwunáwu, nindombu mwituŋa, nyuli nakumwima namukwawu nyuli. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.46",
            "verseOrgIds": [
              "JER.51.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JER 51:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi tiya, kwakenza mafuku inakasompesha akishi akusoŋa kuBabiloni, niituŋa dindi dejima dakatiya nsonyi, antu indi akajahawu akadimbukila mukachi kindi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.47",
            "verseOrgIds": [
              "JER.51.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JER 51:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu nimawulu nimaseki niyuma yejima yekalamu, yakemba tumina twakuzaŋa alala nansaŋu yaBabiloni. Muloŋa kwakubuwa akufuma kukabeta kakuchimunswa, akamuwana. Dimu mwanahoshiyi Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.48",
            "verseOrgIds": [
              "JER.51.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JER 51:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanadimbwi shiluwu aIsarela ajahiluwu kudi aBabiloni, dimu nawa mwakadimbukilawu antu ejima amwituŋa dejima akajahawu kuBabiloni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.49",
            "verseOrgIds": [
              "JER.51.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JER 51:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.49",
            "verseOrgIds": [
              "JER.51.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JER 51:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu munapuluki kumpoku jatubali, yenu, bayi mwimanaku, mwakamwanukilaŋa aYehova kwakulehi, Yerusalema akenzi kunyichima yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.50",
            "verseOrgIds": [
              "JER.51.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JER 51:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tunatiyi nsonyi, muloŋa tunatiyi jakutusawula. Nsonyi jinatubuti dehi kumesu wi-i, muloŋa mumalala amwitala daYehova muneŋili dehi antu akwacheŋi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.51",
            "verseOrgIds": [
              "JER.51.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "JER 51:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Yehova nindi, Tiya, kwakenza mafuku inakasompesha akishi indi akusoŋa; mwahita ituŋa dindi dejima mwakekala nyaabu yawantu akatapawu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.52",
            "verseOrgIds": [
              "JER.51.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "JER 51:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela Babiloni wakakandama ashika nikwiwulu, hela wakahatisha hewulu hakolelayi, kudi yena kwakenza akwakubuwa akufumakudami. Dimu mwanahoshiyi Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.53",
            "verseOrgIds": [
              "JER.51.53"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "JER 51:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.53",
            "verseOrgIds": [
              "JER.51.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "JER 51:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "KuBabiloni kunatiyakani mbila, kwituŋa dawaKaladeya kunatiyakani kujilumuka kwasweja! ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.54",
            "verseOrgIds": [
              "JER.51.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "JER 51:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa Yehova hakubuwa Babiloni, hakukisaŋanamu izu deneni. Mankandawu hiyakuvuma neyi chimeji chachivulu; izu danahoshuwu dinatiyakani. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.55",
            "verseOrgIds": [
              "JER.51.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "JER 51:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukwakubuwa namuwani dehi, namuwani Babiloni, ayilobu jindi anayikwati dehi, matawu anyikunji anayikotoli dehi kotu-kotu; muloŋa Yehova hiNzambi wakufwetesha, chalala kwaamu wakafwetesha hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.56",
            "verseOrgIds": [
              "JER.51.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "JER 51:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakashetesha niatulamba twindi, niantu indi akwamaana, nianguvulu jindi, nianyuli jindi, niayilobu jindi, akakama tulu twahaya nyaka twakubula kuhinduka. Dimu mwanahoshiyi Mwanta, wukweti ijina daYehova wamazaza. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.57",
            "verseOrgIds": [
              "JER.51.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "JER 51:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wamazaza nahoshi nindi, Mpwembu jakuBabiloni jatandumuka jakakunduka chikupu, yenzelu yindi yayilehi yakumpwembu jindi yakasukuma nakesi; nyuza yawantu yakakabakena chuma chamukunkulwayi, nyuza yakakabakena kesi, akazeya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.58",
            "verseOrgIds": [
              "JER.51.58"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "JER 51:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.58",
            "verseOrgIds": [
              "JER.51.58"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "JER 51:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izu dakaprofwetu Yeremiya dalejeliyi Seraya mwana kaNeriya, Neriya mwana kaMaseya, hayiliyi namwanta wawaYudeya Zedekiya kuBabiloni, mumwaka wawanta windi wamuchiwana. Henohu Seraya wadiŋi mukulumpi wawatulama. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.59",
            "verseOrgIds": [
              "JER.51.59"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "60",
            "style": "v",
            "sid": "JER 51:60"
          },
          "items": [
            {
              "text": "60",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeremiya wasonekeli mumukanda yuma yatama yejima yamba kamona Babiloni, wowu mazu awa ejima anasonekuwu akutena Babiloni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.60",
            "verseOrgIds": [
              "JER.51.60"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "61",
            "style": "v",
            "sid": "JER 51:61"
          },
          "items": [
            {
              "text": "61",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeremiya hakumwila Seraya, nindi, Chiwakashika kuBabiloni, wakaanuka kutaŋa mazu awa ejima. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.61",
            "verseOrgIds": [
              "JER.51.61"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "62",
            "style": "v",
            "sid": "JER 51:62"
          },
          "items": [
            {
              "text": "62",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakela neyi, Eyi Yehova wunateni dehi mukala wunu, neyi Nakawufumishahu, mwakabuli kushakama hela muntu hela kanyama. Neyi, Wakekala kwayihembi hohu haya nyaka. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.62",
            "verseOrgIds": [
              "JER.51.62"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "63",
            "style": "v",
            "sid": "JER 51:63"
          },
          "items": [
            {
              "text": "63",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiwakela wunakumishi dehi kutaŋa mukandiwu, wakakasaku ilola, hiwakawunatila mukachi kaYufurati. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.63",
            "verseOrgIds": [
              "JER.51.63"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "64",
            "style": "v",
            "sid": "JER 51:64"
          },
          "items": [
            {
              "text": "64",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiwakela neyi, Dichi chakanekamayi Babiloni, hakafumpuka nawa cheŋuku, nayatama yinakamushikŋila; akazeya. Mwenimu dimu munakumini mazu aYeremiya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.64",
            "verseOrgIds": [
              "JER.51.64"
            ]
          }
        }
      ]
    }
