        },
        {
          "text": "Izu daYehova denjili kudi kaprofwetu Yeremiya dakutena aFwilistinu, helili Fwaro wuchidi kanaa atapi Gaza.",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.1",
