    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 37:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana kaYosiya Zedekiya hakushakama muwanta, naswani dehi mwana kaYehoyakimi Koniya, adiishiluwu wanta wamwituŋa daYuda kudi mwanta wakuBabiloni Nebukaneza. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.1",
            "verseOrgIds": [
              "JER.37.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 37:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela yena, hela ambuŋindi, hela antu amwituŋa, kutiyilila kumazu aYehova ahosheliyi nakaprofwetu Yeremiya, nehi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.2",
            "verseOrgIds": [
              "JER.37.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 37:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.2",
            "verseOrgIds": [
              "JER.37.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 37:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta Zedekiya watemesheli mwana kaShelemiya, Yehukali, niZefwaniya mwana kakapristu Maseya, kudi kaprofwetu Yeremiya, nindi, Atulombeluku mwani, kudi Yehova Nzambi yetu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.3",
            "verseOrgIds": [
              "JER.37.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 37:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu Yeremiya wudi nakudendela mukachi kawantu, kanda amushi mukaleyaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.4",
            "verseOrgIds": [
              "JER.37.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 37:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu njita yaFwaro yafuma dehi muEjipitu. AKaladeya akuchikili Yerusalema hiyakutiya nsaŋu yawu, hiyakujaha chimba chawu chakuYerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.5",
            "verseOrgIds": [
              "JER.37.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 37:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.5",
            "verseOrgIds": [
              "JER.37.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 37:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izu daYehova hidikwinza kudi kaprofwetu Yeremiya, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.6",
            "verseOrgIds": [
              "JER.37.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 37:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Yehova Nzambi yaIsarela nahoshi nindi, Tiyenu chimwakamwila mwanta wawaYuda nayitemeshi kudami nakwihula, nenu, Tiyenu, njita yaFwaro yinenzi nakuyikwashaku yakafunta cheŋi mwituŋa dawu muEjipitu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.7",
            "verseOrgIds": [
              "JER.37.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 37:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "AKaladeya akafunta cheŋi kunu, akalwa namukaliwu, akawutambula, akawocha nakesi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.8",
            "verseOrgIds": [
              "JER.37.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 37:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nahoshi nindi, Bayi mudidimba nenu, AKaladeya chalala akatu fumaku. Hiyakayifumaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.9",
            "verseOrgIds": [
              "JER.37.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 37:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela tuhu neyi mwatapa njita yejima yawaKaladeya adi nakulwa nanenu, hikukushala kwampanza hohu, adi kunyamuka mumatenti awu wejima wawu, adi kwocha mukaliwu nakesi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.10",
            "verseOrgIds": [
              "JER.37.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 37:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.10",
            "verseOrgIds": [
              "JER.37.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 37:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chelili njita yawaKaladeya yinajahi dehi chimba chawu chakuYerusalema, nawomawanjita yaFwarowatiyiluwu, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.11",
            "verseOrgIds": [
              "JER.37.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 37:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeremiya hakufuma muYerusalema nindi ayi mwituŋa daBenjamini, atambwiluku iseka dindi mukachi kawantu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.12",
            "verseOrgIds": [
              "JER.37.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 37:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanashikiyi muchisu chaBenjamini kuwana hikudi mukulumpi wawatulama, ijina dindi Iriya, mwana kaShelemiya, Shelemiya mwana kaHananiya. Hakumukwata kaprofwetu Yeremiya, nindi, Hiwukuya nakudimbukila kudi aKaladeya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.13",
            "verseOrgIds": [
              "JER.37.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 37:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeremiya nindi, Wunatwambi. Hinidi nakuya nakudimbukila kudi aKaladeyaku. Ilaŋa yena kumutiyilila nehi. Dichi Iriya hakumukwata Yeremiya, hakumutwala kudi atulamba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.14",
            "verseOrgIds": [
              "JER.37.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 37:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atulamba hiyakumuzuwila Yeremiya, hiyakumweta, hiyakumusha mukaleya kamwitala dansoneki Jonatani. Muloŋa adibalumuna dehi kaleya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.15",
            "verseOrgIds": [
              "JER.37.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 37:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Helili Yeremiya nenzi dehi mwitala damuwina, nimukapeka kamukachi, Yeremiya nashakami dehi kwenoku mafuku amavulu, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.16",
            "verseOrgIds": [
              "JER.37.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 37:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwanta Zedekiya hakutemesha antu nakumuleta. Mwanta hakumwihwila mwitala dindi kumbeŋu, nindi, Kuduhu kadizu kakudi Yehova? Yeremiya nindi, Didi kwoku. Nindi, Eyi akukuhana kudi mwanta wakuBabiloni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.17",
            "verseOrgIds": [
              "JER.37.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 37:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeremiya nakumwila nawa mwanta Zedekiya nindi, Indi ami nayitamishili hadihi, hela eyi, hela ambugeyi, hela antu awa, mwaka muŋushi mukaleya? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.18",
            "verseOrgIds": [
              "JER.37.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 37:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atuprofwetu twenu ayiprofweteli nawu, Mwanta wakuBabiloni hakenza nakulwa nancnu, hela netuŋa iduku, hiyadihi? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.19",
            "verseOrgIds": [
              "JER.37.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 37:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi dinu, eyi nkaka yami mwanta, tiya mwani. Atiyi mwani chinukulemba kumesu eyi. Bayi wunfuntisha cheŋi kwitala dansoneki Jonatanuku, nakenza kafwilaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.20",
            "verseOrgIds": [
              "JER.37.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 37:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta Zedekiya hakuyileja antu, hiyakumusha Yeremiya muchipaŋu chaawatulama, hiyakumwinkaŋa dinkendi dimu hefuku hefuku dakufumisha kumukwakwa wawakwakutuŋa mankendi, nichimwamanini mankendi ejima mumukala, Dichi Yeremiya hakushakama muchipaŋu chaawatulama.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.21",
            "verseOrgIds": [
              "JER.37.21"
            ]
          }
        }
      ]
    }
  ],
