          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.16",
            "verseOrgIds": [
              "JER.34.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Yehova nahoshi nindi, Himunatiyilili kudami mwakubidika, iwu abidiki mana kwindi, iwu abidiki mukwawu jakulekesha wuduŋuku. Yehova nindi, Tiyenu, nukuyibidikenu jakubula kulekesha wuduŋu, wakumona mpoku yakabali, nichipupu, ninzala. Ninami nakayizukumwisha mwahita mawanta aheseki ejima.",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.17",
            "verseOrgIds": [
              "JER.34.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.17",
            "verseOrgIds": [
              "JER.34.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu awa anamotoki chitiyaŋenu chami, anabuli kukoŋa mazu achitiyaŋenu chatiyaŋenuwu kumesu ami, habalwiluwu mwana kaŋombi hakachi, hiyakuhita mukachi, muneli iku mutamba iku mutamba, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.18",
            "verseOrgIds": [
              "JER.34.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 34:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "wowu atulamba twawaYuda, nawatulamba amuYerusalema, niatulala, niatupristu, niantu ejima amwituŋahitili mukachi, muneli mutamba wamwana kaŋombi iku, mutamba wamwana kaŋombi iku, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.19",
            "verseOrgIds": [
              "JER.34.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 34:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "nakayihana kudi ayilumbu jawu, nikudi antu akukeŋa kuyijaha. Yibimbi yawu yakekala mbiji yakudya atujila ahaluzwizu nawanyama aheseki. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.20",
            "verseOrgIds": [
              "JER.34.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wawaYuda Zedekiya nawatulamba twindi nakayihana kudi ayilumbu jawu, nikudi antu akukeŋa kuyijaha, nikunjita yamwanta wakuBabiloni, anafumi dehi kudenu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.21",
            "verseOrgIds": [
              "JER.34.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 34:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nindi, Tiyenu, nakayileja akafunti cheŋi kumukala wunu. Akalwa nawu, akawutambula, akawocha nakesi. Nyikala yawaYuda nakayibalumuna kwikala yihembi yakadi antu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.22",
            "verseOrgIds": [
              "JER.34.22"
            ]
          }
        }
      ]
    }
