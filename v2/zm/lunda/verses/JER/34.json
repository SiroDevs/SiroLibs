      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izu dakudi Yehova denjili kudi Yeremiya, helili mwanta waku Babiloni Nebukaneza, ninjita yindi yejima, nimawanta ahanu heseki ejima amwovwahililaŋa, ninyuza yejima hiyakulwa naYerusalema, ninanyikala yawu yejima, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.1",
            "verseOrgIds": [
              "JER.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Yehova Nzambi yaIsarela nahoshi nindi, Yaku wakahoshi namwanta wawaYuda Zedekiya, wakamuleji neyi, Yehova nahoshi nindi, Tiya, mukaliwu nakawuhana kudi mwanta wakuBabiloni, niyena wakawocha nakesi, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.2",
            "verseOrgIds": [
              "JER.34.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nineyi hiwakapuluka kudi yenaku, akakukwata chalala, akakuhana kudi yena. Mesu eyi akamona mesu amwanta wakuBabiloni, niyena wakahosha naneyi kanwa nakanwa, nineyi wakaya kuBabiloni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.3",
            "verseOrgIds": [
              "JER.34.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela chochu, tiya izu daYehova, eyi mwanta wawaYuda Zedekiya. Yehova nakuteni dehi nindi, Hiwakafwa nampoku yakabaluku; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.4",
            "verseOrgIds": [
              "JER.34.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakafwa chawunda, chochelelaŋawu ankakulula jeyi anyanta ásambilili, eyi wuchidi kanda, dichi nawa chakakwochelawu eyi. Akakudila nawu, Lelu nkako! Muloŋa ami nahoshi dehi izu idi. Dimu mwanahoshiyi Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.5",
            "verseOrgIds": [
              "JER.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.5",
            "verseOrgIds": [
              "JER.34.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaprofwetu Yeremiya hakuhosha mazu ejimawa namwanta wawaYuda Zedekiya muYerusalema, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.6",
            "verseOrgIds": [
              "JER.34.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "iku njita yamwanta wakuBabiloni yidi nakulwa naYerusalema ninanyikala yawaYuda yinashaluku yejima, yoyaLakishi naAzeka, muloŋa nyikala yayipaka yasheluku yoyeniyi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.7",
            "verseOrgIds": [
              "JER.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.7",
            "verseOrgIds": [
              "JER.34.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyenu izu daYehova denjili kudi Yeremiya, helili mwanta Zedekiya natiyaloŋani dehi chitiyaŋenu nawantu ejima adiŋi kuYerusalema, chakuyibidika jakulekesha wuduŋu; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.8",
            "verseOrgIds": [
              "JER.34.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "izu dakwila nawu antu ejima akayumbuku anduŋu jawu aHeberu amayala, nianduŋu jawu aHeberu awambanda, bayi muntu wakaheta mana kwindi kaYudeya muwuduŋuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.9",
            "verseOrgIds": [
              "JER.34.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atulamba ejima niantu ejima atiyaŋeni chitiyaŋenu chakwila nawu akayumbuku anduŋu jawu amayala, nanduŋu jawu awambanda, akabuli kuyiheta cheŋi muwuduŋu, ovwahililumu ayumbiluku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.10",
            "verseOrgIds": [
              "JER.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutwalamu abalumukili cheŋi, hiyakufuntisha cheŋi, anduŋu jawu amayala nawambanda ombiluwu, hiyakuyiŋŋa cheŋi muwuduŋu, ekali cheŋi anduŋu jawu amayala nawambanda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.11",
            "verseOrgIds": [
              "JER.34.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.11",
            "verseOrgIds": [
              "JER.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi izu daYehova hidikufuma kudi Yehova, hidikwinza kudi Yeremiya, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.12",
            "verseOrgIds": [
              "JER.34.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Yehova Nzambi yaIsarela nahoshi nindi, Ami natiyaŋeni chitiyaŋenu nawankakulula jenu, ifuku dinayifumishili mwituŋa daEjipitu mwitala dawuduŋu, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.13",
            "verseOrgIds": [
              "JER.34.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nami, Hakukumishaŋa nyaka yitanu nayiyedi, wejima wenu mwakayumbaŋaku ana kwenu aHeberu anayilandishuwu, anayikalakeli dehi nyaka yitanu nawumu, mwakayumbaŋaku, akafumi kudenu chakubula wuduŋu. Ilaŋa nkakulula jenu hiyatiyililili kudamuku, hela kuteŋelekaku matu awu nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.14",
            "verseOrgIds": [
              "JER.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelu munabalumuki dehi, muneli dehi chaloŋa kumesu ami, chimuneli dehi wejima wenu himukubidika akwenu jakulekesha wuduŋu. Munatiyaloŋani dehi chitiyaŋenu kumesu ami, mwitala datenenawu ijina dami. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.15",
            "verseOrgIds": [
              "JER.34.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu himukubalumuka nawa cheni, himukutamisha ijina dami, wejima wenu himukufuntisha anduŋu jenu amayala nawambanda imwombili, kulonda eli mwaya nyichima yawu; himukufunta nakuyiŋŋa cheŋi muwuduŋu, kulonda ekali cheŋi anduŋu jenu amayala nawambanda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.16",
            "verseOrgIds": [
              "JER.34.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
