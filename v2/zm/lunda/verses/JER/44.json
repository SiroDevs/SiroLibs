        "sid": "JER 44"
      },
      "items": [
        {
          "text": "44",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 44:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izu dakutena aYudeya ejima ashakamini mwituŋa daEjipitu, niashakamini kuMigidoli, nikuTapanesi nikuNofwi, nimwituŋa daPatirosi, denjili kudi. Yeremiya, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.1",
            "verseOrgIds": [
              "JER.44.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 44:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Yehova wamazaza, Nzambi yaIsarela, nahoshi nindi, Munamoni kutama kwejima kunaleteli Yerusalema, ninyikala yawaYuda yejima. Talenu, lelu aneli dehi kwayihembi, himwashakama antuku, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.2",
            "verseOrgIds": [
              "JER.44.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 44:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "muloŋa wakutama kwawu kwakoŋeluwu kwakunvuloka nizuwi, nachina chayiluwu nakwocha insensi, nakupesha akishi abulili kwiluka hela wena, hela enu, hela ankakulula jenu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.3",
            "verseOrgIds": [
              "JER.44.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 44:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela chochu, ami nayitemeshelelaŋa ambuŋami atuprofwetu ejima, chakumenekaŋa budidi nakuyitemeshela, nami, Nayilembeli, bayi mwila ichi chishimashima chinabula kukeŋaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.4",
            "verseOrgIds": [
              "JER.44.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 44:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa wena kutiyilila nehi, hela kuteŋelekaku itu dawu ashiyi kutama kwawu kwakwochela akishi insensi, nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.5",
            "verseOrgIds": [
              "JER.44.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 44:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dihu hafumini kwichila kulendumuka kwami nikuzuwa kwami, hikukubutuka munyikala yawaYuda, nimunyikwakwa yamuYerusalema munashali kwayihembi hohu, munamweni dehi zo-o neyi chimudi lelu idi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.6",
            "verseOrgIds": [
              "JER.44.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 44:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi dinu Yehova, Nzambi wamazaza, Nzambi yaIsarela, nahoshi nindi, Mudi nakukogeladi kutama iku kweneni kwakuditamisha enu aweni, kwakufumisha mukachi kenu niiyala, nimumbanda, nimwana nimukwakwamwa, abuli kwikala muYuda, mushali chakadi muntu, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.7",
            "verseOrgIds": [
              "JER.44.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 44:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "nanochu chimukunvuloka nizuwi nanyidimu yakumakasenu yakwochela akishi insensi mwituŋa daEjipitu, kumunayi nakushakama. Mwaka mudifumishumu tuhu, mwikali ashigewa, asawuka mukachi kanyuza yejima yaheseki? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.8",
            "verseOrgIds": [
              "JER.44.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 44:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komana munavulameni dehi kutama kwawankakulula jenu, nikutama kwawanyanta awaYuda, nikutama kwawaŋodi jawu, nikutama kwenwenu aweni, nikutama kwawaŋodi jenu kwakogeluwu mwituŋa daEjipitu, nimunyikwakwa yamuYerusalema, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.9",
            "verseOrgIds": [
              "JER.44.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 44:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nilelu saŋa abuli lawu kudizoza, hela kutiya woma, hela kwenda mwaya nshimbi jami, hela mwaya yidika yami yinayishilili kumesu enu, nikumesu awankakulula jenu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.10",
            "verseOrgIds": [
              "JER.44.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 44:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.10",
            "verseOrgIds": [
              "JER.44.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 44:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Yehova wamazaza, Nzambi yaIsarela, nindi, Tiyenu, nakayitala mesu akuhila kulonda kuyitamisha, kulonda kufumishahu aYuda ejima. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.11",
            "verseOrgIds": [
              "JER.44.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 44:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukutambula aYuda anashaluku, anati mesu awu akuya mwituŋa daEjipitu nakushakamaku, wejima wawu akanoŋa zo. Akadimbukila mwituŋa daEjipitu. Akanoŋa nampoku yakabali ninzala. Akafwa nampoku yakabali ninzala, kufumisha kudi wakadi kulema kushika nikudi wasweja kulema. Akekala ashigewa, akuhayama, eshiŋu, asawuka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.12",
            "verseOrgIds": [
              "JER.44.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 44:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.12",
            "verseOrgIds": [
              "JER.44.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 44:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakayibabesha ashakama mwituŋa daEjipitu neyi chinababeshi Yerusalema nampoku yakabali, nanzala, nachipupu, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.13",
            "verseOrgIds": [
              "JER.44.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 44:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulonda aYuda anashaluku, anayi nakushakama mwituŋa daEjipitu, hakabuli kumwekana niwumu wakapuluka hela kushalaku, mwaka akamoni kufunta mwituŋa daYuda, kwashiluwu muchima nawu twakafunta nakushakamaku. Muloŋa kwosi wakafuntaku, chiŋa yowu wakapuluka chakupuluka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.14",
            "verseOrgIds": [
              "JER.44.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 44:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.14",
            "verseOrgIds": [
              "JER.44.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 44:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu amayala ejima elukili nawu aŋodi jawu adi nakwochela akishi insensi, niambanda ejima emenuku, chipompelu chacheni, kafwampi antu ejima ashakamini muPatirosi mwituŋa daEjipitu, hiyakumwakula Yeremiya, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.15",
            "verseOrgIds": [
              "JER.44.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 44:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nawu, Izu diwunahoshi nanetu mwijina daYehova, etu kwetu hitukukutiyaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.16",
            "verseOrgIds": [
              "JER.44.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 44:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazu ejima anafumi namutunwa twetu akumwochela mwantawamumbanda wamwiwulu insensi, niakumuhuŋunwina nyilambu yakuhuŋununa, mutwelaŋa ninetu, niankakulula jetu, niatulamba twetu, nimunyikala yawaYuda, nimunyikwakwa yamuYerusalema, tukwilamu hohu chalala, muloŋa chitwelilaŋa ochu twamwenaŋa kudya kwakuvulu, twashakaminaŋa chachiwahi, hitwamwenaŋa chuma chatamaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.17",
            "verseOrgIds": [
              "JER.44.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 44:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa kufumisha hitwalekeli kumwochela mwanta wamumbanda wamwiwulu insensi, nikumuhuŋunwina nyilambu yakuhuŋununa, tunabuli yuma yejima, tunanoŋi nampoku yakabali nanzala. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.18",
            "verseOrgIds": [
              "JER.44.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 44:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ochu chitwamwochelelaŋa mwanta wamumbanda wamwiwulu insensi, chitwamuhuŋunwinaŋa nyilambu yetu yakuhuŋununa, komana twanamutuŋililaŋa mankendi akumujilokela nachu, twamuhuŋunwinaŋa nyilambu yetu yakuhuŋununa chakadi anfumu jetu, tahindi?",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.19",
            "verseOrgIds": [
              "JER.44.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 44:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.19",
            "verseOrgIds": [
              "JER.44.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 44:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeremiya hakuyakula antu ejima, wowu amayala nawambanda, kafwampi antu ejima amwakwili mwenomu, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.20",
            "verseOrgIds": [
              "JER.44.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 44:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Oyu insensi yimwochelaŋa munyikala yawaYuda, nimunyikwakwa yamuYerusalema, ninenu, niankakulula jenu, nianyanta jenu, niatulamba twenu, niantu amwituŋa, Yehova hayanukiluku? Hiyenjili kumnchima winduku? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.21",
            "verseOrgIds": [
              "JER.44.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 44:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaka Yehova akaŋanyi kudi wundisha nayatama yimwelilaŋa, nayishimashima yimwakogeli. Dihu hanafumi niituna denu kubalumuka kwayihembi hohu, dakuhayama, deshiŋu, dakadi antu, neyi chididi lelu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.22",
            "verseOrgIds": [
              "JER.44.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 44:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimunochi insensi, nichimunamuvulumuni Yehova, nichimunabuli kwovwahila izu daYehova, hela kwenda mwaya nshimbi jindi, hela mwaya yidika yindi, hela mwaya wunsahu windi, dichi chimunamoni yuma yatamiyi yimukumona lelu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.23",
            "verseOrgIds": [
              "JER.44.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 44:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.23",
            "verseOrgIds": [
              "JER.44.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 44:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeremiya hakuyila cheŋi antu ejima niambanda ejima, nindi, Enu aYuda ejima mudi mwituŋa daEjipitu, tiyenu izu daYehova; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.24",
            "verseOrgIds": [
              "JER.44.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 44:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wamazaza, Nzambi yaIsarsla, nahoshi nindi, Ninenu, niaŋodi jenu muneli nikuhosha natunwa twenu, nikukoŋamu namakasenu, nenu, Chalala hohu twakakoŋa mutwadishiilili mwakumwochela mwanta wamumbanda wamwiwulu insensi, nimwakumuhuŋunwina nyilambu yetu yakuhuŋununa. Komana koleshenu mumwadishiilili, mukoŋi mumwadishiilili. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.25",
            "verseOrgIds": [
              "JER.44.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 44:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu enu aYuda ejima mwashakama mwituŋa daEjipitu, tiyenu izu daYehova. Yehova nindi, Tiyenu, ami nasanyiki dehi ijina dami deneni, nami, Mwahita ituŋa daEjipitu dejima, ijina dami dakutena nawu, Chahandayi Mwanta Yehova kwaamu; hiyakuditena cheŋi mukanwa kakaYuda niwumuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.26",
            "verseOrgIds": [
              "JER.44.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 44:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyenu, nakayiimena kwimana kwakuyitamisha, bayi kwakuyiwahishaku. NiaYuda ejima adi mwituŋa daEjipitu akanoŋa nampoku yakabali nanzala, nichakamanawu to-o. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.27",
            "verseOrgIds": [
              "JER.44.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 44:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu akapuluka kumpoku yakabali akafuma mwituŋa daEjipitu, akafunta cheŋi mwituŋa daYuda, akekala antesha hohu. NiaYuda anashali ejima, anayi mwituŋa daEjipitu nakushakamaku, akeluka izu dakakola danyi, dami tahindi dawena? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.28",
            "verseOrgIds": [
              "JER.44.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 44:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nindi, Kubabesha kunakayibabesha mwenamunu dichinjikijilu chenu, chimwakeluka nachu nenu chalala mazu ami akayikolela chakuyitamisha. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.29",
            "verseOrgIds": [
              "JER.44.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 44:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nindi, Tiyenu, mwanta wakuEjipitu Fwaro Hofwira nakamuhana kudi ayilumbu jindi, nikudi antu anakeŋi kumujaha, neyi chinaheni mwanta wawaYuda Zedekiya kudi mwanta wakuBabiloni Nebukaneza, yowu chilumbu chindi wakeŋa eli kumujaha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.30",
            "verseOrgIds": [
              "JER.44.30"
            ]
          }
        }
      ]
    }
