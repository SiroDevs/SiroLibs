      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatachikili wanta waYehoyakimi mwana kaYosiya, mwanta wawa Yuda, kwenjili izu dakufuma kudi Yehova, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.1",
            "verseOrgIds": [
              "JER.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "dakwila nindi, Yehova nahoshi nindi, Imanaku muchipaŋu chakwitala daYehova, wakahoshi nawakwanyikala yawaYuda yejima yenzaŋa nakudifukwila mwitala daYehova, mazu ejima inakakuleja kuhosha kudi wena, bayi wakasweka izu nidimuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.2",
            "verseOrgIds": [
              "JER.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamba kela akatiyilila, akabalumuka, iwu nakushiya njila yindi yatama, iwu nakushiya njila yindi yatama, kulonda nakabalumuki nakaleki kunafuukula kuyikoŋa nayuma yatama yelaŋawu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.3",
            "verseOrgIds": [
              "JER.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakayila neyi, Yehova nahoshi nindi, Neyi mwakatiyilila kudami nakwenda munshimbi jami jinashili kumesu enu, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.4",
            "verseOrgIds": [
              "JER.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nakutiyilila mumazu awambuŋami atuprofwetu inayitemeshelaŋa, chakumenekaŋa budidi nakuyitemeshela, ilaŋa enu kwenu kutiyililaŋa nehi; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.5",
            "verseOrgIds": [
              "JER.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ami kwami nakabalumuna italidi kwikala neyi Shilo, nakabalumuna mukaliwu kwikala ishiŋu kudi nyuza yejima yaheseki. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.6",
            "verseOrgIds": [
              "JER.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niatupristu, niatuprofwetu, niantu ejima atiyili chakuhoshayi Yeremiya mazu awa mwitala daYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.7",
            "verseOrgIds": [
              "JER.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cheliliyi Yeremiya nakumishi dehi kuhosha mazu ejima amulejeliyi Yehova kuhosha nawantu ejima, atupristu niatuprofwetu niantu ejima hiyakumukwata, nawu, Eyi chiŋa wufwa hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.8",
            "verseOrgIds": [
              "JER.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indi eyi wunaprofwetelidi mwijina daYehova neyi, Italidi dakekala neyi Shilo, nimukaliwu wakekala kwachihembi chakadi antu? Antu ejima hiyakumupompela Yeremiya mwitala daYehova.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.9",
            "verseOrgIds": [
              "JER.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.9",
            "verseOrgIds": [
              "JER.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atulamba twawaYuda chiyatiyiluwu yumiyi, hiyakufuma kwitala damwanta, hiyakukankalala kwitala daYehova. Hiyakushakama muwiŋililu wakuchisu chachiha chakuchipaŋu chakwitala daYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.10",
            "verseOrgIds": [
              "JER.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atupristu nawatuprofwetu hiyakuhosha nawatulamba nawantu ejima, nawu, Muntu iwu nateli kufwa; muloŋa yena naprofweti dehi chakuzuwila mukaliwu mwomu mumunatiyi namatu enwenu aweni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.11",
            "verseOrgIds": [
              "JER.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Yeremiya hakuyila atulamba ejima niantu ejima, nindi, Yehova diyi wantemesheli nakaprofweti chakuzuwila italidi nimukaliwu, namazu ejima imunatiyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.12",
            "verseOrgIds": [
              "JER.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu wahishenu njila jenu niyimwelaŋa, mwovwahili izu daYehova Nzambi yenu, niyena Yehova wakabalumuka mumuchima wakaleka katama kanayiteneniyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.13",
            "verseOrgIds": [
              "JER.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwila ami, yamonu nidi kumakasenu; ŋilenu mwejima mumunamoni kuwaha nikuloŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.14",
            "verseOrgIds": [
              "JER.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa ilukenu chalala chikupu nenu, neyi mwakanjaha mwakadikojeja mashi akadi muloŋa ninenu, nimukaliwu, niantu ashakamamu. Chalala chi, Yehova diyi nantemeshi kudenu nakahoshi mazu awa ejima kumatu enu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.15",
            "verseOrgIds": [
              "JER.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atulamba nawantu ejima hiyakuhosha nawatupristu nawatuprofwetu, nawu, Muntu iwu hanateli kufwaku. Mulopa yena nahoshi nanetu mwijina daYehova Nzambi yetu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.16",
            "verseOrgIds": [
              "JER.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hikukunyamuka awakulumpi amakwawu amwituŋa, hiyakuhosha nachipompelu chawantuchejima, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.17",
            "verseOrgIds": [
              "JER.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "nawu, Mikaya waku Moresheti waprofweteli hamafuku adiŋiyi mwanta wawaYuda Hezekiya. Wahosheli nawantu amuYuda ejima, nindi, Yehova wamazaza nahoshi nindi, Ziyona akamudima nyihaŋaneyi chikweha, Yerusalema wakabalumuka kwanyilumba nyilumba, mpidi yetala yakabalumuka neyi yinaŋanaŋa yamwisaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.18",
            "verseOrgIds": [
              "JER.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wawaYuda Hezekiya nawaYuda ejima amujahili? Hatiyili woma waYehovaku? Halembeleli nindi amoni wuselewa waYehovaku? Yehova habalumukili mumuchima, aleka katama kayiteneneniyuku? Neyi etu tukwila mwenimu tukudikokela kutama kwasweja.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.19",
            "verseOrgIds": [
              "JER.26.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.19",
            "verseOrgIds": [
              "JER.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwadiŋi nawa muntu waprofweteli mwijina daYehova, yowu mwana kaShemaya Uriya wakuKiriyati Yeyarimi, niyena waprofweteli chakuzuwila mukaliwu niituŋidi mwomunayi mazu aYeremiya ejima. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.20",
            "verseOrgIds": [
              "JER.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta Yehoyakimi nawayilobu jindi ejima, niatulamba ejima, chatiyiluwu mazu indi, mwanta wakegeli kumujaha. Ilaŋa chachitiyili Uriya watiyili woma, hakutemuka lufuchi, hakuya muEjipitu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.21",
            "verseOrgIds": [
              "JER.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta Yehoyakimi hakutemesha antu muEjipitu, antu atemesheliyi muEjipitu wowu aElinatani mwana kaAkibori nawantu amakwawu ayiliyi nawu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.22",
            "verseOrgIds": [
              "JER.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amufumishili Uriya muEjipitu, amuleteli kudi mwanta Yehoyakimi. Yena wamujahili nampoku yakabali, anatili mujimba windi mumajamu awantu amukunkulwayi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.23",
            "verseOrgIds": [
              "JER.26.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.23",
            "verseOrgIds": [
              "JER.26.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa chikasa chamwana kaShafwani Ahikami chakumini kudi Yeremiya, kulonda akabuli kumuhana kudi antu mwaka amujahi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.24",
            "verseOrgIds": [
              "JER.26.24"
            ]
          }
        }
      ]
    }
