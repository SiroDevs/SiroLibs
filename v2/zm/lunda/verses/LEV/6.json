              "LEV.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wahosheli naMosi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.24",
            "verseOrgIds": [
              "LEV.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Hoshaku naAroni nawanyanindi, neyi, Tiyenu lushimbi lwamulambu wahanshidi; kwoku kwajahilaŋawuhimulambu wakushita diku kwamujahilaŋawu Yehova himulambu wahanshidi, wajila nankashi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.25",
            "verseOrgIds": [
              "LEV.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akawidyi kudi kapristu wakawulambwila nshidi; akawudiili mwajila, mwomu muchipaŋu chetenti dakubulakena. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.26",
            "verseOrgIds": [
              "LEV.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakakunkakumbiji yawu nekali dehi wajila; neyi mashi anasampukili hehina, ihina dinasampukili mashi akadikoseli kwajila. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.27",
            "verseOrgIds": [
              "LEV.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwinza inuŋu yawumba yatelekawu akayi fumpi; neyi ateleka mwinuŋu yawuneŋu chiŋa akayikoola nakuyikosolola nameji. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.28",
            "verseOrgIds": [
              "LEV.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amayala ejima ahadi atupristu diwu akawidyaŋa; wajila nankashi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.29",
            "verseOrgIds": [
              "LEV.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 6:30"
          },
          "items": [
            {
