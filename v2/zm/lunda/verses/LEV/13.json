          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi nsuki jindi jikuhuluka kunamutu windi kumesu, wukweti ibala dakwihama, natooki. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.41",
            "verseOrgIds": [
              "LEV.13.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 13:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa neyi mwibala dakunamutu, indi kwiji mwibala dakwihama, mudi musopu iku neyi wuchinana iku neyi wutooka, himbumbayinedikili mwibala dakunamutu windi, indi kwiji mwibala dakwihama dindi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.42",
            "verseOrgIds": [
              "LEV.13.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 13:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu kapristu akamutali; neyi wukumona mwibala dakunamutu windi, indi kwiji mwibala dakwihama dindi, munanani musoŋu iku neyi wuchinanaiku neyi wutooka, wunamwekani mwikowa damujimba neyi mbumba, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.43",
            "verseOrgIds": [
              "LEV.13.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 13:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "himukwambumba, wamajilu. Chalala kapristu akamuteni nindi wamajilu, musoŋu windi wudi kunamutu windi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.44",
            "verseOrgIds": [
              "LEV.13.44"
            ]
          }
        }
      ]
