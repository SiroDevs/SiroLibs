            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela iyala hela mumbanda neyi mwikowa damujimba windi mudimabeŋa atokoloka, kafwampi mabeŋa atooka, akejima, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.38",
