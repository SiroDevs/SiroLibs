          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "neyi musoŋuwuna mwekani neyi meji amatamba, indi kwiji neyi wuchinanaku chanti, hela mwihina hela muchitembi, hela munjila yehina hela munketula, helamuchitembi chakutuŋa chuma, himusoŋu wambumba, chiŋa akamuleja kapristu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.49",
            "verseOrgIds": [
              "LEV.13.49"
            ]
          }
