            "sid": "LEV 13:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapristu akatali hamusoŋu, chuma chi kweti musoŋu akachenzeleli mwitala mafuku atanu nayedi; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.50",
            "verseOrgIds": [
              "LEV.13.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LEV 13:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "hefuku damu chitanu nachiyedi akatali hamusoŋu; neyi wakamona musopu wudi nakuya nakuswila mwihina dakuvwala, hela munjila yehina hela munketula, hela muchitembi chonsu chanatuŋuwu nachu chochu; himusoŋu wambumba yasumana, wamajilu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.51",
            "verseOrgIds": [
              "LEV.13.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LEV 13:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akochi ihina dakuvwala bwi-i, hela njila hela nketula, hela yehina dawuvuji, hela yehina dawanda, hela chitembi chakutuŋa chuma, yejima yikweti musoŋu, muloŋa himbumba yasumana; akayochi mukesi bwi-i.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.52",
            "verseOrgIds": [
              "LEV.13.52"
            ]
          }
        }
      ]
