          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niihina dakuvwala nawa neyi dikweti musoŋu wambumba, hela hiihinadawuvuji, hela hiihina dawanda, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.47",
            "verseOrgIds": [
              "LEV.13.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LEV 13:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "neyi wudi munjila yehina hela munketula, hela yehina dawanda, hela yehina dawuvuji, hela wudi muchitembichacheni, hela wudi muchitembi chakutuŋa chuma; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.48",
            "verseOrgIds": [
              "LEV.13.48"
            ]
          }
        },
        {
