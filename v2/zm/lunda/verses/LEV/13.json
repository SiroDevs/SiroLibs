          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "henohu kapristu akayileji akakosi chuma chi kweti musoŋu, akachenzeleli cheŋi mwitala mafuku atanu nayedi; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.54",
