            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 13:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "henohu kapristu akataluhu; neyi wakamona mabeŋa atokoloka adi mwikowa damuji mbawindi hiyakutooka chanti, hiihuji tuhu, dinediki mwikowa; natooki.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.39",
            "verseOrgIds": [
              "LEV.13.39"
            ]
          }
        }
