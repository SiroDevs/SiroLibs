          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi nsuki jamuntu jikuhuluka kunamutu windi, wukweti ibala, natooki. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.40",
            "verseOrgIds": [
              "LEV.13.40"
            ]
          }
        },
        {
