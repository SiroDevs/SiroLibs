          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela iyala hela mumbanda neyi wukweti musopu hela kunamutu helakuwevu, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.29",
            "verseOrgIds": [
              "LEV.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "henohu kapristu akatali musoŋu. Neyi wakamona wunamwekanineyi wunahanuki mwikowa, himudi lusuki lwapepela luchinana, henohu kapristu akamuteni nindi wamajilu, hiiyaji, himbumba hela yakunamutu hela yakuwevu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.30",
            "verseOrgIds": [
              "LEV.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi kapristu wakatala hamusoriu weyaji, neyi wakamonawuna mwekani neyi hiwunahanuki hekowaku, mwosi ninsuki jiyilaku, henohu kapristu akamwenzeleli mukwamusoŋu weyaji mwitala mafuku atanu nayedi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.31",
            "verseOrgIds": [
              "LEV.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hefuku damu chitanu nachiyedi kapristu akatali musoŋu, neyi wakamona iyaji dinabuli kuswila, mwosi nilusuki luchinana, niiyajihidikumwekana neyi dinabuli kuhanuka mwikowa, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.32",
            "verseOrgIds": [
              "LEV.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "akamutewuli, ilaŋayaji bayi akaditewulaku; kapristu akamwenzeleli cheŋi mukweyaji mwitala mafuku amakwawu atanu nayedi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.33",
            "verseOrgIds": [
              "LEV.13.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hefuku damu chitanu nachiyedi kapristu akatali cheŋi heyaji, neyi wakamona iyaji dinabuli kuswila mwikowa, hidikumwekana neyi dinabuli kuhanuka mwikowa, henohu kapristu akamuteni nindi natooki. Akakosi mahinindi, akatooki. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.34",
            "verseOrgIds": [
              "LEV.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa neyinatooki dehi, nkumininaku iyaji hidikuya nakuswila cheŋi mwikowa, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.35",
            "verseOrgIds": [
              "LEV.13.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "kapristu akamutali; neyi wakamona iyaji dinaswili mwikowa, kapristubayi akakeŋakeŋa lusuki luchinanaku, wamajilu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.36",
            "verseOrgIds": [
              "LEV.13.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa neyi wakamonaiyaji dinemani hamu, muna meni ninsuki jiyila, iyaji dinakusuki, natooki; kapristu akamuteni nindi natooki.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.37",
            "verseOrgIds": [
              "LEV.13.37"
            ]
          }
        }
      ]
