          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi mwakadishima nayuma yakuzalala yazalalaŋaku, hela kudilisha amajilu, bayi mudilisha nawu amajiluku mwakenza kaditamisha nawu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.43",
            "verseOrgIds": [
              "LEV.11.43"
            ]
          }
        },
        {
          "name": "verse",
