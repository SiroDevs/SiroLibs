              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi kanyama kimwadyaŋa kakadifwila, yowu wakakunka wafwa dehi akekali wamajilu hohu nikumelela. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.39",
