          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela akwendela hamavumu, hela akwendela kumakasa nanyendu, hela akweti nyendu yayivulu kafwampi ayuma ejima akuzalala azalalaŋa hamaseki, bayi mwakayidyaku muloria akushimana kwawu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.42",
            "verseOrgIds": [
              "LEV.11.42"
            ]
          }
        },
        {
