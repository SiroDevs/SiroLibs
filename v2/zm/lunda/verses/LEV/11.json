          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa yami Yehova nayifumishili mwituŋa daEjipituniikali Nzambi yenu; dichi dinu chiŋa mwakekalaŋa ajila, muloŋa ami najila.",
          "type": "text",
