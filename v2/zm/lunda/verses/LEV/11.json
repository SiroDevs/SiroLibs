          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋaami yami Yehova Nzambi yenu, dichi dijilikenu mwikali ajila; muloŋa ami najila; bayi mwakaditamisha nachuma hichuma chazalalaŋa chikwenda hamasekuku. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.44",
            "verseOrgIds": [
              "LEV.11.44"
            ]
          }
        },
        {
