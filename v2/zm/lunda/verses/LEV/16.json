          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "muloŋa denodu ifuku odu didudakayililawu yakuyibuta nachu kulonda kuyitookesha, mwakatooki nshidŋenu jejima kumesu aYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.30",
            "verseOrgIds": [
              "LEV.16.30"
            ]
          }
        },
        {
          "name": "verse",
