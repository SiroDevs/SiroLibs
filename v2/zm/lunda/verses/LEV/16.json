          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hisabata yenu yakunooka kwakudihudika, mwakadikabishaŋa munyichima yenu, hichidika chahaya nyaka.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.31",
            "verseOrgIds": [
              "LEV.16.31"
            ]
