              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapristu akawayishawu manji, akakunjikawu kwikala kapristu mumatu watata yindi, diyi wakela yakubuta nachu, diyi wakavwala mahina awandawawuwahi, wowu mahina ajila; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.32",
