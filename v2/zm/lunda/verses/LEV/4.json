    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wahosheli naMosi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.1",
            "verseOrgIds": [
              "LEV.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Hoshaku nawanyana kaIsarela, neyi, Neyi hakekala muntu wakavulumuna chakuluwukila, nakoŋichuma chanalekeshiyi Yehova nindi chinjila kuchila; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.2",
            "verseOrgIds": [
              "LEV.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "hela kapristu awayishawu dehi manji wakavulumuna chakuyikokela antu kutanya, oyunshidi yindi yakavulumunayi akalambuli Yehova iyoŋa daŋombi weyalawakadi hataminayi wamulambu wahanshidi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.3",
            "verseOrgIds": [
              "LEV.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaleti ŋombi kuchisuchetenti dakubulakena kumesu aYehova, akanaŋiki chikasa chindi hanamutuwaŋombi, oyu ŋombi akamujahili kumesu aYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.4",
            "verseOrgIds": [
              "LEV.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapristu awayishawu dehi manji hamashi aŋombi akanonuhu amu, akayileti mwitenti dakubulakena. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.5",
            "verseOrgIds": [
              "LEV.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapristu akatumpiki munu windi mumashi, akasampulimashi kwatala Yehova mapampa katanu nakayedi, kumesu ehina dakujikakumalala. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.6",
            "verseOrgIds": [
              "LEV.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapristu akaloombi mashi amakwawu kunseŋu jakameŋaka insensi yevumba dadiwahi kumesu aYehova, kokameŋa kekala mwitenti dakubulakena, mashi aŋombi anashali ejima akayimwaŋili kwishina dakameŋaka himulambu wakushita, kekala kuchisu chetenti dakubulakena. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.7",
            "verseOrgIds": [
              "LEV.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manji aŋombi wamulambu wahanshidi akayifumishuhu ejima, nimanji ajikaŋa hayuma yamwivumu, nimanji ekala kunyijiŋwa ejima, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.8",
            "verseOrgIds": [
              "LEV.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ninshiyamujiyedi, nimanji aju ekala kumasweswa, nichibutamuchima, akayalwili kumu nanshiya, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.9",
            "verseOrgIds": [
              "LEV.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwomu mwafumishilaŋawu kuŋombi wakuketula wanyilambu yakuwunda, kapristu akayishiti bwi-i hakameŋa kahimulambu wakushita. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.10",
            "verseOrgIds": [
              "LEV.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chitembi chaŋombi nimbiji yindi yejima, ninamutu windi, ninyendu yindi, nimakasindi hamu, niyuma yindi yamwivumu, niwufwachi windi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.11",
            "verseOrgIds": [
              "LEV.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kafwampi ŋombi wejima mwakumayi, akamutwali kunsa yachilombu kutooka kwasukwilaŋawu mawuti, akamwochi nakesi hanchawa, akamwochela kwasukwilaŋawu mawuti.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.12",
            "verseOrgIds": [
              "LEV.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.12",
            "verseOrgIds": [
              "LEV.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi chipompelu chaIsarela chejima chakaluwa, chipompelu kwilukachuma chaneluwu nehi, anakoŋi chuma chalekesheliyi Yehova nindi chinjilakuchila, anatanyi dehi; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.13",
            "verseOrgIds": [
              "LEV.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "neyi aneluki dehi nshidi oyu yanavulumunuwu, chipompelu chakalambuli iyoŋa daŋombi weyala wamulambu wahanshidi, akamuleti kumesu etenti dakubulakena. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.14",
            "verseOrgIds": [
              "LEV.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akulumpi achipompelu akanaŋiki makasawu hanamutu waŋombi kumesu aYehova, ŋombi akamuja hilikumesu aYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.15",
            "verseOrgIds": [
              "LEV.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapristu awayishawu dehi manji akaleti mashiaŋombi kwitenti dakubulakena, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.16",
            "verseOrgIds": [
              "LEV.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kapristu akatumpiki munu windi mumashi, akayisampuli mapampa katanu nakayedi kwatala Yehova, kumesuehina dakujika mwajila. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.17",
            "verseOrgIds": [
              "LEV.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mashi amu akaloombi kunseŋu jakameŋa kekalakumesu aYehova, kekala mwitenti dakubulakena, mashi akashalahu ejima akayimwapili kwishina dakameŋa kahimulambu wakushita, kekala kuchisuchetenti dakubulakena. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.18",
            "verseOrgIds": [
              "LEV.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamufumishi manji indi ejima, akayishiti hakameŋabwi-i. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.19",
            "verseOrgIds": [
              "LEV.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋombi akamwili mwomweliliyi ŋombi wamulambu wahanshidi, dimu mwakelayi niyenowu nawa; kapristu akayilili yakubuta nachu, akayanakena. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.20",
            "verseOrgIds": [
              "LEV.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatwali ŋombi kunsa yachilombu, akamwochi neyichocheleliyi ŋombi wakusambila; hihimulambu wachipompelu wahanshidi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.21",
            "verseOrgIds": [
              "LEV.4.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.21",
            "verseOrgIds": [
              "LEV.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi nyuli navulumuni, naluwukili dehi chuma chimu chalekesheliyi Yehova Nzambi yindi nindi chinjila kuchila, natanyi dehi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.22",
            "verseOrgIds": [
              "LEV.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "neyi nshidiyindi yanavulumuniyi akamulejayu, akaleti himulambu windi wampembi, chizamba wakadi hataminayi; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.23",
            "verseOrgIds": [
              "LEV.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "akanaŋiki chikasa chindi hanamutu wampembi, akamujahili kwajahilaŋawu himulambu wakushita kumesu aYehova; hihimulambu wahanshidi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.24",
            "verseOrgIds": [
              "LEV.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamashi ahimulambu wahanshidi kapristu akanonuhu namunu windi, akaloombi kunsepu jakameŋa kahimulambu wakushita, mashi indi akayimwapili kwishina dakameŋa kahimulambu wakushita, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.25",
            "verseOrgIds": [
              "LEV.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "manji indi ejima akayishiti hakameŋa bwi-i neyi chashitapawu manji achimuna chakuketula chanyilambu yakuwunda, kapristu akamwilili yakubuta nachu hansaŋu yanshidi yindi, akamwanakena.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.26",
            "verseOrgIds": [
              "LEV.4.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.26",
            "verseOrgIds": [
              "LEV.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi muntu wamunyikala navulumuni chakuluwukila, naluwukili chuma chimu chalekesheliyi Yehova nindi chinjila kuchila, natanyi dehi; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.27",
            "verseOrgIds": [
              "LEV.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "neyi neluki dehi nshidi yindi yanavulumuniyi akamulejayu, akaleti mulambu windi wampembi, mukaji wakadi hataminayi, wanshidi yindi yanavulumuniyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.28",
            "verseOrgIds": [
              "LEV.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanaŋiki chikasa chindi hanamutu wamulambu wahanshidi, himulambu wahanshidi akawujahili kuwujahilu wamulambu wakushita. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.29",
            "verseOrgIds": [
              "LEV.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamashi indi kapristu akanonuhu namunu windi, akaloombi kunseŋujakameŋa kahimulambu wakushita, mashi indi ejima akayimwaŋili kwishina dakameŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.30",
            "verseOrgIds": [
              "LEV.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akafumishuku manji indi ejima neyi chafumishaŋawu manji achimuna chakuketula chanyilambu yakuwunda; kapristu akayishitili yehova hakameŋa bwi-i, yevumba dadiwahi; kapristu akamwilili yakubuta nachu, akamwanakena.",
          "type": "text",
