    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wahosheli naMosi naAroni, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.1",
            "verseOrgIds": [
              "LEV.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Hoshenu nawanyana kaIsarela, muyili nenu, Neyi kudi muntu wapwekaŋa kumujimba windi, neli dehi wamajilu nanochu chanapwekiyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.2",
            "verseOrgIds": [
              "LEV.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyenu mwakakwatilayi majilu omu mwakapwekelayi; neyi kumujimba windi kukupweka, hela neyi kumujimba windi kukujika nanochu chakupwekayi, nakwati dehi majilu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.3",
            "verseOrgIds": [
              "LEV.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tudidi twejima twakakamayi owu wapwekaŋa twakekali twamajilu; niyuma yakashakamayi yejima yakekali yamajilu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.4",
            "verseOrgIds": [
              "LEV.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu wakakunka kukadidi kindi, akakosi mahinindi, akaweli mumeji, akekali wamajilu hohunikumelela. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.5",
            "verseOrgIds": [
              "LEV.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu wakashakama hayuma yashakaminiyi owu wapwekaŋa, akakosi mahinindi, akaweli mumeji, akekali wamajilu hohu nikumelela. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.6",
            "verseOrgIds": [
              "LEV.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu wakakunka kumujimba wanowu wapwekaŋa, akakosi mahinindi, akaweli mumeji, akekali wamajilu hohu nikumelela. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.7",
            "verseOrgIds": [
              "LEV.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu wutookaneyi akumufwŋila mazeŋi kudi muntu wapwekaŋa, akakosi mahinindi, akaweli mumeji, akekali wamajilu hohu nikumelela. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.8",
            "verseOrgIds": [
              "LEV.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nisadi yakendelayi owu wapwekaŋa yakeli yamajilu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.9",
            "verseOrgIds": [
              "LEV.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu wakakunka kuchuma chadiŋikwishina dindi akekali wamajilu hohu nikumelela, niwakasenda yumoyu akakosi mahinindi, akaweli mumeji, akekali wamajilu hohu nikumelela. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.10",
            "verseOrgIds": [
              "LEV.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowu akakunkawu kudi mukwakupwekesha nabuli kwisuka kumakasindi mumeji, akakosi mahinindi, akaweli mumeji, akekali wamajilu hohunikumelela. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.11",
            "verseOrgIds": [
              "LEV.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nichuma chewumba chakakunkayi mukwakupwekesha akachi fumpi, hakwila yuma yanyitondu yejima akayikosololi mumeji.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.12",
            "verseOrgIds": [
              "LEV.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.12",
            "verseOrgIds": [
              "LEV.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wapwekaŋa, neyi natooki dehi nanochu chapwekelapayi, akachindi mafuku indi atanu nayedi akutooka nachu, akakosi mahinindi, akawelimu meji adi nakuhita, akatooki. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.13",
            "verseOrgIds": [
              "LEV.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hefuku damu chitanu nachisatu akadikwatili tutela tuyedi, hela anyana katupompa ayedi, akenzi kumesu aYehova kuchisu chetenti dakubulakena, akayinki kapristu; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.14",
            "verseOrgIds": [
              "LEV.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kapristu akayilambuli, wumu wamulambu wahanshidi, mukwawu wamulambu wakushita; kapristu akamwilili yakumubuta nachu kumesu aYehova nanochu chanapwekiyi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.15",
            "verseOrgIds": [
              "LEV.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.15",
            "verseOrgIds": [
              "LEV.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi kwakamwekana iyala wakalota kamwadi akaweli mujimba wejimamumeji, akekali wamajilu hohu nikumelela. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.16",
            "verseOrgIds": [
              "LEV.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimahina akuvwala ejima, niyitembi yejima yikweti mbutu yalusemu, akayikosi mumeji, yakekali yamajilu hohu nikumelela. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.17",
            "verseOrgIds": [
              "LEV.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimumbanda nakami neyala wudi nambutuyalusemu nawa chochu, wejima wawu mwayedi wawu akaweli mumeji, akekali amajilu hohu nikumelela.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.18",
            "verseOrgIds": [
              "LEV.15.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.18",
            "verseOrgIds": [
              "LEV.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi kudi mumbanda wapwekaŋa, chakupwekayi kumujimba windihakupweka mashi, akayi kwitala di kwawu mafuku atanu nayedi; muntuwakamukunka akekali wamajilu hohu nikumelela. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.19",
            "verseOrgIds": [
              "LEV.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuma yejima yakakamayi hakekalayi kwitala di kwawu yakeli yamajilu, niyuma yakashakamayi yejima yakeli yamajilu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.20",
            "verseOrgIds": [
              "LEV.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu wakakunka kadidi kindi akakosi mahinindi, akaweli mumeji, akekali wamajilu hohu nikumelela. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.21",
            "verseOrgIds": [
              "LEV.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu wakakunka kuchuma chakashakamayi akakosi mahinindi, akaweli mumeji, akekali wamajilu hohu nikumelela. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.22",
            "verseOrgIds": [
              "LEV.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi muntu wakakunka hela chuma chahakadidi, hela chuma chanashakamiyi, akekali wamajilu hohu nikumelela. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.23",
            "verseOrgIds": [
              "LEV.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi iyala wakakama nindi, nikanyanda kindi kakekala hadi iyala, akekali wamajilu mafuku atanu nayedi, nitudidi twakakamayi twejima twakelitwamajilu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.24",
            "verseOrgIds": [
              "LEV.15.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.24",
            "verseOrgIds": [
              "LEV.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi kudi mumbanda wapwekaŋa mashi indi mafuku amavulu habulilaŋakuyayi kwitala di kwawu, hela neyi wapwekapa nakupandakesha hayilaŋayi kwitala di kwawu, mafuku ejima akupwekapayi akwikalayi wamajiluakekali neyi mafuku indi ayaŋayi kwitala di kwawu, akeli kwindi wamajilu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.25",
            "verseOrgIds": [
              "LEV.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tudidi twakamaŋayi mafuku ejima apwekaŋayi twakekali neyi kadidikindi kakamaŋayi hayaŋayi kwitala di kwawu; niyashakamaŋayi yejima yakeli yamajilu, neyi chivelaŋa hayaŋayi kwitala di kwawu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.26",
            "verseOrgIds": [
              "LEV.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu wakakunka yumoyu akeli wamajilu, akakosi mahinindi, akaweli mumeji, akekali wamajilu hohu nikumelela. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.27",
            "verseOrgIds": [
              "LEV.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi nakumishi dehi kupweka, akachindi mafuku indi atanu nayedi, akatooki. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.28",
            "verseOrgIds": [
              "LEV.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hefuku damuchitanu nachisatu akadikwatili tutela tuyedi, hela anyana katupompa ayedi, akayileti kudi kapristu kuchisu chetenti dakubulakena. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.29",
            "verseOrgIds": [
              "LEV.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
