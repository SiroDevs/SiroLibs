          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimwakaaŋulaŋa yakudya yamwituŋa denu bayi wakaaŋulaŋi chikupu kunyisoŋa yeha deyuku, hela yakudya yenu yikushalashala mwiha bayi wakayinonojolaku; kayilekeli kazwepi namweni; yami Yehova Nzambi yenu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.22",
            "verseOrgIds": [
              "LEV.23.22"
            ]
          }
        }
      ]
    },
