          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Denodu ifuku kwililamu mudimu himudimunehi, muloŋa hiifuku dakubutapa, dakuyilila yakubuta nachu kumesu aYehova Nzambi yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.28",
            "verseOrgIds": [
              "LEV.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu wakabula kudikabisha denodu ifuku, hadi akwawu akamufumishuhu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.29",
            "verseOrgIds": [
              "LEV.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu wakakoŋa mudimu himudimudenodu ifuku, yenowu muntu nakamukisaŋana hadi akwawu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.30",
            "verseOrgIds": [
              "LEV.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi mwakakoŋi mudimu himudimuku; hichidika chahaya nyaka munyikalayenu mwambakavwa ikilaŋi anyanenu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.31",
            "verseOrgIds": [
              "LEV.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dakekali ifuku denu dasabata yakunooka kwakudihudika, mwakadikabishaŋa munyichima yenu; mwifukuda muchitanu nachiwana dakakweji hamelela, kufumisha kumelela nakushikŋi kumelela, dimu mwakahembelaŋa sabata yenu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.32",
            "verseOrgIds": [
              "LEV.23.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.32",
            "verseOrgIds": [
              "LEV.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wahosheli naMosi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.33",
            "verseOrgIds": [
              "LEV.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Hoshaku nawanyana kaIsarela, neyi, Ifuku dekumi nakatanu elakaweji aka kamuchitanu nachiyedi, hichawija chamuyisolu chaYehova chamafuku atanu nayedi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.34",
            "verseOrgIds": [
              "LEV.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifuku dakusambila kwakeli kupompa kwajila, kukoŋa mudimu waŋovu nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.35",
            "verseOrgIds": [
              "LEV.23.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafuku atanu nayedi mwakalambulaŋa himulambu wakumwilila Yehova nakesi; ifukuda muchitanu nachisatu mwakapompi kupompa kwajila; mwakalambuli himulambu wakumwilila Yehova nakesi; hikupompa kwakudihudika; kukoŋamudimu waŋovu nehi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.36",
            "verseOrgIds": [
              "LEV.23.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.36",
            "verseOrgIds": [
              "LEV.23.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 23:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Diyi yawija yaYehova yakutiyaŋana yimwakabidikaŋa, kulonda akapompaŋa kupompa kwajila, kulonda kulambulaŋa himulambu wakumwilila Yehova nakesi, himulambu wakushita, nihimulambu wawuŋa, chimuna chakuketula, ninyilambu yakuhuŋununa, iwu nefuku dawu iwu nefukudawu; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.37",
            "verseOrgIds": [
              "LEV.23.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 23:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "yakulunjikapa hasabata jaYehova, nihayamukunkulu yenu, nihansaŋu jenu jimwakadishi ilaŋamu, nihanyilambu yenu yakudilambwila chakunyichima yenu, yimukumwinkaŋa Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.38",
            "verseOrgIds": [
              "LEV.23.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 23:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.38",
            "verseOrgIds": [
              "LEV.23.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 23:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwinza ifuku dekumi nakatanu dakakweji kamuchitanu nachiyedi, chimwakela munakuŋuli dehi mbutu jamwituŋa, mwakadyi chawija chaYehova mafuku atanu nayedi; ifuku dakusambila mwakanooki kunooka kwakudihudika, nihefuku damu chitanu nachisatu mwakanooki kunooka kwakudihudika. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.39",
            "verseOrgIds": [
              "LEV.23.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 23:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifuku dakusambila mwakadikunkwili nyikabu yanyitondu yayiwahi, ninyitayi yanyikoma, ninyitayi yanyitondu yajika, ninyitonduyayiwahi yakumeji, mwakazaŋajali kumesu aYehova Nzambi yenu mafuku atanu nayedi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.40",
            "verseOrgIds": [
              "LEV.23.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 23:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwakamudi ilaŋa Yehova chawija ichi mafuku atanu nayedi hamwaka; hichidika chahaya nyaka mwamba kavwalikilaŋa anyanenu; mwaka chidyaŋa mukakweji kamuchitanu nachiyedi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.41",
            "verseOrgIds": [
              "LEV.23.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 23:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwakashakamaŋa muyisolu mafuku atanu nayedi; aIsarela achisemwa ejima akashaakamaŋa muyisolu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.42",
            "verseOrgIds": [
              "LEV.23.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 23:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulonda anyanenu amba kavwalikaŋa akelukichina shakamishili anyana kaIsarela muyisolu hinayifumishili mwituŋa daEjipitu; yami Yehova Nzambi yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.43",
            "verseOrgIds": [
              "LEV.23.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 23:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi wayilejeli anyana kaIsarela yawija yaYehova yakutiyaŋana.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.44",
            "verseOrgIds": [
              "LEV.23.44"
            ]
          }
        }
      ]
    }
