  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "LEV 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chelili ifuku damu chitanu nachisatu dinashiki dehi, Mosi hakutambika Aroni nawanyanindi amayala, niakulumpi awaIsarela; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.1",
            "verseOrgIds": [
              "LEV.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakumwila Aroni, nindi, Kwataku mwana kaŋombi weyala wamulambu wahanshidi, nichizamba chamukoku chamulambu wakushita; akadi ninaha hataminawu, wakayilambuli kumesu aYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.2",
            "verseOrgIds": [
              "LEV.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakayili anyana kaIsarela, neyi, Kwatenu chizamba champembi chamulambu wahanshidi; ni mwana kaŋombi ni mwana kamukoku, mwayedi wawu amwaka wumu, akadi hataminawu, ahimulambu wakushita; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.3",
            "verseOrgIds": [
              "LEV.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "niŋombi weyala nichizambachamukoku, anyilambu yakuwunda, kulonda kuyiketwila kumesu aYehova; nihimulambu wawuŋa wakubomba namanji; muloŋa lelu Yehova wukumwekanakudenu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.4",
            "verseOrgIds": [
              "LEV.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.4",
            "verseOrgIds": [
              "LEV.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yayilejeluwu kudi Mosi ayileteli kumesu etenti dakubulakena; chipompelu chejima chakundamini kwakwihi, chemeni kumesu aYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.5",
            "verseOrgIds": [
              "LEV.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi wayilili nindi, Tiyenu chuma chanayilejiyi Yehova nindi mwakachilikulonda kulema kwaYehova kumwekani kudenu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.6",
            "verseOrgIds": [
              "LEV.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi wamwilili Aroni, nindi, Kundamaku kukameŋa, wulambuli nihimulambu weyi wahanshidi, nihimulambu weyi wakushita, wili niyakudibuta nachu eyi aweni, niyakubuta nachu antu; wulambuli himulambu wawantu, wuyilili antuyakuyibuta nachu; mwomwatulejeliyi Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.7",
            "verseOrgIds": [
              "LEV.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.7",
            "verseOrgIds": [
              "LEV.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nochu Aroni wakundamini kukameŋa, wajahili mwana kaŋ ombi wamulambu wahanshidi, wayomwenindi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.8",
            "verseOrgIds": [
              "LEV.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaAroni ashikŋili mashi kudi yena; yena watumpikili munu windi mumashi, wayiloombelikunseŋu jakameŋa, wamwapilili mashi kwishina dakameŋa; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.9",
            "verseOrgIds": [
              "LEV.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ilaŋamanji, ninshiya, nichibutamuchima chamulambu wahanshidi, wayishitilihakameŋa bwi-i; mwomwamulejeluwu Mosi kudi Yehova; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.10",
            "verseOrgIds": [
              "LEV.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimbiji, nichitembi, wayocheli hakesi bwi-i kunsa yachilombu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.11",
            "verseOrgIds": [
              "LEV.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.11",
            "verseOrgIds": [
              "LEV.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wajahili nihimulambu wakushita, anyana kaAroni amuleteleli mashikwakwihi, wayisampwili hakameŋa kwi-ndo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.12",
            "verseOrgIds": [
              "LEV.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amuleteleli himulambu wakushita kwakwihi, hachidi hachidi, ninamutu, wayishitili hakameŋa bwi-i. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.13",
            "verseOrgIds": [
              "LEV.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakoseli niyamwivumu ninyendu, wayishitili bwi-i hewulu dahimulambu wakushita hakameŋa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.14",
            "verseOrgIds": [
              "LEV.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.14",
            "verseOrgIds": [
              "LEV.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waleteli kwakwihi himulambu wawantu, hakukwata nimpembi yahimulambu wawantu wahanshidi, hakumujaha, hakumulambwila nshidi neyihakusambila. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.15",
            "verseOrgIds": [
              "LEV.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waleteli himulambu wahanshidi kwakwihi, wawulambwili mwomwelilaŋawu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.16",
            "verseOrgIds": [
              "LEV.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waleteli nihimulambu wawuŋa kwakwihi, wanonenumuchikasa to-o, wawushitili hakameŋa bwi-i, wabombeleli kuhimulambu wakushita wabudidi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.17",
            "verseOrgIds": [
              "LEV.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.17",
            "verseOrgIds": [
              "LEV.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wajahili nawa niŋombi, nimukoku, hiyimuna yanyilambu yakuwunda yakuketwila antu; anyana kaAroni amuleteleli mashi kwakwihi, hakuyisampula hakameŋa kwi-ndo, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.18",
            "verseOrgIds": [
              "LEV.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimanji aŋombi, nimanji amukoku, nimukilawamanji, nimanji abutaŋa hayuma yamwivumu, ninshiya, nichibutamuchima; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.19",
            "verseOrgIds": [
              "LEV.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ashili manji hamabwambu, ashitili manji hakameŋa bwi-i; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.20",
            "verseOrgIds": [
              "LEV.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni wanyinkesheli nimabwambu nichipeha chachidiilu kumesu aYehova hihimulambu wakunyinkesha, mwomwayilejeliyi Mosi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.21",
            "verseOrgIds": [
              "LEV.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.21",
            "verseOrgIds": [
              "LEV.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni wayolweleli antu makasindi kwiwulu, wayi kiswilili nkisu, hakukunkumuka kwayiliyi nakulambula himulambu wahanshidi, nihimulambu wakushita, ninyilambu yakuwunda. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.22",
            "verseOrgIds": [
              "LEV.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMosi naAroni epilili mwitenti dakubulakena, edikilumu ayikiswilili antu, ni kulema kwaYehova kwamwekenikudi antu ejima. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.23",
            "verseOrgIds": [
              "LEV.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kudi Yehova kwafumini kesi, kanoŋeshelini himulambu wakushita nimanji adiŋi hakameŋa, chachimwenuwu antu ejima, akalokeli adimbokeli chamesu awu heseki.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.24",
            "verseOrgIds": [
              "LEV.9.24"
            ]
          }
        }
      ]
    }
  ],
