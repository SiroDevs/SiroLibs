  "verseCount": 46,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "DEU 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyenu mazu ahosheliyi Mosi nawaIsarela ejima kwishinadi daYodana, mwisaŋa, kuchana, mwatalaŋana naSufwi, hakachi kaParana, naTofweli, naLabani, naHazeroti, naDizahabi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.1",
            "verseOrgIds": [
              "DEU.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kufuma kuHorebi njilayampidi yaSeyiri nakushika kuKadeshi Baraneya hikwenda kwamafuku ikumi nadimu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.2",
            "verseOrgIds": [
              "DEU.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwaka wamakumi awana, mukakweji kekumi nakamu, mwifuku dakakweji dakusambila, Mosi wahosheli nawanyana kaIsarela mwejima mwamulejeliyi Yehova kuyileja; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.3",
            "verseOrgIds": [
              "DEU.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "henohu natapi dehi Sihoni mwanta wawaAmori washakamini muHeshiboni, naOŋi mwanta wakuBashani washakamini muAshataroti kuEdereyi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.4",
            "verseOrgIds": [
              "DEU.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwishinadi daYodana, mwituŋa daMowabi, kwokwatachikililiyi Mosi kushimuna lushimbilu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.5",
            "verseOrgIds": [
              "DEU.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Yehova Nzambi yetu wahosheli nanetu kuHorebi, nindi, Munashakami dehi hampidiyi hanalehi dehi, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.6",
            "verseOrgIds": [
              "DEU.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "balumukenu mukwati cheŋi lwendu lwenu muyi mwituŋa dawaAmori damapidi, nikumpata jekalaku, nimuchana, ni mwituŋa damapidi, nimunkulu, nikukabeta kakuchidiilu, nikuchikumu chakaluŋalwiji, dodituŋa dawaKenani naLebanoni, lusunikukaloŋa keneni, yowu kaloŋa Yufurati. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.7",
            "verseOrgIds": [
              "DEU.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Talenu, nayishili dehi ituŋa kumesu enu; ipilenu mutambuli ituŋa dasanyikililiyi Yehova ankakululajenu Abarahama naIsaka naYakoba, nindi wakayinkadu nianyanawuamba kalondelaŋamu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.8",
            "verseOrgIds": [
              "DEU.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.8",
            "verseOrgIds": [
              "DEU.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami nahosheli nanenu henahana nami, Hinatweshi kukabakana nanenukanka wamuku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.9",
            "verseOrgIds": [
              "DEU.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova Nzambi yenu nayivulishi dehi, talenu lelumunavuli dehi neyi tutumbwa twamwiwulu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.10",
            "verseOrgIds": [
              "DEU.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninochu Yehova Nzambi yawankakulula jenu ayibadishi kuvula imumumunashiki dehi maŋampa ikombakaji, ayikiswili nkisu mwomwayikaniniyi dehi! ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.11",
            "verseOrgIds": [
              "DEU.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indi ami yaminuku kabakanaŋa nenu kanka wami nayidŋokojola yenu, nansaŋu jenu, nandombu jenu, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.12",
            "verseOrgIds": [
              "DEU.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepenu amayala akwamaana, akweti kashinshi, atiyakana mwahita nyichidi yenu, ami nakayilishi anyanta jenu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.13",
            "verseOrgIds": [
              "DEU.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu mwaŋa kwili nenu, Chuma chiwunahoshi chachiwahi tukwilamu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.14",
            "verseOrgIds": [
              "DEU.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.14",
            "verseOrgIds": [
              "DEU.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi ami natambwili anyanta akunyichidi yenu, amayala akwetimaana, atiyakana, nayikunjikili kwikala anyanta jenu, wowu awakulumpi amakombakaji, niakulumpi amakulakaji, niakulumpi amakumi atanu, niakulumpimakumi, ekalaŋa atulala twenu mwahita nyichidi yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.15",
            "verseOrgIds": [
              "DEU.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakonkomweneni ansompeshi jenu henahana, nami, Mwakatiyaŋa nsaŋujawana kwenu, mwakasompeshaŋa nsaŋu jamuntu namana kwindi chaloŋa, ngmwenyi ekalayi nindi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.16",
            "verseOrgIds": [
              "DEU.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimwa kasompeshaŋa bayi mwakaakamaŋa antu kumesuku; mwakatiyililaŋa hamu niwanyanya nimuneni; bayi mwakatiyaŋa woma wamesu amuntuku; muloŋa wuŋaji wambala waNzambi; nsaŋu yakasweja kuyikalila mwakayileta kudami, ami nakayitiya. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.17",
            "verseOrgIds": [
              "DEU.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henahananayilejeli yuma yejima yimwadi kwila.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.18",
            "verseOrgIds": [
              "DEU.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.18",
            "verseOrgIds": [
              "DEU.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twafumini kuHorebi, twahitili mwisaŋa dejima diŋa dasweja kutoha, dikweti woma nankashi dimwamweni, twahitili njila yetuŋa dawaAmori damapidi, mwatulejeliyi Yehova Nzambi yetu; twashikili kuKadeshi Baraneya. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.19",
            "verseOrgIds": [
              "DEU.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nayilili nami, Munashiki dehi kwituŋa dawaAmori damapidida kutwinkayi Yehova Nzambi yetu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.20",
            "verseOrgIds": [
              "DEU.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Talaku ntahi Yehova Nzambi yeyi nakushili dehi ituŋa kumesu eyi; yaku wakaditambuli mwomwakuhosheliyi Yehova Nzambi yawankakulula jeyi; bayi wakatiya womaku, bayi wakaakamaku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.21",
            "verseOrgIds": [
              "DEU.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaswilili kwakwihi nanami wejima wenu, mwelili nenu, Tutemeshaŋahu dehi amayala akatwendesheli ituŋa, akafunti cheŋi nakutulejanjila yitwakaya, nikunyikala yitwakashika. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.22",
            "verseOrgIds": [
              "DEU.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chumochu chantiyishili kuwaha nankashi; nafumishili hadenu mayala ikumi nayedi, hamuchidi iyala, hamuchidi iyala. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.23",
            "verseOrgIds": [
              "DEU.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalumukili, akandukili hampidi, ashikili kuchinekineki chaEshikoli, achendesheli. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.24",
            "verseOrgIds": [
              "DEU.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asendeli mumakasawu yakudya yamwituŋa, atuleteleliyi, afuntili cheŋi nakutuleja nawu, Ituŋa dakutwinkayi Yehova Nzambi yetu hiituŋa dadiwahi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.25",
            "verseOrgIds": [
              "DEU.1.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.25",
            "verseOrgIds": [
              "DEU.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela chochu himwetiyili kuya kwoku, mwadikaŋili, mwalekeli kwovwahila mwayilejeliyi Yehova Nzambi yenu; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.26",
            "verseOrgIds": [
              "DEU.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwatobatobeli mumatenti enu, nenu, Komana Yehova watuheleli, dichi chatufumishililiyi mwituŋa daEjipitu, walondeli atuhani kudi aAmori kulonda atujilumuni. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.27",
            "verseOrgIds": [
              "DEU.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenu, Tukukanduka tuyi kudihi? Ana kwetu anatusuŋununi dehi nyichima mumavumu, aneli dehi nawu, Hiyantu atubadika nikuvula nikutaluka, ninyikala yamaneni yikweti nimpwembu jashika nimwiwulu, twamonamu nianyana kawaAnaki. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.28",
            "verseOrgIds": [
              "DEU.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami nayilili henahana nami, Bayi muzaala womaku, bayi muyakamaku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.29",
            "verseOrgIds": [
              "DEU.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova Nzambi yenu wukutwaminaku, diyi wukuyilwila, mwejima mwayikoŋeleliyi muEjipitu enu mumonaŋa namesu enu; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.30",
            "verseOrgIds": [
              "DEU.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DEU 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "nichi chiwamweni mwisaŋa chakwelekeliyi Yehova Nzambi yeyi, neyi chelekarjayi iyala mwanindi, munjila yimwenjili yejima nichi chimwashikili kunu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.31",
            "verseOrgIds": [
              "DEU.1.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DEU 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela mwejimimu himwamwitiyili Yehova Nzambi yenuku, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.32",
            "verseOrgIds": [
              "DEU.1.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DEU 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "kutoŋa diyi watwaminini munjila mumwenjilaŋa, nakuyikeŋela hakutuŋila matenti enu; nawufuku mukesi kakuyileja nachu njila yimukuya, namwaana mwivu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.33",
            "verseOrgIds": [
              "DEU.1.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DEU 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.33",
            "verseOrgIds": [
              "DEU.1.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "DEU 1:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova watiyili mazu imwahosheli, wazuwili, wasanyikili, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.34",
            "verseOrgIds": [
              "DEU.1.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "DEU 1:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Chalala kwaamu, hosi iyala niwumu wahekiŋu idi datama wamba kamonahu ituŋodu dadiwahi dinasanyikili nami nakayinka ankakulula jenuku, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.35",
            "verseOrgIds": [
              "DEU.1.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "DEU 1:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "chiŋa yowu mwana kaYefune Kalebi hohu, diyi wakadimona; ituŋa dadatiliyi nakamwinkadu niyena nianyanindi; muloŋa yena wamulondeli Yehova hachikupu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.36",
            "verseOrgIds": [
              "DEU.1.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "DEU 1:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.36",
            "verseOrgIds": [
              "DEU.1.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "DEU 1:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wanzuwilili ninami nawa hanyijimba yenwenu, welili nindi, Nineyi nawa kwijila mwenomu nehi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.37",
            "verseOrgIds": [
              "DEU.1.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "DEU 1:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwana kaNuni Yoshuwa, wemanaŋa kumesu eyi diyi wakeŋa ilamu; mwinki Ŋovu, muloŋa diyi wakayiswanishadu aIsarela. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.38",
            "verseOrgIds": [
              "DEU.1.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "DEU 1:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nianyanenu anyanya imwelili nenu akakwachika, nianyanenu abulili kwiluka hela mwamuwahi hela mwatama dena ifuku dina, diwu akeŋilamu, diwu nakenka ituŋodu, diwu akadiheta hidawu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.39",
            "verseOrgIds": [
              "DEU.1.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "DEU 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwila enu balumukenu muholokeli munjila yenu muyi mwisaŋa njila yaKaluŋalwiji Kachinana.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.40",
            "verseOrgIds": [
              "DEU.1.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "DEU 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.40",
            "verseOrgIds": [
              "DEU.1.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "DEU 1:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henahana mwaŋakwili, mwaŋilili nenu, tunamuvulumuni dehi Yehova, tukukanduka twakalwi mwonsu mwanatulejiyi Yehova Nzambi yetu. Enu mwamanyekeli wonsu wenu yuma yenu yakwasa nachu njita, mwadihindili, nenu mwakakanduki hampidi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.41",
            "verseOrgIds": [
              "DEU.1.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "DEU 1:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova waŋilili nindi, Kayili neyi, Bayi mukandukaku, bayi mulwaku; muloŋa ami kwami hinidi mukachi kenuku; akenza kayitapa tuhu kudi ayilumbu jenu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.42",
            "verseOrgIds": [
              "DEU.1.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "DEU 1:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenomu dimu nahosheli nenu, enu kwenu kutiya nehi, mwadikaŋili nezu dayilejeliyi Yehova, mwakandukili hampidi naŋovu jenu hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.43",
            "verseOrgIds": [
              "DEU.1.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "DEU 1:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "AAmori ashakamini hampidi yina ayilotokeleli; ayikupishili neyi chelaŋawu ampuka, ayitapili kuSeyiri, lusu nikuHorama. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.44",
            "verseOrgIds": [
              "DEU.1.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "DEU 1:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu mwafuntili nakudilila kumesu aYehova; Yehova hatiyilili kwindi izu denuku, hela kushaku itu dindi nehi kwindi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.45",
            "verseOrgIds": [
              "DEU.1.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "DEU 1:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwashakamini kuKadeshi mafuku amavulu, mwomwashikili mafuku imwashakamini kwenoku.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.46",
            "verseOrgIds": [
              "DEU.1.46"
            ]
          }
        }
      ]
    }
