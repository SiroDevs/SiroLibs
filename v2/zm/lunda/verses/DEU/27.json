          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wukudiwula tata yindi namama yindi, amushiŋi. Antu ejima akelanawu, Mwomwenomu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.16",
            "verseOrgIds": [
              "DEU.27.16"
