          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wukuheŋesha muloŋa wamwenyi, nanshona, nantuluwa, amushiŋi. Antu ejima akela nawu, Mwomwenomu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.19",
            "verseOrgIds": [
              "DEU.27.19"
            ]
