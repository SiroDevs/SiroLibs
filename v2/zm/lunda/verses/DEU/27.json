          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wukututulula chinjikijilu chakwiluka nachu muŋinza namukwawu, amushiŋi. Antu ejima akela nawu, Mwomwenomu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.17",
