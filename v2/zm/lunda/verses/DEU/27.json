          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wukukama naŋodatata yindi, amushiŋi, muloŋa navúuli dehi tatayindi. Antu ejima akela nawu, Mwomwenomu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.20",
            "verseOrgIds": [
