          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wukupwapwisha mputamesu munjila amushiŋi. Antu ejima akelanawu, Mwomwenomu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.18",
