          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.33.25",
            "verseOrgIds": [
              "DEU.33.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 33:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi Yeshuruni, hikudi wadifwana naNzambuku, wendelaŋa kwindihamawulu kulonda akukwashuku, wendelaŋa haluzwizu chawanta.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.33.26",
            "verseOrgIds": [
              "DEU.33.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 33:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.33.28",
            "verseOrgIds": [
              "DEU.33.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 33:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi Isarela, O chiwamona kuwaha! Wudi neyi eyi hinyi? Muza wakwamwina kudi Yehova nkebu yeyi yakukwashaŋa, diyi mpoku yeyi yakabali yawanta weyi. Ayilumbu jeyi akakufwomokela; wakadata hayinaŋanaŋa yawu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.33.29",
            "verseOrgIds": [
              "DEU.33.29"
            ]
          }
        }
      ]
    }
  ],
