      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 33:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyenu nkisu yakiswililuwu anyana kaIsarela kudi muntu waNzambi Mosi, kwakwihi nakufwa kwindi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.33.1",
            "verseOrgIds": [
              "DEU.33.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.33.5",
            "verseOrgIds": [
              "DEU.33.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rubeni ahandi kwindi, bayi afwaku; hela chochu antu indi ekaliantesha.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.33.6",
            "verseOrgIds": [
              "DEU.33.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.33.6",
            "verseOrgIds": [
              "DEU.33.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyenu nkisu yaYuda, nindi, Eyi Yehova tiyaku izu daYuda wumushikŋi kudi ayindi; wadilwilili yemweni namakasindi; yeyi wakekala nkwashiyindi hakadasayi nawakwankunyi nindi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.33.7",
            "verseOrgIds": [
              "DEU.33.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.33.7",
            "verseOrgIds": [
              "DEU.33.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamwilili Levi, nindi, Tumimi yeyi niWurimi yeyi, yidi naweyi wajila iwesekeli kuMasa, lwafwilaŋeni nindi kumeji aNdombu; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.33.8",
            "verseOrgIds": [
              "DEU.33.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "welili tata yindinamama yindi nindi, Hinamumonuku, hela ana kwindi hatŋiluku, hela anyanindi yemwenindi hayilukiluku; anashi muchima kwizu deyi, ahembaŋa chitiyaŋenu cheyi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.33.9",
            "verseOrgIds": [
              "DEU.33.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akalejaŋa Yakoba muwuŋaji weyi, akalejaŋa niIsarela nshimbi jeyi; akakushila insensi kumesu eyi; nihimulambu wakushita wamukuma akawisha hakameŋa keyi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.33.10",
            "verseOrgIds": [
              "DEU.33.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi Yehova kiswilakuyuma yindi nkisu, tambula nimudimu wakmnakasindi; adikaŋa nindiyeteli hankuma, ninawa amuhela, bayi amona jakunyamuka cheŋuku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.33.11",
            "verseOrgIds": [
              "DEU.33.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamwilili Benjamini, nindi, Akeŋawu kudi Yehova wakashakama kudiyena chakadi kwakama; wamubutaŋa mwaana wejima, eŋaŋi, washakamaŋa habulakena mafwŋi indi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.33.12",
            "verseOrgIds": [
              "DEU.33.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamwilili Yosefu, nindi, Ituŋa dindi adikiswili nkisu kudi Yehova, amoni yuma yalema yamwiwulu, niwuumi, niyidi mwakunama mwakumakwishina, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.33.13",
            "verseOrgIds": [
              "DEU.33.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "amoni niyuma yalema yameneshaŋa itaŋwa, niyuma yalemaya kulishaŋa tukweji, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.33.14",
            "verseOrgIds": [
              "DEU.33.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "niyuma yabadikamu yakumapidi ahashankulu, niyuma yalema yakutupidi twahaya nyaka, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.33.15",
            "verseOrgIds": [
              "DEU.33.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "amoni niyuma yalema yahamaseki muyavulila, nikumutiya kuwaha kudi washakamini muchiputa; nkisu iyi yinzi hanamutu waYosefu, mwishina danamutu wayena aambwilu wukudi ana kwindi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.33.16",
            "verseOrgIds": [
              "DEU.33.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wawaha neyi chawaha ŋombi yindi wawedi; nseŋu jindi jidi neyi nseŋu jaŋombi wampata; wakahuma nachu nyuza yejima kumu nikwakumina iseki; kudi Efweremi kudi makombakaji makumina makumi, kudi Manase kudi makombakaji.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.33.17",
            "verseOrgIds": [
              "DEU.33.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.33.17",
            "verseOrgIds": [
              "DEU.33.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamwilili Zebuluni, nindi, Zaŋalalaku, eyi Zebuluni, muwendaŋa; nineyi Isakari mumatenti eyi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.33.18",
            "verseOrgIds": [
              "DEU.33.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 33:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatambika nyuza yawantu kwinza kumpidi; kwenoku akaketwilaku yimuna yakuloŋa; muloŋa wena akaamwayuma yayivulu yanamutuluŋa lwŋi, niyuma yalema yaswamana yamuwusekulula.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.33.19",
            "verseOrgIds": [
              "DEU.33.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 33:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.33.19",
            "verseOrgIds": [
              "DEU.33.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamwilili Gadi, nindi, Wukutohesha mpata yaGadi akekali wakisulewa; washakamaŋa neyi mukaji wamutupa, watabulaŋa chikasa, niishina danamutu kumu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.33.20",
            "verseOrgIds": [
              "DEU.33.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 33:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waambwiluku iseka dakusambila nindi dami, dikukwatentekeluwu iseka damukwakuhana nshimbi; wenjili nawayilolu, welilimwaya wuŋaji waYehova, nimwasompesheliyi aIsarela.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.33.21",
            "verseOrgIds": [
              "DEU.33.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 33:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.33.21",
            "verseOrgIds": [
              "DEU.33.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 33:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamwilili Dani, nindi, Dani himwenzi wamutupa, wafumaŋa kuBashani nakutumboka.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.33.22",
            "verseOrgIds": [
              "DEU.33.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 33:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.33.22",
            "verseOrgIds": [
              "DEU.33.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 33:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamwilili Nafwatali, nindi, Eyi Nafwatali, wunekuti wuselewa, wunenzali nkisu yaYehova mbe; hetaku nimujika nikabeta kakuchidiilu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.33.23",
            "verseOrgIds": [
              "DEU.33.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 33:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.33.23",
            "verseOrgIds": [
              "DEU.33.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 33:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamwilili Asheri, nindi, Asheri amukiswili nkisu yakusema; amumoni kuwaha kudi ana kwindi, atumpi mwendu windi mumanji; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.33.24",
            "verseOrgIds": [
              "DEU.33.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 33:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyikomenuyeyi yakekala chikuŋu nawuneŋu; mwakekalila mafuku eyi dimu mwakekalila niŋovu jeyi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.33.25",
            "verseOrgIds": [
              "DEU.33.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
