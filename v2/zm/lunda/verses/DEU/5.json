          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwikala naiwisu lwaŋodamukwenu, chinjila; kwikala nalwisu lwetaladamukwenu, hela lweha dindi, hela lwaŋamba yindi weyala, hela lwaŋmbayindi wamumbanda, hela lwaŋombi yindi, hela lwachimbulu chindi, helalwachuma hichuma chambala chamukwenu, chinjila.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.21",
            "verseOrgIds": [
              "DEU.5.21"
            ]
          }
        }
