  "copyright": "PUBLIC DOMAIN",
  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "29",
        "style": "c",
        "sid": "DEU 29"
      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyenu mazu achitiyaŋenu chalejeluwu Mosi kudi Yehova kutiya Ijana nawanyana kaIsarela mwituŋa daMowabi, chakulunjika hachitiyaŋenu chatiyaŋeniyi dehi nawu kuHorebi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.1",
            "verseOrgIds": [
              "DEU.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.1",
            "verseOrgIds": [
              "DEU.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi watambikili aIsarela ejima, wayilili nindi, Enu munamoni yumayejima yeliliyi Yehova kumesu enu mwituŋa daEjipitu, yamwililiyi Fwaro, niambuŋindi, niituŋa dindi dejima; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.2",
            "verseOrgIds": [
              "DEU.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kweseka kweneni kuwamweni namesueyi, niyinjikijilu, niyihayamisha oyu yamaneni. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.3",
            "verseOrgIds": [
              "DEU.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela chochu, Yehova hanayinki muchima wakwiluka, hela mesu akumona, hela matu akutiyaku, nikulelu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.4",
            "verseOrgIds": [
              "DEU.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami nayilombweli mwisaŋa nyaka makumi awana; mahinenu hiyakulilili hanyijimba yenuku, nkwabilu jeyi hijakulilili kunyendu yeyuku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.5",
            "verseOrgIds": [
              "DEU.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu himwadiili mankenduku, himwanwini hela vinyu hela walwaku; kulonda mwakeluki nenu yami Yehova Nzambi yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.6",
            "verseOrgIds": [
              "DEU.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimwenjili kunu Sihoni mwanta wakuHeshiboni, niOgi mwanta wakuBashani atulotokeleli nanjita, twayitapili; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.7",
            "verseOrgIds": [
              "DEU.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "twatambwili ituŋa dawu, twadinkeli aRubeni, nawaGadi, namuchidi wawaManase wachibalu, dawu dakuswanaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.8",
            "verseOrgIds": [
              "DEU.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu hembenupa mazu achitiyaŋenu ichi kulonda mwakamonikuwaha muyuma yejima yimwakelapa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.9",
            "verseOrgIds": [
              "DEU.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.9",
            "verseOrgIds": [
              "DEU.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelu munemani wejima wenu kumesu aYehova Nzambi yenu; nianyanta jenu, ninyichidi yenu, niakulumpi jenu, nitulala twenu, amayala aIsarela ejima, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.10",
            "verseOrgIds": [
              "DEU.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "niatwansi twenu, niapodi jenu, nienyi eyi adi muyilombuyeyi, akufumishila hadi mukwakuchaya nchawa jeyi, kushikŋa nikudimukwakutaha meji eyi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.11",
            "verseOrgIds": [
              "DEU.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulonda wakeŋili muchitiyaŋenu chaYehova Nzambi yeyi, nimukusanyika kwindi kwana kusanyikiliyi Yehova Nzambi yeyi lelu; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.12",
            "verseOrgIds": [
              "DEU.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulonda akushimatishi lelu wikali muza wambala wayena hohu; kulonda wakamumoni neyi komana hiNzambi mwomwahosheliyi naneyi, mwomwasanyikililiyi ankakulula jeyi, aAbarahama, naIsaka, naYakoba. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.13",
            "verseOrgIds": [
              "DEU.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi chitiyaŋenu, niniku kusanyika, hinidi nakwilenu hohuku; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.14",
            "verseOrgIds": [
              "DEU.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "nidinakwila niniwu nemani kunu hamu nanetu kumesu aYehova Nzambi yetulelu, niwunabuli kwikala kunu hamu nanetu lelu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.15",
            "verseOrgIds": [
              "DEU.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muŋa enu munelukichitwa shakamini mwituŋa daEjipitu, ninichi chitwahanukili mukachi kanyuza mutwahitili; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.16",
            "verseOrgIds": [
              "DEU.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "munamoni mwashimanaŋawu, niakishi awu atuji, anyitondu namalola nasiliva nawuru adiŋi mukachi kawu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.17",
            "verseOrgIds": [
              "DEU.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchina kumwekana mukachi kenu lelu hela iyala, hela mumbanda, hela chisaka, helamuchidi, wukweti muchima wakutepuluka lelu, wakufuma kudi Yehova Nzambi yetu, wakuya nakupesha akishi anyuzoyu. Kuchina kumwekanamukachi kenu muji wakusopa wulembi mwaaji; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.18",
            "verseOrgIds": [
              "DEU.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakenza kamona hakatiyayi mazu eshipwidi, hakadikisula nkisu mumuchima windi, nindi, Helanakenda tuhu mwonsu mwakadikapila muchima wami, nakukisaŋana kumuniyituuta niyawuma, nakamona tuhu kwami kuwunda hohu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.19",
            "verseOrgIds": [
              "DEU.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova hakamwanakenaku, kuzuwa kwaYehova nimukawu windi wakamufwindashanina muntu owu, niishiŋu dejima danasonekuwu mumukandiwu dakamushikena, Yehova wakajiyisha niijina dindi mwishina dewulu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.20",
            "verseOrgIds": [
              "DEU.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wakamwambula mukachi kanyuza yawaIsarela yejima wakamonaŋa kutamamwomwaya mashipu ejima achitiyaŋenu chanasonekuwu mumukandi wuwanshimbi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.21",
            "verseOrgIds": [
              "DEU.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niikipu dakalondelamu, wowu anyanenu akahiŋa mudenu, niantu acheŋi akafuma kwituŋa dadilehi, chakamonawu yipúpu yetuŋodu, niyikatu yakayikatishayi nachu Yehova; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.22",
            "verseOrgIds": [
              "DEU.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ituŋa dejima himakala namuŋwahohu, dasukuma dehi, hiyadidimaŋaku, hidasoŋapaku, himwamenaŋa matahuku, dakisika dehi neyi chakisikili Sodoma naGomora, naAdima, naZeboyimi, akisaŋeniyi Yehova hazuwiliyi, haleteliyi ndombu; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.23",
            "verseOrgIds": [
              "DEU.29.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "kafwampinyuza yejima akahosha nawu, Yehova nakoŋelidi ituŋidi chochichi? Ikukuzuwa kukumaha kwasweja kwaya mudihi? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.24",
            "verseOrgIds": [
              "DEU.29.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu antu akahoshanawu, Muloŋalekeli chitiyaŋenu chaYehova Nzambi yawankakulula jawu, chatiyaŋeniyi nawu hayifumishiliyi mwituŋa daEjipitu; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.25",
            "verseOrgIds": [
              "DEU.29.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "ayili nakupeshaakishi, hiyakudifukula kudi wena, akishi akadi kwiluka wena, abulili kuyilejayi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.26",
            "verseOrgIds": [
              "DEU.29.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "dihu hanafumi kuzuwa kwaYehova hikukusaŋumukila ituŋidi, hafumi nikudiletela ishiŋu dejimidi danasonekuwu mumukandiwu; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.27",
            "verseOrgIds": [
              "DEU.29.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwaka Yehova ayibwitaŋa mwituŋa dawu nakuzuwa, nandombu, nakutatashana nankashi, hakuyinatila mwituŋa dacheŋi neyi ichi chimunamoni leluidi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.28",
            "verseOrgIds": [
              "DEU.29.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.28",
            "verseOrgIds": [
              "DEU.29.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuma yakujinda yambala yaYehova Nzambi yetu; ilaŋa yumayana mwekeshuwu yetwetu nawanyanetu chahaya nyaka, kulonda twakelaŋamazu ejima anshimbiji.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.29",
            "verseOrgIds": [
              "DEU.29.29"
            ]
          }
        }
      ]
    }
  ],
