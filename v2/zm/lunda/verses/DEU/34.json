        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi wafumini muyana yaMowabi, wakandukili hamukandu waNebo hewulu daPisiga, yatalaŋana naYeriku. Yehova wamulejeli ituŋa daGileyadi dejima, nikuDani;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.1",
            "verseOrgIds": [
              "DEU.34.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.6",
            "verseOrgIds": [
              "DEU.34.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi hafwiliyi washi kili munyaka nkulakaji namakumi ayedi; mesuindi hiyelili lumbunduku, niŋovu jindi hijamufuminuku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.7",
            "verseOrgIds": [
              "DEU.34.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaIsarela amudilili Mosi muyana yakuMowabi mafuku makumi asatu; mafuku amudililuwu Mosi amana nikumana.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.8",
            "verseOrgIds": [
              "DEU.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.8",
            "verseOrgIds": [
              "DEU.34.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana kaNuni Yoshuwa wenzeli spiritu yama ana nanochu chamunaŋikiluwu dehi makasa kudi Mosi; anyana kaIsarela amutiyililili, elili mwejima mwamulejeluwu Mosi kudi Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.9",
            "verseOrgIds": [
              "DEU.34.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "MuIsarela himunamwekani cheŋi kaprofwetu wudi neyi Mosi, elukiliyi Yehova wakudimona nindimesu namesu; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.10",
            "verseOrgIds": [
              "DEU.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nayinjikijilu yejima, nayihayamisha yamutemeshelu wukudi Yehova kumukoŋa Fwaro nambuŋindi ejima niituŋa dindi dejima; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.11",
            "verseOrgIds": [
              "DEU.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "nachena chikasa chaŋovu cheji mochu, nimutentu weneni weji mowuwakoŋeliyi Mosi chakumona kudi aIsarela ejima namesuku.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.12",
            "verseOrgIds": [
              "DEU.34.12"
            ]
          }
        }
      ]
    }
