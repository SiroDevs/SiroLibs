  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "DEU 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi kudi antu kudi kufwilaŋana, akaholoki kuchota, akayisompeshi; akayipishi waloŋa, akahishi watama; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.1",
            "verseOrgIds": [
              "DEU.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "neyi owu muntu watamanateli kumweta akamukamiki kudi nsompeshi hamaseki, akamweteli kumesuindi mwashikila kuluwa kwindi, chakuchinda. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.2",
            "verseOrgIds": [
              "DEU.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakatwesha kumweteshanyinkakambu makumi awana, kumotweshamu nehi, kuchina kwila neyi wunamotweshumu dehi, wunamweti dehi nyinkakambu yayivulu yakubadikiyi, mana kweyi wakenza kamwekana kudeyi neyi wamukunkulwayi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.3",
            "verseOrgIds": [
              "DEU.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.3",
            "verseOrgIds": [
              "DEU.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi wakakasa kukanwa kaŋombi hakuhulayi tidikuku.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.4",
            "verseOrgIds": [
              "DEU.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.4",
            "verseOrgIds": [
              "DEU.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi antu evumu dimu akushakama hamu, hafwa wumu wabula mwanaweyala, iŋodamufu bayi akasumbukila kwacheŋi kudi mwenyuku; manakwanfumwindi akeŋili mwadiyi yena, akamusumbuli, akamwilili mudimuwatela kwila mana kwanfumwindi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.5",
            "verseOrgIds": [
              "DEU.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owu wedi akavwalayi akaswani ijina damana kwindi wafwa, kulonda ijina dindi dakabuli kujiya muIsarela. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.6",
            "verseOrgIds": [
              "DEU.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi owu iyala kukeŋa kutambula iŋodamana kwindi nehi, owu iŋodamana kwindi akayi kuchisu champwembu kudi awakulumpi, akayili nindi, Manakwanfumwami naleki kumusaŋwila mana kwindi ijina muIsarela, kwonti kwindi kuŋilila mudimu watela kwila mana kwanfumwami. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.7",
            "verseOrgIds": [
              "DEU.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu awakulumpi amumukala wawu akamutambiki, akahoshi nindi; neyi yena wakakakelamu nindi, Ami kwami hinakeŋi kumutambulaku; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.8",
            "verseOrgIds": [
              "DEU.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "henohu iŋoda mana kwindi akenzi kudi yena kumesu awawakulumpi, akamusubuli nkwabilu kumwendu windi, akamufwŋili mazeŋi mumesu; akamwakuli nindi, Dichi chakamwilawu iyala wukubula kutuŋa mukala wamana kwindi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.9",
            "verseOrgIds": [
              "DEU.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanamutumbi ijina dindi muIsarela nawu, Itala dawasubwiluwu nkwabilu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.10",
            "verseOrgIds": [
              "DEU.25.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.10",
            "verseOrgIds": [
              "DEU.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi amayala ayedi adi nakuzuŋa, iŋodawumu hakukundama kwakwihi, nindi amwamwini nfumwindi kudi mukwawu wudi nakumweta, hakwolola chikasa chindi hakumukwatila kuwusonyi, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.11",
            "verseOrgIds": [
              "DEU.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakamuteti chikasa, disudeyi bayi dakamutala naluwuku.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.12",
            "verseOrgIds": [
              "DEU.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.12",
            "verseOrgIds": [
              "DEU.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi wakekala napezu jacheŋi najacheŋi niyeneni niyanyanya munjekiyeyuku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.13",
            "verseOrgIds": [
              "DEU.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi wakekala namabapu akweseka nachu acheŋi niacheŋi, nideneni nidanyanya, mwitala deyuku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.14",
            "verseOrgIds": [
              "DEU.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakekalaŋa napezu yalalayashikilamu ndwa; wakekalaŋa nebaŋu dakweseka nachu dalala dashikilamundwa; kulonda mafuku eyi akavuli mwituŋa dikukwinka Yehova Nzambi yeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.15",
            "verseOrgIds": [
              "DEU.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa antu ejima akwila yuma yidochu, antu ejima akwilaŋa mwaheŋa, Yehova Nzambi yeyi wayimona hiyakwakushimana hohu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.16",
            "verseOrgIds": [
              "DEU.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.16",
            "verseOrgIds": [
              "DEU.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anukaku chakukoŋeliyi Amaleki munjila himwafuminaŋa muEjipitu; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.17",
            "verseOrgIds": [
              "DEU.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "chakubula keniyi munjila hakutapa antu eyi asheli munyima, wowu antu ejima abulili Ŋovu adiŋi munyima yeyi, hiwelili wazeya dehi, wakatala dehi; yena kumutiya Nzambi woma nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.18",
            "verseOrgIds": [
              "DEU.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiwakela neyi Yehova Nzambi yeyi nakunookeshi dehi kudi ayilumbu jeyi ejima akunyeŋumuka kwi-ndo, mwituŋa dikukwinka Yehova Nzambi yeyi dawuswana wakudihetela, henohu wakajiyisha Amaleki mwishina dewulu nikuyanuka nawa cheŋi nawumwadiŋi Amaleki nehi; bayi wakavulamenaku.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.19",
            "verseOrgIds": [
              "DEU.25.19"
            ]
          }
        }
      ]
    }
  ],
