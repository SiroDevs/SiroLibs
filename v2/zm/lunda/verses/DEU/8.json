  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "DEU 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuleja kwejima kunukukuleja lelu chiŋa wakashaku muchima wakwilamu, kulonda mwakahandi, mwakasemununi, mwakeŋili nakutambula ituŋa dayisanyikililiyi Yehova ankakulula jenu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.1",
            "verseOrgIds": [
              "DEU.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakaanukaŋi njilayejima yakulombweliyi Yehova Nzambi yeyi mwisaŋa nyakiyi makumi awana, kulonda akuzozeshi mumuchima, akweseki, eluki yidi mumuchimaweyi neyi wakovwahilaŋa mwanakuleji, hela nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.2",
            "verseOrgIds": [
              "DEU.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakuzozesheli mumuchima, wakulekeli nanzala, wakudiishili manina iwabulili kwilukeyi, abulili kwiluka hela ankakulula jeyi, kulonda akwilukishi nawu muntu hahandaŋa nayakudya hohuku, muntu wahandaŋi chiŋi nayuma yejima Lukayafumaŋa mukanwa kaYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.3",
            "verseOrgIds": [
              "DEU.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyakiyi makumi awana yuma yeyi yakuvwala hiyakulilili hamujimba weyuku, mwendu weyi hiwananinuku.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.4",
            "verseOrgIds": [
              "DEU.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.4",
            "verseOrgIds": [
              "DEU.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakatonojokana chachiwahi mumuchima weyi, neyi mwababeshelaŋayi iyala mwanindi weyala, dimu mwakukubabeshelayi Yehova Nzambi yeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.5",
            "verseOrgIds": [
              "DEU.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakahembaŋa kuleja kwaYehova Nzambi yeyi, kulonda wendi munjilajindi wumutiyi woma. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.6",
            "verseOrgIds": [
              "DEU.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa Yehova Nzambi yeyi hakukutwala mwituŋa dadiwahi, Ituŋa datutuloŋa twameji, namanyirii, natuseloki twatupukilaŋa animuyinekineki nikumapidi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.7",
            "verseOrgIds": [
              "DEU.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "hiituŋa datidiku nabali, danyivinyu nayikuyu namabula; hiituŋa damaolive amanji, niwuchi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.8",
            "verseOrgIds": [
              "DEU.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "hiituŋadakudya yakudya dye-e, kwosi chuma chiwakabula mwoku; ituŋa dakwila malola ekalamu hichikuŋu, mapidi ekalamu mukutwesha kupundamuwuneriu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.9",
            "verseOrgIds": [
              "DEU.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakadya wakekuta, wakamukiswila Yehova Nzambi yeyi nkisu netuŋa dadiwahi danakwinkiyi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.10",
            "verseOrgIds": [
              "DEU.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.10",
            "verseOrgIds": [
              "DEU.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babalaku wakenza kavulamena Yehova Nzambi yeyi, hiwukubulakuhemba nimukuleja kwindi, nimuwuŋaji windi, nimuyidika yindi munakuiejilelu; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.11",
            "verseOrgIds": [
              "DEU.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakenza kela chiwakela wunadyi dehi, wunekuti dehi, wunatuŋi dehi matala amawahi, wunashakamumu dehi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.12",
            "verseOrgIds": [
              "DEU.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "niaŋombi jeyi niyimuna yeyi yanyanya yinasemununi dehi, nisiliva yeyi niwuru weyiwunavuli dehi, niyuma yeyi yejima yinavuli dehi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.13",
            "verseOrgIds": [
              "DEU.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "henohu hiwakadivwimbamumuchima weyi, hiwakavulamena Yehova Nzambi yeyi wakufumishilimwituŋa daEjipitu, mwitala dawuduŋu; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.14",
            "verseOrgIds": [
              "DEU.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakulombwelihiwukuhita mwisaŋa diŋa deneni dikweti woma nankashi, mwadiŋi nitupelatwakesi, nitunjimbu, niiseki dominina, dabula nimeji; wakufumishililimeji mwilola dabalulaŋawu malola amukalula; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.15",
            "verseOrgIds": [
              "DEU.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakudiishili mwisaŋa manina abulili kwiluka ankakulula jeyi; kulonda akuzozeshi, akweseki kulonda akakwili chachiwahi kunyaka yeyi yakukuminina. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.16",
            "verseOrgIds": [
              "DEU.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakenzakela mumuchima weyi neyi, Ŋovu yami niŋovu yachikasa chami diyiyinanheteshi maheta ejimawa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.17",
            "verseOrgIds": [
              "DEU.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiŋa wakaanukaŋa neyi, Yehova Nzambi yami diyi nanyinki ŋovu yakuheta; kulonda akakoleshi chitiyaŋenu chindi chasanyikililiyi ankakulula jenu neyi chakwilayi lelu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.18",
            "verseOrgIds": [
              "DEU.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monawakavulamena Yehova Nzambi yeyi, hiwakalondela akishi, nakuyipeshana kudifukula kudi wena, nukuyileja lelu nami mwakajilumuka tuhu shati. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.19",
            "verseOrgIds": [
              "DEU.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwomwakuji lumukila nyuza yidi nakujilumunayi Yehova kumukuyenudimu mwakaiilumukila ninenu; muloŋa munaleki kutiyilila mwizu daYehova Nzambi yenu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.20",
            "verseOrgIds": [
              "DEU.8.20"
            ]
          }
        }
      ]
    }
  ],
