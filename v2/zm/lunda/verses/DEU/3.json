        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twabalumukili, twakandukilili njila yakuBashani. Oŋi mwanta i wakuBashani wenjili nakulwa netu njita kuEdereyi, niyena niantu indi ejima. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.1",
            "verseOrgIds": [
              "DEU.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova waŋilili, nindi, Bayi wumutiya womaku muloŋa namuhani dehi kudeyi, niyena niantu indi ejima niituŋa dindi; wakamwilaneyi chiwamwilili Sihoni mwanta wawaAmori washakamini kuHeshiboni.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.2",
            "verseOrgIds": [
              "DEU.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.2",
            "verseOrgIds": [
              "DEU.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninochu Yehova Nzambi yetu waheni kudetu niOgi mwanta wakuBashani nawa niantu indi onsu; twamutapili to-o niwindi wumu wakushalahunehi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.3",
            "verseOrgIds": [
              "DEU.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henahana twatambwili nyikala yindi yonsu; hosi mukalawutwabulili kuyitambulawuku; nyikala makumi atanu nadimu, yoyi mpataya Arigobi yejima, wowanta waOŋi wamuBashani. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.4",
            "verseOrgIds": [
              "DEU.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyikala yejimiyi yadiŋi yakuhata mumpwembu jajilehi jikweti niyenzelu ninyikomenu yayu; ninyikala yi kwawu yakadi mpwembu yayivulu nankashi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.5",
            "verseOrgIds": [
              "DEU.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twayijilu mwini chikupu, neyi chitwamwilili Sihoni mwanta wakuHeshiboni, twajilu mwini chikupu nyikala yejima yatuŋiluwu antu, niambanda nianyana anyanya kumu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.6",
            "verseOrgIds": [
              "DEU.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwila yimuna yejima niyitwapupili munyikala twatambwilinetu hiyuma yetu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.7",
            "verseOrgIds": [
              "DEU.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henahana dihu twatambwili ituŋa kudi anyanta awaAmori ayedi adiŋi kwishinadi daYodana, kufumisha kuchi nekineki chaArinoni lusu nikumpidi yaHerimoni; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.8",
            "verseOrgIds": [
              "DEU.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "diyi Herimoni atenaŋawu aZidoni nawu Siriyoni, atenaŋawu Amori nawu Seniri; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.9",
            "verseOrgIds": [
              "DEU.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyikala yamuchana yonsu, niGileyadi wejima, niBashani wejima lusu nikuSaleka naEdereyi, nyikala yamuwanta waOgi wakuBashani. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.10",
            "verseOrgIds": [
              "DEU.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa Ogi mwanta wakuBashani kanka windi hohu diyi washeluhu hadi aRefwa asheluhu; tiyenu, kadidi kindi kadiri kadidi kachikuŋu; hikashala muRabawa wanyana kaAmonuku? Mukuleha kwaku munkotweli jachikasa jitanuna jiwana, mukutoha munkotweli jachikasa jiwana, munkotweli yeyala.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.11",
            "verseOrgIds": [
              "DEU.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.11",
            "verseOrgIds": [
              "DEU.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamafuku ana twatambwili ituŋodu, tudiheta nikudiheta; kufumisha kuArowenai wakuma kuchinekineki chaArinoni, nichibalu chetuŋa daGileyadi damapidi, ninyikala yekalamu, nenkeli aRubeni nawaGadi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.12",
            "verseOrgIds": [
              "DEU.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "chibalu chaGileyadi chasheluku, niBashani wejima, wowanta waOŋi nenkeli muchidi waManase wachibalu; yoyi mpata yaArigobi yejima, kafwampi Bashani wejima. Dodatenaŋawu nawu ituŋa dawaRefwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.13",
            "verseOrgIds": [
              "DEU.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yayiri mwana kaManase watambwili mpata yaArigobi yejima, lusu nikuŋinza yawaGeshuri nawaMakati; watumbili Bashani ijina dindi yemweni, nindi, Havoti Yayiri, nilelu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.14",
            "verseOrgIds": [
              "DEU.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.14",
            "verseOrgIds": [
              "DEU.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makiri namwinkeli Gileyadi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.15",
            "verseOrgIds": [
              "DEU.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ARubeni nawaGadi nayinkeli mpatayakufumisha kuGileyadi lusu kuchinekineki chaArinoni, hohakachika chinekineki, niŋinza yayu; lusu nikukaloŋa Yaboki, yoyi ŋinza yawanyana kaAmoni; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.16",
            "verseOrgIds": [
              "DEU.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "nichana nawa, niYodana niŋinza yaku, kufumisha kuKineretilusu nikwijiya dakuchana, dodu ŋiya Damuŋwa, kwakunkumukila Pisiga, nikumusela.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.17",
            "verseOrgIds": [
              "DEU.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.17",
            "verseOrgIds": [
              "DEU.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nayilejeli henohu nami, Yehova Nzambi yenu nayinki dehi ituŋidi mwakadiheti; mwakazambukaŋahu dehi kumesu awana kwenu anyana kaIsarela, enu ayilobu ejima. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.18",
            "verseOrgIds": [
              "DEU.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwinza aŋodi jenu ni anyanenu anyanya niyimuna yenu, muloŋa neluki nami mukweti yimuna yayivulu, akashala munyikala yenu yinayinki; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.19",
            "verseOrgIds": [
              "DEU.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ninichi chamba kanookeshayi Yehova anakwenu neyi chanayinookeshiyi enu, hamba kahetawu niwena nawa ituŋa dakuyinkayi Yehova Nzambi yenu mwishinadi daYodana; dihu himwakafunta enu amayala ejima kumpata yenu yimunaheti yinayinki. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.20",
            "verseOrgIds": [
              "DEU.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hena hanana mulejeli Yoshuwa nami, Wunamoni namesu eyi mwejima mwanakoŋiyi Yehova Nzambi yenu awa anyanta ankanu ayedi; ninochu dimu mwakakoŋayi Yehova mawanta ejima oku kuwukuya. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.21",
            "verseOrgIds": [
              "DEU.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi wakayitiya womaku, muloŋa Yehova Nzambi yenu diyi wayilwilaŋa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.22",
            "verseOrgIds": [
              "DEU.3.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.22",
            "verseOrgIds": [
              "DEU.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henahana namulembeleleli Yehova, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.23",
            "verseOrgIds": [
              "DEU.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "nami, Eyi Mwanta Yehova wuna tachiki dehi kunmwekeshela ami kambuŋeyi nikutoha kweyi nichikasacheyi chaŋovu; ochu kudi mukishinyi hela mwiwulu hela hamaseki wukutweshakukoŋa nyidimu yakweseka nayeyeyi, hela kwila yuma yaŋovu yidi neyi welaŋeyi? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.24",
            "verseOrgIds": [
              "DEU.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋitiji mwani nizambuki nimonuhu ituŋa didi mwishinadi daYodana, odu ituŋa dadiwahi damapidi, niLebanoni. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.25",
            "verseOrgIds": [
              "DEU.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa Yehova wanzuwilili hanyijimba yenwenu, hapitiyiluku. Yehova wapilili, nindi, Kunahu dehi; bayi wuhosha cheŋi nanami nsaŋu iyuku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.26",
            "verseOrgIds": [
              "DEU.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandamaku hewulu daPisiga, wakafumbuli mesu eyi wakatali nikumujika nikukabetana kabeta, nikumusela, wakamoni namesu eyi, muloŋa eyi hiwakazambuka iwu Yodanaku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.27",
            "verseOrgIds": [
              "DEU.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
