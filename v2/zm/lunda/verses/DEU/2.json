            "number": "32",
            "style": "v",
            "sid": "DEU 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henahana Sihoni wenjili nakutwasa njita, niyena niantu indi ejima, kuYahazi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.32",
            "verseOrgIds": [
              "DEU.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DEU 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova Nzambi yetu watwinkeliyi kutwayili; twamutapiliniyena ni anyanindi amayala, niantu indi ejima. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.33",
            "verseOrgIds": [
              "DEU.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "DEU 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henahana twatambwilinyikala yindi yejima, twajilumwini chikupu nyikala yejima yashakaminuwu antu, niambanda nianyana anyanya kumu; hitwashiyili hoku muntuniwumuku; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.34",
            "verseOrgIds": [
              "DEU.2.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "DEU 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "twatambwiluku kwayimuna hohu netu yuma yakupuŋa, niyuma yamunyikala yitwapupili. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.35",
            "verseOrgIds": [
              "DEU.2.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "DEU 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hitwamweni mukala wutwakaŋenyina mpwembu kulehaku, kufumisha kuArowenai wekala kunsa yachinekineki chaArinoni, nikumukala wekala muchinekineki, lusu nikuGileyadi; Yehova Nzambi yetu watwinkeliyi yejima kutwayili; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.36",
            "verseOrgIds": [
              "DEU.2.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "DEU 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "ituŋa diwabulili kuswilakwakwihi dodawanyana kaAmoni dodishinadi daYaboki dejima, ninyikalayamwituŋa damapidi nikwejima kwatulekesheliyi Yehova Nzambi yetu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.37",
            "verseOrgIds": [
              "DEU.2.37"
            ]
          }
        }
