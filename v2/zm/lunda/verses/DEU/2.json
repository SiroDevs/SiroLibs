          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami natemesheli antemesha, afumini mwisaŋa dakuKedemoti ayilikudi Sihoni mwanta wakuHeshiboni namazu amawahi, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.26",
            "verseOrgIds": [
              "DEU.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "nami, Nlekinihiti mwituŋa deyi, nakahita kwamumukwakwa, hinakasenukamu niyahela kuchikasa chachidiilu hela kuchimunswaku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.27",
            "verseOrgIds": [
              "DEU.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakanlandisha yakudya namali kulonda nakadyi; wakanyinka meji akunwa namali; kumina dakunleka nihitumu kwananyendu yanji hohu; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.28",
            "verseOrgIds": [
              "DEU.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwomwaŋililuwuanyana kaEsawu ashakama muSeyiri, nawaMowabi ashakama muAri; ninichi chinakazambuka Yodana nakuya mwituŋa dakutwinkayi Yehova Nzambi yetu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.29",
            "verseOrgIds": [
              "DEU.2.29"
            ]
          }
        }
      ]
