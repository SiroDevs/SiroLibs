  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "JDG 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaIsarela ejima anyamukili hanyikala yawu, kufumisha kuDani nakushika kuBerisheba, niakwituŋa daGileyadi, apompeli chipompelu chejima kudi Yehova kuMizipa neyi muntu wumu hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.1",
            "verseOrgIds": [
              "JDG.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akulumpi jawantu ejima akunyichidi yaIsarela yejima enjili nakwimana muchipompelu chawantu aNzambi, akwakwenda heseki amayala makombakaji makulakaji awana akwakuhola mpoku jatubali. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.2",
            "verseOrgIds": [
              "JDG.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu anyana kaBenjamini achitiya dehi nawu anyana kaIsarela anayi kuMizipa. Anyana kaIsarela elili nawu, Tuleji dinu, indi ichichuma chatama achilili ŋahi? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.3",
            "verseOrgIds": [
              "JDG.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owu iyala kaLevi, nfumwamumbanda ajahiluwu, wayilejeli nindi, Ami nayili hamukala waGibeya waBenjamini, ninami nintombu yami, netutwakakami. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.4",
            "verseOrgIds": [
              "JDG.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amayala ahaGibeya anyamukili, hiyakwinza nandombukwitala kunadiŋi ami, kwitala dejima kwi-ndo antu hohu nawufuku. Ninami akeŋa kunjaha, hakwila ntombu yami amukakeja kukama nindi, wafwa dehi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.5",
            "verseOrgIds": [
              "JDG.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi natambwili ntombu yami, hinukumuteta, hinukumutemeshamwejima mwahita mpata yawuswana waIsarela. Muloŋa wenaanakoŋi chuma chatama chawusupi munu mumpata yaIsarela. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.6",
            "verseOrgIds": [
              "JDG.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wejimawenu yenu anyana kaIsarela hohu, hoshenu tutiyi maana enu nimpùŋa yenu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.7",
            "verseOrgIds": [
              "JDG.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.7",
            "verseOrgIds": [
              "JDG.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu ejima anyamuka nikakata, kakata, neyi muntu wumu hohu, ahosheli nawu, Hosi wukuya kwitenti dinduku, hosi wukuya nawa cheŋi hela kwitala dinduku. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.8",
            "verseOrgIds": [
              "JDG.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyenu namutukuyila aGibeya; tukudisakula nachinjikijilu kulonda tuyi nakulwa nawu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.9",
            "verseOrgIds": [
              "JDG.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tukwila hadi nkulakaji tunonahuamayala ikumi, hadi ikombakaji tunonahu amayala nkulakaji, hadi makombakaji ikumi tunonahu dimu, hanyichidi yawaIsarela yejima, ayi akaleti yakudya yawantu, kulonda chiyaka shikawu kuGibeya waBenjamini, akayi koŋi chakweseka mwashika wusupi wawu waneluwu munu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.10",
            "verseOrgIds": [
              "JDG.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi amayala awaIsarela ejima awupompeleli wena mukalowu namuchima wawu wumu neyi muntu wumu hohu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.11",
            "verseOrgIds": [
              "JDG.20.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.11",
            "verseOrgIds": [
              "JDG.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyichidi yaIsarela yatemesheli antu mwejima mwatuŋili muchidi waBenjamini, nakuyila nawu, Indi ichichuma chatama chanka chimuna koŋi munyikala yenu? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.12",
            "verseOrgIds": [
              "JDG.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu owu amayala, owu antu amukunkulwayi adi muGibeya, atwinkuwu kulonda tuyijahi, tufumishi kutama munumumpata yaIsarela. Ilaŋa Benjamini kwonti kwawu kutiya mwizu dawanakwawu anyana kaIsarela. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.13",
            "verseOrgIds": [
              "JDG.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaBenjamini anyamokeli munyikalayawu, apompeleli kuGibeya kulonda ayi akadasi njita nawanyana kaIsarela. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.14",
            "verseOrgIds": [
              "JDG.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaBenjamini afumini munyikala yawu, ayichindili dena ifukuodu adiŋi amayala makombakaji makumi ayedi natanu nadimu, akwakuhola mpoku jatubali, ahaGibeya kuyibombelahu nehi, wena kuyichinda adiŋi amayala makulakaji atanu nayedi akutonda akutonda. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.15",
            "verseOrgIds": [
              "JDG.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hadi wenawaantu ejima hadiŋi amayala makulakaji atanu nayedi akapiku akutonda akutonda, adiŋi eluka nankashi kwasa malola akwasa namwonji, hela kwasalusuki lwamuntu kululweza nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.16",
            "verseOrgIds": [
              "JDG.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amayala awaIsarela neyi kubulakubombelamu aBenjamini, kuyichinda adiŋi makombakaji makulakajiawana, amayala akwakuhola mpoku jatubali hohu. Wenawa wejima wawuadiŋi akwanjita.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.17",
            "verseOrgIds": [
              "JDG.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.17",
            "verseOrgIds": [
              "JDG.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaIsarela anyamukili nakuya kuBeteli nakulomba maana kudi Nzambi. Nawu, Indi wakasambila kuya nakutwasila njita nawanyana kaBenjamini hinyi? Yehova nindi, Wakasambila Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.18",
            "verseOrgIds": [
              "JDG.20.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.18",
            "verseOrgIds": [
              "JDG.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaIsarela anyamukili budidi, ayili nakutuŋila Gibeya chilombu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.19",
            "verseOrgIds": [
              "JDG.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amayala awaIsarela afumini muchilombu chawu, hiyakuya akadasinjita nawaBenjamini; amayala awaIsarela atanjikilili akwawu njita kuGibeya. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.20",
            "verseOrgIds": [
              "JDG.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaBenjamini afumini muGibeya, dena ifuku odu adimbwishili heseki aIsarela makombakaji makumi ayedi namakombakaji ayedi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.21",
            "verseOrgIds": [
              "JDG.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owu antu, owu amayala awaIsarela, adikwatishili, atanjikili cheŋi njita hohatandaminuwu ifuku dakusambila. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.22",
            "verseOrgIds": [
              "JDG.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaIsarela ayili nakudilakumesu aYehova dile-e nimelela. Amwihwili Yehova nawu, Niyi cheŋi nakadasi njita nawanyana kamana kwami Benjamini tahindi? Yehova nindi, Yaku, wakadasi nindi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.23",
            "verseOrgIds": [
              "JDG.20.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.23",
            "verseOrgIds": [
              "JDG.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaIsarela ayili cheŋi kwakwihi alwi nawanyana kaBenjamini ifuku damu chiyedi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.24",
            "verseOrgIds": [
              "JDG.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "ABenjamini afumini muGibeya ifuku damuchiyedi adasi nawu, adimbwishili heseki anyana kaIsarela cheŋi nawa, makombakaji ikumi natanu nasatu. Wenowu wejima wawu akwakuhola mpoku jatubalihohu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.25",
            "verseOrgIds": [
              "JDG.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaIsarela ejima, niantu ejima, ayili kuBeteli nakudilanakushakama kuna kumesu aYehova, nakushakama nanzala ifuku denodudejima shakame-e nimelela. Alambwili nyilambu yakushita ninyi lambuya kuwunda kumesu aYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.26",
            "verseOrgIds": [
              "JDG.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafuku owu chimbaŋu chachitiyaŋenu chaNzambi chadiŋi kwenoku, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.27",
            "verseOrgIds": [
              "JDG.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "niFwinehasi mwana kaEleyazari, yowumwana kaAroni, wemenuku mafuku owu, dichi anyana kaIsarela amwihwili Yehova, nawu, Niyi cheŋi nakadasi njita nawanyana kamana kwami Benjamini, tahindi nichileki? Yehova nindi, Yaku. Kumadiki nakakwinkayi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.28",
            "verseOrgIds": [
              "JDG.20.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.28",
            "verseOrgIds": [
              "JDG.20.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "AIsarela ashiluku akwakubelamina Gibeya kwi-ndo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.29",
            "verseOrgIds": [
              "JDG.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaIsarela ayili adasi nawanyana kaBenjamini ifuku damu chisatu, atandamini adasi naGibeya neyi hakusambila. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.30",
            "verseOrgIds": [
              "JDG.20.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaBenjamini afuminumuna kuya nakudasa nawantu, ayikokeleli kwakulehi namukala. Atachikili kutapa nakujaha antu neyi cheliluwu hakusambila, munyikwakwa wumuwowaya kuBeteli wukwawu wowaya kuGibeya, mumaha, amayala aIsarela kwiji neyi makumi asatu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.31",
            "verseOrgIds": [
              "JDG.20.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaBenjamini elili nawu, Nilelu tunayitapi neyi hakusambila. Ilaŋa nyana kaIsarela diwu elili nawu, Tutemukenu, tuyikokelenu kwakulehi namukala munyikwakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.32",
            "verseOrgIds": [
              "JDG.20.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JDG 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amayala ejima awaIsarela anyamukili mwadiŋuwu, atandamini kuBayali Tamari. Nia-Isarela abelaminini alundumukili mwadiŋuwu mwomunyihoŋi yakuGibeya. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.33",
            "verseOrgIds": [
              "JDG.20.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JDG 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amayala makombakaji ikumi aweni akutonda hadi aIsarela ejima ayilikwakwihi naGibeya, njita yisweja nikusweja, hakwila wena kwiluka nawukatama kayiwana dehi mwamwihi nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.34",
            "verseOrgIds": [
              "JDG.20.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 20:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova watapili aBenjamini kumesu awaIsarela. Ifuku odu anyana kaIsarela ajilumwini kudi aBenjamini amayala makombakaji makumi ayedi natanu, nankulakaji. Wena wawejima wawu adiŋi akwakuhola mpoku jatubali hohu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.35",
            "verseOrgIds": [
              "JDG.20.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 20:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.35",
            "verseOrgIds": [
              "JDG.20.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JDG 20:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi anyana kaBenjamini amweni nawu tunayitapi dehi. Muloŋa mayala awaIsarela ayitemukili aBenjamini, akuhweleli akwakubelamina abatamishiluwu kwakwihi naGibeya. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.36",
            "verseOrgIds": [
              "JDG.20.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JDG 20:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwakubelamina anyakeli, alundumukili nakuya kuGibeya, akwakubelamina ayiluku, atapili mukala wejimanampoku yakabali. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.37",
            "verseOrgIds": [
              "JDG.20.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JDG 20:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chuma chatiyaŋenuwu amayala awaIsarela nawakwakubelamina kulonda kwiluka nachu, nawu akafwindisha wishiwawuvulu hamukala neyi ivu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.38",
            "verseOrgIds": [
              "JDG.20.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JDG 20:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amayala awaIsarela hiya kutemuka kunjita, niaBenjamini hiyakutachika kuyitapa nakujaha amayala awaIsarela neyi kwiji antu makumi asatu; muloŋa elili nawu, Chalala tunayitapi neyichitwelili hanjita yakusambila. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.39",
            "verseOrgIds": [
              "JDG.20.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JDG 20:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa chiwelili wishi hiwukukakumuka hamukala neyi chishimi chawishi, aBenjamini niwena atalili hanyima, amweni mukala wejima wuna wukukakumuka owu, kwawishi hohu fwi-i. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.40",
            "verseOrgIds": [
              "JDG.20.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JDG 20:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amayala awaIsarela hiyakubalumuka cheŋi, amayala awaBenjamini kwakuha yama hohu kwawu, muloŋa amweni katama kanayiwani dehi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.41",
            "verseOrgIds": [
              "JDG.20.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JDG 20:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi ayitemukili amayala awaIsarela, hiyakuya njila yaya kwisaŋa. Ilaŋa njita yayilondeli naŋovu nakuyikuma munyima hohu. Niantu afumini munyikala ayikumaŋeneni nakuyijilisha. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.42",
            "verseOrgIds": [
              "JDG.20.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JDG 20:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayikumaŋeneni aBenjamini kwi-ndo, nakuyikupisha, nakuyidatola, chakadi nikumonakukala, kwakwihi nakuGibeya mutamba waholokaŋa itaŋwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.43",
            "verseOrgIds": [
              "JDG.20.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JDG 20:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adimbukili heseki aBenjamini amayala makombakaji ikumi natanu nasatu, wejima wawuayilobu hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.44",
            "verseOrgIds": [
              "JDG.20.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JDG 20:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalumukili, atemukili hiyakuya kwisaŋa kwilola dakuRimoni. Munyikwakwa ahuhojolelumu amayala makombakaji atanu. Ayilondeli naŋovu nakuyishikŋa kuGidomi, atapili amayala amakwawu makombakaji ayedi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.45",
            "verseOrgIds": [
              "JDG.20.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JDG 20:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.45",
            "verseOrgIds": [
              "JDG.20.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JDG 20:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nochu antu ejima aBenjamini adimbukili ifuku odu ashikili mumakombakaji makumi ayedi natanu, akwakuhola mpoku jatubali hohu. Wejima wawu adiŋi ayilobu hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.46",
            "verseOrgIds": [
              "JDG.20.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JDG 20:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa mayala makulakaji atanu nadimuabalu mukili cheŋi nakutemuka nakuya kwisaŋa kwilola dakuRimoni, ashakamini mwilola dakuRimoni tukweji tuwana. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.47",
            "verseOrgIds": [
              "JDG.20.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JDG 20:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amayala awaIsarela afuntili cheŋi kudi anyana kaBenjamini nakuyitapa nampoku yakabali, nimukala wejima ni ayimuna niyuma yejima yawenuwu. Ninyikala yejima yawenuwu ayocheli nakesi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.48",
            "verseOrgIds": [
              "JDG.20.48"
            ]
          }
        }
      ]
    }
  ],
