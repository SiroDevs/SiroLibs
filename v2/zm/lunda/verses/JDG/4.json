  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "JDG 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hafwiliyi Ehudi, anyana kaIsarela elili cheŋi chatama kumesu aYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.1",
            "verseOrgIds": [
              "JDG.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wayilandishili kudi Yabini mwanta waku-Kenani, wadiŋi mwanta muHazori, mukulumpi wanjita yindi wadiŋi Sisera, owu watupili muHarosheti wawajentili. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.2",
            "verseOrgIds": [
              "JDG.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaIsarela abileleli kudi Yehova, muŋa Yabini wadiŋi namakálu ayikupu makulakaji makumi atanu nawana; yena anyana kaIsarela wayikabishili naŋovu nyakamakumi ayedi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.3",
            "verseOrgIds": [
              "JDG.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaprofwetu Debora iŋoda Lapidoti hamafuku owu diyi wasompeshelapa mwituŋa daIsarela. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.4",
            "verseOrgIds": [
              "JDG.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena washakamini mwishina damukoma waDebora, Rama iku, Beteli iku, yena hakachi, mwituŋa daEfweremi damapidi; anyana kaIsarela ayilaŋa kudi yena nakuhosha nyiŋa yawu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.5",
            "verseOrgIds": [
              "JDG.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena watemesheli kuKedeshi Nafwatali nakutambika mwana kaAbinowami Baraka, wamwilili nindi, Yehova Nzambi yaIsarela, hanashimuni nindi, Yaŋa, kakundami kumpidi yaTabori, kasendi mayala makombakaji ikumi, nianyana kaNafwatali, nianyana kaZebulunu ku? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.6",
            "verseOrgIds": [
              "JDG.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninami nakakukokela Sisera, mukulumpi wanjita yaYabini, nimakálu indi niluntu lwindi kukaŋa Kishoni, nakakwinkayi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.7",
            "verseOrgIds": [
              "JDG.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baraka wamwilili nindi, Neyi eyi tukuya neyinukuya chi; hakwinza neyi kuya neyi nehi hinukuyaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.8",
            "verseOrgIds": [
              "JDG.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Welili nindi, Chalala nukuya neyi chi; ilaŋa njiloyu yiwukwenda hiyeyi wakatiyakenamumpuhuku; muŋa Yehova wakamulandisha Sisera kudi mumbanda. Debora wanyamukili, wayili naBaraka kuKedeshi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.9",
            "verseOrgIds": [
              "JDG.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baraka watambikilini aZebuluni niaNafwatali, nindi pompenu kuKedeshi. Ayili nindi amayala makombakaji ikumi; Debora niyena wayili nindi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.10",
            "verseOrgIds": [
              "JDG.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.10",
            "verseOrgIds": [
              "JDG.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heberi kaKeni, waambukili dehi nawaKeni anyana kaHobabi muku waMosi, walemeni itenti dindi kuna kumukula wamuZayanimi, wowuwekala kwakwihi nakuKedeshi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.11",
            "verseOrgIds": [
              "JDG.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.16",
            "verseOrgIds": [
              "JDG.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwinza Sisera watemukili heseki, wayili kwitenti daYahela iŋodaHeberi kaKeni, muloŋa Yabini mwanta wakuHazori namutaŋa waHeberi kaKeni, adikundili. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.17",
            "verseOrgIds": [
              "JDG.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahela wedi kili nakumukinkilila Sisera, wamwililinindi, Ipilaku mwanta wami, iŋilaku mwami, bayi wutiya womaku. Wepililimwitenti mwadiŋi yi, mumbanda wamubutili namwemba. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.18",
            "verseOrgIds": [
              "JDG.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena wamwilili nindi, Anyinki mwani, tumeji twantesha ninwi, natiyi mpwila. Wajikwili munswaha mwadiŋi mayeli, wamwinkeli, hakunwa, omubutani cheŋi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.19",
            "verseOrgIds": [
              "JDG.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena wamwilili nindi, Imanaku muchisu chetenti, wumoni muntu hakwinza nakukwihula nindi, Mwenomu mudi iyala? Eyi wumwilaŋaneyi, Mwosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.20",
            "verseOrgIds": [
              "JDG.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahela ujoda Heberi yonona nilubwambu lwetenti, yokwata nichuma chakupopa nachu kuchikasa chindi, hakuya chovu chovu kudi yena iyala, hakumupopa lubwambu mukanyiŋiketu, luhanuka zwani mumasekilwe, muloŋa yena wakamini tulu twatweni, wadiŋi wazeya dehi. Hakuhondomoka, hakufwa ni kufwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.21",
            "verseOrgIds": [
              "JDG.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chakuhitayi Baraka naleumuhaŋa Sisera, Yahela hakwidika nakumukinkilila, hakumwila nindi, Inzaŋa nikulejiiyala wunakeŋi. Hakuya nikudi yena, kutala Sisera iwu wunakami iwu, wafwa dehi zo-o, nilubwambu lwindi mukanyipiketu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.22",
            "verseOrgIds": [
              "JDG.4.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.22",
            "verseOrgIds": [
              "JDG.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi ifuku diŋa wamufumbili Yabini mwanta wakuKenani hakwovwahila anyana kaIsarela. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.23",
            "verseOrgIds": [
              "JDG.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaIsarela Ŋovu yawu hiyi kuswejani kusweja naYabini mwanta wakuKenani, nichiyamujilishiluwu to-o Yabinimwanta wakuKenani.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.24",
            "verseOrgIds": [
              "JDG.4.24"
            ]
          }
        }
      ]
    }
  ],
