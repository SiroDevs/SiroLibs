              "items": [
                {
                  "text": "1 Kor 1.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Jyewe Umukuru, ndakwandikiye Gayo ukundwa, uwo nkunda by'ukuri.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.1",
            "verseOrgIds": [
              "3JN.1.1"
            ]
          }
        }
