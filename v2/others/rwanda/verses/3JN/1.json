          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urasigare amahoro.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.15",
            "verseOrgIds": [
              "3JN.1.15"
            ]
          }
        }
