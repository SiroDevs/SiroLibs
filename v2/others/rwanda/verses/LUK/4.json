          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ariko abacamo aragenda.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.30",
            "verseOrgIds": [
              "LUK.4.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu akiza umuntu utewe na dayimoni",
          "type": "text"
        }
      ]
    },
    {
