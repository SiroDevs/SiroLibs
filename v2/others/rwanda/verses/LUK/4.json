          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "aramubwira ati “Ndaguha ubu butware bwose n'ikuzo ryabwo, kuko ari jye wabugabanye kandi mbugabira uwo nshaka wese. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.6",
            "verseOrgIds": [
              "LUK.4.6"
            ]
          }
        },
