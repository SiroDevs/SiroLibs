        },
        {
          "text": "Yesu yuzuzwa Umwuka Wera, ava kuri Yorodani ajyanwa n'Umwuka mu butayu, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.1",
            "verseOrgIds": [
              "LUK.4.1"
            ]
          }
        },
