            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.5.1+2KI.5.2+2KI.5.3+2KI.5.4+2KI.5.5+2KI.5.6+2KI.5.7+2KI.5.8+2KI.5.9+2KI.5.10+2KI.5.11+2KI.5.12+2KI.5.13+2KI.5.14"
              },
              "items": [
                {
                  "text": "2 Abami 5.1-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kandi hāriho ababembe benshi mu Bisirayeli mu gihe cy'umuhanuzi Elisa, nyamara ntihakizwa n'umwe muri bo keretse Nāmani w'Umusiriya.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.27",
            "verseOrgIds": [
              "LUK.4.27"
            ]
          }
        }
