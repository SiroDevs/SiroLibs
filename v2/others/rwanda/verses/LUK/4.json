          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu asubira i Galilaya afite imbaraga z'Umwuka, inkuru ye yamamara mu bihugu byose bihereranye n'aho. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.14",
            "verseOrgIds": [
              "LUK.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yigishiriza mu masinagogi yabo, bose baramuhimbaza.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.15",
            "verseOrgIds": [
              "LUK.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ab'i Nazareti bashaka kwica Yesu",
          "type": "text"
        }
      ]
    },
