              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.17.8+1KI.17.9+1KI.17.10+1KI.17.11+1KI.17.12+1KI.17.13+1KI.17.14+1KI.17.15+1KI.17.16"
              },
              "items": [
                {
                  "text": "1 Abami 17.8-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nyamara Eliya ntiyatumwa kuri umwe muri bo, ahubwo atumwa ku mugore w'umupfakazi w'i Sarefati mu gihugu cy'i Sidoni. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.26",
            "verseOrgIds": [
              "LUK.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 4:27"
          },
          "items": [
            {
              "text": "27",
