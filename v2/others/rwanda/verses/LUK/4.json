            "number": "21",
            "style": "v",
            "sid": "LUK 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko atangira kubabwira ati “Uyu munsi ibyo byanditswe bisohoye mu matwi yanyu.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.21",
            "verseOrgIds": [
              "LUK.4.21"
            ]
          }
        }
