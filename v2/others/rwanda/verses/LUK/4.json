            "number": "20",
            "style": "v",
            "sid": "LUK 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaze kubumba igitabo agisubiza umurinzi w'inzu, aricara. Abantu bose bari mu isinagogi baramutumbira. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.20",
            "verseOrgIds": [
              "LUK.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
