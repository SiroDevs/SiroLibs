              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ba banzi banjye batakunze ko mbategeka, nimubazane hano mubīcire imbere yanjye.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.27",
