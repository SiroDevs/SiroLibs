          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abafarisayo bari muri iryo teraniro baramubwira bati “Mwigisha, cyaha abigishwa bawe.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.39",
            "verseOrgIds": [
              "LUK.19.39"
            ]
          }
        }
      ]
    },
    {
