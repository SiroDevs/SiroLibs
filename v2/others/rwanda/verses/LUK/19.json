            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.28",
            "verseOrgIds": [
              "LUK.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ageze bugufi bw'i Betifage n'i Betaniya ku musozi witwa Elayono, atuma babiri bo mu bigishwa be ati ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.29",
            "verseOrgIds": [
              "LUK.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mujye mu kirorero kiri imbere yanyu, nimwinjiramo muri bubone icyana cy'indogobe kiziritse, kitigeze guheka umuntu. Nuko mukiziture mukizane. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.30",
            "verseOrgIds": [
              "LUK.19.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nihagira umuntu ubabaza ati ‘Murakiziturira iki?’ Mumubwire mutya muti ‘Databuja ni we ugishaka.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.31",
            "verseOrgIds": [
              "LUK.19.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
