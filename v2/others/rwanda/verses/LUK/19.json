          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.31",
            "verseOrgIds": [
              "LUK.19.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izo ntumwa ziragenda zibisanga nk'uko yazibwiye. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.32",
            "verseOrgIds": [
              "LUK.19.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakizitura icyana cy'indogobe, ba nyiracyo barababaza bati “Murakiziturira iki?”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.33",
            "verseOrgIds": [
              "LUK.19.33"
            ]
          }
        }
      ]
    },
