          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arabasubiza ati “Ndababwira yuko aba bahoze, amabuye yarangurura.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.40",
