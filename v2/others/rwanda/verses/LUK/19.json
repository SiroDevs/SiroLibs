            "sid": "LUK 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yenda kugera mu ibanga rw'umusozi wa Elayono, iteraniro rinini ry'abigishwa be bose batangira kunezerwa, no guhimbarisha Imana ijwi rirenga ku bw'ibitangaza babonye byose bati",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.37",
            "verseOrgIds": [
              "LUK.19.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
