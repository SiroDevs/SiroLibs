          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ageze hafi abona umurwa arawuririra ati ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.41",
            "verseOrgIds": [
              "LUK.19.41"
            ]
          }
