          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barabasubiza bati “Databuja ni we ugishaka.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.34",
            "verseOrgIds": [
              "LUK.19.34"
            ]
          }
        },
        {
          "name": "verse",
