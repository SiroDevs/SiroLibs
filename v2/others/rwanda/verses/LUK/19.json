              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaze kuvuga ibyo ajya imbere, azamuka i Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.28",
            "verseOrgIds": [
              "LUK.19.28"
            ]
