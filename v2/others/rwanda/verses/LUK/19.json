              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yinjira mu rusengero atangira kwirukana abaguriragamo, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.45",
            "verseOrgIds": [
              "LUK.19.45"
            ]
