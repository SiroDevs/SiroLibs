          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bose bakazinduka mu gitondo, bakajya aho ari mu rusengero kumwumva.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.38",
