            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Iminsi yose yirirwaga mu rusengero yigisha, ariko bwakwira agasohoka akarara ku musozi witwa Elayono. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.37",
            "verseOrgIds": [
              "LUK.21.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
