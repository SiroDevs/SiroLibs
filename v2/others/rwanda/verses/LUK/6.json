            "verseId": "LUK.6.1",
            "verseOrgIds": [
              "LUK.6.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.23.26"
              },
              "items": [
                {
                  "text": "Guteg 23.26",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku munsi w'isabato agenda anyura mu mirima y'amasaka, abigishwa be baca amahundo, bayavunga mu ntoki zabo barayahekenya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.1",
            "verseOrgIds": [
              "LUK.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Abafarisayo bamwe barababaza bati “Ni iki gitumye mukora ibizira ku isabato?”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.2",
            "verseOrgIds": [
              "LUK.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.2",
            "verseOrgIds": [
              "LUK.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
