          "attrs": {
            "verseId": "LUK.6.22",
            "verseOrgIds": [
              "LUK.6.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.4.14"
              },
              "items": [
                {
                  "text": "1 Pet 4.14",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Muzahirwa abantu nibabanga bakabaha akato, bakabatuka, bakanegura izina ryanyu nk'aho ari ribi, babahora Umwana w'umuntu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.22",
            "verseOrgIds": [
