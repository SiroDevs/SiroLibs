              "LUK.6.39"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.15.14"
              },
              "items": [
                {
                  "text": "Mat 15.14",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abacira n'umugani ati “Mbese impumyi yabasha kurandata indi mpumyi? Mbese zombi ntizagwa mu mwobo? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.39",
            "verseOrgIds": [
              "LUK.6.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 6:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.24+MAT.10.25"
              },
              "items": [
                {
                  "text": "Mat 10.24-25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.13.16"
              },
              "items": [
                {
                  "text": "Yoh 13.16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.20"
              },
              "items": [
                {
                  "text": "15.20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Umwigishwa ntaruta umwigisha, ahubwo umwigishwa wese iyo atunganye rwose mu byo yigishijwe, amera nk'umwigisha we.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.40",
            "verseOrgIds": [
              "LUK.6.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 6:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.40",
            "verseOrgIds": [
              "LUK.6.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 6:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ni iki gituma ureba agatotsi kari mu jisho rya mwene so, ukirengagiza umugogo uri mu jisho ryawe? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.41",
            "verseOrgIds": [
              "LUK.6.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 6:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabasha ute kubwira mwene so uti ‘Mwene data, henga ngutokore agatotsi kari mu jisho ryawe’, nawe nturebe umugogo uri mu ryawe? Wa ndyarya we, banza wikuremo umugogo uri mu jisho ryawe, abe ari ho ubona uko utokora agatotsi kari mu jisho rya mwene so.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.42",
            "verseOrgIds": [
              "LUK.6.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 6:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.42",
            "verseOrgIds": [
              "LUK.6.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 6:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kuko ari nta giti cyiza cyera imbuto mbi, cyangwa igiti kibi cyera imbuto nziza. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.43",
            "verseOrgIds": [
              "LUK.6.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 6:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.33"
              },
              "items": [
                {
                  "text": "Mat 12.33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Igiti cyose kimenyekanishwa n'imbuto zacyo: ntibasoroma imbuto z'umutini ku mugenge, cyangwa imizabibu ku mufatangwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.44",
            "verseOrgIds": [
              "LUK.6.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 6:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.35"
              },
              "items": [
                {
                  "text": "Mat 12.35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Umuntu mwiza atanga ibyiza abikuye mu butunzi bwiza bwo mu mutima we, n'umuntu mubi atanga ibibi abikuye mu butunzi bwe bubi, kuko ibyuzuye mu mutima ari byo akanwa kavuga.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.45",
            "verseOrgIds": [
              "LUK.6.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 6:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
