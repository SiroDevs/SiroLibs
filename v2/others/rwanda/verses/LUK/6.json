              "LUK.6.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.21.1+1SA.21.2+1SA.21.3+1SA.21.4+1SA.21.5+1SA.21.6"
              },
              "items": [
                {
                  "text": "1 Sam 21.1-6",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yesu arabasubiza ati “Ntimwari mwasoma icyo Dawidi yakoze, ubwo yasonzaga we n'abo bari bari kumwe, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.3",
            "verseOrgIds": [
              "LUK.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.24.9"
              },
              "items": [
                {
                  "text": "Lewi 24.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ko yinjiye mu nzu y'Imana akenda imitsima yo kumurikwa akayirya, akayiha n'abo bari bari kumwe amategeko atemeye ko abandi bayirya, keretse abatambyi bonyine?”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.4",
            "verseOrgIds": [
              "LUK.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.4",
            "verseOrgIds": [
              "LUK.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi arababwira ati “Umwana w'umuntu ni Umwami w'isabato.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.5",
            "verseOrgIds": [
              "LUK.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akiza umuntu unyunyutse ukuboko ku munsi w'isabato",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.5",
            "verseOrgIds": [
              "LUK.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ku yindi sabato yinjira mu isinagogi arigisha. Asangamo umuntu unyunyutse ukuboko kw'iburyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.6",
            "verseOrgIds": [
              "LUK.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanditsi n'Abafarisayo bagenza Yesu ngo barebe ko amukiza ku isabato, babone uko bamurega. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.7",
            "verseOrgIds": [
              "LUK.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko amenya ibyo batekereza, abwira uwo muntu unyunyutse ukuboko ati “Haguruka uhagarare hagati mu bantu.” Arahaguruka arahagarara. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.8",
            "verseOrgIds": [
              "LUK.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yesu arababwira ati “Ndababaza yuko amategeko yemera gukora neza ku isabato cyangwa ko akora nabi, gukiza umuntu cyangwa kumwica?” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.9",
            "verseOrgIds": [
              "LUK.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abararanganyamo amaso bose abwira wa wundi ati “Rambura ukuboko kwawe.” Arakurambura kurakira.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.10",
            "verseOrgIds": [
              "LUK.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.10",
            "verseOrgIds": [
              "LUK.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze bazabiranywa n'uburakari, bajya inama y'uko bazagenza Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.11",
            "verseOrgIds": [
              "LUK.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Atoranya intumwa cumi n'ebyiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.11",
            "verseOrgIds": [
              "LUK.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko muri iyo minsi avayo ajya ku musozi gusenga, akesha ijoro asenga Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.12",
            "verseOrgIds": [
              "LUK.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijoro rikeye ahamagara abigishwa be, atoranyamo cumi na babiri abita intumwa: ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.13",
            "verseOrgIds": [
              "LUK.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoni uwo yise Petero na Andereya mwene se, na Yakobo na Yohana, na Filipo na Barutolomayo, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.14",
            "verseOrgIds": [
              "LUK.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Matayo na Toma na Yakobo mwene Alufayo, na Simoni witwa Zelote ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.15",
            "verseOrgIds": [
              "LUK.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Yuda mwene Yakobo, na Yuda Isikariyota wahindutse umugambanyi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.16",
            "verseOrgIds": [
              "LUK.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.16",
            "verseOrgIds": [
              "LUK.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amanukana na bo, ahagarara aharinganiye ari kumwe n'abigishwa be benshi, n'abantu benshi bavuye i Yudaya hose n'i Yerusalemu, no mu gihugu cy'i Tiro n'i Sidoni gihereranye n'Inyanja Nini, bazanywe no kumwumva no gukizwa indwara zabo, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.17",
            "verseOrgIds": [
              "LUK.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi n'abababazwaga n'abadayimoni arabakiza. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.18",
            "verseOrgIds": [
              "LUK.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bose bashaka kumukoraho, kuko imbaraga yamuvagamo ikabakiza bose.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.19",
            "verseOrgIds": [
              "LUK.6.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu yerekana abahiriwe abo ari bo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.19",
            "verseOrgIds": [
              "LUK.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuburira abigishwa be amaso arababwira ati",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.20",
            "verseOrgIds": [
              "LUK.6.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 6:21"
          },
          "items": [
