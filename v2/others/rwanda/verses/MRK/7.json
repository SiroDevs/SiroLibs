                "loc": "ISA.29.13"
              },
              "items": [
                {
                  "text": "Yes 29.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Arabasubiza ati “Yesaya yahanuye ibyanyu neza mwa ndyarya mwe, nk'uko byanditswe ngo",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.6",
            "verseOrgIds": [
              "MRK.7.6"
            ]
          }
        }
