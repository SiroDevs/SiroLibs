          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayifata ukuboko ayisohokana mu kirorero, acira amacandwe mu maso yayo, ayirambikaho ibiganza arayibaza ati “Hari icyo ureba?”",
          "type": "text",
          "attrs": {
