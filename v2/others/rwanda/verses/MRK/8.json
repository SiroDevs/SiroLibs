          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Yesu ahindukiye areba abigishwa be, acyaha Petero aramubwira ati “Subira inyuma yanjye Satani, kuko ibyo wibwira atari iby'Imana, ahubwo ari iby'abantu.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.33",
            "verseOrgIds": [
              "MRK.8.33"
            ]
          }
        }
