          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu ahaza abantu ibihumbi bine",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muri iyo minsi abantu benshi bongeye guterana ntibabona ibyokurya, ahamagara abigishwa be arababwira ati ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.1",
            "verseOrgIds": [
              "MRK.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aba bantu banteye impuhwe kuko uyu munsi ari uwa gatatu turi kumwe, none bakaba badafite ibyo kurya. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.2",
            "verseOrgIds": [
              "MRK.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimbasezerera ngo basubire iwabo biriwe ubusa, baragwira isari mu nzira kuko bamwe ari aba kure.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.3",
            "verseOrgIds": [
              "MRK.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.3",
            "verseOrgIds": [
              "MRK.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abigishwa be baramubaza bati “Umuntu yabasha ate guhaza aba bantu imitsima, ko hano ari mu butayu hatagira abantu?”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.4",
            "verseOrgIds": [
              "MRK.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.4",
            "verseOrgIds": [
              "MRK.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na we arababaza ati “Mufite imitsima ingahe?” Baramusubiza bati “Ni irindwi.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.5",
            "verseOrgIds": [
              "MRK.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.5",
            "verseOrgIds": [
              "MRK.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ategeka abantu ko bicara hasi, yenda iyo mitsima irindwi arayishimira, arayimanyagura ayiha abigishwa be ngo bayibashyire, barayibaha. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.6",
            "verseOrgIds": [
              "MRK.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bari bafite n'udufi duke na two aradushimira, ategeka ko batubaha. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.7",
            "verseOrgIds": [
              "MRK.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bararya barahaga, bateranya ubuvungukira busigaye bwuzura ibitebo birindwi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.8",
            "verseOrgIds": [
              "MRK.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bari nk'ibihumbi bine, arabasezerera. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.9",
            "verseOrgIds": [
              "MRK.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo mwanya yikirana mu bwato n'abigishwa be, ajya mu mpande z'i Dalumanuta.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.10",
            "verseOrgIds": [
              "MRK.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Umusemburo w'Abafarisayo ni wo nyigisho yabo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.10",
            "verseOrgIds": [
              "MRK.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.11",
            "verseOrgIds": [
              "MRK.8.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.38"
              },
              "items": [
                {
                  "text": "Mat 12.38",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.11.16"
              },
              "items": [
                {
                  "text": "Luka 11.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Abafarisayo baraza batangira kumugisha impaka, bamushakaho ikimenyetso kivuye mu ijuru bamugerageza. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.11",
            "verseOrgIds": [
              "MRK.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.39"
              },
              "items": [
                {
                  "text": "Mat 12.39",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.11.29"
              },
              "items": [
                {
                  "text": "Luka 11.29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Asuhuza umutima cyane ati “Ab'iki gihe bashakira iki ikimenyetso? Ndababwira ukuri yuko ab'iki gihe nta kimenyetso bazahabwa.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.12",
            "verseOrgIds": [
              "MRK.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.12",
            "verseOrgIds": [
              "MRK.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasiga aho yongera kwikira mu bwato, ajya hakurya.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.13",
            "verseOrgIds": [
              "MRK.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.13",
            "verseOrgIds": [
              "MRK.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko bari bibagiwe kujyana imitsima nta yo bari bafite mu bwato keretse umwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.14",
            "verseOrgIds": [
              "MRK.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.1"
              },
              "items": [
                {
                  "text": "Luka 12.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Arabahana arababwira ati“Mumenye, mwirinde umusemburo w'Abafarisayo n'umusemburo wa Herode.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.15",
            "verseOrgIds": [
              "MRK.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.15",
            "verseOrgIds": [
              "MRK.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barabazanya bati “Ahari ni kuko tudafite umutsima.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.16",
            "verseOrgIds": [
              "MRK.8.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.16",
            "verseOrgIds": [
              "MRK.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu arabimenya arababaza ati “Igitumye mubazanya ni uko mudafite imitsima? Mbese ntimurajijuka ngo musobanukirwe? Mbega imitima yanyu iracyanangiwe! ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.17",
            "verseOrgIds": [
              "MRK.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.5.21"
              },
              "items": [
                {
                  "text": "Yer 5.21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.12.2"
              },
              "items": [
                {
                  "text": "Ezek 12.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.4.12"
              },
              "items": [
                {
                  "text": "Mar 4.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kuko mufite amaso ntimurebe, mufite amatwi ntimwumve! Mbese ye ntimwibuka? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.18",
            "verseOrgIds": [
              "MRK.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubwo namanyuriraga abantu ibihumbi bitanu ya mitsima itanu, mwateranyije ubuvungukira bwuzura intonga zingahe?”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.19",
            "verseOrgIds": [
              "MRK.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramusubiza bati “Ni cumi n'ebyiri.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.19",
            "verseOrgIds": [
              "MRK.8.19"
            ]
          }
        }
      ]
    },
