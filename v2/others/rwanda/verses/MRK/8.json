              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aherako abigisha uburyo Umwana w'umuntu akwiriye kuzababazwa uburyo bwinshi, akangwa n'abakuru n'abatambyi bakuru n'abanditsi akicwa, hashira iminsi itatu akazuka. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.31",
            "verseOrgIds": [
              "MRK.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avuga iryo jambo aryeruye, nuko Petero aramwihererana atangira kumuhana. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.32",
            "verseOrgIds": [
              "MRK.8.32"
            ]
          }
        },
