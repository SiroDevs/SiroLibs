            "sid": "MRK 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bose baratangara barabazanya bati “Ibi ni ibiki? Ko ari imyigishirize y'inzaduka! Mbega uburyo ategekana ubutware, n'abadayimoni na bo baramwumvira!”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.27",
            "verseOrgIds": [
              "MRK.1.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
