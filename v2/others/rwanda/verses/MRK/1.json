          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Duhuriye he Yesu w'i Nazareti? Uje kuturimbura? Ndakuzi uri uwera w'Imana.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.24",
            "verseOrgIds": [
              "MRK.1.24"
            ]
          }
        }
