          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "ab'umudugudu wose bateranira ku irembo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.33",
            "verseOrgIds": [
              "MRK.1.33"
            ]
          }
        },
