          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akiza benshi bari barwaye indwara zitari zimwe, yirukana abadayimoni benshi, ntiyabakundira ko bavuga kuko bari bamuzi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.34",
            "verseOrgIds": [
              "MRK.1.34"
            ]
          }
        }
      ]
    },
