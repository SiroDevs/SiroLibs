              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu isinagogi yabo harimo umuntu utewe na dayimoni, arataka cyane ati ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.23",
            "verseOrgIds": [
              "MRK.1.23"
            ]
          }
        },
