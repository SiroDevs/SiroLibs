            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Timoteyo dukorana arabatashyanya na Lukiyosi, na Yasoni na Sosipatiro dusangiye ubwoko.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.21",
