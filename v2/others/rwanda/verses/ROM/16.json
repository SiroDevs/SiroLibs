              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.16",
            "verseOrgIds": [
              "ROM.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko bene Data, ndabinginga ngo mwirinde abazana ibyo gutandukanya n'ibigusha binyurana n'ibyo mwize, mubazibukire ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.17",
            "verseOrgIds": [
              "ROM.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko abameze batyo atari imbata z'Umwami wacu Kristo, ahubwo ari iz'inda zabo, kandi imitima y'abatagira uburiganya bayohesha amagambo meza n'ibyo kubanezeza. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.18",
            "verseOrgIds": [
              "ROM.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igitumye mbabwira ibyo ni uko kumvira Imana kwanyu kwamamaye mu bantu bose. Ni cyo gitumye mbīshimira, ariko ndashaka ko muba abanyabwenge mu byiza mukaba abaswa mu bibi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.19",
            "verseOrgIds": [
              "ROM.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana nyir'amahoro izamenagurira Satani munsi y'ibirenge byanyu bidatinze.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.20",
            "verseOrgIds": [
              "ROM.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
