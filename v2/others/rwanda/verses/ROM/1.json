                "loc": "ACT.19.21"
              },
              "items": [
                {
                  "text": "Ibyak 19.21",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ariko bene Data, sinshaka ko mutamenya yuko kenshi nagambiriraga kuza iwanyu, ngo mbone imbuto muri mwe namwe nko mu yandi mahanga, ariko ngira ibisībya kugeza na n'ubu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.13",
            "verseOrgIds": [
              "ROM.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abagiriki n'abatari Abagiriki, abanyabwenge n'abaswa mbafiteho umwenda, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.14",
            "verseOrgIds": [
              "ROM.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni cyo gituma ku bwanjye nshaka kubabwira ubutumwa bwiza namwe abari i Roma.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.15",
            "verseOrgIds": [
              "ROM.1.15"
            ]
          }
        }
      ]
    },
    {
