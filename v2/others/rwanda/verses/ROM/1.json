              "type": "text"
            }
          ]
        },
        {
          "text": "n'abatukana, n'abanga Imana n'abanyagasuzuguro, n'abīrarīra n'abahimba ibibi, n'abatumvira ababyeyi ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.30",
