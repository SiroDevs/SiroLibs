    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pawulo imbata ya Yesu Kristo, wahamagariwe kuba intumwa, kandi watoranirijwe ubutumwa bwiza bw'Imana, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.1",
            "verseOrgIds": [
              "ROM.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ubwo yasezeranije kera mu kanwa k'abahanuzi bayo mu byanditswe byera, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.2",
            "verseOrgIds": [
              "ROM.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "buvuga iby'Umwana wayo wavutse mu rubyaro rwa Dawidi ku mubiri, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.3",
            "verseOrgIds": [
              "ROM.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi werekanywe n'ubushobozi ko ari Umwana w'Imana mu buryo bw'Umwuka Wera bigahamywa no kuzuka kwe, ni we Yesu Kristo Umwami wacu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.4",
            "verseOrgIds": [
              "ROM.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni we waduhesheje igikundiro no kuba intumwa ku bw'izina rye, kugira ngo mu mahanga yose habemo abumvira Imana babiheshwa no kwizera, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.5",
            "verseOrgIds": [
              "ROM.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi namwe muri muri bo, abahamagariwe kuba aba Yesu Kristo, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.6",
            "verseOrgIds": [
              "ROM.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndabandikiye abari i Roma mwese bakundwa n'Imana, bahamagariwe kuba abera.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.7",
            "verseOrgIds": [
              "ROM.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubuntu bube muri mwe n'amahoro biva ku Mana Data wa twese, no ku Mwami wacu Yesu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.7",
            "verseOrgIds": [
              "ROM.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.7",
            "verseOrgIds": [
              "ROM.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irya mbere mwese mbashimiye Imana yanjye muri Yesu Kristo, kuko kwizera kwanyu kwamamaye mu isi yose. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.8",
            "verseOrgIds": [
              "ROM.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana nkorera mu mutima wanjye mvuga ubutumwa bwiza bw'Umwana wayo, ni yo ntanze ho umugabo yuko mbasabira urudaca uko nsenze, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.9",
            "verseOrgIds": [
              "ROM.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ngo naho byamera bite, Imana yemere kungendesha amahoro ubu ikangeza iwanyu, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.10",
            "verseOrgIds": [
              "ROM.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko nifuza kubonana namwe kugira ngo mbahe impano y'Umwuka ngo ibakomeze, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.11",
            "verseOrgIds": [
              "ROM.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "tubone uko duhumurizanya mwebwe nanjye, mpumurizwe no kwizera kwanyu namwe mube muhumurijwe n'ukwanjye.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.12",
            "verseOrgIds": [
              "ROM.1.12"
            ]
          }
        }
      ]
    },
