        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1PE 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petero intumwa ya Yesu Kristo, ndabandikiye mwebwe abimukira b'intore bo mu batataniye i Ponto n'i Galatiya, n'i Kapadokiya no muri Asiya n'i Bituniya, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.1",
            "verseOrgIds": [
              "1PE.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1PE 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwatoranijwe nk'uko Imana Data wa twese yabamenye kera mubiheshejwe no kwezwa n'Umwuka, kugira ngo mwumvire Imana muminjagirwe amaraso ya Yesu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.2",
            "verseOrgIds": [
              "1PE.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1PE 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubuntu n'amahoro bigwire muri mwe.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.2",
            "verseOrgIds": [
              "1PE.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ishimwe ry'ibyiringiro by'agakiza",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1PE 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.2",
            "verseOrgIds": [
              "1PE.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1PE 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana y'Umwami wacu Yesu Kristo, ari na yo Se, ishimwe kuko yatubyaye ubwa kabiri nk'uko imbabazi zayo nyinshi ziri, kugira ngo tugire ibyiringiro bizima tubiheshejwe no kuzuka kwa Yesu Kristo, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.3",
            "verseOrgIds": [
              "1PE.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1PE 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "tuzabone umurage utabasha kubora cyangwa kwandura cyangwa kugajuka, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.4",
            "verseOrgIds": [
              "1PE.1.4"
            ]
          }
        },
        {
          "text": " mwabikiwe mu ijuru, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.4",
            "verseOrgIds": [
              "1PE.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1PE 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwebwe abarindwa n'imbaraga z'Imana ku bwo kwizera, murindirwa agakiza kiteguwe kuzahishurwa mu gihe cy'imperuka.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.5",
            "verseOrgIds": [
              "1PE.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1PE 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.5",
            "verseOrgIds": [
              "1PE.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1PE 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni cyo gituma mwishima, nubwo ahari mukwiriye kumara igihe gito mubabazwa n'ibibagerageza byinshi, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.6",
            "verseOrgIds": [
              "1PE.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1PE 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ngo kwizera kwanyu kugaragare ko kurusha izahabu igiciro cyinshi (kandi izahabu nubwo ishira igeragereshwa umuriro), kandi kugira ngo kwizera kwanyu kugaragare ko ari uk'ukuri, amaherezo kuzabahesha ishimwe n'ubwiza n'icyubahiro ubwo Yesu Kristo azahishurwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.7",
            "verseOrgIds": [
              "1PE.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1PE 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo mumukunda mutaramubona, kandi nubwo none mutamureba muramwizera, ni cyo gituma mwishima ibyishimo byiza bitavugwa, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.8",
            "verseOrgIds": [
              "1PE.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1PE 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko muhabwa agakiza k'ubugingo bwanyu ari ko ngororano yo kwizera kwanyu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.9",
            "verseOrgIds": [
              "1PE.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1PE 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.9",
            "verseOrgIds": [
              "1PE.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1PE 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abahanuzi bahanuye iby'ako gakiza barondora n'iby'ubuntu mwari mugiye kuzahabwa babishimikiriye, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.10",
            "verseOrgIds": [
              "1PE.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1PE 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "barondora igihe icyo ari cyo n'ibimenyetso byacyo, byerekanwaga n'Umwuka wa Kristo wari muri bo agahamya imibabaro ya Kristo itari yaba, n'ubwiza bw'uburyo bwinshi bwari bugiye kuyiheruka. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.11",
            "verseOrgIds": [
              "1PE.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi bahishurirwa yuko batabyiyerekewe ahubwo ko ari mwe babyerekewe. Ibyo none mumaze kubibwirwa n'ababwirije ubutumwa bwiza, babwirijwe n'Umwuka Wera woherejwe ava mu ijuru, kandi ibyo abamarayika babigirira amatsiko bashaka kubirunguruka.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.12",
            "verseOrgIds": [
              "1PE.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ibyo kwera mu ngeso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.12",
            "verseOrgIds": [
              "1PE.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1PE 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko mukenyere mu mitima yanyu, mwirinde ibisindisha, mwiringire rwose impano y'ubuntu muzazanirwa, ubwo Yesu Kristo azahishurwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.13",
            "verseOrgIds": [
              "1PE.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1PE 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mube nk'abana bumvira, ntimwishushanye n'irari mwagiraga kera mukiri injiji. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.14",
            "verseOrgIds": [
              "1PE.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1PE 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahubwo nk'uko uwabahamagaye ari uwera, abe ari ko namwe muba abera mu ngeso zanyu zose. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.15",
            "verseOrgIds": [
              "1PE.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1PE 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.11.44+LEV.11.45"
              },
              "items": [
                {
                  "text": "Lewi 11.44-45",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.2"
              },
              "items": [
                {
                  "text": "19.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kuko byanditswe ngo “Muzabe abera kuko ndi uwera.”",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.16",
            "verseOrgIds": [
              "1PE.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1PE 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.16",
            "verseOrgIds": [
              "1PE.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1PE 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ubwo uwo mwambaza mumwita So, ari ucira umuntu wese urubanza rukwiriye ibyo yakoze ntarobanure ku butoni, mumare iminsi y'ubusuhuke bwanyu mutinya. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.17",
            "verseOrgIds": [
              "1PE.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1PE 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko muzi yuko ibyo mwacungujwe ngo muve mu ngeso zanyu zitagira umumaro mwatojwe na ba sekuruza banyu, atari ibyangirika nk'ifeza cyangwa izahabu, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.18",
            "verseOrgIds": [
              "1PE.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1PE 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahubwo mwacungujwe amaraso y'igiciro cyinshi, nk'ay'umwana w'intama utagira inenge cyangwa ibara, ari yo ya Kristo ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.19",
            "verseOrgIds": [
              "1PE.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1PE 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "wamenywe n'Imana kera isi itararemwa, ariko akerekanwa ku mperuka y'ibihe ku bwanyu, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.20",
            "verseOrgIds": [
              "1PE.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1PE 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "abo yahaye kwizera Imana yamuzuye ikamuha icyubahiro, kugira ngo kwizera kwanyu n'ibyiringiro byanyu bibe ku Mana.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.21",
            "verseOrgIds": [
              "1PE.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1PE 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.21",
            "verseOrgIds": [
              "1PE.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1PE 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero ubwo mwiyejesheje imitima kumvira ukuri kugira ngo mubone uko mukunda bene Data mutaryarya, mukundane cyane mu mitima ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.22",
            "verseOrgIds": [
              "1PE.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1PE 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko mwabyawe ubwa kabiri, mutabyawe n'imbuto ibora ahubwo mwabyawe n'imbuto itabora, mubiheshejwe n'ijambo ry'Imana rizima rihoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.23",
            "verseOrgIds": [
              "1PE.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1PE 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.40.6+ISA.40.7+ISA.40.8"
              },
              "items": [
                {
                  "text": "Yes 40.6-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kuko,",
          "type": "text",
