            "sid": "1PE 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko mwiyambure igomwa ryose n'uburiganya bwose, n'uburyarya n'ishyari no gusebanya kose, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.1",
            "verseOrgIds": [
              "1PE.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1PE 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "mumere nk'impinja zivutse vuba, mwifuze amata y'umwuka adafunguye, kugira ngo abakuze abageze ku gakiza, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.2",
            "verseOrgIds": [
              "1PE.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1PE 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.34.9"
              },
              "items": [
                {
                  "text": "Zab 34.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " niba mwarasogongeye mukamenya yuko Umwami wacu agira neza.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.3",
            "verseOrgIds": [
              "1PE.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1PE 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.3",
            "verseOrgIds": [
              "1PE.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1PE 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimumwegere ni we Buye rizima ryanzwe n'abantu, ariko ku Mana ryaratoranijwe riba iry'igiciro cyinshi, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.4",
            "verseOrgIds": [
              "1PE.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1PE 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "namwe mwubakwe nk'amabuye mazima kugira ngo mube inzu y'umwuka, n'ubwoko bw'abatambyi bwera bwo gutamba ibitambo by'umwuka bishimwa n'Imana ku bwa Yesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.5",
            "verseOrgIds": [
              "1PE.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1PE 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.28.16"
              },
              "items": [
                {
                  "text": "Yes 28.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kuko mu byanditswe harimo aya magambo ngo",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.6",
            "verseOrgIds": [
              "1PE.2.6"
            ]
          }
        }
      ]
    },
