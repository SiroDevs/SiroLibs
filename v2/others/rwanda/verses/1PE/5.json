        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Inshingano y'abakuru b'Itorero n'abasore",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1PE 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya magambo ndayahuguza abakuru b'Itorero bo muri mwe, kuko nanjye ndi umukuru mugenzi wanyu, n'umugabo wo guhamya imibabaro ya Kristo kandi mfatanije namwe ubwiza buzahishurwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.1",
            "verseOrgIds": [
              "1PE.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1PE 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.21.15+JHN.21.16+JHN.21.17"
              },
              "items": [
                {
                  "text": "Yoh 21.15-17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Muragire umukumbi w'Imana wo muri mwe mutawurinda nk'abahatwa, ahubwo muwurinde mubikunze nk'uko Imana ishaka atari ku bwo kwifuza indamu mbi, ahubwo ku bw'umutima ukunze ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.2",
            "verseOrgIds": [
              "1PE.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1PE 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi mudasa n'abatwaza igitugu abo mwagabanijwe, ahubwo mube ibyitegererezo by'umukumbi. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.3",
            "verseOrgIds": [
              "1PE.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1PE 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Umutahiza naboneka, muzahabwa ikamba ry'ubugingo ritangirika.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.4",
            "verseOrgIds": [
              "1PE.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1PE 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.4",
            "verseOrgIds": [
              "1PE.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1PE 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.5",
            "verseOrgIds": [
              "1PE.5.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.3.34"
              },
              "items": [
                {
                  "text": "Imig 3.34",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Namwe basore mugandukire abakuru. Mwese mukenyere kwicisha bugufi kugira ngo mukorerane, kuko Imana irwanya abibone naho abicisha bugufi ikabahera ubuntu. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.5",
            "verseOrgIds": [
              "1PE.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1PE 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.23.12"
              },
              "items": [
                {
                  "text": "Mat 23.12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.14.11"
              },
              "items": [
                {
                  "text": "Luka 14.11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.18.14"
              },
              "items": [
                {
                  "text": "18.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nuko mwicishe bugufi muri munsi y'ukuboko gukomeye kw'Imana, kugira ngo ibashyire hejuru mu gihe gikwiriye. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.6",
            "verseOrgIds": [
              "1PE.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1PE 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muyikoreze amaganya yanyu yose, kuko yita kuri mwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.7",
            "verseOrgIds": [
              "1PE.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1PE 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwirinde ibisindisha mube maso, kuko umurezi wanyu Satani azerera nk'intare yivuga ashaka uwo aconshomera. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.8",
            "verseOrgIds": [
              "1PE.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1PE 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumurwanye mushikamye kandi mufite kwizera gukomeye, muzi yuko bene Data bari mu isi muhuje imibabaro. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.9",
            "verseOrgIds": [
              "1PE.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1PE 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Imana igira ubuntu bwose yabahamagariye ubwiza bwayo buhoraho buri muri Kristo, izabatunganya rwose ubwayo ibakomeze, ibongerere imbaraga nimumara kubabazwa akanya gato. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.10",
            "verseOrgIds": [
              "1PE.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1PE 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icyubahiro n'ubutware bibe ibyayo iteka ryose. Amen.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.11",
            "verseOrgIds": [
              "1PE.5.11"
            ]
          }
        }
      ]
    },
