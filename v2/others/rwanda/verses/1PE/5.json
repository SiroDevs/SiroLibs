            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.15.22"
              },
              "items": [
                {
                  "text": "Ibyak 15.22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.15.40"
              },
              "items": [
                {
                  "text": "40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mbandikiye uru rwandiko rw'amagambo make, rwanditswe n'ukuboko kwa Siluwano, mwene Data wo kwizerwa, uko ntekereza mbahugura, mpamya, yuko ubuntu bw'Imana navuze ari ubw'ukuri",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.12",
            "verseOrgIds": [
              "1PE.5.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "navuze . . . ukuri:",
              "type": "text"
            },
            {
              "text": "cyangwa, yuko ubu buntu bw'Imana muhagazemo, ari ubw'ukuri.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", nimubuhagararemo mushikamye.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.12",
            "verseOrgIds": [
              "1PE.5.12"
            ]
          }
        }
      ]
