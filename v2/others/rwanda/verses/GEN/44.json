          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "umwe akamvaho nkibwira ndashidikanya yuko yatanyaguwe n'inyamaswa nanjye nkaba ntakimubona, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.28",
            "verseOrgIds": [
              "GEN.44.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 44:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimunkuraho n'uyu akagira ibyago, muzatuma imvi zanjye zimanukana ishavu zijya ikuzimu.’",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.29",
            "verseOrgIds": [
              "GEN.44.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 44:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.29",
            "verseOrgIds": [
              "GEN.44.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 44:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nuko none najya kuri data umugaragu wawe tutari kumwe n'uwo muhungu, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.30",
            "verseOrgIds": [
              "GEN.44.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 44:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "data akabona tutazanye yapfa, kuko ubugingo bwe bwiboshye ku bw'uwo muhungu, twebwe abagaragu bawe tukaba dutumye imvi za data umugaragu wawe, zimanukana ishavu zijya ikuzimu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.31",
            "verseOrgIds": [
              "GEN.44.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 44:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko jyewe umugaragu wawe nishingiye uwo muhungu kuri data nti ‘Nintamugushyikiriza, nzaba ngukoreye icyaha data, kitazamvaho iteka.’ ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.32",
            "verseOrgIds": [
              "GEN.44.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 44:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko none ndakwinginze, databuja, jyewe umugaragu wawe ngume mu cyimbo cy'uwo muhungu ndi imbata yawe, kandi uwo muhungu atahane na bene se. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.33",
            "verseOrgIds": [
              "GEN.44.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 44:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasubira nte ngo njye kuri data, ntari kumwe n'uwo muhungu? Ne kureba ibyago bizagera kuri data.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.34",
            "verseOrgIds": [
              "GEN.44.34"
            ]
          }
        }
      ]
