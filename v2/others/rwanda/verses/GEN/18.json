        },
        {
          "text": "Uwiteka aravuga ati “Ubwo gutaka kw'abarega i Sodomu n'i Gomora ari kwinshi, ibyaha byaho bigakabya cyane, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.20",
            "verseOrgIds": [
              "GEN.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndamanuka ndebe ko bakora ibihwanye rwose no gutaka kw'abaharega kwangezeho, kandi niba atari ko bimeze, ndabimenya.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.21",
            "verseOrgIds": [
              "GEN.18.21"
            ]
          }
        }
      ]
