          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bagabo barahindukira, bava aho bagenda berekeje i Sodomu, Aburahamu agihagaze imbere y'Uwiteka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.22",
            "verseOrgIds": [
