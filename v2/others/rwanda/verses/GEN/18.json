          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahari ku bakiranutsi mirongo itanu hazaburaho batanu, uzarimbura umudugudu wose, kuko habuzeho batanu?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.28",
            "verseOrgIds": [
