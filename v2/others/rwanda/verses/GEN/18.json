        },
        {
          "text": "Aburahamu arongera aramubwira ati “Mpangaye kuvugana n'umwami wanjye, nubwo ndi umukungugu n'ivu gusa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.27",
            "verseOrgIds": [
