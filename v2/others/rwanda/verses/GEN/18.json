              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwiteka aramusubiza ati “Nimbona i Sodomu abakiranutsi mirongo itanu bari muri uwo mudugudu, nzahababarira hose ku bwabo.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.26",
