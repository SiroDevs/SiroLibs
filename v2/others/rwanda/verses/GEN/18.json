        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.9",
            "verseOrgIds": [
              "GEN.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.10",
