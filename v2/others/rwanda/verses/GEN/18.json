              "GEN.18.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.9"
              },
              "items": [
                {
                  "text": "Rom 9.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Undi aramubwira ati “Iki gihe cy'umwaka nikigaruka, sinzabura kugaruka aho uri, Sara umugore wawe abyare umuhungu.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.10",
            "verseOrgIds": [
              "GEN.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sara abyumva ari mu muryango w'ihema uri inyuma ye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.10",
            "verseOrgIds": [
              "GEN.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburahamu na Sara bari bashaje, bageze mu za bukuru, kandi Sara ntiyari akijya mu mihango y'abakobwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.11",
            "verseOrgIds": [
              "GEN.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.3.6"
              },
              "items": [
                {
                  "text": "1 Pet 3.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Sara asekera mu mutima ati “Ko maze gukecura, nzanezerwa ntyo kandi umutware wanjye akaba ashaje?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.12",
            "verseOrgIds": [
              "GEN.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.12",
            "verseOrgIds": [
              "GEN.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwiteka abaza Aburahamu ati “Ni iki gishekeje Sara, akibaza ati ‘Ni ukuri koko nzabyara, nkecuye?’ ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.13",
            "verseOrgIds": [
              "GEN.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.37"
              },
              "items": [
                {
                  "text": "Luka 1.37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hari ikinanira Uwiteka se? Mu gihe cyashyizweho, iki gihe cy'umwaka nikigaruka nzakugarukaho, Sara abyare umuhungu.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.14",
            "verseOrgIds": [
              "GEN.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.14",
            "verseOrgIds": [
              "GEN.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Sara arahakana ati “Sinsetse”, kuko yatinyaga.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.15",
            "verseOrgIds": [
              "GEN.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aramusubiza ati “Oya, urasetse.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.15",
            "verseOrgIds": [
              "GEN.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Imana ibwira Aburahamu ko igiye kurimbura i Sodomu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.15",
            "verseOrgIds": [
              "GEN.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bagabo barahaguruka baragenda, berekeza amaso i Sodomu, Aburahamu arabaherekeza. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.16",
            "verseOrgIds": [
              "GEN.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwiteka aribaza ati “Aburahamu namuhisha icyo ngiye gukora? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.17",
            "verseOrgIds": [
              "GEN.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko Aburahamu atazabura guhinduka ubwoko bukomeye bw'ubunyamaboko, kandi amahanga yose yo mu isi azaherwa umugisha muri we. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.18",
            "verseOrgIds": [
              "GEN.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko icyatumye mumenya, ari ukugira ngo ategeke abana be n'abo mu rugo rwe bazakurikiraho, gukomeza mu nzira y'Uwiteka, bakora ibyo gukiranuka baca imanza zitabera, kugira ngo Uwiteka azanire Aburahamu ibyo yamuvuzeho.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.19",
            "verseOrgIds": [
              "GEN.18.19"
            ]
          }
        }
      ]
    },
    {
