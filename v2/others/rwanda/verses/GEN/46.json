          ]
        },
        {
          "text": " Abahungu ba Yosefu yabyariye muri Egiputa ni babiri, abantu bose b'inzu ya Yakobo bagiye muri Egiputa bari mirongo irindwi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.27",
