          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'abagabo bose bo mu rugo rwe, abaruvukiyemo n'abo yaguze n'abanyamahanga, bakebanwa na we.",
          "type": "text",
