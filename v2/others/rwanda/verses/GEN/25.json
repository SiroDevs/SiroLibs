          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esawu abwira Yakobo ati “Ndakwinginze, ngaburira ku bitukura utetse, kuri ibyo bitukura byawe, kuko nkōza.” Ni cyo cyatumye yitwa Edomu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.30",
            "verseOrgIds": [
              "GEN.25.30"
            ]
          }
