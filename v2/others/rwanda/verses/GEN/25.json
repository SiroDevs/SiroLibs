              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bahungu barakura. Esawu aba umuhigi w'umuhanga w'umunyeshyamba, Yakobo we yari umunyamahane make, yabaga mu mahema. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.27",
            "verseOrgIds": [
              "GEN.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Isaka yakundiraga Esawu kuko yajyaga arya ku muhigo w, Rebeka we yakundaga Yakobo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.28",
            "verseOrgIds": [
              "GEN.25.28"
            ]
          }
        }
      ]
