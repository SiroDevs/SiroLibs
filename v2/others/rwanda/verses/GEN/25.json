              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye Yakobo ateka imboga, Esawu arinjira avuye mu ishyamba, akōza. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.29",
            "verseOrgIds": [
              "GEN.25.29"
            ]
