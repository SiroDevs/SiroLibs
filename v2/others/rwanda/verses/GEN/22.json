              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inshoreke ye yitwa Rewuma, na yo yabyaye Teba na Gahamu, na Tahashi na Māka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.24",
            "verseOrgIds": [
