              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburahamu asubira aho abagaragu be bari, barahaguruka bajyana i Bērisheba, agezeyo arahatura.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.19",
