              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.1",
            "verseOrgIds": [
              "GEN.22.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.17+HEB.11.18+HEB.11.19"
              },
              "items": [
                {
                  "text": "Heb 11.17-19",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Hanyuma y'ibyo, Imana igerageza Aburahamu iramuhamagara iti “Aburahamu.” Aritaba ati “Karame.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.1",
            "verseOrgIds": [
              "GEN.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.1",
            "verseOrgIds": [
              "GEN.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.2",
            "verseOrgIds": [
              "GEN.22.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.3.1"
              },
              "items": [
                {
                  "text": "2 Ngoma 3.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Iramubwira iti “Jyana umwana wawe, umwana wawe w'ikinege ukunda Isaka, ujye mu gihugu cy'i Moriya umutambireyo ku musozi ndi bukubwire, abe igitambo cyoswa.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.2",
            "verseOrgIds": [
              "GEN.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.2",
            "verseOrgIds": [
              "GEN.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburahamu azinduka kare kare, ashyira amatandiko ku ndogobe ye, ajyana n'abagaragu be babiri, na Isaka umwana we. Yasa inkwi zo kosa igitambo, arahaguruka ajya ahantu Imana yamubwiye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.3",
            "verseOrgIds": [
              "GEN.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku munsi wa gatatu Aburahamu arambura amaso, yitegereza aho hantu hari kure. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.4",
            "verseOrgIds": [
              "GEN.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburahamu abwira abo bagaragu be ati “Musigirane hano indogobe, jye n'uyu muhungu tujye hirya hariya dusenge, tubagarukeho.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.5",
            "verseOrgIds": [
              "GEN.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.5",
            "verseOrgIds": [
              "GEN.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburahamu yenda za nkwi zo kosa igitambo, azikorera Isaka umuhungu we, ajyana n'umuriro n'umushyo, bombi barajyana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.6",
            "verseOrgIds": [
              "GEN.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka ahamagara se Aburahamu ati “Data.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.7",
            "verseOrgIds": [
              "GEN.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aramwitaba ati “Ndakwitaba, mwana wanjye.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.7",
            "verseOrgIds": [
              "GEN.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aramubaza ati “Dore umuriro n'inkwi ngibi, ariko umwana w'intama uri he, w'igitambo cyo koswa?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.7",
            "verseOrgIds": [
              "GEN.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.7",
            "verseOrgIds": [
              "GEN.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburahamu aramusubiza ati “Mwana wanjye, Imana iri bwibonere umwana w'intama w'igitambo cyo koswa.” Nuko bombi barajyana.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.8",
            "verseOrgIds": [
              "GEN.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aburahamu agiye gutamba Isaka, Imana iramubuza",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.8",
            "verseOrgIds": [
              "GEN.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.9",
            "verseOrgIds": [
              "GEN.22.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.2.21"
              },
              "items": [
                {
                  "text": "Yak 2.21",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bagera ahantu Imana yamubwiye, Aburahamu yubakayo igicaniro yararikaho za nkwi, aboha Isaka umuhungu we, amurambika kuri icyo gicaniro hejuru y'inkwi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.9",
            "verseOrgIds": [
              "GEN.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburahamu arambura ukuboko, yenda wa mushyo ngo asogote umuhungu we. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.10",
            "verseOrgIds": [
              "GEN.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Marayika w'Uwiteka amuhamagara ari mu ijuru ati “Aburahamu, Aburahamu.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.11",
            "verseOrgIds": [
              "GEN.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aritaba ati “Karame.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.11",
            "verseOrgIds": [
              "GEN.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.11",
            "verseOrgIds": [
              "GEN.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aramubwira ati “Ntukoze ukuboko kuri uwo muhungu, ntugire icyo umutwara, kuko ubu menye yuko wubaha Imana, kuko utanyimye umwana wawe w'ikinege.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.12",
            "verseOrgIds": [
              "GEN.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.12",
            "verseOrgIds": [
              "GEN.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburahamu yubura amaso arareba, abona inyuma ye impfizi y'intama, amahembe yayo afashwe mu gihuru. Aburahamu aragenda, yenda ya ntama, ayitambaho igitambo cyoswa mu cyimbo cy'umuhungu we. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.13",
            "verseOrgIds": [
              "GEN.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburahamu yita aho hantu Yehovayire",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.14",
            "verseOrgIds": [
              "GEN.22.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "Yehovayire:",
              "type": "text"
            },
            {
              "text": "risobanurwa ngo Uwiteka azatuma kiboneka.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", nk'uko bavuga na bugingo n'ubu bati “Ku musozi w'Uwiteka kizabonwa.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.14",
            "verseOrgIds": [
              "GEN.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Imana iha Aburahamu umugisha ukomeye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.14",
            "verseOrgIds": [
              "GEN.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze marayika w'Uwiteka arongera ahamagara Aburahamu ari mu ijuru, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.15",
            "verseOrgIds": [
              "GEN.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.6.13+HEB.6.14"
              },
              "items": [
                {
                  "text": "Heb 6.13-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " aramubwira ati “Ndirahiye, ni ko Uwiteka avuga, ubwo ugenjeje utyo ntunyime umwana wawe w'ikinege, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.16",
            "verseOrgIds": [
              "GEN.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
