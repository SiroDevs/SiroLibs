              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma y'ibyo babwira Aburahamu bati “Na Miluka yabyaranye na mwene so Nahori abana.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.20",
            "verseOrgIds": [
              "GEN.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imfura ye ni Usi, hakurikiraho Buzi murumuna we, na Kemuweli se wa Aramu, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.21",
            "verseOrgIds": [
              "GEN.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
