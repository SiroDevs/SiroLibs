      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yakobo ashaka gusubirayo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
