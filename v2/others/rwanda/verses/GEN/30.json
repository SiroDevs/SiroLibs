          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asama inda abyara umuhungu ati “Imana inkuyeho igitutsi.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.23",
            "verseOrgIds": [
              "GEN.30.23"
            ]
          }
        },
        {
