              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'umutware Dishoni, n'umutware Eseri, n'umutware Dishani. Abo ni bo batware bavuye mu Bahori, nk'uko abatware babo bari mu gihugu cy'i Seyiri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.30",
