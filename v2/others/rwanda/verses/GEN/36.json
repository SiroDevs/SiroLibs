            }
          ]
        },
        {
          "text": "Kandi aba ni bo batware bavuye mu Bahori: umutware Lotani, n'umutware Shobali, n'umutware Sibeyoni, n'umutware Ana, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.29",
            "verseOrgIds": [
