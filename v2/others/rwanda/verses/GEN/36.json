          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi aba ni bo bene Reweli mwene Esawu: umutware Nahati, n'umutware Zera, n'umutware Shama, n'umutware Miza. Abo ni bo batware bakomotse kuri Reweli mu gihugu cya Edomu, abo ni bo buzukuru ba Basemati muka Esawu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.17",
            "verseOrgIds": [
              "GEN.36.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
