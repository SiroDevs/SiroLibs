          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi aba ni bo bene Ana: Dishoni na Oholibama, umukobwa wa Ana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.25",
            "verseOrgIds": [
              "GEN.36.25"
            ]
          }
        },
        {
