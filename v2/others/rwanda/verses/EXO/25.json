              "items": [
                {
                  "text": "Heb 8.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ugire umwete wo kubirema, ukurikize icyitegerezo cyabyo werekewe kuri uyu musozi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.40",
