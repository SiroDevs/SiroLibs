                "loc": "EXO.37.1+EXO.37.2+EXO.37.3+EXO.37.4+EXO.37.5+EXO.37.6+EXO.37.7+EXO.37.8+EXO.37.9"
              },
              "items": [
                {
                  "text": "Kuva 37.1-9",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Kandi bazabāze isanduku mu giti cyitwa umushita: uburebure bwayo bw'umurambararo bube mikono ibiri n'igice, ubugari bwayo bube mukono umwe n'igice, uburebure bw'igihagararo bube mukono umwe n'igice. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.10",
            "verseOrgIds": [
              "EXO.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzayiyagirizeho izahabu nziza imbere n'inyuma, uyigoteshe umuguno w'izahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.11",
            "verseOrgIds": [
              "EXO.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyitekere izahabu zivemo ibifunga bine, ubishyire ku nkokora zayo zo hepfo uko ari enye. Ibifunga bibiri bibe mu rubavu rumwe, ibindi bibiri bibe mu rundi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.12",
            "verseOrgIds": [
              "EXO.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubāze imijisho mu mushita, uyiyagirizeho izahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.13",
            "verseOrgIds": [
              "EXO.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ushyire iyo mijisho mu bifunga byo mu mbavu z'iyo sanduku, bajye bayiyiremereza. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.14",
            "verseOrgIds": [
              "EXO.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo mijisho igume mu bifunga by'isanduku, ntikabivemo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.15",
            "verseOrgIds": [
              "EXO.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ushyire muri iyo sanduku Ibihamya nzaguha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.16",
            "verseOrgIds": [
              "EXO.25.16"
            ]
          }
        }
      ]
    },
