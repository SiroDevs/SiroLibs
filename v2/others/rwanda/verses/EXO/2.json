          "items": [
            {
              "text": "Gerushomu",
              "type": "text"
            },
            {
              "text": "risobanura ngo Umusuhuke w'aho hantu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ati “Nari umusuhuke mu gihugu kitari icyacu.”",
