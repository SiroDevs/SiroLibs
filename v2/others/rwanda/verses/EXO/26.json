            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.3+HEB.9.4+HEB.9.5"
              },
              "items": [
                {
                  "text": "9.3-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Umanike uwo mwenda munsi ya bya bikwasi, ushyire hirya yawo ya sanduku y'Ibihamya, uwo mwenda ubabere urugabano rw'Ahera n'Ahera cyane. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.33",
            "verseOrgIds": [
              "EXO.26.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 26:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi uzashyire ya ntebe y'ihongerero kuri iyo sanduku y'Ibihamya, iri Ahera cyane. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.34",
            "verseOrgIds": [
              "EXO.26.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 26:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ya meza uyashyire hino y'uwo mwenda, na cya gitereko cy'amatabaza ugishyire mu ruhande rw'iburyo rw'ubwo buturo, kibangikane n'ayo meza, ameza uyashyire mu ruhande rw'ibumoso.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.35",
            "verseOrgIds": [
              "EXO.26.35"
            ]
          }
        }
