            "sid": "EXO 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwiteka abwira Mose ati “Uhereye none uzabona ibyo nzagirira Farawo. Azabarekura bagende, abyemejwe n'amaboko menshi, kandi no kwirukana azabirukana mu gihugu cye ku bw'ayo maboko.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.1",
            "verseOrgIds": [
              "EXO.6.1"
            ]
          }
        }
      ]
    },
