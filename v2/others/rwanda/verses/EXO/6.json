          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo ni bo babwiye Farawo umwami wa Egiputa ngo bakure Abisirayeli muri Egiputa. Abo ni bo Mose na Aroni, ba bandi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.27",
