          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eleyazari mwene Aroni arongora umwe mu bakobwa ba Putiyeli, babyarana Finehasi. Abo ni bo batware b'amazu ya ba sekuru yo mu Balewi nk'uko imiryango yabo iri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.25",
            "verseOrgIds": [
              "EXO.6.25"
            ]
          }
        }
