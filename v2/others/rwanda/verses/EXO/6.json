              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bene Kōra ni Asiri na Elukana na Abiyasafu. Iyo ni yo miryango y'Abakōra. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.24",
            "verseOrgIds": [
              "EXO.6.24"
            ]
          }
        },
        {
