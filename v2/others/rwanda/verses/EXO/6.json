              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo ni bo Aroni na Mose, ba bandi Uwiteka yabwiye ati “Mukure Abisirayeli mu gihugu cya Egiputa, uko imitwe yabo iri.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.26",
            "verseOrgIds": [
              "EXO.6.26"
            ]
          }
        },
