                {
                  "text": "Kuva 6.2-3",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mose abaza Imana ati “Ningera ku Bisirayeli nkababwira nti ‘Imana ya ba sekuruza banyu yabantumyeho’, bakambaza bati ‘Yitwa nde?’ Nzasubiza iki?”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.13",
            "verseOrgIds": [
              "EXO.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
