              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose ava imbere ya Farawo arasohoka, asaba Uwiteka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.26",
            "verseOrgIds": [
