              "type": "text"
            }
          ]
        },
        {
          "text": " Maze Mose n'Abisirayeli baririmbira Uwiteka iyi ndirimbo bati",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.1",
            "verseOrgIds": [
              "EXO.15.1"
            ]
