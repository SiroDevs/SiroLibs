                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Niwumva inkuru y'impuha ntukayamamaze, ntugakoranire mu ntoki n'umunyabyaha gusezerana guhamya ibinyoma. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.1",
            "verseOrgIds": [
              "EXO.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntugakurikize benshi gukora ibyaha, kandi nutangwa ho umugabo ntukajye iyo abenshi bagiye ngo utume baca urubanza nabi, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.2",
            "verseOrgIds": [
              "EXO.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
