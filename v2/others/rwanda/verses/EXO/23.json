          ]
        },
        {
          "text": " “Kandi ujye uziririza umunsi mukuru w'isarura, uw'umuganura w'imirimo yawe wabibye mu murima.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.16",
