                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Ntukagoreke urubanza rw'umukene uri muri mwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.6",
            "verseOrgIds": [
              "EXO.23.6"
            ]
