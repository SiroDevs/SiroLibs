            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Nuhura n'inka y'umwanzi wawe cyangwa n'indogobe ye izimira, ntukabure kuyimuzanira. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.4",
            "verseOrgIds": [
              "EXO.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nusanga indogobe y'umwanzi wawe umutwaro ihetse yawugwanye, ukagira ngo wirengagize kumufasha, ntukabure kumufasha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.5",
            "verseOrgIds": [
              "EXO.23.5"
            ]
          }
        }
      ]
    },
