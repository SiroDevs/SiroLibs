            "number": "11",
            "style": "v",
            "sid": "EXO 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ariko ku wa karindwi bujye buruhuka uburaze, kugira ngo abakene bo mu bwoko bwanyu barye cyimeza, ibyo basize inyamaswa zo mu gasozi zibirye. Uko abe ari ko ujya ugenza uruzabibu rwawe n'urwelayo rwawe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.11",
            "verseOrgIds": [
