            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 36:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi umwenda ukingiriza bawubohesha ubudodo bw'umukara wa kabayonga, n'ubw'umuhengeri n'ubw'umuhemba, n'ubw'ibitare byiza buboheranije, bawubohamo ibishushanyo by'abakerubi, abahanga b'ibyo aba ari bo babiboha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.35",
            "verseOrgIds": [
              "EXO.36.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 36:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bawubāriza inkingi enye mu mushita baziyagirizaho izahabu, inkonzo zo kuri zo ziba iz'izahabu. Batekera izo nkingi ifeza, zivamo imyobo ine yo kuzishingamo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.36",
            "verseOrgIds": [
              "EXO.36.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 36:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi umwenda wo gukinga umuryango w'iryo Hema, bawuremesha ubudodo bw'umukara wa kabayonga, n'ubw'umuhengeri n'ubw'umuhemba, n'ubw'ibitare byiza buboheranije, abahanga b'ibyo aba ari bo bawudodaho amabara. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.37",
            "verseOrgIds": [
              "EXO.36.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 36:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babāza inkingi zawo uko ari eshanu bazishyiraho inkonzo zazo, imitwe yazo n'imitambiko yo kuri zo baziyagirizaho izahabu, imyobo zishingwamo uko ari itanu, iba iy'imiringa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.38",
            "verseOrgIds": [
              "EXO.36.38"
            ]
          }
        }
      ]
