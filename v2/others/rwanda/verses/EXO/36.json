            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.26.1+EXO.26.2+EXO.26.3+EXO.26.4+EXO.26.5+EXO.26.6+EXO.26.7+EXO.26.8+EXO.26.9+EXO.26.10+EXO.26.11+EXO.26.12+EXO.26.13+EXO.26.14+EXO.26.15+EXO.26.16+EXO.26.17+EXO.26.18+EXO.26.19+EXO.26.20+EXO.26.21+EXO.26.22+EXO.26.23+EXO.26.24+EXO.26.25+EXO.26.26+EXO.26.27+EXO.26.28+EXO.26.29+EXO.26.30+EXO.26.31+EXO.26.32+EXO.26.33+EXO.26.34+EXO.26.35+EXO.26.36+EXO.26.37"
              },
              "items": [
                {
                  "text": "Kuva 26.1-37",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abahanga bose bo mu bakoraga uwo murimo barema ubwo buturo, babusakaza imyenda cumi bayibohesheje ubudodo bw'ibitare byiza buboheranije, n'ubw'umukara wa kabayonga, n'ubw'umuhengeri n'ubw'umuhemba, bayibohamo ibishushanyo by'abakerubi, abahanga aba ari bo babiboha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.8",
            "verseOrgIds": [
              "EXO.36.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uburebure bw'umwenda wose buba mikono makumyabiri n'umunani, ubugari bwawo buba mikono ine, imyenda yose iba urugero rumwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.9",
            "verseOrgIds": [
              "EXO.36.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imyenda itanu bayikombata ukwayo, n'iyindi itanu bayikombata ukwayo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.10",
            "verseOrgIds": [
              "EXO.36.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi badoda imikondo y'udutambaro tw'imikara ya kabayonga ku musozo w'umwenda uhera igikombate kimwe, badoda yindi nka yo ku musozo w'umwenda uhera ikindi gikombate. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.11",
            "verseOrgIds": [
              "EXO.36.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Badoda imikondo mirongo itanu ku mwenda umwe, n'indi mirongo itanu bayidoda ku musozo w'umwenda uhera ikindi gikombate, iyo mikondo irerekerana. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.12",
            "verseOrgIds": [
              "EXO.36.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bacura ibikwasi by'izahabu mirongo itanu babifatanisha ibyo bikombate, ubwo buturo buba bumwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.13",
            "verseOrgIds": [
              "EXO.36.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.13",
            "verseOrgIds": [
              "EXO.36.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi baboha imyenda yo gusakara y'ubwoya bw'ihene, iba ihema risakara ubwo buturo, baboha imyenda cumi n'umwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.14",
            "verseOrgIds": [
              "EXO.36.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 36:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uburebure bw'umwenda wose buba mikono mirongo itatu, ubugari bwawo buba mikono ine, iyo myenda uko ari cumi n'umwe iba urugero rumwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.15",
            "verseOrgIds": [
              "EXO.36.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 36:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakombata imyenda itanu ukwayo, n'iyindi itandatu bayikombata ukwayo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.16",
            "verseOrgIds": [
              "EXO.36.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Badoda imikondo mirongo itanu ku musozo w'umwenda uhera igikombate kimwe, n'indi mirongo itanu bayidoda ku musozo w'umwenda uhera ikindi igikombate. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.17",
            "verseOrgIds": [
              "EXO.36.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 36:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bacura ibikwasi by'imiringa mirongo itanu byo gufatanisha iryo hema, ngo ribe rimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.18",
            "verseOrgIds": [
              "EXO.36.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi baciranya igisakara iryo hema mu mpu z'amasekurume y'intama zizigishijwe inzigo itukura, bakirenzaho igicirane cy'impu z'inyamaswa zitwa tahashi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.19",
            "verseOrgIds": [
              "EXO.36.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.19",
            "verseOrgIds": [
              "EXO.36.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 36:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi babāza imbaho z'imiganda y'ubwo buturo mu mushita, barazishinga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.20",
            "verseOrgIds": [
              "EXO.36.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uburebure bw'urubaho rwose buba mikono cumi, ubugari bwarwo buba mukono umwe n'igice. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.21",
            "verseOrgIds": [
              "EXO.36.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 36:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ku rubaho rwose haba inkarwe ebyiri zifatanye, aba ari ko bazibāza ku mbaho z'ubwo buturo zose. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.22",
            "verseOrgIds": [
              "EXO.36.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 36:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babāza imbaho z'imiganda yabwo, iz'uruhande rw'iburyo ziba makumyabiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.23",
            "verseOrgIds": [
              "EXO.36.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 36:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi bacura imyobo mirongo ine mu ifeza, yo kuba hasi y'izo mbaho uko ari makumyabiri, imyobo ibiri yo kuba hasi y'urubaho rumwe, ngo ishingwemo inkarwe zarwo zombi, bityo bityo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.24",
            "verseOrgIds": [
              "EXO.36.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 36:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi babāza imbaho makumyabiri z'urundi ruhande rw'ubwo buturo rw'ibumoso, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.25",
            "verseOrgIds": [
              "EXO.36.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 36:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "bazicurira imyobo mirongo ine mu ifeza, imyobo ibiri yo kuba hasi y'urubaho rumwe, bityo bityo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.26",
            "verseOrgIds": [
              "EXO.36.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 36:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi babāza imbaho esheshatu zo mu mwinjiro w'ubwo buturo, iburengerazuba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.27",
            "verseOrgIds": [
              "EXO.36.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 36:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi babāza imbaho ebyiri z'impfuruka zabwo zo mu mwinjiro. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.28",
            "verseOrgIds": [
              "EXO.36.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 36:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hasi ziba izivuyemo nk'ebyiri, kandi ziba imyishyikire zigera ku mpeta ya mbere, aba ari ko bazigira ku mpfuruka zombi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.29",
            "verseOrgIds": [
              "EXO.36.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 36:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko izo mbaho ziba umunani, imyobo y'ifeza zishingwamo iba cumi n'itandatu, imyobo ibiri iba hasi y'urubaho rwose.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.30",
            "verseOrgIds": [
              "EXO.36.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 36:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.30",
            "verseOrgIds": [
              "EXO.36.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 36:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi babāza imbumbe mu mushita, imbumbe eshanu zo ku mbaho z'imiganda y'uruhande rumwe rw'ubwo buturo, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.31",
            "verseOrgIds": [
              "EXO.36.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 36:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'izindi eshanu zo ku mbaho z'imiganda y'uruhande rwabwo, n'izindi eshanu zo mu mwinjiro wabwo, iburengerazuba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.32",
            "verseOrgIds": [
              "EXO.36.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 36:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbumbe yo hagati y'izindi iringanije imbaho, bayibāza ari umwishyikire. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.33",
            "verseOrgIds": [
              "EXO.36.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 36:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi izo mbaho baziyagirizaho izahabu, bacura impeta mu izahabu zo kuzishyiraho ngo zisesekwemo izo mbumbe, imbumbe na zo baziyagirizaho izahabu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.34",
            "verseOrgIds": [
              "EXO.36.34"
            ]
          }
        }
      ]
    },
