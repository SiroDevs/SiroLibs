                "loc": "DEU.7.6"
              },
              "items": [
                {
                  "text": "7.6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.14.2"
