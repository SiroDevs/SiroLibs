              },
              "items": [
                {
                  "text": "Kuva 12.29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " kandi narakubwiye nti: rekura umwana wanjye agende ankorere, ariko wanze kumurekura. Nuko rero nzica umwana wawe w'impfura.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.23",
            "verseOrgIds": [
              "EXO.4.23"
            ]
          }
        }
      ]
