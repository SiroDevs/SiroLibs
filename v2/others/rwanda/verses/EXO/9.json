        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.32",
            "verseOrgIds": [
              "EXO.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose ava mu rurembo imbere ya Farawo aramburira Uwiteka amaboko, guhinda kw'inkuba n'urubura birashira, imvura ntiyongera kugwa mu isi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.33",
            "verseOrgIds": [
              "EXO.9.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Farawo abonye imvura n'urubura n'inkuba zihinda bishize, arushaho gukora icyaha, yinangira umutima we n'abagaragu be. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.34",
            "verseOrgIds": [
              "EXO.9.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umutima wa Farawo uranangira ntiyareka Abisirayeli bagenda, uko Uwiteka yavugiye mu kanwa ka Mose.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.35",
            "verseOrgIds": [
              "EXO.9.35"
            ]
          }
        }
      ]
