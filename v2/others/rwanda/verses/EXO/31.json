              "items": [
                {
                  "text": "Lewi 23.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.12+DEU.5.13+DEU.5.14"
              },
              "items": [
                {
                  "text": "Guteg 5.12-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mu minsi itandatu abe ari mo imirimo ijya ikorwa, ariko uwa karindwi ni isabato yo kuruhuka yerejwe Uwiteka. Uzagira umurimo akora ku munsi w'isabato ntakabure kwicwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.15",
            "verseOrgIds": [
              "EXO.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Abisirayeli baziririze isabato, bajye bayitondera mu bihe byabo byose, ibe isezerano ridakuka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.16",
            "verseOrgIds": [
              "EXO.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.11"
              },
              "items": [
                {
                  "text": "Kuva 20.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ni ikimenyetso cy'iteka ryose hagati yanjye n'Abisirayeli, kuko iminsi itandatu ari yo Uwiteka yaremeyemo ijuru n'isi, ku wa karindwi akarorera, akaruhuka.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.17",
            "verseOrgIds": [
              "EXO.31.17"
            ]
          }
        }
      ]
    },
    {
