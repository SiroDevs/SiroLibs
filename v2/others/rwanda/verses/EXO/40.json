          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "uko bagiye kwinjira mu ihema ry'ibonaniro, kandi uko bagiye kwegera icyo gicaniro bakajya bakaraba bakoga ibirenge, uko Uwiteka yategetse Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.32",
