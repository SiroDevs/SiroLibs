              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashinga urugo rugota ubwo buturo n'icyo gicaniro, akinga umwenda mu irembo ryarwo. Uko ni ko Mose yarangije uwo murimo wose.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.33",
            "verseOrgIds": [
              "EXO.40.33"
            ]
