          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi mu rugendo rwabo rwose uko icyo gicu cyaterurwaga kuri ubwo buturo, Abisirayeli barahagurukaga bakagenda, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.36",
            "verseOrgIds": [
