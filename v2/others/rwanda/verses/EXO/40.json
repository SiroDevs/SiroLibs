              "type": "text"
            }
          ]
        },
        {
          "text": "ariko icyo gicu kitaterurwaho ntibagende, bakageza umunsi giteruriweho. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.37",
            "verseOrgIds": [
