              "type": "text"
            }
          ]
        },
        {
          "text": "Mose ananirwa kwinjira mu ihema ry'ibonaniro kuko icyo gicu cyari kiririho, ubwiza bw'Uwiteka bukuzura ubwo buturo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.35",
            "verseOrgIds": [
