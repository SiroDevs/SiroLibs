      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Uko impano z'Umwuka zitandukanye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bene Data, ibyerekeye impano z'Umwuka sinshaka ko mutabimenya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.1",
            "verseOrgIds": [
              "1CO.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muzi yuko mukiri abapagani mwayobywaga mukajya ku bigirwamana bitabasha kuvuga, uko mwabijyanwagaho kose. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.2",
            "verseOrgIds": [
              "1CO.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni cyo gituma mbamenyesha yuko ari nta muntu ubwirijwe n'Umwuka w'Imana uvuga ati “Yesu ni ikivume”, kandi nta muntu ubasha kuvuga ati “Yesu ni Umwami”, atabibwirijwe n'Umwuka Wera.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.3",
            "verseOrgIds": [
              "1CO.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.3",
            "verseOrgIds": [
              "1CO.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.4",
            "verseOrgIds": [
              "1CO.12.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.6+ROM.12.7+ROM.12.8"
              },
              "items": [
                {
                  "text": "Rom 12.6-8",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Icyakora hariho impano z'uburyo bwinshi, ariko Umwuka ni umwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.4",
            "verseOrgIds": [
              "1CO.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi hariho uburyo bwinshi bwo kugabura iby'Imana, ariko Umwami ni umwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.5",
            "verseOrgIds": [
              "1CO.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hariho n'uburyo bwinshi bwo gukora, ariko Imana ikorera byose muri bose ni imwe, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.6",
            "verseOrgIds": [
              "1CO.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "umuntu wese agahabwa ikimwerekanaho Umwuka kugira ngo bose bafashwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.7",
            "verseOrgIds": [
              "1CO.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwe aheshwa ijambo ry'ubwenge n'Umwuka, undi agaheshwa n'uwo Mwuka ijambo ryo kumenya, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.8",
            "verseOrgIds": [
              "1CO.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "undi agaheshwa n'uwo Mwuka kwizera, undi agaheshwa n'uwo Mwuka impano yo gukiza indwara. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.9",
            "verseOrgIds": [
              "1CO.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Undi agahabwa gukora ibitangaza, undi agahabwa guhanura, undi agahabwa kurobanura imyuka, undi agahabwa kuvuga indimi nyinshi, undi agahabwa gusobanura indimi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.10",
            "verseOrgIds": [
              "1CO.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ariko ibyo byose uwo Mwuka umwe ni we ubikorera muri bo, agabira umuntu wese uko ashaka.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.11",
            "verseOrgIds": [
              "1CO.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Uburyo ingingo zitari zimwe zirema umubiri umwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.11",
            "verseOrgIds": [
              "1CO.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.12",
            "verseOrgIds": [
              "1CO.12.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.4+ROM.12.5"
              },
              "items": [
                {
                  "text": "Rom 12.4-5",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nk'uko umubiri ari umwe ukagira ingingo nyinshi, kandi nk'uko ingingo z'umubiri zose, nubwo ari nyinshi ari umubiri umwe, ni ko na Kristo ari, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.12",
            "verseOrgIds": [
              "1CO.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko mu Mwuka umwe twese ari mo twabatirijwe kuba umubiri umwe, naho twaba Abayuda cyangwa Abagiriki, naho twaba imbata cyangwa ab'umudendezo. Kandi twese twujujwe Umwuka umwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.13",
            "verseOrgIds": [
              "1CO.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.13",
            "verseOrgIds": [
              "1CO.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umubiri si urugingo rumwe ahubwo ni nyinshi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.14",
            "verseOrgIds": [
              "1CO.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikirenge cyavuga kiti “Ko ntari ikiganza sindi uwo ku mubiri”, ibyo ntibyatuma kiba kitari icyo ku mubiri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.15",
            "verseOrgIds": [
              "1CO.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ugutwi kwavuga kuti “Ko ntari ijisho sindi uwo ku mubiri”, ibyo ntibyatuma kuba kutari uko ku mubiri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.16",
            "verseOrgIds": [
              "1CO.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbese iyo umubiri wose uba ijisho, kumva kwabaye he? Iyo wose uba kumva, kunukirwa kwaba he? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.17",
            "verseOrgIds": [
              "1CO.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Imana yashyize ingingo mu mubiri, izigenera aho ishatse zose uko zingana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.18",
            "verseOrgIds": [
              "1CO.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbese noneho iyo zose ziba urugingo rumwe, umubiri uba warabaye he? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.19",
            "verseOrgIds": [
              "1CO.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko noneho ingingo ni nyinshi, naho umubiri ni umwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.20",
            "verseOrgIds": [
              "1CO.12.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.20",
            "verseOrgIds": [
              "1CO.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijisho ntiribasha kubwira ikiganza riti “Nta cyo umariye”, cyangwa umutwe ngo ubwire ibirenge uti “Nta cyo mumariye.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.21",
            "verseOrgIds": [
              "1CO.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahubwo biri ukundi rwose: ingingo z'umubiri zizwi ko ari iz'intege nke hanyuma y'izindi ni zo zo kutabura, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.22",
            "verseOrgIds": [
              "1CO.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi izo ku mubiri zizwi ko ari iz'icyubahiro gike ni zo turushaho kwambika icyubahiro, kandi ingingo zacu ziteye isoni ni zo zirushaho gushimwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.23",
            "verseOrgIds": [
              "1CO.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyamara izidateye isoni ntizigomba kwambikwa, ariko Imana yateranije umubiri hamwe, urugingo rukennye icyubahiro iruha icyubahiro kuruta izindi ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.24",
            "verseOrgIds": [
              "1CO.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ngo umubiri utirema ibice, ahubwo ingingo zigirirane. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.25",
            "verseOrgIds": [
              "1CO.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urugingo rumwe iyo rubabaye, ingingo zose zibabarana na rwo, cyangwa iyo urugingo rumwe ruhawe icyubahiro, ingingo zose zishīmana na rwo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.26",
            "verseOrgIds": [
              "1CO.12.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.26",
            "verseOrgIds": [
              "1CO.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CO 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero muri umubiri wa Kristo, kandi umuntu wese wo muri mwe ni urugingo rwawo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.27",
