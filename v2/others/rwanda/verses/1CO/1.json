          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko ubupfu bw'Imana burusha abantu ubwenge, kandi intege nke z'Imana zirusha abantu imbaraga.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.25",
            "verseOrgIds": [
              "1CO.1.25"
            ]
