              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Inkuru yamamaye hose yuko muri mwe habonetse ubusambanyi, ndetse bw'uburyo butaboneka no mu bapagani, umuntu kwenda muka se. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.1",
            "verseOrgIds": [
              "1CO.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namwe murihimbaza aho kubabara, kandi ari byo byari bibakwiriye ngo uwakoze icyo cyaha akurwe muri mwe, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.2",
            "verseOrgIds": [
              "1CO.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko jyewe nubwo ntari kumwe namwe mu mubiri nahoranye namwe mu mwuka, kandi ubwo bimeze bityo namaze gucira ho iteka uwakoze ibisa bityo nk'aho mpari, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.3",
            "verseOrgIds": [
              "1CO.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ubwo nari nteraniye hamwe namwe mu mutima wanjye dufite ububasha bw'Umwami wacu Yesu, nahawe ubutware na we ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.4",
            "verseOrgIds": [
              "1CO.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ngo uwo muntu muhe Satani umubiri we urimbuke, umwuka we ubone kuzakira ku munsi w'Umwami Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.5",
            "verseOrgIds": [
              "1CO.5.5"
            ]
          }
        }
      ]
    },
