    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ibyerekeye ishyingirwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibyerekeye ibyo mwanyandikiye, ibyiza ni uko umugabo adakora ku mugore. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.1",
            "verseOrgIds": [
              "1CO.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ku bwo kwirinda gusambana, umugabo wese agire uwe mugore, n'umugore wese agire uwe mugabo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.2",
            "verseOrgIds": [
              "1CO.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umugabo ahe umugore we ibimukwiriye kandi n'umugore na we abigenze atyo ku mugabo we, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.3",
            "verseOrgIds": [
              "1CO.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko umugore adatwara umubiri we ahubwo utwarwa n'umugabo we, kandi n'umugabo na we adatwara umubiri we ahubwo utwarwa n'umugore we. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.4",
            "verseOrgIds": [
              "1CO.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntimukimane keretse ahari musezeranye igihe, kugira ngo mubone uburyo bwo gusenga, kandi mwongere guhura Satani atabagerageresha iruba ry'imibiri yanyu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.5",
            "verseOrgIds": [
              "1CO.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.5",
            "verseOrgIds": [
              "1CO.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ibyo mbivuze ku bwanjye si amategeko mbategeka, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.6",
            "verseOrgIds": [
              "1CO.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko nashaka ko abantu bose bamera nkanjye, ariko umuntu wese afite impano ye yahawe n'Imana, umwe ukwe undi ukwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.7",
            "verseOrgIds": [
              "1CO.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.7",
            "verseOrgIds": [
              "1CO.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abatararongorana kandi n'abapfakazi, ndababwira yuko icyiza kuri bo ari uko bagumya kumera nkanjye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.8",
            "verseOrgIds": [
              "1CO.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko niba badashobora kwirinda barongorane, kuko ibyiza ari ukurongorana kuruta gushyuha.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.9",
            "verseOrgIds": [
              "1CO.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.9",
            "verseOrgIds": [
              "1CO.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 7:10"
          },
          "items": [
            {
