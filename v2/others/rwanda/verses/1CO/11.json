              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.1",
            "verseOrgIds": [
              "1CO.11.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.4.16"
              },
              "items": [
                {
                  "text": "1 Kor 4.16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.3.17"
              },
              "items": [
                {
                  "text": "Fili 3.17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mugere ikirenge mu cyanjye, nk'uko nanjye nkigera mu cya Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.1",
            "verseOrgIds": [
              "1CO.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.1",
            "verseOrgIds": [
              "1CO.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndabashimira kuko mwibuka ibyo nabigishije byose, mugakomeza imigenzo nk'uko nayibahaye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.2",
            "verseOrgIds": [
              "1CO.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ndashaka yuko mumenya ko umutwe w'umugabo wese ari Kristo, kandi ko umutwe w'umugore ari umugabo we, kandi ko umutwe wa Kristo ari Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.3",
            "verseOrgIds": [
              "1CO.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umugabo wese iyo asenga cyangwa ahanura umutwe we utwikiriwe, aba akojeje isoni umutwe we. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.4",
            "verseOrgIds": [
              "1CO.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko umugore wese iyo asenga cyangwa ahanura adatwikiriye umutwe we, aba awukojeje isoni kuko ari bimwe rwose no kwimoza. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.5",
            "verseOrgIds": [
              "1CO.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niba umugore adatwikiriye umutwe yikemuze, ariko niba ari ibiteye isoni ko umugore yikemuza cyangwa yimoza, ajye atwikira umutwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.6",
            "verseOrgIds": [
              "1CO.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.1.26+GEN.1.27"
              },
              "items": [
                {
                  "text": "Itang 1.26-27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Umugabo ntakwiriye gutwikira umutwe kuko ari ishusho y'Imana n'ubwiza bwayo, ariko umugore ni ubwiza bw'umugabo we ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.7",
            "verseOrgIds": [
              "1CO.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.2.18+GEN.2.19+GEN.2.20+GEN.2.21+GEN.2.22+GEN.2.23"
              },
              "items": [
                {
                  "text": "Itang 2.18-23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " kuko umugabo atakomotse ku mugore, ahubwo umugore ari we wakomotse ku mugabo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.8",
            "verseOrgIds": [
              "1CO.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi umugabo ntiyaremwe ku bw'umugore, ahubwo umugore ni we waremwe ku bw'umugabo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.9",
            "verseOrgIds": [
              "1CO.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni cyo gituma umugore akwiriye kwambara ku mutwe ikimenyetso cyo gutwarwa ku bw'abamarayika. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.10",
            "verseOrgIds": [
              "1CO.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko mu Mwami wacu umugore ntabaho hatariho umugabo, ni ko n'umugabo atabaho hatariho umugore. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.11",
            "verseOrgIds": [
              "1CO.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nk'uko umugore yakomotse ku mugabo ni ko umugabo abyarwa n'umugore, ariko byose bikomoka ku Mana.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.12",
            "verseOrgIds": [
              "1CO.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.12",
            "verseOrgIds": [
              "1CO.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubwanyu mubitekereze uko biri. Mbese birakwiriye ko umugore asenga Imana adatwikiriye umutwe? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.13",
            "verseOrgIds": [
              "1CO.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kamere yanyu ubwayo ntibahamiriza yuko umugabo iyo ahirimbije umusatsi umukoza isoni, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.14",
            "verseOrgIds": [
              "1CO.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "naho umugore iyo ahirimbije umusatsi ukaba ari ubwiza bwe? Koko yahawe umusatsi mu cyimbo cy'umwambaro wo ku mutwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.15",
            "verseOrgIds": [
              "1CO.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko niba hagira umuntu ushaka kujya impaka, amenye yuko tudafite umugenzo nk'uwo ashaka, kandi n'amatorero y'Imana ntawufite.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.16",
            "verseOrgIds": [
              "1CO.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ibidakwiriye gukorwa mu Ifunguro ryera",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.16",
            "verseOrgIds": [
              "1CO.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ibyo ngiye kubategeka ubu simbibashimira, kuko amateraniro yanyu aho kubungura abatera gusubira inyuma. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.17",
            "verseOrgIds": [
              "1CO.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irya mbere iyo muteraniye mu iteraniro numva yuko mwiremamo ibice, kandi ibyo ndabyemera ho hato, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.18",
            "verseOrgIds": [
              "1CO.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko na none ibice bikwiriye kuba muri mwe ngo abemewe bagaragarizwe ukwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.19",
            "verseOrgIds": [
              "1CO.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " iyo muteraniye hamwe, ntimuba muteranijwe no gusangira Ifunguro ry'Umwami wacu by'ukuri, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.20",
            "verseOrgIds": [
              "1CO.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko iyo murya, umuntu wese yikubira ibye agacura abandi, nuko umwe arasonza naho undi akarengwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.21",
            "verseOrgIds": [
              "1CO.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbese ye, ntimufite ingo zanyu ngo abe ari zo muriramo no kunyweramo? Mugayisha mutyo Itorero ry'Imana mugakoza isoni abakene? Mbese mbabwire iki? Mbashime? Kuri ibyo simbashima.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.22",
            "verseOrgIds": [
              "1CO.11.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.22",
            "verseOrgIds": [
              "1CO.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko icyo nahawe n'Umwami wacu kumenya ni cyo nabahaye namwe, yuko Umwami Yesu ijoro bamugambaniyemo yenze umutsima ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.23",
            "verseOrgIds": [
              "1CO.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "akawushimira, akawumanyagura akavuga ati “Uyu ni umubiri wanjye ubatangiwe, mujye mukora mutya kugira ngo munyibuke.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.24",
            "verseOrgIds": [
              "1CO.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.24.6+EXO.24.7+EXO.24.8"
              },
              "items": [
                {
                  "text": "Kuva 24.6-8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.31.31+JER.31.32+JER.31.33+JER.31.34"
              },
              "items": [
                {
                  "text": "Yer 31.31-34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " N'igikombe akigenza atyo, bamaze kurya ati “Iki gikombe ni isezerano rishya ryo mu maraso yanjye, mujye mukora mutya uko muzajya munyweraho kugira ngo munyibuke.”",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.25",
            "verseOrgIds": [
              "1CO.11.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.25",
            "verseOrgIds": [
              "1CO.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko muzajya murya uwo mutsima mukanywera kuri icyo gikombe, muzaba mwerekana urupfu rw'Umwami Yesu kugeza aho azazira. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.26",
            "verseOrgIds": [
              "1CO.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CO 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni cyo gituma umuntu wese uzarya umutsima w'Umwami wacu, cyangwa uzanywera ku gikombe cye uko bidakwiriye, azagibwaho n'urubanza rwo gucumura ku mubiri n'amaraso by'Umwami. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.27",
            "verseOrgIds": [
              "1CO.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CO 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko umuntu yinire yisuzume abone kurya kuri uwo mutsima no kunywera kuri icyo gikombe, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.28",
            "verseOrgIds": [
              "1CO.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CO 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko upfa kurya, akanywa atitaye ku mubiri w'Umwami, aba arīriye kandi aba anywereye kwishyiraho gucirwa ho iteka. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.29",
            "verseOrgIds": [
              "1CO.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CO 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndetse ni cyo gituma benshi muri mwe bagira intege nke, abandi bakarwaragura, abandi benshi bakaba basinziriye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.30",
            "verseOrgIds": [
              "1CO.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CO 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko twakwisuzuma ntitwagibwaho n'urubanza. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.31",
            "verseOrgIds": [
              "1CO.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CO 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyamara iyo duciriwe urubanza n'Umwami wacu, duhanirwa na we kugira ngo tutazacirirwa ho iteka hamwe n'ab'isi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.32",
            "verseOrgIds": [
              "1CO.11.32"
            ]
          }
        }
      ]
    },
