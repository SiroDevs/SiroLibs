    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Satani abohwa, abakiranutsi bimana na Yesu imyaka igihumbi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbona marayika amanuka ava mu ijuru afite urufunguzo rufungura ikuzimu, afite n'umunyururu munini mu ntoki ze. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.1",
            "verseOrgIds": [
              "REV.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.3.1"
              },
              "items": [
                {
                  "text": "Itang 3.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Afata cya kiyoka, ari cyo ya nzoka ya kera, ari yo Mwanzi na Satani, akibohera kugira ngo kimare imyaka igihumbi, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.2",
            "verseOrgIds": [
              "REV.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "akijugunya ikuzimu arahakinga, ashyiriraho ikimenyetso gifatanya, kugira ngo kitongera kuyobya amahanga kugeza aho iyo myaka igihumbi izashirira, icyakora nishira gikwiriye kubohorerwa kugira ngo kimare igihe gito.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.3",
            "verseOrgIds": [
              "REV.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 20:3"
          },
          "items": [
