              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.3",
            "verseOrgIds": [
              "REV.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
