            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.9"
              },
              "items": [
                {
                  "text": "Dan 7.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.22"
              },
              "items": [
                {
                  "text": "22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mbona intebe z'ubwami, mbona bazicaraho bahabwa ubucamanza. Kandi mbona imyuka y'abaciwe ibihanga babahōra guhamya kwa Yesu n'ijambo ry'Imana, ari bo batāramije ya nyamaswa cyangwa igishushanyo cyayo kandi batashyizweho ikimenyetso cyayo. Barazuka bimana na Kristo imyaka igihumbi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.4",
            "verseOrgIds": [
              "REV.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo ni wo muzuko wa mbere. Abapfuye basigaye ntibazuka, iyo myaka igihumbi itarashira.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.5",
            "verseOrgIds": [
              "REV.20.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "20.5:",
              "type": "text"
            },
            {
              "text": "cyangwa, Abapfuye basigaye ntibazuka, iyo myaka igihumbi itarashira. Uwo ni wo muzuko wa mbere.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.5",
            "verseOrgIds": [
              "REV.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ufite umugabane wo kuzuka kwa mbere arahirwa kandi ni uwera. Urupfu rwa kabiri ntirubasha kugira icyo rutwara abameze batyo, ahubwo bazaba abatambyi b'Imana na Kristo kandi bazimana na yo iyo myaka igihumbi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.6",
            "verseOrgIds": [
              "REV.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.6",
            "verseOrgIds": [
              "REV.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo myaka igihumbi nishira, Satani azabohorwa ave aho yari abohewe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.7",
            "verseOrgIds": [
              "REV.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.7.2"
              },
              "items": [
                {
                  "text": "Ezek 7.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.38.2"
              },
              "items": [
                {
                  "text": "38.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.38.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.38.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Azasohoka ajye kuyobya amahanga yo mu mpfuruka enye z'isi, Gogi na Magogi kugira ngo ayakoranirize intambara, umubare wabo ni nk'umusenyi wo ku nyanja. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.8",
            "verseOrgIds": [
              "REV.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazazamuka bakwire isi yose, bagote amahema y'ingabo z'abera n'umurwa ukundwa. Umuriro uzamanuka uva mu ijuru, ubatwike, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.9",
            "verseOrgIds": [
              "REV.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi Satani wabayobyaga ajugunywe muri ya nyanja yaka umuriro n'amazuku, irimo ya nyamaswa na wa muhanuzi w'ibinyoma. Bazababazwa ku manywa na nijoro iteka ryose.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.10",
            "verseOrgIds": [
              "REV.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
