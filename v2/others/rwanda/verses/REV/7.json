                "loc": "ZEC.6.5"
              },
              "items": [
                {
                  "text": "Zek 6.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hanyuma y'ibyo mbona abamarayika bane bahagaze ku mpfuruka enye z'isi bafashe imiyaga ine yo mu isi, kugira ngo hatagira umuyaga uhuha mu isi cyangwa mu nyanja cyangwa ku giti cyose. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.1",
            "verseOrgIds": [
              "REV.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbona na marayika wundi azamuka ava i burasirazuba, afite ikimenyetso cy'Imana ihoraho, arangurura ijwi rirenga, abwira ba bamarayika bane bahawe kubabaza isi n'inyanja ati ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.2",
            "verseOrgIds": [
              "REV.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.9.4"
              },
              "items": [
                {
                  "text": "Ezek 9.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.9.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Ntimubabaze isi cyangwa inyanja cyangwa ibiti tutaramara gushyira ikimenyetso mu ruhanga rw'imbata z'Imana yacu.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.3",
            "verseOrgIds": [
              "REV.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Numva umubare w'abashyizweho ikimenyetso ngo ni agahumbi n'inzovu enye n'ibihumbi bine. Ni bo bashyizweho ikimenyetso bo mu miryango yose y'Abisirayeli.",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.4",
            "verseOrgIds": [
              "REV.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yohana yerekwa abahowe Yesu bageze mu ijuru",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.8",
            "verseOrgIds": [
              "REV.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma y'ibyo mbona abantu benshi umuntu atabasha kubara, bo mu mahanga yose n'imiryango yose n'amoko yose n'indimi zose, bahagaze imbere ya ya ntebe n'imbere y'Umwana w'Intama, bambaye ibishura byera kandi bafite amashami y'imikindo mu ntoki zabo, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.9",
            "verseOrgIds": [
              "REV.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "bavuga ijwi rirenga bati “Agakiza ni ak'Imana yacu yicaye ku ntebe n'ak'Umwana w'Intama.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.10",
            "verseOrgIds": [
              "REV.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
