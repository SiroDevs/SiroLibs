                "loc": "JER.9.14"
              },
              "items": [
                {
                  "text": "Yer 9.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Iyo nyenyeri yitwa Muravumba. Kimwe cya gatatu cy'amazi gihinduka apusinto, abantu benshi bicwa n'ayo mazi kuko yasharirijwe.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.11",
            "verseOrgIds": [
              "REV.8.11"
            ]
          }
