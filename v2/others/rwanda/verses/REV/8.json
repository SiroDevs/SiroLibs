              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko marayika wa kabiri avuza impanda. Ikimeze nk'umusozi munini waka umuriro kijugunywa mu nyanja, kimwe cya gatatu cy'inyanja gihinduka amaraso, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.8",
            "verseOrgIds": [
              "REV.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kimwe cya gatatu cy'ibyaremwe byo mu nyanja bifite ubugingo birapfa, kandi kimwe cya gatatu cy'inkuge kirarimbuka.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.9",
            "verseOrgIds": [
              "REV.8.9"
            ]
          }
        }
