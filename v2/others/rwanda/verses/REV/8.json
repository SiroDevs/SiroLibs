            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.30.3"
              },
              "items": [
                {
                  "text": "3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Haza marayika wundi ahagarara ku gicaniro afite icyotero cyacuzwe mu izahabu, ahabwa imibavu myinshi ngo ayongere ku mashengesho y'abera bose, ayishyire ku gicaniro cy'izahabu kiri imbere ya ya ntebe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.3",
            "verseOrgIds": [
              "REV.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwotsi w'umubavu uva mu kuboko kwa marayika, uzamukana imbere y'Imana n'amashengesho y'abera.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.4",
            "verseOrgIds": [
              "REV.8.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "umuzamukana . . . abera:",
              "type": "text"
            },
            {
              "text": "cyangwa, uzamuka imbere y'Imana ku bw'amashengesho y'abera.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.4",
            "verseOrgIds": [
              "REV.8.4"
            ]
          }
        },
        {
