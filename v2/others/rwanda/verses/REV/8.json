            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Marayika wa gatatu avuza impanda: inyenyeri nini iva mu ijuru iragwa yaka nk'urumuri, igwa kuri kimwe cya gatatu cy'inzuzi n'imigezi no ku masōko. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.10",
            "verseOrgIds": [
              "REV.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
