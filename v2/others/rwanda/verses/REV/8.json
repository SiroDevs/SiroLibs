              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbona abamarayika barindwi bahora bahagarara imbere y'Imana bahabwa impanda ndwi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.2",
            "verseOrgIds": [
              "REV.8.2"
            ]
          }
        },
