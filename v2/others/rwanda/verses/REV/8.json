                  "text": "16.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nuko marayika ajyana icyo cyotero acyuzuza umuriro wo ku gicaniro akijugunya",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.5",
            "verseOrgIds": [
              "REV.8.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "akijugunya",
              "type": "text"
            },
            {
              "text": "cyangwa, awujugunya.",
              "type": "text"
            }
          ]
        },
        {
          "text": " mu isi, hakurikiraho amajwi avuga n'inkuba zihinda, n'imirabyo n'igishyitsi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.5",
            "verseOrgIds": [
              "REV.8.5"
            ]
          }
        }
