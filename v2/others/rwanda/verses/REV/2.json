          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Nzi aho uba ko ari ho intebe y'ubwami bwa Satani iri, nyamara ugakomeza izina ryanjye ntiwihakane kunyizera, ndetse no mu minsi ya Antipa umugabo wakiranukiraga kumpamya, wiciwe iwanyu aho Satani aba. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.13",
            "verseOrgIds": [
              "REV.2.13"
            ]
          }
        },
