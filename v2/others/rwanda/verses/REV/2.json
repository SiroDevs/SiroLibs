            }
          ]
        },
        {
          "text": "“Ufite inkota ityaye ifite ubugi impande zombi aravuga aya magambo ati ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.12",
            "verseOrgIds": [
              "REV.2.12"
