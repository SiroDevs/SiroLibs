          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dore nzamugusha ku buriri, mutezane amakuba menshi n'abasambane be nibatihana imirimo yabo mibi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.22",
            "verseOrgIds": [
