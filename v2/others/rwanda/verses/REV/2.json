                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ariko rero mfite bike nkugaya, kuko iwanyu ufite abakomeza inyigisho za Balāmu, wigishije Balaki gushyira igisitaza imbere y'Abisirayeli kugira ngo barye intonōrano kandi basambane. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.14",
            "verseOrgIds": [
              "REV.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe ni ko umeze, ufite abakomeza inyigisho z'Abanikolayiti nka bo. ",
          "type": "text",
          "attrs": {
