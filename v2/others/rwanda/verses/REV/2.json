              "type": "text"
            }
          ]
        },
        {
          "text": "“Wandikire marayika w'Itorero ry'i Tuwatira uti",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.18",
            "verseOrgIds": [
              "REV.2.18"
