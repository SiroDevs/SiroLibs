          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Nzi imirimo yawe n'urukundo rwawe no kwizera kwawe, no kugabura kwawe no kwihangana kwawe, n'uburyo imirimo yawe ya nyuma iruta iya mbere kuba myinshi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.19",
            "verseOrgIds": [
              "REV.2.19"
            ]
          }
        },
