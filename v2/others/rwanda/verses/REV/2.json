                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nyamara mfite icyo nkugaya, kuko ukundira urya mugore Yezebeli wiyita umuhanuzikazi akigisha imbata zanjye, akaziyobya kugira ngo zisambane kandi zirye intonōrano. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.20",
            "verseOrgIds": [
              "REV.2.20"
            ]
          }
        },
        {
