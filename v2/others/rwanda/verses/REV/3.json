          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.49.23"
              },
              "items": [
                {
                  "text": "Yes 49.23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.60.14"
              },
              "items": [
                {
                  "text": "60.14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.43.4"
              },
              "items": [
                {
                  "text": "43.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Dore nguhaye bamwe bo mu isinagogi ya Satani biyita Abayuda nyamara atari bo, ahubwo ari abanyabinyoma. Dore nzabahata kuza bikubite imbere y'ibirenge byawe, bamenye yuko nagukunze. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.9",
            "verseOrgIds": [
              "REV.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko witondeye ijambo ryo kwihangana kwanjye, nanjye nzakurinda igihe cyo kugerageza kigiye kuza mu bihugu byose kugerageza abari mu isi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.10",
            "verseOrgIds": [
              "REV.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaza vuba, komeza ibyo ufite hatagira ugutwara ikamba ryawe.’",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.11",
            "verseOrgIds": [
              "REV.3.11"
            ]
          }
        }
      ]
    },
