              "items": [
                {
                  "text": "Ibyah 16.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nuko ibuka ibyo wākiriye n'ibyo wumvise, ubyitondere kandi wihane. Ariko rero nutaba maso nzaza nk'umujura, nawe ntuzamenya igihe nzagutungurira. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.3",
            "verseOrgIds": [
              "REV.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icyakora ufite amazina make y'ab'i Sarudi batanduje imyenda yabo. Ni bo bazagendana nanjye bambaye imyenda yera kuko babikwiriye.’",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.4",
            "verseOrgIds": [
              "REV.3.4"
            ]
          }
        }
