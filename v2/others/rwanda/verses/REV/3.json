            "number": "1",
            "style": "v",
            "sid": "REV 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ufite Imyuka irindwi y'Imana n'inyenyeri ndwi aravuga aya magambo ati ‘Nzi imirimo yawe n'uko ufite izina ry'uko uriho, nyamara ukaba uri intumbi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.1",
            "verseOrgIds": [
              "REV.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jya uba maso ukomeze ibisigaye bigiye gupfa, kuko nabonye ko ari nta mirimo mwakoze itunganye rwose imbere y'Imana yanjye. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.2",
            "verseOrgIds": [
              "REV.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
