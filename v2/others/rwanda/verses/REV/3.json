          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Uwera kandi w'ukuri ufite urufunguzo rwa Dawidi, ukingura ntihagire ukinga kandi ukinga ntihagire ukingura, aravuga aya magambo ati ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.7",
            "verseOrgIds": [
              "REV.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Nzi imirimo yawe. Dore nshyize imbere yawe urugi rukinguye kandi nta wubasha kurukinga, kuko ufite imbaraga nke nyamara ukitondera ijambo ryanjye, ntiwihakane izina ryanjye. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.8",
            "verseOrgIds": [
              "REV.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 3:9"
          },
          "items": [
