          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Unesha nzamuha kwicarana nanjye ku ntebe yanjye y'ubwami, nk'uko nanjye nanesheje nkicarana na Data ku ntebe ye.",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.21",
