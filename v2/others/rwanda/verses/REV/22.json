                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Anyereka uruzi rw'amazi y'ubugingo rubonerana nk'isarabwayi, ruva ku ntebe y'Imana n'Umwana w'Intama, ",
          "type": "text",
          "attrs": {
