                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.47.12"
              },
              "items": [
                {
                  "text": "Ezek 47.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " rutembera mu nzira nyabagendwa hagati. Hakurya no hakuno y'urwo ruzi, hariho igiti cy'ubugingo cyera imbuto z'uburyo cumi na bubiri, cyera imbuto z'uburyo bumwe bumwe uko ukwezi gutashye. Ibibabi byacyo byari ibyo gukiza amahanga.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.2",
            "verseOrgIds": [
              "REV.22.2"
            ]
          }
        }
      ]
    },
