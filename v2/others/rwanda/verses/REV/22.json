                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Hahirwa abamesera ibishura byabo kugira ngo bemererwe kwegera cya giti cy'ubugingo, kandi banyure mu marembo binjire muri rwa rurembo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.14",
            "verseOrgIds": [
              "REV.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanze hazaba imbwa n'abarozi n'abasambanyi, n'abicanyi n'abasenga ibishushanyo, n'umuntu wese ukunda kubeshya akabikora.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.15",
            "verseOrgIds": [
              "REV.22.15"
            ]
