          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nihagira umuntu ukura ku magambo y'igitabo cy'ubu buhanuzi, Imana izamukura ku mugabane wa cya giti",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.19",
            "verseOrgIds": [
              "REV.22.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "ku mugabane . . . giti:",
              "type": "text"
            },
            {
              "text": "cyangwa, mu gitabo.",
              "type": "text"
            }
          ]
        },
        {
          "text": " cy'ubugingo no ku wa rwa rurembo rwera, byanditswe muri iki gitabo.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.19",
            "verseOrgIds": [
              "REV.22.19"
            ]
          }
        }
