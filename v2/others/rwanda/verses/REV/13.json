                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.17.3"
              },
              "items": [
                {
                  "text": "Ibyah 17.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.17.7+REV.17.8+REV.17.9+REV.17.10+REV.17.11+REV.17.12"
              },
              "items": [
                {
                  "text": "7-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ngihagarara ku musenyi wo ku nyanja, ngiye kubona mbona inyamaswa iva mu nyanja ifite amahembe cumi n'imitwe irindwi. Ku mahembe yayo hariho ibisingo cumi, no ku mitwe yayo hariho amazina yo gutuka Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.1",
            "verseOrgIds": [
              "REV.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.4+DAN.7.5+DAN.7.6"
              },
              "items": [
                {
                  "text": "Dan 7.4-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Iyo nyamaswa nabonye yasaga n'ingwe, amajanja yayo yasaga n'aya aruko",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.2",
            "verseOrgIds": [
              "REV.13.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "aruko",
              "type": "text"
            },
            {
              "text": "ni inyamaswa nini y'inkazi.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", akanwa kayo kasaga n'ak'intare. Cya kiyoka kiyiha imbaraga zacyo n'intebe yacyo y'ubwami, n'ubutware bukomeye.",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.2",
            "verseOrgIds": [
              "REV.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.2",
            "verseOrgIds": [
              "REV.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko mbona umwe mu mitwe yayo usa n'ukomeretse uruguma rwica, ariko urwo ruguma rwawishe rurakira. Abari mu isi yose bakurikira iyo nyamaswa bayitangarira. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.3",
            "verseOrgIds": [
              "REV.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramya icyo kiyoka kuko cyahaye iyo nyamaswa ubutware bwacyo, baramya n'iyo nyamaswa bati “Ni nde uhwanye n'iyi nyamaswa, kandi ni nde ubasha kuyirwanya?”",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.4",
            "verseOrgIds": [
              "REV.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.4",
            "verseOrgIds": [
              "REV.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 13:5"
          },
          "items": [
