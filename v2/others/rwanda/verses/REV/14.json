                "loc": "EZK.9.4"
              },
              "items": [
                {
                  "text": "Ezek 9.4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.7.3"
              },
              "items": [
                {
                  "text": "Ibyah 7.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nuko ngiye kubona mbona Umwana w'Intama ahagaze ku musozi wa Siyoni, ahagararanye n'abantu agahumbi n'inzovu enye n'ibihumbi bine, bafite izina rye n'izina rya Se yanditswe mu ruhanga rwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.1",
            "verseOrgIds": [
              "REV.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Numva ijwi rivugira mu ijuru rimeze nk'iry'amazi menshi asuma, kandi nk'iry'inkuba ihinda cyane, kandi iryo jwi numvise ryari rimeze nk'iry'abacuranzi bacuranga inanga zabo, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.2",
            "verseOrgIds": [
              "REV.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "baririmba indirimbo nshya imbere ya ya ntebe y'ubwami n'imbere ya bya bizima bine na ba bakuru. Nta muntu wabashije kwiga iyo ndirimbo, keretse ba bantu agahumbi n'inzovu enye n'ibihumbi bine bacunguwe ngo bakurwe mu isi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.3",
            "verseOrgIds": [
              "REV.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.3",
            "verseOrgIds": [
              "REV.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo ni bo batandujwe n'abagore kuko ari abāri. Abo ni bo bakurikira Umwana w'Intama aho ajya hose. Bacunguriwe mu bantu kugira ngo babe umuganura ku Mana no ku Mwana w'Intama. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.4",
            "verseOrgIds": [
              "REV.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEP.3.13"
              },
              "items": [
                {
                  "text": "Zef 3.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mu kanwa kabo ntihabonetsemo ibinyoma, kuko ari abaziranenge.",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.5",
            "verseOrgIds": [
              "REV.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ubutumwa bw'abamarayika batatu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
