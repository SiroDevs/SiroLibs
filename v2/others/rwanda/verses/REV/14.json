              },
              "items": [
                {
                  "text": "Yes 34.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Umwotsi wo kubabazwa kwabo ucumba iteka ryose, ntibaruhuka ku manywa na nijoro abaramya ya nyamaswa n'igishushanyo cyayo, umuntu wese ushyirwaho ikimenyetso cy'izina ryayo.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.11",
            "verseOrgIds": [
              "REV.14.11"
            ]
          }
        }
