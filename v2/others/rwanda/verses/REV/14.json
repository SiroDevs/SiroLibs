          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho ni ho kwihangana kw'abera kuri, bitondera amategeko y'Imana bakagira kwizera ",
          "type": "text",
          "attrs": {
