            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.38.22"
              },
              "items": [
                {
                  "text": "Ezek 38.22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " uwo ni we uzanywa ku nzoga ari yo mujinya w'Imana, yiteguwe idafunguwemo amazi mu gacuma k'umujinya wayo. Kandi azababazwa n'umuriro n'amazuku imbere y'abamarayika bera, n'imbere y'Umwana w'Intama. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.10",
            "verseOrgIds": [
              "REV.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
