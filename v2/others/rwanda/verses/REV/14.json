              "items": [
                {
                  "text": "Yow 4.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Marayika wundi ava mu rusengero arangurura ijwi rirenga, abwira uwicaye kuri icyo gicu ati “Ahuramo umuhoro wawe, usarure kuko isarura risohoye, kandi ibisarurwa byo mu isi byeze cyane.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.15",
            "verseOrgIds": [
              "REV.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko uwicaye ku gicu yahura umuhoro we mu isi, isi irasarurwa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.16",
            "verseOrgIds": [
              "REV.14.16"
            ]
          }
        }
      ]
    },
