            "number": "6",
            "style": "v",
            "sid": "REV 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko mbona marayika wundi aguruka aringanije ijuru, afite ubutumwa bwiza bw'iteka ryose ngo abubwira abari mu isi, bo mu mahanga yose n'imiryango yose, n'indimi zose n'amoko yose. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.6",
            "verseOrgIds": [
              "REV.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avuga ijwi rirenga ati “Nimwubahe Imana muyihimbaze, kuko igihe cyo gucira abantu urubanza gisohoye, muramye Iyaremye ijuru n'isi n'inyanja n'amasōko.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.7",
            "verseOrgIds": [
              "REV.14.7"
            ]
          }
        }
      ]
    },
    {
