    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Umwana w'Intama n'abo yacunguye bari ku musozi wa Siyoni",
          "type": "text"
        }
      ]
    },
    {
