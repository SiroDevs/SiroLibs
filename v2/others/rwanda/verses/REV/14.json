            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mbona igicu cyera, no ku gicu mbona uwicayeho usa n'Umwana w'umuntu, wambaye ikamba ry'izahabu ku mutwe kandi afite umuhoro utyaye mu intoki ze. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.14",
            "verseOrgIds": [
              "REV.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
