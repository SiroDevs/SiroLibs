            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.6.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Umwana w'Intama amennye ikimenyetso cya gatatu, numva ikizima cya gatatu kivuga kiti “Ngwino.” Nuko ngiye kubona mbona ifarashi y'umukara, kandi uyicayeho yari afite urugero rw'indatira mu intoki ze. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.5",
            "verseOrgIds": [
              "REV.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Numva hagati y'ibyo bizima bine igisa n'ijwi rivuga riti “Urugero rumwe rw'ingano rugurwe idenariyo imwe, n'ingero eshatu za sayiri zigurwe idenariyo imwe, naho amavuta na vino ntugire icyo ubitwara.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.6",
            "verseOrgIds": [
              "REV.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
