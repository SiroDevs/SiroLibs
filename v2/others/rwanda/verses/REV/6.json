              },
              "items": [
                {
                  "text": "Ibyah 16.20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ijuru rikurwaho nk'uko bazinga igitabo cy'umuzingo, imisozi yose n'ibirwa byose bikurwa ahantu habyo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.14",
            "verseOrgIds": [
              "REV.6.14"
            ]
          }
        },
        {
