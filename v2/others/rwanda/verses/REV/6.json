            "number": "1",
            "style": "v",
            "sid": "REV 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko mbona Umwana w'Intama amena kimwe muri ibyo bimenyetso birindwi bifatanije cya gitabo, numva kimwe muri bya bizima bine kivuga ijwi nk'iry'inkuba kiti “Ngwino.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.1",
            "verseOrgIds": [
              "REV.6.1"
            ]
          }
        }
      ]
    },
