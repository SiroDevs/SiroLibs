                {
                  "text": "6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ngiye kubona mbona ifarashi y'umweru, kandi uyicayeho yari afite umuheto ahabwa ikamba, nuko agenda anesha kandi ngo ahore anesha.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.2",
            "verseOrgIds": [
              "REV.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
