                "loc": "ISA.34.4"
              },
              "items": [
                {
                  "text": "Yes 34.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " inyenyeri zo mu ijuru zigwa hasi, nk'uko umutini iyo unyeganyejwe n'umuyaga mwinshi uragarika imbuto zawo zidahishije, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.13",
            "verseOrgIds": [
              "REV.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
