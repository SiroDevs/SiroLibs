                  "text": "Mat",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nuko mbona amena ikimenyetso cya gatandatu, habaho igishyitsi cyinshi, izuba ririrabura nk'ikigunira kiboheshejwe ubwoya, ukwezi kose guhinduka nk'amaraso, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.12",
            "verseOrgIds": [
              "REV.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
