            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwana w'Intama amennye ikimenyetso cya kane, numva ijwi ry'ikizima cya kane kivuga kiti “Ngwino.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.7",
            "verseOrgIds": [
              "REV.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.14.21"
              },
              "items": [
                {
                  "text": "Ezek 14.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nuko, ngiye kubona mbona ifarashi y'igitare igajutse, kandi uyicayeho yitwa Rupfu, kandi Kuzimu aramukurikira. Nuko bahabwa ubutware bwa kimwe cya kane cy'isi, ngo babicishe inkota n'inzara n'urupfu, n'ibikoko byo mu isi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.8",
            "verseOrgIds": [
              "REV.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.8",
            "verseOrgIds": [
              "REV.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwana w'Intama amennye ikimenyetso cya gatanu, mbona munsi y'igicaniro imyuka y'abishwe bahōwe ijambo ry'Imana n'ubuhamya bahamyaga. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.9",
            "verseOrgIds": [
              "REV.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batakana ijwi rirenga bati “Ayii Mwami wera w'ukuri! Uzageza he kudaca amateka no kudahōra abari mu isi, uhōrere amaraso yacu?” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.10",
            "verseOrgIds": [
              "REV.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu wese muri bo ahabwa igishura cyera, babwirwa kumara n'ikindi gihe gito baruhuka, kugeza aho umubare w'imbata bagenzi babo na bene Se bagiye kwicwa nka bo uzuzurira.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.11",
            "verseOrgIds": [
              "REV.6.11"
            ]
          }
        }
      ]
    },
