          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma y'ibyo ngiye kubona mbona mu ijuru urugi rukinguye, kandi numva rya jwi nabanje kumva rivugana nanjye rimeze nk'iry'impanda rimbwira riti “Zamuka uze hano nkwereke ibikwiriye kuzabaho hanyuma y'ibyo.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.1",
            "verseOrgIds": [
              "REV.4.1"
            ]
          }
        }
      ]
    },
