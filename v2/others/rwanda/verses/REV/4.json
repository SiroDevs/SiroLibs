                "loc": "EZK.1.13"
              },
              "items": [
                {
                  "text": "Ezek 1.13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.4"
              },
              "items": [
                {
                  "text": "Ibyah 1.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kuri ya ntebe y'ubwami haturukaga imirabyo n'amajwi no guhinda kw'inkuba, kandi amatabaza arindwi yaka umuriro yamurikiraga imbere y'iyo ntebe. Ayo matabaza ni yo Myuka irindwi y'Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.5",
            "verseOrgIds": [
              "REV.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Ezek 1.22,5-10",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.10.14"
              },
              "items": [
                {
                  "text": "10.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Imbere y'iyo ntebe hariho igisa n'inyanja y'ibirahuri isa n'isarabwayi, kandi hagati y'iyo ntebe no kuyizenguruka hari ibizima bine byuzuye amaso imbere n'inyuma. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.6",
            "verseOrgIds": [
              "REV.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikizima cya mbere cyasaga n'intare, icya kabiri gisa n'ikimasa, icya gatatu cyari gifite mu maso hasa n'ah'umuntu, naho icya kane cyasaga n'ikizu kiguruka. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.7",
            "verseOrgIds": [
              "REV.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.18"
              },
              "items": [
                {
                  "text": "Ezek 1.18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.10.12"
              },
              "items": [
                {
                  "text": "10.12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.6.2+ISA.6.3"
              },
              "items": [
                {
                  "text": "Yes 6.2-3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ibyo bizima uko ari bine byari bifite amababa atandatu atandatu, byuzuye amaso impande zose no mu nda. Ntibiruhuka ku manywa na nijoro, ahubwo bihora bivuga biti “Uwera, Uwera, Uwera, ni we Mwami Imana Ishoborabyose, ni yo yahozeho kandi iriho kandi izahoraho.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.8",
            "verseOrgIds": [
              "REV.4.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "izahoraho:",
              "type": "text"
            },
            {
              "text": "cyangwa, izaza.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.8",
            "verseOrgIds": [
              "REV.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo ibyo bizima bihaye Iyicara kuri ya ntebe ihoraho iteka ryose, icyubahiro no guhimbazwa n'ishimwe, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.9",
            "verseOrgIds": [
              "REV.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ba bakuru makumyabiri na bane bikubita imbere y'Iyicara kuri iyo ntebe, bakaramya Ihoraho iteka ryose, bakajugunya amakamba yabo imbere y'iyo ntebe bavuga bati ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.10",
            "verseOrgIds": [
              "REV.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwami wacu, Mana yacu, ukwiriye guhabwa icyubahiro no guhimbazwa n'ubutware koko, kuko ari wowe waremye byose. Igituma biriho kandi icyatumye biremwa ni uko wabishatse.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.11",
            "verseOrgIds": [
              "REV.4.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "uko wabishatse:",
              "type": "text"
            },
            {
              "text": "cyangwa, ukugira ngo biguhimbaze.",
              "type": "text"
            }
          ]
        }
      ]
    }
