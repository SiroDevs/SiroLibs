              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.11",
            "verseOrgIds": [
              "RUT.4.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.29.31"
              },
              "items": [
                {
                  "text": "Itang 29.31",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nuko abantu bose bari mu marembo n'abakuru baramusubiza bati “Turi abagabo b'ibyo. Uwo mugore uje mu nzu yawe Uwiteka amuhwanye na Rasheli na Leya, abashinze bombi inzu y'Abisirayeli. Nawe ujye werekana gukomera kwawe muri Efurata, ube ikirangirire i Betelehemu. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.11",
            "verseOrgIds": [
              "RUT.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "RUT 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.38.27+GEN.38.28+GEN.38.29+GEN.38.30"
              },
              "items": [
                {
                  "text": "Itang 38.27-30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Icyaduha urubyaro Uwiteka azaguha kuri iyo nkumi rukazahwanya inzu yawe n'iya Perēsi, uwo Tamari yabyariye Yuda.”",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.12",
            "verseOrgIds": [
              "RUT.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bowazi ahungura Rusi, abyara Obedi sekuru wa Dawidi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "RUT 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.12",
            "verseOrgIds": [
              "RUT.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "RUT 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Bowazi acyura Rusi aba umugore we, aryamana na we Uwiteka amuha gusama inda, abyara umuhungu. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.13",
            "verseOrgIds": [
              "RUT.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "RUT 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abagore babwira Nawomi bati “Uwiteka ahimbazwe, utakuretse udafite umucunguzi. Icyaduha akazaba ikirangirire mu Bisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.14",
            "verseOrgIds": [
              "RUT.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "RUT 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi azasubiza intege mu bugingo bwawe, azagutunga mu bukecuru bwawe, kuko umukazana wawe ugukunda akakugirira umumaro uruta uwo abahungu barindwi, ari we umubyaye.” ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.15",
            "verseOrgIds": [
              "RUT.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "RUT 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawomi ajyana uwo mwana amushyira mu gituza cye, aba umurezi we.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.16",
            "verseOrgIds": [
              "RUT.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "RUT 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.16",
            "verseOrgIds": [
              "RUT.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "RUT 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abagore b'abaturanyi be bamwita izina bati “Nawomi abyariwe umuhungu.” Bamwita Obedi ari we se wa Yesayi, se wa Dawidi.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.17",
            "verseOrgIds": [
              "RUT.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "RUT 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.17",
            "verseOrgIds": [
              "RUT.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "RUT 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uru ni rwo rubyaro rwa Perēsi: Perēsi yabyaye Hesironi, ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.18",
            "verseOrgIds": [
              "RUT.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "RUT 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hesironi yabyaye Ramu, Ramu yabyaye Aminadabu, ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.19",
            "verseOrgIds": [
              "RUT.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "RUT 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
