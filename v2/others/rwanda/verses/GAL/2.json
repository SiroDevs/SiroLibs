              },
              "items": [
                {
                  "text": "15.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hashize imyaka cumi n'ine nsubira kuzamuka njya i Yerusalemu ndi kumwe na Barinaba, njyana na Tito ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.1",
            "verseOrgIds": [
              "GAL.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GAL 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "njyanyweyo n'ibyo nahishuriwe. Nuko mbasobanurira ubutumwa bwiza mbwiriza mu banyamahanga, icyakora mbubasobanurira abakuru bashimwa twiherereye ngo ntirukira ubusa, cyangwa ngo mbe narirukiye ubusa. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.2",
            "verseOrgIds": [
              "GAL.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GAL 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo Tito twari kumwe ari Umugiriki ntibamuhatiye gukebwa, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.3",
            "verseOrgIds": [
              "GAL.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GAL 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahubwo hanyuma byatewe na bene Data b'indyarya, binjijwe rwihereranwa no gutata umudendezo wacu dufite muri Kristo Yesu, kugira ngo badushyire mu bubata. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.4",
            "verseOrgIds": [
              "GAL.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GAL 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo ntitwabumviye na hato ngo dutegekwe na bo, kugira ngo ukuri k'ubutumwa bwiza kugume muri mwe.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.5",
            "verseOrgIds": [
              "GAL.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
