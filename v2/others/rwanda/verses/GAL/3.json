              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbese ubwo bibaye bityo, amategeko arwanya amasezerano y'Imana? Ntibikabeho kuko iyaba harabayeho amategeko abasha kubeshaho abantu, gukiranuka kuba kwaraheshejwe na yo. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.21",
            "verseOrgIds": [
              "GAL.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GAL 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ibyanditswe bivuga yuko byose byakingiraniwe gutwarwa n'ibyaha, kugira ngo abizera bahabwe ibyasezeranijwe, babiheshejwe no kwizera Yesu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.22",
            "verseOrgIds": [
              "GAL.3.22"
            ]
          }
        }
      ]
    },
