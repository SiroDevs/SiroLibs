          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko kwizera kumaze kuza ntitwaba tugitwarwa na wa mushorera.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.25",
            "verseOrgIds": [
              "GAL.3.25"
            ]
          }
        }
