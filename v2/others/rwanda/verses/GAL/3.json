              "type": "text"
            }
          ]
        },
        {
          "text": "Mwese muri abana b'Imana mubiheshejwe no kwizera Kristo Yesu, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.26",
            "verseOrgIds": [
