            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.4.3"
              },
              "items": [
                {
                  "text": "Rom 4.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nk'uko Aburahamu yizeye Imana bikamuhwanirizwa no gukiranuka, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.6",
            "verseOrgIds": [
              "GAL.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GAL 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.4.16"
              },
              "items": [
                {
                  "text": "Rom 4.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " mumenye yuko ari na ko abīringira kwizera ari bo bana ba Aburahamu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.7",
            "verseOrgIds": [
              "GAL.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GAL 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.12.3"
              },
              "items": [
                {
                  "text": "Itang 12.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kandi ibyanditswe byamenye bitaraba yuko Imana izatsindishiriza abanyamahanga kuko bizeye, bibwira Aburahamu ubutumwa bwiza bw'ibitaraba biti “Muri wowe ni mo amahanga yose azaherwa umugisha.” ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.8",
            "verseOrgIds": [
              "GAL.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GAL 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko abīringira kwizera bahānwa umugisha na Aburahamu wizeraga.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.9",
            "verseOrgIds": [
              "GAL.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
