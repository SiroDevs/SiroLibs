          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubwo ni bwo buryo amategeko yatubereye umushorera wo kutugeza kuri Kristo, ngo dutsindishirizwe no kwizera. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.24",
            "verseOrgIds": [
              "GAL.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
