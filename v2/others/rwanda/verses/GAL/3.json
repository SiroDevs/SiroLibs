              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icyakora uko kwizera kutaraza twarindwaga tubohewe gutwarwa n'amategeko, dutegereje kwizera kwari kugiye guhishurwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.23",
            "verseOrgIds": [
              "GAL.3.23"
            ]
          }
        },
        {
