          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.13",
            "verseOrgIds": [
              "NAM.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NAM 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Uwiteka yategetse ibyawe ngo nta mbuto zitirirwa izina ryawe zizongera kubaho, nzaca igishushanyo kibajwe n'igishushanyo kiyagijwe mbikure mu nzu y'ibigirwamana byawe, nzagucukurira imva yawe kuko uri umunyagisuzuguriro.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.14",
            "verseOrgIds": [
              "NAM.1.14"
            ]
          }
        }
      ]
    }
