        "style": "s1"
      },
      "items": [
        {
          "text": "Imyubakire y'urusengero",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
