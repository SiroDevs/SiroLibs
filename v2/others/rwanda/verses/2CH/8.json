          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.16",
            "verseOrgIds": [
              "2CH.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma Salomo ajya Esiyonigeberi na Eloti, ku nkengero y'inyanja mu gihugu cya Edomu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.17",
            "verseOrgIds": [
              "2CH.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiramu amwoherereza inkuge zijyanwa n'abagaragu be bamenyereye inyanja, bajyana n'abagaragu ba Salomo Ofiri, bakurayo italanto z'izahabu magana ane na mirongo itanu bazishyira Umwami Salomo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.18",
            "verseOrgIds": [
              "2CH.8.18"
            ]
          }
        }
