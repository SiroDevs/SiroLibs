              "2CH.9.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.42"
              },
              "items": [
                {
                  "text": "Mat 12.42",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.11.31"
              },
              "items": [
                {
                  "text": "Luka 11.31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Umugabekazi w'i Sheba yumvise inkuru ya Salomo, aza i Yerusalemu azanywe no kumubaza ibinaniranye amugerageza. Yari azanye n'abantu benshi cyane n'ingamiya zihetse ibihumura neza, n'izahabu nyinshi cyane n'amabuye y'igiciro cyinshi. Ageze kuri Salomo amurondorera ibyari mu mutima we byose. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.1",
            "verseOrgIds": [
              "2CH.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salomo amusobanurira ibyo yamubajije byose, nta kintu cyasobye Salomo atamusobanuriye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.2",
            "verseOrgIds": [
              "2CH.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko umugabekazi w'i Sheba abonye ubwenge bwa Salomo n'inzu yubatse, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.3",
            "verseOrgIds": [
              "2CH.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'ibyokurya byo ku meza ye n'imyicarire y'abagaragu be, no guhereza kw'abahereza be n'imyambarire yabo, n'abahereza be ba vino n'imyambarire yabo, n'urwuririro yazamukiragaho ajya mu nzu y'Uwiteka, arumirwa bimukura umutima.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.4",
            "verseOrgIds": [
              "2CH.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.4",
            "verseOrgIds": [
              "2CH.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aherako abwira umwami ati “Inkuru numviye mu gihugu cyanjye z'ibyo wakoze n'iz'ubwenge bwawe, zari iz'ukuri. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.5",
            "verseOrgIds": [
              "2CH.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko sindakemera ibyo bavuze kugeza aho naziye nkabyirebera n'ayanjye maso, kandi mbonye ko ntabwiwe n'igice cy'ubwenge bwawe bukomeye, urengeje inkuru numvise. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.6",
            "verseOrgIds": [
              "2CH.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hahirwa abantu bawe, aba bagaragu bawe barahirwa bibera imbere yawe iminsi yose, bakumva ubwenge bwawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.7",
            "verseOrgIds": [
              "2CH.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwiteka Imana yawe ihimbazwe, yakwishimiye ikakwicaza ku ntebe yayo ukaba umwami utwarira Uwiteka Imana yawe, kuko Imana yawe yakunze ubwoko bwa Isirayeli ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.8",
            "verseOrgIds": [
              "2CH.9.8"
            ]
          }
        },
        {
          "text": " kubukomeza iteka ryose, ni cyo cyatumye ikugira umwami wabo ngo uce imanza zitabera.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.8",
            "verseOrgIds": [
              "2CH.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.8",
            "verseOrgIds": [
              "2CH.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze atura umwami italanto z'izahabu ijana na makumyabiri, n'ibihumura neza byinshi cyane n'amabuye y'igiciro cyinshi, kandi ntabwo higeze kubaho ibihumura neza nk'ibyo umugabekazi w'i Sheba yatuye Umwami Salomo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.9",
            "verseOrgIds": [
              "2CH.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.9",
            "verseOrgIds": [
              "2CH.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi n'abagaragu ba Hiramu n'aba Salomo, abazanaga izahabu ya Ofiri, ni bo bazanaga ibiti bimeze nk'imisagavu n'amabuye y'igiciro cyinshi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.10",
            "verseOrgIds": [
              "2CH.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami akoresha ibiti bimeze nk'imisagavu inzuririro z'inzu y'Uwiteka n'iz'inzu y'ubwami, abibāzamo n'inanga na nebelu by'abaririmbyi, kandi kera kose mu gihugu cy'i Buyuda ntihigeze kuboneka ibiti nk'ibyo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.11",
            "verseOrgIds": [
              "2CH.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.11",
            "verseOrgIds": [
              "2CH.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Umwami Salomo aha umugabekazi w'i Sheba ibyo yifuzaga n'ibyo yasabye byose, biruta ibyo yatuye umwami. Nuko arahaguruka asubira mu gihugu cye n'abagaragu be.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.12",
            "verseOrgIds": [
              "2CH.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ubutunzi bwa Salomo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.12",
            "verseOrgIds": [
              "2CH.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izahabu yajyaga kwa Salomo mu mwaka yari italanto magana atandatu na mirongo itandatu n'esheshatu, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.13",
            "verseOrgIds": [
              "2CH.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "udashyizeho izo abagenza n'abacuruzi bazanaga, kandi abami ba Arabiya bose n'abatware bo mu gihugu bajyaga bazanira Salomo izahabu n'ifeza. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.14",
            "verseOrgIds": [
              "2CH.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Salomo acurisha ingabo magana abiri mu izahabu, italanto z'izahabu magana atandatu zikajya zicurwamo ingabo imwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.15",
            "verseOrgIds": [
              "2CH.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acura n'ingabo ntoya magana atatu mu izahabu, ishekeli magana atandatu z'izahabu zikajya zicurwamo ingabo imwe, umwami azitambika mu nzu y'ibiti by'ikibira cy'i Lebanoni.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.16",
            "verseOrgIds": [
              "2CH.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.16",
            "verseOrgIds": [
              "2CH.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi umwami yibarishiriza intebe nini y'ubwami mu mahembe y'inzovu, ayiteraho izahabu itunganijwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.17",
            "verseOrgIds": [
              "2CH.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo ntebe yari ifite urwuririro rw'intambwe esheshatu, ifite n'agatebe k'ibirenge k'izahabu. Izo nzuririro zari zifashe ku ntebe, kandi hariho n'imikondo impande zombi z'ahicarwa, n'ibishushanyo by'intare bibiri bihagaze impande zombi iruhande rw'imikondo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.18",
            "verseOrgIds": [
              "2CH.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ibindi bishushanyo by'intare cumi na bibiri byahagararaga impande zombi ku nzuririro uko ari esheshatu. Mu bihugu byose nta ntebe yigeze kubazwa isa na yo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.19",
            "verseOrgIds": [
              "2CH.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.19",
            "verseOrgIds": [
              "2CH.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibintu umwami yanyweshaga byose byari izahabu, n'ibirirwaho byose byo mu nzu y'ibiti by'ikibira cy'i Lebanoni byari izahabu itunganijwe. Ku ngoma ya Salomo ifeza ntiyatekerezwaga ko ari ikintu, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.20",
            "verseOrgIds": [
              "2CH.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko umwami yari afite inkuge zajyaga zijya i Tarushishi zijyanwa n'abagaragu ba Hiramu. Uko imyaka itatu yashiraga, inkuge z'i Tarushishi zajyaga zigaruka zizanye izahabu n'ifeza, n'amahembe y'inzovu n'inkima na tawusi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.21",
            "verseOrgIds": [
              "2CH.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.21",
            "verseOrgIds": [
              "2CH.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Salomo arusha abami bo mu isi bose ubutunzi n'ubwenge. ",
          "type": "text",
          "attrs": {
