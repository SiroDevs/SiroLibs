        "style": "s1"
      },
      "items": [
        {
          "text": "Iby'Umugabekazi w'i Sheba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
