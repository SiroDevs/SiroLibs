              "items": [
                {
                  "text": "1 Abami 5.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi Salomo yari afite ibiraro by'amafarashi ibihumbi bine yakururaga amagare ye, n'abagendera ku mafarashi inzovu imwe n'ibihumbi bibiri, ibyo abishyira mu midugudu ibikwamo amagare n'i Yerusalemu mu murwa w'umwami. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.25",
            "verseOrgIds": [
              "2CH.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.15.18"
              },
              "items": [
                {
                  "text": "Itang 15.18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.5.1"
              },
              "items": [
                {
                  "text": "1 Abami 5.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kandi yategekaga abami bose, uhereye kuri rwa Ruzi ukageza ku gihugu cy'Abafilisitiya no ku rugabano rwa Egiputa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.26",
            "verseOrgIds": [
              "2CH.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami atuma i Yerusalemu hagwira ifeza ingana n'amabuye yaho ubwinshi, n'ibiti by'imyerezi atuma bingana n'imivumu yo mu kibaya ubwinshi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.27",
            "verseOrgIds": [
              "2CH.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.16"
              },
              "items": [
                {
                  "text": "Guteg 17.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kandi bazaniraga Salomo amafarashi avuye muri Egiputa no mu bihugu byose.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.28",
            "verseOrgIds": [
              "2CH.9.28"
            ]
          }
        }
