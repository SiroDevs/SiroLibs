                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hanyuma Nebukadinezari umwami w'i Babuloni aramutera, amubohesha imihana amujyana i Babuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.6",
            "verseOrgIds": [
              "2CH.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Nebukadinezari ajyana ibintu byo mu nzu y'Uwiteka i Babuloni, abishyira mu rusengero rwe rw'i Babuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.7",
            "verseOrgIds": [
              "2CH.36.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko indi mirimo ya Yehoyakimu n'ibizira yakoraga n'ibyamubonekagaho, byanditswe mu gitabo cy'abami b'Abisirayeli n'ab'Abayuda, maze umuhungu we Yehoyakini yima ingoma ye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.8",
            "verseOrgIds": [
              "2CH.36.8"
            ]
          }
        }
