      },
      "items": [
        {
          "text": "Umwami Yowahazi aneshwa n'Umwami Nebukadinezari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 36:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze abantu bo mu gihugu bajyana Yowahazi mwene Yosiya, bamwimika ingoma ya se i Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.1",
            "verseOrgIds": [
              "2CH.36.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowahazi atangira gutegeka yari amaze imyaka makumyabiri n'itatu avutse, amara amezi atatu i Yerusalemu ari ku ngoma. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.2",
            "verseOrgIds": [
              "2CH.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami wa Egiputa amukura ku ngoma i Yerusalemu, atangisha abo mu gihugu italanto z'ifeza ijana n'italanto imwe y'izahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.3",
            "verseOrgIds": [
              "2CH.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.22.11+JER.22.12"
              },
              "items": [
                {
                  "text": "Yer 22.11-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maze Neko umwami wa Egiputa yimika mukuru we ngo abe umwami w'i Buyuda n'i Yerusalemu, ahindura izina rye amuhimba Yehoyakimu. Neko uwo aherako ajyana murumuna we Yowahazi muri Egiputa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.4",
            "verseOrgIds": [
              "2CH.36.4"
            ]
          }
        }
      ]
    },
