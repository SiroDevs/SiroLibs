        },
        {
          "text": " Sedekiya atangira gutegeka yari amaze imyaka makumyabiri n'umwe avutse, ategekera i Yerusalemu amara imyaka cumi n'umwe i Yerusalemu ari ku ngoma. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.11",
            "verseOrgIds": [
              "2CH.36.11"
            ]
          }
        },
