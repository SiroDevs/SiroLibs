            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 36:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma mu mwaka wa mbere w'ingoma ya Kuro umwami w'u Buperesi, Uwiteka atera umwete umutima wa Kuro umwami w'u Buperesi, ngo ijambo Uwiteka yavugiye mu kanwa ka Yeremiya risohore, ategeka ko bamamaza itegeko mu gihugu cye cyose araryandika ati",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.22",
            "verseOrgIds": [
              "2CH.36.22"
            ]
          }
        }
      ]
