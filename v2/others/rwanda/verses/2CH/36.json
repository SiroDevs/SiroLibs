                "loc": "JER.34.1+JER.34.2+JER.34.3+JER.34.4+JER.34.5"
              },
              "items": [
                {
                  "text": "34.1-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ni cyo cyatumye abateza umwami w'Abakaludaya, akicishiriza abasore babo inkota mu nzu y'ubuturo bwabo bwera, ntababarire umuhungu cyangwa umukobwa, umusaza cyangwa umusaza rukukuri, abo bose arabamugabiza. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.17",
            "verseOrgIds": [
              "2CH.36.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 36:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ibintu byo mu nzu y'Imana byose, ibinini n'ibito n'iby'ubutunzi byo mu nzu y'Uwiteka, n'iby'ubutunzi by'umwami n'iby'abatware be, ibyo byose abijyana i Babuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.18",
            "verseOrgIds": [
              "2CH.36.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze batwika inzu y'Imana, basenya inkike z'i Yerusalemu, batwika inyumba zaho, barimbura ibintu byaho byiza byose. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.19",
            "verseOrgIds": [
              "2CH.36.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 36:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abacitse ku icumu Nebukadinezari abajyana i Babuloni, bahinduka imbata ze n'iz'abahungu be kugeza ku ngoma z'abami b'i Buperesi, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.20",
            "verseOrgIds": [
              "2CH.36.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.25.11"
              },
              "items": [
                {
                  "text": "Yer 25.11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.29.10"
              },
              "items": [
                {
                  "text": "29.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " bisobanurwa ngo kugeza ubwo igihugu kizaba cyishimira amasabato yacyo, ngo ijambo Uwiteka yavugiye mu kanwa ka Yeremiya ribe risohoye, kuko iminsi yose cyabereye umusaka cyajiririje isabato, kimara imyaka mirongo irindwi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.21",
            "verseOrgIds": [
              "2CH.36.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Umwami Kuro ategeka ko bongera kubaka urusengero",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
