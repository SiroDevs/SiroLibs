  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "2CH 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Asa abuza kuramya ibishushanyo, asezerana isezerano n'Uwiteka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwuka w'Imana aza kuri Azariya mwene Odedi, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.1",
            "verseOrgIds": [
              "2CH.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ajya gusanganira Asa aramubwira ati “Nimunyumve, Asa namwe Bayuda n'Ababenyamini mwese, Uwiteka ari kumwe namwe nimuba kumwe na we. Nimumushaka muzamubona, ariko nimumuta na we azabata. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.2",
            "verseOrgIds": [
              "2CH.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi hariho ubwo Abisirayeli bamaze igihe kirekire, badafite Imana nyakuri cyangwa umutambyi wigisha, badafite n'amategeko. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.3",
            "verseOrgIds": [
              "2CH.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ibyago bibagezeho bahindukirira Uwiteka Imana ya Isirayeli, barayishaka barayibona. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.4",
            "verseOrgIds": [
              "2CH.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi muri icyo gihe abasohokaga n'abinjiraga nta mahoro bari bafite, ahubwo abaturage bo muri ibyo bihugu bose bagiraga imidugararo myinshi, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.5",
            "verseOrgIds": [
              "2CH.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakavunagurana ubwoko bukarwanya ubundi, n'umudugudu ukarwanya undi kuko Imana yabihebeshaga, ibateza ibyago byose. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.6",
            "verseOrgIds": [
              "2CH.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko mwebwe mukomere, amaboko yanyu ye gutentebuka kuko imirimo yanyu izagororerwa.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.7",
            "verseOrgIds": [
              "2CH.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.7",
            "verseOrgIds": [
              "2CH.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Asa yumvise ayo magambo, yumva n'ayo umuhanuzi Odedi yahanuye arakomera, akura ibizira mu gihugu cyose cy'i Buyuda n'i Bubenyamini, no mu midugudu yahindūye yo mu gihugu cy'imisozi ya Efurayimu, asubiriza icyotero cy'Uwiteka cyari imbere y'ibaraza ry'Uwiteka.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.8",
            "verseOrgIds": [
              "2CH.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.8",
            "verseOrgIds": [
              "2CH.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye ateranya Abayuda n'Ababenyamini bose n'abaturanaga na bo, baturutse mu gihugu cya Efurayimu no mu cy'Abamanase no mu cy'Abasimeyoni, kuko benshi bamukeje baturuka mu Bwisirayeli, babonye yuko Uwiteka Imana ye iri kumwe na we. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.9",
            "verseOrgIds": [
              "2CH.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko bateranira i Yerusalemu mu kwezi kwa gatatu ko mu mwaka wa cumi n'itanu, ku ngoma ya Asa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.10",
            "verseOrgIds": [
              "2CH.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuri uwo munsi batambira Uwiteka inka magana arindwi n'intama ibihumbi birindwi, babikuye mu minyago bazanye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.11",
            "verseOrgIds": [
              "2CH.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze basezerana isezerano, ryo gushakisha Uwiteka Imana ya ba sekuruza imitima yabo yose n'ubugingo bwabo bwose, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.12",
            "verseOrgIds": [
              "2CH.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi yuko utemeye gushaka Uwiteka Imana ya Isirayeli azicwa, ari uworoheje n'ukomeye, umugabo cyangwa umugore. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.13",
            "verseOrgIds": [
              "2CH.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko barahiza ijwi rirenga, bararangurura bavuza amakondera n'amahembe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.14",
            "verseOrgIds": [
              "2CH.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abayuda bose bishimira iyo ndahiro kuko bari barahiye n'imitima yabo yose, bagashakana Uwiteka umwete wabo wose bakamubona, maze Uwiteka abaha ihumure impande zose.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.15",
            "verseOrgIds": [
              "2CH.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.15",
            "verseOrgIds": [
              "2CH.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Māka nyina w'Umwami Asa, umwami amwirukana mu bugabekazi kuko yari aremesheje igishushanyo cy'ikizira cya Ashera. Asa amutemera igishushanyo, aragihondagura, agitwikira ku kagezi ka Kidironi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.16",
            "verseOrgIds": [
              "2CH.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ingoro ntizakurwaho mu Bwisirayeli, icyakora umutima wa Asa wari utunganye iminsi ye yose. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.17",
            "verseOrgIds": [
              "2CH.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acyura ibintu se yejeje mu nzu y'Imana, n'ibyo yejeje ubwe by'ifeza n'izahabu n'ibindi bintu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.18",
            "verseOrgIds": [
              "2CH.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nta ntambara zongeye kubaho, kugeza mu mwaka wa mirongo itatu n'itanu akiri ku ngoma.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.19",
            "verseOrgIds": [
              "2CH.15.19"
            ]
          }
        }
      ]
    }
  ],
