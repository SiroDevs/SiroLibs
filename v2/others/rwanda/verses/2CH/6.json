          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nuko Mana yanjye ndakwinginze, amaso yawe arebe n'amatwi yawe yumve ishengesho ryose rizasengerwa aha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.40",
            "verseOrgIds": [
              "2CH.6.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "2CH 6:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.132.8+PSA.132.9+PSA.132.10"
              },
              "items": [
                {
                  "text": "Zab 132.8-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nuko rero none Uwiteka Mana, haguruka winjire mu buruhukiro bwawe wowe ubwawe n'isanduku y'icyubahiro cyawe,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.41",
            "verseOrgIds": [
              "2CH.6.41"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "icyubahiro cyawe:",
              "type": "text"
            },
            {
              "text": "cyangwa, imbaraga zawe.",
              "type": "text"
            }
          ]
        },
        {
          "text": " abatambyi bawe Uwiteka Mana bambikwe agakiza, abakunzi bawe banezererwe amahirwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.41",
            "verseOrgIds": [
              "2CH.6.41"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "amahirwe:",
              "type": "text"
            },
            {
              "text": "cyangwa, ibyiza.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.41",
            "verseOrgIds": [
              "2CH.6.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "2CH 6:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwiteka Mana, ntiwime uwo wimikishije amavuta, ujye wibuka imbabazi wagiriye umugaragu wawe Dawidi.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.42",
            "verseOrgIds": [
              "2CH.6.42"
            ]
          }
        }
