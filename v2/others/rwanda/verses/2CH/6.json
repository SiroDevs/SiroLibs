              "2CH.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.18",
            "verseOrgIds": [
              "2CH.6.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.2.7"
              },
              "items": [
                {
                  "text": "2 Ngoma 2.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Ariko se ni ukuri koko, Imana izaturana n'abantu mu isi? Dore ijuru ndetse n'ijuru risumba ayandi nturikwirwamo, nkanswe iyi nzu nubatse. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.18",
            "verseOrgIds": [
              "2CH.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko wite ku gusenga k'umugaragu wawe nkwinginga, Uwiteka Mana yanjye, wumve gutakamba no gusenga umugaragu wawe ngusengera imbere, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.19",
            "verseOrgIds": [
              "2CH.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.12.11"
              },
              "items": [
                {
                  "text": "Guteg 12.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " kugira ngo uhore ushyize amaso kuri iyi nzu ku manywa na nijoro, n'ahantu wavuze ko uzashyira izina ryawe ngo ubone uko ujya wumva gusenga umugaragu wawe nzajya nsenga nerekeye aha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.20",
            "verseOrgIds": [
              "2CH.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ujye wumva kwinginga k'umugaragu wawe n'ukw'abantu bawe b'Abisirayeli, uko bazajya basenga berekeye aha hantu. Ni koko ujye wumva uri mu buturo bwawe ari bwo ijuru, kandi uko uzajya wumva ubabarire.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.21",
            "verseOrgIds": [
              "2CH.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.21",
            "verseOrgIds": [
              "2CH.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Umuntu nacumura kuri mugenzi we bakamurahiza indahiro, akaza akarahirira imbere y'icyotero cyawe muri iyi nzu, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.22",
            "verseOrgIds": [
              "2CH.6.22"
            ]
          }
        },
        {
          "name": "verse",
