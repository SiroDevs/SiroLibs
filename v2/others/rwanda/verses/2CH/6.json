          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abantu bawe b'Abisirayeli nibirukanwa n'ababisha bazira ko bagucumuyeho, nyuma bakaguhindukirira bakerura izina ryawe, bagasenga bingingira imbere yawe muri iyi nzu, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.24",
            "verseOrgIds": [
              "2CH.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "ujye wumva uri mu ijuru ubabarire abantu bawe b'Abisirayeli igicumuro cyabo, ubagarure mu gihugu wabahanye na ba sekuruza.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.25",
            "verseOrgIds": [
              "2CH.6.25"
            ]
          }
        }
      ]
