            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ijuru nirikingwa imvura ntigwe kuko bagucumuyeho, nyuma bagasenga berekeye aha bakubaha izina ryawe, bakareka igicumuro cyabo kuko uzaba ubahannye, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.26",
            "verseOrgIds": [
              "2CH.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "ujye wumva uri mu ijuru ubabarire abagaragu bawe n'abantu bawe b'Abisirayeli igicumuro cyabo, uzabigishe kugendana ingeso nziza, uvubire igihugu cyawe imvura, icyo wahaye abantu bawe ho gakondo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.27",
            "verseOrgIds": [
              "2CH.6.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
