            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inzara nitera mu gihugu cyangwa mugiga, cyangwa kurumbya cyangwa gikongoro, cyangwa inzige cyangwa kagungu, cyangwa ababisha nibabagotera mu gihugu kirimo imidugudu yabo, nubwo hatera ibyago cyangwa indi ndwara yose, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.28",
            "verseOrgIds": [
              "2CH.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "maze umuntu wese nagira icyo asaba cyose yinginze, cyangwa abantu bawe b'Abisirayeli bose uko umuntu wese azajya yimenyaho indwara ye n'umubabaro we ku bwe, akarambura amaboko ye yerekeye iyi nzu, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.29",
            "verseOrgIds": [
              "2CH.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ujye wumva uri mu ijuru ari ryo buturo bwawe ubabarire, witure umuntu wese ukurikije ibyo yakoze byose, wowe uzi umutima we (kuko ari wowe wenyine uzi imitima y'abantu), ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.30",
            "verseOrgIds": [
              "2CH.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ngo bakubahe bagendere mu nzira zawe, iminsi bazamara yose mu gihugu wahaye ba sogokuruza bakiriho.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.31",
            "verseOrgIds": [
              "2CH.6.31"
            ]
          }
        }
      ]
    },
    {
