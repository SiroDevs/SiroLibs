          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bituma abatambyi batakibasha guhagarara ngo bakore ku bw'igicu, kuko icyubahiro cy'Uwiteka cyuzuye inzu y'Imana.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.14",
