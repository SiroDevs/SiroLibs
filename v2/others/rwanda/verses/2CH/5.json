              "2CH.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma abatambyi bavuye Ahera (kuko abatambyi bose bari bahari biyejeje, ntibaragakurikiza ibihe byabo, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.11",
            "verseOrgIds": [
              "2CH.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi n'Abalewi b'abaririmbyi bose, Asafu na Hemani na Yedutuni n'abahungu babo na bene wabo, bari bambaye ibitare byiza bafite ibyuma bivuga na nebelu n'inanga, bahagaze iruhande rw'icyotero rw'iburasirazuba bari kumwe n'abatambyi ijana na makumyabiri bavuza amakondera). ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.12",
            "verseOrgIds": [
              "2CH.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
