                  "text": "Yer 33.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ubwo abavuzaga amakondera n'abaririmbaga bahuza amajwi. Bumvikanishije ijwi rihuye bahimbaza bashima Uwiteka, kandi barangurura amajwi yabo n'amakondera n'ibyuma bivuga n'ibintu bicurangwa, bahimbaza Uwiteka bati",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.13",
            "verseOrgIds": [
              "2CH.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
