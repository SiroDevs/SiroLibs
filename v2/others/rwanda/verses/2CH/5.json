                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.15.25+1CH.15.26+1CH.15.27+1CH.15.28"
              },
              "items": [
                {
                  "text": "1 Ngoma 15.25-28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Salomo aherako ateraniriza i Yerusalemu abakuru b'Abisirayeli, n'abatware b'imiryango bose n'abatware b'amazu ya ba sekuruza b'Abisirayeli, kugira ngo bazamure isanduku y'isezerano ry'Uwiteka, bayikure mu mudugudu wa Dawidi ari wo Siyoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.2",
            "verseOrgIds": [
              "2CH.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko abagabo b'Abisirayeli bose bateranira aho umwami ari, mu birori byari bisanzwe biba mu kwezi kwa karindwi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.3",
            "verseOrgIds": [
              "2CH.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakuru b'Abisirayeli bose baraza, Abalewi baterura isanduku, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.4",
            "verseOrgIds": [
              "2CH.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "bazamura isanduku n'ihema ry'ibonaniro n'ibintu byera byose byari mu ihema. Ibyo byazamuwe n'abatambyi b'Abalewi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.5",
            "verseOrgIds": [
              "2CH.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami Salomo n'iteraniro ryose ry'Abisirayeli, ryari riteraniye aho ari bari imbere y'isanduku, batamba inka n'intama zitabasha kubarika cyangwa kurondorwa kuko ari nyinshi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.6",
            "verseOrgIds": [
              "2CH.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze abatambyi bacyura isanduku y'isezerano ry'Uwiteka ahantu hayo, mu nzu ahavugirwa, Ahera cyane munsi y'amababa y'ibishushanyo by'abakerubi, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.7",
            "verseOrgIds": [
              "2CH.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko ibishushanyo by'abakerubi byari bitanze amababa hejuru y'ahantu h'isanduku, bagatwikira isanduku n'imijisho yayo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.8",
            "verseOrgIds": [
              "2CH.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo mijisho yari miremire, bigatuma imitwe yayo igaragara hino y'ahavugirwa, ariko uri hanze ntiyayirebaga, kandi iracyahari na n'ubu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.9",
            "verseOrgIds": [
              "2CH.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.10.5"
              },
              "items": [
                {
                  "text": "Guteg 10.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mu isanduku nta kintu cyabagamo keretse ibisate bibiri Mose yashyiriyemo i Horebu, ubwo Uwiteka yasezeranaga n'Abisirayeli isezerano, bava muri Egiputa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.10",
            "verseOrgIds": [
              "2CH.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
