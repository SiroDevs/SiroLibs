          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko mwebweho bakundwa, mwibuke amagambo yavuzwe kera n'intumwa z'Umwami wacu Yesu Kristo, ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.17",
            "verseOrgIds": [
              "JUD.1.17"
            ]
          }
        },
