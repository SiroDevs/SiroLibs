              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.2",
            "verseOrgIds": [
              "JUD.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JUD 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakundwa, ubwo nagiraga umwete wo kubandikira iby'agakiza dusangiye niyumvisemo ko mpaswe no kubahugura, kugira ngo mushishikarire kurwanira ibyo kwizera abera bahawe rimwe, bakazageza iteka ryose. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.3",
            "verseOrgIds": [
              "JUD.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JUD 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko hariho bamwe baseseye muri mwe rwihishwa bagenewe kera gucirwa ho iteka: ni abantu batubaha Imana, bahindura ubuntu bw'Imana yacu isoni nke, bakihakana Yesu Kristo ari we wenyine Databuja n'Umwami wacu.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.4",
            "verseOrgIds": [
              "JUD.1.4"
            ]
          }
        }
      ]
    },
    {
