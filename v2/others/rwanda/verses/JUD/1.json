          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko abo bantu batuka ibyo batazi ndetse n'ibyo bazi, babwirijwe na kamere yabo barabyiyononesha nk'inyamaswa zitagira ubwenge. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.10",
            "verseOrgIds": [
              "JUD.1.10"
            ]
          }
        },
