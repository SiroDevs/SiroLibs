        },
        {
          "text": " Ndashaka kubibutsa, nubwo byose hari ubundi mwigeze kubimenya, yuko Umwami Imana imaze gukirisha ubwoko bw'Abisirayeli kubakura mu gihugu cya Egiputa, hanyuma irimbura abatizeye. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.5",
            "verseOrgIds": [
              "JUD.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JUD 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'abamarayika batarinze ubutware bwabo ahubwo bakareka ubuturo bwabo, ibarindira mu minyururu idashira no mu mwijima w'icuraburindi kugira ngo bacirwe ho iteka ku munsi ukomeye. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.6",
            "verseOrgIds": [
              "JUD.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JUD 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.1+GEN.19.2+GEN.19.3+GEN.19.4+GEN.19.5+GEN.19.6+GEN.19.7+GEN.19.8+GEN.19.9+GEN.19.10+GEN.19.11+GEN.19.12+GEN.19.13+GEN.19.14+GEN.19.15+GEN.19.16+GEN.19.17+GEN.19.18+GEN.19.19+GEN.19.20+GEN.19.21+GEN.19.22+GEN.19.23+GEN.19.24"
              },
              "items": [
                {
                  "text": "Itang 19.1-24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kandi n'i Sodomu n'i Gomora n'imidugudu yari ihereranye na ho, kuko abaho na bo bitanze bakiha ubusambanyi no kwendana mu buryo imibiri itaremewe, iyo midugudu yashyiriweho kuba akabarore ihanwa n'umuriro utazima. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.7",
            "verseOrgIds": [
              "JUD.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JUD 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko ni ko na ba bandi b'abarosi bonona imibiri yabo, bagasuzugura gutegekwa bagatuka abanyacyubahiro.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.8",
            "verseOrgIds": [
              "JUD.1.8"
            ]
          }
        }
      ]
