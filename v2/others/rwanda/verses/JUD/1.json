              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ababagisha impaka mubagirire impuhwe, ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.22",
            "verseOrgIds": [
              "JUD.1.22"
