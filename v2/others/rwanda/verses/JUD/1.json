        },
        {
          "text": " Nyamara Mikayeli ari we marayika ukomeye, ubwo yatonganaga na Satani agira impaka na we intumbi ya Mose, ntiyahangaye kumucira urubanza amuvuma, ahubwo yaramubwiye ati “Umwami Imana iguhane.” ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.9",
            "verseOrgIds": [
              "JUD.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
