              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ngo agirire bose ibihura n'amateka baciriwe ho, no kwemeza abatubaha Imana bose ukuri kw'imirimo yose yo kutubaha Imana bakoze batubaha Imana, n'amagambo yose akomeye abanyabyaha batubaha Imana bayitutse.”",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.15",
            "verseOrgIds": [
              "JUD.1.15"
            ]
          }
        }
