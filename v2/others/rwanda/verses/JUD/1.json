                  "text": "2 Pet 3.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " uko zababwiye ziti “Mu gihe cy'imperuka hazabaho abakobanyi bagenda bakurikiza kwifuza kwabo kunyuranye n'iby'Imana.”",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.18",
            "verseOrgIds": [
              "JUD.1.18"
            ]
          }
        },
