              "type": "text"
            }
          ]
        },
        {
          "text": "abandi mubakirishe ubwoba mubahubuje mu muriro, mwanga ndetse n'umwenda utewe ibizinga n'umubiri.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.23",
