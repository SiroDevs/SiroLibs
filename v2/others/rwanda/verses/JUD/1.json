          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "kunyuranye n'iby'Imana:",
              "type": "text"
            },
            {
              "text": "cyangwa, kwifuza kwabo kutubaha Imana.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.18",
            "verseOrgIds": [
