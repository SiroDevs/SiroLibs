        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.15",
            "verseOrgIds": [
              "MAT.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu amaze kubatizwa uwo mwanya ava mu mazi, ijuru riramukingukira abona Umwuka w'Imana amanuka asa n'inuma amujyaho, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.16",
            "verseOrgIds": [
              "MAT.3.16"
            ]
          }
        },
