              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yohana uwo yari yambaye umwambaro w'ubwoya bw'ingamiya, abukenyeje umushumi, ibyokurya bye byari inzige n'ubuki bw'ubuhura. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.4",
            "verseOrgIds": [
              "MAT.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ab'i Yerusalemu n'ab'i Yudaya yose, no mu gihugu cyose giteganye na Yorodani bose barahaguruka bajya aho ari, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.5",
            "verseOrgIds": [
              "MAT.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ababatiriza mu ruzi rwa Yorodani bavuga ibyaha bakoze.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.6",
            "verseOrgIds": [
              "MAT.3.6"
            ]
          }
        }
      ]
    },
    {
