              "items": [
                {
                  "text": "Zab 118.26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ndababwira yuko mutazambona uhereye none ukageza ubwo muzavuga muti ‘Hahirwa uje mu izina ry'Uwiteka.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.39",
