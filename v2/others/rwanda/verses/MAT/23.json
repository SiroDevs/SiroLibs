          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Yerusalemu, Yerusalemu, wica abahanuzi ugatera amabuye abagutumweho, ni kangahe nshaka kubundikira abana bawe, nk'uko inkoko ibundikira imishwi yayo mu mababa yayo ntimunkundire? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.37",
            "verseOrgIds": [
              "MAT.23.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 23:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.22.5"
              },
              "items": [
                {
                  "text": "Yer 22.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Dore inzu yanyu muyisigiwe ari umusaka. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.38",
            "verseOrgIds": [
              "MAT.23.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 23:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
