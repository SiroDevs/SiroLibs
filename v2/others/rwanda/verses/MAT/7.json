            "style": "v",
            "sid": "MAT 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.23",
            "verseOrgIds": [
              "MAT.7.23"
            ]
          }
        },
        {
          "name": "verse",
