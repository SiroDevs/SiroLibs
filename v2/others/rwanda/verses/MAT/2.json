              "items": [
                {
                  "text": "Yoh 1.45",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " atura mu mudugudu witwa i Nazareti ngo ibyavuzwe n'abahanuzi bisohore ngo “Azitwa Umunazareti.”",
          "type": "text",
          "attrs": {
