            "number": "22",
            "style": "v",
            "sid": "MAT 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko yumvise yuko Arikelayo yimye i Yudaya aha se Herode atinya kujyayo, abwirizwa n'Imana mu nzozi ajya mu gihugu cy'i Galilaya, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.22",
            "verseOrgIds": [
              "MAT.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.1.24"
              },
              "items": [
                {
                  "text": "Mar 1.24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
