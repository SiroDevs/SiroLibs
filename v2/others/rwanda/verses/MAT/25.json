          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndatinya, ndagenda mpisha italanto yawe mu butaka. dore ngiyo, ibyawe urabifite.’",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.25",
            "verseOrgIds": [
              "MAT.25.25"
            ]
          }
        }
      ]
    },
    {
