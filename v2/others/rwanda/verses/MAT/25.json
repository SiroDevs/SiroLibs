            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.19.11+LUK.19.12+LUK.19.13+LUK.19.14+LUK.19.15+LUK.19.16+LUK.19.17+LUK.19.18+LUK.19.19+LUK.19.20+LUK.19.21+LUK.19.22+LUK.19.23+LUK.19.24+LUK.19.25+LUK.19.26+LUK.19.27"
              },
              "items": [
                {
                  "text": "Luka 19.11-27",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Bizaba nk'iby'umuntu wari ugiye kuzindukira mu kindi gihugu, ahamagara abagaragu be abasigira ibintu bye, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.14",
            "verseOrgIds": [
              "MAT.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "aha umwe italanto eshanu, undi amuha ebyiri, undi amuha imwe uko umuntu ashoboye, arazinduka. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.15",
            "verseOrgIds": [
              "MAT.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo mwanya uwahawe italanto eshanu aragenda arazigenza, agenzuramo izindi talanto eshanu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.16",
            "verseOrgIds": [
              "MAT.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'uwahawe ebyiri abigenza atyo, agenzuramo izindi ebyiri. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.17",
            "verseOrgIds": [
              "MAT.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko uwahawe imwe aragenda acukura umwobo, ahishamo italanto ya shebuja.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.18",
            "verseOrgIds": [
              "MAT.25.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.18",
            "verseOrgIds": [
              "MAT.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Maze iminsi myinshi ishize, shebuja w'abo bagaragu araza, abarana na bo umubare w'ibyo yabasigiye. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.19",
            "verseOrgIds": [
              "MAT.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwahawe italanto eshanu araza, azana izindi talanto eshanu ati ‘Databuja, wansigiye italanto eshanu, dore nazigenzuyemo izindi talanto eshanu.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.20",
            "verseOrgIds": [
              "MAT.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shebuja aramubwira ati ‘Nuko nuko mugaragu mwiza ukiranuka, wakiranutse mu bike, nzakwegurira byinshi, injira mu munezero wa shobuja.’",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.21",
            "verseOrgIds": [
              "MAT.25.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.21",
            "verseOrgIds": [
              "MAT.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“N'uwahawe italanto ebyiri araza aravuga ati ‘Databuja, wansigiye italanto ebyiri, dore nazigenzuyemo izindi ebyiri.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.22",
            "verseOrgIds": [
              "MAT.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shebuja aramubwira ati ‘Nuko nuko mugaragu mwiza ukiranuka, wakiranutse mu bike, nzakwegurira byinshi, injira mu munezero wa shobuja.’",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.23",
            "verseOrgIds": [
              "MAT.25.23"
            ]
          }
        }
      ]
    },
