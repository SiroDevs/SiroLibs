                "loc": "MRK.4.25"
              },
              "items": [
                {
                  "text": "Mar 4.25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.8.18"
