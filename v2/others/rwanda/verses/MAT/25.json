          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.16.27"
              },
              "items": [
                {
                  "text": "Mat 16.27",
