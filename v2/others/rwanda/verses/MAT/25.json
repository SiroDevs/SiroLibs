      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gucirwaho iteka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
