                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.19.28"
              },
              "items": [
                {
                  "text": "19.28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Umwana w'umuntu ubwo azazana n'abamarayika bose afite ubwiza bwe, ni bwo azicara ku ntebe y'ubwiza bwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.31",
            "verseOrgIds": [
              "MAT.25.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 25:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amahanga yose azateranirizwa imbere ye, abarobanure nk'uko umwungeri arobanura intama mu ihene, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.32",
            "verseOrgIds": [
              "MAT.25.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "intama azazishyira iburyo bwe, naho ihene azishyire ibumoso. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.33",
            "verseOrgIds": [
              "MAT.25.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami azabwira abari iburyo bwe ati ‘Nimuze mwebwe abo Data yahaye umugisha, muragwe ubwami bwabatunganirijwe uhereye ku kuremwa kw'isi, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.34",
            "verseOrgIds": [
              "MAT.25.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 25:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko nari nshonje mukamfungurira, nari mfite inyota mumpa icyo nywa, nari umushyitsi murancumbikira, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.35",
            "verseOrgIds": [
              "MAT.25.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 25:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "nari nambaye ubusa muranyambika, nari ndwaye muransūra, nari mu nzu y'imbohe muza kundeba.’",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.36",
            "verseOrgIds": [
              "MAT.25.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 25:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.36",
            "verseOrgIds": [
              "MAT.25.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 25:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abakiranutsi bazamubaza bati ‘Mwami, twakubonye ryari ushonje turagufungurira, cyangwa ufite inyota tuguha icyo unywa? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.37",
            "verseOrgIds": [
              "MAT.25.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi twakubonye ryari uri umushyitsi turagucumbikira, cyangwa wambaye ubusa turakwambika? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.38",
            "verseOrgIds": [
              "MAT.25.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 25:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi twakubonye ryari urwaye, cyangwa uri mu nzu y'imbohe tuza kugusūra?’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.39",
            "verseOrgIds": [
              "MAT.25.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 25:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami azabasubiza ati ‘Ndababwira ukuri yuko ubwo mwabikoreye umwe muri bene Data aba boroheje bari hanyuma y'abandi, ari jye mwabikoreye.’",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.40",
            "verseOrgIds": [
              "MAT.25.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 25:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.40",
            "verseOrgIds": [
              "MAT.25.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 25:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Azabwira n'abari ibumoso ati ‘Nimuve aho ndi mwa bivume mwe, mujye mu muriro w'iteka watunganirijwe Umwanzi n'abamarayika be, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.41",
            "verseOrgIds": [
              "MAT.25.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 25:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko nari nshonje ntimumfungurire, nari mfite inyota ntimwampa icyo nywa, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.42",
            "verseOrgIds": [
              "MAT.25.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 25:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "nari umushyitsi ntimwancumbikira, nari nambaye ubusa ntimwanyambika, nari umurwayi no mu nzu y'imbohe ntimwansūra.’",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.43",
            "verseOrgIds": [
              "MAT.25.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 25:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.43",
            "verseOrgIds": [
              "MAT.25.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 25:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Na bo bazamusubiza bati ‘Mwami, twakubonye ryari ushonje, cyangwa ufite inyota, cyangwa uri umushyitsi, cyangwa wambaye ubusa, cyangwa urwaye, cyangwa uri mu nzu y'imbohe, ntitwagukorera?’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.44",
            "verseOrgIds": [
              "MAT.25.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 25:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azabasubiza ati ‘Ndababwira ukuri yuko ubwo mutabikoreye umwe muri bene Data aba boroheje bari hanyuma y'abandi, nanjye mutabinkoreye.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.45",
            "verseOrgIds": [
              "MAT.25.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 25:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.12.2"
              },
              "items": [
                {
                  "text": "Dan 12.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Abo bazajya mu ihaniro ry'iteka, naho abakiranutsi bazajya mu bugingo buhoraho.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.46",
            "verseOrgIds": [
              "MAT.25.46"
            ]
          }
        }
