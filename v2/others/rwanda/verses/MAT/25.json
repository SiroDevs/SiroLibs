              "items": [
                {
                  "text": "Luka 8.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kuko ufite wese azahabwa akarushirizwaho, ariko udafite azakwa n'icyo yari afite. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.29",
            "verseOrgIds": [
              "MAT.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 25:30"
          },
          "items": [
