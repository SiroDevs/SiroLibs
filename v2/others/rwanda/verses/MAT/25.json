            "sid": "MAT 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ariko shebuja aramusubiza ati ‘Wa mugaragu mubi we, wa munyabute we, ko wari uzi ko nsarura aho ntabibye, mpunika ibyo ntagosoye, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.26",
            "verseOrgIds": [
              "MAT.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "italanto yawe ntiwari ukwiriye kuyiha abagenza, nanjye naza ukampana iyanjye n'inyungu yayo? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.27",
            "verseOrgIds": [
              "MAT.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko nimuyimwake, muyihe ufite italanto cumi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.28",
            "verseOrgIds": [
              "MAT.25.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.13.12"
              },
              "items": [
                {
                  "text": "Mat 13.12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
