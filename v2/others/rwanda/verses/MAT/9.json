        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu arahindukira amubonye aramubwira ati “Mwana wanjye, komera. Kwizera kwawe kuragukijije.” Umugore akira uwo mwanya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.22",
            "verseOrgIds": [
              "MAT.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.22",
            "verseOrgIds": [
              "MAT.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu ageze mu muryango w'inzu y'uwo mutware, abona abavuza imyirongi n'abantu benshi baboroga ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.23",
            "verseOrgIds": [
              "MAT.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "arababwira ati “Nimuhave kuko agakobwa kadapfuye, ahubwo karasinziriye.” Baramuseka cyane. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.24",
            "verseOrgIds": [
              "MAT.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bamaze guhezwa yinjira mu nzu, agafata ukuboko karabyuka. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.25",
            "verseOrgIds": [
              "MAT.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo nkuru yamamara muri icyo gihugu cyose.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.26",
            "verseOrgIds": [
              "MAT.9.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ahumūra impumyi ebyiri, akiza abarwayi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
