              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramusubiza bati “Ni mwene Dawidi.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.42",
            "verseOrgIds": [
