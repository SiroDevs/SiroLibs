              },
              "items": [
                {
                  "text": "Luka 10.25-28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " umwe muri bo w'umwigishamategeko amubaza amugerageza ati ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.35",
            "verseOrgIds": [
              "MAT.22.35"
            ]
          }
