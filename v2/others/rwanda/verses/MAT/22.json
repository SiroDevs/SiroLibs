          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu babyumvise batangazwa no kwigisha kwe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.33",
            "verseOrgIds": [
              "MAT.22.33"
            ]
