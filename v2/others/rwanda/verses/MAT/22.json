            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Na we aramusubiza ati “ ‘Ukundishe Uwiteka, Imana yawe umutima wawe wose n'ubugingo bwawe bwose n'ubwenge bwawe bwose.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.37",
            "verseOrgIds": [
              "MAT.22.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 22:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iryo ni ryo tegeko rikomeye ry'imbere. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.38",
            "verseOrgIds": [
              "MAT.22.38"
            ]
          }
        },
        {
          "name": "verse",
