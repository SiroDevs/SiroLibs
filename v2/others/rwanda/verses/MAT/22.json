          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu arabasubiza ati “Mwarahabye kuko mutamenye ibyanditswe cyangwa imbaraga z'Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.29",
            "verseOrgIds": [
              "MAT.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu izuka ntibarongora kandi ntibashyingirwa, ahubwo bamera nk'abamarayika bo mu ijuru. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.30",
            "verseOrgIds": [
              "MAT.22.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko se ibyerekeye ku kuzuka kw'abapfuye, ntimwari mwasoma icyo Imana yababwiye ngo ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.31",
            "verseOrgIds": [
              "MAT.22.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 22:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.3.6"
              },
              "items": [
                {
                  "text": "Kuva 3.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ‘Ni jye Mana ya Aburahamu n'Imana ya Isaka n'Imana ya Yakobo?’ Imana si Imana y'abapfuye, ahubwo ni iy'abazima.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.32",
            "verseOrgIds": [
              "MAT.22.32"
            ]
          }
        }
      ]
    },
