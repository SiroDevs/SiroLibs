          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Abafarisayo bumvise yuko yatsinze Abasadukayo, bakananirwa kumusubiza, bateranira hamwe, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.34",
            "verseOrgIds": [
              "MAT.22.34"
            ]
          }
        },
        {
