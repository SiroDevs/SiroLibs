              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu abwira abigishwa be ati “Ndababwira ukuri yuko biruhije ko umutunzi yinjira mu bwami bwo mu ijuru. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.23",
            "verseOrgIds": [
