              "MAT.19.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.24.1+DEU.24.2+DEU.24.3+DEU.24.4"
              },
              "items": [
                {
                  "text": "Guteg 24.1-4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.31"
              },
              "items": [
                {
                  "text": "Mat 5.31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Baramubaza bati “Niba ari uko, ni iki cyatumye Mose ategeka ko umugabo aha umugore urwandiko rwo kumusenda, abone uko yamwirukana?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.7",
            "verseOrgIds": [
              "MAT.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.7",
            "verseOrgIds": [
              "MAT.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arabasubiza ati “Mose yabemereye gusenda abagore banyu kuko imitima yanyu inangiye, ariko uhereye mbere hose ntibyari bimeze bityo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.8",
            "verseOrgIds": [
              "MAT.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.32"
              },
              "items": [
                {
                  "text": "Mat 5.32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.7.10+1CO.7.11"
              },
              "items": [
                {
                  "text": "1 Kor 7.10-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ariko ndababwira yuko umuntu wese uzasenda umugore we atamuhora gusambana, akarongora undi azaba asambanye. Kandi ucyura uwasenzwe na we aba asambanye.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.9",
            "verseOrgIds": [
              "MAT.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.9",
            "verseOrgIds": [
              "MAT.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abigishwa be baramubwira bati “Iby'umugabo n'umugore we niba bigenda bityo, noneho kurongora si byiza.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.10",
            "verseOrgIds": [
              "MAT.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.10",
            "verseOrgIds": [
              "MAT.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na we arababwira ati “Abantu bose ntibabasha kwemera iryo jambo, keretse ababihawe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.11",
            "verseOrgIds": [
              "MAT.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko hariho ibiremba byavutse bityo mu nda za ba nyina, hariho n'inkone zakonwe n'abantu, hariho n'inkone zīkona ubwazo ku bw'ubwami bwo mu ijuru. Ubasha kubyemera abyemere.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.12",
            "verseOrgIds": [
              "MAT.19.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu yakira abana bato",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.12",
            "verseOrgIds": [
              "MAT.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze bamuzanira abana bato ngo abarambikeho ibiganza abasabire, abigishwa barabacyaha. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.13",
            "verseOrgIds": [
              "MAT.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Yesu arababwira ati “Mureke abana bato ntimubabuze kunsanga, kuko abameze batyo ubwami bwo mu ijuru ari ubwabo.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.14",
            "verseOrgIds": [
              "MAT.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.14",
            "verseOrgIds": [
              "MAT.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaze kubarambikaho ibiganza, avayo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.15",
            "verseOrgIds": [
              "MAT.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Iby'umusore w'umutunzi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.15",
            "verseOrgIds": [
              "MAT.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko umuntu aza aho ari aramubaza ati “Mwigisha mwiza, nkore cyiza ki ngo mpabwe ubugingo buhoraho?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.16",
            "verseOrgIds": [
              "MAT.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.16",
            "verseOrgIds": [
              "MAT.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na we aramusubiza ati“Unyitira iki mwiza? Umwiza ni umwe gusa, ni Imana. Ariko nushaka kugera ku bugingo, witondere amategeko.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.17",
            "verseOrgIds": [
              "MAT.19.17"
            ]
          }
        }
      ]
    },
