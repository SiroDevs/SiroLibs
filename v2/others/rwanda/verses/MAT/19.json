          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo musore yumvise iryo jambo agenda afite agahinda, kuko yari afite ubutunzi bwinshi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.22",
            "verseOrgIds": [
