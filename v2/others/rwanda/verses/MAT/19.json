          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndetse ndababwira yuko icyoroshye ari uko ingamiya yanyura mu zuru ry'urushinge, kuruta ko umutunzi yakwinjira mu bwami bwo mu ijuru.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.24",
            "verseOrgIds": [
              "MAT.19.24"
            ]
          }
        }
