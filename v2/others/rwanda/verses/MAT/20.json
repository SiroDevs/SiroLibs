                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ariko muri mwe si ko biri, ahubwo ushaka kuba mukuru muri mwe ajye aba umugaragu wanyu, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.26",
