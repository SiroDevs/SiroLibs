                "loc": "LUK.22.24"
              },
              "items": [
                {
                  "text": "Luka 22.24",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Icyo gihe abigishwa begera Yesu baramubaza bati “Umukuru mu bwami bwo mu ijuru ni nde?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.1",
            "verseOrgIds": [
              "MAT.18.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.1",
            "verseOrgIds": [
              "MAT.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahamagara umwana muto amuhagarika hagati yabo, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.2",
            "verseOrgIds": [
              "MAT.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.10.15"
              },
              "items": [
                {
                  "text": "Mar 10.15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.18.17"
              },
              "items": [
                {
                  "text": "Luka 18.17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " arababwira ati “Ndababwira ukuri yuko nimudahinduka ngo mumere nk'abana bato, mutazinjira mu bwami bwo mu ijuru. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.3",
            "verseOrgIds": [
              "MAT.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko uzicisha bugufi nk'uyu mwana muto, ni we mukuru mu bwami bwo mu ijuru. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.4",
            "verseOrgIds": [
              "MAT.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwemera umwana umwe muto nk'uyu mu izina ryanjye, ni jye aba yemeye.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.5",
            "verseOrgIds": [
              "MAT.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.5",
            "verseOrgIds": [
              "MAT.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ariko ushuka umwe muri aba bato banyizera akamugusha, ikiruta ni uko yahambirwa urusyo mu ijosi rye, akazikwa imuhengeri mu nyanja. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.6",
            "verseOrgIds": [
              "MAT.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isi izaboneshwa ishyano n'ibigusha abantu, kuko ibyo bigusha bitazabura kuza, ariko uwo muntu uzana ibigusha azabona ishyano.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.7",
            "verseOrgIds": [
              "MAT.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
