      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ubukuru bushimwa mu bwami bwo mu ijuru ubwo ari bwo",
          "type": "text"
        }
      ]
    },
    {
