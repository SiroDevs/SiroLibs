              "items": [
                {
                  "text": "Yoh 20.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Ndababwira ukuri yuko ibyo muzahambira mu isi bizaba bihambiriwe mu ijuru, kandi ibyo muzahambura mu isi bizaba bihambuwe mu ijuru.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.18",
