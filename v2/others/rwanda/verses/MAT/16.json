        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu asobanura iby'inzira y'umusaraba",
          "type": "text"
        }
      ]
    },
