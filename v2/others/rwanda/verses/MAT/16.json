              "items": [
                {
                  "text": "Luka 9.7-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Baramusubiza bati “Bamwe bagira ngo uri Yohana Umubatiza, abandi ngo uri Eliya, abandi ngo uri Yeremiya, cyangwa ngo uri umwe wo mu bahanuzi.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.14",
