          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu aramusubiza ati “Urahirwa Simoni wa Yona, kuko umubiri n'amaraso atari byo byabiguhishuriye, ahubwo ni Data wo mu ijuru. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.17",
            "verseOrgIds": [
              "MAT.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
