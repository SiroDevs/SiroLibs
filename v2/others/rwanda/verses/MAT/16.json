                }
              ]
            }
          ]
        },
        {
          "text": " Kuko Umwana w'umuntu azazana n'abamarayika be afite ubwiza bwa Se, agaherako yitura umuntu wese ibikwiriye ibyo yakoze. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.27",
