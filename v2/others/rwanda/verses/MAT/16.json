              "items": [
                {
                  "text": "Yoh 20.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nzaguha imfunguzo z'ubwami bwo mu ijuru, kandi icyo uzahambira mu isi kizaba gihambiriwe mu ijuru, n'icyo uzahambura mu isi kizaba gihambuwe mu ijuru.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.19",
            "verseOrgIds": [
              "MAT.16.19"
            ]
          }
        }
