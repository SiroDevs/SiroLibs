          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arababaza ati “Ariko mwebwe ubwanyu mugira ngo ndi nde?”",
          "type": "text",
          "attrs": {
