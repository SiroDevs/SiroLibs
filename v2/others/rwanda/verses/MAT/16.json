              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze yihanangiriza abigishwa ngo batagira uwo babwira ko ari we Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.20",
            "verseOrgIds": [
              "MAT.16.20"
            ]
