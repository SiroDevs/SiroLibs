                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Ariko ituro umuntu atura Uwiteka burundu mu byo afite byose, naho ari umuntu cyangwa itungo cyangwa umurima wo muri gakondo ye, ntihakagire ituro bene iryo rigurwa cyangwa ricungurwa, ituro ry'impezi nk'iryo ni iryera cyane ry'Uwiteka. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.28",
            "verseOrgIds": [
              "LEV.27.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntihakagire umuntu utuwe burundu ucungurwa, ahubwo akwiriye gupfa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.29",
            "verseOrgIds": [
              "LEV.27.29"
            ]
          }
        }
      ]
    },
