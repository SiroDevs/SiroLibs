            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.14.22+DEU.14.23+DEU.14.24+DEU.14.25+DEU.14.26+DEU.14.27+DEU.14.28+DEU.14.29"
              },
              "items": [
                {
                  "text": "Guteg 14.22-29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Mu bimeze mu butaka byose, naho yaba imyaka cyangwa imbuto z'ibiti, kimwe mu icumi ni icy'Uwiteka. Ni icyera cy'Uwiteka. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.30",
            "verseOrgIds": [
              "LEV.27.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 27:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu nashaka kwicungurira icyo muri kimwe mu icumi akwiriye gutanga, akigerekeho igice cyacyo cya gatanu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.31",
            "verseOrgIds": [
              "LEV.27.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 27:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimwe mu icumi cyo mu mashyo yose cyangwa imikumbi yose, muzinyura munsi y'inkoni bazibarisha zose, imwe mu icumi ijye iba iyera y'Uwiteka. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.32",
            "verseOrgIds": [
              "LEV.27.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 27:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu ntakayitegereze ko ari nziza cyangwa ko ari mbi ntakayigurane indi, nayigurana, iyo n'ingurane yayo zombi zizabe izera kandi ntigacungurwe.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.33",
            "verseOrgIds": [
              "LEV.27.33"
            ]
          }
        }
      ]
