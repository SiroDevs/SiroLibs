        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Keretse uburiza bw'amatungo busanzwe ari ubw'Uwiteka kuko ari uburiza, ntihakagire umuntu ubweza naho bwaba ubw'inka cyangwa ubw'intama, ni ubw'Uwiteka. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.26",
            "verseOrgIds": [
              "LEV.27.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibuba ubw'itungo rizira, abucunguze igiciro uzacira, akigeretseho igice cyacyo cya gatanu. Niridacungurwa, rigurwe igiciro uciriye.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.27",
            "verseOrgIds": [
              "LEV.27.27"
            ]
          }
        }
      ]
    },
