              "type": "tag",
              "attrs": {
                "loc": "LEV.20.1+LEV.20.2+LEV.20.3+LEV.20.4+LEV.20.5"
              },
              "items": [
                {
                  "text": "Lewi 20.1-5",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Ntugatange uwo mu rubyaro rwawe ngo umutambire Moleki, kandi ntugasuzuguze izina ry'Imana yawe. Ndi Uwiteka. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.21",
            "verseOrgIds": [
              "LEV.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.20.13"
              },
              "items": [
                {
                  "text": "Lewi 20.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ntugatinge abagabo, ni ikizira. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.22",
            "verseOrgIds": [
              "LEV.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.22.18"
              },
              "items": [
                {
                  "text": "Kuva 22.18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.20.15+LEV.20.16"
              },
              "items": [
                {
                  "text": "Lewi 20.15-16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.21"
              },
              "items": [
                {
                  "text": "Guteg 27.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ntukaryamane n'itungo ryose cyangwa n'inyamaswa yose ngo ucyiyandurishe, kandi he kugira umugore cyangwa umukobwa uhagarara imbere y'itungo ngo aryamane na ryo, ibyo ni ukuvanga ibidahuye.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.23",
            "verseOrgIds": [
              "LEV.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abaca kuri ayo mategeko baba bahumanije igihugu cyabo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.23",
            "verseOrgIds": [
              "LEV.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ntimukagire icyo muri ibyo byose mwiyandurisha, kuko ibyo byose byanduje amahanga nzirukana akabahunga, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.24",
            "verseOrgIds": [
              "LEV.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "igihugu cyayo kikaba cyanduye. Ni cyo gituma ngihora gukiranirwa kwacyo, kikaruka abagituyemo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.25",
            "verseOrgIds": [
              "LEV.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko mwebweho mujye mwitondera amategeko yanjye n'amateka yanjye, ntimukagire icyo muri ibyo bizira mukora, naho yaba kavukire cyangwa umunyamahanga ubasuhukiyemo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.26",
            "verseOrgIds": [
              "LEV.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko ibyo bizira byose bene icyo gihugu bakoze, batuyemo mbere yanyu, icyo gihugu kikaba cyanduye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.27",
            "verseOrgIds": [
              "LEV.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntimuzabikore kugira ngo icyo gihugu kitabaruka namwe nimucyanduza, nk'uko kirutse ishyanga ryatuyemo mbere yanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.28",
            "verseOrgIds": [
              "LEV.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu wese uzakora icyo muri ibyo bizira, ubugingo bw'ababikora buzakurwa mu bwoko bwabo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.29",
            "verseOrgIds": [
              "LEV.18.29"
            ]
          }
        }
      ]
    },
