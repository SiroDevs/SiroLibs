          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "ridakurikije isezerano nasezeranye na ba sekuruza, ku munsi nabafataga ukuboko nkabakura mu gihugu cya Egiputa. Rya sezerano ryanjye bararyishe nubwo nari umugabo wabo wabirongōreye. Ni ko Uwiteka avuga. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.32",
            "verseOrgIds": [
              "JER.31.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
