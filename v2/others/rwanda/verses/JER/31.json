              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ab'i Buyuda n'ab'imidugudu yaho yose bazahabana, abahinzi n'abaragiye imikumbi ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.24",
