              "type": "text"
            }
          ]
        },
        {
          "text": "Uwiteka aravuga ati “Dore iminsi izaza, nzabiba mu nzu ya Isirayeli no mu nzu ya Yuda imbuto z'abantu n'imbuto z'amatungo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.27",
            "verseOrgIds": [
