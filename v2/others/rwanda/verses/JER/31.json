              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko nahagije ubugingo burembye, n'ubugingo bufite agahinda bwose narabukamaze.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.25",
            "verseOrgIds": [
