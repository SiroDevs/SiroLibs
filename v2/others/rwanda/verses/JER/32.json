            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.41",
            "verseOrgIds": [
              "JER.32.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JER 32:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uku ni ko Uwiteka avuga ati “Nk'uko nateje ubu bwoko ibyo byago bikomeye byose, ni ko nzabasohoreza ibyiza nabasezeraniye byose. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.42",
            "verseOrgIds": [
              "JER.32.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JER 32:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze imirima izagurwa muri iki gihugu, icyo muhinyura ngo ‘Ni amatongo, nta muntu ukikibamo, haba n'amatungo, kigabijwe Abakaludaya.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.43",
            "verseOrgIds": [
              "JER.32.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JER 32:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bazagura imirima ifeza, bandike inzandiko z'ubuguzi bazishyireho icyitegererezo cy'ubushishi, bitorere abagabo mu gihugu cya Benyamini n'imisozi ikikije i Yerusalemu no mu midugudu y'u Buyuda, mu midugudu yo mu misozi miremire no mu midugudu yo mu bibaya no mu midugudu y'ikusi, kuko nzagarura ababo bajyanywe ari imbohe.” Ni ko Uwiteka avuga.",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.44",
            "verseOrgIds": [
              "JER.32.44"
            ]
          }
        }
      ]
    }
