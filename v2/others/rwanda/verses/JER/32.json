                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ahubwo bahagaritse ibizira byabo mu nzu yitirirwa izina ryanjye, kugira ngo bayanduze. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.34",
            "verseOrgIds": [
              "JER.32.34"
            ]
          }
        },
