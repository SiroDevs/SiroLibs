      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.26",
            "verseOrgIds": [
              "JER.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Uzababwira ayo magambo yose ariko ntibazakumvira, kandi uzabahamagara ariko ntibazakwitaba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.27",
            "verseOrgIds": [
              "JER.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze uzapfe kubabwira uti ‘Ubu ni ubwoko butumviye ijwi ry'Uwiteka Imana yabo, butemeye no guhanwa. Ukuri kuraheze kandi gushize mu kanwa kabo.’",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.28",
            "verseOrgIds": [
              "JER.7.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
