          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Eega Abayuda bakoreye ibibi imbere yanjye! Ni ko Uwiteka avuga. Bashyize ibizira byabo mu nzu yitiriwe izina ryanjye barayanduza. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.30",
            "verseOrgIds": [
              "JER.7.30"
            ]
