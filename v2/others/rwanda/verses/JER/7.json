          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Imore umusatsi Yerusalemu we, uwujugunye kandi uborogere mu mpinga z'imisozi, kuko Uwiteka yanze umuryango w'abantu yarakariye akabareka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.29",
            "verseOrgIds": [
              "JER.7.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 7:29"
          },
          "items": [
