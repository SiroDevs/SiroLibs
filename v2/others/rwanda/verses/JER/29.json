          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.28",
            "verseOrgIds": [
              "JER.29.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Zefaniya w'umutambyi asomera urwo rwandiko imbere y'umuhanuzi Yeremiya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.29",
            "verseOrgIds": [
              "JER.29.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ijambo ry'Uwiteka riza kuri Yeremiya riti ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.30",
            "verseOrgIds": [
              "JER.29.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 29:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Utume ku mbohe zose uti: Uku ni ko Uwiteka avuga ibya Shemaya w'i Nehelami ngo ‘Kuko Shemaya yabahanuriye kandi ntamutumye agatuma mwemera ibinyoma, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.31",
            "verseOrgIds": [
              "JER.29.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 29:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni cyo gituma Uwiteka avuga atya ati: Dore nzahana Shemaya w'i Nehelami n'urubyaro rwe, ntazagira uwo mu rubyaro rwe uzaba muri ubu bwoko ngo ageze igihe cyo kubona ibyiza nzagirira ubwoko bwanjye, kuko yagomeshereje Uwiteka.’ ” Ni ko Uwiteka avuga.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.32",
            "verseOrgIds": [
              "JER.29.32"
            ]
          }
        }
