            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ijambo ry'Uwiteka rinzaho riti ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.4",
            "verseOrgIds": [
              "JER.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
