            "number": "5",
            "style": "v",
            "sid": "JER 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nakumenye ntarakurema mu nda ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.5",
            "verseOrgIds": [
              "JER.1.5"
            ]
          }
        },
        {
          "text": " kandi nakwejeje utaravuka, ngushyiriraho kuba umuhanuzi uhanurira amahanga.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.5",
            "verseOrgIds": [
              "JER.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
