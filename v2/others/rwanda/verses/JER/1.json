            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.11+2CH.36.12+2CH.36.13+2CH.36.14+2CH.36.15+2CH.36.16+2CH.36.17+2CH.36.18+2CH.36.19+2CH.36.20+2CH.36.21"
              },
              "items": [
                {
                  "text": "11-21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ryaje kandi no ku ngoma ya Yehoyakimu mwene Yosiya umwami w'u Buyuda, kugeza mu iherezo ry'umwaka wa cumi n'umwe wo ku ngoma ya Sedekiya mwene Yosiya umwami w'u Buyuda, igihe ab'i Yerusalemu bajyanywe ari imbohe, mu kwezi kwa gatanu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.3",
            "verseOrgIds": [
              "JER.1.3"
            ]
          }
        }
      ]
    },
