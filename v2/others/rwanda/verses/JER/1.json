          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ndavuga nti “Nyamuneka Nyagasani Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.6",
            "verseOrgIds": [
              "JER.1.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "Yehova",
              "type": "text"
            },
            {
              "text": "risobanurwa ngo “Ibaho”.",
              "type": "text"
            }
          ]
        },
        {
          "text": " dore sinzi kuvuga ndi umwana!”",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.6",
            "verseOrgIds": [
              "JER.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
