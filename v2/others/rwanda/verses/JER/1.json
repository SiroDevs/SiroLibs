              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "2 Abami 22.3—23.27; 2 Ngoma 34.8—35.19",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yabwiwe ijambo ry'Uwiteka ku ngoma ya Yosiya mwene Amoni umwami w'u Buyuda, mu mwaka wa cumi n'itatu wo ku ngoma ye. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.2",
            "verseOrgIds": [
              "JER.1.2"
            ]
          }
        },
        {
