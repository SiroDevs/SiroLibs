            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "2 Abami 23.36—24.7; 24.18—25.21",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.5+2CH.36.6+2CH.36.7+2CH.36.8"
              },
              "items": [
