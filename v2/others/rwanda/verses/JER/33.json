        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.9",
            "verseOrgIds": [
              "JER.33.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Uku ni ko Uwiteka avuga ati ‘Aha hantu, aho muvuga ngo ni amatongo hatakiba umuntu bona n'amatungo, ndetse no mu midugudu y'u Buyuda no mu nzira z'i Yerusalemu zasibye, zitakinyurwamo n'umuntu cyangwa umuturage cyangwa itungo, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.10",
            "verseOrgIds": [
              "JER.33.10"
            ]
          }
        },
