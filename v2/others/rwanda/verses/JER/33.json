              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nk'uko ingabo zo mu ijuru zitabasha kubarika, n'umusenyi wo ku nyanja uko utabasha kugerwa, ni ko nzagwiza urubyaro rwa Dawidi umugaragu wanjye, n'Abalewi bankorera.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.22",
            "verseOrgIds": [
              "JER.33.22"
            ]
          }
        }
