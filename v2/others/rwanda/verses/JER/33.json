                "loc": "1CH.17.11+1CH.17.12+1CH.17.13+1CH.17.14"
              },
              "items": [
                {
                  "text": "1 Ngoma 17.11-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kuko Uwiteka avuze ngo ‘Ntabwo Dawidi azabura uwo kuraga ingoma ya Isirayeli, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.17",
            "verseOrgIds": [
              "JER.33.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.3.5+NUM.3.6+NUM.3.7+NUM.3.8+NUM.3.9+NUM.3.10"
              },
              "items": [
                {
                  "text": "Kub 3.5-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " n'abatambyi b'Abalewi na bo ntibazabura umuntu imbere yanjye wo gutamba ibitambo byoswa, n'uwo kosa amaturo y'ifu n'uwo kujya atamba iteka.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.18",
            "verseOrgIds": [
