            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.136.1"
              },
              "items": [
                {
                  "text": "136.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " aho hantu hazongera kumvikana ijwi ryo kwishima n'ijwi ry'umunezero, ijwi ry'umukwe n'ijwi ry'umugeni, ijwi ry'abavuga bati: Nimuhimbaze Uwiteka Nyiringabo kuko Uwiteka ari mwiza, imbabazi ze zihoraho iteka ryose. N'ijwi ry'abazana ibitambo byo gushima mu nzu y'Uwiteka, kuko nzagarura abo mu gihugu bagiye ari imbohe bakaba nka mbere.’ Ni ko Uwiteka avuga.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
