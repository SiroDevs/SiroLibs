              "items": [
                {
                  "text": "Neh 13.15-22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Uku ni ko Uwiteka avuga ati: ‘Mwirinde mutikorera umutwaro ku munsi w'isabato, haba no kuwucisha mu marembo y'i Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.21",
            "verseOrgIds": [
              "JER.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 17:22"
          },
          "items": [
