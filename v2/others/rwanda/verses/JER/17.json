                "loc": "EXO.20.8+EXO.20.9+EXO.20.10"
              },
              "items": [
                {
                  "text": "Kuva 20.8-10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.12+DEU.5.13+DEU.5.14"
              },
              "items": [
                {
                  "text": "Guteg 5.12-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ntimugasohore umutwaro mu mazu yanyu kuri uwo munsi kandi ntimukagire umurimo wose mukora, ahubwo mujye mweza umunsi w'isabato nk'uko nabitegetse ba sogokuruza. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.22",
            "verseOrgIds": [
              "JER.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ntibarakumvira haba no gutega amatwi, ahubwo bashinze amajosi kugira ngo batumvira, haba no kwemera kwigishwa.’",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.23",
            "verseOrgIds": [
              "JER.17.23"
            ]
          }
        }
      ]
