              "COL.3.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.4.2"
              },
              "items": [
                {
                  "text": "Ef 4.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nuko nk'uko bikwiriye intore z'Imana zera kandi zikundwa, mwambare umutima w'imbabazi n'ineza, no kwicisha bugufi n'ubugwaneza no kwihangana, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.12",
            "verseOrgIds": [
              "COL.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "COL 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.4.32"
              },
              "items": [
                {
                  "text": "Ef 4.32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " mwihanganirana kandi mubabarirana ibyaha, uko umuntu agize icyo apfa n'undi. Nk'uko Umwami wacu yabababariye, abe ari ko namwe mubabarirana. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.13",
            "verseOrgIds": [
              "COL.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "COL 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ibigeretse kuri ibyo byose mwambare urukundo, kuko ari rwo murunga wo gutungana rwose. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.14",
            "verseOrgIds": [
              "COL.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "COL 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mureke amahoro ya Kristo atwarire mu mitima yanyu, ayo mwahamagariwe kuba umubiri umwe, kandi mugire imitima ishima. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.15",
            "verseOrgIds": [
              "COL.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "COL 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.19+EPH.5.20"
              },
              "items": [
                {
                  "text": "Ef 5.19-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ijambo rya Kristo ribe muri mwe rigwiriye rifite ubwenge bwose, mwigishanye, muhugurane muri zaburi n'indirimbo n'ibihimbano by'umwuka, muririmbirirana Imana ishimwe mu mitima yanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.16",
            "verseOrgIds": [
              "COL.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "COL 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi icyo muzavuga cyose n'ibyo muzakora, mujye mubikora byose mu izina ry'Umwami Yesu, mushima Imana Data wa twese ku bw'uwo.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.17",
            "verseOrgIds": [
              "COL.3.17"
            ]
          }
        }
      ]
    },
    {
