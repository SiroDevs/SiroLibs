                  "text": "1 Pet 3.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bagore, mugandukire abagabo banyu nk'uko bikwiriye abari mu Mwami wacu.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.18",
