                }
              ]
            }
          ]
        },
        {
          "text": " Arisitariko uwo tubohanywe arabatashya, na Mariko mwene se wabo wa Barinaba arabatashya na we. (Uwo ni we mwategetswe, naramuka aje iwanyu muzamwakire.) ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.10",
            "verseOrgIds": [
              "COL.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "COL 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yesu witwa Yusito arabatashya, abo ni bo bonyine bo mu bakebwe bakorana nanjye ku bw'ubwami bw'Imana kandi bamaze umubabaro.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.11",
            "verseOrgIds": [
              "COL.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "COL 4:11"
          },
          "items": [
            {
