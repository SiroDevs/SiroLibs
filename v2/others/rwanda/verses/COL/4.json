            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mugendere mu bwenge ku byo mugirira abo hanze, mucunguze uburyo umwete. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.5",
            "verseOrgIds": [
              "COL.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "COL 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijambo ryanyu rifatanye iteka n'ubuntu bw'Imana risīze umunyu, kugira ngo mumenye uko mukwiriye gusubiza umuntu wese.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.6",
            "verseOrgIds": [
              "COL.4.6"
            ]
          }
        }
      ]
    },
