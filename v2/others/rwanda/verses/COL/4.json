                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tukiko,",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.7",
            "verseOrgIds": [
              "COL.4.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "Tukiko na Onesimo",
              "type": "text"
            },
            {
              "text": "ni bo Pawulo yahaye uru rwandiko ngo barugeze ku Bakolosayi.",
              "type": "text"
            }
          ]
        },
        {
          "text": " mwene Data ukundwa w'umubwiriza w'iby'Imana ukiranuka, ni umugaragu mugenzi wanjye ukorera mu Mwami wacu, azababwira ibyanjye byose. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.7",
            "verseOrgIds": [
              "COL.4.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.6.21+EPH.6.22"
              },
              "items": [
                {
                  "text": "Ef 6.21-22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.7",
            "verseOrgIds": [
              "COL.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "COL 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni we mbatumyeho ku bw'ibyo ngo mumenye ibyacu kandi ahumurize imitima yanyu, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.8",
            "verseOrgIds": [
              "COL.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "COL 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHM.1.10+PHM.1.11+PHM.1.12"
              },
              "items": [
                {
                  "text": "File 10-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " mutumanye na Onesimo mwene Data wo kwizerwa kandi ukundwa, mwene wanyu, bazabamenyesha iby'ino byose.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.9",
            "verseOrgIds": [
              "COL.4.9"
            ]
          }
        }
