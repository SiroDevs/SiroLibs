              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.11",
            "verseOrgIds": [
              "COL.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "COL 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Epafura mwene wanyu arabatashya, na we ni imbata ya Kristo Yesu ibarwanira iteka ikabasabira, kugira ngo muhagarare mushikamye kandi mutunganye rwose, mumenya neza mudashidikanya ibyo Imana ishaka byose. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.12",
            "verseOrgIds": [
              "COL.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "COL 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi umugabo wo kumuhamya yuko abagirira umwete mwinshi, mwebwe n'ab'i Lawodikiya n'ab'i Hiyerapoli. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.13",
            "verseOrgIds": [
              "COL.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "COL 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luka umuvūzi ukundwa, na Dema barabatashya. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.14",
            "verseOrgIds": [
              "COL.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "COL 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntahirize bene Data b'i Lawodikiya, na Numfa n'Itorero ryo mu nzu ye.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.15",
            "verseOrgIds": [
              "COL.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
