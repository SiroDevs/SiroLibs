          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Makinadebayi na Shashayi na Sharayi, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.40",
            "verseOrgIds": [
              "EZR.10.40"
            ]
          }
        },
