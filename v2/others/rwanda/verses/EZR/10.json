        {
          "text": "Mu bakumirizi ni Shalumu na Telemu na Uri.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.24",
            "verseOrgIds": [
              "EZR.10.24"
            ]
          }
        }
