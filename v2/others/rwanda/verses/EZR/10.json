            "sid": "EZR 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu Bisirayeli: muri bene Paroshi ni Ramiya na Iziya na Malikiya, na Miyamini na Eleyazari na Malikiya na Benaya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.25",
            "verseOrgIds": [
              "EZR.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZR 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muri bene Elamu ni Mataniya na Zekariya na Yehiyeli, na Abudi na Yeremoti na Eliya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.26",
            "verseOrgIds": [
              "EZR.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZR 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muri bene Zatu ni Eliyowenayi na Eliyashibu na Mataniya, na Yeremoti na Zabadi na Aziza. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.27",
            "verseOrgIds": [
              "EZR.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZR 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muri bene Bebayi ni Yehohanani na Hananiya, na Zabayi na Atilayi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.28",
            "verseOrgIds": [
              "EZR.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZR 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muri bene Bani ni Meshulamu na Maluki na Adaya, na Yashubu na Sheyali na Yeremoti. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.29",
            "verseOrgIds": [
              "EZR.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZR 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muri bene Pahatimowabu ni Adina na Kelali na Benaya, na Māseya na Mataniya na Besalēli, na Binuwi na Manase. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.30",
            "verseOrgIds": [
              "EZR.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZR 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muri bene Harimu ni Eliyezeri na Ishiya na Malikiya, na Shemaya na Shimeyoni, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.31",
            "verseOrgIds": [
              "EZR.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZR 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Benyamini na Maluki na Shemariya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.32",
            "verseOrgIds": [
              "EZR.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EZR 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muri bene Hashumu ni Matenayi na Matata na Zabadi, na Elifeleti na Yeremayi na Manase na Shimeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.33",
            "verseOrgIds": [
              "EZR.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EZR 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muri bene Bani ni Madayi na Amuramu na Uweli, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.34",
            "verseOrgIds": [
              "EZR.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EZR 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Benaya na Bedeya na Keluhi, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.35",
            "verseOrgIds": [
              "EZR.10.35"
            ]
          }
        },
