            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.24",
            "verseOrgIds": [
              "EZR.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
