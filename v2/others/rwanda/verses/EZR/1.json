                "loc": "JER.29.10"
              },
              "items": [
                {
                  "text": "29.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mu mwaka wa mbere wo ku ngoma ya Kuro umwami w'u Buperesi, Uwiteka atera umwete umutima wa Kuro umwami w'u Buperesi, ngo ijambo Uwiteka yavugiye mu kanwa ka Yeremiya risohore. Ategeka ko bamamaza itegeko mu gihugu cye cyose kandi arandika ati ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.1",
            "verseOrgIds": [
              "EZR.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.44.28"
              },
              "items": [
                {
                  "text": "Yes 44.28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Kuro umwami w'u Buperesi aravuga ati ‘Uwiteka Imana nyir'ijuru yangabiye ibihugu by'abami bose byo mu isi, kandi yanyihanangirije kuyubakira inzu i Yerusalemu mu Buyuda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.2",
            "verseOrgIds": [
              "EZR.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "None umuntu wo mu bantu bayo wese uri muri mwe Imana ye ibane na we, azamuke ajye i Yerusalemu mu Bayuda yubake inzu y'Uwiteka Imana ya Isirayeli, ari yo Mana iba i Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.3",
            "verseOrgIds": [
              "EZR.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi umusuhuke wese usigara aho yasuhukiye, abantu baho nibamufashishe ifeza n'izahabu n'ibintu n'amatungo, ukuyemo amaturo baturira inzu y'Imana y'i Yerusalemu babikunze.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.4",
            "verseOrgIds": [
              "EZR.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.4",
            "verseOrgIds": [
              "EZR.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko abatware b'amazu ya ba sekuruza b'Abayuda n'ab'Ababenyamini, bahagurukana n'abatambyi n'Abalewi n'abandi bose Imana yateye umwete wo guhagurukana, ngo bajye kubaka inzu y'Uwiteka i Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.5",
            "verseOrgIds": [
              "EZR.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze abaturanyi babo babatwerera ibikoreshwa by'ifeza n'izahabu, n'ibindi bintu n'amatungo n'ibintu by'igiciro cyinshi, ukuyemo ibyo batuye byose babikunze.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.6",
            "verseOrgIds": [
              "EZR.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.6",
            "verseOrgIds": [
              "EZR.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi n'Umwami Kuro asohora ibintu byakoreshwaga mu nzu y'Uwiteka, ibyo Nebukadinezari yari yaranyaze i Yerusalemu, akabishyira mu ngoro z'ibigirwamana bye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.7",
            "verseOrgIds": [
              "EZR.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibyo Kuro umwami w'u Buperesi abikuzamo Mitiredati w'umunyabintu, na we abibarira Sheshibasari igikomangoma cyo mu Bayuda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.8",
            "verseOrgIds": [
              "EZR.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi umubare wabyo ni uyu: amasahani y'izahabu mirongo itatu n'ay'ifeza igihumbi, n'imishyo makumyabiri n'icyenda, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.9",
            "verseOrgIds": [
              "EZR.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'ibyungu by'izahabu mirongo itatu, n'iby'ifeza by'uburyo bwa kabiri magana ane n'icumi, n'ibindi bikoreshwa igihumbi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.10",
            "verseOrgIds": [
              "EZR.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.10",
            "verseOrgIds": [
              "EZR.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibikoreshwa byose by'izahabu n'ifeza byari ibihumbi bitanu na magana ane. Ibyo byose Sheshibasari yabizamukanye ubwo abanyagano bavanwaga i Babuloni, bagasubira i Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.11",
            "verseOrgIds": [
              "EZR.1.11"
            ]
          }
        }
      ]
    }
  ],
