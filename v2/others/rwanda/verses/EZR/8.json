            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EZR 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze abavukiye mu bunyage bakabuvamo batambira Imana ya Isirayeli ibitambo byoswa, batamba inka cumi n'ebyiri z'igitambo cyoswa cy'Abisirayeli bose, n'amasekurume y'intama mirongo urwenda n'atandatu, n'abana b'intama mirongo irindwi na barindwi, n'amasekurume y'ihene cumi n'abiri, biba igitambo cyo gukuraho ibyaha. Ibyo byose byabaye igitambo cyoserezwa Uwiteka. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.35",
            "verseOrgIds": [
              "EZR.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EZR 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze bashyikiriza abatware b'umwami n'ibisonga bye bo hakurya y'uruzi amategeko y'umwami, na bo bafasha abantu n'inzu y'Imana.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.36",
            "verseOrgIds": [
              "EZR.8.36"
            ]
          }
        }
