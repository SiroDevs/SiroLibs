            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HEB 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahubwo mwegereye umusozi wa Siyoni n'ururembo rw'Imana ihoraho, ari rwo Yerusalemu yo mu ijuru, kandi mwegereye iteraniro ry'abamarayika batabarika, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.22",
            "verseOrgIds": [
              "HEB.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HEB 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'Itorero ry'abana b'impfura banditswe mu ijuru, mwegereye n'Imana umucamanza wa bose n'imyuka y'abakiranutsi batunganijwe rwose. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.23",
            "verseOrgIds": [
              "HEB.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "HEB 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.4.10"
              },
              "items": [
                {
                  "text": "Itang 4.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mwegereye na Yesu umuhuza w'isezerano rishya, mwegereye n'amaraso aminjagirwa, avuga ibyiza kurusha aya Abeli.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.24",
            "verseOrgIds": [
              "HEB.12.24"
