                "loc": "DEU.5.22+DEU.5.23+DEU.5.24+DEU.5.25+DEU.5.26+DEU.5.27"
              },
              "items": [
                {
                  "text": "5.22-27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ntimwegereye wa musozi ubasha gukorwaho wakaga umuriro, cyangwa ngo mwegere igicu n'umwijima w'icuraburindi n'umuyaga w'ishuheri, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.18",
            "verseOrgIds": [
              "HEB.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'ijwi ry'impanda n'iry'amagambo, abaryumvise bakingingira kutongerwaho ijambo, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.19",
            "verseOrgIds": [
              "HEB.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HEB 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.19.12+EXO.19.13"
              },
              "items": [
                {
                  "text": "Kuva 19.12-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " kuko batashoboye kwihanganira ibyategetswe, ngo “Naho yaba inyamaswa ikoze kuri uwo musozi bayicishe amabuye.” ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.20",
            "verseOrgIds": [
              "HEB.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HEB 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.9.19"
              },
              "items": [
                {
                  "text": "Guteg 9.19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ibyo byose byari ibiteye ubwoba, ni cyo cyatumye Mose avuga ati “Mfite ubwoba cyane ndahinda umushyitsi.”",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.21",
            "verseOrgIds": [
              "HEB.12.21"
            ]
          }
        }
      ]
    },
