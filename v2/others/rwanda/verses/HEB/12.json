                "loc": "JOB.5.17"
              },
              "items": [
                {
                  "text": "Yobu 5.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.3.11+PRO.3.12"
              },
              "items": [
                {
                  "text": "Imig 3.11-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " kandi mwibagiwe kwa guhugura kubabwira nk'abana ngo",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.5",
            "verseOrgIds": [
              "HEB.12.5"
            ]
          }
        }
      ]
    },
