              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nuko mumanike amaboko atentebutse, mugorore amavi aremaye, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.12",
            "verseOrgIds": [
              "HEB.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.4.26"
              },
              "items": [
                {
                  "text": "Imig 4.26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " kandi muharurire ibirenge byanyu inzira zigororotse, kugira ngo ikirenge gicumbagira kidakuka rwose ahubwo gikire.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.13",
            "verseOrgIds": [
              "HEB.12.13"
            ]
          }
        }
      ]
