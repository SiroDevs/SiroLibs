              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.1",
            "verseOrgIds": [
              "HEB.7.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.14.17+GEN.14.18+GEN.14.19+GEN.14.20"
              },
              "items": [
                {
                  "text": "Itang 14.17-20",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Melikisedeki uwo wari umwami w'i Salemu, n'umutambyi w'Imana Isumbabyose (wa wundi wasanganiye Aburahamu, ubwo yatabarukaga avuye gutsinda abami, amuha umugisha, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.1",
            "verseOrgIds": [
              "HEB.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni na we Aburahamu yahaye kimwe mu icumi cya byose). Ubwa mbere izina rye risobanurwa ngo “Umwami wo gukiranuka”, kandi irya kabiri yitwa “Umwami w'i Salemu”, risobanurwa ngo “Umwami w'amahoro.” ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.2",
            "verseOrgIds": [
              "HEB.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntagira se ntagira nyina, ntagira ba sekuruza kandi ntafite itangiriro ry'iminsi cyangwa iherezo ry'ubugingo, ahubwo ubwo",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.3",
            "verseOrgIds": [
              "HEB.7.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "ahubwo ubwo:",
              "type": "text"
            },
            {
              "text": "cyangwa, ahubwo.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ashushanywa n'Umwana w'Imana, ahora ari umutambyi iteka ryose.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.3",
            "verseOrgIds": [
              "HEB.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.3",
            "verseOrgIds": [
              "HEB.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko mutekereze namwe uburyo uwo muntu yari akomeye, byatumye ndetse Aburahamu sogokuruza mukuru amuha kimwe mu icumi cy'iminyago y'inyamibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.4",
            "verseOrgIds": [
              "HEB.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.21"
              },
              "items": [
                {
                  "text": "Kub 18.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kandi abana ba Lewi ari bo bahabwa ubutambyi, bafite itegeko ryo gukoresha abantu kimwe mu icumi, ni bo bene wabo nubwo abo bakomotse ku rukiryi rwa Aburahamu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.5",
            "verseOrgIds": [
              "HEB.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko dore wa wundi utakomotse mu muryango wabo yakoresheje Aburahamu kimwe mu icumi, kandi aha umugisha nyir'ibyasezeranijwe! ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.6",
            "verseOrgIds": [
              "HEB.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nta wahakana ko uworoheje ahabwa umugisha n'ukomeye. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.7",
            "verseOrgIds": [
              "HEB.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi muri twe abantu bapfa ni bo bahabwa kimwe mu icumi, naho icyo gihe cyahawe uhamywa ko ahoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.8",
            "verseOrgIds": [
              "HEB.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndetse byabasha kuvugwa yuko Lewi uhabwa kimwe mu icumi, na we ubwe yagikoreshejwe ku bwa Aburahamu ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.9",
            "verseOrgIds": [
              "HEB.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko yari akiri mu rukiryi rwa sekuruza, ubwo Melikisedeki yamusanganiraga.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.10",
            "verseOrgIds": [
              "HEB.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.10",
            "verseOrgIds": [
              "HEB.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko, niba gutunganywa rwose kuba kwarazanywe n'ubutambyi bw'Abalewi (kuko mu gihe cyabwo ari ho abantu baherewe amategeko), ni iki cyatumye bigikwiriye ko undi mutambyi aboneka wo mu buryo bwa Melikisedeki, utavugwaho ko ari mu buryo bwa Aroni? ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.11",
            "verseOrgIds": [
              "HEB.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero ubwo ubutambyi bwahindutse ni cyo gituma n'amategeko na yo akwiriye guhinduka, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.12",
            "verseOrgIds": [
              "HEB.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko uwavuzweho ibyo, ari uwo mu wundi muryango utigeze gukomokwaho n'uwakoze umurimo wo ku gicaniro. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.13",
            "verseOrgIds": [
              "HEB.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi biragaragara rwose yuko Umwami wacu yakomotse kuri Yuda, ari nta cyo Mose yavuze kuri uwo muryango cyerekeye ubutambyi.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.14",
            "verseOrgIds": [
              "HEB.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.14",
            "verseOrgIds": [
              "HEB.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndetse birushaho kugaragara, ubwo habonetse undi mutambyi uhwanye na Melikisedeki, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.15",
            "verseOrgIds": [
              "HEB.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "utatoranirijwe ubutambyi nk'uko byategetswe n'amategeko yo mu buryo bw'abantu, ahubwo wabuheshejwe n'uko afite imbaraga z'ubugingo butagira iherezo, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.16",
            "verseOrgIds": [
              "HEB.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.110.4"
              },
              "items": [
                {
                  "text": "Zab 110.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " kuko ahamywa ngo",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.17",
            "verseOrgIds": [
              "HEB.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.17",
            "verseOrgIds": [
              "HEB.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero itegeko rya mbere ryakuweho ku bw'intege nke zaryo n'umumaro muke, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.18",
            "verseOrgIds": [
              "HEB.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko amategeko atagize icyo yatunganije rwose, ahubwo yari ibanze ry'ibyiringiro biyaruta biduhesha kwegera Imana.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.19",
            "verseOrgIds": [
              "HEB.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.19",
            "verseOrgIds": [
              "HEB.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HEB 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ubwo bitabaye ari nta ndahiro, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.20",
            "verseOrgIds": [
              "HEB.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HEB 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.110.4"
              },
              "items": [
                {
                  "text": "Zab 110.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " (dore Abalewi bahawe ubutambyi ari nta ndahiro, nyamara Iyabuhaye uwo yararahiye imubwiye iti “Uwiteka ararahiye kandi ntazivuguruza ati ‘Uri umutambyi iteka ryose’ ”), ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.21",
            "verseOrgIds": [
              "HEB.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HEB 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni cyo cyatumye Yesu aba umwishingizi w'isezerano rirusha rya rindi kuba ryiza.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.22",
            "verseOrgIds": [
              "HEB.7.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HEB 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.22",
            "verseOrgIds": [
              "HEB.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HEB 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ba bandi babaye abatambyi ni benshi kuko urupfu rubabuza guhoraho, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.23",
            "verseOrgIds": [
              "HEB.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "HEB 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "naho Uwo kuko ahoraho iteka ryose afite ubutambyi budakuka. ",
          "type": "text",
          "attrs": {
