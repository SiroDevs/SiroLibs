              "HEB.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo rya sezerano rya mbere ryinonosora, ntihajyaga kuba hakwiriye gushakwa irindi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.7",
            "verseOrgIds": [
