        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.18+EXO.25.19+EXO.25.20+EXO.25.21+EXO.25.22"
              },
              "items": [
                {
                  "text": "Kuva 25.18-22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hejuru yayo hariho Abakerubi b'icyubahiro bateye igicucu intebe y'imbabazi, ariko ibyo ntitwakwirirwa tubirondora nonaha.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.5",
            "verseOrgIds": [
              "HEB.9.5"
            ]
          }
        }
