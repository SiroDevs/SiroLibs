            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Icyakora ibyo bimaze kwitegurwa bityo, abatambyi binjiraga iminsi yose mu ihema ribanzirizwamo, kugira ngo basohoze imirimo yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.6",
            "verseOrgIds": [
              "HEB.9.6"
            ]
          }
        },
        {
