          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku bw'ibyo, ni cyo gituma aba umuhuza w'isezerano rishya, kugira ngo abahamagawe bahabwe ibiragwa bidashira byasezeranijwe, ubwo habayeho uwapfiriye gucungura abacumuye bagitegekwa n'isezerano rya mbere.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.15",
            "verseOrgIds": [
              "HEB.9.15"
            ]
          }
        }
