        },
        {
          "text": " kuko hariho ihema ribanzirizwamo, ryarimo igitereko cy'amatabaza n'ameza, n'imitsima iyateretseho imbere y'Imana, rikitwa Ahera. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.2",
            "verseOrgIds": [
              "HEB.9.2"
            ]
          }
        },
