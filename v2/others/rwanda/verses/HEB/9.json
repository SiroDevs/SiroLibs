              },
              "items": [
                {
                  "text": "17-19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " None ubwo amaraso y'ihene n'ay'amapfizi n'ivu ry'inka y'iriza, iyo biminjiriwe ku bahumanye ko byeza umubiri ugahumanuka, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.13",
            "verseOrgIds": [
              "HEB.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkanswe amaraso ya Kristo witambiye Imana atagira inenge ku bw'Umwuka w'iteka, ntazarushaho guhumanura imitima yanyu akayezaho imirimo ipfuye, kugira ngo mubone uko mukorera Imana ihoraho?",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.14",
            "verseOrgIds": [
              "HEB.9.14"
            ]
          }
        }
      ]
    },
