                {
                  "text": "Kuva 26.31-33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kandi hirya y'inyegamo y'umwenda wa kabiri ukinze hariho ihema, hitwa Ahera cyane. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.3",
