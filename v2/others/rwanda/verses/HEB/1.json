          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kera Imana yavuganiye na ba sogokuruza mu kanwa k'abahanuzi mu bihe byinshi no mu buryo bwinshi, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.1",
            "verseOrgIds": [
              "HEB.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "naho muri iyi minsi y'imperuka yavuganiye natwe mu kanwa k'Umwana wayo, uwo yashyiriyeho kuba umuragwa wa byose ari we yaremesheje isi.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.2",
            "verseOrgIds": [
              "HEB.1.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "isi:",
              "type": "text"
            },
            {
              "text": "cyangwa, ibihe.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.2",
            "verseOrgIds": [
              "HEB.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo kuko ari ukurabagirana k'ubwiza bwayo n'ishusho ya kamere yayo, kandi akaba ari we uramiza byose ijambo ry'imbaraga ze, amaze kweza no gukuraho ibyaha byacu yicara iburyo bw'Ikomeye cyane yo mu ijuru.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.3",
            "verseOrgIds": [
              "HEB.1.3"
            ]
          }
        }
      ]
    },
