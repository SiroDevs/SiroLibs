              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.10",
            "verseOrgIds": [
              "HEB.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tumufiteho byinshi byo kuvugwa kandi biruhije gusobanurwa, kuko mwabaye ibihuri. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.11",
            "verseOrgIds": [
              "HEB.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.3.2"
              },
              "items": [
                {
                  "text": "1 Kor 3.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kandi nubwo mwari mukwiriye kuba abigisha ubu kuko mumaze igihe kirekire mwiga, dore musigaye mukwiriye kongera kwigishwa namwe iby'ishingiro rya mbere ry'ibyavuzwe n'Imana, kandi mwahindutse abakwiriye kuramizwa amata aho kugaburirwa ibyokurya bikomeye, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.12",
            "verseOrgIds": [
              "HEB.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko unywa amata aba ataraca akenge mu by'ijambo ryo gukiranuka kuko akiri uruhinja, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.13",
            "verseOrgIds": [
              "HEB.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ariko ibyokurya bikomeye ni iby'abakuru bafite ubwenge, kandi bamenyereye gutandukanya ikibi n'icyiza.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.14",
            "verseOrgIds": [
              "HEB.5.14"
            ]
          }
        }
      ]
