            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.22.39+LUK.22.40+LUK.22.41+LUK.22.42+LUK.22.43+LUK.22.44+LUK.22.45+LUK.22.46"
              },
              "items": [
                {
                  "text": "Luka 22.39-46",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yesu akiri mu mubiri, amaze kwinginga no gusaba cyane Iyabashije kumukiza urupfu ataka cyane arira, yumviswe ku bwo kubaha kwe. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.7",
            "verseOrgIds": [
              "HEB.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyamara nubwo ari Umwana w'Imana, yigishijwe kumvira ku bw'imibabaro yihanganiye, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.8",
            "verseOrgIds": [
              "HEB.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi amaze gutunganywa rwose abera abamwumvira bose umuhesha w'agakiza kadashira, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.9",
            "verseOrgIds": [
              "HEB.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana ubwayo imwise umutambyi mukuru wo mu buryo bwa Melikisedeki.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.10",
            "verseOrgIds": [
              "HEB.5.10"
            ]
          }
        }
      ]
    },
