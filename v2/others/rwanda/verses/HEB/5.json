            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umutambyi mukuru wese iyo atoranijwe mu bantu, ashyirirwaho gukora ibyerekeye Imana ku bw'abantu kugira ngo ature amaturo, atambe n'ibitambo by'ibyaha, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.1",
            "verseOrgIds": [
              "HEB.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi abasha kwihanganira abatagira ubwenge n'abayobye, kuko na we agoswe n'intege nke. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.2",
            "verseOrgIds": [
              "HEB.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.9.7"
              },
              "items": [
                {
                  "text": "Lewi 9.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ndetse ni cyo gituma akwiriye no kwitambirira ibye byaha, nk'uko abitambirira abandi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.3",
            "verseOrgIds": [
              "HEB.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.28.1"
              },
              "items": [
                {
                  "text": "Kuva 28.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nta wiha icyo cyubahiro, ahubwo ahamagarwa n'Imana nk'uko Aroni yahamagawe.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.4",
            "verseOrgIds": [
              "HEB.5.4"
            ]
          }
        }
      ]
    },
