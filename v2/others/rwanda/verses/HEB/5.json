              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ni ko na Kristo atihimbarishije kwigira Umutambyi mukuru, ahubwo yabihawe n'Iyamubwiye iti",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.5",
            "verseOrgIds": [
              "HEB.5.5"
            ]
          }
        }
