          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandi bati “Umunyabyaha yabasha ate gukora ibimenyetso bingana bityo?” Baramupfa.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.16",
            "verseOrgIds": [
              "JHN.9.16"
            ]
          }
        }
      ]
    },
