          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "uwizera uwo Mwana aba abonye ubugingo buhoraho, ariko utumvira uwo Mwana ntazabona ubugingo, ahubwo umujinya w'Imana uguma kuri we.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.36",
