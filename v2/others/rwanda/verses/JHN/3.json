          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abigishwa ba Yohana bajya impaka n'Umuyuda ku byo kwiyeza. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.25",
            "verseOrgIds": [
              "JHN.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basanga Yohana baramubwira bati “Mwigisha, uwari kumwe nawe hakurya ya Yorodani, uwo wahamyaga dore na we arabatiza, n'abantu bose baramusanga.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.26",
            "verseOrgIds": [
              "JHN.3.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 3:26"
          },
          "items": [
