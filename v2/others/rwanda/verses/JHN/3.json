              "items": [
                {
                  "text": "Luka 10.22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Se akunda Umwana we kandi yamweguriye byose, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.35",
            "verseOrgIds": [
              "JHN.3.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
