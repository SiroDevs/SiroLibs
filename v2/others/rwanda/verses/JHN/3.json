              "JHN.3.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwavuye mu ijuru ni we usumba byose, naho uwo mu isi we ni uw'isi nyine, kandi n'ibyo avuga ni iby'isi. Uwavuye mu ijuru ni we usumba byose, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.31",
            "verseOrgIds": [
              "JHN.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ibyo yabonye n'ibyo yumvise ni byo ahamya, nyamara nta wemera ibyo ahamya. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.32",
            "verseOrgIds": [
              "JHN.3.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 3:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwemera ibyo ahamya, aba yemeye n'uko n'Imana ari inyakuri. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.33",
            "verseOrgIds": [
              "JHN.3.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 3:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwatumwe n'Imana avuga amagambo yayo, kuko Imana idatanga Umwuka imugeze. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.34",
            "verseOrgIds": [
              "JHN.3.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
