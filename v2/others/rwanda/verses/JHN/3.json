              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.26",
            "verseOrgIds": [
              "JHN.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yohana arabasubiza ati “Nta cyo umuntu yashobora kwiha ubwe, keretse yagihawe kivuye mu ijuru. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.27",
            "verseOrgIds": [
              "JHN.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.20"
              },
              "items": [
                {
                  "text": "Yoh 1.20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Namwe murambere abagabo yuko navuze nti ‘Si jye Kristo, ahubwo natumwe kumubanziriza.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.28",
            "verseOrgIds": [
              "JHN.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo umugeni asanga ni we mukwe, kandi umuranga iyo ahagaze iruhande rw'umukwe amwumva anezezwa n'ijwi rye. None uwo munezero wanjye mwinshi cyane urasohoye. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.29",
            "verseOrgIds": [
              "JHN.3.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo akwiriye gukuzwa, naho jye nkwiriye kwicisha bugufi.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.30",
            "verseOrgIds": [
              "JHN.3.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
