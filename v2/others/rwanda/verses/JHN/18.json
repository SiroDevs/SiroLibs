          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icyakora mufite umugenzo ko mbabohorera imbohe imwe mu minsi ya Pasika. Mbese murashaka ko mbabohorera umwami w'Abayuda?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.39",
            "verseOrgIds": [
              "JHN.18.39"
            ]
          }
        }
