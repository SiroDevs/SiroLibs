              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaze kubivuga atyo aherako arasohoka, ajya aho Abayuda bari bari arababwira ati “Jyewe nta cyaha mubonyeho. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.38",
            "verseOrgIds": [
              "JHN.18.38"
            ]
          }
        },
