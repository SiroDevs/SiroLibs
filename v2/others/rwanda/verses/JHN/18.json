              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilato aramubaza ati “Ukuri ni iki?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.38",
            "verseOrgIds": [
              "JHN.18.38"
