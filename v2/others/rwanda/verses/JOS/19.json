              "items": [
                {
                  "text": "Abac 18.27-29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kandi igihugu cy'Abadani cyisumbura urugabano rwabo, kuko Abadani bazamutse bagatera i Leshemu bakaharwanya, bahaneshesha inkota barahahindūra baturayo, maze i Leshemu bahita i Dani, bahitirira n'izina rya sekuruza Dani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.47",
            "verseOrgIds": [
              "JOS.19.47"
            ]
          }
        },
        {
