              "type": "text"
            }
          ]
        },
        {
          "text": "Ubufindo bwa karindwi bwerekana umuryango w'Abadani nk'uko amazu yabo ari. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.40",
            "verseOrgIds": [
              "JOS.19.40"
            ]
          }
        },
