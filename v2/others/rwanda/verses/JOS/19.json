              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo ni yo gakondo y'umuryango w'Abadani nk'uko amazu yabo ari, imidugudu n'ibirorero byabo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.48",
            "verseOrgIds": [
              "JOS.19.48"
            ]
          }
        }
