          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze yandikira imbere y'Abisirayeli ku mabuye y'igicaniro amategeko ya Mose, nk'uko Mose yari yarayanditse. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.32",
            "verseOrgIds": [
              "JOS.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
