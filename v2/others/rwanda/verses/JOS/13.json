          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Mose ni we wagerereye igice cy'umuryango wa Manase, haba ahabo nk'uko amazu yabo ari. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.29",
            "verseOrgIds": [
              "JOS.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igihugu bahawe cyageraga i Mahanayimu n'i Bashani yose, igihugu cyose cya Ogi umwami w'i Bashani, n'imidugudu yose ya Yayiri yo muri Bashani, yose yari mirongo itandatu, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.30",
            "verseOrgIds": [
              "JOS.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'igice cy'i Galeyadi na Ashitaroti na Edureyi, imidugudu y'igihugu cya Ogi cy'i Bashani, yari iya bene Makiri mwene Manase. Ni cyo cya gice cya bene Makiri nk'uko amazu yabo ari.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.31",
            "verseOrgIds": [
              "JOS.13.31"
            ]
          }
        }
