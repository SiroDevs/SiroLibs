              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.26",
            "verseOrgIds": [
              "JOS.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi bagabanyiriza bene Gerushoni bo mu mazu y'Abalewi, mu mugabane w'igice cy'umuryango wa Manase i Golani y'i Bashani n'ibikingi byabo, ari wo mudugudu w'ubuhungiro bwa gatozi, n'i Bēshitera n'ibikingi byaho. Iyo midugudu uko ari ibiri. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.27",
            "verseOrgIds": [
              "JOS.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi mu muryango wa Isakari babaha i Kishiyoni n'ibikingi byaho, n'i Daberati n'ibikingi byaho, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.28",
            "verseOrgIds": [
              "JOS.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'i Yaramuti n'ibikingi byaho, na Eniganimu n'ibikingi byaho. Yose ni imidugudu ine. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.29",
            "verseOrgIds": [
              "JOS.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi mu muryango wa Asheri babaha i Mishali n'ibikingi byaho, na Abudoni n'ibikingi byaho, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.30",
            "verseOrgIds": [
              "JOS.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'i Helikati n'ibikingi byaho, n'i Rehobu n'ibikingi byaho. Yose ni imidugudu ine. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.31",
            "verseOrgIds": [
              "JOS.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi umuryango wa Nafutali babaha i Kedeshi y'i Galilaya n'ibikingi byaho, ari wo mudugudu w'ubuhungiro bwa gatozi, n'i Hamotidori n'ibikingi byaho, n'i Karitani n'ibikingi byaho. Yose ni imidugudu itatu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.32",
            "verseOrgIds": [
              "JOS.21.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imidugudu yose y'Abagerushoni nk'uko amazu yabo ari, yari cumi n'itatu n'ibikingi byayo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.33",
            "verseOrgIds": [
              "JOS.21.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
