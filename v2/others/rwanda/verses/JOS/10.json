          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosuwa arabica uhereye i Kadeshi y'i Baruneya ukageza n'i Gaza, n'igihugu cyose cy'i Gosheni kugeza n'i Gibeyoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.41",
            "verseOrgIds": [
              "JOS.10.41"
            ]
          }
        },
