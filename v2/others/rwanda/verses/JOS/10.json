          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko abo bami bose n'ibihugu byabo Yosuwa abaneshereza icyarimwe, kuko Uwiteka Imana y'Abisirayeli yabarwaniye. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.42",
            "verseOrgIds": [
              "JOS.10.42"
            ]
          }
