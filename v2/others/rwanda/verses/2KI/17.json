              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.39",
            "verseOrgIds": [
              "2KI.17.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "2KI 17:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ntibabyitaho, ahubwo bakomeza ingeso zabo za kera. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.40",
            "verseOrgIds": [
              "2KI.17.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "2KI 17:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ayo mahanga yubahaga Uwiteka, ariko bagakorera n'ibishushanyo byabo bibajwe, n'abana babo n'abuzukuru babo bakomeza kugenza batyo. Uko ba sekuruza bagenzaga, na bo ni ko bagenza na bugingo ubu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.41",
            "verseOrgIds": [
              "2KI.17.41"
            ]
          }
        }
      ]
    }
