          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko indi mirimo ya Zekariya yanditswe mu gitabo cy'ibyo ku ngoma z'abami b'Abisirayeli.",
          "type": "text",
          "attrs": {
