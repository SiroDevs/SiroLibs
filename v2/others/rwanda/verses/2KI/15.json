            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.12",
            "verseOrgIds": [
              "2KI.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka wa mirongo itatu n'icyenda wo ku ngoma ya Uziya umwami w'Abayuda, Shalumu mwene Yabeshi yarimye, amara ukwezi kumwe i Samariya ari ku ngoma.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.13",
            "verseOrgIds": [
              "2KI.15.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.13",
            "verseOrgIds": [
              "2KI.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma Menahemu mwene Gadi ava i Tirusa arazamuka ajya i Samariya, yicirayo Shalumu mwene Yabeshi. Amaze kumwica yima mu cyimbo cye. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.14",
            "verseOrgIds": [
              "2KI.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko indi mirimo ya Shalumu n'ubugome bwe byanditswe mu gitabo cy'ibyo ku ngoma z'abami b'Abisirayeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.15",
            "verseOrgIds": [
              "2KI.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.15",
            "verseOrgIds": [
              "2KI.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye Menahemu ava i Tirusa atera i Tipusa, ahatsindana n'abari barimo bose n'ibihugu byaho. Icyatumye ahatsinda, ni uko banze kumwugururira amarembo, maze abagore batwite bari barimo bose arabafomoza.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.16",
            "verseOrgIds": [
              "2KI.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.16",
            "verseOrgIds": [
              "2KI.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka wa mirongo itatu n'icyenda wo ku ngoma ya Uziya umwami w'Abayuda, Menahemu mwene Gadi yimye muri Isirayeli, amara imyaka cumi i Samariya ari ku ngoma. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.17",
            "verseOrgIds": [
              "2KI.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko akora ibyangwa n'Uwiteka. Mu gihe yari akiriho, ntiyaretse ibyaha bya Yerobowamu mwene Nebati woheje Abisirayeli ngo bacumure. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.18",
            "verseOrgIds": [
              "2KI.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye Puli umwami wa Ashuri atera igihugu. Menahemu ni ko guhongera Puli italanto z'ifeza igihumbi, kugira ngo amutize amaboko abone uko akomera mu bwami bwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.19",
            "verseOrgIds": [
              "2KI.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Menahemu yari yatse abakomeye mu Bisirayeli b'abatunzi bose ifeza, umuntu wese muri bo yamwatse shekeli z'ifeza mirongo itanu, ngo azihe umwami wa Ashuri. Nuko umwami wa Ashuri arakimirana ntiyaguma muri icyo gihugu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.20",
            "verseOrgIds": [
              "2KI.15.20"
            ]
          }
        }
      ]
    },
    {
