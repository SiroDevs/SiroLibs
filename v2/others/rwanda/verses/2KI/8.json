          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko yagendanaga ingeso z'abami b'Abisirayeli nk'uko ab'inzu ya Ahabu bazigendanaga, kuko yarongoye umukobwa wa Ahabu akora ibyangwa n'Uwiteka. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.18",
            "verseOrgIds": [
              "2KI.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.11.36"
              },
              "items": [
                {
                  "text": "1 Abami 11.36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ariko Uwiteka yanze kurimbura Abayuda kuko yagiriye Dawidi umugaragu we, nk'uko yamusezeranije kuzamuha itabaza rijya ryaka mu rubyaro rwe iteka ryose.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.19",
            "verseOrgIds": [
              "2KI.8.19"
            ]
          }
        }
