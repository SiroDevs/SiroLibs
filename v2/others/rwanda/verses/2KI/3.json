          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze bageze mu rugerero rwa Isirayeli, Abisirayeli barabahagurukana barabanesha, bituma Abamowabu bahunga. Abisirayeli basesekara mu gihugu cyabo, babakubita umugenda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.24",
            "verseOrgIds": [
              "2KI.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
