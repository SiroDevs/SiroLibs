            "style": "v",
            "sid": "2KI 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.20",
            "verseOrgIds": [
              "2KI.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abamowabu bose bumvise ko abo bami bazamutse kubatera, baherako baterana bose uko bangana, uhereye ku basore b'imigenda bashobora kwambara ibyo kurwanisha, baragenda bategera ku rugabano. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.21",
            "verseOrgIds": [
              "2KI.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abamowabu bazinduka kare mu gitondo, babona izuba rirasiye ku mazi aberekeye atukura nk'amaraso, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.22",
            "verseOrgIds": [
              "2KI.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "baravuga bati “Dore amaraso. Ni ukuri ba bami bararimbutse, ingabo zabo zisubiranyemo ubwazo. Noneho yemwe Bamowabu, nimuze tujye kwinyagira.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.23",
            "verseOrgIds": [
              "2KI.3.23"
            ]
          }
        }
