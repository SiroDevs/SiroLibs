          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko mu kwezi kwa karindwi, Ishimayeli mwene Netaniya mwene Elishama w'igikomangoma araza azanye n'abantu cumi, bica Gedaliya n'Abayuda n'Abakaludaya bari kumwe na we i Misipa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.25",
            "verseOrgIds": [
              "2KI.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 25:26"
          },
          "items": [
