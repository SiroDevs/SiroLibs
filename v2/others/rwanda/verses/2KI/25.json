                "loc": "JER.43.5+JER.43.6+JER.43.7"
              },
              "items": [
                {
                  "text": "Yer 43.5-7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Abantu bose, aboroheje n'abakomeye n'abatware b'ingabo, baherako barahaguruka bajya Egiputa kuko batinye Abakaludaya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.26",
