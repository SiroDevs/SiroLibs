            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.15+1KI.7.16+1KI.7.17+1KI.7.18+1KI.7.19+1KI.7.20+1KI.7.21+1KI.7.22+1KI.7.23+1KI.7.24+1KI.7.25+1KI.7.26"
              },
              "items": [
                {
                  "text": "1 Abami 7.15-26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.3.15+2CH.3.16+2CH.3.17"
              },
              "items": [
                {
                  "text": "2 Ngoma 3.15-17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kandi inkingi z'imiringa zari mu nzu y'Uwiteka n'ibitereko n'igikarabiro kidendeje cy'umuringa cyari mu nzu y'Uwiteka, Abakaludaya barabimenagura, bajyana imiringa yabyo i Babuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.13",
            "verseOrgIds": [
              "2KI.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.45"
              },
              "items": [
                {
                  "text": "1 Abami 7.45",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.4.16"
              },
              "items": [
                {
                  "text": "2 Ngoma 4.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bajyana n'ibibindi n'ibyuma byo kuyora ivu, n'ibifashi n'indosho n'ibintu by'imiringa bakoreshaga byose, n'ibyotero n'ibyungu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.14",
            "verseOrgIds": [
              "2KI.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi uwo mutware w'abarinzi ajyana ibintu by'izahabu n'iby'ifeza. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.15",
            "verseOrgIds": [
              "2KI.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Za nkingi zombi na cya gikarabiro kidendeje n'ibitereko Salomo yakoreye gushyira mu nzu y'Uwiteka, imiringa yabyo byose ntiyagiraga akagero. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.16",
            "verseOrgIds": [
              "2KI.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkingi imwe uburebure bwayo bwari mikono cumi n'umunani, kandi umutwe wayo wacuzwe mu miringa, uburebure bwawo bwari mikono itatu, hasobekeranijeho ibisa n'urushundura hariho n'imbuto z'amakomamanga, byose byari imiringa. Kandi inkingi ya kabiri na yo yariho bene ibyo hamwe n'ibisa n'urushundura.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.17",
            "verseOrgIds": [
              "2KI.25.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abari basigaye i Yerusalemu bajyanwa ho iminyago i Babuloni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.17",
            "verseOrgIds": [
              "2KI.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye umutware w'abarinzi afata Seraya umutambyi mukuru, na Zefaniya umutambyi wa kabiri n'abarinzi b'irembo batatu, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.18",
            "verseOrgIds": [
              "2KI.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi muri uwo murwa ahafatira umutware w'ingabo, n'abagabo batanu b'ibyegera by'umwami yasanze aho, n'umwanditsi w'umugaba w'ingabo wakoranyaga ingabo zo muri icyo gihugu, n'abagabo mirongo itandatu bo muri rubanda yasanze mu murwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.19",
            "verseOrgIds": [
              "2KI.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Nebuzaradani umutware w'abarinzi, arabajyana abashyira umwami w'i Babuloni i Ribula. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.20",
            "verseOrgIds": [
              "2KI.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami w'i Babuloni abicira i Ribula mu gihugu cy'i Hamati.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.21",
            "verseOrgIds": [
              "2KI.25.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko ni ko Abayuda bajyanywe ho iminyago bakurwa mu gihugu cyabo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.21",
            "verseOrgIds": [
              "2KI.25.21"
            ]
          }
        }
      ]
    },
    {
