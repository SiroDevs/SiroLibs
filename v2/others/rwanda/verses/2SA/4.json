              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye Ishibosheti mwene Sawuli yumvise ko Abuneri yaguye i Heburoni aracogora, Abisirayeli bose bahagarika umutima. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.1",
            "verseOrgIds": [
              "2SA.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Ishibosheti uwo mwene Sawuli yari afite abatware b'ingabo babiri: umwe yitwaga Bāna, undi yitwaga Rekabu, bene Rimoni w'i Bēroti wo mu muryango wa Benyamini. (Kuko i Bēroti habarwaga ku Babenyamini, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.2",
            "verseOrgIds": [
              "2SA.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ab'i Bēroti bari barahungiye i Gitayimu, basuhukirayo na bugingo n'ubu.)",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.3",
            "verseOrgIds": [
              "2SA.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
