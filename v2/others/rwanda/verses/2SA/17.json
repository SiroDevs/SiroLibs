          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "bamuzanira amariri n'inzabya n'inkono, n'ingano na sayiri n'ifu n'ingano zikaranze, n'ibishyimbo n'udushyimbo duto n'inkori zikaranze, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.28",
