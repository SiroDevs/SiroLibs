          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Dawidi ajya i Mahanayimu, Abusalomu na we yambuka Yorodani ari kumwe n'Abisirayeli bose. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.24",
            "verseOrgIds": [
              "2SA.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Abusalomu agira Amasa umugaba w'ingabo ze, mu cyimbo cya Yowabu. Kandi Amasa uwo yari umwana w'umugabo witwa Itura w'Umwisirayeli, waryamanye na Abigayili mwene Nahashi murumuna wa Seruya nyina wa Yowabu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.25",
            "verseOrgIds": [
              "2SA.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisirayeli na Abusalomu bagerereza mu gihugu cy'i Galeyadi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.26",
            "verseOrgIds": [
              "2SA.17.26"
            ]
          }
        }
      ]
