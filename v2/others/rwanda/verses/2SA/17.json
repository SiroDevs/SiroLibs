          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma Dawidi ageze i Mahanayimu, Shobi mwene Nahashi w'i Raba y'Abamoni, na Makiri mwene Amiyeli w'i Lodebari, na Barizilayi w'Umunyagaleyadi w'i Rogelimu, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.27",
            "verseOrgIds": [
              "2SA.17.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
