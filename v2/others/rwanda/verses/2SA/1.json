                "loc": "JOS.10.13"
              },
              "items": [
                {
                  "text": "Yos 10.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " abategeka kwigisha Abayuda indirimbo y'umuheto, yanditswe mu gitabo cya Yashari.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.18",
            "verseOrgIds": [
              "2SA.1.18"
            ]
          }
        }
