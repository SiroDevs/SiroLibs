              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.17.6"
              },
              "items": [
                {
                  "text": "Abac 17.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ariko icyo gihe Abisirayeli nta mwami bari bafite, kandi umuntu wese yitegekaga uko ashatse.",
          "type": "text",
          "attrs": {
